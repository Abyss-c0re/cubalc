# CubalC 1.8.0-nest — Each cube compiles into a matrix. No flow → no compile. Nestable.
HOLD_FLASH 1
SHARE state_matrix_only
BUDGET 40
GENESIS "NEXUS_COORD v1 | from=cop | type=nest_compile | hold_flash=1 |"

CUBE outer ROLE shell  PROTON 1
CUBE mid   ROLE core   PROTON 1
CUBE inner ROLE seed   PROTON 1
CUBE peer  ROLE peer   PROTON 1

NEST outer mid
NEST mid   inner

FOLDBITS outer "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS mid   "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS inner "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS peer  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG outer mid
PLUG mid   inner
PLUG outer peer

IMPULSE outer 1
ENERGYFLOW 3
FLOW DIR 4

COMPILE ALL
ASSERT COMPILED(inner) == 1
ASSERT COMPILED(mid) == 1
ASSERT COMPILED(outer) == 1
ASSERT COMPILED(peer) == 1
ASSERT SET(outer) > 0
ASSERT NESTED(inner) == 1
ASSERT DIGIT(outer) >= 0
ASSERT DIGIT(outer) <= 9

PRINT "NEST_COMPILE" CUBES COMPILED SET(outer) DIGIT(outer) ENERGY(peer) UNITY
VIZ "state/nest_compile_viz.json"
