# fleet_config_scrub.cubalc — fleet config scrub via REPLACEFILES + READALL/WRITEALL
#
# Real use: ops agent inventories config plates under a fleet dir, concatenates
# them for a digest (READALL/CATFILES), bulk-rewrites host/token strings
# (REPLACEFILES/SUBFILES) without EACH+READ+WRITE, and can WRITEALL reset
# templates across the bag. Distinct from incident_log_board (content search
# + append stamp) and kv_config_loader (single-file KV peel): this board is
# multi-file content rewrite + concat audit.
#
# Plate under STATE:
#   PATHS.txt          — working path bag
#   DIGEST.txt         — last READALL concat
#   TOUCHED.txt        — last REPLACEFILES rewritten paths
#   SCRUB_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_FC_ACTION):
#   list      — depths (default)
#   scan      — PATHGLOB DIR PAT → PATHS
#   files     — KEEPFILES PATHS
#   cat       — READALL PATHS [sep ARG1 default "\n"] → DIGEST
#   scrub     — REPLACEFILES PATHS old(ARG1) new(ARG2) → TOUCHED
#   reset     — WRITEALL PATHS data(ARG1) overwrite all
#   has       — HASLINE exact on PATHS
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_fc_$$; mkdir -p "$CUBALC_STATE/cfg"
#   # write host=old fixtures
#   CUBALC_FC_DIR=$CUBALC_STATE/cfg CUBALC_ARG0=scan CUBALC_ARG1='*.cfg' \
#     ./out/cubalc run -q -s programs/realworld/fleet_config_scrub.cubalc
#   CUBALC_ARG0=scrub CUBALC_ARG1='host=old' CUBALC_ARG2='host=new' \
#     ./out/cubalc run -q -s ...
#   CUBALC_ARG0=cat CUBALC_ARG1='|||' ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_FC_DIR=…  CUBALC_FC_PAT=*  CUBALC_FC_REQUIRE=1  CUBALC_FC_SEP=
#
# Edges deliberately stressed:
#   REPLACEFILES only rewrites changed files (SKIP count)
#   empty old → no-op SKIP all
#   READALL soft miss OK=0 partial concat; sep between files
#   WRITEALL creates missing; overwrites all same data
#   WRITE vs WRITEALL; REPLACEALL string vs REPLACEFILES paths
#   WRITE NL; PRINT_JSON; soft READ; REQUIRE empty

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "fleet_config_scrub: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT PFILE = "PATHS.txt"
DEFAULT DFILE = "DIGEST.txt"
DEFAULT TFILE = "TOUCHED.txt"
DEFAULT REPORT = "SCRUB_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT PAT = "*"
DEFAULT DIR = ""
DEFAULT SEP = ""
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_FC_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_FC_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_FC_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_FC_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_FC_PAT" OR ""
IF LAST_N > 0 THEN
  LET PAT = LAST
END
SYS ENV "CUBALC_FC_DIR" OR ""
IF LAST_N > 0 THEN
  LET DIR = LAST
END
SYS ENV "CUBALC_FC_SEP" OR ""
IF LAST_N > 0 THEN
  LET SEP = LAST
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS BLANK DIR
IF LAST_N == 1 THEN
  LET DIR = state_dir
END
SYS JOIN state_dir PFILE
LET paths_path = LAST
SYS JOIN state_dir DFILE
LET digest_path = LAST
SYS JOIN state_dir TFILE
LET touched_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR paths_path OR ""
LET paths = LAST
CLEAR_ERR
SYS READ OR digest_path OR ""
LET digest = LAST
CLEAR_ERR
SYS READ OR touched_path OR ""
LET touched = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET paths_ch = 0
LET digest_ch = 0
LET touched_ch = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET pglob_n = 0
LET keep_n = 0
LET drop_n = 0
LET read_n = 0
LET read_miss = 0
LET read_bytes = 0
LET scrub_n = 0
LET scrub_subs = 0
LET scrub_skip = 0
LET scrub_miss = 0
LET write_n = 0
LET write_fail = 0
LET write_bytes = 0

SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET PAT = NAME
  END
END
SYS EQS ACTION "cat"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET SEP = NAME
  END
END
SYS EQS ACTION "scrub"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "scrub needs old new"
  END
END
SYS EQS ACTION "reset"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "reset needs data"
  END
END
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs path"
  END
END

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS LINES paths
  LET np = LAST_N
  SYS LINES touched
  LET nt = LAST_N
  CLEAR_ERR
  STATUS
  PRINT "fscrub" np nt ACTION
  PRINT_JSON np nt ACTION STATUS_OK
  PRINT_JSON paths
  PRINT_JSON digest
  PRINT_JSON touched
  LET note_msg = "list ok"
END

# --- scan ---
SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  NOTE "action scan"
  SYS PATHGLOB DIR PAT
  IF OK == 0 THEN
    LET miss = 1
    LET paths = ""
    LET paths_ch = 1
    LET note_msg = "scan miss"
    FAIL "scan miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "scan miss"
    END
  ELSE
    LET paths = LAST
    LET pglob_n = PATHGLOB_N
    LET paths_ch = 1
    LET hit = pglob_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "scan empty"
      FAIL "scan empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "scan empty"
      END
    ELSE
      LET note_msg = "scan ok"
    END
    PRINT_JSON PAT pglob_n
    PRINT_JSON paths
  END
END

# --- files ---
SYS EQS ACTION "files"
IF LAST_N == 1 THEN
  NOTE "action files"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "files empty"
    FAIL "files empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "files empty"
    END
  ELSE
    SYS KEEPFILES paths
    LET paths = LAST
    LET keep_n = KEEPFILES_N
    LET drop_n = KEEPFILES_DROP
    LET paths_ch = 1
    LET hit = keep_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "files none"
      FAIL "files none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "files none"
      END
    ELSE
      LET note_msg = "files ok"
    END
    PRINT_JSON keep_n drop_n
    PRINT_JSON paths
  END
END

# --- cat READALL ---
SYS EQS ACTION "cat"
IF LAST_N == 1 THEN
  NOTE "action cat"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "cat empty"
    FAIL "cat empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "cat empty"
    END
  ELSE
    SYS BLANK SEP
    IF LAST_N == 1 THEN
      SYS READALL paths
    ELSE
      SYS READALL paths SEP
    END
    LET digest = LAST
    LET read_n = READALL_N
    LET read_miss = READALL_MISS
    LET read_bytes = READALL_BYTES
    LET hit = read_n
    LET digest_ch = 1
    IF read_n == 0 THEN
      LET miss = 1
      LET note_msg = "cat none"
      FAIL "cat none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "cat none"
      END
    ELSE
      LET note_msg = "cat ok"
    END
    PRINT_JSON read_n read_miss read_bytes
    PRINT_JSON digest
    CLEAR_ERR
  END
END

# --- scrub REPLACEFILES ---
SYS EQS ACTION "scrub"
IF LAST_N == 1 THEN
  NOTE "action scrub"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "scrub empty"
    FAIL "scrub empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "scrub empty"
    END
  ELSE
    SYS REPLACEFILES paths NAME A2
    LET touched = LAST
    LET scrub_n = REPLACEFILES_N
    LET scrub_subs = REPLACEFILES_SUBS
    LET scrub_skip = REPLACEFILES_SKIP
    LET scrub_miss = REPLACEFILES_MISS
    LET hit = scrub_n
    LET touched_ch = 1
    SYS BLANK touched
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "scrub none"
      FAIL "scrub none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "scrub none"
      END
    ELSE
      LET note_msg = "scrub ok"
    END
    PRINT_JSON NAME A2 scrub_n scrub_subs scrub_skip scrub_miss
    PRINT_JSON touched
    CLEAR_ERR
  END
END

# --- reset WRITEALL ---
SYS EQS ACTION "reset"
IF LAST_N == 1 THEN
  NOTE "action reset"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "reset empty"
    FAIL "reset empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "reset empty"
    END
  ELSE
    SYS WRITEALL paths NAME
    LET touched = LAST
    LET write_n = WRITEALL_N
    LET write_fail = WRITEALL_FAIL
    LET write_bytes = WRITEALL_BYTES
    LET hit = write_n
    LET touched_ch = 1
    IF write_n == 0 THEN
      LET miss = 1
      LET note_msg = "reset none"
      FAIL "reset none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "reset none"
      END
    ELSE
      LET note_msg = "reset ok"
    END
    PRINT_JSON write_n write_fail write_bytes NAME
    PRINT_JSON touched
    CLEAR_ERR
  END
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS HASLINE paths NAME
  LET val_n = LAST_N
  LET hit = val_n
  IF val_n == 0 THEN
    LET miss = 1
    LET note_msg = "has miss"
    FAIL "has miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has miss"
    END
  ELSE
    LET note_msg = "has ok"
  END
  PRINT_JSON val_n NAME
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET paths = ""
  LET digest = ""
  LET touched = ""
  LET paths_ch = 1
  LET digest_ch = 1
  LET touched_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "scan"
LET k = k + LAST_N
SYS EQS ACTION "files"
LET k = k + LAST_N
SYS EQS ACTION "cat"
LET k = k + LAST_N
SYS EQS ACTION "scrub"
LET k = k + LAST_N
SYS EQS ACTION "reset"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF paths_ch > 0 THEN
  SYS WRITE paths_path paths
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "paths write failed"
  END
  CLEAR_ERR
END
IF digest_ch > 0 THEN
  SYS WRITE digest_path digest
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "digest write failed"
  END
  CLEAR_ERR
END
IF touched_ch > 0 THEN
  SYS WRITE touched_path touched
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "touched write failed"
  END
  CLEAR_ERR
END

SYS LINES paths
LET depth_p = LAST_N
SYS LINES touched
LET depth_t = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.fleet_config_scrub.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "a2"
LET report = LAST
SYS PUSH report A2
LET report = LAST
SYS PUSH report "scrub_n"
LET report = LAST
SYS STR scrub_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "scrub_subs"
LET report = LAST
SYS STR scrub_subs
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "scrub_skip"
LET report = LAST
SYS STR scrub_skip
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "read_n"
LET report = LAST
SYS STR read_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "read_bytes"
LET report = LAST
SYS STR read_bytes
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "write_n"
LET report = LAST
SYS STR write_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "write_bytes"
LET report = LAST
SYS STR write_bytes
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_p"
LET report = LAST
SYS STR depth_p
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_t"
LET report = LAST
SYS STR depth_t
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "dir"
LET report = LAST
SYS PUSH report DIR
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "fleet_config_scrub" ACTION hit miss scrub_n read_n write_n note_msg elapsed
PRINT_JSON ACTION hit miss scrub_n scrub_subs scrub_skip read_n read_bytes write_n write_bytes depth_p depth_t note_msg STATUS_OK
NOTE "fleet_config_scrub: done"
