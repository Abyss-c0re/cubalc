# svc_pathbyval_reverse_board.cubalc — PATHBYVAL reverse nest lookup
#
# Real use: ops agents answer "which path holds this value?" without
# EACH FLAT+EQS glue — role/host inventory reverse index, peer name map.
# First realworld of proof 1243 PATHBYVAL (MEANINGFUL 702).
#
#   PATHBYVAL|VALPATH|FINDVAL [FROM plate] value [OR fallback]
#   LAST = first matching path · PATHBYVAL_VALUE · HIT · FALLBACK
#   Prefer LAST over specials near 128-var cap (W408 class).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_spv_$$
#   ./out/cubalc run programs/realworld/svc_pathbyval_reverse_board.cubalc boot
#   ./out/cubalc run ... find|or|peer|soft|gate|first|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SPV_REPORT.txt agent.json peer.json path.txt
# Env: HOST_S ROLE_S CUBALC_SPV_REQUIRE
#
# Edges: soft miss; OR fallback; FROM PEER; first-match repeat; GETP round-trip;
#   WRITE NL; REQUIRE softens; exact value vs substring false friends

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_pathbyval_reverse_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_pathbyval_reverse -- boot|find|or|peer|soft|gate|first|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SPV_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

# path pool — stay under 128-var hard cap
SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "path.txt"
LET path_file = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SPV_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET path_val = ""
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "find", "or", "peer", "soft", "gate", "first", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "find" THEN
    LET op = "find"
  WHEN "or" THEN
    LET op = "or"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "first" THEN
    LET op = "first"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — role/host plate + peer name map
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  # site not host — reverse lookup must hit cfg.host not site
  # agent_job uses runner not worker — first-seen PATHBYVAL walk hits earlier keys
  SYS CAT "{\"agent\":\"svc-pathbyval\",\"schema\":\"cubalc.svc_pathbyval_reverse.v1\",\"site\":\"" host_s "\",\"agent_job\":\"runner\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"leader\",\"host\":\"h1\"},\"other\":{\"host\":\"h2\"},\"label\":\"path\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_pathbyval_reverse.v1\",\"site\":\"" host_s "\",\"a\":{\"name\":\"first\"},\"b\":{\"name\":\"second\"},\"c\":{\"name\":\"third\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.host"
  SYS EQS LAST "h2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:roles:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# find — PATHBYVAL worker/leader/h1/h2 reverse paths
SYS EQS op "find"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHBYVAL "worker"
  LET path_val = LAST
  CLEAR_ERR
  SYS WRITE path_file path_val
  CLEAR_ERR
  SYS EQS path_val "meta.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "leader"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "cfg.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "h1"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "cfg.host"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "h2"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "other.host"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss no OR
  PATHBYVAL "nope"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "find ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "find score"
    FAIL "find score"
    CLEAR_ERR
  END
  SYS CAT "find:" path_val ":fd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "find:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

# or — soft miss + OR fallback path
SYS EQS op "or"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHBYVAL "nope" OR "default.path"
  LET path_val = LAST
  CLEAR_ERR
  SYS WRITE path_file path_val
  CLEAR_ERR
  SYS EQS path_val "default.path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # real hit still wins over OR
  PATHBYVAL "worker" OR "default.path"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "meta.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "ghost"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pathbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "or ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "or score"
    FAIL "or score"
    CLEAR_ERR
  END
  SYS CAT "or:" path_val ":or"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "or:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

# peer — PATHBYVAL/VALPATH/FINDVAL FROM PEER names
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHBYVAL FROM PEER "second"
  LET path_val = LAST
  CLEAR_ERR
  SYS WRITE path_file path_val
  CLEAR_ERR
  SYS EQS path_val "b.name"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  VALPATH FROM PEER "first"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "a.name"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FINDVAL FROM PEER "third"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "c.name"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pathbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" path_val ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

# soft — miss + plate intact
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHBYVAL "ghostpath"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "worker"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val "meta.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pathbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

# gate — reverse path contract + GETP round-trip
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHBYVAL "worker"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val "meta.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP path_val
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_pathbyval_reverse"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "leader"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "cfg.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS WRITE path_file path_val
  CLEAR_ERR
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

# first — first-seen path wins when value repeated
SYS EQS op "first"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "probe.a.v" "x"
  CLEAR_ERR
  SETP "probe.b.v" "x"
  CLEAR_ERR
  PATHBYVAL "x"
  LET path_val = LAST
  CLEAR_ERR
  SYS WRITE path_file path_val
  CLEAR_ERR
  SYS EQS path_val "probe.a.v"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # later path still first-seen a
  SETP "probe.c.v" "x"
  CLEAR_ERR
  PATHBYVAL "x"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe.a.v"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pathbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 4 THEN
    LET hit = 1
    LET note_msg = "first ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "first score"
    FAIL "first score"
    CLEAR_ERR
  END
  SYS CAT "first:" path_val ":fi"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "first:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

# probe — exact value match; substring "work" must NOT hit "worker"
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHBYVAL "worker"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val "meta.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # false friend: partial value should miss (exact value contract)
  PATHBYVAL "work"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PATHBYVAL "orker"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # agent_job holds role_s value (worker) — first-seen meta.role still wins for "worker"
  PATHBYVAL "worker"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "meta.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "pathbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS WRITE path_file path_val
  CLEAR_ERR
  SYS CAT "probe:" path_val ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_pathbyval_reverse.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " path=" path_val " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_pathbyval_reverse_board: end"
