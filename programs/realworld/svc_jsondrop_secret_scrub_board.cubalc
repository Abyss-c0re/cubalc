# svc_jsondrop_secret_scrub_board.cubalc — JSONDROP/JSONOMIT secret scrub
#
# Real use: agents redact secret/token/password keys from peer plates before
# mesh handoff or log export. Soft bulk dual of multi JSONDEL. Dual of
# JSONPLUCK (export allowlist values) — this *omits* deny-list keys and keeps
# remainder object. OF bag omit list for policy plates.
#
#   JSONDROP · JSONOMIT · JDROPK · JOMIT · JSONDROP_N (removed count)
#   OF bag · miss soft · empty plate · admit when secrets gone
#
# Edges (challenge):
#   JSONDROP_N = removed count (not remaining keys)
#   miss keys → removed=0, plate unchanged
#   HASFORM may lag (forms catalog empty for JSONDROP prefix) while ops live
#   JSONHAS on scrubbed plate for secret → 0 (admit)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_jds_$$
#   ./out/cubalc run programs/realworld/svc_jsondrop_secret_scrub_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt JDS_REPORT.txt agent.json plates/*
# Env: HOST_S ROLE_S CUBALC_JDS_REQUIRE

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN scrub_secrets
  LET clean = ""
  LET removed_n = 0
  LET ok_v = 0
  SYS JSONDROP plate "secret" "token" "password" "passwd" "api_key"
  LET clean = LAST
  LET removed_n = JSONDROP_N
  IF removed_n > 0 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN scrub_ofbag
  LET clean = ""
  LET removed_n = 0
  LET ok_v = 0
  SYS JOIN "" "secret\ntoken\npassword\napi_key"
  LET kbag = LAST
  SYS JSONDROP plate OF kbag
  LET clean = LAST
  LET removed_n = JSONDROP_N
  IF removed_n > 0 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN secrets_gone
  LET ok_v = 1
  SYS JSON "secret" FROM clean
  SYS EMPTY LAST
  IF LAST_N == 0 THEN
    LET ok_v = 0
  END
  CLEAR_ERR
  SYS JSON "token" FROM clean
  SYS EMPTY LAST
  IF LAST_N == 0 THEN
    LET ok_v = 0
  END
  CLEAR_ERR
  SYS JSON "password" FROM clean
  SYS EMPTY LAST
  IF LAST_N == 0 THEN
    LET ok_v = 0
  END
  CLEAR_ERR
END

FN admit_scrubbed
  LET state = "deny-leak"
  LET ok_v = 0
  CALL scrub_secrets
  CALL secrets_gone
  IF ok_v == 1 THEN
    SYS JSON "id" FROM clean
    IF LAST_N > 0 THEN
      LET state = "admit"
      LET ok_v = 1
    ELSE
      LET state = "deny-noid"
      LET ok_v = 0
    END
    CLEAR_ERR
  ELSE
    LET state = "deny-leak"
    LET ok_v = 0
  END
END

NOTE "svc_jsondrop_secret_scrub_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_jsondrop_secret_scrub -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_JDS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JDS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "peer.json"
LET peer_path = LAST
SYS JOIN plate_dir "clean.json"
LET clean_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET plate = ""
LET clean = ""
LET state = ""
LET saved = 0
LET removed_n = 0
LET kbag = ""

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-jds\",\"schema\":\"cubalc.svc_jsondrop_secret_scrub.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"jds\",\"want_filter\":\"jsondrop_secret_scrub\",\"cfg\":{\"surface\":\"JSONDROP,JSONOMIT,JDROPK,JSONDROP_N\",\"contract\":\"deny-list key scrub before mesh handoff (dual of JSONPLUCK allowlist)\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"id\":\"peer-1\",\"status\":\"ok\",\"role\":\"worker\",\"secret\":\"s3cr3t\",\"token\":\"tok\",\"n\":3}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL scrub_secrets
  CLEAR_ERR
  SYS WRITE clean_path clean
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jds"
  IF LAST_N == 1 THEN
    IF removed_n == 2 THEN
      CALL secrets_gone
      IF ok_v == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = removed_n
      ELSE
        LET miss = 1
        LET note_msg = "boot leak"
        FAIL "boot leak"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot removed"
      FAIL "boot removed"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core drop duals 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"peer-1\",\"status\":\"ok\",\"role\":\"worker\",\"secret\":\"s3cr3t\",\"token\":\"tok\",\"password\":\"p\",\"n\":3}"
  CALL scrub_secrets
  IF removed_n == 3 THEN
    LET score = score + 1
  END
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS JSON "id" FROM clean
  SYS EQS LAST "peer-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JSON "n" FROM clean
  SYS NUM
  IF LAST_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JSON "role" FROM clean
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OF bag
  CALL scrub_ofbag
  IF removed_n >= 3 THEN
    LET score = score + 1
  END
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # JSONOMIT alias single
  SYS JSONOMIT plate "secret"
  LET clean = LAST
  SYS JSON "secret" FROM clean
  SYS EMPTY LAST
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JSON "token" FROM clean
  SYS EQS LAST "tok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "JSONDROP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — miss · empty · no-secret plate
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"p2\",\"status\":\"live\"}"
  CALL scrub_secrets
  IF removed_n == 0 THEN
    LET score = score + 1
  END
  SYS JSON "id" FROM clean
  SYS EQS LAST "p2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # miss keys only
  LET plate = "{\"id\":\"p3\",\"secret\":\"x\"}"
  SYS JSONDROP plate "gone" "nada"
  LET clean = LAST
  IF JSONDROP_N == 0 THEN
    LET score = score + 1
  END
  SYS JSON "secret" FROM clean
  SYS EQS LAST "x"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty object
  SYS JSONDROP "{}" "secret"
  LET clean = LAST
  SYS EMPTY clean
  IF LAST_N == 0 THEN
    # may be "{}" non-empty
    SYS HAS clean "{"
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  # JDROPK alias
  LET plate = "{\"a\":1,\"secret\":\"z\"}"
  SYS JDROPK plate "secret"
  LET clean = LAST
  SYS JSON "a" FROM clean
  SYS NUM
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JSON "secret" FROM clean
  SYS EMPTY LAST
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # admit clean
  LET plate = "{\"id\":\"ok1\",\"status\":\"ok\",\"secret\":\"no\"}"
  CALL admit_scrubbed
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — disk peer → clean.json
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"id\":\"disk-9\",\"status\":\"ok\",\"role\":\"w\",\"secret\":\"hide\",\"token\":\"t9\",\"n\":1}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL scrub_secrets
  IF removed_n == 2 THEN
    LET score = score + 1
  END
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS WRITE clean_path clean
  CLEAR_ERR
  SYS READ clean_path
  LET clean = LAST
  CLEAR_ERR
  SYS HAS clean "secret"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS clean "hide"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JSON "id" FROM clean
  SYS EQS LAST "disk-9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL scrub_ofbag
  IF removed_n >= 2 THEN
    LET score = score + 1
  END
  CALL admit_scrubbed
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "deny-list"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "JSONDROP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — admit ladder
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"s1\",\"status\":\"ok\",\"secret\":\"x\"}"
  CALL admit_scrubbed
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # no id after drop only secrets — still has id
  LET plate = "{\"secret\":\"only\"}"
  CALL admit_scrubbed
  SYS EQS state "deny-noid"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"id\":\"s2\",\"token\":\"t\",\"password\":\"p\"}"
  CALL scrub_secrets
  IF removed_n == 2 THEN
    LET score = score + 1
  END
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL admit_scrubbed
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # re-scrub clean plate removed 0
  LET plate = clean
  CALL scrub_secrets
  IF removed_n == 0 THEN
    LET score = score + 1
  END
  SYS JSON "id" FROM clean
  IF LAST_N > 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "dual of JSONPLUCK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "JSONDROP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONOMIT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JDROPK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JOMIT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONPICK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONPLUCK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SYS JSONDROP"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONDROP_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsondrop_secret_scrub"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "JSONDROP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

