  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET plate = "{\"secret\":\"only\"}"
  CALL admit_scrubbed
  SYS EQS state "deny-noid"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"id\":\"g2\",\"status\":\"ok\"}"
  CALL admit_scrubbed
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF removed_n == 0 THEN
    LET score = score + 1
  END
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "scrub"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "mesh handoff"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
