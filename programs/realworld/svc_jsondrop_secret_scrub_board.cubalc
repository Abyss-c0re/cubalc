# probe — disk · WRITE NL · NUM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"id\":\"pr1\",\"status\":\"ok\",\"secret\":\"x\",\"token\":\"y\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL scrub_secrets
  IF removed_n == 2 THEN
    LET score = score + 1
  END
  LET saved = removed_n
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 2 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS WRITE clean_path clean
  CLEAR_ERR
  SYS CAT "removed=" removed_n " state=probe"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "removed="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "jds_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "jds_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ clean_path
  LET clean = LAST
  CLEAR_ERR
  CALL secrets_gone
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS JSON "id" FROM clean
  SYS EQS LAST "pr1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jds"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-jds\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit ",\"removed_n\":" removed_n ",\"state\":\"" state "\"}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n " removed=" removed_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_jsondrop_secret_scrub_board: done"
PASS
