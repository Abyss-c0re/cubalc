    ELSE
      LET hit = 1
      LET note_msg = "blank ok"
      SYS STR probe_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "blank"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR probe_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON probe_n
  CLEAR_ERR
END

# --- has / hasi ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "has bad slot"
    FAIL "has bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "has bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        HASINF a0 note NEEDLE
        LET o_ok = OK
        LET probe_n = HASINF_N
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        HASINF a1 note NEEDLE
        LET o_ok = OK
        LET probe_n = HASINF_N
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        HASINF a2 note NEEDLE
        LET o_ok = OK
        LET probe_n = HASINF_N
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "has miss obj"
      FAIL "has miss obj"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "has miss obj"
      END
    ELSE
      IF probe_n == 1 THEN
        LET hit = 1
        LET note_msg = "has ok"
        LET val = "1"
      ELSE
        LET miss = 1
        LET note_msg = "has miss"
        LET val = "0"
        FAIL "has miss"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "has miss"
        END
      END
      LET val_ch = 1
      LET meta = "has"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta NEEDLE
      LET meta = LAST
      SYS STR probe_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON probe_n
  CLEAR_ERR
END

SYS EQS ACTION "hasi"
IF LAST_N == 1 THEN
  NOTE "action hasi"
  IF slot < 0 THEN
    LET miss = 1
