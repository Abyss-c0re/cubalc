    FAIL "hasi bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "hasi bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        HASIFI a0 note NEEDLE
        LET o_ok = OK
        LET probe_n = HASIFI_N
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        HASIFI a1 note NEEDLE
        LET o_ok = OK
        LET probe_n = HASIFI_N
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        HASIFI a2 note NEEDLE
        LET o_ok = OK
