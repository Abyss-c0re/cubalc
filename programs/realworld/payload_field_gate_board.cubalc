SYS EQS ACTION "empty"
IF LAST_N == 1 THEN
  NOTE "action empty"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "empty bad slot"
    FAIL "empty bad slot"
    CLEAR_ERR
