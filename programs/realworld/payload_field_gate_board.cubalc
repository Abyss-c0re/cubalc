        EMPTYF a0 note
        LET o_ok = 1
        LET probe_n = EMPTYF_N
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        EMPTYF a1 note
        LET o_ok = 1
        LET probe_n = EMPTYF_N
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        EMPTYF a2 note
        LET o_ok = 1
