# payload_field_gate_board.cubalc — LENF + HASINF/STARTSF/ENDSF intake gates
#
# Real use: ops agents admit Artifact payloads only when path prefix/suffix,
# note length bounds, and required tag substrings hold — without GETF+SYS
# LEN/HAS/STARTS glue and without mutating fields.
#
# Surfaces forced (1.15.393–394):
#   LENF / EMPTYF / BLANKF / NONEMPTYF · TRYLENF · LENF SOFT
#   HASINF / HASIFI / CONTAINSF · STARTSF / STARTSIF · ENDSF / ENDSIF
#   TRYHASINF / TRYSTARTSF / TRYENDSF
#   DUMPOBJ rehydrate · soft miss + REQUIRE wall
#
# Distinct from payload_size_gate (bytes plate) and fleet_label_scrub
# (mutators): this board is *read-only field probes for IF gates*.
#
# Slots: a0 a1 a2
#
# Plate under STATE:
#   dump/a0 dump/a1 dump/a2
#   VAL.txt META.txt OBJS.txt GATE_REPORT.txt
#
# Actions:
#   list | open | len | empty | blank | has | hasi | starts | ends
#   admit | probe | get | dump | clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_pfg_$$
#   CUBALC_ARG0=open CUBALC_ARG1=a0 CUBALC_ARG2=/tmp/out.json
#   CUBALC_FS_NEEDLE=timeout CUBALC_ARG0=has CUBALC_ARG1=a0
#   CUBALC_FS_MINL=3 CUBALC_FS_MAXL=200 CUBALC_ARG0=admit CUBALC_ARG1=a0
#   CUBALC_FS_REQUIRE=1 CUBALC_ARG0=admit CUBALC_ARG1=a1
#
# Env: CUBALC_FS_REQUIRE NAME NEEDLE MINL MAXL PREFIX SUFFIX MSG ACTION
#
# Edges:
#   HASINF empty needle always matches
#   LENF on num → decimal digit length
#   probes set LAST to field text (EQS after LENF clobbers LAST_N)
#   no LENWHERE fleet probe — per-object only
#   WRITE NL; NUM softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS Artifact
  FIELD id ""
  FIELD path ""
  FIELD note ""
  FIELD status "new"
  METHOD init i p n
    SETF THIS id i
    SETF THIS path p
    SETF THIS note n
    SETF THIS status "new"
  END
END

REQUIRE CLASS Artifact
REQUIRE METHOD Artifact init

NOTE "payload_field_gate_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT NEED_HIT = 0
DEFAULT NEEDLE = "ok"
DEFAULT MINL = 1
DEFAULT MAXL = 256
DEFAULT PREFIX = "/tmp"
DEFAULT SUFFIX = ".json"
DEFAULT MSG = "error: timeout on peer"
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_FS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_FS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_FS_A2" OR ""
  IF LAST_N > 0 THEN
    LET A2 = LAST
  END
END
SYS ENV "CUBALC_FS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET NEED_HIT = LAST_N
  END
END
SYS ENV "CUBALC_FS_NEEDLE" OR ""
IF LAST_N > 0 THEN
  LET NEEDLE = LAST
END
SYS ENV "CUBALC_FS_MINL" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MINL = LAST_N
  END
END
SYS ENV "CUBALC_FS_MAXL" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MAXL = LAST_N
  END
END
SYS ENV "CUBALC_FS_PREFIX" OR ""
IF LAST_N > 0 THEN
  LET PREFIX = LAST
END
SYS ENV "CUBALC_FS_SUFFIX" OR ""
IF LAST_N > 0 THEN
  LET SUFFIX = LAST
END
SYS ENV "CUBALC_FS_NOTE" OR ""
IF LAST_N > 0 THEN
  LET MSG = LAST
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "dump"
LET dump_dir = LAST
SYS MKDIR dump_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "GATE_REPORT.txt"
LET report_path = LAST
SYS JOIN dump_dir "a0"
LET d_a0 = LAST
SYS JOIN dump_dir "a1"
LET d_a1 = LAST
SYS JOIN dump_dir "a2"
LET d_a2 = LAST

LET slot = -1
SYS EQS NAME "a0"
IF LAST_N == 1 THEN
  LET slot = 0
END
SYS EQS NAME "a1"
IF LAST_N == 1 THEN
  LET slot = 1
END
SYS EQS NAME "a2"
IF LAST_N == 1 THEN
  LET slot = 2
END
LET sn = ""
IF slot == 0 THEN
  LET sn = "a0"
END
IF slot == 1 THEN
  LET sn = "a1"
END
IF slot == 2 THEN
  LET sn = "a2"
END

# rehydrate
SYS READ OR d_a0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ a0
  IF LAST_N == 1 THEN
    DELETEOBJ a0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "path"
  LET rpa = LAST
  SYS LOOKUP snap "note"
  LET rno = LAST
  SYS LOOKUP snap "status"
  LET rst = LAST
  CLEAR_ERR
  NEW Artifact a0 rid rpa rno
  SYS BLANK rpa
  IF LAST_N == 0 THEN
    TRYSETF a0 path rpa
  END
  SYS BLANK rno
  IF LAST_N == 0 THEN
    TRYSETF a0 note rno
  END
  SYS BLANK rst
  IF LAST_N == 0 THEN
    TRYSETF a0 status rst
  END
  CLEAR_ERR
END
SYS READ OR d_a1 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ a1
  IF LAST_N == 1 THEN
    DELETEOBJ a1
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "path"
  LET rpa = LAST
  SYS LOOKUP snap "note"
  LET rno = LAST
  SYS LOOKUP snap "status"
  LET rst = LAST
  CLEAR_ERR
  NEW Artifact a1 rid rpa rno
  SYS BLANK rpa
  IF LAST_N == 0 THEN
    TRYSETF a1 path rpa
  END
  SYS BLANK rno
  IF LAST_N == 0 THEN
    TRYSETF a1 note rno
  END
  SYS BLANK rst
  IF LAST_N == 0 THEN
    TRYSETF a1 status rst
  END
  CLEAR_ERR
END
SYS READ OR d_a2 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ a2
  IF LAST_N == 1 THEN
    DELETEOBJ a2
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "path"
  LET rpa = LAST
  SYS LOOKUP snap "note"
  LET rno = LAST
  SYS LOOKUP snap "status"
  LET rst = LAST
  CLEAR_ERR
  NEW Artifact a2 rid rpa rno
  SYS BLANK rpa
  IF LAST_N == 0 THEN
    TRYSETF a2 path rpa
  END
  SYS BLANK rno
  IF LAST_N == 0 THEN
    TRYSETF a2 note rno
  END
  SYS BLANK rst
  IF LAST_N == 0 THEN
    TRYSETF a2 status rst
  END
  CLEAR_ERR
END

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET nobjs = 0
LET probe_n = 0
LET board_rep = "payload_field_gate_board"

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS Artifact
  LET bag = LAST
  LET nobjs = NOBJS
  SYS WRITE objs_path bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- open ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    LET p0 = "/tmp/out.json"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET p0 = A2
    END
    LET n0 = MSG
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        DELETEOBJ a0
        CLEAR_ERR
      END
      NEW Artifact a0 sn p0 n0
      DUMPOBJ a0
      SYS WRITE d_a0 LAST
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        DELETEOBJ a1
        CLEAR_ERR
      END
      NEW Artifact a1 sn p0 n0
      DUMPOBJ a1
      SYS WRITE d_a1 LAST
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        DELETEOBJ a2
        CLEAR_ERR
      END
      NEW Artifact a2 sn p0 n0
      DUMPOBJ a2
      SYS WRITE d_a2 LAST
      CLEAR_ERR
    END
    LISTOBJS Artifact
    LET nobjs = NOBJS
    SYS WRITE objs_path LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "open ok"
    LET val = sn
    LET val_ch = 1
    LET meta = "open"
    SYS PUSH meta sn
    LET meta = LAST
    SYS PUSH meta p0
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- len ---
SYS EQS ACTION "len"
IF LAST_N == 1 THEN
  NOTE "action len"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "len bad slot"
    FAIL "len bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "len bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        LENF a0 note
        LET o_ok = OK
        LET probe_n = LENF_N
        LET val = LAST
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        LENF a1 note
        LET o_ok = OK
        LET probe_n = LENF_N
        LET val = LAST
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        LENF a2 note
        LET o_ok = OK
        LET probe_n = LENF_N
        LET val = LAST
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "len miss"
      FAIL "len miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "len miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "len ok"
      LET val_ch = 1
      LET meta = "len"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR probe_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON probe_n
  CLEAR_ERR
END

