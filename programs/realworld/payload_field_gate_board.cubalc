        LET miss = 1
        LET note_msg = "starts miss"
        LET val = "0"
        FAIL "starts miss"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "starts miss"
        END
      END
      LET val_ch = 1
      LET meta = "starts"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta PREFIX
      LET meta = LAST
      SYS STR probe_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON probe_n
  CLEAR_ERR
END

