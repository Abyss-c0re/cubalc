# --- starts / ends ---
SYS EQS ACTION "starts"
IF LAST_N == 1 THEN
  NOTE "action starts"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "starts bad slot"
    FAIL "starts bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "starts bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        STARTSF a0 path PREFIX
        LET o_ok = OK
        LET probe_n = STARTSF_N
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        STARTSF a1 path PREFIX
        LET o_ok = OK
        LET probe_n = STARTSF_N
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        STARTSF a2 path PREFIX
        LET o_ok = OK
        LET probe_n = STARTSF_N
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "starts miss obj"
      FAIL "starts miss obj"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "starts miss obj"
      END
    ELSE
      IF probe_n == 1 THEN
        LET hit = 1
        LET note_msg = "starts ok"
        LET val = "1"
