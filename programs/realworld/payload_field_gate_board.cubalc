      LET miss = 1
      LET note_msg = "empty miss"
      FAIL "empty miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "empty miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "empty ok"
      SYS STR probe_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "empty"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR probe_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON probe_n
  CLEAR_ERR
END

SYS EQS ACTION "blank"
IF LAST_N == 1 THEN
