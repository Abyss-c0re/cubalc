# --- admit: path prefix+suffix + note len in [MINL,MAXL] + HASINF needle ---
SYS EQS ACTION "admit"
IF LAST_N == 1 THEN
  NOTE "action admit"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "admit bad slot"
    FAIL "admit bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "admit bad slot"
    END
  ELSE
    LET o_ok = 0
    LET ok_all = 1
    LET reason = "ok"
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        LET o_ok = 1
        STARTSF a0 path PREFIX
        IF STARTSF_N == 0 THEN
          LET ok_all = 0
          LET reason = "prefix"
        END
        ENDSF a0 path SUFFIX
        IF ENDSF_N == 0 THEN
          LET ok_all = 0
          LET reason = "suffix"
        END
        LENF a0 note
        LET probe_n = LENF_N
        IF probe_n < MINL THEN
          LET ok_all = 0
          LET reason = "minl"
        END
        IF probe_n > MAXL THEN
          LET ok_all = 0
          LET reason = "maxl"
        END
        NONEMPTYF a0 note
        IF NONEMPTYF_N == 0 THEN
          LET ok_all = 0
          LET reason = "empty"
        END
        HASINF a0 note NEEDLE
        IF HASINF_N == 0 THEN
          LET ok_all = 0
          LET reason = "needle"
        END
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        LET o_ok = 1
        STARTSF a1 path PREFIX
        IF STARTSF_N == 0 THEN
          LET ok_all = 0
          LET reason = "prefix"
        END
        ENDSF a1 path SUFFIX
        IF ENDSF_N == 0 THEN
          LET ok_all = 0
          LET reason = "suffix"
        END
        LENF a1 note
        LET probe_n = LENF_N
        IF probe_n < MINL THEN
          LET ok_all = 0
          LET reason = "minl"
        END
        IF probe_n > MAXL THEN
          LET ok_all = 0
          LET reason = "maxl"
        END
        NONEMPTYF a1 note
        IF NONEMPTYF_N == 0 THEN
          LET ok_all = 0
          LET reason = "empty"
        END
        HASINF a1 note NEEDLE
        IF HASINF_N == 0 THEN
          LET ok_all = 0
          LET reason = "needle"
        END
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        LET o_ok = 1
        STARTSF a2 path PREFIX
        IF STARTSF_N == 0 THEN
          LET ok_all = 0
          LET reason = "prefix"
        END
        ENDSF a2 path SUFFIX
        IF ENDSF_N == 0 THEN
          LET ok_all = 0
          LET reason = "suffix"
        END
        LENF a2 note
        LET probe_n = LENF_N
        IF probe_n < MINL THEN
          LET ok_all = 0
          LET reason = "minl"
        END
        IF probe_n > MAXL THEN
          LET ok_all = 0
          LET reason = "maxl"
        END
        NONEMPTYF a2 note
        IF NONEMPTYF_N == 0 THEN
          LET ok_all = 0
          LET reason = "empty"
        END
        HASINF a2 note NEEDLE
        IF HASINF_N == 0 THEN
          LET ok_all = 0
          LET reason = "needle"
        END
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "admit miss"
      LET val = "deny"
      LET val_ch = 1
      FAIL "admit miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "admit miss"
      END
    ELSE
      IF ok_all == 1 THEN
        LET hit = 1
        LET note_msg = "admit ok"
        LET val = "admit"
        LET val_ch = 1
        IF slot == 0 THEN
          SETF a0 status "admitted"
          DUMPOBJ a0
          SYS WRITE d_a0 LAST
          CLEAR_ERR
        END
        IF slot == 1 THEN
          SETF a1 status "admitted"
          DUMPOBJ a1
          SYS WRITE d_a1 LAST
          CLEAR_ERR
        END
        IF slot == 2 THEN
          SETF a2 status "admitted"
          DUMPOBJ a2
          SYS WRITE d_a2 LAST
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "admit deny"
        LET val = "deny"
        LET val_ch = 1
        FAIL "admit deny"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "admit deny"
        END
      END
    END
  END
  LET meta = "admit"
  SYS PUSH meta sn
  LET meta = LAST
  SYS PUSH meta reason
  LET meta = LAST
  SYS STR probe_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- get path/note ---
SYS EQS ACTION "get"
IF LAST_N == 1 THEN
  NOTE "action get"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "get bad slot"
    FAIL "get bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "get bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        GETF a0 path
        LET val = LAST
        LET o_ok = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        GETF a1 path
        LET val = LAST
        LET o_ok = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        GETF a2 path
        LET val = LAST
        LET o_ok = 1
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "get miss"
      FAIL "get miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "get miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "get ok"
      LET val_ch = 1
      LET meta = "get"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- probe soft ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  TRYLENF nosuch_art note
  LET l_ok = OK
  CLEAR_ERR
  TRYHASINF nosuch_art note "x"
  LET h_ok = OK
  CLEAR_ERR
  TRYSTARTSF nosuch_art path "/"
  LET s_ok = OK
  CLEAR_ERR
  TRYENDSF nosuch_art path ".z"
  LET e_ok = OK
  CLEAR_ERR
  # empty needle always hits if live
  LET empty_hit = 0
  HASOBJ a0
  IF LAST_N == 1 THEN
    HASINF a0 note ""
    LET empty_hit = HASINF_N
    CLEAR_ERR
  END
  LET hit = 1
  LET note_msg = "probe ok"
  LET val = "soft"
  LET val_ch = 1
  LET meta = "probe"
  SYS STR l_ok
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR h_ok
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR s_ok
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR e_ok
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR empty_hit
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  IF l_ok != 0 THEN
    LET miss = 1
    LET note_msg = "probe len not soft"
  END
  IF h_ok != 0 THEN
    LET miss = 1
    LET note_msg = "probe has not soft"
  END
  PRINT_JSON l_ok
  PRINT_JSON h_ok
  PRINT_JSON empty_hit
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "dump bad slot"
    FAIL "dump bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "dump bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        DUMPOBJ a0
        LET val = LAST
        SYS WRITE d_a0 val
        LET o_ok = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        DUMPOBJ a1
        LET val = LAST
        SYS WRITE d_a1 val
        LET o_ok = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        DUMPOBJ a2
        LET val = LAST
        SYS WRITE d_a2 val
        LET o_ok = 1
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "dump miss"
      FAIL "dump miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "dump miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "dump ok"
      LET val_ch = 1
      LET meta = "dump"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ a0
  IF LAST_N == 1 THEN
    DELETEOBJ a0
    CLEAR_ERR
  END
  HASOBJ a1
  IF LAST_N == 1 THEN
    DELETEOBJ a1
    CLEAR_ERR
  END
  HASOBJ a2
  IF LAST_N == 1 THEN
    DELETEOBJ a2
    CLEAR_ERR
  END
  SYS WRITE d_a0 ""
  SYS WRITE d_a1 ""
  SYS WRITE d_a2 ""
  SYS WRITE objs_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

