# fleet_allowlist_merge.cubalc — durable dual-env allowlist set ops under STATE
#
# Real use: agents merge prod/stage service allowlists without shell
# sort|uniq|comm. Primary bag A and secondary bag B on plates; set ops
# write result back to A (or report only).
#
# Actions (CUBALC_ARG0 / CUBALC_AL_ACTION):
#   list      — depth A/B + AGE (default)
#   seed_a    — WORDS → bag A (HASLINE skip)
#   seed_b    — WORDS → bag B
#   add_a / add_b / drop_a / drop_b
#   union     — UNION A B → A (first-seen unique)
#   intersect — INTERSECT A B → A
#   diff      — DIFF A B → A (A not in B)
#   distinct  — DISTINCT A → A (full unique vs adjacent UNIQ)
#   zip       — ZIP A B [sep] → roles plate (default :)
#   keys      — KEYS of roles plate → print/report
#   vals      — VALS of roles plate
#   has_a / has_b / count_a
#   clear_a / clear_b
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed_a CUBALC_ARG1="api db mesh api" \
#     ./out/cubalc run -q -s programs/realworld/fleet_allowlist_merge.cubalc
#   CUBALC_ARG0=seed_b CUBALC_ARG1="db cache api" ./out/cubalc run -q -s ...
#   CUBALC_ARG0=union ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_AL_FILE_A=ALLOW_A.txt
#   CUBALC_AL_FILE_B=ALLOW_B.txt
#   CUBALC_AL_ROLES=ROLES.txt
#   CUBALC_AL_SEP=:
#   CUBALC_AL_REQUIRE=1   # EXIT 2 on empty op / drop miss
#
# Edges deliberately stressed:
#   UNION/INTERSECT/DIFF/DISTINCT/ZIP return LAST — must LET bag = LAST
#   DISTINCT is full unique; UNIQ only adjacent (needs SORT first)
#   ZIP unequal lengths pad empty partner (h3:  or :role)
#   KEYS/VALS peel; fields without sep → whole as key / empty val
#   GREP substring false friends; COUNTLINE exact
#   PRINT_JSON bag collapse; WRITE trailing NL
#   soft READ empty; REQUIRE miss paths
#   no string concat — ZIP is the structured join path

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "fleet_allowlist_merge: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT FA = "ALLOW_A.txt"
DEFAULT FB = "ALLOW_B.txt"
DEFAULT FR = "ROLES.txt"
DEFAULT REPORT = "ALLOW_REPORT.txt"
DEFAULT SEP = ":"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_AL_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_AL_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET SEP = LAST
ELSE
  SYS ENV "CUBALC_AL_SEP" OR ":"
  LET SEP = LAST
END
SYS ENV "CUBALC_AL_FILE_A" OR ""
IF LAST_N > 0 THEN
  LET FA = LAST
END
SYS ENV "CUBALC_AL_FILE_B" OR ""
IF LAST_N > 0 THEN
  LET FB = LAST
END
SYS ENV "CUBALC_AL_ROLES" OR ""
IF LAST_N > 0 THEN
  LET FR = LAST
END
SYS ENV "CUBALC_AL_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir FA
LET path_a = LAST
SYS JOIN state_dir FB
LET path_b = LAST
SYS JOIN state_dir FR
LET path_r = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR path_a OR ""
LET bag_a = LAST
CLEAR_ERR "soft A load"
SYS LINES bag_a
LET depth_a0 = LAST_N

SYS READ OR path_b OR ""
LET bag_b = LAST
CLEAR_ERR "soft B load"
SYS LINES bag_b
LET depth_b0 = LAST_N

SYS READ OR path_r OR ""
LET bag_r = LAST
CLEAR_ERR "soft roles load"
SYS LINES bag_r
LET depth_r0 = LAST_N

LET hit = 0
LET miss = 0
LET changed_a = 0
LET changed_b = 0
LET changed_r = 0
LET note_msg = "ok"
LET result = ""
LET n_out = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "allow" depth_a0 depth_b0 depth_r0 ACTION
  PRINT_JSON depth_a0 depth_b0 depth_r0 ACTION STATUS_OK
  PRINT_JSON bag_a
  PRINT_JSON bag_b
  PRINT_JSON bag_r
  LET note_msg = "list ok"
END

# --- seed_a ---
SYS EQS ACTION "seed_a"
IF LAST_N == 1 THEN
  NOTE "action seed_a"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed_a needs names"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      SYS HASLINE bag_a n
      IF LAST_N == 0 THEN
        SYS PUSH bag_a n
        LET bag_a = LAST
        LET changed_a = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded_a"
END

# --- seed_b ---
SYS EQS ACTION "seed_b"
IF LAST_N == 1 THEN
  NOTE "action seed_b"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed_b needs names"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      SYS HASLINE bag_b n
      IF LAST_N == 0 THEN
        SYS PUSH bag_b n
        LET bag_b = LAST
        LET changed_b = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded_b"
END

# --- add_a ---
SYS EQS ACTION "add_a"
IF LAST_N == 1 THEN
  NOTE "action add_a"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "add_a needs name"
  END
  SYS HASLINE bag_a NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET hit = 1
    LET note_msg = "add_a already"
  ELSE
    SYS PUSH bag_a NAME
    LET bag_a = LAST
    LET changed_a = 1
    LET hit = 1
    LET note_msg = "added_a"
  END
END

# --- add_b ---
SYS EQS ACTION "add_b"
IF LAST_N == 1 THEN
  NOTE "action add_b"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "add_b needs name"
  END
  SYS HASLINE bag_b NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET hit = 1
    LET note_msg = "add_b already"
  ELSE
    SYS PUSH bag_b NAME
    LET bag_b = LAST
    LET changed_b = 1
    LET hit = 1
    LET note_msg = "added_b"
  END
END

# --- drop_a ---
SYS EQS ACTION "drop_a"
IF LAST_N == 1 THEN
  NOTE "action drop_a"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop_a needs name"
  END
  SYS HASLINE bag_a NAME
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "drop_a miss"
    FAIL "drop_a miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop_a miss"
    END
  ELSE
    SYS REMOVELINE bag_a NAME
    LET bag_a = LAST
    LET changed_a = 1
    LET hit = 1
    LET note_msg = "dropped_a"
  END
END

# --- drop_b ---
SYS EQS ACTION "drop_b"
IF LAST_N == 1 THEN
  NOTE "action drop_b"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop_b needs name"
  END
  SYS HASLINE bag_b NAME
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "drop_b miss"
    FAIL "drop_b miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop_b miss"
    END
  ELSE
    SYS REMOVELINE bag_b NAME
    LET bag_b = LAST
    LET changed_b = 1
    LET hit = 1
    LET note_msg = "dropped_b"
  END
END

# --- union ---
SYS EQS ACTION "union"
IF LAST_N == 1 THEN
  NOTE "action union"
  SYS UNION bag_a bag_b
  LET bag_a = LAST
  SYS LINES bag_a
  LET n_out = LAST_N
  LET hit = n_out
  LET changed_a = 1
  LET note_msg = "unioned"
END

# --- intersect ---
SYS EQS ACTION "intersect"
IF LAST_N == 1 THEN
  NOTE "action intersect"
  SYS INTERSECT bag_a bag_b
  LET bag_a = LAST
  SYS LINES bag_a
  LET n_out = LAST_N
  LET hit = n_out
  LET changed_a = 1
  IF n_out == 0 THEN
    LET miss = 1
    LET note_msg = "intersect empty"
    FAIL "intersect empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "intersect empty"
    END
  ELSE
    LET note_msg = "intersected"
  END
END

# --- diff ---
SYS EQS ACTION "diff"
IF LAST_N == 1 THEN
  NOTE "action diff"
  SYS DIFF bag_a bag_b
  LET bag_a = LAST
  SYS LINES bag_a
  LET n_out = LAST_N
  LET hit = n_out
  LET changed_a = 1
  LET note_msg = "diffed"
END

# --- distinct ---
SYS EQS ACTION "distinct"
IF LAST_N == 1 THEN
  NOTE "action distinct"
  # inject intentional non-adjacent dups challenge via PUSH if empty skip
  SYS DISTINCT bag_a
  LET bag_a = LAST
  SYS LINES bag_a
  LET n_out = LAST_N
  LET hit = n_out
  LET changed_a = 1
  LET note_msg = "distinct"
END

# --- zip A with B → roles plate ---
SYS EQS ACTION "zip"
IF LAST_N == 1 THEN
  NOTE "action zip"
  SYS LINES bag_a
  LET da = LAST_N
  SYS LINES bag_b
  LET db = LAST_N
  IF da == 0 THEN
    LET miss = 1
    LET note_msg = "zip empty A"
    FAIL "zip empty A"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "zip empty"
    END
  ELSE
    # ZIP sep must be string literal — bare SEP var → unknown form 'SEP'
    SYS ZIP bag_a bag_b ":"
    LET bag_r = LAST
    SYS LINES bag_r
    LET n_out = LAST_N
    LET hit = n_out
    LET changed_r = 1
    LET note_msg = "zipped"
    PRINT_JSON bag_r
  END
END

# --- keys ---
SYS EQS ACTION "keys"
IF LAST_N == 1 THEN
  NOTE "action keys"
  SYS READ OR path_r OR ""
  LET bag_r = LAST
  CLEAR_ERR
  SYS LINES bag_r
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "keys empty roles"
    FAIL "keys empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "keys empty"
    END
  ELSE
    SYS KEYS bag_r ":"
    LET result = LAST
    SYS LINES result
    LET hit = LAST_N
    LET note_msg = "keys"
    PRINT_JSON result
  END
END

# --- vals ---
SYS EQS ACTION "vals"
IF LAST_N == 1 THEN
  NOTE "action vals"
  SYS READ OR path_r OR ""
  LET bag_r = LAST
  CLEAR_ERR
  SYS LINES bag_r
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "vals empty roles"
    FAIL "vals empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "vals empty"
    END
  ELSE
    SYS VALS bag_r ":"
    LET result = LAST
    SYS LINES result
    LET hit = LAST_N
    LET note_msg = "vals"
    PRINT_JSON result
  END
END

# --- has_a ---
SYS EQS ACTION "has_a"
IF LAST_N == 1 THEN
  NOTE "action has_a"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has_a needs name"
  END
  SYS HASLINE bag_a NAME
  LET hit = LAST_N
  LET note_msg = "has_a"
END

# --- has_b ---
SYS EQS ACTION "has_b"
IF LAST_N == 1 THEN
  NOTE "action has_b"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has_b needs name"
  END
  SYS HASLINE bag_b NAME
  LET hit = LAST_N
  LET note_msg = "has_b"
END

# --- count_a ---
SYS EQS ACTION "count_a"
IF LAST_N == 1 THEN
  NOTE "action count_a"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count_a needs name"
  END
  SYS COUNTLINE bag_a NAME
  LET hit = LAST_N
  LET note_msg = "count_a"
END

# --- clear_a ---
SYS EQS ACTION "clear_a"
IF LAST_N == 1 THEN
  NOTE "action clear_a"
  LET bag_a = ""
  LET changed_a = 1
  LET hit = 1
  LET note_msg = "cleared_a"
END

# --- clear_b ---
SYS EQS ACTION "clear_b"
IF LAST_N == 1 THEN
  NOTE "action clear_b"
  LET bag_b = ""
  LET changed_b = 1
  LET hit = 1
  LET note_msg = "cleared_b"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed_a"
LET k = k + LAST_N
SYS EQS ACTION "seed_b"
LET k = k + LAST_N
SYS EQS ACTION "add_a"
LET k = k + LAST_N
SYS EQS ACTION "add_b"
LET k = k + LAST_N
SYS EQS ACTION "drop_a"
LET k = k + LAST_N
SYS EQS ACTION "drop_b"
LET k = k + LAST_N
SYS EQS ACTION "union"
LET k = k + LAST_N
SYS EQS ACTION "intersect"
LET k = k + LAST_N
SYS EQS ACTION "diff"
LET k = k + LAST_N
SYS EQS ACTION "distinct"
LET k = k + LAST_N
SYS EQS ACTION "zip"
LET k = k + LAST_N
SYS EQS ACTION "keys"
LET k = k + LAST_N
SYS EQS ACTION "vals"
LET k = k + LAST_N
SYS EQS ACTION "has_a"
LET k = k + LAST_N
SYS EQS ACTION "has_b"
LET k = k + LAST_N
SYS EQS ACTION "count_a"
LET k = k + LAST_N
SYS EQS ACTION "clear_a"
LET k = k + LAST_N
SYS EQS ACTION "clear_b"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF changed_a > 0 THEN
  SYS WRITE path_a bag_a
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "write A failed"
  END
  CLEAR_ERR
END
IF changed_b > 0 THEN
  SYS WRITE path_b bag_b
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "write B failed"
  END
  CLEAR_ERR
END
IF changed_r > 0 THEN
  SYS WRITE path_r bag_r
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "write roles failed"
  END
  CLEAR_ERR
END

SYS LINES bag_a
LET depth_a1 = LAST_N
SYS LINES bag_b
LET depth_b1 = LAST_N
SYS LINES bag_r
LET depth_r1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.allowlist.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "name"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_out"
LET report = LAST
SYS STR n_out
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_a0"
LET report = LAST
SYS STR depth_a0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_a1"
LET report = LAST
SYS STR depth_a1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_b0"
LET report = LAST
SYS STR depth_b0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_b1"
LET report = LAST
SYS STR depth_b1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "allow" ACTION hit miss n_out depth_a0 depth_a1 depth_b0 depth_b1
PRINT_JSON ACTION hit miss n_out depth_a0 depth_a1 depth_b0 depth_b1 depth_r1 elapsed STATUS_OK
PASS "allow tick"
NOTE "fleet_allowlist_merge: done"
CLEAR_ERR
EXIT 0 "allow ok"
