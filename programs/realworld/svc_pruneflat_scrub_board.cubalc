# svc_pruneflat_scrub_board.cubalc — PRUNEFLAT nest noise/secret write-back scrub
#
# Real use: before mesh share, drop tmp/debug/secret leaves in place without
# multi DELP or GREPFLAT+UNFLAT glue. KEEPONLYFLAT projects cfg.* only.
# First realworld of proof 1215 PRUNEFLAT/KEEPONLYFLAT/DELFLAT.
#
#   PRUNEFLAT|DELFLAT [FROM plate] needle  — drop matching leaves · write-back
#   KEEPONLYFLAT [FROM plate] needle       — keep only matching leaves
#   LAST = plate JSON after · LAST_N = PRUNEFLAT_N pruned count
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_spf_$$
#   ./out/cubalc run programs/realworld/svc_pruneflat_scrub_board.cubalc boot
#   ./out/cubalc run ... prune|keep|secret|peer|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SPF_REPORT.txt PLATE_OUT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SPF_REQUIRE
#
# Edges: tmp multi-leaf prune; empty parent residual; KEEPONLY project;
#   secret path substring; peer FROM; soft ghost/empty needle; DELFLAT;
#   WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_pruneflat_scrub_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_pruneflat_scrub -- boot|prune|keep|secret|peer|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SPF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "PLATE_OUT.txt"
LET out_file = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SPF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "prune", "keep", "secret", "peer", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "prune" THEN
    LET op = "prune"
  WHEN "keep" THEN
    LET op = "keep"
  WHEN "secret" THEN
    LET op = "secret"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-pruneflat\",\"schema\":\"cubalc.svc_pruneflat_scrub.v1\",\"site\":\"" host_s "\",\"cfg\":{\"meta\":{\"role\":\"worker\",\"tmp\":1},\"port\":\"8080\",\"secret\":\"s3cr3t\"},\"tmp\":{\"scratch\":1},\"label\":\"pruneflat\",\"debug\":1}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_pruneflat_scrub.v1\",\"a\":{\"status\":\"ok\",\"tmp\":9},\"b\":{\"status\":\"ok\"},\"tmp_peer\":1,\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "cfg.secret"
  SYS EQS LAST "s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.tmp"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "debug"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# prune — drop tmp noise leaves (write-back)
SYS EQS op "prune"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # reseed noise for idempotent action
  SETP "cfg.meta.tmp" "1"
  CLEAR_ERR
  SETP "tmp.scratch" "1"
  CLEAR_ERR
  SETP "debug" "1"
  CLEAR_ERR
  PRUNEFLAT "tmp"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF PRUNEFLAT_N == 2 THEN
    LET score = score + 1
  END
  HASP "cfg.meta.tmp"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP "tmp.scratch"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # port kept
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty parent residual may remain as tmp:{}
  TYPEP "tmp"
  LET row = LAST
  CLEAR_ERR
  SYS EQS row "obj"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PRUNEFLAT "debug"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASP "debug"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  SYS WRITE out_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "prune ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "prune score"
    FAIL "prune score"
    CLEAR_ERR
  END
  SYS CAT "prune:" find_n ":pn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "prune:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# keep — KEEPONLYFLAT project cfg.*
SYS EQS op "keep"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # reseed full plate for project test
  SYS CAT "{\"agent\":\"svc-pruneflat\",\"schema\":\"cubalc.svc_pruneflat_scrub.v1\",\"site\":\"" host_s "\",\"cfg\":{\"meta\":{\"role\":\"worker\"},\"port\":\"8080\"},\"label\":\"pruneflat\",\"n\":3}"
  LET PLATE = LAST
  CLEAR_ERR
  KEEPONLYFLAT "cfg"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF KEEPONLYFLAT_N == 2 THEN
    LET score = score + 1
  END
  HASP "label"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP "n"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP "agent"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore agent from seed file (not projected plate)
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE out_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "keep ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "keep score"
    FAIL "keep score"
    CLEAR_ERR
  END
  SYS CAT "keep:" find_n ":kp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "keep:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# secret — path-substring scrub of secret leaves
SYS EQS op "secret"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "cfg.secret" "s3cr3t"
  CLEAR_ERR
  # substring needle sec matches secret
  PRUNEFLAT "sec"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  HASP "cfg.secret"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # second secret prune is no-op
  PRUNEFLAT "secret"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  SYS WRITE out_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "secret ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "secret score"
    FAIL "secret score"
    CLEAR_ERR
  END
  SYS CAT "secret:" find_n ":se"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "secret:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# peer — multi-plate tmp scrub (also hits tmp_peer substring)
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP FROM PEER "a.tmp" "9"
  CLEAR_ERR
  SETP FROM PEER "tmp_peer" "1"
  CLEAR_ERR
  PRUNEFLAT FROM PEER "tmp"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF PRUNEFLAT_FROM == 1 THEN
    LET score = score + 1
  END
  SYS EQS PRUNEFLAT_SRC "PEER"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP FROM PEER "a.tmp"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP FROM PEER "tmp_peer"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "a.status"
  SYS EQS LAST "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  SYS WRITE out_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" find_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — ghost + empty needle no-op
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PRUNEFLAT "ghostpath"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF PRUNEFLAT_N == 0 THEN
    LET score = score + 1
  END
  PRUNEFLAT ""
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — admit when no secret and no debug (share-safe)
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # ensure clean
  PRUNEFLAT "secret"
  CLEAR_ERR
  PRUNEFLAT "debug"
  CLEAR_ERR
  HASP "cfg.secret"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP "debug"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_pruneflat_scrub"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — DELFLAT
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # unique leaf name — short needle "c" also matches cfg/schema paths (substring)
  SETP "a.b" "1"
  CLEAR_ERR
  SETP "a.dropme" "2"
  CLEAR_ERR
  DELFLAT "dropme"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  IF DELFLAT_N == 1 THEN
    LET score = score + 1
  END
  HASP "a.dropme"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "a.b"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE out_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" find_n ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — edges
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "cfg.secret" "s3cr3t"
  CLEAR_ERR
  SETP "cfg.meta.tmp" "1"
  CLEAR_ERR
  # value needle does not prune
  PRUNEFLAT "s3cr3t"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  HASP "cfg.secret"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # path substring sec
  PRUNEFLAT "sec"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASP "cfg.secret"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty needle no-op
  PRUNEFLAT ""
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "pruneflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_pruneflat_scrub.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_pruneflat_scrub_board: end"
