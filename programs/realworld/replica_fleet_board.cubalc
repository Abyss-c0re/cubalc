SYS MS
LET t1ms = MS
LET dt = t1ms - t0ms
# fleet_rep predeclared at start (late LET+SYS PUSH bag after FINDOBJ/-s was flaky)
SYS PUSH fleet_rep run_date
LET fleet_rep = LAST
SYS PUSH fleet_rep ACTION
LET fleet_rep = LAST
SYS PUSH fleet_rep note_msg
LET fleet_rep = LAST
SYS STR hit
SYS PUSH fleet_rep LAST
LET fleet_rep = LAST
SYS STR miss
SYS PUSH fleet_rep LAST
LET fleet_rep = LAST
SYS STR dt
SYS PUSH fleet_rep LAST
LET fleet_rep = LAST
SYS WRITE report_path fleet_rep
CLEAR_ERR

NOTE "replica_fleet_board: done"
IF miss > 0 THEN
  IF REQUIRE_HIT > 0 THEN
    EXIT 2 note_msg
  END
END
EXIT 0 note_msg
