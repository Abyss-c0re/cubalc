# svc_insertmatchfile_runbook_inject_board.cubalc — INSERTMATCHFILE runbook inject
#
# Real use: agents inject runbook/pipeline steps after or before a marker
# line on disk without rewriting the whole file. Surface:
#   INSERTMATCHFILE · AFTERMATCHFILE · BEFOREMATCHFILE · HASFILELINE
#   COUNTFILELINE · READ/WRITE · FINDLINE on bag materialize
#
# Challenge (substring match like SETMATCHFILE W918):
#   needle "step:build" matches "step:build-extra" FIRST — inject lands
#   on the wrong step. Prefer unique full tokens or exact HASFILELINE
#   verify after inject.
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_imf_$$
#   ./out/cubalc run programs/realworld/svc_insertmatchfile_runbook_inject_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IMF_REPORT.txt agent.json books/runbook.txt
# Env: HOST_S ROLE_S CUBALC_IMF_REQUIRE

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN seed_runbook
  SYS JOIN "" "# runbook\nstep:init\nstep:build\nstep:test\nstep:deploy\n# end"
  LET body = LAST
  SYS WRITE book_path body
  CLEAR_ERR
END

FN seed_false_friend
  SYS JOIN "" "# runbook\nstep:init\nstep:build-extra\nstep:build\nstep:test\n# end"
  LET body = LAST
  SYS WRITE book_path body
  CLEAR_ERR
END

FN inject_after_build
  LET state = "miss"
  LET ok_v = 0
  SYS INSERTMATCHFILE book_path "step:build" "step:scan"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:scan"
  IF LAST_N == 1 THEN
    LET state = "injected"
    LET ok_v = 1
  ELSE
    LET state = "miss"
    LET ok_v = 0
  END
END

FN inject_before_deploy
  LET state = "miss"
  LET ok_v = 0
  SYS BEFOREMATCHFILE book_path "step:deploy" "step:approve"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:approve"
  IF LAST_N == 1 THEN
    LET state = "injected"
    LET ok_v = 1
  ELSE
    LET state = "miss"
    LET ok_v = 0
  END
END

FN inject_after_test
  LET state = "miss"
  LET ok_v = 0
  SYS AFTERMATCHFILE book_path "step:test" "step:lint"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:lint"
  IF LAST_N == 1 THEN
    LET state = "injected"
    LET ok_v = 1
  ELSE
    LET state = "miss"
    LET ok_v = 0
  END
END

FN order_ok_scan_after_build
  LET ok_v = 0
  SYS READ book_path
  LET body = LAST
  CLEAR_ERR
  SYS FINDLINE body "step:build"
  LET i_build = LAST_N
  SYS FINDLINE body "step:scan"
  LET i_scan = LAST_N
  IF i_scan == i_build + 1 THEN
    LET ok_v = 1
  END
END

FN admit_has_scan
  LET state = "deny"
  LET ok_v = 0
  SYS HASFILELINE book_path "step:scan"
  IF LAST_N == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  ELSE
    LET state = "deny"
    LET ok_v = 0
  END
END

NOTE "svc_insertmatchfile_runbook_inject_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_insertmatchfile_runbook_inject -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IMF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IMF_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "books"
LET books_dir = LAST
SYS JOIN books_dir "runbook.txt"
LET book_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET state = ""
LET saved = 0
LET i_build = 0
LET i_scan = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-imf\",\"schema\":\"cubalc.svc_insertmatchfile_runbook_inject.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"imf\",\"want_filter\":\"insertmatchfile_runbook_inject\",\"cfg\":{\"surface\":\"INSERTMATCHFILE,AFTERMATCHFILE,BEFOREMATCHFILE,HASFILELINE,COUNTFILELINE\",\"contract\":\"disk runbook step inject after/before marker with substring false-friend guard\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR books_dir
  CLEAR_ERR
  CALL seed_runbook
  CLEAR_ERR
  CALL inject_after_build
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-imf"
  IF LAST_N == 1 THEN
    SYS EQS state "injected"
    IF LAST_N == 1 THEN
      CALL order_ok_scan_after_build
      IF ok_v == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot order"
        FAIL "boot order"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot inject"
      FAIL "boot inject"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — inject after/before + order + alias
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR books_dir
  CLEAR_ERR
  CALL seed_runbook
  CLEAR_ERR
  CALL inject_after_build
  SYS EQS state "injected"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL order_ok_scan_after_build
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL inject_after_test
  SYS EQS state "injected"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASFILELINE book_path "step:lint"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL inject_before_deploy
  SYS EQS state "injected"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ book_path
  LET body = LAST
  CLEAR_ERR
  SYS FINDLINE body "step:approve"
  LET i_build = LAST_N
  SYS FINDLINE body "step:deploy"
  LET i_scan = LAST_N
  IF i_scan == i_build + 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASFILELINE book_path "step:scan"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS COUNTFILELINE book_path "step:"
  IF LAST_N >= 6 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "INSERTMATCHFILE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — miss · false-friend substring · empty path
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR books_dir
  CLEAR_ERR
  CALL seed_runbook
  CLEAR_ERR
  # miss marker soft
  SYS INSERTMATCHFILE book_path "step:gone" "step:x"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:x"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS BEFOREMATCHFILE book_path "step:gone" "step:y"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:y"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # false-friend: build-extra before build
  CALL seed_false_friend
  CLEAR_ERR
  SYS INSERTMATCHFILE book_path "step:build" "step:injected"
  CLEAR_ERR
  SYS READ book_path
  LET body = LAST
  CLEAR_ERR
  SYS FINDLINE body "step:build-extra"
  LET i_build = LAST_N
  SYS FINDLINE body "step:injected"
  LET i_scan = LAST_N
  # inject lands after first substring hit (build-extra)
  IF i_scan == i_build + 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS FINDLINE body "step:build"
  LET i_build = LAST_N
  # injected is before true step:build when false-friend wins
  IF i_scan < i_build THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # unique needle avoids false friend
  CALL seed_false_friend
  CLEAR_ERR
  SYS INSERTMATCHFILE book_path "step:build\n" "step:safe"
  CLEAR_ERR
  # newline in needle may not work — use full unique if present
  SYS INSERTMATCHFILE book_path "step:test" "step:safe"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:safe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ book_path
  LET body = LAST
  CLEAR_ERR
  SYS FINDLINE body "step:test"
  LET i_build = LAST_N
  SYS FINDLINE body "step:safe"
  LET i_scan = LAST_N
  IF i_scan == i_build + 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # miss path soft
  SYS INSERTMATCHFILE "/no/such/runbook" "step:build" "step:x"
  CLEAR_ERR
  IF OK >= 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASFILELINE "/no/such/runbook" "step:x"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty file
  SYS WRITE book_path ""
  CLEAR_ERR
  SYS INSERTMATCHFILE book_path "step:build" "step:x"
  CLEAR_ERR
  SYS HASFILELINE book_path "step:x"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — full inject pipeline on disk
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR books_dir
  CLEAR_ERR
  CALL seed_runbook
  CLEAR_ERR
  CALL inject_after_build
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL inject_after_test
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL inject_before_deploy
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL order_ok_scan_after_build
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ book_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "step:scan"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "step:lint"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "step:approve"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_has_scan
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "false-friend"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — admit only after required inject
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR books_dir
  CLEAR_ERR
  CALL seed_runbook
  CLEAR_ERR
  CALL admit_has_scan
  SYS EQS state "deny"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL inject_after_build
  CALL admit_has_scan
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL order_ok_scan_after_build
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # re-inject same may duplicate?
  SYS INSERTMATCHFILE book_path "step:build" "step:scan"
  CLEAR_ERR
  SYS COUNTFILELINE book_path "step:scan"
  LET saved = LAST_N
  IF saved >= 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL inject_before_deploy
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL inject_after_test
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS COUNTFILELINE book_path "step:"
  IF LAST_N >= 6 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "AFTERMATCHFILE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "BEFOREMATCHFILE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

