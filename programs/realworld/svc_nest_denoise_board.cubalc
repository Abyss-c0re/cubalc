# svc_nest_denoise_board.cubalc — THRESHOBJ/DROPZEROOBJ/CAPOBJ nest FREQ denoise
#
# Real use: fleet metric agents drop zero counters, threshold noise floors,
# and cap outlier spikes in nested FREQ maps before handoff. First realworld
# of proof 1184 (MEANINGFUL 643).
#
#   DROPZEROOBJ nest            · KEEPNZOBJ alias
#   THRESHOBJ nest min          · KEEPVOBJ / MINCOUNTOBJ / NESTTHRESH
#   CAPOBJ nest max             · CLAMPOBJ
#   … FROM PEER multi-plate
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_snd_$$
#   ./out/cubalc run programs/realworld/svc_nest_denoise_board.cubalc boot
#   ./out/cubalc run ... dropz|thresh|cap|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SND_REPORT.txt agent.json peer.json keys.txt
# Env: HOST_S ROLE_S MIN_T MAX_C CUBALC_SND_REQUIRE
#
# Edges:
#   soft nest miss; non-int keys dropped by thresh; zeros kept by CAP;
#   WRITE NL; NUM softens REQUIRE; EXIT shell (W7); min/max literal limits

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_nest_denoise_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_nest_denoise -- boot|dropz|thresh|cap|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeD"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT MIN_T = "5"
GETFLAG mint|t OR ENV MIN_T OR MIN_T
LET min_t_s = LAST
CLEAR_ERR

DEFAULT MAX_C = "20"
GETFLAG maxc|c OR ENV MAX_C OR MAX_C
LET max_c_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SND_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

LET min_t = 5
SYS NUM min_t_s
IF OK == 1 THEN
  LET min_t = LAST_N
END
CLEAR_ERR

LET max_c = 20
SYS NUM max_c_s
IF OK == 1 THEN
  LET max_c = LAST_N
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SND_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "keys.txt"
LET keys_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET key_bag = ""
LET soft_ok = 0
LET gate_ok = 0
LET keep_n = 0

ONEOF ACTION "boot", "dropz", "thresh", "cap", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "dropz" THEN
    LET op = "dropz"
  WHEN "thresh" THEN
    LET op = "thresh"
  WHEN "cap" THEN
    LET op = "cap"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s min_t max_c
  CLEAR_ERR
END

# boot — seed freq with zeros, noise, outlier
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-denoise\",\"schema\":\"cubalc.svc_nest_denoise.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"freq\":{\"a\":0,\"b\":3,\"c\":10,\"d\":100,\"noise\":1},\"cfg\":{\"port\":8080}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"freq\":{\"x\":0,\"y\":5,\"z\":50},\"tag\":\"t\",\"schema\":\"cubalc.svc_nest_denoise.v1\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LENOBJ "freq"
  LET keep_n = LAST_N
  CLEAR_ERR
  KEYSOBJ "freq"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "a"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST host_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF keep_n == 5 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET take_n = 5
        LET load_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot host"
        FAIL "boot host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot zero key"
      FAIL "boot zero key"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot len"
    FAIL "boot len"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n has_n peel_hit note_msg
  CLEAR_ERR
END

# dropz — DROPZEROOBJ
SYS EQS op "dropz"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  DROPZEROOBJ "freq"
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  KEYSOBJ "freq"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "a"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "b"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "d"
  LET load_hit = LAST_N
  CLEAR_ERR
  LENOBJ "freq"
  LET keep_n = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF keep_n == 4 THEN
          LET hit = 1
          LET note_msg = "dropz ok"
          LET admit_n = 1
          LET take_n = 4
        ELSE
          LET miss = 1
          LET note_msg = "dropz len"
          FAIL "dropz len"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "dropz d"
        FAIL "dropz d"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "dropz b"
      FAIL "dropz b"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "dropz a remain"
    FAIL "dropz a remain"
    CLEAR_ERR
  END
  SYS STR keep_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "dropz:" w_s ":dz"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "dropz:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# thresh — THRESHOBJ min (literal 5 default via branch)
SYS EQS op "thresh"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # THRESHOBJ min is literal-oriented — branch common mins
  SYS EQS min_t_s "3"
  IF LAST_N == 1 THEN
    THRESHOBJ "freq" 3
  ELSE
    THRESHOBJ "freq" 5
    LET min_t = 5
  END
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  KEYSOBJ "freq"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "c"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "d"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "b"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "noise"
  LET miss_n = LAST_N
  CLEAR_ERR
  LENOBJ "freq"
  LET keep_n = LAST_N
  CLEAR_ERR
  # after dropz+thresh@5: expect c,d only (b=3 noise=1 dropped)
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 0 THEN
        IF miss_n == 0 THEN
          IF keep_n == 2 THEN
            LET hit = 1
            LET note_msg = "thresh ok"
            LET admit_n = 1
            LET take_n = 2
          ELSE
            LET miss = 1
            LET note_msg = "thresh len"
            FAIL "thresh len"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "thresh noise"
          FAIL "thresh noise"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "thresh b remain"
        FAIL "thresh b remain"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "thresh d"
      FAIL "thresh d"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "thresh c"
    FAIL "thresh c"
    CLEAR_ERR
  END
  SYS STR keep_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "thresh:" w_s ":th"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "thresh:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# cap — CAPOBJ clamp outliers
SYS EQS op "cap"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS EQS max_c_s "50"
  IF LAST_N == 1 THEN
    CAPOBJ "freq" 50
    LET max_c = 50
  ELSE
    CAPOBJ "freq" 20
    LET max_c = 20
  END
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETPOBJ "freq" "d"
  LET body = LAST
  CLEAR_ERR
  SYS NUM body
  LET take_n = LAST_N
  CLEAR_ERR
  GETPOBJ "freq" "c"
  SYS EQS LAST "10"
  LET has_n = LAST_N
  CLEAR_ERR
  LENOBJ "freq"
  LET keep_n = LAST_N
  CLEAR_ERR
  # d was 100 → capped to max_c (20)
  LET peel_hit = 0
  IF take_n == max_c THEN
    LET peel_hit = 1
  END
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF keep_n >= 2 THEN
        LET hit = 1
        LET note_msg = "cap ok"
        LET admit_n = 1
        LET load_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "cap len"
        FAIL "cap len"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "cap c"
      FAIL "cap c"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "cap d val"
    FAIL "cap d val"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "cap:" w_s ":cp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "cap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n keep_n max_c note_msg
  CLEAR_ERR
END

# peer — DROPZERO + THRESH FROM PEER
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  DROPZEROOBJ FROM PEER "freq"
  CLEAR_ERR
  THRESHOBJ FROM PEER "freq" 5
  CLEAR_ERR
  KEYSOBJ FROM PEER "freq"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "x"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "y"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "z"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  LET soft_ok = LAST_N
  CLEAR_ERR
  LENOBJ FROM PEER "freq"
  LET keep_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SAVEP FROM PEER peer_path
  CLEAR_ERR
  # y=5 z=50 kept; x=0 dropped
  IF has_n == 0 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF soft_ok == 1 THEN
          IF keep_n == 2 THEN
            LET hit = 1
            LET note_msg = "peer ok"
            LET admit_n = 1
            LET take_n = 2
          ELSE
            LET miss = 1
            LET note_msg = "peer len"
            FAIL "peer len"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer tag"
          FAIL "peer tag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer z"
        FAIL "peer z"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer y"
      FAIL "peer y"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer x remain"
    FAIL "peer x remain"
    CLEAR_ERR
  END
  SYS STR keep_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "peer:" w_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n has_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

# soft — nest miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  THRESHOBJ "ghost" 1
  LET soft_ok = 0
  IF OK == 1 THEN
    LET soft_ok = 1
  END
  CLEAR_ERR
  HASP "ghost"
  LET has_n = LAST_N
  CLEAR_ERR
  DROPZEROOBJ "ghost"
  CLEAR_ERR
  CAPOBJ "ghost" 10
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-denoise"
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF soft_ok == 1 THEN
    IF has_n == 0 THEN
      IF take_n == 0 THEN
        IF peel_hit == 1 THEN
          LET hit = 1
          LET note_msg = "soft ok"
          LET admit_n = 1
          LET load_hit = 1
        ELSE
          LET miss = 1
          LET note_msg = "soft agent"
          FAIL "soft agent"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft empty bag"
        FAIL "soft empty bag"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft ghost created"
      FAIL "soft ghost created"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft thresh ok"
    FAIL "soft thresh ok"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok has_n peel_hit note_msg
  CLEAR_ERR
END

# gate — denoise result: no zeros, keys c/d or y/z style clean
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  KEYSOBJ "freq"
  LET key_bag = LAST
  CLEAR_ERR
  SYS HASLINE key_bag "a"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "c"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPOBJ "freq" "d" OR "0"
  LET body = LAST
  CLEAR_ERR
  SYS NUM body
  LET take_n = LAST_N
  CLEAR_ERR
  LET load_hit = 0
  IF take_n <= max_c THEN
    IF take_n > 0 THEN
      LET load_hit = 1
    END
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_nest_denoise"
  LET miss_n = LAST_N
  CLEAR_ERR
  # false friend: key "noise" gone
  SYS HASLINE key_bag "noise"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF miss_n == 1 THEN
          IF soft_ok == 0 THEN
            LET hit = 1
            LET gate_ok = 1
            LET admit_n = 1
            LET note_msg = "gate ok"
          ELSE
            LET miss = 1
            LET note_msg = "gate noise remain"
            FAIL "gate noise remain"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate schema"
          FAIL "gate schema"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate d cap"
        FAIL "gate d cap"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate c"
      FAIL "gate c"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate zero key"
    FAIL "gate zero key"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok has_n peel_hit take_n note_msg
  CLEAR_ERR
END

# probe — aliases + reseed mini nest
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FROMKVOBJ "board" "p1:40\np2:150\np3:80\nname:run"
  CLEAR_ERR
  CLAMPOBJ "board" 100
  CLEAR_ERR
  GETPOBJ "board" "p2"
  SYS EQS LAST "100"
  LET has_n = LAST_N
  CLEAR_ERR
  GETPOBJ "board" "name"
  SYS EQS LAST "run"
  LET peel_hit = LAST_N
  CLEAR_ERR
  KEEPNZOBJ "board"
  CLEAR_ERR
  FROMKVOBJ "tiny" "z:0\nw:9"
  CLEAR_ERR
  KEEPNZOBJ "tiny"
  CLEAR_ERR
  HASPOBJ "tiny" "z"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETPOBJ "tiny" "w"
  SYS EQS LAST "9"
  LET take_n = LAST_N
  CLEAR_ERR
  NESTTHRESH "tiny" 9
  CLEAR_ERR
  HASPOBJ "tiny" "w"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-denoise"
  LET miss_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 0 THEN
        IF take_n == 1 THEN
          IF soft_ok == 1 THEN
            IF miss_n == 1 THEN
              LET hit = 1
              LET note_msg = "probe ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "probe agent"
              FAIL "probe agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe nestthresh"
            FAIL "probe nestthresh"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe keepnz w"
          FAIL "probe keepnz w"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe z remain"
        FAIL "probe z remain"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe name"
      FAIL "probe name"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe clamp"
    FAIL "probe clamp"
    CLEAR_ERR
  END
  SYS CAT "probe:alias:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_nest_denoise.v1 host=" host_s " role=" role_s " mint=" min_t " maxc=" max_c " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " keep=" keep_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_nest_denoise_board: end"
