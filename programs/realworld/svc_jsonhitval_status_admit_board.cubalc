# svc_jsonhitval_status_admit_board.cubalc — JSONHITVAL/JSONFIRSTVAL status admit
#
# Real use: multi-vendor intake admits peers when *status value* is ready
# without knowing which key holds it (status|state|legacy_status|phase) and
# without EQS-branch peel after JSONHITKEY (W904 workaround from iter 377).
# First realworld of SYS JSONHITVAL/JSONFIRSTVAL (1.15.960 · MI 960). Soft
# dual of JSONHITKEY that peels VALUE + names key (JSONHITVAL_KEY).
#
#   JSONHITVAL · JSONFIRSTVAL · JHITVAL · JSONHITVAL_N · JSONHITVAL_HIT
#   JSONHITVAL_KEY · OF bag · null→"" false→"0" · id value peel
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_jhv_$$
#   ./out/cubalc run programs/realworld/svc_jsonhitval_status_admit_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt JHV_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_JHV_REQUIRE
#
# Edges: candidate order; all-miss soft; empty candidates; OF bag;
#   null/false present as empty/"0"; bool true→"1"; sticky key+val

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# peel first present status *value* among status|state|legacy_status|phase
FN peel_status_val
  LET val = ""
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JSONHITVAL plate "status" "state" "legacy_status" "phase"
  IF JSONHITVAL_HIT == 1 THEN
    LET val = LAST
    LET hit_key = JSONHITVAL_KEY
    LET hit_idx = JSONHITVAL_N
    LET ok_v = 1
  ELSE
    LET val = ""
    LET hit_key = ""
    LET hit_idx = 0
    LET ok_v = 0
  END
END

# peel first present identity *value*
FN peel_id_val
  LET val = ""
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JSONHITVAL plate "id" "uuid" "agent_id" "name"
  IF JSONHITVAL_HIT == 1 THEN
    LET val = LAST
    LET hit_key = JSONHITVAL_KEY
    LET hit_idx = JSONHITVAL_N
    LET ok_v = 1
  ELSE
    LET val = ""
    LET hit_key = ""
    LET hit_idx = 0
    LET ok_v = 0
  END
END

# JSONFIRSTVAL alias
FN peel_status_first
  LET val = ""
  LET hit_key = ""
  LET ok_v = 0
  SYS JSONFIRSTVAL plate "status" "state" "legacy_status" "phase"
  IF JSONHITVAL_HIT == 1 THEN
    LET val = LAST
    LET hit_key = JSONHITVAL_KEY
    LET ok_v = 1
  END
END

# OF-bag candidate list for status values
FN peel_status_ofbag
  LET val = ""
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JOIN "" "phase\nstate\nlegacy_status\nstatus"
  LET kbag = LAST
  SYS JSONHITVAL plate OF kbag
  IF JSONHITVAL_HIT == 1 THEN
    LET val = LAST
    LET hit_key = JSONHITVAL_KEY
    LET hit_idx = JSONHITVAL_N
    LET ok_v = 1
  END
END

# admit when status value is ready/ok/live (one-shot hitval)
# Note: peel_status_val sets ok_v=1 on any present status key — must reset
# ok_v before ready/ok/live EQS or deny-status never sticks (W910).
FN admit_ready
  LET state = "deny-no-status"
  LET ok_v = 0
  CALL peel_status_val
  IF ok_v == 0 THEN
    LET state = "deny-no-status"
  ELSE
    LET state = "deny-status"
    LET ok_v = 0
    SYS EQS val "ready"
    IF LAST_N == 1 THEN
      LET state = "admit"
      LET ok_v = 1
    END
    CLEAR_ERR
    SYS EQS val "ok"
    IF LAST_N == 1 THEN
      LET state = "admit"
      LET ok_v = 1
    END
    CLEAR_ERR
    SYS EQS val "live"
    IF LAST_N == 1 THEN
      LET state = "admit"
      LET ok_v = 1
    END
    CLEAR_ERR
  END
END

# admit when both identity value and ready status present
FN admit_identified_ready
  LET state = "deny"
  LET ok_v = 0
  CALL peel_id_val
  IF ok_v == 0 THEN
    LET state = "deny-no-id"
  ELSE
    LET id_val = val
    LET id_key = hit_key
    CALL peel_status_val
    IF ok_v == 0 THEN
      LET state = "deny-no-status"
    ELSE
      LET state = "deny-status"
      LET ok_v = 0
      SYS EQS val "ready"
      IF LAST_N == 1 THEN
        LET state = "admit"
        LET ok_v = 1
      END
      CLEAR_ERR
      SYS EQS val "ok"
      IF LAST_N == 1 THEN
        LET state = "admit"
        LET ok_v = 1
      END
      CLEAR_ERR
      SYS EQS val "live"
      IF LAST_N == 1 THEN
        LET state = "admit"
        LET ok_v = 1
      END
      CLEAR_ERR
    END
  END
END

NOTE "svc_jsonhitval_status_admit_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_jsonhitval_status_admit -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_JHV_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JHV_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "intake.json"
LET intake_path = LAST
SYS JOIN plate_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET plate = ""
LET hit_key = ""
LET hit_idx = 0
LET val = ""
LET state = ""
LET saved = 0
LET kbag = ""
LET id_val = ""
LET id_key = ""

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-jhv\",\"schema\":\"cubalc.svc_jsonhitval_status_admit.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"jhv\",\"want_filter\":\"jsonhitval_status_admit\",\"cfg\":{\"surface\":\"JSONHITVAL,JSONFIRSTVAL,JHITVAL,JSONHITVAL_N,JSONHITVAL_HIT,JSONHITVAL_KEY\",\"contract\":\"first-present status/id value peel for multi-vendor admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE intake_path "{\"agent_id\":\"w-9\",\"legacy_status\":\"ok\",\"code\":0}"
  SYS WRITE peer_path "{\"uuid\":\"u-1\",\"state\":\"ready\",\"n\":1}"
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_status_val
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jhv"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      SYS EQS val "ok"
      IF LAST_N == 1 THEN
        SYS EQS hit_key "legacy_status"
        IF LAST_N == 1 THEN
          IF hit_idx == 3 THEN
            LET hit = 1
            LET note_msg = "boot ok"
            LET admit_n = 1
            LET score = 1
            LET find_n = hit_idx
          ELSE
            LET miss = 1
            LET note_msg = "boot idx"
            FAIL "boot idx"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "boot key"
          FAIL "boot key"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot val"
        FAIL "boot val"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot hit"
      FAIL "boot hit"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core 10/10 value peel semantics
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # 1-3: legacy_status value + key + idx
  LET plate = "{\"agent_id\":\"w-9\",\"legacy_status\":\"ok\",\"code\":0}"
  CALL peel_status_val
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  # 4-5: candidate order prefers status over legacy
  LET plate = "{\"legacy_status\":\"ok\",\"status\":\"ready\"}"
  CALL peel_status_val
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 6: JSONFIRSTVAL alias
  CALL peel_status_first
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 7-8: id value peel uuid before name
  LET plate = "{\"uuid\":\"u-1\",\"name\":\"peer\"}"
  CALL peel_id_val
  SYS EQS val "u-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "uuid"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 9-10: all-miss soft
  LET plate = "{\"n\":1}"
  CALL peel_status_val
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF JSONHITVAL_HIT == 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — admit ladder · OF bag · null/false · empty cand
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # 1 deny no status
  LET plate = "{\"n\":0}"
  CALL admit_ready
  SYS EQS state "deny-no-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 2 deny wrong status
  LET plate = "{\"status\":\"down\"}"
  CALL admit_ready
  SYS EQS state "deny-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 3-4 admit ok via legacy
  LET plate = "{\"legacy_status\":\"ok\"}"
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 5-6 OF bag prefers phase when listed first
  LET plate = "{\"phase\":\"beta\",\"status\":\"ok\"}"
  CALL peel_status_ofbag
  SYS EQS val "beta"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "phase"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 7 null present → empty val but hit
  LET plate = "{\"gone\":null,\"flag\":false}"
  SYS JSONHITVAL plate "nope" "gone"
  IF JSONHITVAL_HIT == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS JSONHITVAL_KEY "gone"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 9 false → "0"
  SYS JSONHITVAL plate "flag"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 10 empty candidate list → miss
  SYS JSONHITVAL plate
  IF JSONHITVAL_HIT == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — disk plates one-shot value (no EQS-branch W904)
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE intake_path "{\"agent_id\":\"w-9\",\"legacy_status\":\"ok\",\"code\":0}"
  SYS WRITE peer_path "{\"uuid\":\"u-1\",\"state\":\"ready\",\"n\":1}"
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_id_val
  SYS EQS val "w-9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "agent_id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_id_val
  SYS EQS val "u-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "state"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # hitval closes W904: no var-key SYS JSON needed
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  SYS JSONHITVAL plate "status" "legacy_status"
  SYS EQS LAST "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # dual: JSONHITKEY still names without value
  SYS JSONHITKEY plate "status" "legacy_status"
  SYS EQS LAST "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — identified+ready ladder · bool coerce · multi vendor
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"i-1\",\"status\":\"live\"}"
  CALL admit_identified_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS id_val "i-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"status\":\"ok\"}"
  CALL admit_identified_ready
  SYS EQS state "deny-no-id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"agent_id\":\"fleet-2\",\"phase\":\"gamma\"}"
  CALL admit_identified_ready
  SYS EQS state "deny-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"agent_id\":\"fleet-2\",\"phase\":\"ok\"}"
  CALL admit_identified_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # bool true peels as "1"
  LET plate = "{\"ok\":true,\"n\":3}"
  SYS JSONHITVAL plate "missing" "ok"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS JSONHITVAL_KEY "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # numeric 0 present as "0"
  SYS JSONHITVAL plate "n"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "JSONHITVAL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "JSONHITVAL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONFIRSTVAL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JHITVAL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHITKEY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHASANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHITVAL_KEY"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONHITVAL_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONHITVAL_HIT"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsonhitval_status_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "JSONHITVAL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit identified ready
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"uuid\":\"gate-1\",\"status\":\"live\"}"
  CALL admit_identified_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS id_val "gate-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS val "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"n\":9}"
  CALL admit_identified_ready
  SYS EQS state "deny-no-id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"name\":\"solo\",\"status\":\"down\"}"
  CALL admit_identified_ready
  SYS EQS state "deny-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"name\":\"solo\",\"state\":\"ready\"}"
  CALL admit_identified_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft JSONHASANY twin without value
  SYS JSONHASANY plate "status" "state"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "first-present"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk · WRITE NL · NUM shuttle
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE intake_path "{\"agent_id\":\"probe-1\",\"legacy_status\":\"ok\"}"
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  LET saved = hit_idx
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 3 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "hitkey=" hit_key " val=" val " idx=" hit_idx
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "hitkey="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "jhv_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "jhv_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_id_val
  SYS EQS val "probe-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jhv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-jhv\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit ",\"hit_key\":\"" hit_key "\",\"hit_idx\":" hit_idx ",\"val\":\"" val "\"}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n " key=" hit_key " val=" val
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_jsonhitval_status_admit_board: done"
PASS
