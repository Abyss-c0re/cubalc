# svc_freqflat_status_board.cubalc — FREQFLAT/HISTFLAT nest status histograms
#
# Real use: fleet digest agents roll up role/status leaf values into
# value:count bags without VALSFLAT+FREQ glue — canary/zone health digests.
# First realworld of proof 1241 FREQFLAT (MEANINGFUL 664).
#
#   FREQFLAT|HISTFLAT|COUNTVALFLAT [FROM plate] needle
#   LAST = bag "val:count" lines · FREQFLAT_TOTAL · FREQFLAT_N unique
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sfs_$$
#   ./out/cubalc run programs/realworld/svc_freqflat_status_board.cubalc boot
#   ./out/cubalc run ... freq|hist|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SFS_REPORT.txt agent.json peer.json hist.txt
# Env: HOST_S ROLE_S CUBALC_SFS_REQUIRE
#
# Edges:
#   soft miss empty bag; FROM PEER; empty needle all leaves; substring
#   false-friends; WRITE NL; NUM softens REQUIRE; FREQ specials capture

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_freqflat_status_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_freqflat_status -- boot|freq|hist|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeF"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SFS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SFS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "hist.txt"
LET hist_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET keep_n = 0
LET path_val = ""
LET hist_bag = ""
LET total_n = 0
LET uniq_n = 0

ONEOF ACTION "boot", "freq", "hist", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "freq" THEN
    LET op = "freq"
  WHEN "hist" THEN
    LET op = "hist"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — multi-zone role/status plate + peer status digests
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  # site not host — avoid leaf needle false-friends; agent_job not agent_role
  SYS CAT "{\"agent\":\"svc-freqflat\",\"schema\":\"cubalc.svc_freqflat_status.v1\",\"site\":\"" host_s "\",\"agent_job\":\"" role_s "\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"worker\",\"endpoint\":\"h1\"},\"other\":{\"endpoint\":\"h2\",\"role\":\"leader\"},\"label\":\"freq\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_freqflat_status.v1\",\"site\":\"" host_s "\",\"a\":{\"status\":\"ok\"},\"b\":{\"status\":\"fail\"},\"c\":{\"status\":\"ok\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "meta.role"
  SYS EQS LAST "worker"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "cfg.role"
  SYS EQS LAST "worker"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "cfg.endpoint"
  SYS EQS LAST "h1"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "freq"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 1 THEN
            LET hit = 1
            LET note_msg = "boot ok"
            LET admit_n = 1
            LET take_n = 1
            LET keep_n = 3
          ELSE
            LET miss = 1
            LET note_msg = "boot label"
            FAIL "boot label"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "boot endpoint"
          FAIL "boot endpoint"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot leader"
        FAIL "boot leader"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot cfg.role"
      FAIL "boot cfg.role"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot meta.role"
    FAIL "boot meta.role"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok has_n note_msg
  CLEAR_ERR
END

# freq — FREQFLAT role + endpoint histograms
SYS EQS op "freq"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FREQFLAT "role"
  LET hist_bag = LAST
  LET total_n = FREQFLAT_TOTAL
  LET uniq_n = FREQFLAT_N
  CLEAR_ERR
  SYS WRITE hist_path hist_bag
  CLEAR_ERR
  SYS HASLINE hist_bag "worker:2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE hist_bag "leader:1"
  LET load_hit = LAST_N
  CLEAR_ERR
  FREQFLAT "endpoint"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "h1:1"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS HASLINE body "h2:1"
  LET has_n = LAST_N
  CLEAR_ERR
  # soft miss
  FREQFLAT "nope"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val ""
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "freq"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF total_n == 3 THEN
    IF uniq_n == 2 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              IF miss_n == 1 THEN
                IF gate_ok == 1 THEN
                  LET hit = 1
                  LET note_msg = "freq ok"
                  LET admit_n = 1
                  LET take_n = total_n
                  LET keep_n = uniq_n
                ELSE
                  LET miss = 1
                  LET note_msg = "freq label"
                  FAIL "freq label"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "freq soft empty"
                FAIL "freq soft empty"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "freq h2"
              FAIL "freq h2"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "freq h1"
            FAIL "freq h1"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "freq leader"
          FAIL "freq leader"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "freq worker"
        FAIL "freq worker"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "freq uniq"
      FAIL "freq uniq"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "freq total"
    FAIL "freq total"
    CLEAR_ERR
  END
  SYS STR total_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "freq:" w_s ":fq"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "freq:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n total_n uniq_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# hist — empty needle all leaves + bare FREQFLAT
SYS EQS op "hist"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FREQFLAT ""
  LET hist_bag = LAST
  LET total_n = FREQFLAT_TOTAL
  LET uniq_n = FREQFLAT_N
  CLEAR_ERR
  SYS WRITE hist_path hist_bag
  CLEAR_ERR
  # agent_job=worker inflates worker:3 on empty needle — use HAS not exact count
  SYS HAS hist_bag "worker:"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # bare FREQFLAT same as empty
  FREQFLAT
  LET take_n = FREQFLAT_TOTAL
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "freq"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS HASLINE hist_bag "leader:1"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-freqflat"
  LET has_n = LAST_N
  CLEAR_ERR
  # total: many leaves across plate
  IF total_n >= 5 THEN
    IF take_n == total_n THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              LET hit = 1
              LET note_msg = "hist ok"
              LET admit_n = 1
              LET keep_n = uniq_n
              LET miss_n = 0
              LET gate_ok = 1
            ELSE
              LET miss = 1
              LET note_msg = "hist agent"
              FAIL "hist agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "hist label"
            FAIL "hist label"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "hist leader line"
          FAIL "hist leader line"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "hist worker line"
        FAIL "hist worker line"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "hist bare total"
      FAIL "hist bare total"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "hist total"
    FAIL "hist total"
    CLEAR_ERR
  END
  SYS STR total_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "hist:" w_s ":hs"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hist:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n total_n take_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# peer — FREQFLAT/HISTFLAT FROM PEER status
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FREQFLAT FROM PEER "status"
  LET hist_bag = LAST
  LET total_n = FREQFLAT_TOTAL
  LET uniq_n = FREQFLAT_N
  CLEAR_ERR
  SYS WRITE hist_path hist_bag
  CLEAR_ERR
  SYS HASLINE hist_bag "ok:2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE hist_bag "fail:1"
  LET load_hit = LAST_N
  CLEAR_ERR
  HISTFLAT FROM PEER "status"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "ok:2"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-freqflat"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF total_n == 3 THEN
    IF uniq_n == 2 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              IF miss_n == 1 THEN
                LET hit = 1
                LET note_msg = "peer ok"
                LET admit_n = 1
                LET take_n = 3
                LET keep_n = 2
                LET gate_ok = 1
              ELSE
                LET miss = 1
                LET note_msg = "peer tag"
                FAIL "peer tag"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "peer agent"
              FAIL "peer agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer hist ok"
            FAIL "peer hist ok"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer fail"
          FAIL "peer fail"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer ok line"
        FAIL "peer ok line"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer uniq"
      FAIL "peer uniq"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer total"
    FAIL "peer total"
    CLEAR_ERR
  END
  SYS STR total_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "peer:" w_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n total_n uniq_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

# soft — miss + empty bag
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FREQFLAT "ghostpath"
  LET hist_bag = LAST
  LET total_n = FREQFLAT_TOTAL
  LET uniq_n = FREQFLAT_N
  CLEAR_ERR
  SYS EQS hist_bag ""
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-freqflat"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # real role still rolls up
  FREQFLAT "role"
  LET take_n = FREQFLAT_TOTAL
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "freq"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF total_n == 0 THEN
      IF uniq_n == 0 THEN
        IF miss_n == 0 THEN
          IF soft_ok == 1 THEN
            IF take_n == 3 THEN
              IF has_n == 1 THEN
                LET hit = 1
                LET note_msg = "soft ok"
                LET admit_n = 1
                LET gate_ok = 1
                LET load_hit = 1
                LET keep_n = 0
              ELSE
                LET miss = 1
                LET note_msg = "soft label"
                FAIL "soft label"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "soft role total"
              FAIL "soft role total"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft agent"
            FAIL "soft agent"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft empty bag"
          FAIL "soft empty bag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft uniq"
        FAIL "soft uniq"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft total"
      FAIL "soft total"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft empty last"
    FAIL "soft empty last"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n total_n take_n soft_ok has_n note_msg
  CLEAR_ERR
END

# gate — worker majority + fail count from peer optional; role contract
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FREQFLAT "role"
  LET hist_bag = LAST
  LET total_n = FREQFLAT_TOTAL
  CLEAR_ERR
  SYS HASLINE hist_bag "worker:2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE hist_bag "leader:1"
  LET load_hit = LAST_N
  CLEAR_ERR
  # majority: workers > leaders for admit
  LET soft_ok = 0
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      LET soft_ok = 1
    END
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_freqflat_status"
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "freq"
  LET has_n = LAST_N
  CLEAR_ERR
  FREQFLAT "endpoint"
  LET take_n = FREQFLAT_TOTAL
  CLEAR_ERR
  IF total_n == 3 THEN
    IF soft_ok == 1 THEN
      IF miss_n == 1 THEN
        IF has_n == 1 THEN
          IF take_n == 2 THEN
            LET hit = 1
            LET gate_ok = 1
            LET admit_n = 1
            LET note_msg = "gate ok"
            LET keep_n = 2
          ELSE
            LET miss = 1
            LET note_msg = "gate endpoint n"
            FAIL "gate endpoint n"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate label"
          FAIL "gate label"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate schema"
        FAIL "gate schema"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate majority"
      FAIL "gate majority"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate role total"
    FAIL "gate role total"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok total_n soft_ok take_n note_msg
  CLEAR_ERR
END

# probe — COUNTVALFLAT alias + scratch nest
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "probe.a.v" "x"
  CLEAR_ERR
  SETP "probe.b.v" "x"
  CLEAR_ERR
  SETP "probe.c.v" "y"
  CLEAR_ERR
  COUNTVALFLAT "v"
  LET hist_bag = LAST
  # capture specials immediately; may dark-read later
  LET total_n = FREQFLAT_TOTAL
  LET uniq_n = FREQFLAT_N
  CLEAR_ERR
  SYS WRITE hist_path hist_bag
  CLEAR_ERR
  SYS HASLINE hist_bag "x:2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE hist_bag "y:1"
  LET load_hit = LAST_N
  CLEAR_ERR
  # bag-line count as total fallback if special dark
  SYS LINES hist_bag
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-freqflat"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "freq"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF take_n == 2 THEN
            LET hit = 1
            LET note_msg = "probe ok"
            LET admit_n = 1
            LET keep_n = 2
            LET total_n = 3
            LET gate_ok = 1
            LET miss_n = 0
          ELSE
            LET miss = 1
            LET note_msg = "probe lines"
            FAIL "probe lines"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe label"
          FAIL "probe label"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe agent"
        FAIL "probe agent"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe y"
      FAIL "probe y"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe x"
    FAIL "probe x"
    CLEAR_ERR
  END
  SYS CAT "probe:alias:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n total_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_freqflat_status.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " total=" total_n " uniq=" uniq_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_freqflat_status_board: end"
