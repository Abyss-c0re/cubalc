SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  ENDTOPIC mesh
  LET topic_got = ENDTOPIC
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LASTTOPIC form
  LET topic_got = LASTTOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHTOPIC 0 form
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTMATCHTOPICS form
  LET topics_n = COUNTMATCHTOPICS_N
  CLEAR_ERR
  IF topics_n == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "ntr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ENDTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.needle"
  SYS EQS LAST "p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = topics_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n topic_got score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + HASTOPIC vs HASMATCHTOPICS + literal idx note
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NTHTOPIC 0 p
  LET topic_got = NTHTOPIC
  LET topics_n = NTHTOPIC_N
  LET body = LAST
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS EQS stem_s "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # LAST after PRINT is not the topic
  SYS EQS LAST "cap"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # exact vs filter presence
  HASTOPIC p
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  HASMATCHTOPICS p
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF topics_n == 4 THEN
    LET score = score + 1
  END
  # LASTTOPIC_N often 0 even after success — capture as observation score if 0 or set
  LASTTOPIC p
  LET sum_n = LASTTOPIC_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  ELSE
    IF sum_n >= 1 THEN
      LET score = score + 1
    END
  END
  SYS EQS LASTTOPIC "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "nthtopic_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NTHTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = topics_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" topics_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_nthtopic_roster.v1 host=" host_s " role=" role_s " needle=" needle_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " topics_n=" topics_n " topic=" topic_got " filt=" filt_s " slot=" slot_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_nthtopic_roster_board: done"
PASS
