# svc_nthtopic_roster_board.cubalc — NTHTOPIC/LASTTOPIC fleet topic roster
#
# Real use: fleet agents index a filtered discovery-topic roster by slot
# (NTHTOPIC 0..n needle), peel the tail (LASTTOPIC/ENDTOPIC), and gate
# capacity with COUNTMATCHTOPICS/HASMATCHTOPICS before GUIDE playbook.
# First realworld of proofs 1349 NTHTOPIC + 1348 HASMATCHTOPICS (1.15.799).
#
#   NTHTOPIC idx needle [OR fb] → NTHTOPIC · TOPIC_NAME · NTHTOPIC_N family
#   LASTTOPIC|ENDTOPIC needle [OR fb] → LASTTOPIC · ENDTOPIC
#   COUNTMATCHTOPICS / HASMATCHTOPICS / NEEDMATCHTOPICS capacity gates
#   soft OOR index · empty filter · synonym mesh · substring p roster
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ntr_$$
#   ./out/cubalc run programs/realworld/svc_nthtopic_roster_board.cubalc boot
#   ./out/cubalc run ... nth|last|count|chain|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt NTR_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S NEEDLE_S CUBALC_NTR_REQUIRE
#
# Edges: NTHTOPIC index literal-only (var idx fails); LASTTOPIC_N sticky 0;
#   PRINT clobber; WRITE NL; HASTOPIC p vs HASMATCHTOPICS p; OOR soft

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_nthtopic_roster_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_nthtopic_roster -- boot|nth|last|count|chain|soft|gate|alias|probe|list -- [--host=H] [--role=R] [--needle=N]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT NEEDLE_S = "p"
GETFLAG needle|n OR ENV NEEDLE_S OR NEEDLE_S
LET needle_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_NTR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "NTR_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET topics_n = 0
LET topic_got = ""
LET filt_s = ""
LET slot_n = 0

ONEOF ACTION "boot", "nth", "last", "count", "chain", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "nth" THEN
    LET op = "nth"
  WHEN "last" THEN
    LET op = "last"
  WHEN "count" THEN
    LET op = "count"
  WHEN "chain" THEN
    LET op = "chain"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s needle_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-ntr\",\"schema\":\"cubalc.svc_nthtopic_roster.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"topic_roster\",\"label\":\"ntr\",\"cfg\":{\"surface\":\"NTHTOPIC,LASTTOPIC,ENDTOPIC,COUNTMATCHTOPICS,HASMATCHTOPICS\",\"needle\":\"p\",\"slots\":4}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"topic_roster\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-ntr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_nthtopic_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "ntr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NTHTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# nth — walk filtered roster slots 0..3 for needle p
SYS EQS op "nth"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.needle"
  LET filt_s = LAST
  CLEAR_ERR
  NTHTOPIC 0 filt_s
  LET topic_got = NTHTOPIC
  LET topics_n = NTHTOPIC_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS TOPIC_NAME "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF topics_n == 4 THEN
    LET score = score + 1
  END
  NTHTOPIC 1 filt_s
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHTOPIC 2 filt_s
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHTOPIC 3 filt_s
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  SYS EQS topic_got "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OR fallback on OOR
  NTHTOPIC 9 filt_s OR general
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NTHTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.slots"
  SYS NUM
  LET slot_n = LAST_N
  CLEAR_ERR
  IF slot_n == 4 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "nth ok"
    LET admit_n = 1
    LET find_n = topics_n
  ELSE
    LET miss = 1
    LET note_msg = "nth score"
    FAIL "nth score"
    CLEAR_ERR
  END
  SYS CAT "nth:" topics_n ":nt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "nth:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n topic_got score note_msg
  CLEAR_ERR
END

# last — LASTTOPIC / ENDTOPIC tail of filter
SYS EQS op "last"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LASTTOPIC p
  LET topic_got = LASTTOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS ENDTOPIC "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LASTTOPIC mesh
  LET topic_got = LASTTOPIC
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ENDTOPIC fat
  LET topic_got = ENDTOPIC
  CLEAR_ERR
  SYS EQS topic_got "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS LASTTOPIC "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OR fallback
  LASTTOPIC zzz_nope OR run
  LET topic_got = LASTTOPIC
  CLEAR_ERR
  SYS EQS topic_got "run"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LASTTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ENDTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "ntr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "last ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "last score"
    FAIL "last score"
    CLEAR_ERR
  END
  SYS CAT "last:" topic_got ":lt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "last:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topic_got score note_msg
  CLEAR_ERR
END

# count — COUNTMATCHTOPICS / HASMATCHTOPICS / NEEDMATCHTOPICS gates
SYS EQS op "count"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTMATCHTOPICS p
  LET topics_n = COUNTMATCHTOPICS_N
  LET sum_n = LAST_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF topics_n == 4 THEN
    LET score = score + 1
  END
  # LAST_N may track count or not — score if either matches family
  IF sum_n == 4 THEN
    LET score = score + 1
  ELSE
    IF sum_n >= 1 THEN
      IF topics_n == 4 THEN
        LET score = score + 1
      END
    END
  END
  HASMATCHTOPICS p
  LET sum_v = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  HASMATCHTOPICS cap
  IF HASMATCHTOPICS_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTMATCHTOPICS mesh
  LET sum_n = COUNTMATCHTOPICS_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  NEEDMATCHTOPICS plate
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  # soft miss has
  HASMATCHTOPICS zzz_nope
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "COUNTMATCHTOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "count ok"
    LET admit_n = 1
    LET find_n = topics_n
  ELSE
    LET miss = 1
    LET note_msg = "count score"
    FAIL "count score"
    CLEAR_ERR
  END
  SYS CAT "count:" topics_n ":ct"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "count:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n score note_msg
  CLEAR_ERR
END

# chain — COUNT gate → NTH slot → GUIDE
SYS EQS op "chain"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTMATCHTOPICS p
  LET topics_n = COUNTMATCHTOPICS_N
  CLEAR_ERR
  IF topics_n == 4 THEN
    LET score = score + 1
  END
  HASMATCHTOPICS p
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # slot 1 → plate playbook
  NTHTOPIC 1 p
  LET topic_got = NTHTOPIC
  LET body = LAST
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GUIDE topic_got
  LET sum_n = GUIDE_RELATED_N
  LET body = LAST
  CLEAR_ERR
  IF sum_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.guide.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # tail protect
  LASTTOPIC p
  LET stem_s = LASTTOPIC
  CLEAR_ERR
  SYS EQS stem_s "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.slots"
  SYS NUM
  IF LAST_N == 4 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "chain ok"
    LET admit_n = 1
    LET find_n = topics_n
  ELSE
    LET miss = 1
    LET note_msg = "chain score"
    FAIL "chain score"
    CLEAR_ERR
  END
  SYS CAT "chain:" topic_got ":ch"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "chain:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n topic_got score note_msg
  CLEAR_ERR
END

# soft — OOR / empty / miss paths
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NTHTOPIC 5 p
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  NTHTOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  LASTTOPIC zzz_nope
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  COUNTMATCHTOPICS zzz_nope
  LET sum_n = COUNTMATCHTOPICS_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  HASMATCHTOPICS
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  # OR recovers
  NTHTOPIC 99 p OR general
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-ntr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASMATCHTOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate surface + live NTHTOPIC
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NTHTOPIC 0 lib
  LET topic_got = NTHTOPIC
  CLEAR_ERR
  SYS EQS topic_got "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTMATCHTOPICS p
  LET topics_n = COUNTMATCHTOPICS_N
  CLEAR_ERR
  IF topics_n == 4 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NTHTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LASTTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "COUNTMATCHTOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "nthtopic_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = topics_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n topic_got score note_msg
  CLEAR_ERR
END

