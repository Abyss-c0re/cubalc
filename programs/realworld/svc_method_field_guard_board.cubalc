    FAIL "fld score"
    CLEAR_ERR
  END
  SYS CAT "fld:" anyo ":fd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fld:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score anyo note_msg
  CLEAR_ERR
END

# combo — soft ALL+ANY both planes together
SYS EQS op "combo"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET NEED_METHODS = "MeshSvc.ping\nMeshSvc.health"
  LET NEED_METHOD_ANY = "MeshPay.refund\nGhost.z"
  LET METHOD_GUARD_SOFT = 1
  INCLUDE method_guard
  LET mgo = METHOD_GUARD_OK
  LET allo = METHOD_GUARD_ALL_OK
  LET anyo = METHOD_GUARD_ANY_OK
  CLEAR_ERR
  IF mgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  LET NEED_FIELDS = "MeshSvc.zone\nMeshPay.n"
  LET NEED_FIELD_ANY = "MeshPay.currency\nGhost.z"
  LET FIELD_GUARD_SOFT = 1
  INCLUDE field_guard
  LET fgo = FIELD_GUARD_OK
  LET allo = FIELD_GUARD_ALL_OK
  LET anyo = FIELD_GUARD_ANY_OK
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  # combined fail: ALL miss method + ANY hit field
  LET NEED_METHODS = "MeshSvc.ping\nGhost.all"
  LET NEED_METHOD_ANY = "MeshPay.pay"
  LET METHOD_GUARD_SOFT = 1
  INCLUDE method_guard
  LET allo = METHOD_GUARD_ALL_OK
  LET mgo = METHOD_GUARD_OK
  CLEAR_ERR
  IF allo == 0 THEN
    LET score = score + 1
  END
  IF mgo == 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-mfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "combo ok"
    LET admit_n = 1
    LET find_n = mgo
  ELSE
    LET miss = 1
    LET note_msg = "combo score"
    FAIL "combo score"
    CLEAR_ERR
  END
  SYS CAT "combo:" score ":cb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "combo:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM for free duals used by guards
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "HASMETHODS"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "HASFIELDS"
  LET allo = LAST_N
  CLEAR_ERR
  HASFORM "HASMETHODANY"
  LET anyo = LAST_N
  CLEAR_ERR
  HASFORM "HASFIELDANY"
  LET fgo = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF fgo == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "HASMETHOD"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "HASFIELD"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SYS HASMETHODS"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "method_field_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "method_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — dual soft pass + soft recover + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET NEED_METHODS = "MeshSvc.ping\nMeshSvc.health"
  LET NEED_METHOD_ANY = "MeshPay.pay"
  LET METHOD_GUARD_SOFT = 1
  INCLUDE method_guard
  IF METHOD_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_FIELDS = "MeshSvc.zone\nMeshPay.n"
  LET NEED_FIELD_ANY = "MeshPay.currency"
  LET FIELD_GUARD_SOFT = 1
  INCLUDE field_guard
  IF FIELD_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss must not block
  LET NEED_METHODS = "Ghost.only"
  LET NEED_METHOD_ANY = ""
  LET METHOD_GUARD_SOFT = 1
  INCLUDE method_guard
  IF METHOD_GUARD_OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_FIELDS = "Ghost.only"
  LET NEED_FIELD_ANY = ""
  LET FIELD_GUARD_SOFT = 1
  INCLUDE field_guard
  IF FIELD_GUARD_OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHOD MeshSvc deploy
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFIELD MeshSvc load
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-mfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · CLEAR_ERR LAST · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET NEED_METHODS = "MeshSvc.ping"
  LET NEED_METHOD_ANY = ""
  LET METHOD_GUARD_SOFT = 1
  INCLUDE method_guard
  LET mgo = METHOD_GUARD_OK
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF mgo == 1 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_FIELDS = "MeshSvc.zone"
  LET FIELD_GUARD_SOFT = 1
  INCLUDE field_guard
  IF FIELD_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "method_field_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "fn_slot_admit"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHOD MeshSvc health
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = mgo
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score mgo note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " mgo=" mgo " fgo=" fgo
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "mfg report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
