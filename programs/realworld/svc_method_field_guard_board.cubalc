  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_FIELDS = ""
  LET NEED_FIELD_ANY = "Ghost.nope\nMeshPay.currency"
  LET FIELD_GUARD_SOFT = 1
  INCLUDE field_guard
  LET anyo = FIELD_GUARD_ANY_OK
  LET have_s = FLDHAVE
  CLEAR_ERR
  IF anyo == 1 THEN
    LET score = score + 1
  END
