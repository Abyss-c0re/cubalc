# svc_cap_boot_admit_board.cubalc — cap_boot + LISTFORMS + host form floor
#
# Real use: fleet agents admit nodes with one-shot capability preamble
# (agent_boot+form_guard via cap_boot), inventory HELP catalog surface
# in-lang (LISTFORMS/COUNTFORMS), and honor host form floors
# (cubalc run -C / CUBALC_REQUIRE_FORMS) before mtime/lib ops.
# First realworld of proofs 1325 cap_boot + 1326 require_forms + 1327 LISTFORMS.
#
#   INCLUDE cap_boot · LISTFORMS|COUNTFORMS [prefix] · FORMLIST dual
#   Host: cubalc run -C SORTLIBS,LIBAGE · CUBALC_REQUIRE_FORMS=…
#   Plate require_forms field on run JSON · FORMMISS soft path
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_scb_$$
#   ./out/cubalc run programs/realworld/svc_cap_boot_admit_board.cubalc boot
#   ./out/cubalc run -C HASFORM,SORTLIBS ... catalog|cap|floor|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SCB_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SCB_REQUIRE CUBALC_REQUIRE_FORMS
#
# Edges: LISTFORMS var prefix (post-fix); INCLUDE stop-list filter;
#   PRINT clobbers LAST bag; WRITE NL; form_guard soft; host floor shell

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_cap_boot_admit_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_cap_boot_admit -- boot|cap|catalog|soft|floor|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SCB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

# host form floor (set by cubalc run -C or CUBALC_REQUIRE_FORMS)
LET floor_s = ""
SYS ENV "CUBALC_REQUIRE_FORMS" OR ""
IF LAST_N > 0 THEN
  LET floor_s = LAST
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SCB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET forms_n = 0
LET miss_n = 0
LET floor_n = 0

ONEOF ACTION "boot", "cap", "catalog", "soft", "floor", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "cap" THEN
    LET op = "cap"
  WHEN "catalog" THEN
    LET op = "catalog"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "floor" THEN
    LET op = "floor"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-capboot\",\"schema\":\"cubalc.svc_cap_boot_admit.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"cap\",\"label\":\"capboot\",\"cfg\":{\"need\":\"HASFORM,SORTLIBS,LIBAGE\",\"boot\":\"cap_boot\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"capadmit\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_cap_boot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.boot"
  SYS EQS LAST "cap_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# cap — INCLUDE cap_boot (agent_boot + form_guard one-shot)
SYS EQS op "cap"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # hard capability contract (default NEED_FORMS inside cap_boot)
  INCLUDE cap_boot
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  HASINCLUDE cap_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE form_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE agent_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM SORTLIBS
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORMS HASFORM NEEDFORM
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.boot"
  SYS EQS LAST "cap_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "cap ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "cap score"
    FAIL "cap score"
    CLEAR_ERR
  END
  SYS CAT "cap:1:cp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "cap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# catalog — LISTFORMS / COUNTFORMS inventory (capture bag before PRINT)
SYS EQS op "catalog"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LISTFORMS SORT
  LET body = LAST
  LET forms_n = LISTFORMS_N
  LET stem_s = LISTFORMS_FILTER
  CLEAR_ERR
  IF forms_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "SORT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LISTFORMS LIB
  LET body = LAST
  LET forms_n = LISTFORMS_N
  CLEAR_ERR
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  SYS HASLINE body "LIBAGE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # quoted form-name prefix (unquoted works post-rebuild)
  LISTFORMS "HASFORM"
  LET body = LAST
  LET forms_n = LISTFORMS_N
  CLEAR_ERR
  IF forms_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE body "HASFORM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # var prefix (fixed: lex_next after var expand)
  LET f = "SORTLIBS"
  LISTFORMS f
  LET forms_n = LISTFORMS_N
  LET stem_s = LISTFORMS_FILTER
  CLEAR_ERR
  IF forms_n >= 1 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTFORMS FORM
  LET sum_n = LAST_N
  LET admit_n = COUNTFORMS_N
  CLEAR_ERR
  IF sum_n >= 5 THEN
    LET score = score + 1
  END
  # empty filter soft empty
  LISTFORMS ZZZNOMATCH_XYZ
  LET sum_v = LAST_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "catalog ok"
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "catalog score"
    FAIL "catalog score"
    CLEAR_ERR
  END
  SYS CAT "catalog:" admit_n ":ct"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "catalog:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n admit_n forms_n score note_msg
  CLEAR_ERR
END

# soft — soft form_guard miss path (no hard NEEDFORMS)
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  DEFAULT FORM_GUARD_SOFT = 1
  DEFAULT NEED_FORMS = "SORTLIBS\nNO_SUCH_FORM_XYZ_ZZZ"
  INCLUDE form_guard
  LET sum_v = OK
  LET miss_n = FORMMISS_N
  LET body = FORMMISS
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "NO_SUCH_FORM_XYZ_ZZZ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # LISTFORMS empty soft
  LISTFORMS ZZZNOMATCH_XYZ
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # HASFORM soft miss
  HASFORM NO_SUCH_FORM_XYZ_ZZZ
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_v miss_n score note_msg
  CLEAR_ERR
END

# floor — observe host CUBALC_REQUIRE_FORMS / dual HASFORMS
SYS EQS op "floor"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # re-read env (may be empty if host used only -C inject without env)
  SYS ENV "CUBALC_REQUIRE_FORMS" OR ""
  LET floor_s = LAST
  CLEAR_ERR
  SYS LINES floor_s
  # CSV may be one line — count commas+1 when non-empty
  IF floor_s != "" THEN
    LET floor_n = 1
    LET score = score + 1
    HASFORMS floor_s
    LET sum_v = OK
    LET miss_n = FORMMISS_N
    CLEAR_ERR
    IF sum_v == 1 THEN
      LET score = score + 1
    END
    IF miss_n == 0 THEN
      LET score = score + 1
    END
  ELSE
    # no host floor — soft pass with local contract
    LET floor_n = 0
    LET score = score + 1
    HASFORMS HASFORM SORTLIBS LIBAGE
    LET sum_v = OK
    CLEAR_ERR
    IF sum_v == 1 THEN
      LET score = score + 1
    END
    LET miss_n = 0
    LET score = score + 1
  END
  COUNTFORMS
  LET forms_n = LAST_N
  CLEAR_ERR
  IF forms_n >= 100 THEN
    LET score = score + 1
  END
  GETP "cfg.need"
  SYS HAS LAST "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "floor ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "floor score"
    FAIL "floor score"
    CLEAR_ERR
  END
  SYS CAT "floor:" floor_n ":fl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "floor:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n floor_n forms_n score note_msg
  CLEAR_ERR
END

# gate — plate cfg.need vs live catalog + LISTFORMS prefix
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.need"
  LET body = LAST
  CLEAR_ERR
  HASFORMS body
  LET sum_v = OK
  LET miss_n = FORMMISS_N
  LET admit_n = HASFORMS_N
  LET forms_n = FORMS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  IF admit_n == 3 THEN
    LET score = score + 1
  END
  IF forms_n == 3 THEN
    LET score = score + 1
  END
  LISTFORMS SORTLIBS
  LET stem_s = LAST
  CLEAR_ERR
  SYS HASLINE stem_s "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.boot"
  SYS EQS LAST "cap_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET find_n = admit_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n admit_n forms_n score note_msg
  CLEAR_ERR
END

# alias — FORMLIST / NFORMS / CATALOGFORMS duals
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FORMLIST SORT
  LET forms_n = LISTFORMS_N
  CLEAR_ERR
  IF forms_n >= 3 THEN
    LET score = score + 1
  END
  NFORMS LIB
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 5 THEN
    LET score = score + 1
  END
  CATALOGFORMS HASFORM
  LET body = LAST
  LET forms_n = LISTFORMS_N
  CLEAR_ERR
  IF forms_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE body "HASFORMS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMCOUNT FORM
  IF LAST_N >= 5 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capboot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n score note_msg
  CLEAR_ERR
END

# probe — dual edges: INCLUDE filter stop, PRINT LAST clobber note, COUNT vs LIST
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # COUNTFORMS does not clobber multi-line agent bags the same way
  COUNTFORMS SORT
  LET sum_n = LAST_N
  CLEAR_ERR
  LISTFORMS SORT
  LET body = LAST
  LET forms_n = LISTFORMS_N
  CLEAR_ERR
  IF sum_n == forms_n THEN
    LET score = score + 1
  END
  IF forms_n >= 3 THEN
    LET score = score + 1
  END
  # capture before PRINT (W4)
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE stem_s "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # bare COUNTFORMS full catalog large
  COUNTFORMS
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n >= 100 THEN
    LET score = score + 1
  END
  # quoted INCLUDE-like filter works; unquoted INCLUDE is stop-list
  LISTFORMS "INCLUDE"
  LET forms_n = LISTFORMS_N
  CLEAR_ERR
  IF forms_n >= 1 THEN
    LET score = score + 1
  END
  # soft miss HASFORMS
  HASFORMS SORTLIBS NO_SUCH_FORM_XYZ_ZZZ
  LET miss_n = FORMMISS_N
  CLEAR_ERR
  IF miss_n == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "cap_boot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.boot"
  SYS EQS LAST "cap_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n forms_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_cap_boot_admit.v1 host=" host_s " role=" role_s " req=" require_hit " floor=" floor_s " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " forms_n=" forms_n " miss_n=" miss_n " floor_n=" floor_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_cap_boot_admit_board: done"
PASS
