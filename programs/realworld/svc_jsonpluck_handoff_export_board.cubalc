# svc_jsonpluck_handoff_export_board.cubalc — JSONPLUCK handoff field export
#
# Real use: mesh agents export a *value bag* of allowlisted plate fields for
# peer handoff (id/status/role) without secrets. Soft dual of multi JSON GET
# loops. Miss keys leave empty fields (stable indices). Dual JSONPICK keeps
# object form. First focused realworld of JSONPLUCK handoff (proof 1082).
#
#   JSONPLUCK · JPLUCK · JSONPLUCK_N · JSONPLUCK_HIT · JSONPLUCK_MISS
#   OF bag allowlist · JSONPICK dual · secret scrub · empty-slot miss
#
# Edges (challenge):
#   miss middle keeps empty field (index stable)
#   JSONHAS var plate key may fail; prefer SYS JSON key FROM plate (W948)
#   all-miss still LAST_N = listed count with empty fields
#   bool true peels as "1" in value bag
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_jpl_$$
#   ./out/cubalc run programs/realworld/svc_jsonpluck_handoff_export_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt JPL_REPORT.txt agent.json plates/*
# Env: HOST_S ROLE_S CUBALC_JPL_REQUIRE

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN export_handoff
  LET export_bag = ""
  LET ok_v = 0
  LET hit_n = 0
  LET miss_n = 0
  SYS JSONPLUCK plate "id" "status" "role"
  LET export_bag = LAST
  LET hit_n = JSONPLUCK_HIT
  LET miss_n = JSONPLUCK_MISS
  IF hit_n == 3 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN export_ofbag
  LET export_bag = ""
  LET ok_v = 0
  LET hit_n = 0
  LET miss_n = 0
  SYS JOIN "" "id\nstatus\nrole\nzone"
  LET kbag = LAST
  SYS JSONPLUCK plate OF kbag
  LET export_bag = LAST
  LET hit_n = JSONPLUCK_HIT
  LET miss_n = JSONPLUCK_MISS
  IF hit_n >= 1 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN export_pick_obj
  LET body = ""
  LET ok_v = 0
  SYS JSONPICK plate "id" "status" "role"
  LET body = LAST
  SYS JSON "id" FROM body
  IF LAST_N > 0 THEN
    LET ok_v = 1
  END
  CLEAR_ERR
END

FN admit_complete
  LET state = "deny-miss"
  LET ok_v = 0
  CALL export_handoff
  IF hit_n == 3 THEN
    IF miss_n == 0 THEN
      LET state = "admit"
      LET ok_v = 1
    END
  ELSE
    LET state = "deny-miss"
    LET ok_v = 0
  END
END

FN scrub_check
  LET ok_v = 0
  SYS HAS export_bag "secret"
  IF LAST_N == 0 THEN
    SYS HAS export_bag "x"
    IF LAST_N == 0 THEN
      LET ok_v = 1
    END
  END
  CLEAR_ERR
END

NOTE "svc_jsonpluck_handoff_export_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_jsonpluck_handoff_export -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_JPL_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JPL_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "peer.json"
LET peer_path = LAST
SYS JOIN plate_dir "handoff.bag"
LET handoff_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET plate = ""
LET state = ""
LET saved = 0
LET export_bag = ""
LET hit_n = 0
LET miss_n = 0
LET kbag = ""

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-jpl\",\"schema\":\"cubalc.svc_jsonpluck_handoff_export.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"jpl\",\"want_filter\":\"jsonpluck_handoff_export\",\"cfg\":{\"surface\":\"JSONPLUCK,JPLUCK,JSONPLUCK_N,JSONPLUCK_HIT,JSONPLUCK_MISS,JSONPICK\",\"contract\":\"allowlist value-bag handoff export without secrets\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"id\":\"peer-1\",\"status\":\"ok\",\"role\":\"worker\",\"secret\":\"s3cr3t\",\"n\":7}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL export_handoff
  CLEAR_ERR
  SYS WRITE handoff_path export_bag
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jpl"
  IF LAST_N == 1 THEN
    IF hit_n == 3 THEN
      IF miss_n == 0 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = hit_n
      ELSE
        LET miss = 1
        LET note_msg = "boot miss"
        FAIL "boot miss"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot hit"
      FAIL "boot hit"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core pluck duals 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"peer-1\",\"status\":\"ok\",\"role\":\"worker\",\"secret\":\"s3cr3t\",\"n\":7}"
  CALL export_handoff
  IF hit_n == 3 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  IF JSONPLUCK_N == 3 THEN
    LET score = score + 1
  END
  SYS LINES export_bag
  IF LAST_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL scrub_check
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS NTH 0 export_bag
  SYS EQS LAST "peer-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS NTH 1 export_bag
  SYS EQS LAST "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS NTH 2 export_bag
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # miss middle stable index
  SYS JSONPLUCK plate "id" "zone" "role"
  LET export_bag = LAST
  IF JSONPLUCK_HIT == 2 THEN
    LET score = score + 1
  END
  IF JSONPLUCK_MISS == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — all miss · OF bag · pick dual · empty plate
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"p2\",\"status\":\"live\"}"
  # all miss listed still 2 empty fields
  SYS JSONPLUCK plate "a" "b"
  IF JSONPLUCK_HIT == 0 THEN
    LET score = score + 1
  END
  SYS LINES LAST
  IF LAST_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OF bag with zone miss
  CALL export_ofbag
  IF hit_n == 2 THEN
    LET score = score + 1
  END
  IF miss_n == 2 THEN
    LET score = score + 1
  END
  SYS LINES export_bag
  IF LAST_N == 4 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # JSONPICK object dual
  LET plate = "{\"id\":\"p2\",\"status\":\"live\",\"role\":\"edge\",\"secret\":\"no\"}"
  CALL export_pick_obj
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS JSON "status" FROM body
  SYS EQS LAST "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # JSONHAS body secret should be 0 if pick omitted — peel via JSON
  SYS JSON "secret" FROM body
  SYS EMPTY LAST
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty plate
  LET plate = "{}"
  CALL export_handoff
  IF hit_n == 0 THEN
    LET score = score + 1
  END
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — disk peer → handoff.bag
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"id\":\"disk-9\",\"status\":\"ok\",\"role\":\"worker\",\"secret\":\"hide\",\"zone\":\"z1\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL export_handoff
  IF hit_n == 3 THEN
    LET score = score + 1
  END
  CALL scrub_check
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS WRITE handoff_path export_bag
  CLEAR_ERR
  SYS READ handoff_path
  LET export_bag = LAST
  CLEAR_ERR
  SYS LINES export_bag
  IF LAST_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS export_bag "disk-9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS export_bag "hide"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL export_ofbag
  IF hit_n == 4 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  CALL admit_complete
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "JSONPLUCK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — admit ladder · partial miss deny
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"s1\",\"status\":\"ok\",\"role\":\"r\"}"
  CALL admit_complete
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"id\":\"s2\",\"status\":\"ok\"}"
  CALL admit_complete
  SYS EQS state "deny-miss"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_n == 2 THEN
    LET score = score + 1
  END
  IF miss_n == 1 THEN
    LET score = score + 1
  END
  LET plate = "{\"secret\":\"only\"}"
  CALL export_handoff
  IF hit_n == 0 THEN
    LET score = score + 1
  END
  CALL scrub_check
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # bool true in bag
  LET plate = "{\"id\":\"b1\",\"status\":true,\"role\":\"w\"}"
  CALL export_handoff
  SYS NTH 1 export_bag
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_n == 3 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "without secrets"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "JSONPLUCK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JPLUCK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONPICK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONGETALL"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONHAS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONPLUCK_HIT"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONPLUCK_MISS"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "SYS NTH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsonpluck_handoff_export"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "JSONPLUCK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — complete handoff only
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"g1\",\"status\":\"ok\",\"role\":\"w\",\"secret\":\"nope\"}"
  CALL admit_complete
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL scrub_check
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET plate = "{\"id\":\"g2\",\"role\":\"w\"}"
  CALL admit_complete
  SYS EQS state "deny-miss"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_n == 2 THEN
    LET score = score + 1
  END
  LET plate = "{}"
  CALL admit_complete
  SYS EQS state "deny-miss"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "value-bag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "allowlist"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk · WRITE NL · NUM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"id\":\"pr1\",\"status\":\"ok\",\"role\":\"worker\",\"secret\":\"x\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL export_handoff
  IF hit_n == 3 THEN
    LET score = score + 1
  END
  LET saved = hit_n
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 3 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS WRITE handoff_path export_bag
  CLEAR_ERR
  SYS CAT "hit=" hit_n " miss=" miss_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "hit="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "jpl_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "jpl_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ handoff_path
  LET export_bag = LAST
  CLEAR_ERR
  SYS HAS export_bag "pr1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL scrub_check
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jpl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-jpl\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit ",\"hit_n\":" hit_n ",\"miss_n\":" miss_n ",\"state\":\"" state "\"}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n " hit_n=" hit_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_jsonpluck_handoff_export_board: done"
PASS
