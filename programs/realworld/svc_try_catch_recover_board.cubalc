# svc_try_catch_recover_board.cubalc — TRY/CATCH soft recovery + REQUIRE OK floor
#
# Real use: ops agents wrap flaky probe/IO soft FAILs in TRY…CATCH…FINALLY so
# recovery clears sticky err and teardown always runs (unlock/temp), then
# REQUIRE OK / NEEDOK as a fail-fast soft-status floor before admit.
# First realworld of 1449 TRY/CATCH/ONERR (1.15.904+ · MI 911) + 1450
# REQUIRE OK/NEEDOK/MUSTOK (MI 912). Distinct from svc_retry_hook (RETRY loop)
# and TRY/FINALLY-only cleanup — this board is *soft recovery arm + OK floor*.
#
#   TRY … CATCH|ONERR … [FINALLY|CLEANUP] … END
#   CATCH_N · FINALLY_N · CLEAR_ERR in CATCH then PASS
#   REQUIRE OK|SUCCESS · NEEDOK · MUSTOK · ASSERTOK · REQUIRE_OK
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_tcr_$$
#   ./out/cubalc run programs/realworld/svc_try_catch_recover_board.cubalc boot
#   ./out/cubalc run ... pass|soft|catch|need|finally|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt TCR_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_TCR_REQUIRE
#
# Edges: TRY nested in IF steals END (W821) — FN wrap + CALL;
#   REQUIRE OK after uncaught FAIL → ok:false exit_code 0 (W7 class);
#   success skips CATCH; ONERR alias; PRINT clobber; WRITE NL

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# --- helpers (TRY/CATCH must not sit inside IF — W821 framing) ---

FN try_ok
  LET caught = 0
  LET cleaned = 0
  TRY
    PASS
  CATCH
    LET caught = 1
  FINALLY
    LET cleaned = 1
  END
  RET cleaned
END

FN try_catch_soft
  LET caught = 0
  LET cleaned = 0
  TRY
    FAIL "soft miss"
  CATCH
    LET caught = 1
    CLEAR_ERR
    PASS
  FINALLY
    LET cleaned = 1
  END
  RET caught
END

FN try_onerr
  LET caught = 0
  TRY
    FAIL "y"
  ONERR
    LET caught = 1
    CLEAR_ERR
    PASS
  END
  RET caught
END

FN try_catch_only
  LET caught = 0
  TRY
    FAIL "x"
  CATCH
    LET caught = 1
    CLEAR_ERR
    PASS
  END
  RET caught
END

FN try_finally_only
  LET cleaned = 0
  TRY
    LET z = 7
  FINALLY
    LET cleaned = 1
  END
  RET cleaned
END

FN try_cleanup_alias
  LET cleaned = 0
  TRY
    LET w = 2
  CLEANUP
    LET cleaned = 1
  END
  RET cleaned
END

FN needok_clean
  PASS
  NEEDOK
  RET REQUIRE_OK
END

FN needok_recover
  FAIL "soft"
  CLEAR_ERR
  PASS
  NEEDOK "recovered"
  RET REQUIRE_OK
END

FN require_ok_hit
  PASS
  REQUIRE OK
  RET REQUIRE_OK
END

FN require_success_hit
  PASS
  REQUIRE SUCCESS
  RET REQUIRE_OK
END

FN mustok_hit
  PASS
  MUSTOK
  RET REQUIRE_OK
END

FN assertok_hit
  PASS
  ASSERTOK
  RET REQUIRE_OK
END

FN require_ok_after_catch
  TRY
    FAIL "x"
  CATCH
    CLEAR_ERR
    PASS
  END
  REQUIRE OK
  RET REQUIRE_OK
END

NOTE "svc_try_catch_recover_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_try_catch_recover -- boot|pass|soft|catch|need|finally|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_TCR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "TCR_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET catch_n = 0
LET finally_n = 0
LET req_ok = 0

ONEOF ACTION "boot", "pass", "soft", "catch", "need", "finally", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "catch" THEN
    LET op = "catch"
  WHEN "need" THEN
    LET op = "need"
  WHEN "finally" THEN
    LET op = "finally"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-tcr\",\"schema\":\"cubalc.svc_try_catch_recover.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"tcr\",\"want_filter\":\"try_catch_recover\",\"cfg\":{\"surface\":\"TRY,CATCH,ONERR,FINALLY,CLEANUP,CATCH_N,FINALLY_N,REQUIRE OK,NEEDOK,MUSTOK,ASSERTOK,REQUIRE_OK\",\"contract\":\"soft recovery + always cleanup + OK status floor\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  CALL try_ok
  LET ok_v = LAST_N
  LET catch_n = CATCH_N
  LET finally_n = FINALLY_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-tcr"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF finally_n == 1 THEN
        IF catch_n == 0 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET score = 1
          LET find_n = finally_n
        ELSE
          LET miss = 1
          LET note_msg = "boot catch"
          FAIL "boot catch"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot finally"
        FAIL "boot finally"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot ret"
      FAIL "boot ret"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score catch_n finally_n note_msg
  CLEAR_ERR
END

# pass — success skips CATCH · FINALLY runs · REQUIRE OK
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL try_ok
  LET ok_v = LAST_N
  LET catch_n = CATCH_N
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF catch_n == 0 THEN
    LET score = score + 1
  END
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  CALL require_ok_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL require_success_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL mustok_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL assertok_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL needok_clean
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "try_catch_recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = finally_n
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score catch_n finally_n note_msg
  CLEAR_ERR
END

# soft — FAIL → CATCH recover · FINALLY · CATCH_N
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL try_catch_soft
  LET ok_v = LAST_N
  LET catch_n = CATCH_N
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF catch_n == 1 THEN
    LET score = score + 1
  END
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  CALL try_onerr
  LET ok_v = LAST_N
  LET catch_n = CATCH_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF catch_n == 1 THEN
    LET score = score + 1
  END
  CALL try_catch_only
  LET ok_v = LAST_N
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF finally_n == 0 THEN
    LET score = score + 1
  END
  CALL require_ok_after_catch
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = catch_n
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score catch_n note_msg
  CLEAR_ERR
END

# catch — dual recover paths + CATCH_N plate
SYS EQS op "catch"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL try_catch_soft
  LET ok_v = LAST_N
  LET catch_n = CATCH_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF catch_n == 1 THEN
    LET score = score + 1
  END
  CALL try_onerr
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL try_catch_only
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL try_ok
  LET catch_n = CATCH_N
  CLEAR_ERR
  IF catch_n == 0 THEN
    LET score = score + 1
  END
  CALL needok_recover
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL require_ok_after_catch
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "CATCH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "ONERR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "no_such_surface_tcr"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "catch ok"
    LET admit_n = 1
    LET find_n = catch_n
  ELSE
    LET miss = 1
    LET note_msg = "catch score"
    FAIL "catch score"
    CLEAR_ERR
  END
  SYS CAT "catch:" score ":ct"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "catch:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score catch_n note_msg
  CLEAR_ERR
END

# need — NEEDOK / REQUIRE OK aliases after clean/recover
SYS EQS op "need"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL needok_clean
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL needok_recover
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL require_ok_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL require_success_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL mustok_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL assertok_hit
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  CALL require_ok_after_catch
  LET req_ok = LAST_N
  CLEAR_ERR
  IF req_ok == 1 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "NEEDOK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "REQUIRE_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "need ok"
    LET admit_n = 1
    LET find_n = req_ok
  ELSE
    LET miss = 1
    LET note_msg = "need score"
    FAIL "need score"
    CLEAR_ERR
  END
  SYS CAT "need:" score ":nd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "need:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score req_ok note_msg
  CLEAR_ERR
END

# finally — FINALLY/CLEANUP always-run · FINALLY-only
SYS EQS op "finally"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL try_finally_only
  LET ok_v = LAST_N
  LET catch_n = CATCH_N
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF catch_n == 0 THEN
    LET score = score + 1
  END
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  CALL try_cleanup_alias
  LET ok_v = LAST_N
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  CALL try_catch_soft
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  CALL try_ok
  LET finally_n = FINALLY_N
  CLEAR_ERR
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "FINALLY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "CLEANUP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "finally ok"
    LET admit_n = 1
    LET find_n = finally_n
  ELSE
    LET miss = 1
    LET note_msg = "finally score"
    FAIL "finally score"
    CLEAR_ERR
  END
  SYS CAT "finally:" score ":fn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "finally:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score finally_n note_msg
  CLEAR_ERR
END

# form — HASFORM surface
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "TRY"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "CATCH"
  LET catch_n = LAST_N
  CLEAR_ERR
  HASFORM "ONERR"
  LET finally_n = LAST_N
  CLEAR_ERR
  HASFORM "FINALLY"
  LET req_ok = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF catch_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF finally_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF req_ok == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "NEEDOK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "CLEANUP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SYS TRY"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "try_catch_recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "REQUIRE OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — recover pipeline + REQUIRE env
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL try_catch_soft
  IF CATCH_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL require_ok_after_catch
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL try_ok
  IF CATCH_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL needok_clean
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL try_finally_only
  IF FINALLY_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-tcr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "try_catch_recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL try_ok
  LET finally_n = FINALLY_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF finally_n == 1 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "try_catch_recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "retry_hook"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL try_catch_soft
  IF CATCH_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL needok_clean
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = finally_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " catch_n=" catch_n " finally_n=" finally_n " req_ok=" req_ok
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "tcr report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
