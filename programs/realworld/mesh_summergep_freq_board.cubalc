# mesh_summergep_freq_board.cubalc — SUMMERGEP/SUBP/DIVP mesh FREQ rollup
#
# Real use: mesh ops sum-merge local+peer alert FREQ plates (warn/error/info),
# compute interval deltas with SUBP, and integer mean with DIVP — no
# TOKV+MERGEKV/DIFFKV glue. First realworld of proof 1162 SUMMERGEP (MEANINGFUL 621).
#
#   SUMMERGEP PLATE PEER          # sum shared ints · append b-only
#   SUBP now prev                 # a−b interval delta
#   DIVP 2 FROM LAST              # integer mean after merge
#   ADDFREQP / DELTAVP / IDIVP aliases
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_msf_$$
#   ./out/cubalc run programs/realworld/mesh_summergep_freq_board.cubalc boot
#   ./out/cubalc run ... merge|delta|mean|empty|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt MSF_REPORT.txt agent.json peer.json merged.json base.json
# Env: HOST_S ERR_MAX CUBALC_MSF_REQUIRE
#
# Edges:
#   sources unmutated; empty soft; host string kept; LAST not knobs;
#   WRITE omit NL; soft empty bag; NUM shuttle

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "mesh_summergep_freq_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "mesh_summergep_freq -- boot|merge|delta|mean|empty|gate|probe|soft|list -- [--host=H]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ERR_MAX = "20"
GETFLAG errmax|e OR ENV ERR_MAX OR ERR_MAX
SYS NUM
LET err_max = LAST_N
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_MSF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "MSF_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "merged.json"
LET merged_path = LAST
SYS JOIN state_dir "base.json"
LET base_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET merged = "{}"
LET base = "{}"

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "merge", "delta", "mean", "empty", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "merge" THEN
    LET op = "merge"
  WHEN "delta" THEN
    LET op = "delta"
  WHEN "mean" THEN
    LET op = "mean"
  WHEN "empty" THEN
    LET op = "empty"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s err_max
  CLEAR_ERR
END

# boot — local FREQ + peer FREQ + base snapshot for delta
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "agent" "freq-ctl" "warn" 2 "error" 5 "info" 1 "host" "cubeL" "schema" "cubalc.mesh_summergep.v1"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS JSONOBJ "agent" "hive-peer" "warn" 3 "error" 1 "crit" 4 "host" host_s "schema" "cubalc.mesh_summergep.v1"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  SYS JSONOBJ "warn" 1 "error" 2 "info" 1
  LET base = LAST
  CLEAR_ERR
  SYS WRITE base_path base
  CLEAR_ERR
  SUMMERGEP PLATE PEER
  LET merged = LAST
  CLEAR_ERR
  SYS WRITE merged_path merged
  CLEAR_ERR
  SYS JSON "warn" FROM merged
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "error" FROM merged
  SYS NUM
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "crit" FROM merged
  SYS NUM
  LET peel_hit = LAST_N
  CLEAR_ERR
  # sources unmutated
  GETP "warn"
  SYS NUM
  LET load_hit = LAST_N
  CLEAR_ERR
  IF take_n == 5 THEN
    IF has_n == 6 THEN
      IF peel_hit == 4 THEN
        IF load_hit == 2 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET created = 1
          SYS CAT "boot:" host_s ":bt"
          LET row = LAST
          CLEAR_ERR
          SYS GREPV "boot:" bag
          LET bag = LAST
          CLEAR_ERR
          SYS PUSH bag row
          LET bag = LAST
          LET bag_ch = 1
        ELSE
          LET miss = 1
          LET note_msg = "boot source mutated"
          FAIL "boot source mutated"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot crit"
        FAIL "boot crit"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot error sum"
      FAIL "boot error sum"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot warn sum"
    FAIL "boot warn sum"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# merge — SUMMERGEP write merged.json
SYS EQS op "merge"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SUMMERGEP PLATE PEER
  LET merged = LAST
  CLEAR_ERR
  SYS WRITE merged_path merged
  CLEAR_ERR
  SYS JSON "warn" FROM merged
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "info" FROM merged
  SYS NUM
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "host" FROM merged
  LET body = LAST
  CLEAR_ERR
  SYS EMPTY body
  LET peel_hit = LAST_N
  CLEAR_ERR
  # host non-int kept from a (should be non-empty)
  IF take_n == 5 THEN
    IF has_n == 1 THEN
      IF peel_hit == 0 THEN
        LET hit = 1
        LET note_msg = "merge ok"
        LET admit_n = 1
        LET load_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "merge host lost"
        FAIL "merge host lost"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "merge info"
      FAIL "merge info"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "merge warn"
    FAIL "merge warn"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "merge:" w_s ":mg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "merge:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit note_msg
  CLEAR_ERR
END

# delta — SUBP PLATE vs base (interval)
SYS EQS op "delta"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS READ OR base_path OR ""
  LET base = LAST
  CLEAR_ERR
  SYS LINES base
  IF LAST_N < 1 THEN
    SYS JSONOBJ "warn" 1 "error" 2 "info" 1
    LET base = LAST
    CLEAR_ERR
  END
  SUBP PLATE base
  LET body = LAST
  CLEAR_ERR
  SYS JSON "warn" FROM body
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "error" FROM body
  SYS NUM
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "info" FROM body
  SYS NUM
  LET peel_hit = LAST_N
  CLEAR_ERR
  # warn 2-1=1, error 5-2=3, info 1-1=0
  IF take_n == 1 THEN
    IF has_n == 3 THEN
      IF peel_hit == 0 THEN
        LET hit = 1
        LET note_msg = "delta ok"
        LET admit_n = 1
        LET load_hit = 1
        SYS WRITE report_path body
        CLEAR_ERR
      ELSE
        LET miss = 1
        LET note_msg = "delta info"
        FAIL "delta info"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "delta error"
      FAIL "delta error"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "delta warn"
    FAIL "delta warn"
    CLEAR_ERR
  END
  SYS STR has_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "delta:" w_s ":dl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "delta:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit note_msg
  CLEAR_ERR
END

# mean — SUMMERGEP then DIVP 2 FROM LAST
SYS EQS op "mean"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SUMMERGEP PLATE PEER
  LET merged = LAST
  CLEAR_ERR
  # DIVP FROM named capture — CLEAR_ERR can clobber LAST before DIVP FROM LAST
  DIVP 2 FROM merged
  LET body = LAST
  CLEAR_ERR
  SYS JSON "warn" FROM body
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "error" FROM body
  SYS NUM
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "crit" FROM body
  SYS NUM
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "info" FROM body
  SYS NUM
  LET load_hit = LAST_N
  CLEAR_ERR
  # warn 5/2=2, error 6/2=3, crit 4/2=2, info 1/2=0
  IF take_n == 2 THEN
    IF has_n == 3 THEN
      IF peel_hit == 2 THEN
        IF load_hit == 0 THEN
          LET hit = 1
          LET note_msg = "mean ok"
          LET admit_n = 1
          SYS WRITE merged_path body
          CLEAR_ERR
        ELSE
          LET miss = 1
          LET note_msg = "mean info"
          FAIL "mean info"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "mean crit"
        FAIL "mean crit"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "mean error"
      FAIL "mean error"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "mean warn"
    FAIL "mean warn"
    CLEAR_ERR
  END
  SYS STR has_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "mean:" w_s ":mn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "mean:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# empty — soft empty merge
SYS EQS op "empty"
IF LAST_N == 1 THEN
  LET known = 1
  LET empty_obj = "{}"
  SUMMERGEP empty_obj empty_obj
  LET body = LAST
  CLEAR_ERR
  SYS JSONLEN body
  LET take_n = LAST_N
  CLEAR_ERR
  SUBP empty_obj empty_obj
  SYS JSONLEN LAST
  LET has_n = LAST_N
  CLEAR_ERR
  IF take_n == 0 THEN
    IF has_n == 0 THEN
      LET hit = 1
      LET note_msg = "empty ok"
      LET admit_n = 0
      LET peel_hit = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "empty sub"
      FAIL "empty sub"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "empty merge"
    FAIL "empty merge"
    CLEAR_ERR
  END
  SYS CAT "empty:0:em"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "empty:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n note_msg
  CLEAR_ERR
END

# gate — merged error total under err_max
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SUMMERGEP PLATE PEER
  LET merged = LAST
  CLEAR_ERR
  SYS WRITE merged_path merged
  CLEAR_ERR
  SYS JSON "error" FROM merged
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  IF take_n <= err_max THEN
    IF take_n >= 1 THEN
      LET hit = 1
      LET note_msg = "gate ok"
      LET admit_n = 1
      LET peel_hit = 1
      LET has_n = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "gate zero err"
      FAIL "gate zero err"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate over err"
    FAIL "gate over err"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate over err"
    END
  END
  SYS STR take_n
  LET w_s = LAST
  SYS STR err_max
  LET d_s = LAST
  CLEAR_ERR
  SYS CAT "gate:" w_s ":" d_s ":ga"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n err_max note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — ADDFREQP alias; b-only negative SUBP; IDIVP FROM PEER; sources intact
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  ADDFREQP PLATE PEER
  LET body = LAST
  CLEAR_ERR
  SYS JSON "error" FROM body
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  # SUBP PLATE vs base for interval (LET-var SUBP flaky in large boards)
  SYS READ OR base_path OR ""
  LET base = LAST
  CLEAR_ERR
  SYS LINES base
  IF LAST_N < 1 THEN
    SYS JSONOBJ "warn" 1 "error" 2 "info" 1
    LET base = LAST
    CLEAR_ERR
  END
  SUBP PLATE base
  LET body = LAST
  CLEAR_ERR
  SYS JSON "error" FROM body
  SYS NUM
  LET has_n = LAST_N
  CLEAR_ERR
  # error 5-2=3
  IF has_n == 3 THEN
    LET peel_hit = 1
  ELSE
    LET peel_hit = 0
  END
  IDIVP FROM PEER 2
  LET body = LAST
  CLEAR_ERR
  SYS JSON "warn" FROM body
  SYS NUM
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "warn"
  SYS NUM
  LET miss_n = LAST_N
  CLEAR_ERR
  # peer source still warn=3 after IDIVP on copy
  IF take_n == 6 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF miss_n == 3 THEN
          LET hit = 1
          LET note_msg = "probe ok"
          LET admit_n = 1
          LET has_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "probe peer mutated"
          FAIL "probe peer mutated"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe idiv"
        FAIL "probe idiv"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe sub"
      FAIL "probe sub"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe addfreq"
    FAIL "probe addfreq"
    CLEAR_ERR
  END
  PRINT_JSON take_n has_n peel_hit load_hit miss_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
SYS STR admit_n
LET out = LAST
CLEAR_ERR
SYS CAT "schema=cubalc.mesh_summergep.v1 op=" op " hit=" w_s " miss=" d_s " admit=" out " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "msf op=" op " hit=" w_s " miss=" d_s " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n peel_hit has_n load_hit miss_n created err_max note_msg
