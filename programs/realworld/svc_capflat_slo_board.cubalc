# svc_capflat_slo_board.cubalc — CAPFLAT nest pure-int ceiling for SLO clamp
#
# Real use: clamp score/latency leaves to max without multi GETP+SETP glue.
# First realworld of proof 1223 CAPFLAT/CLAMPFLAT.
#
#   CAPFLAT|CLAMPFLAT [FROM plate] [needle] max
#   LAST_N = CAPFLAT_N changed · CAPFLAT_MATCH · CAPFLAT_MAX · SRC/FROM
#   pure-int only; path substring; bare CAPFLAT max = empty needle all ints
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_scf_$$
#   ./out/cubalc run programs/realworld/svc_capflat_slo_board.cubalc boot
#   ./out/cubalc run ... cap|peer|floor|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SCF_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SCF_REQUIRE
#
# Edges: score multi-clamp; peer latency; no-op when under; CLAMPFLAT 0;
#   empty-needle all-int; soft miss; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_capflat_slo_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_capflat_slo -- boot|cap|peer|floor|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeC"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SCF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SCF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "cap", "peer", "floor", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "cap" THEN
    LET op = "cap"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "floor" THEN
    LET op = "floor"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-capflat\",\"schema\":\"cubalc.svc_capflat_slo.v1\",\"site\":\"" host_s "\",\"score\":{\"a\":50,\"b\":150,\"c\":100},\"meta\":{\"score\":200,\"role\":\"worker\"},\"label\":\"capflat\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"latency\":{\"west\":900,\"east\":40},\"n\":1,\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "score.b"
  SYS EQS LAST "150"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "meta.score"
  SYS EQS LAST "200"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# cap — CAPFLAT score 100
SYS EQS op "cap"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "score.a" "50"
  CLEAR_ERR
  SETP "score.b" "150"
  CLEAR_ERR
  SETP "score.c" "100"
  CLEAR_ERR
  SETP "meta.score" "200"
  CLEAR_ERR
  CAPFLAT "score" 100
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF CAPFLAT_N == 2 THEN
    LET score = score + 1
  END
  IF CAPFLAT_MATCH == 4 THEN
    LET score = score + 1
  END
  IF CAPFLAT_MAX == 100 THEN
    LET score = score + 1
  END
  GETP "score.a"
  SYS EQS LAST "50"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "score.b"
  SYS EQS LAST "100"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "meta.score"
  SYS EQS LAST "100"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "cap ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "cap score"
    FAIL "cap score"
    CLEAR_ERR
  END
  SYS CAT "cap:" find_n ":cp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "cap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# peer — CAPFLAT FROM PEER latency 100
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP FROM PEER "latency.west" "900"
  CLEAR_ERR
  SETP FROM PEER "latency.east" "40"
  CLEAR_ERR
  CAPFLAT FROM PEER "latency" 100
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  IF CAPFLAT_FROM == 1 THEN
    LET score = score + 1
  END
  SYS EQS CAPFLAT_SRC "PEER"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "latency.west"
  SYS EQS LAST "100"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "latency.east"
  SYS EQS LAST "40"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "n"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" find_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# floor — already under max → N=0
SYS EQS op "floor"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "score.a" "1"
  CLEAR_ERR
  SETP "score.b" "2"
  CLEAR_ERR
  SETP "score.c" "3"
  CLEAR_ERR
  SETP "meta.score" "4"
  CLEAR_ERR
  CAPFLAT "score" 100
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF CAPFLAT_MATCH == 4 THEN
    LET score = score + 1
  END
  GETP "score.b"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "floor ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "floor score"
    FAIL "floor score"
    CLEAR_ERR
  END
  SYS CAT "floor:0:fl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "floor:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — ghost miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  CAPFLAT "ghostpath" 9
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF CAPFLAT_MATCH == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CAPFLAT "nope" 1
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — after cap all score leaves <= 100
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "score.a" "50"
  CLEAR_ERR
  SETP "score.b" "150"
  CLEAR_ERR
  SETP "meta.score" "200"
  CLEAR_ERR
  CAPFLAT "score" 100
  CLEAR_ERR
  GETP "score.b"
  SYS EQS LAST "100"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "meta.score"
  SYS EQS LAST "100"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_capflat_slo"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — CLAMPFLAT
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET PLATE = "{\"score\":{\"a\":5},\"label\":\"cl\"}"
  CLAMPFLAT "score" 0
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  GETP "score.a"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" find_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — empty needle all-int + strings skip
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET PLATE = "{\"a\":5,\"b\":20,\"c\":10,\"s\":\"z\"}"
  CAPFLAT 10
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  IF CAPFLAT_MATCH == 3 THEN
    LET score = score + 1
  END
  GETP "a"
  SYS EQS LAST "5"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "b"
  SYS EQS LAST "10"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "s"
  SYS EQS LAST "z"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring score matches meta.score and score.*
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "score.b" "200"
  CLEAR_ERR
  SETP "meta.score" "300"
  CLEAR_ERR
  CAPFLAT "score" 50
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n >= 2 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "capflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_capflat_slo.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_capflat_slo_board: end"
