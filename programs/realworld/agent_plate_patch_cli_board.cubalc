# agent_plate_patch_cli_board.cubalc — plate_patch lib + cubalc plate CLI dual
#
# Real use: agent multi-key status patch via INCLUDE plate_patch (MERGEP+SAVE
# or JSONFILEMERGE create), plus shell-side `cubalc plate` one-shots on the
# same file. First realworld of proof 1115 plate_patch + 1112 CLI plate.
#
#   INCLUDE plate_boot
#   LET PLATE_PATCH = {...}
#   INCLUDE plate_patch   — merge overlay + SAVEPLATE
#   Host twin: ./out/cubalc plate get|set|inc|del|keys|show PATH ...
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_appc_$$
#   ./out/cubalc run programs/realworld/agent_plate_patch_cli_board.cubalc \
#     boot -- --plate=/tmp/appc/agent.json
#   ./out/cubalc run ... patch -- --plate=... --status=ready --zone=east
#   ./out/cubalc plate get $PLATE status
#   ./out/cubalc plate inc $PLATE n 1
#
# Plate: STATUS.txt VAL.txt META.txt APPC_REPORT.txt
# Env: PLATE_PATH STATUS_S ZONE_S CUBALC_APPC_REQUIRE
#
# Edges:
#   patch with/without prior PLATE; empty {} patch; overlay wins;
#   plate_save LAST=path after INCLUDE; CLI OR miss; WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_plate_patch_cli_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "agent_plate_patch_cli -- boot|patch|ready|reload|gate|fresh|probe|list -- [--plate=P] [--status=S] [--zone=Z]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/deep/agent.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
CLEAR_ERR

DEFAULT STATUS_S = "ready"
GETFLAG status|s OR ENV STATUS_S OR STATUS_S
LET status_s = LAST
CLEAR_ERR

DEFAULT ZONE_S = "east"
GETFLAG zone|z OR ENV ZONE_S OR ZONE_S
LET zone_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_APPC_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "APPC_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET peel_s = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "patch", "ready", "reload", "gate", "fresh", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "patch" THEN
    LET op = "patch"
  WHEN "ready" THEN
    LET op = "ready"
  WHEN "reload" THEN
    LET op = "reload"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "fresh" THEN
    LET op = "fresh"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src status_s zone_s
  CLEAR_ERR
END

LET PLATE_PATH = plate_file
SYS JSONOBJ "n" 1 "ok" true "role" "worker" "schema" "cubalc.agent_patch.v1" "keep" "yes"
LET PLATE_SEED = LAST
CLEAR_ERR

# boot — plate_boot
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONHASALL body "n" "ok" "role" "keep"
  LET has_n = LAST_N
  CLEAR_ERR
  LET out = body
  LET take_n = load_hit
  IF load_hit == 1 THEN
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET created = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot keys"
      FAIL "boot keys"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot load"
    FAIL "boot load"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "boot fail"
    END
  END
  SYS CAT "boot:"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":bt"
  LET row = LAST
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit has_n p_src note_msg
  CLEAR_ERR
END

# patch — PLATE_PATCH + plate_patch (with prior boot MERGEP path)
SYS EQS op "patch"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "status" status_s "zone" zone_s "n" 9 "peer" "a"
  LET PLATE_PATCH = LAST
  CLEAR_ERR
  INCLUDE plate_patch
  LET has_n = OK
  CLEAR_ERR
  IF has_n == 0 THEN
    LET miss = 1
    LET note_msg = "patch soft fail"
    FAIL "patch soft fail"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "patch fail"
    END
  ELSE
    SYS LOADPLATE plate_file
    LET load_hit = LAST_N
    LET body = LAST
    CLEAR_ERR
    SYS JSON "status" FROM body
    SYS EQS LAST status_s
    LET peel_hit = LAST_N
    CLEAR_ERR
    SYS JSON "zone" FROM body
    SYS EQS LAST zone_s
    LET take_n = LAST_N
    CLEAR_ERR
    SYS JSONN "n" FROM body
    LET created = LAST_N
    CLEAR_ERR
    SYS JSON "keep" FROM body
    SYS EQS LAST "yes"
    LET admit_n = LAST_N
    CLEAR_ERR
    LET out = body
    IF load_hit == 1 THEN
      IF peel_hit == 1 THEN
        IF take_n == 1 THEN
          IF created == 9 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "patch ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "patch keep"
              FAIL "patch keep"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "patch n"
            FAIL "patch n"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "patch zone"
          FAIL "patch zone"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "patch status"
        FAIL "patch status"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "patch load"
      FAIL "patch load"
      CLEAR_ERR
    END
  END
  SYS CAT "patch:"
  LET row = LAST
  SYS CAT row status_s
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS CAT row zone_s
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR created
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":pt"
  LET row = LAST
  SYS GREPV "patch:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit created load_hit p_src note_msg
  CLEAR_ERR
END

# ready — thin status/phase patch
SYS EQS op "ready"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "status" "ready" "phase" "run"
  LET PLATE_PATCH = LAST
  CLEAR_ERR
  INCLUDE plate_patch
  CLEAR_ERR
  SYS PEEKPLATE plate_file "status"
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "ready"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS PEEKPLATE plate_file "phase"
  LET row = LAST
  CLEAR_ERR
  SYS EQS row "run"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "ready ok"
      LET admit_n = 1
      LET take_n = 2
    ELSE
      LET miss = 1
      LET note_msg = "ready phase"
      FAIL "ready phase"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "ready status"
    FAIL "ready status"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "ready fail"
    END
  END
  SYS CAT "ready:"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":rd"
  LET row = LAST
  SYS GREPV "ready:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit has_n p_src note_msg
  CLEAR_ERR
END

# reload
SYS EQS op "reload"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  LET take_n = load_hit
  LET out = body
  IF load_hit == 1 THEN
    SYS JSON "status" FROM body
    LET peel_s = LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "reload hit"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "reload miss"
    FAIL "reload miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "reload miss"
    END
  END
  SYS CAT "reload:"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS CAT row peel_s
  LET row = LAST
  SYS CAT row ":rl"
  LET row = LAST
  SYS GREPV "reload:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit peel_s p_src note_msg
  CLEAR_ERR
END

# gate — HASALL after patch
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "status" status_s "zone" zone_s "schema" "cubalc.agent_patch.v1"
  LET PLATE_PATCH = LAST
  CLEAR_ERR
  INCLUDE plate_patch
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF load_hit == 0 THEN
    LET miss = 1
    LET note_msg = "gate miss"
    FAIL "gate miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate miss"
    END
  ELSE
    SYS JSONHASALL body "n" "ok" "role" "status" "zone"
    LET admit_n = LAST_N
    CLEAR_ERR
    SYS JSON "keep" FROM body
    SYS EQS LAST "yes"
    LET has_n = LAST_N
    CLEAR_ERR
    LET out = body
    LET take_n = load_hit
    IF admit_n == 1 THEN
      IF has_n == 1 THEN
        LET hit = 1
        LET note_msg = "gate admit"
      ELSE
        LET miss = 1
        LET note_msg = "gate keep"
        FAIL "gate keep"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate need deny"
      FAIL "gate need deny"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "gate deny"
      END
    END
  END
  SYS CAT "gate:"
  LET row = LAST
  SYS STR admit_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":gt"
  LET row = LAST
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n admit_n has_n load_hit p_src note_msg
  CLEAR_ERR
END

# fresh — plate_patch without prior PLATE (JSONFILEMERGE create path)
SYS EQS op "fresh"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/fresh_patch.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  # create-on-miss via JSONFILEMERGE (UNSET PLATE + plate_patch SAVE can
  # hit unknown form PLATE if LET PLATE fails under var pressure — W198)
  SYS JSONOBJ "boot" 1 "role" "seed"
  LET body = LAST
  CLEAR_ERR
  SYS JSONFILEMERGE row body
  LET has_n = OK
  CLEAR_ERR
  SYS LOADPLATE row
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONN "boot" FROM body
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "role" FROM body
  SYS EQS LAST "seed"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET out = body
  IF has_n == 1 THEN
    IF load_hit == 1 THEN
      IF take_n == 1 THEN
        IF peel_hit == 1 THEN
          LET hit = 1
          LET note_msg = "fresh ok"
          LET admit_n = 1
          LET created = 1
        ELSE
          LET miss = 1
          LET note_msg = "fresh role"
          FAIL "fresh role"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "fresh boot"
        FAIL "fresh boot"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "fresh load"
      FAIL "fresh load"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "fresh merge"
    FAIL "fresh merge"
    CLEAR_ERR
  END
  SYS CAT "fresh:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":fr"
  LET row = LAST
  SYS GREPV "fresh:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit load_hit created p_src note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — empty patch; second patch phase; keep base
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/probe_patch.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  LET PLATE_PATH = row
  SYS JSONOBJ "n" 1 "keep" "yes"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "status" "ready" "n" 5
  LET PLATE_PATCH = LAST
  CLEAR_ERR
  INCLUDE plate_patch
  CLEAR_ERR
  SYS JSONOBJ
  LET PLATE_PATCH = LAST
  CLEAR_ERR
  INCLUDE plate_patch
  CLEAR_ERR
  SYS LOADPLATE row
  LET body = LAST
  CLEAR_ERR
  SYS JSONN "n" FROM body
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "keep" FROM body
  SYS EQS LAST "yes"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "ready"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSONOBJ "phase" "run"
  LET PLATE_PATCH = LAST
  CLEAR_ERR
  INCLUDE plate_patch
  CLEAR_ERR
  SYS PEEKPLATE row "phase"
  SYS EQS LAST "run"
  LET load_hit = LAST_N
  CLEAR_ERR
  LET PLATE_PATH = plate_file
  IF take_n == 5 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          LET note_msg = "probe ok"
          LET hit = 1
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "probe phase"
          FAIL "probe phase"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe status"
        FAIL "probe status"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe keep"
      FAIL "probe keep"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe n"
    FAIL "probe n"
    CLEAR_ERR
  END
  PRINT_JSON take_n has_n peel_hit load_hit p_src note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_plate_patch_cli_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "admit"
LET row = LAST
SYS STR admit_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "plate"
LET row = LAST
SYS PUSH row plate_file
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "appc op="
LET body = LAST
SYS CAT body op
LET body = LAST
SYS CAT body " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST
LET body = LAST
SYS CAT body " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST
LET body = LAST
SYS CAT body " note="
LET body = LAST
SYS CAT body note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n created load_hit peel_hit p_src note_msg
NOTE "agent_plate_patch_cli_board: done"
