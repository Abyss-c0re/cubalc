# svc_relatedtopic_mesh_board.cubalc — RELATEDTOPIC neighbor mesh for fleets
#
# Real use: fleet agents route discovery topics by neighbor bags
# (RELATEDTOPIC/SEETOPICS), peel one-line docs (TOPICHINT) on first neighbor,
# and walk full catalog (EACH TOPIC) for mesh inventory — dual of RELATED for
# forms, but for usability topics. First realworld of proof 1340 RELATEDTOPIC.
#
#   RELATEDTOPIC|SEETOPICS name → RELATEDTOPIC_OF · RELATEDTOPIC_N · bag
#   TOPICHINT first neighbor · EACH TOPIC + RELATEDTOPIC floor
#   soft miss zzz · bare need name · forms→cap · HAS substring false friend
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_srt_$$
#   ./out/cubalc run programs/realworld/svc_relatedtopic_mesh_board.cubalc boot
#   ./out/cubalc run ... mesh|first|walk|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SRT_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SRT_REQUIRE TOPIC_S
#
# Edges: PRINT clobber before TOPICHINT LAST; HAS vs HASLINE; soft miss;
#   bare RELATEDTOPIC; WRITE NL; forms alias

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_relatedtopic_mesh_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_relatedtopic_mesh -- boot|mesh|first|walk|soft|gate|alias|probe|list -- [--host=H] [--role=R] [--topic=T]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT TOPIC_S = "plate"
GETFLAG topic|t OR ENV TOPIC_S OR TOPIC_S
LET topic_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SRT_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SRT_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET rel_n = 0
LET walk_n = 0
LET topic_got = ""

ONEOF ACTION "boot", "mesh", "first", "walk", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "mesh" THEN
    LET op = "mesh"
  WHEN "first" THEN
    LET op = "first"
  WHEN "walk" THEN
    LET op = "walk"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s topic_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  SYS TRIM topic_s
  LET topic_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-reltopic\",\"schema\":\"cubalc.svc_relatedtopic_mesh.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"mesh\",\"label\":\"reltopic\",\"cfg\":{\"topic\":\"" topic_s "\",\"surface\":\"RELATEDTOPIC,SEETOPICS,TOPICHINT\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"topicmesh\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_relatedtopic_mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  SYS EQS LAST topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RELATEDTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# mesh — RELATEDTOPIC plate/cap/p2p neighbor bags
SYS EQS op "mesh"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  RELATEDTOPIC topic_s
  LET body = LAST
  LET rel_n = RELATEDTOPIC_N
  LET topic_got = RELATEDTOPIC_OF
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # plate does not neighbor cap
  SYS HASLINE body "cap"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RELATEDTOPIC cap
  LET body = LAST
  LET rel_n = RELATEDTOPIC_N
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASLINE body "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RELATEDTOPIC p2p
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RELATEDTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "mesh ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "mesh score"
    FAIL "mesh score"
    CLEAR_ERR
  END
  SYS CAT "mesh:" rel_n ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "mesh:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n topic_got score note_msg
  CLEAR_ERR
END

# first — NTH first neighbor + TOPICHINT (capture before PRINT)
SYS EQS op "first"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  RELATEDTOPIC topic_s
  LET body = LAST
  LET rel_n = RELATEDTOPIC_N
  CLEAR_ERR
  SYS NTH 0 body
  LET stem_s = LAST
  CLEAR_ERR
  SYS TRIM stem_s
  LET stem_s = LAST
  CLEAR_ERR
  # capture stem before any PRINT
  TOPICHINT stem_s
  LET sum_v = OK
  LET row = LAST
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got stem_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  HASTOPIC stem_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # var topic
  LET t = "lib"
  RELATEDTOPIC t
  LET body = LAST
  LET topic_got = RELATEDTOPIC_OF
  CLEAR_ERR
  SYS EQS topic_got "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF RELATEDTOPIC_N >= 3 THEN
    LET score = score + 1
  END
  GETP "cfg.topic"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "first ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "first score"
    FAIL "first score"
    CLEAR_ERR
  END
  SYS CAT "first:" stem_s ":ft"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "first:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s rel_n score note_msg
  CLEAR_ERR
END

# walk — EACH TOPIC + RELATEDTOPIC floor
SYS EQS op "walk"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET walk_n = 0
  LET sum_n = 0
  EACH TOPIC AS t
    LET walk_n = walk_n + 1
    RELATEDTOPIC t
    IF OK == 1 THEN
      IF RELATEDTOPIC_N >= 3 THEN
        LET sum_n = sum_n + 1
      END
    END
    CLEAR_ERR
  END
  CLEAR_ERR
  IF walk_n == 8 THEN
    LET score = score + 1
  END
  IF sum_n == 8 THEN
    LET score = score + 1
  END
  LISTTOPICS
  LET find_n = LISTTOPICS_N
  CLEAR_ERR
  IF find_n == 8 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "SEETOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "relatedtopic_mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "walk ok"
    LET admit_n = 1
    LET find_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "walk score"
    FAIL "walk score"
    CLEAR_ERR
  END
  SYS CAT "walk:" walk_n ":wk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "walk:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n sum_n score note_msg
  CLEAR_ERR
END

# soft — miss + bare
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RELATEDTOPIC zzz_nope
  LET sum_v = OK
  LET rel_n = RELATEDTOPIC_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF rel_n == 0 THEN
    LET score = score + 1
  END
  RELATEDTOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RELATEDTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate topic contract + live mesh
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  RELATEDTOPIC topic_s
  LET rel_n = RELATEDTOPIC_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  HASTOPIC topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RELATEDTOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOPICHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "relatedtopic_mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n score note_msg
  CLEAR_ERR
END

# alias — SEETOPICS forms→cap
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SEETOPICS forms
  LET topic_got = RELATEDTOPIC_OF
  LET rel_n = RELATEDTOPIC_N
  LET body = LAST
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASLINE body "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SEETOPICS protect
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "reltopic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "SEETOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n topic_got score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + HAS substring false friend
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RELATEDTOPIC plate
  LET body = LAST
  LET rel_n = RELATEDTOPIC_N
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE stem_s "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE LAST "fat"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend
  SYS HAS stem_s "fa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "fa"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # PRINT then TOPICHINT LAST would miss — use captured NTH
  SYS NTH 0 stem_s
  LET row = LAST
  CLEAR_ERR
  TOPICHINT row
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "relatedtopic_mesh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOPICHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" rel_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_relatedtopic_mesh.v1 host=" host_s " role=" role_s " topic=" topic_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " rel_n=" rel_n " walk_n=" walk_n " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_relatedtopic_mesh_board: done"
PASS
