# deploy_step_board.cubalc — durable numbered deploy steps under STATE
#
# Real use: agents keep a step bag, ENUMERATE order, PREFIXALL env,
# SUFFIXALL status, and SETMATCH transitions without shell sed.
#
# Actions (CUBALC_ARG0 / CUBALC_DS_ACTION):
#   list     — depth + pending/done tallies (default)
#   seed     — WORDS step names (plain tokens); optional renumber
#   add      — PUSH step name if absent
#   drop     — REMOVELINE by exact field (full token)
#   number   — ENUMERATE bag start 1 sep "."
#   tag_env  — PREFIXALL env/ (ARG1 env name, default prod)
#   tag_stat — SUFFIXALL :status (ARG1 status, default pending)
#   arm      — number + tag_env + tag_stat pipeline → plate
#   fill     — FILL N status tokens (capacity board, ARG1=N ARG2=token)
#   pass     — SETMATCH first *:pending → *:done for step identity
#   fail     — SETMATCH first match → *:failed
#   pin      — MOVELINE first pending to front
#   has      — HASLINE exact
#   count    — COUNTLINE exact
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1="build test deploy smoke" \
#     ./out/cubalc run -q -s programs/realworld/deploy_step_board.cubalc
#   CUBALC_ARG0=arm CUBALC_ARG1=prod ./out/cubalc run -q -s ...
#   CUBALC_ARG0=pass CUBALC_ARG1=build ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_DS_FILE=STEPS.txt
#   CUBALC_DS_ENV=prod
#   CUBALC_DS_REQUIRE=1
#
# Edges deliberately stressed:
#   ENUMERATE/PREFIXALL/SUFFIXALL return LAST — need LET bag = LAST
#   PREFIXALL accepts string var for prefix (unlike ZIP sep)
#   ENUMERATE sep third arg may need literal
#   pass identity: GREP step name substring-unsafe; walk BEFORE/AFTER
#   SUFFIXALL :pending then SETMATCH full token for status flip
#   FILL n status for ZIP capacity; PRINT_JSON collapse; WRITE NL
#   soft READ empty; REQUIRE miss

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "deploy_step_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT ENVN = "prod"
DEFAULT RFILE = "STEPS.txt"
DEFAULT REPORT = "STEPS_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_DS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_DS_NAME" OR ""
  LET NAME = LAST
END
SYS ENV "CUBALC_DS_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_DS_ENV" OR ""
IF LAST_N > 0 THEN
  LET ENVN = LAST
END
SYS ENV "CUBALC_DS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

# for arm: ARG1 may be env override
SYS EQS ACTION "arm"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET ENVN = NAME
  END
END
SYS EQS ACTION "tag_env"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET ENVN = NAME
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR "soft steps load"
SYS LINES bag
LET depth0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET n_pending = 0
LET n_done = 0
LET n_failed = 0
LET idx = -1
LET old_entry = ""
LET entry = ""
LET note_msg = "ok"
LET pref = ""

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS GREP ":pending" bag
  SYS LINES LAST
  LET n_pending = LAST_N
  SYS GREP ":done" bag
  SYS LINES LAST
  LET n_done = LAST_N
  SYS GREP ":failed" bag
  SYS LINES LAST
  LET n_failed = LAST_N
  STATUS
  PRINT "deploy" depth0 n_pending n_done n_failed ACTION
  PRINT_JSON depth0 n_pending n_done n_failed ACTION STATUS_OK
  PRINT_JSON bag
  LET note_msg = "list ok"
END

# --- seed plain names ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs step names"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      # identity on bare name or as substring after last /
      LET name_hit = 0
      EACH LINE AS row IN bag
        SYS EQS row n
        IF LAST_N == 1 THEN
          LET name_hit = 1
        END
        SYS HASI row n
        IF LAST_N == 1 THEN
          SYS ENDS row n
          IF LAST_N == 1 THEN
            LET name_hit = 1
          END
          SYS ENDS row n
        END
      END
      # simpler: HASLINE exact only for seed of plain names
      SYS HASLINE bag n
      IF LAST_N == 0 THEN
        SYS PUSH bag n
        LET bag = LAST
        LET changed = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded"
END

# --- add ---
SYS EQS ACTION "add"
IF LAST_N == 1 THEN
  NOTE "action add"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "add needs step"
  END
  SYS HASLINE bag NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET hit = 1
    LET note_msg = "add already"
  ELSE
    SYS PUSH bag NAME
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "added"
  END
END

# --- drop exact ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs exact field or name"
  END
  SYS HASLINE bag NAME
  IF LAST_N == 1 THEN
    SYS REMOVELINE bag NAME
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "dropped exact"
  ELSE
    # try find by step name identity in armed tokens
    LET name_hit = 0
    LET old_entry = ""
    EACH LINE AS row IN bag
      # strip env prefix and index and status for identity
      SYS AFTER row "/"
      LET rest = LAST
      SYS BLANK rest
      IF LAST_N == 1 THEN
        LET rest = row
      END
      # rest may be 1.build:pending or build:pending or build
      SYS BEFORE rest ":"
      LET core = LAST
      SYS AFTER core "."
      LET step = LAST
      SYS BLANK step
      IF LAST_N == 1 THEN
        LET step = core
      END
      SYS EQS step NAME
      IF LAST_N == 1 THEN
        IF name_hit == 0 THEN
          LET old_entry = row
          LET name_hit = 1
        END
      END
    END
    IF name_hit == 0 THEN
      LET miss = 1
      LET note_msg = "drop miss"
      FAIL "drop miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "drop miss"
      END
    ELSE
      SYS REMOVELINE bag old_entry
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "dropped by name"
    END
  END
END

# --- number ENUMERATE ---
SYS EQS ACTION "number"
IF LAST_N == 1 THEN
  NOTE "action number"
  SYS LINES bag
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "number empty"
    FAIL "number empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "number empty"
    END
  ELSE
    # peel bare step names if already armed: use VALS/KEYS hard — walk AFTER
    SYS ENUMERATE bag 1 "."
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "numbered"
  END
END

# --- tag_env PREFIXALL ---
SYS EQS ACTION "tag_env"
IF LAST_N == 1 THEN
  NOTE "action tag_env"
  SYS LINES bag
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "tag_env empty"
    FAIL "tag_env empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "tag_env empty"
    END
  ELSE
    # build env/ prefix via REPLACEALL template (literal /)
    LET pref = "ENV/"
    SYS REPLACEALL pref "ENV" ENVN
    LET pref = LAST
    SYS PREFIXALL bag pref
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "tagged env"
  END
END

# --- tag_stat SUFFIXALL ---
SYS EQS ACTION "tag_stat"
IF LAST_N == 1 THEN
  NOTE "action tag_stat"
  LET st = "pending"
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET st = NAME
  END
  SYS LINES bag
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "tag_stat empty"
    FAIL "tag_stat empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "tag_stat empty"
    END
  ELSE
    LET suf = ":STAT"
    SYS REPLACEALL suf "STAT" st
    LET suf = LAST
    SYS SUFFIXALL bag suf
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "tagged status"
  END
END

# --- arm: number then env then pending ---
SYS EQS ACTION "arm"
IF LAST_N == 1 THEN
  NOTE "action arm"
  SYS LINES bag
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "arm empty"
    FAIL "arm empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "arm empty"
    END
  ELSE
    SYS ENUMERATE bag 1 "."
    LET bag = LAST
    LET pref = "ENV/"
    SYS REPLACEALL pref "ENV" ENVN
    LET pref = LAST
    SYS PREFIXALL bag pref
    LET bag = LAST
    SYS SUFFIXALL bag ":pending"
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "armed"
  END
END

# --- fill capacity ---
SYS EQS ACTION "fill"
IF LAST_N == 1 THEN
  NOTE "action fill"
  LET n = 3
  LET tok = "idle"
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    SYS PREPEND "" NAME
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET n = LAST_N
    END
  END
  SYS ARG 2 OR ""
  IF LAST_N > 0 THEN
    LET tok = LAST
  ELSE
    SYS ENV "CUBALC_DS_FILL" OR "idle"
    LET tok = LAST
  END
  SYS MAX n 0
  LET n = LAST_N
  IF n > 64 THEN
    LET n = 64
  END
  SYS FILL n tok
  LET bag = LAST
  LET changed = 1
  LET hit = n
  LET note_msg = "filled"
END

# --- pass: find step → SETMATCH pending→done ---
SYS EQS ACTION "pass"
IF LAST_N == 1 THEN
  NOTE "action pass"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "pass needs step name"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    # match if row ends with NAME:pending or contains .NAME:pending
    SYS HASI row ":pending"
    IF LAST_N == 1 THEN
      SYS BEFORE row ":"
      LET core = LAST
      SYS AFTER core "."
      LET step = LAST
      SYS BLANK step
      IF LAST_N == 1 THEN
        LET step = core
      END
      # also strip env prefix from step if present
      SYS AFTER step "/"
      LET s2 = LAST
      SYS BLANK s2
      IF LAST_N == 0 THEN
        LET step = s2
      END
      SYS EQS step NAME
      IF LAST_N == 1 THEN
        IF name_hit == 0 THEN
          LET old_entry = row
          LET name_hit = 1
        END
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "pass miss"
    FAIL "pass miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pass miss"
    END
  ELSE
    SYS BEFORE old_entry ":"
    LET core = LAST
    LET entry = "CORE:done"
    SYS REPLACEALL entry "CORE" core
    LET entry = LAST
    SYS SETMATCH bag old_entry entry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "pass setmatch miss"
      FAIL "setmatch"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "passed"
    END
  END
END

# --- fail status ---
SYS EQS ACTION "fail"
IF LAST_N == 1 THEN
  NOTE "action fail"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "fail needs step name"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    LET core = LAST
    SYS AFTER core "."
    LET step = LAST
    SYS BLANK step
    IF LAST_N == 1 THEN
      LET step = core
    END
    SYS AFTER step "/"
    LET s2 = LAST
    SYS BLANK s2
    IF LAST_N == 0 THEN
      LET step = s2
    END
    SYS EQS step NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "fail miss"
    FAIL "fail miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "fail miss"
    END
  ELSE
    SYS BEFORE old_entry ":"
    LET core = LAST
    LET entry = "CORE:failed"
    SYS REPLACEALL entry "CORE" core
    LET entry = LAST
    SYS SETMATCH bag old_entry entry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "fail setmatch"
      FAIL "setmatch"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "failed step"
    END
  END
END

# --- pin first pending ---
SYS EQS ACTION "pin"
IF LAST_N == 1 THEN
  NOTE "action pin"
  SYS GREP ":pending" bag
  LET pend = LAST
  SYS LINES pend
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "pin no pending"
    FAIL "pin empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pin miss"
    END
  ELSE
    SYS HEAD pend
    LET old_entry = LAST
    SYS FINDLINE bag old_entry
    LET idx = LAST_N
    SYS MOVELINE bag idx 0
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "pin moveline miss"
      FAIL "moveline"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET idx = 0
      LET note_msg = "pinned pending"
    END
  END
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs token"
  END
  SYS HASLINE bag NAME
  LET hit = LAST_N
  LET note_msg = "has"
END

# --- count ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs token"
  END
  SYS COUNTLINE bag NAME
  LET hit = LAST_N
  LET note_msg = "counted"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "add"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
SYS EQS ACTION "number"
LET k = k + LAST_N
SYS EQS ACTION "tag_env"
LET k = k + LAST_N
SYS EQS ACTION "tag_stat"
LET k = k + LAST_N
SYS EQS ACTION "arm"
LET k = k + LAST_N
SYS EQS ACTION "fill"
LET k = k + LAST_N
SYS EQS ACTION "pass"
LET k = k + LAST_N
SYS EQS ACTION "fail"
LET k = k + LAST_N
SYS EQS ACTION "pin"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

# post tallies
SYS GREP ":pending" bag
SYS LINES LAST
LET n_pending = LAST_N
SYS GREP ":done" bag
SYS LINES LAST
LET n_done = LAST_N
SYS GREP ":failed" bag
SYS LINES LAST
LET n_failed = LAST_N

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "steps write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.deploy.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "name"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "env"
LET report = LAST
SYS PUSH report ENVN
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_pending"
LET report = LAST
SYS STR n_pending
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_done"
LET report = LAST
SYS STR n_done
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_failed"
LET report = LAST
SYS STR n_failed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth0"
LET report = LAST
SYS STR depth0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "deploy" ACTION hit miss changed n_pending n_done n_failed depth0 depth1
PRINT_JSON ACTION hit miss changed n_pending n_done n_failed depth0 depth1 idx elapsed STATUS_OK
PASS "deploy tick"
NOTE "deploy_step_board: done"
CLEAR_ERR
EXIT 0 "deploy ok"
