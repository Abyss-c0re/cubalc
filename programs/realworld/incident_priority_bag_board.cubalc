# incident_priority_bag_board.cubalc — COUNTLINE/MOVELINE/SETMATCH priority queue
#
# Real use: on-call agents maintain an in-memory+durable incident bag.
# Promote critical rows to front (FINDLINE+MOVELINE), tally exact severities
# (COUNTLINE), rewrite status (SETMATCH), ack first exact (REMOVELINE).
# Stresses exact bag field ops vs substring false friends.
#
#   SYS COUNTLINE bag needle  → LAST_N exact field hits
#   SYS FINDLINE bag needle   → LAST_N 0-based index (soft -1? / 0 miss)
#   SYS MOVELINE bag from to  → reorder · LAST bag · LAST_N 1|0
#   SYS SETMATCH bag old new  → replace first exact · LAST_N 1|0
#   SYS REMOVELINE bag needle → drop first exact · LAST_N 1|0
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ipb_$$
#   ./out/cubalc run programs/realworld/incident_priority_bag_board.cubalc \
#     boot
#   ./out/cubalc run ... admit -- --id=INC-9 --sev=crit
#   ./out/cubalc run ... promote -- --id=INC-9
#   ./out/cubalc run ... count -- --sev=crit
#   ./out/cubalc run ... set -- --id=INC-9 --sev=ack
#   ./out/cubalc run ... ack -- --id=INC-9
#   ./out/cubalc run ... gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt IPB_REPORT.txt  (bag = STATUS body)
# Env: ID_S SEV_S CUBALC_IPB_REQUIRE
#
# Edges:
#   COUNTLINE exact not substring; MOVELINE OOR soft; SETMATCH miss soft;
#   REMOVELINE first-only; GREPV prefix false-friend; empty bag; WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "incident_priority_bag_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "incident_priority_bag -- boot|admit|promote|demote|count|set|ack|gate|probe|soft|list -- [--id=I] [--sev=S]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT ID_S = "INC-1"
GETFLAG id|i OR ENV ID_S OR ID_S
LET id_s = LAST
CLEAR_ERR

DEFAULT SEV_S = "crit"
GETFLAG sev|s OR ENV SEV_S OR SEV_S
LET sev_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IPB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IPB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "admit", "promote", "demote", "count", "set", "ack", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "admit" THEN
    LET op = "admit"
  WHEN "promote" THEN
    LET op = "promote"
  WHEN "demote" THEN
    LET op = "demote"
  WHEN "count" THEN
    LET op = "count"
  WHEN "set" THEN
    LET op = "set"
  WHEN "ack" THEN
    LET op = "ack"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n id_s sev_s
  CLEAR_ERR
END

# boot — seed three incidents (warn/crit/info) in bag STATUS
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = "INC-1:warn\nINC-2:crit\nINC-3:info"
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  SYS COUNTLINE bag "INC-2:crit"
  LET has_n = LAST_N
  CLEAR_ERR
  IF bag_n == 3 THEN
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET created = 1
      LET take_n = 3
    ELSE
      LET miss = 1
      LET note_msg = "boot count"
      FAIL "boot count"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot n"
    FAIL "boot n"
    CLEAR_ERR
  END
  PRINT_JSON bag_n has_n take_n note_msg
  CLEAR_ERR
END

# admit — PUSH id:sev (exact row)
SYS EQS op "admit"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT id_s ":" sev_s
  LET row = LAST
  CLEAR_ERR
  SYS HASLINE bag row
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    LET miss = 1
    LET note_msg = "admit dup"
    FAIL "admit dup"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "admit dup"
    END
  ELSE
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    SYS LINES bag
    LET bag_n = LAST_N
    SYS HASLINE bag row
    LET peel_hit = LAST_N
    CLEAR_ERR
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "admit ok"
      LET admit_n = 1
      LET take_n = 1
      LET out = row
    ELSE
      LET miss = 1
      LET note_msg = "admit push"
      FAIL "admit push"
      CLEAR_ERR
    END
  END
  PRINT_JSON bag_n peel_hit has_n note_msg
  CLEAR_ERR
END

# promote — FINDLINE id:sev + MOVELINE to front (index 0)
SYS EQS op "promote"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT id_s ":" sev_s
  LET row = LAST
  CLEAR_ERR
  SYS FINDLINE bag row
  LET take_n = LAST_N
  CLEAR_ERR
  # FINDLINE miss: LAST_N 0 and may equal first index when hit at 0
  SYS HASLINE bag row
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    LET miss = 1
    LET note_msg = "promote miss"
    FAIL "promote miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "promote miss"
    END
  ELSE
    SYS MOVELINE bag take_n 0
    LET peel_hit = LAST_N
    LET bag = LAST
    CLEAR_ERR
    IF peel_hit == 1 THEN
      LET bag_ch = 1
      SYS NTH 0 bag
      LET body = LAST
      CLEAR_ERR
      SYS EQS body row
      LET load_hit = LAST_N
      CLEAR_ERR
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "promote ok"
        LET admit_n = 1
        LET out = body
      ELSE
        LET miss = 1
        LET note_msg = "promote head"
        FAIL "promote head"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "promote move"
      FAIL "promote move"
      CLEAR_ERR
    END
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# demote — FINDLINE + MOVELINE to end
SYS EQS op "demote"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT id_s ":" sev_s
  LET row = LAST
  CLEAR_ERR
  SYS HASLINE bag row
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    LET miss = 1
    LET note_msg = "demote miss"
    FAIL "demote miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "demote miss"
    END
  ELSE
    SYS FINDLINE bag row
    LET take_n = LAST_N
    CLEAR_ERR
    SYS LINES bag
    LET bag_n = LAST_N
    # to = bag_n-1 via clamp: use large to
    SYS MOVELINE bag take_n 99
    LET peel_hit = LAST_N
    LET bag = LAST
    CLEAR_ERR
    IF peel_hit == 1 THEN
      LET bag_ch = 1
      # no SYS DEC/ADD for bag_n-1 — REVL+NTH 0 peels tail
      SYS REVL bag
      LET body = LAST
      CLEAR_ERR
      SYS NTH 0 body
      LET body = LAST
      CLEAR_ERR
      SYS EQS body row
      LET load_hit = LAST_N
      CLEAR_ERR
      SYS LINES bag
      LET bag_n = LAST_N
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "demote ok"
        LET admit_n = 1
        LET out = body
      ELSE
        LET miss = 1
        LET note_msg = "demote tail"
        FAIL "demote tail"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "demote move"
      FAIL "demote move"
      CLEAR_ERR
    END
  END
  PRINT_JSON bag_n take_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# count — COUNTLINE exact id:sev and COUNTLINEI / substring trap
SYS EQS op "count"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT id_s ":" sev_s
  LET row = LAST
  CLEAR_ERR
  SYS COUNTLINE bag row
  LET take_n = LAST_N
  CLEAR_ERR
  # substring false friend: needle without full field
  SYS COUNTLINE bag id_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS COUNTLINE bag sev_s
  LET load_hit = LAST_N
  CLEAR_ERR
  # total crit fields if sev is crit pattern — count all :crit rows via TALLY of known
  SYS COUNTLINE bag "INC-2:crit"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS LINES bag
  LET bag_n = LAST_N
  # exact count may be 0 (soft) without FAIL when require off
  IF peel_hit == 0 THEN
    IF load_hit == 0 THEN
      LET hit = 1
      LET note_msg = "count ok"
      LET admit_n = 1
      LET out = row
    ELSE
      # sev alone matched a field (unlikely for "crit" alone if fields are id:sev)
      LET hit = 1
      LET note_msg = "count sev-alone"
      LET admit_n = 1
    END
  ELSE
    # id alone matched full field — would be exact id-only row
    LET hit = 1
    LET note_msg = "count id-alone"
    LET admit_n = 1
  END
  PRINT_JSON bag_n take_n peel_hit load_hit has_n note_msg
  CLEAR_ERR
END

# set — SETMATCH rewrite first exact id:oldsev → id:newsev (sev_s is new)
SYS EQS op "set"
IF LAST_N == 1 THEN
  LET known = 1
  # old row: find any line starting with id: via GREP then exact SETMATCH
  SYS GREP id_s bag
  LET body = LAST
  CLEAR_ERR
  SYS NTH 0 body
  LET row = LAST
  CLEAR_ERR
  SYS BLANK row
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    LET miss = 1
    LET note_msg = "set miss"
    FAIL "set miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "set miss"
    END
  ELSE
    SYS CAT id_s ":" sev_s
    LET out = LAST
    CLEAR_ERR
    SYS SETMATCH bag row out
    LET peel_hit = LAST_N
    LET bag = LAST
    CLEAR_ERR
    IF peel_hit == 1 THEN
      LET bag_ch = 1
      SYS HASLINE bag out
      LET load_hit = LAST_N
      CLEAR_ERR
      # old exact gone (unless same)
      SYS EQS row out
      LET take_n = LAST_N
      CLEAR_ERR
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "set ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "set has"
        FAIL "set has"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "set match"
      FAIL "set match"
      CLEAR_ERR
    END
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit take_n note_msg
  CLEAR_ERR
END

# ack — REMOVELINE first exact id:sev
SYS EQS op "ack"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT id_s ":" sev_s
  LET row = LAST
  CLEAR_ERR
  SYS REMOVELINE bag row
  LET peel_hit = LAST_N
  LET bag = LAST
  CLEAR_ERR
  IF peel_hit == 1 THEN
    LET bag_ch = 1
    SYS HASLINE bag row
    LET has_n = LAST_N
    CLEAR_ERR
    IF has_n == 0 THEN
      LET hit = 1
      LET note_msg = "ack ok"
      LET admit_n = 1
      LET take_n = 1
    ELSE
      # first-only: may still have second same row
      LET hit = 1
      LET note_msg = "ack first"
      LET admit_n = 1
      LET take_n = 1
    END
  ELSE
    LET miss = 1
    LET note_msg = "ack miss"
    FAIL "ack miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "ack miss"
    END
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit has_n note_msg
  CLEAR_ERR
END

# gate — head is crit (NTH 0 ends with :crit) and bag non-empty
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "gate empty"
    FAIL "gate empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate empty"
    END
  ELSE
    SYS NTH 0 bag
    LET body = LAST
    CLEAR_ERR
    SYS ENDS body ":crit"
    LET has_n = LAST_N
    CLEAR_ERR
    SYS COUNTLINE bag body
    LET take_n = LAST_N
    CLEAR_ERR
    IF has_n == 1 THEN
      IF take_n >= 1 THEN
        LET hit = 1
        LET note_msg = "gate ok"
        LET admit_n = 1
        LET out = body
        LET peel_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "gate count"
        FAIL "gate count"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate head"
      FAIL "gate head"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "gate head"
      END
    END
  END
  PRINT_JSON bag_n has_n take_n peel_hit note_msg
  CLEAR_ERR
END

# soft — empty bag soft miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — OOR MOVELINE, COUNTLINE substring, SETMATCH miss, REMOVELINE substring
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  # no standalone "ERROR" field — only "ERROR boom" / "ERROR fixed" (substring trap)
  LET body = "ERROR boom\nWARN\nERROR fixed\nINC-x:crit"
  CLEAR_ERR
  # COUNTLINE exact: "ERROR" alone must NOT hit longer fields
  SYS COUNTLINE body "ERROR"
  LET take_n = LAST_N
  CLEAR_ERR
  SYS COUNTLINE body "ERROR boom"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # MOVELINE OOR soft
  SYS MOVELINE body 99 0
  LET has_n = LAST_N
  CLEAR_ERR
  # SETMATCH miss soft
  SYS SETMATCH body "NOPE" "x"
  LET load_hit = LAST_N
  CLEAR_ERR
  # REMOVELINE substring miss (no exact ERROR field)
  SYS REMOVELINE body "ERROR"
  LET miss_n = LAST_N
  CLEAR_ERR
  # REMOVELINE exact hit
  SYS REMOVELINE body "ERROR boom"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF take_n == 0 THEN
    IF peel_hit == 1 THEN
      IF has_n == 0 THEN
        IF load_hit == 0 THEN
          IF miss_n == 0 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "probe ok"
            ELSE
              LET miss = 1
              LET note_msg = "probe rm exact"
              FAIL "probe rm exact"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe rm sub"
            FAIL "probe rm sub"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe setmiss"
          FAIL "probe setmiss"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe move oor"
        FAIL "probe move oor"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe count boom"
      FAIL "probe count boom"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe count ERROR"
    FAIL "probe count ERROR"
    CLEAR_ERR
  END
  PRINT_JSON take_n peel_hit has_n load_hit miss_n admit_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

# META compact (avoid var thrash)
SYS CAT "schema=cubalc.incident_priority_bag.v1 op=" op " hit="
LET row = LAST
SYS STR hit
SYS CAT row LAST " miss="
LET row = LAST
SYS STR miss
SYS CAT row LAST " admit="
LET row = LAST
SYS STR admit_n
SYS CAT row LAST " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "ipb op=" op " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n peel_hit has_n load_hit created note_msg
