# zone_load_where_board.cubalc — SUMWHERE/AVGWHERE/MINWHERE/MAXWHERE zone load
#
# Real use: capacity agents track Shard fleet (h0..h2) with zone string +
# numeric load/cost. Roll up per-zone sum/avg/min/max without GETFWHERE +
# SYS SUM/AVG/MIN/MAX glue, then admit when zone cost sum ≤ budget.
#
# Surfaces forced (1.15.358–359):
#   SUMWHERE / TOTALWHERE / SUMIF / AVGWHERE / MEANWHERE
#   MINWHERE / MAXWHERE / MINIF / MAXIF
#   COUNTWHERE · DUMPOBJ rehydrate LOOKUP/LOOKUPN · bag journal
#   soft TRYSEND + REQUIRE miss (EXIT only in action bodies)
#
# Distinct from latency_median (MEDIANF fleet-wide), cost_unit (unit plate),
# shard_load_pick (pick min host), job_retry_where (status ladder): this board
# is *filtered numeric rollup by zone string + budget admit*.
#
# Slots: h0 h1 h2
#
# Plate under STATE:
#   dump/h0 dump/h1 dump/h2
#   JOURNAL.txt OBJS.txt VAL.txt META.txt STATS.txt ZONE_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_FS_ACTION):
#   list       — LISTOBJS Shard
#   open       — NEW Shard ARG1=hN [zone=ARG2 default default]
#   setzone    — SETF zone ARG2
#   setload    — SETF load ARG2 (numeric)
#   setcost    — SETF cost ARG2 (numeric)
#   sum_load   — SUMWHERE load WHERE zone ARG1
#   avg_load   — AVGWHERE load WHERE zone ARG1
#   min_load   — MINWHERE load WHERE zone ARG1
#   max_load   — MAXWHERE load WHERE zone ARG1
#   sum_cost   — SUMWHERE cost WHERE zone ARG1
#   count_zn   — COUNTWHERE zone ARG1
#   admit      — SUMWHERE cost zone WANT ≤ BUDGET; REQUIRE→2 if over
#   journal / count / pin / setmatch
#   probe / dump / clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_zlw_$$
#   CUBALC_ARG0=open CUBALC_ARG1=h0 CUBALC_ARG2=us-east
#   CUBALC_ARG0=setload CUBALC_ARG1=h0 CUBALC_ARG2=40
#   CUBALC_ARG0=sum_load CUBALC_ARG1=us-east
#   CUBALC_ARG0=admit CUBALC_FS_WANT=us-east CUBALC_FS_BUDGET=100 CUBALC_FS_REQUIRE=1
#
# Env: CUBALC_FS_REQUIRE NAME WANT BUDGET ACTION
#
# Edges:
#   no-match SUM/AVG/MIN/MAX → 0 (cannot distinguish empty vs zero load)
#   AVG empty sample → 0 (not soft miss / NaN)
#   zone match equality only — substring false friends (us vs us-east)
#   NOBJS stale until LISTOBJS; LOOKUPN for numeric rehydrate
#   WRITE NL; NUM REQUIRE/BUDGET softens; SETMATCH first-only

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS Shard
  FIELD id ""
  FIELD zone "default"
  FIELD load 0
  FIELD cost 0
  METHOD init i z
    SETF THIS id i
    SETF THIS zone z
    SETF THIS load 0
    SETF THIS cost 0
  END
END

NOTE "zone_load_where_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT NEED_HIT = 0
DEFAULT WANT = "default"
DEFAULT BUDGET = 100
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_FS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_FS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_FS_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_FS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET NEED_HIT = LAST_N
  END
END
SYS ENV "CUBALC_FS_WANT" OR ""
IF LAST_N > 0 THEN
  LET WANT = LAST
END
SYS ENV "CUBALC_FS_BUDGET" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET BUDGET = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "dump"
LET dump_dir = LAST
SYS MKDIR dump_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JOURNAL.txt"
LET journal_path = LAST
SYS JOIN state_dir "STATS.txt"
LET stats_path = LAST
SYS JOIN state_dir "ZONE_REPORT.txt"
LET report_path = LAST
SYS JOIN dump_dir "h0"
LET d_h0 = LAST
SYS JOIN dump_dir "h1"
LET d_h1 = LAST
SYS JOIN dump_dir "h2"
LET d_h2 = LAST

LET slot = -1
SYS EQS NAME "h0"
IF LAST_N == 1 THEN
  LET slot = 0
END
SYS EQS NAME "h1"
IF LAST_N == 1 THEN
  LET slot = 1
END
SYS EQS NAME "h2"
IF LAST_N == 1 THEN
  LET slot = 2
END
LET sn = ""
IF slot == 0 THEN
  LET sn = "h0"
END
IF slot == 1 THEN
  LET sn = "h1"
END
IF slot == 2 THEN
  LET sn = "h2"
END

# rehydrate h0
SYS READ OR d_h0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ h0
  IF LAST_N == 1 THEN
    DELETEOBJ h0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "zone"
  LET rzn = LAST
  SYS LOOKUPN snap "load"
  LET rld = LAST_N
  SYS LOOKUPN snap "cost"
  LET rct = LAST_N
  CLEAR_ERR
  NEW Shard h0 rid rzn
  TRYSETF h0 zone rzn
  TRYSETF h0 load rld
  TRYSETF h0 cost rct
  CLEAR_ERR
END
# rehydrate h1
SYS READ OR d_h1 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ h1
  IF LAST_N == 1 THEN
    DELETEOBJ h1
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "zone"
  LET rzn = LAST
  SYS LOOKUPN snap "load"
  LET rld = LAST_N
  SYS LOOKUPN snap "cost"
  LET rct = LAST_N
  CLEAR_ERR
  NEW Shard h1 rid rzn
  TRYSETF h1 zone rzn
  TRYSETF h1 load rld
  TRYSETF h1 cost rct
  CLEAR_ERR
END
# rehydrate h2
SYS READ OR d_h2 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ h2
  IF LAST_N == 1 THEN
    DELETEOBJ h2
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "zone"
  LET rzn = LAST
  SYS LOOKUPN snap "load"
  LET rld = LAST_N
  SYS LOOKUPN snap "cost"
  LET rct = LAST_N
  CLEAR_ERR
  NEW Shard h2 rid rzn
  TRYSETF h2 zone rzn
  TRYSETF h2 load rld
  TRYSETF h2 cost rct
  CLEAR_ERR
END

SYS READ OR journal_path OR ""
LET jbag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET nobjs = 0
LET ret_n = 0
LET j_changed = 0
LET board_rep = "zone_load_where_board"

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS Shard
  LET bag = LAST
  LET nobjs = NOBJS
  SYS WRITE objs_path bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- open ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    LET zn0 = "default"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET zn0 = A2
    END
    IF slot == 0 THEN
      HASOBJ h0
      IF LAST_N == 1 THEN
        DELETEOBJ h0
        CLEAR_ERR
      END
      NEW Shard h0 sn zn0
      DUMPOBJ h0
      SYS WRITE d_h0 LAST
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ h1
      IF LAST_N == 1 THEN
        DELETEOBJ h1
        CLEAR_ERR
      END
      NEW Shard h1 sn zn0
      DUMPOBJ h1
      SYS WRITE d_h1 LAST
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ h2
      IF LAST_N == 1 THEN
        DELETEOBJ h2
        CLEAR_ERR
      END
      NEW Shard h2 sn zn0
      DUMPOBJ h2
      SYS WRITE d_h2 LAST
      CLEAR_ERR
    END
    LISTOBJS Shard
    LET nobjs = NOBJS
    SYS WRITE objs_path LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "open ok"
    LET val = sn
    LET val_ch = 1
    LET meta = "open"
    SYS PUSH meta sn
    LET meta = LAST
    SYS PUSH meta zn0
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- setzone ---
SYS EQS ACTION "setzone"
IF LAST_N == 1 THEN
  NOTE "action setzone"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "setzone bad slot"
    FAIL "setzone bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "setzone bad slot"
    END
  ELSE
    LET zn0 = "default"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET zn0 = A2
    END
    LET ok_set = 0
    IF slot == 0 THEN
      HASOBJ h0
      IF LAST_N == 1 THEN
        SETF h0 zone zn0
        LET ok_set = 1
        DUMPOBJ h0
        SYS WRITE d_h0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ h1
      IF LAST_N == 1 THEN
        SETF h1 zone zn0
        LET ok_set = 1
        DUMPOBJ h1
        SYS WRITE d_h1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ h2
      IF LAST_N == 1 THEN
        SETF h2 zone zn0
        LET ok_set = 1
        DUMPOBJ h2
        SYS WRITE d_h2 LAST
        CLEAR_ERR
      END
    END
    IF ok_set == 0 THEN
      LET miss = 1
      LET note_msg = "setzone no obj"
      FAIL "setzone no obj"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "setzone no obj"
      END
    ELSE
      LET hit = 1
      LET note_msg = "setzone ok"
      LET val = zn0
      LET val_ch = 1
      LET meta = "setzone"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta zn0
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

