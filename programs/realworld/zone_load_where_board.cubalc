# --- admit: SUMWHERE cost zone ≤ BUDGET ---
# empty zone: sum=0 always admits under positive budget — document as weakness
SYS EQS ACTION "admit"
IF LAST_N == 1 THEN
  NOTE "action admit"
  LET zn0 = WANT
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET zn0 = NAME
  END
  SUMWHERE Shard cost zone zn0
  LET ret_n = LAST_N
  LET n_hit = SUMWHERE_N
  LET val = "deny"
  LET miss = 1
  LET hit = 0
  LET note_msg = "admit deny"
  IF ret_n <= BUDGET THEN
    LET val = "admit"
    LET miss = 0
    LET hit = 1
    LET note_msg = "admit ok"
  END
  LET val_ch = 1
  LET meta = "admit"
  SYS PUSH meta zn0
  LET meta = LAST
  SYS STR ret_n
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR BUDGET
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR n_hit
  SYS PUSH meta LAST
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
  IF miss > 0 THEN
    FAIL "admit deny cost over budget"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "admit deny cost over budget"
    END
  END
END

# --- journal ---
SYS EQS ACTION "journal"
IF LAST_N == 1 THEN
  NOTE "action journal"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "journal needs slot"
    FAIL "journal needs slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "journal needs slot"
    END
  ELSE
    LET ev = "note"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET ev = A2
    END
    LET jev = "DEP:EV"
    SYS REPLACEALL jev "DEP" NAME
    LET jev = LAST
    SYS REPLACEALL jev "EV" ev
    LET jev = LAST
    SYS PUSH jbag jev
    LET jbag = LAST
    LET j_changed = 1
    LET hit = 1
    LET note_msg = "journal ok"
    LET val = jev
    LET val_ch = 1
    LET meta = "journal"
    SYS PUSH meta jev
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- count journal ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "count needs needle"
    FAIL "count needs needle"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "count needs needle"
    END
  ELSE
    SYS COUNTLINE jbag NAME
    LET ret_n = LAST_N
    LET hit = 1
    SYS STR ret_n
    LET val = LAST
    LET val_ch = 1
    LET note_msg = "count ok"
    LET meta = "count"
    SYS PUSH meta NAME
    LET meta = LAST
    SYS PUSH meta val
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- pin ---
SYS EQS ACTION "pin"
IF LAST_N == 1 THEN
  NOTE "action pin"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "pin needs row"
    FAIL "pin needs row"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "pin needs row"
    END
  ELSE
    SYS FINDLINE jbag NAME
    LET idx = LAST_N
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "pin miss"
      FAIL "pin miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "pin miss"
      END
    ELSE
      SYS MOVELINE jbag idx 0
      LET jbag = LAST
      LET j_changed = 1
      LET hit = 1
      LET note_msg = "pin ok"
      LET val = NAME
      LET val_ch = 1
      LET meta = "pin"
      SYS PUSH meta NAME
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- setmatch ---
SYS EQS ACTION "setmatch"
IF LAST_N == 1 THEN
  NOTE "action setmatch"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "setmatch needs old"
    FAIL "setmatch needs old"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "setmatch needs old"
    END
  ELSE
    SYS BLANK A2
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "setmatch needs new"
      FAIL "setmatch needs new"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "setmatch needs new"
      END
    ELSE
      SYS HASLINE jbag NAME
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "setmatch miss"
        FAIL "setmatch miss"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "setmatch miss"
        END
      ELSE
        SYS SETMATCH jbag NAME A2
        IF LAST_N == 0 THEN
          LET miss = 1
          LET note_msg = "setmatch fail"
          FAIL "setmatch fail"
          CLEAR_ERR
        ELSE
          LET jbag = LAST
          LET j_changed = 1
          LET hit = 1
          LET note_msg = "setmatch ok"
          LET val = A2
          LET val_ch = 1
          LET meta = "setmatch"
          SYS PUSH meta NAME
          LET meta = LAST
          SYS PUSH meta A2
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- probe ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET soft_m = 0
  LET soft_f = 0
  HASOBJ h0
  IF LAST_N == 1 THEN
    TRYSEND h0 no_such_method
    IF OK == 0 THEN
      LET soft_m = 1
    END
    CLEAR_ERR
    TRYSETF h0 no_such_field 1
    IF OK == 0 THEN
      LET soft_f = 1
    END
    CLEAR_ERR
  ELSE
    LET soft_m = 1
    LET soft_f = 1
  END
  SUMWHERE Shard load zone "no_such_zone"
  LET empty_sum = LAST_N
  CLEAR_ERR
  AVGWHERE Shard load zone "no_such_zone"
  LET empty_avg = LAST_N
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  LET val = "probe"
  LET val_ch = 1
  LET meta = "probe"
  SYS STR soft_m
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR soft_f
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR empty_sum
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR empty_avg
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "dump bad slot"
    FAIL "dump bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "dump bad slot"
    END
  ELSE
    LET ok_d = 0
    IF slot == 0 THEN
      HASOBJ h0
      IF LAST_N == 1 THEN
        DUMPOBJ h0
        LET val = LAST
        SYS WRITE d_h0 val
        CLEAR_ERR
        LET ok_d = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ h1
      IF LAST_N == 1 THEN
        DUMPOBJ h1
        LET val = LAST
        SYS WRITE d_h1 val
        CLEAR_ERR
        LET ok_d = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ h2
      IF LAST_N == 1 THEN
        DUMPOBJ h2
        LET val = LAST
        SYS WRITE d_h2 val
        CLEAR_ERR
        LET ok_d = 1
      END
    END
    IF ok_d == 0 THEN
      LET miss = 1
      LET note_msg = "dump no obj"
      FAIL "dump no obj"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "dump no obj"
      END
    ELSE
      LET hit = 1
      LET note_msg = "dump ok"
      LET val_ch = 1
      LET meta = "dump"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ h0
  IF LAST_N == 1 THEN
    DELETEOBJ h0
    CLEAR_ERR
  END
  HASOBJ h1
  IF LAST_N == 1 THEN
    DELETEOBJ h1
    CLEAR_ERR
  END
  HASOBJ h2
  IF LAST_N == 1 THEN
    DELETEOBJ h2
    CLEAR_ERR
  END
  SYS WRITE d_h0 ""
  SYS WRITE d_h1 ""
  SYS WRITE d_h2 ""
  SYS WRITE journal_path ""
  SYS WRITE objs_path ""
  SYS WRITE stats_path ""
  LET jbag = ""
  LET j_changed = 0
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

