        EXIT 2 "setcost no obj"
      END
    ELSE
      LET hit = 1
      LET note_msg = "setcost ok"
      SYS STR n0
      LET val = LAST
      LET val_ch = 1
      LET meta = "setcost"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- sum_load ---
SYS EQS ACTION "sum_load"
IF LAST_N == 1 THEN
  NOTE "action sum_load"
  LET zn0 = WANT
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET zn0 = NAME
  END
  SUMWHERE Shard load zone zn0
  LET ret_n = LAST_N
  LET n_hit = SUMWHERE_N
  SYS STR ret_n
  LET val = LAST
  SYS WRITE stats_path val
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "sum_load ok"
  LET val_ch = 1
  LET meta = "sum_load"
  SYS PUSH meta zn0
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  SYS STR n_hit
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON ret_n
  CLEAR_ERR
END

