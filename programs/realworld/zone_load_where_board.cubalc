IF LAST_N == 1 THEN
  NOTE "action count_zn"
  LET zn0 = WANT
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET zn0 = NAME
  END
  COUNTWHERE Shard zone zn0
  LET ret_n = LAST_N
  LET hit = 1
  LET note_msg = "count_zn ok"
  SYS STR ret_n
