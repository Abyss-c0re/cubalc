# svc_topic_runbook_board.cubalc — TIPS + FORMSFOR + FORMHINT topic runbook
#
# Real use: fleet ops agents discover curated next-steps (TIPS) and the form
# surface for a usability topic (FORMSFOR), then peel one-line HELP hints
# (FORMHINT) before executing plate/cap/lib runbooks — no cookbook scrape.
# First realworld of proofs 1328 FORMHINT + 1329 TIPS + 1330 FORMSFOR.
#
#   TIPS|HOWTO [topic] · FORMSFOR|TOPICFORMS [topic] · FORMHINT|DESCRIBEFORM name
#   topics: general|cap|fat|plate|p2p|run|lib|protect (+ aliases forms→cap)
#   soft miss unknown topic OK=0 · var topic after lex_next fix
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_str_$$
#   ./out/cubalc run programs/realworld/svc_topic_runbook_board.cubalc boot
#   ./out/cubalc run ... tips|forms|hint|digest|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt STR_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_STR_REQUIRE TOPIC_S
#
# Edges: var topic; PRINT clobber LAST bag; SYS HAS substring false friend;
#   HASLINE exact; soft unknown topic; FORMHINT multi-word; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_topic_runbook_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_topic_runbook -- boot|tips|forms|hint|digest|soft|gate|alias|probe|list -- [--host=H] [--role=R] [--topic=T]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT TOPIC_S = "plate"
GETFLAG topic|t OR ENV TOPIC_S OR TOPIC_S
LET topic_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_STR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "STR_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET tips_n = 0
LET forms_n = 0
LET topic_got = ""

ONEOF ACTION "boot", "tips", "forms", "hint", "digest", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "tips" THEN
    LET op = "tips"
  WHEN "forms" THEN
    LET op = "forms"
  WHEN "hint" THEN
    LET op = "hint"
  WHEN "digest" THEN
    LET op = "digest"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s topic_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  SYS TRIM topic_s
  LET topic_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-topicrb\",\"schema\":\"cubalc.svc_topic_runbook.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"topic\",\"label\":\"topicrb\",\"cfg\":{\"topic\":\"" topic_s "\",\"surface\":\"TIPS,FORMSFOR,FORMHINT\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"runbook\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_topic_runbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  SYS EQS LAST topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# tips — TIPS plate (or flag topic) + capture bag before PRINT
SYS EQS op "tips"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  # var topic (post-fix lex_next)
  TIPS topic_s
  LET body = LAST
  LET tips_n = TIPS_N
  LET topic_got = TIPS_TOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  SYS EQS topic_got topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "plate_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # default bare TIPS general
  TIPS
  LET sum_n = TIPS_N
  LET stem_s = TIPS_TOPIC
  CLEAR_ERR
  IF sum_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "tips ok"
    LET admit_n = 1
    LET find_n = tips_n
  ELSE
    LET miss = 1
    LET note_msg = "tips score"
    FAIL "tips score"
    CLEAR_ERR
  END
  SYS CAT "tips:" tips_n ":tp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "tips:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n topic_got score note_msg
  CLEAR_ERR
END

# forms — FORMSFOR topic bag + exact HASLINE vs HAS false friend
SYS EQS op "forms"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  FORMSFOR topic_s
  LET body = LAST
  LET forms_n = FORMSFOR_N
  LET topic_got = FORMSFOR_TOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "NEEDP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend: SYS HAS matches subtoken; HASLINE is exact field
  SYS HAS body "SET"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "SET"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  # cap topic forms include HASFORM
  FORMSFOR cap
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "HASFORM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMSFOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "forms ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "forms score"
    FAIL "forms score"
    CLEAR_ERR
  END
  SYS CAT "forms:" forms_n ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "forms:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n topic_got score note_msg
  CLEAR_ERR
END

# hint — FORMHINT on curated form names
SYS EQS op "hint"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FORMHINT SETP
  LET body = LAST
  LET stem_s = FORM
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  DESCRIBEFORM LIBAGE
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS FORM "LIBAGE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMHINT "REQUIRE FN"
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss
  FORMHINT NO_SUCH_FORM_XYZ_ZZZ
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "FORMHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hint ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hint score"
    FAIL "hint score"
    CLEAR_ERR
  END
  SYS CAT "hint:1:hn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hint:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# digest — one topic: tips + forms + first form hint (runbook packet)
SYS EQS op "digest"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  TIPS topic_s
  LET body = LAST
  LET tips_n = TIPS_N
  CLEAR_ERR
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  FORMSFOR topic_s
  LET row = LAST
  LET forms_n = FORMSFOR_N
  LET topic_got = FORMSFOR_TOPIC
  CLEAR_ERR
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  # first form name via SYS NTH 0
  SYS NTH 0 row
  LET stem_s = LAST
  CLEAR_ERR
  FORMHINT stem_s
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS FORM stem_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # alias forms→cap
  FORMSFOR forms
  LET topic_got = FORMSFOR_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "digest ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "digest score"
    FAIL "digest score"
    CLEAR_ERR
  END
  SYS CAT "digest:" forms_n ":dg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "digest:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n forms_n stem_s score note_msg
  CLEAR_ERR
END

# soft — unknown topic soft miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  TIPS zzz_no_topic
  LET sum_v = OK
  LET tips_n = TIPS_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF tips_n == 0 THEN
    LET score = score + 1
  END
  FORMSFOR zzz_no_topic
  LET sum_v = OK
  LET forms_n = FORMSFOR_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF forms_n == 0 THEN
    LET score = score + 1
  END
  FORMHINT NO_SUCH_FORM_XYZ_ZZZ
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_v score note_msg
  CLEAR_ERR
END

# gate — plate surface contract + live FORMSFOR
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  FORMSFOR topic_s
  LET forms_n = FORMSFOR_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  TIPS topic_s
  LET tips_n = TIPS_N
  CLEAR_ERR
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "TIPS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMSFOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "topic_runbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n forms_n score note_msg
  CLEAR_ERR
END

# alias — HOWTO / TOPICFORMS / PLAYBOOK duals
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HOWTO p2p
  LET tips_n = TIPS_N
  LET topic_got = HOWTO_TOPIC
  CLEAR_ERR
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPICFORMS lib
  LET forms_n = FORMSFOR_N
  LET stem_s = FORMSFOR_TOPIC
  CLEAR_ERR
  IF forms_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PLAYBOOK fat
  LET sum_n = TIPS_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  DESCRIBEFORM SORTLIBS
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "topicrb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n forms_n score note_msg
  CLEAR_ERR
END

# probe — dual edges PRINT clobber + topic aliases + soft
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FORMSFOR plate
  LET body = LAST
  LET forms_n = FORMSFOR_N
  CLEAR_ERR
  # intentional PRINT then bad HASLINE LAST — capture first
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE stem_s "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # after PRINT, LAST is mark not bag
  SYS HASLINE LAST "SETP"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # alias mesh→p2p
  FORMSFOR mesh
  LET topic_got = FORMSFOR_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TIPS capability
  LET topic_got = TIPS_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # CLI dual count skew note: in-lang plate tips_n may be 3 vs CLI 4
  TIPS plate
  LET tips_n = TIPS_N
  CLEAR_ERR
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  IF tips_n <= 4 THEN
    LET score = score + 1
  END
  GETP "cfg.topic"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "topic_runbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" forms_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n tips_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_topic_runbook.v1 host=" host_s " role=" role_s " topic=" topic_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " tips_n=" tips_n " forms_n=" forms_n " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_topic_runbook_board: done"
PASS
