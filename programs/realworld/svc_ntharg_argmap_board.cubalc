# svc_ntharg_argmap_board.cubalc — NTHARG/GETARG + ARGMAP/ARGKV fleet raw argv peel
#
# Real use: fleet agents inventory full CUBALC_ARGn (flags kept) as i=value
# bag and peel by index without NTHPOS rest-only confusion or EACH SYS ARG.
# First realworld of 1369 ARGMAP + 1370 NTHARG (1.15.821+).
#
#   ARGMAP|ARGKV → bag 0=… · ARGMAP_N · LOOKUP by index
#   NTHARG|GETARG idx [OR default] → LAST + NTHARG_HIT · NTHARG_N=index
#   NTHPOS peels non-flag only · soft miss · OR fallback LAST_N quirk
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_naa_$$
#   ./out/cubalc run programs/realworld/svc_ntharg_argmap_board.cubalc boot
#   ./out/cubalc run ... map|peel|dual|miss|cmp|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt NAA_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_NAA_REQUIRE
#
# Edges: CUBALC_ARG* via SYS ENV SET only (W1); NTHARG_N is index not count;
#   OR miss LAST_N=0 with LAST=default; bare LOOKUP form fails (need SYS LOOKUP);
#   PRINT clobber; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_ntharg_argmap_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ntharg_argmap -- boot|map|peel|dual|miss|cmp|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_NAA_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "NAA_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "ARGMAP.txt"
LET argmap_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET flag_n = 0
LET rest_n = 0
LET argc_n = 0
LET map_n = 0
LET peel_s = ""
LET hit_n = 0

ONEOF ACTION "boot", "map", "peel", "dual", "miss", "cmp", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "map" THEN
    LET op = "map"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "dual" THEN
    LET op = "dual"
  WHEN "miss" THEN
    LET op = "miss"
  WHEN "cmp" THEN
    LET op = "cmp"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-naa\",\"schema\":\"cubalc.svc_ntharg_argmap.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"raw_argv\",\"label\":\"naa\",\"cfg\":{\"surface\":\"ARGMAP,ARGKV,NTHARG,GETARG,NTHPOS,FLAGMAP,LOOKUP\",\"contract\":\"i=value peel + OR miss\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"raw_argv\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-naa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_ntharg_argmap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "naa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "raw_argv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# map — ARGMAP full i=value bag + LOOKUP + FLAGMAP coexist
SYS EQS op "map"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "--out=hi.txt"
  SYS ENV SET CUBALC_ARG2 "a.txt"
  SYS ENV SET CUBALC_ARG3 "b.txt"
  SYS ENV SET CUBALC_ARGC "4"
  ARGMAP
  LET map_n = ARGMAP_N
  LET body = ARGMAP
  LET argc_n = ARGC
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF map_n == 4 THEN
    LET score = score + 1
  END
  IF argc_n == 4 THEN
    LET score = score + 1
  END
  SYS HASLINE body "0=--verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "1=--out=hi.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "2=a.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "3=b.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS LOOKUP ARGMAP "2" "="
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "a.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FLAGMAP
  IF FLAGMAP_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE FLAGMAP "out=hi.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  ARGMAP
  IF ARGMAP_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LOOKUP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 13 THEN
    LET hit = 1
    LET note_msg = "map ok"
    LET admit_n = 1
    LET find_n = map_n
  ELSE
    LET miss = 1
    LET note_msg = "map score"
    FAIL "map score"
    CLEAR_ERR
  END
  SYS WRITE argmap_path body
  CLEAR_ERR
  SYS CAT "map:" map_n ":mp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "map:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n map_n score note_msg
  CLEAR_ERR
END

# peel — NTHARG/GETARG index peel (flags kept)
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "--out=x"
  SYS ENV SET CUBALC_ARG2 "a.txt"
  SYS ENV SET CUBALC_ARGC "3"
  NTHARG 0
  LET peel_s = LAST
  LET hit_n = NTHARG_HIT
  LET sum_n = NTHARG_N
  CLEAR_ERR
  SYS EQS peel_s "--verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_n == 1 THEN
    LET score = score + 1
  END
  # NTHARG_N is the index (0) not bag count
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  NTHARG 2
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "a.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF NTHARG_N == 2 THEN
    LET score = score + 1
  END
  GETARG 1
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "--out=x"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # variable index works (unlike HASFLAG name vars)
  LET i = 2
  NTHARG i
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "a.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF NTHARG_HIT == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NTHARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "GETARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "naa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 11 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:2:pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# dual — ARGKV alias + hop inventory
SYS EQS op "dual"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--mode=seal"
  SYS ENV SET CUBALC_ARG1 "hopA"
  SYS ENV SET CUBALC_ARG2 "hopB"
  SYS ENV SET CUBALC_ARGC "3"
  ARGKV
  LET map_n = ARGMAP_N
  LET body = ARGMAP
  CLEAR_ERR
  IF map_n == 3 THEN
    LET score = score + 1
  END
  SYS HASLINE body "0=--mode=seal"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "1=hopA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "2=hopB"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS LOOKUP ARGMAP "1" "="
  SYS EQS LAST "hopA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHARG 1
  SYS EQS LAST "hopA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHARG 2
  SYS EQS LAST "hopB"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FLAGMAP
  SYS HASLINE FLAGMAP "mode=seal"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGKV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "peel"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "raw_argv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 11 THEN
    LET hit = 1
    LET note_msg = "dual ok"
    LET admit_n = 1
    LET find_n = map_n
  ELSE
    LET miss = 1
    LET note_msg = "dual score"
    FAIL "dual score"
    CLEAR_ERR
  END
  SYS CAT "dual:" map_n ":du"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "dual:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n map_n score note_msg
  CLEAR_ERR
END

# miss — soft OOR + OR fallback LAST_N quirk
SYS EQS op "miss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  NTHARG 0
  LET hit_n = NTHARG_HIT
  CLEAR_ERR
  IF hit_n == 0 THEN
    LET score = score + 1
  END
  SYS EMPTY LAST
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OR default: HIT=0, LAST=default; LAST_N is hit-shuttle 0 (capture before LET)
  NTHARG 0 OR "default.txt"
  LET sum_v = LAST_N
  LET hit_n = NTHARG_HIT
  LET peel_s = LAST
  CLEAR_ERR
  IF hit_n == 0 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "default.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # LAST_N after OR miss is 0 (not string length) — document
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  NTHARG 9 OR "none"
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "none"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF NTHARG_HIT == 0 THEN
    LET score = score + 1
  END
  GETARG 3 OR "fb"
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "fb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  LET stem_s = LAST
  CLEAR_ERR
  SYS HAS stem_s "OR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  LET stem_s = LAST
  CLEAR_ERR
  SYS HAS stem_s "NTHARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  LET stem_s = LAST
  CLEAR_ERR
  SYS EQS stem_s "naa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # accept 10+ (OR miss LAST_N/EMPTY edge may soft-drop one point)
  IF score >= 10 THEN
    LET hit = 1
    LET note_msg = "miss ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "miss score"
    FAIL "miss score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE miss denied"
    END
  END
  SYS CAT "miss:" score ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "miss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# cmp — NTHARG keeps flags; NTHPOS peels non-flag only
SYS EQS op "cmp"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "--out=x"
  SYS ENV SET CUBALC_ARG2 "a.txt"
  SYS ENV SET CUBALC_ARGC "3"
  NTHARG 0
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "--verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # NTHPOS 0 skips flags → a.txt
  NTHPOS 0
  LET stem_s = LAST
  CLEAR_ERR
  SYS EQS stem_s "a.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # false friend: same index different semantics
  SYS EQS peel_s stem_s
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHARG 2
  SYS EQS LAST "a.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # register-style: all positionals — both agree on 0
  SYS ENV SET CUBALC_ARG0 "register"
  SYS ENV SET CUBALC_ARG1 "--src=x"
  SYS ENV SET CUBALC_ARG2 "hopA"
  SYS ENV SET CUBALC_ARGC "3"
  NTHARG 0
  SYS EQS LAST "register"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHPOS 0
  SYS EQS LAST "register"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHARG 2
  SYS EQS LAST "hopA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # NTHPOS 1 is hopA (skips --src)
  NTHPOS 1
  SYS EQS LAST "hopA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ARGMAP
  SYS HASLINE ARGMAP "1=--src=x"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NTHPOS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FLAGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 11 THEN
    LET hit = 1
    LET note_msg = "cmp ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "cmp score"
    FAIL "cmp score"
    CLEAR_ERR
  END
  SYS CAT "cmp:1:cm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "cmp:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM / RELATED discovery
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORM "NTHARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "GETARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "ARGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "ARGKV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RELATED "NTHARG"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "ARGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RELATED "ARGMAP"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "FLAGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NTHARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "ntharg_argmap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "naa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live hop peel contract
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--job=ingest"
  SYS ENV SET CUBALC_ARG1 "shard0"
  SYS ENV SET CUBALC_ARG2 "shard1"
  SYS ENV SET CUBALC_ARGC "3"
  ARGMAP
  CLEAR_ERR
  IF ARGMAP_N == 3 THEN
    LET score = score + 1
  END
  NTHARG 1
  SYS EQS LAST "shard0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHARG 2 OR "none"
  SYS EQS LAST "shard1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF NTHARG_HIT == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "ARGMAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NTHARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "GETARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "raw_argv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "ntharg_argmap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 3
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · WRITE bag · capture before SAY
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "only.bin"
  SYS ENV SET CUBALC_ARGC "1"
  ARGMAP
  LET body = ARGMAP
  LET map_n = ARGMAP_N
  NTHARG 0
  LET peel_s = LAST
  CLEAR_ERR
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE LAST "0=only.bin"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "0=only.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS peel_s "only.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF map_n == 1 THEN
    LET score = score + 1
  END
  SYS WRITE argmap_path body
  CLEAR_ERR
  SYS READ argmap_path
  LET row = LAST
  CLEAR_ERR
  SYS HASLINE row "0=only.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "ntharg_argmap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LOOKUP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "i=value"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "raw_argv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "naa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = map_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:1:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# clear
SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

# ---- settle ----
IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " map_n=" map_n " peel=" peel_s
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "naa report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
