# peer_overlay_fillp_from_board.cubalc — FILLP FROM peer plate without PLATE clobber
#
# Real use: mesh/on-call agents keep a durable agent PLATE (identity) and a
# transient PEER overlay object. FILLP FROM peer renders status/log lines
# without LET PLATE = peer (which would clobber durable state). First realworld
# of proof 1127 fillp_from.
#
#   FILLP FROM peer "…"          · FILLP_FROM=1 · PLATE unchanged
#   FILLP "…" FROM peer          · trailing FROM
#   FILLP STRICT FROM peer "…"   · fail-fast miss list
#   FILLP FROM LAST / literal    · snapshot / one-shot
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_pof_$$
#   ./out/cubalc run programs/realworld/peer_overlay_fillp_from_board.cubalc boot
#   ./out/cubalc run ... peer -- --name=bob --role=worker --host=cube9
#   ./out/cubalc run ... render|strict|trail|snap|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt POF_REPORT.txt  (bag = STATUS)
# Env: NAME_S ROLE_S HOST_S CUBALC_POF_REQUIRE
#
# Edges:
#   PLATE identity preserved after FROM; soft miss keys; FILLP_FROM flag;
#   empty peer; TRIM/UPPER host-wide sanitize; WRITE omit NL; soft empty bag

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "peer_overlay_fillp_from_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "peer_overlay_fillp_from -- boot|peer|render|strict|trail|snap|gate|probe|soft|list -- [--name=N] [--role=R] [--host=H]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT NAME_S = "bob"
GETFLAG name|n OR ENV NAME_S OR NAME_S
LET name_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT HOST_S = "cube9"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_POF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "POF_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET from_n = 0
LET peer = "{}"

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "peer", "render", "strict", "trail", "snap", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "render" THEN
    LET op = "render"
  WHEN "strict" THEN
    LET op = "strict"
  WHEN "trail" THEN
    LET op = "trail"
  WHEN "snap" THEN
    LET op = "snap"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n name_s role_s host_s
  CLEAR_ERR
END

# boot — durable agent PLATE identity (alice@self) + empty peer file
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "name" "alice" "role" "agent" "schema" "cubalc.peer_overlay.v1"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_session
  CLEAR_ERR
  SETP "name" "alice"
  CLEAR_ERR
  SETP "role" "agent"
  CLEAR_ERR
  INCLUDE plate_save
  CLEAR_ERR
  SYS WRITE peer_path "{}"
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "name" FROM body
  SYS EQS LAST "alice"
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
    LET created = 1
    LET take_n = 1
    SYS CAT "boot:alice:agent:bt"
    LET row = LAST
    CLEAR_ERR
    SYS GREPV "boot:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot name"
    FAIL "boot name"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n take_n note_msg
  CLEAR_ERR
END

# peer — write PEER overlay object (disk + var)
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  # sanitize flags with host-wide TRIM/UPPER (multi-KB path sibling)
  SYS TRIM name_s
  LET name_s = LAST
  CLEAR_ERR
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  SYS LOWER host_s
  LET host_s = LAST
  CLEAR_ERR
  SYS JSONOBJ "name" name_s "role" role_s "host" host_s "tick" 7
  LET peer = LAST
  CLEAR_ERR
  SYS WRITE peer_path peer
  CLEAR_ERR
  SYS READ peer_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "name" FROM body
  SYS EQS LAST name_s
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = 1
    LET take_n = 1
    LET out = peer
    SYS CAT "peer:" name_s ":" role_s ":pr"
    LET row = LAST
    CLEAR_ERR
    SYS GREPV "peer:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
  ELSE
    LET miss = 1
    LET note_msg = "peer write"
    FAIL "peer write"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n name_s role_s host_s note_msg
  CLEAR_ERR
END

# render — FILLP FROM peer; prove PLATE still alice
SYS EQS op "render"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  # restore durable PLATE
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  FILLP FROM peer "peer={{name}} role={{role}} host={{host}} tick={{tick}} miss={{nope}}"
  LET body = LAST
  LET take_n = FILLP_N
  LET miss_n = FILLP_MISS
  LET from_n = FILLP_FROM
  CLEAR_ERR
  SYS CAT "peer=" name_s " role=" role_s " host=" host_s " tick=7 miss="
  LET row = LAST
  CLEAR_ERR
  # peer may have been sanitized on peer action; re-read actual from peer obj
  SYS JSON "name" FROM peer
  LET name_s = LAST
  CLEAR_ERR
  SYS JSON "role" FROM peer
  LET role_s = LAST
  CLEAR_ERR
  SYS JSON "host" FROM peer
  LET host_s = LAST
  CLEAR_ERR
  SYS CAT "peer=" name_s " role=" role_s " host=" host_s " tick=7 miss="
  LET row = LAST
  CLEAR_ERR
  SYS EQS body row
  LET peel_hit = LAST_N
  CLEAR_ERR
  # PLATE identity must still be alice
  GETP "name"
  SYS EQS LAST "alice"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF from_n == 1 THEN
        IF miss_n == 1 THEN
          LET hit = 1
          LET note_msg = "render ok"
          LET admit_n = 1
          LET out = body
          LET load_hit = 1
        ELSE
          LET miss = 1
          LET note_msg = "render miss_n"
          FAIL "render miss_n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "render from flag"
        FAIL "render from flag"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "render plate clobber"
      FAIL "render plate clobber"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "render body"
    FAIL "render body"
    CLEAR_ERR
  END
  SYS CAT "render:" from_n ":" miss_n ":rd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "render:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n miss_n peel_hit has_n note_msg
  CLEAR_ERR
END

# trail — trailing FROM form
SYS EQS op "trail"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  FILLP "role={{role}}" FROM peer
  LET body = LAST
  LET from_n = FILLP_FROM
  CLEAR_ERR
  SYS JSON "role" FROM peer
  LET row = LAST
  CLEAR_ERR
  SYS CAT "role=" row
  LET out = LAST
  CLEAR_ERR
  SYS EQS body out
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "name"
  SYS EQS LAST "alice"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF from_n == 1 THEN
        LET hit = 1
        LET note_msg = "trail ok"
        LET admit_n = 1
        LET take_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "trail from"
        FAIL "trail from"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "trail plate"
      FAIL "trail plate"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "trail body"
    FAIL "trail body"
    CLEAR_ERR
  END
  SYS CAT "trail:" from_n ":" peel_hit ":tr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "trail:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n peel_hit has_n note_msg
  CLEAR_ERR
END

# strict — FILLP STRICT FROM complete peer (no nope); soft miss path uses incomplete
SYS EQS op "strict"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  # complete template keys only from peer fields
  FILLP STRICT FROM peer "peer={{name}}/{{role}}@{{host}}"
  LET body = LAST
  LET from_n = FILLP_FROM
  LET miss_n = FILLP_MISS
  CLEAR_ERR
  SYS JSON "name" FROM peer
  LET name_s = LAST
  CLEAR_ERR
  SYS JSON "role" FROM peer
  LET role_s = LAST
  CLEAR_ERR
  SYS JSON "host" FROM peer
  LET host_s = LAST
  CLEAR_ERR
  SYS CAT "peer=" name_s "/" role_s "@" host_s
  LET row = LAST
  CLEAR_ERR
  SYS EQS body row
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "name"
  SYS EQS LAST "alice"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF miss_n == 0 THEN
        IF from_n == 1 THEN
          LET hit = 1
          LET note_msg = "strict ok"
          LET admit_n = 1
          LET take_n = 1
          LET out = body
        ELSE
          LET miss = 1
          LET note_msg = "strict from"
          FAIL "strict from"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "strict miss"
        FAIL "strict miss"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "strict plate"
      FAIL "strict plate"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "strict body"
    FAIL "strict body"
    CLEAR_ERR
  END
  SYS CAT "strict:" from_n ":" miss_n ":st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "strict:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n miss_n peel_hit has_n note_msg
  CLEAR_ERR
END

# snap — FILLP FROM LAST + FROM literal
SYS EQS op "snap"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  SYS JSONOBJ "host" "cubeZ" "n" 3
  LET body = LAST
  CLEAR_ERR
  SYS CAT "" body
  FILLP FROM LAST "host={{host}} n={{n}}"
  LET out = LAST
  LET from_n = FILLP_FROM
  CLEAR_ERR
  SYS EQS out "host=cubeZ n=3"
  LET peel_hit = LAST_N
  CLEAR_ERR
  FILLP FROM "{\"k\":\"v\"}" "got={{k}}"
  LET row = LAST
  CLEAR_ERR
  SYS EQS row "got=v"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "name"
  SYS EQS LAST "alice"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF load_hit == 1 THEN
        IF from_n == 1 THEN
          LET hit = 1
          LET note_msg = "snap ok"
          LET admit_n = 1
          LET take_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "snap from"
          FAIL "snap from"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "snap plate"
        FAIL "snap plate"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "snap literal"
      FAIL "snap literal"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "snap last"
    FAIL "snap last"
    CLEAR_ERR
  END
  SYS CAT "snap:" from_n ":" peel_hit ":sn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "snap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n peel_hit has_n load_hit note_msg
  CLEAR_ERR
END

# gate — peer file non-empty + FILLP FROM has name + PLATE alice
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR ""
  LET peer = LAST
  CLEAR_ERR
  SYS BLANK peer
  LET has_n = LAST_N
  CLEAR_ERR
  SYS EQS peer "{}"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  FILLP FROM peer "n={{name}}"
  LET body = LAST
  LET from_n = FILLP_FROM
  CLEAR_ERR
  SYS HAS body "n="
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "name"
  SYS EQS LAST "alice"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    IF peel_hit == 0 THEN
      IF take_n == 1 THEN
        IF load_hit == 1 THEN
          IF from_n == 1 THEN
            LET hit = 1
            LET note_msg = "gate ok"
            LET admit_n = 1
            LET out = body
          ELSE
            LET miss = 1
            LET note_msg = "gate from"
            FAIL "gate from"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate plate"
          FAIL "gate plate"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate body"
        FAIL "gate body"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate empty peer"
      FAIL "gate empty peer"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "gate empty peer"
      END
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate no peer"
    FAIL "gate no peer"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate no peer"
    END
  END
  SYS CAT "gate:" from_n ":" peel_hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# soft — empty bag soft miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — empty peer soft; bare FILLP_FROM=0; miss keys; PLATE preserved
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  LET peer = "{}"
  CLEAR_ERR
  FILLP FROM peer "x={{name}} y={{role}}"
  LET body = LAST
  LET miss_n = FILLP_MISS
  LET from_n = FILLP_FROM
  CLEAR_ERR
  SYS EQS body "x= y="
  LET peel_hit = LAST_N
  CLEAR_ERR
  # bare FILLP uses PLATE (alice) — FROM flag 0
  FILLP "me={{name}}"
  LET out = LAST
  LET take_n = FILLP_FROM
  CLEAR_ERR
  SYS EQS out "me=alice"
  LET has_n = LAST_N
  CLEAR_ERR
  # TRIM host-wide on multi-char
  SYS TRIM "  z  "
  SYS EQS LAST "z"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF miss_n == 2 THEN
      IF from_n == 1 THEN
        IF has_n == 1 THEN
          IF take_n == 0 THEN
            IF load_hit == 1 THEN
              LET hit = 1
              LET note_msg = "probe ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "probe trim"
              FAIL "probe trim"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe bare from"
            FAIL "probe bare from"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe bare body"
          FAIL "probe bare body"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe from empty"
        FAIL "probe from empty"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe miss_n"
      FAIL "probe miss_n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe empty body"
    FAIL "probe empty body"
    CLEAR_ERR
  END
  PRINT_JSON peel_hit miss_n from_n has_n take_n load_hit note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS CAT "schema=cubalc.peer_overlay_fillp_from.v1 op=" op " hit="
LET row = LAST
SYS STR hit
SYS CAT row LAST " miss="
LET row = LAST
SYS STR miss
SYS CAT row LAST " admit="
LET row = LAST
SYS STR admit_n
SYS CAT row LAST " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "pof op=" op " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n from_n miss_n peel_hit has_n load_hit created note_msg
