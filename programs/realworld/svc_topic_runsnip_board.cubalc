# svc_topic_runsnip_board.cubalc — LISTTOPICS + TOPIC triad + RUNSNIP execute
#
# Real use: fleet agents discover the usability topic catalog (LISTTOPICS),
# soft-gate presence (HASTOPIC/NEEDTOPIC), peel a one-plate triad
# (TOPIC = tips+forms+snip), then execute curated mini sources (RUNSNIP)
# without shelling cubalc snip | cubalc run. First realworld of proofs
# 1333 TOPIC + 1334 RUNSNIP + 1335 LISTTOPICS.
#
#   LISTTOPICS|TOPICS · HASTOPIC|NEEDTOPIC name
#   TOPIC|TOPICCARD [topic] → TOPIC_*_N · TOPIC_TIPS/FORMS/SNIP bags
#   RUNSNIP|SNIPRUN [topic] → RUNSNIP_OK · RUNSNIP_ASSERTS_OK · nested run
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_strun_$$
#   ./out/cubalc run programs/realworld/svc_topic_runsnip_board.cubalc boot
#   ./out/cubalc run ... catalog|topic|exec|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt STRUN_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_STRUN_REQUIRE TOPIC_S
#
# Edges: soft unknown topic; NEEDTOPIC hard; var topic; RUNSNIP nested
#   asserts pollute parent plate; PRINT clobber; WRITE NL; forms→cap

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_topic_runsnip_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_topic_runsnip -- boot|catalog|topic|exec|soft|gate|alias|probe|list -- [--host=H] [--role=R] [--topic=T]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT TOPIC_S = "plate"
GETFLAG topic|t OR ENV TOPIC_S OR TOPIC_S
LET topic_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_STRUN_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "STRUN_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET tips_n = 0
LET forms_n = 0
LET snip_n = 0
LET run_ok = 0
LET topic_got = ""

ONEOF ACTION "boot", "catalog", "topic", "exec", "runsnip", "go", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "catalog" THEN
    LET op = "catalog"
  WHEN "topic" THEN
    LET op = "topic"
  WHEN "exec", "runsnip", "go" THEN
    LET op = "exec"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s topic_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  SYS TRIM topic_s
  LET topic_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-topicrun\",\"schema\":\"cubalc.svc_topic_runsnip.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"topic\",\"label\":\"topicrun\",\"cfg\":{\"topic\":\"" topic_s "\",\"surface\":\"LISTTOPICS,TOPIC,RUNSNIP\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"runsnip\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-topicrun"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_topic_runsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "topicrun"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  SYS EQS LAST topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RUNSNIP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# catalog — LISTTOPICS + HASTOPIC duals
SYS EQS op "catalog"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LISTTOPICS
  LET body = LAST
  LET sum_n = LISTTOPICS_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 8 THEN
    LET score = score + 1
  END
  SYS HASLINE body "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  HASTOPIC topic_s
  LET sum_v = OK
  LET admit_n = HASTOPIC_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  # alias forms → cap
  HASTOPIC forms
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPICS
  LET find_n = TOPICS_N
  CLEAR_ERR
  IF find_n == 8 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "topicrun"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "catalog ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "catalog score"
    FAIL "catalog score"
    CLEAR_ERR
  END
  SYS CAT "catalog:" sum_n ":ct"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "catalog:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n find_n score note_msg
  CLEAR_ERR
END

# topic — TOPIC one-plate triad
SYS EQS op "topic"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  TOPIC topic_s
  LET body = LAST
  LET topic_got = TOPIC_NAME
  LET tips_n = TOPIC_TIPS_N
  LET forms_n = TOPIC_FORMS_N
  LET snip_n = TOPIC_SNIP_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.topic.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EMPTY TOPIC_SNIP
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # general bare
  TOPIC
  LET stem_s = TOPIC_NAME
  CLEAR_ERR
  SYS EQS stem_s "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "topic ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "topic score"
    FAIL "topic score"
    CLEAR_ERR
  END
  SYS CAT "topic:" forms_n ":tp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "topic:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n forms_n snip_n score note_msg
  CLEAR_ERR
END

# exec — RUNSNIP execute mini program (not named run: host strips ARG run)
SYS EQS op "exec"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  RUNSNIP topic_s
  LET sum_v = OK
  LET run_ok = RUNSNIP_OK
  LET topic_got = RUNSNIP_TOPIC
  LET find_n = RUNSNIP_ASSERTS_OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF find_n >= 0 THEN
    LET score = score + 1
  END
  # cap execute
  RUNSNIP cap
  LET run_ok = RUNSNIP_OK
  LET topic_got = RUNSNIP_TOPIC
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # forms → cap alias
  RUNSNIP forms
  LET topic_got = RUNSNIP_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-topicrun"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RUNSNIP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "exec ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "exec score"
    FAIL "exec score"
    CLEAR_ERR
  END
  SYS CAT "exec:" run_ok ":rn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "exec:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n run_ok find_n score note_msg
  CLEAR_ERR
END

# soft — unknown topic soft miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASTOPIC zzz_nope
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  TOPIC zzz_nope
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  RUNSNIP zzz_nope
  LET sum_v = OK
  LET run_ok = RUNSNIP_OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF run_ok == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "topicrun"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "topic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — NEEDTOPIC + plate contract
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  NEEDTOPIC topic_s
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  HASTOPIC topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPIC topic_s
  LET forms_n = TOPIC_FORMS_N
  LET tips_n = TOPIC_TIPS_N
  CLEAR_ERR
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  IF tips_n >= 2 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "LISTTOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "topic_runsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n forms_n score note_msg
  CLEAR_ERR
END

# alias — TOPICCARD / SNIPRUN / TOPICS duals
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  TOPICCARD plate
  LET topic_got = TOPIC_NAME
  LET forms_n = TOPIC_FORMS_N
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF forms_n >= 5 THEN
    LET score = score + 1
  END
  SNIPRUN fat
  LET run_ok = RUNSNIP_OK
  LET topic_got = RUNSNIP_TOPIC
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPICS
  LET sum_n = TOPICS_N
  CLEAR_ERR
  IF sum_n == 8 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "topicrun"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n run_ok score note_msg
  CLEAR_ERR
END

# probe — var topic + PRINT clobber + nested asserts note
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET t = "lib"
  HASTOPIC t
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  TOPIC t
  LET body = LAST
  LET forms_n = TOPIC_FORMS_N
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF forms_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASI body "LISTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # PRINT clobber
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASI stem_s "RECIPE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI LAST "RECIPE"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RUNSNIP lib
  LET run_ok = RUNSNIP_OK
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  # forms alias
  TOPIC forms
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "topic_runsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" forms_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n run_ok score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_topic_runsnip.v1 host=" host_s " role=" role_s " topic=" topic_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " tips_n=" tips_n " forms_n=" forms_n " snip_n=" snip_n " run_ok=" run_ok " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_topic_runsnip_board: done"
PASS
