# --- gate: ntok >= MINTOK (refresh words first) ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET o_ok = 0
    LET tnow = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        WORDSF a0 raw
        LET tnow = LAST_N
        SETF a0 ntok tnow
        LET o_ok = 1
        DUMPOBJ a0
        SYS WRITE d_a0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        WORDSF a1 raw
        LET tnow = LAST_N
        SETF a1 ntok tnow
        LET o_ok = 1
        DUMPOBJ a1
        SYS WRITE d_a1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        WORDSF a2 raw
        LET tnow = LAST_N
        SETF a2 ntok tnow
        LET o_ok = 1
        DUMPOBJ a2
        SYS WRITE d_a2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "gate miss"
      FAIL "gate miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "gate miss"
      END
    ELSE
      LET ret_n = tnow
      IF tnow < MINTOK THEN
        LET miss = 1
        LET note_msg = "gate deny"
        SYS STR tnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate deny"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR tnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINTOK
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "gate deny"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "gate deny"
        END
      ELSE
        LET hit = 1
        LET note_msg = "gate admit"
        SYS STR tnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate admit"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR tnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINTOK
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- probe ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET p_ok = 1
  TRYWORDSF nosuch raw
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYWORDSF should soft-fail"
  END
  CLEAR_ERR
  TRYCUTF nosuch raw "," 0
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYCUTF should soft-fail"
  END
  CLEAR_ERR
  HASOBJ a0
  IF LAST_N == 1 THEN
    WORDSF SOFT a0 nosuch
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe WORDSF missing field should soft"
    END
    CLEAR_ERR
    CUTF SOFT a0 nosuch "," 0
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe CUTF missing field should soft"
    END
    CLEAR_ERR
    # OOR cut HIT=0
    GETF a0 keep
    SYS BLANK LAST
    IF LAST_N == 0 THEN
      GETF a0 keep
      SETF a0 raw LAST
    END
    GETF a0 raw
    LET save_r = LAST
    CUTF a0 raw DELIM 99
    IF CUTF_HIT != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe OOR CUTF should HIT=0"
    END
    GETF a0 raw
    SYS EQS LAST save_r
    IF LAST_N == 0 THEN
      LET p_ok = 0
      LET note_msg = "probe OOR should leave field"
    END
    CLEAR_ERR
    # still works
    WORDSF a0 raw
    IF OK == 0 THEN
      LET p_ok = 0
      LET note_msg = "probe WORDSF after soft broken"
    END
    LET ret_n = LAST_N
    CLEAR_ERR
  END
  IF p_ok == 1 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET val = "probe"
    LET val_ch = 1
    LET meta = "probe soft"
    LET meta_ch = 1
  ELSE
    LET miss = 1
    FAIL note_msg
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

