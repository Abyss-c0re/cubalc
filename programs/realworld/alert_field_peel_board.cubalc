# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ a0
  IF LAST_N == 1 THEN
    DELETEOBJ a0
    CLEAR_ERR
  END
  HASOBJ a1
  IF LAST_N == 1 THEN
    DELETEOBJ a1
    CLEAR_ERR
  END
  HASOBJ a2
  IF LAST_N == 1 THEN
    DELETEOBJ a2
    CLEAR_ERR
  END
  SYS WRITE d_a0 ""
  SYS WRITE d_a1 ""
  SYS WRITE d_a2 ""
  SYS WRITE objs_path ""
  SYS WRITE words_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

