# svc_recipe_libcard_board.cubalc — RECIPE/LIBCARD/CARD lib recipe inventory
#
# Real use: ops agents audit INCLUDE stems before boot — deps, DEFAULT knobs,
# head comments — without shelling `cubalc recipe`. First realworld of proof
# 1300 RECIPE/LIBCARD/CARD (in-lang dual of cubalc recipe).
#
#   RECIPE|LIBCARD|CARD stem
#   LAST = recipe JSON · LAST_N often deps_n (not bytes!)
#   LIB_STEM · LIB_PATH · LIB_BYTES · LIB_LINES · LIB_DEPS_N
#   RECIPE_DEPS · RECIPE_DEFAULTS · RECIPE_HEAD · RECIPE_*_N
#   soft miss: OK=0 sticky err · CLEAR_ERR required
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_srl_$$
#   ./out/cubalc run programs/realworld/svc_recipe_libcard_board.cubalc boot
#   ./out/cubalc run ... fat|tick|agent|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SRL_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SRL_REQUIRE
#
# Edges: soft miss OK=0; LAST_N=deps_n dual; DEFAULTS brace truncate;
#   WRITE NL; REQUIRE softens; EXIT shell (W7); PRINT clobbers LAST

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_recipe_libcard_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_recipe_libcard -- boot|fat|tick|agent|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SRL_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SRL_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET deps_n = 0
LET def_n = 0
LET head_n = 0
LET bytes_n = 0

ONEOF ACTION "boot", "fat", "tick", "agent", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "fat" THEN
    LET op = "fat"
  WHEN "tick" THEN
    LET op = "tick"
  WHEN "agent" THEN
    LET op = "agent"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-recipe\",\"schema\":\"cubalc.svc_recipe_libcard.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"lib_audit\":1,\"label\":\"recipe\",\"cfg\":{\"stem\":\"fat_session\",\"want_deps\":2}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"audit\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_recipe_libcard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.stem"
  SYS EQS LAST "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# fat — RECIPE fat_session deps/defaults/head
SYS EQS op "fat"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RECIPE fat_session
  LET stem_s = LIB_STEM
  LET deps_n = LIB_DEPS_N
  LET def_n = RECIPE_DEFAULTS_N
  LET head_n = RECIPE_HEAD_N
  LET bytes_n = LIB_BYTES
  LET sum_v = LAST_N
  LET sum_n = deps_n
  CLEAR_ERR
  SYS EQS stem_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF deps_n == 2 THEN
    LET score = score + 1
  END
  IF def_n == 1 THEN
    LET score = score + 1
  END
  IF head_n >= 3 THEN
    LET score = score + 1
  END
  IF bytes_n > 50 THEN
    LET score = score + 1
  END
  SYS HASLINE RECIPE_DEPS "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE RECIPE_DEPS "plate_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS RECIPE_DEFAULTS "NEED_VARROOM=48"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS RECIPE_HEAD "INCLUDE fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # plate identity still intact (recipe does not mutate PLATE)
  GETP "agent"
  SYS EQS LAST "svc-recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "fat ok"
    LET admit_n = deps_n
    LET find_n = bytes_n
  ELSE
    LET miss = 1
    LET note_msg = "fat score"
    FAIL "fat score"
    CLEAR_ERR
  END
  SYS CAT "fat:" deps_n ":ft"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fat:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s deps_n def_n score note_msg
  CLEAR_ERR
END

# tick — LIBCARD plate_tick defaults inventory
SYS EQS op "tick"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LIBCARD plate_tick
  LET stem_s = LIB_STEM
  LET deps_n = LIB_DEPS_N
  LET def_n = RECIPE_DEFAULTS_N
  LET sum_v = LAST_N
  LET sum_n = def_n
  CLEAR_ERR
  SYS EQS stem_s "plate_tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF deps_n == 0 THEN
    LET score = score + 1
  END
  IF def_n == 4 THEN
    LET score = score + 1
  END
  SYS HAS RECIPE_DEFAULTS "PLATE_PATH="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS RECIPE_DEFAULTS "PLATE_TICK_KEY=n"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS RECIPE_DEFAULTS "PLATE_TS_KEY=ts"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # brace-containing DEFAULT truncates in bag (document weakness)
  SYS HAS RECIPE_DEFAULTS "PLATE_SEED="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.want_deps"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "tick ok"
    LET admit_n = def_n
    LET find_n = def_n
  ELSE
    LET miss = 1
    LET note_msg = "tick score"
    FAIL "tick score"
    CLEAR_ERR
  END
  SYS CAT "tick:" def_n ":tk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "tick:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s def_n score note_msg
  CLEAR_ERR
END

# agent — CARD agent_boot (zero deps/defaults)
SYS EQS op "agent"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  CARD agent_boot
  LET body = LAST
  LET stem_s = LIB_STEM
  LET deps_n = LIB_DEPS_N
  LET def_n = RECIPE_DEFAULTS_N
  LET sum_v = LAST_N
  LET sum_n = deps_n
  CLEAR_ERR
  SYS EQS stem_s "agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF deps_n == 0 THEN
    LET score = score + 1
  END
  IF def_n == 0 THEN
    LET score = score + 1
  END
  # capture LAST immediately — later EQS/PRINT clobber recipe JSON (W4)
  SYS HAS body "cubalc.recipe.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "agent ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "agent score"
    FAIL "agent score"
    CLEAR_ERR
  END
  SYS CAT "agent:0:ag"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "agent:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s deps_n score note_msg
  CLEAR_ERR
END

# soft — ghost lib miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RECIPE no_such_lib_xyz_zzz
  LET sum_v = OK
  LET sum_n = LAST_N
  LET stem_s = LIB_STEM
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  # second miss still soft
  RECIPE ghostpath_lib_999
  LET admit_n = OK
  LET find_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  IF find_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_v sum_n score note_msg
  CLEAR_ERR
END

# gate — fat deps floor
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RECIPE fat_session
  LET deps_n = LIB_DEPS_N
  LET sum_v = deps_n
  CLEAR_ERR
  IF deps_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE RECIPE_DEPS "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_recipe_libcard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.want_deps"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET find_n = deps_n
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n score note_msg
  CLEAR_ERR
END

# alias — LIBCARD + CARD same stem as RECIPE
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LIBCARD fat_session
  LET stem_s = LIB_STEM
  LET deps_n = LIB_DEPS_N
  LET sum_v = deps_n
  CLEAR_ERR
  SYS EQS stem_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF deps_n == 2 THEN
    LET score = score + 1
  END
  CARD fat_session
  LET def_n = RECIPE_DEFAULTS_N
  CLEAR_ERR
  IF def_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS LIB_STEM "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = deps_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" deps_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n def_n score note_msg
  CLEAR_ERR
END

# probe — LAST_N dual + DEFAULTS brace truncate + false friend
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RECIPE fat_session
  LET sum_v = LAST_N
  LET deps_n = LIB_DEPS_N
  LET bytes_n = LIB_BYTES
  CLEAR_ERR
  # LAST_N dual: often == deps_n (2), NOT bytes
  IF sum_v == deps_n THEN
    LET score = score + 1
  END
  IF sum_v != bytes_n THEN
    LET score = score + 1
  END
  IF bytes_n > 50 THEN
    LET score = score + 1
  END
  # plate_tick DEFAULTS: JSON seed value truncates at brace
  LIBCARD plate_tick
  LET def_n = RECIPE_DEFAULTS_N
  CLEAR_ERR
  IF def_n == 4 THEN
    LET score = score + 1
  END
  # truncated line is PLATE_SEED={\ not full JSON default
  SYS HAS RECIPE_DEFAULTS "PLATE_SEED={\\"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # false friend: substring fat_boot appears in deps but not as stem
  RECIPE fat_session
  SYS HASLINE RECIPE_DEPS "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS LIB_STEM "fat_boot"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "recipe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = sum_v
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" sum_v ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_v deps_n bytes_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_recipe_libcard.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " deps=" deps_n " def=" def_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n deps_n note_msg
NOTE "svc_recipe_libcard_board: end"
