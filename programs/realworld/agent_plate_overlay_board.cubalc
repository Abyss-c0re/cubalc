# agent_plate_overlay_board.cubalc — JSONFILEMERGE / OVERLAYPLATE multi-key apply
#
# Real use: agent STATUS overlay — apply partial plates (zone/status/phase) in
# one shot without EACH+UPDATEPLATE or LOAD+JSONMERGE+SAVE glue.
# First realworld of proof 1104 JSONFILEMERGE (MERGEPLATE stays in-memory).
#
#   SYS JSONFILEMERGE|OVERLAYPLATE|MERGEPLATEFILE|APPLYPLATE path overlay
#   LAST = merged plate · LAST_N = keys applied from overlay
#   FILE=1 prior object · CREATED=1 new file · overlay wins on collide
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_apol_$$
#   ./out/cubalc run programs/realworld/agent_plate_overlay_board.cubalc \
#     seed -- --plate=/tmp/apol/status.json
#   ./out/cubalc run ... apply -- --plate=... --zone=east --status=ready
#   ./out/cubalc run ... gate -- --plate=...
#
# Plate: STATUS.txt VAL.txt META.txt APOL_REPORT.txt
# Env: PLATE_PATH ZONE_S STATUS_S ROLE_S CUBALC_APOL_REQUIRE
#
# Edges:
#   create-on-miss; empty {} applies 0; keep base keys; LAST_N=overlay keys;
#   aliases APPLY/OVERLAY; 128-var lean; GETFLAG not GETFLAGOUT for field ids

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_plate_overlay_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "agent_plate_overlay -- seed|apply|ready|reload|gate|alias|probe|list -- [--plate=P] [--zone=Z] [--status=S] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/deep/status.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
CLEAR_ERR

DEFAULT ZONE_S = "east"
GETFLAG zone|z OR ENV ZONE_S OR ZONE_S
LET zone_s = LAST
CLEAR_ERR

DEFAULT STATUS_S = "ready"
GETFLAG status|s OR ENV STATUS_S OR STATUS_S
LET status_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_APOL_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "APOL_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

# lean LETs — 128-var hard cap (W174/W177)
LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET peel_s = ""
LET over = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "seed", "apply", "ready", "reload", "gate", "list", "ls", "soft", "clear", "probe", "alias"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "seed" THEN
    LET op = "seed"
  WHEN "apply" THEN
    LET op = "apply"
  WHEN "ready" THEN
    LET op = "ready"
  WHEN "reload" THEN
    LET op = "reload"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "alias" THEN
    LET op = "alias"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src zone_s status_s role_s
  CLEAR_ERR
END

# seed — base agent status plate (role/keep/n)
SYS EQS op "seed"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JSONOBJ "schema" "cubalc.agent_status.v1" "role" role_s "keep" "yes" "n" 1 "zone" "unset"
  LET body = LAST
  CLEAR_ERR
  SYS SAVEPLATE plate_file body
  LET take_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "seed soft fail"
    FAIL "seed soft fail"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "seed fail"
    END
  ELSE
    SYS LOADPLATE plate_file
    LET load_hit = LAST_N
    LET body = LAST
    CLEAR_ERR
    SYS JSON "role" FROM body
    SYS EQS LAST role_s
    LET has_n = LAST_N
    CLEAR_ERR
    LET out = body
    LET created = 1
    IF load_hit == 1 THEN
      IF has_n == 1 THEN
        LET hit = 1
        LET note_msg = "seed ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "seed peel"
        FAIL "seed peel"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "seed load"
      FAIL "seed load"
      CLEAR_ERR
    END
  END
  SYS CAT "seed:"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS CAT row role_s
  LET row = LAST
  SYS CAT row ":sd"
  LET row = LAST
  SYS GREPV "seed:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit has_n p_src note_msg
  CLEAR_ERR
END

# apply — multi-key overlay (zone + status; n bump via overlay)
SYS EQS op "apply"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JSONOBJ "zone" zone_s "status" status_s "n" 9
  LET over = LAST
  CLEAR_ERR
  SYS JSONFILEMERGE plate_file over
  LET take_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "apply soft fail"
    FAIL "apply soft fail"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "apply fail"
    END
  ELSE
    LET out = body
    # LAST_N = keys applied (expect 3)
    SYS JSON "zone" FROM body
    SYS EQS LAST zone_s
    LET has_n = LAST_N
    CLEAR_ERR
    SYS JSON "status" FROM body
    SYS EQS LAST status_s
    LET peel_hit = LAST_N
    CLEAR_ERR
    SYS JSONN "n" FROM body
    LET load_hit = LAST_N
    CLEAR_ERR
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 9 THEN
          LET hit = 1
          LET note_msg = "apply ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "apply n"
          FAIL "apply n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "apply status"
        FAIL "apply status"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "apply zone"
      FAIL "apply zone"
      CLEAR_ERR
    END
  END
  SYS CAT "apply:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS CAT row zone_s
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS CAT row status_s
  LET row = LAST
  SYS CAT row ":ap"
  LET row = LAST
  SYS GREPV "apply:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit p_src note_msg
  CLEAR_ERR
END

# ready — thin overlay status=ready + phase=run
SYS EQS op "ready"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JSONOBJ "status" "ready" "phase" "run"
  LET over = LAST
  CLEAR_ERR
  SYS OVERLAYPLATE plate_file over
  LET take_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "ready soft fail"
    FAIL "ready soft fail"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "ready fail"
    END
  ELSE
    SYS JSON "status" FROM body
    SYS EQS LAST "ready"
    LET has_n = LAST_N
    CLEAR_ERR
    SYS JSON "phase" FROM body
    SYS EQS LAST "run"
    LET peel_hit = LAST_N
    CLEAR_ERR
    LET out = body
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        LET hit = 1
        LET note_msg = "ready ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "ready phase"
        FAIL "ready phase"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "ready status"
      FAIL "ready status"
      CLEAR_ERR
    END
  END
  SYS CAT "ready:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":rd"
  LET row = LAST
  SYS GREPV "ready:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit p_src note_msg
  CLEAR_ERR
END

# reload — soft LOADPLATE
SYS EQS op "reload"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  LET take_n = load_hit
  LET out = body
  IF load_hit == 1 THEN
    SYS JSON "zone" FROM body
    LET peel_s = LAST
    CLEAR_ERR
    SYS JSON "status" FROM body
    LET row = LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "reload hit"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "reload miss"
    FAIL "reload miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "reload miss"
    END
  END
  SYS CAT "reload:"
  LET body = LAST
  SYS STR load_hit
  SYS CAT body LAST
  LET body = LAST
  SYS CAT body ":"
  LET body = LAST
  SYS CAT body peel_s
  LET body = LAST
  SYS CAT body ":rl"
  LET body = LAST
  SYS GREPV "reload:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag body
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit peel_s p_src note_msg
  CLEAR_ERR
END

# gate — required keys after overlay (schema/role/zone/status)
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  # ensure contract via successive overlay if missing
  SYS JSONOBJ "schema" "cubalc.agent_status.v1" "role" role_s "zone" zone_s "status" status_s "ok" true
  LET over = LAST
  CLEAR_ERR
  SYS JSONFILEMERGE plate_file over
  LET take_n = LAST_N
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF load_hit == 0 THEN
    LET miss = 1
    LET note_msg = "gate miss"
    FAIL "gate miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate miss"
    END
  ELSE
    SYS JSONHASALL body "schema" "role" "zone" "status" "ok"
    LET admit_n = LAST_N
    CLEAR_ERR
    SYS JSON "ok" FROM body
    LET peel_s = LAST
    CLEAR_ERR
    LET out = body
    IF admit_n == 1 THEN
      SYS EQS peel_s "1"
      LET has_n = LAST_N
      CLEAR_ERR
      IF has_n == 1 THEN
        LET hit = 1
        LET note_msg = "gate admit"
      ELSE
        LET miss = 1
        LET note_msg = "gate ok peel"
        FAIL "gate ok peel"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate need deny"
      FAIL "gate need deny"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "gate deny"
      END
    END
  END
  SYS CAT "gate:"
  LET row = LAST
  SYS STR admit_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":gt"
  LET row = LAST
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n admit_n has_n load_hit p_src note_msg
  CLEAR_ERR
END

# alias — OVERLAYPLATE / MERGEPLATEFILE / APPLYPLATE / PLATEOVERLAY
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/alias_over.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  SYS JSONOBJ "a" 1
  SYS JSONFILEMERGE row LAST
  LET created = LAST_N
  CLEAR_ERR
  SYS JSONOBJ "b" 2
  SYS OVERLAYPLATE row LAST
  CLEAR_ERR
  SYS JSONOBJ "c" 3
  SYS MERGEPLATEFILE row LAST
  CLEAR_ERR
  SYS JSONOBJ "d" 4
  SYS APPLYPLATE row LAST
  LET take_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONHASALL body "a" "b" "c" "d"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS LOADPLATE row
  LET load_hit = LAST_N
  CLEAR_ERR
  LET out = body
  IF has_n == 1 THEN
    IF load_hit == 1 THEN
      LET hit = 1
      LET note_msg = "alias ok"
      LET admit_n = 1
    ELSE
      LET miss = 1
      LET note_msg = "alias load"
      FAIL "alias load"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "alias keys"
    FAIL "alias keys"
    CLEAR_ERR
  END
  SYS CAT "alias:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":al"
  LET row = LAST
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n created load_hit p_src note_msg
  CLEAR_ERR
END

# soft — empty bag
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — create-on-miss, keep base, empty {}, non-object reseed?, LAST_N keys
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/probe_over.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  # seed base
  SYS JSONOBJ "role" "worker" "keep" "yes" "n" 1
  SYS SAVEPLATE row LAST
  CLEAR_ERR
  # merge overlay
  SYS JSONOBJ "n" 9 "status" "ready"
  LET over = LAST
  SYS JSONFILEMERGE row over
  LET take_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONN "n" FROM body
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "role" FROM body
  SYS EQS LAST "worker"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "keep" FROM body
  SYS EQS LAST "yes"
  LET load_hit = LAST_N
  CLEAR_ERR
  # empty overlay applies 0
  SYS JSONOBJ
  LET over = LAST
  SYS JSONFILEMERGE row over
  LET admit_n = LAST_N
  CLEAR_ERR
  # create-on-miss nested
  SYS JOIN state_dir "sample/nested/fresh_over.json"
  LET peel_s = LAST
  SYS RM peel_s
  CLEAR_ERR
  SYS JSONOBJ "boot" 1
  SYS JSONFILEMERGE peel_s LAST
  LET created = LAST_N
  CLEAR_ERR
  SYS LOADPLATE peel_s
  LET bag_n = LAST_N
  CLEAR_ERR
  # empty overlay on missing → create empty-ish with 0 keys applied
  IF take_n == 2 THEN
    IF peel_hit == 9 THEN
      IF has_n == 1 THEN
        IF load_hit == 1 THEN
          IF admit_n == 0 THEN
            IF created == 1 THEN
              IF bag_n == 1 THEN
                LET note_msg = "probe ok"
                LET hit = 1
                LET admit_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "probe fresh load"
                FAIL "probe fresh load"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe create n"
              FAIL "probe create n"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe empty n"
            FAIL "probe empty n"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe keep"
          FAIL "probe keep"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe role"
        FAIL "probe role"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe n"
      FAIL "probe n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe keys"
    FAIL "probe keys"
    CLEAR_ERR
  END
  PRINT_JSON take_n peel_hit has_n load_hit admit_n created bag_n p_src note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_plate_overlay_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "admit"
LET row = LAST
SYS STR admit_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "plate"
LET row = LAST
SYS PUSH row plate_file
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "apol op="
LET body = LAST
SYS CAT body op
LET body = LAST
SYS CAT body " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST
LET body = LAST
SYS CAT body " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST
LET body = LAST
SYS CAT body " note="
LET body = LAST
SYS CAT body note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n created load_hit peel_hit p_src note_msg
NOTE "agent_plate_overlay_board: done"
