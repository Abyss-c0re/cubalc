# svc_getpn_slo_board.cubalc — GETPN nest path SLO / burn gate plane
#
# Real use: ops agents peel nest numeric fields (lat.p99, freq.error, burn.rate)
# for SLO admit without GETP+NUM glue; soft OR defaults; multi-plate peer peels.
# First realworld of proof 1202 GETPN/NUMP path (+ zero valid, miss soft).
#
#   GETPN|NUMP path [OR n] · LAST_N = value · GETPN_N hit · FROM PEER
#   SYS JSONN path dual · slash path · bool → 1/0
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sgs_$$
#   ./out/cubalc run programs/realworld/svc_getpn_slo_board.cubalc boot
#   ./out/cubalc run ... peel|budget|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SGS_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SGS_REQUIRE MAX_P99 MAX_ERR
#
# Edges:
#   soft miss OR; zero valid; false-friend path; WRITE NL; NUM softens REQUIRE;
#   EXIT shell (W7); GETPN_N vs LAST_N after compare

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_getpn_slo_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_getpn_slo -- boot|peel|budget|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeX"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SGS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

DEFAULT MAX_P99 = "200"
SYS ENV "MAX_P99" OR MAX_P99
LET max_p99 = LAST
CLEAR_ERR
SYS NUM max_p99
IF OK == 1 THEN
  LET max_p99 = LAST_N
ELSE
  LET max_p99 = 200
END
CLEAR_ERR

DEFAULT MAX_ERR = "10"
SYS ENV "MAX_ERR" OR MAX_ERR
LET max_err = LAST
CLEAR_ERR
SYS NUM max_err
IF OK == 1 THEN
  LET max_err = LAST_N
ELSE
  LET max_err = 10
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SGS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET path_val = ""
LET p99_n = 0
LET err_n = 0
LET burn_n = 0

ONEOF ACTION "boot", "peel", "budget", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "budget" THEN
    LET op = "budget"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s max_p99 max_err
  CLEAR_ERR
END

# boot — seed nest SLO metrics
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-getpn\",\"schema\":\"cubalc.svc_getpn_slo.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"n\":1,\"lat\":{\"p50\":40,\"p99\":180,\"p999\":400},\"freq\":{\"error\":3,\"warn\":7,\"info\":12},\"burn\":{\"rate\":2,\"window\":60},\"flags\":{\"live\":1,\"canary\":0},\"meta\":{\"role\":\"" role_s "\",\"zone\":\"east\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"schema\":\"cubalc.svc_getpn_slo.v1\",\"lat\":{\"p99\":90},\"freq\":{\"error\":1},\"burn\":{\"rate\":1},\"meta\":{\"role\":\"edge\",\"n\":9},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETPN "lat.p99"
  LET p99_n = LAST_N
  CLEAR_ERR
  GETPN "freq.error"
  LET err_n = LAST_N
  CLEAR_ERR
  GETPN "burn.rate"
  LET burn_n = LAST_N
  CLEAR_ERR
  GETPN "n"
  LET has_n = LAST_N
  CLEAR_ERR
  IF p99_n == 180 THEN
    IF err_n == 3 THEN
      IF burn_n == 2 THEN
        IF has_n == 1 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET peel_hit = 1
          LET load_hit = 1
          LET take_n = 3
        ELSE
          LET miss = 1
          LET note_msg = "boot n"
          FAIL "boot n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot burn"
        FAIL "boot burn"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot error"
      FAIL "boot error"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot p99"
    FAIL "boot p99"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n p99_n err_n burn_n note_msg
  CLEAR_ERR
END

# peel — multi path GETPN + slash + zero + bool
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETPN "lat.p99"
  LET p99_n = LAST_N
  CLEAR_ERR
  GETPN "lat.p50"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPN "freq.error"
  LET err_n = LAST_N
  CLEAR_ERR
  # slash path
  GETPN "freq/warn"
  LET load_hit = LAST_N
  CLEAR_ERR
  # zero valid (canary flag as 0)
  GETPN "flags.canary"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # bool live → 1
  GETPN "flags.live"
  LET has_n = LAST_N
  CLEAR_ERR
  # NUMP alias
  NUMP "burn.rate"
  LET burn_n = LAST_N
  CLEAR_ERR
  # false friend path miss hard
  GETPN "lat.p9"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET gate_ok = 1
  ELSE
    LET gate_ok = 0
  END
  CLEAR_ERR
  IF p99_n == 180 THEN
    IF peel_hit == 40 THEN
      IF err_n == 3 THEN
        IF load_hit == 7 THEN
          IF soft_ok == 0 THEN
            IF has_n == 1 THEN
              IF burn_n == 2 THEN
                IF gate_ok == 1 THEN
                  LET hit = 1
                  LET note_msg = "peel ok"
                  LET admit_n = 1
                  LET take_n = 1
                ELSE
                  LET miss = 1
                  LET note_msg = "peel false p9"
                  FAIL "peel false p9"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "peel burn"
                FAIL "peel burn"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "peel live"
              FAIL "peel live"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peel canary zero"
            FAIL "peel canary zero"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peel slash warn"
          FAIL "peel slash warn"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peel error"
        FAIL "peel error"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peel p50"
      FAIL "peel p50"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peel p99"
    FAIL "peel p99"
    CLEAR_ERR
  END
  SYS CAT "peel:p99=" p99_n ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n p99_n err_n burn_n soft_ok note_msg
  CLEAR_ERR
END

# budget — compare peels vs MAX_* SLO budgets
SYS EQS op "budget"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETPN "lat.p99"
  LET p99_n = LAST_N
  CLEAR_ERR
  GETPN "freq.error"
  LET err_n = LAST_N
  CLEAR_ERR
  GETPN "burn.rate"
  LET burn_n = LAST_N
  CLEAR_ERR
  # admit if under budgets
  LET peel_hit = 0
  IF p99_n <= max_p99 THEN
    LET peel_hit = 1
  END
  CLEAR_ERR
  LET load_hit = 0
  IF err_n <= max_err THEN
    LET load_hit = 1
  END
  CLEAR_ERR
  # burn soft ceiling 5
  LET soft_ok = 0
  IF burn_n <= 5 THEN
    LET soft_ok = 1
  END
  CLEAR_ERR
  # p999 over budget expected for secondary check
  GETPN "lat.p999"
  LET has_n = LAST_N
  CLEAR_ERR
  LET gate_ok = 0
  IF has_n > max_p99 THEN
    LET gate_ok = 1
  END
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF gate_ok == 1 THEN
          LET hit = 1
          LET note_msg = "budget ok"
          LET admit_n = 1
          LET take_n = 1
          LET miss_n = 0
        ELSE
          LET miss = 1
          LET note_msg = "budget p999 not hot"
          FAIL "budget p999 not hot"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "budget burn"
        FAIL "budget burn"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "budget err over"
      FAIL "budget err over"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "budget p99 over"
    FAIL "budget p99 over"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE budget denied"
    END
  END
  SYS CAT "budget:p99=" p99_n ":err=" err_n ":bd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "budget:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n p99_n err_n max_p99 max_err note_msg
  CLEAR_ERR
END

# peer — GETPN FROM PEER path
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETPN FROM PEER "lat.p99"
  LET p99_n = LAST_N
  CLEAR_ERR
  GETPN FROM PEER "freq.error"
  LET err_n = LAST_N
  CLEAR_ERR
  GETPN FROM PEER "burn.rate"
  LET burn_n = LAST_N
  CLEAR_ERR
  GETPN FROM PEER "meta.n"
  LET has_n = LAST_N
  CLEAR_ERR
  # local plate still higher p99
  GETPN "lat.p99"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET load_hit = 0
  IF peel_hit > p99_n THEN
    LET load_hit = 1
  END
  CLEAR_ERR
  IF p99_n == 90 THEN
    IF err_n == 1 THEN
      IF burn_n == 1 THEN
        IF has_n == 9 THEN
          IF load_hit == 1 THEN
            LET hit = 1
            LET note_msg = "peer ok"
            LET admit_n = 1
            LET take_n = 1
            LET soft_ok = 1
          ELSE
            LET miss = 1
            LET note_msg = "peer local higher"
            FAIL "peer local higher"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer meta.n"
          FAIL "peer meta.n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer burn"
        FAIL "peer burn"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer err"
      FAIL "peer err"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer p99"
    FAIL "peer p99"
    CLEAR_ERR
  END
  SYS CAT "peer:p99=" p99_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n p99_n err_n has_n load_hit note_msg
  CLEAR_ERR
END

# soft — OR default + hard miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETPN "lat.crit" OR 99
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPN "ghost.x" OR 0
  LET load_hit = LAST_N
  CLEAR_ERR
  # hard miss without OR
  GETPN "nope.path"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET has_n = 1
  ELSE
    LET has_n = 0
  END
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET miss_n = LAST_N
  CLEAR_ERR
  # present path still works after soft
  GETPN "freq.error"
  LET gate_ok = LAST_N
  CLEAR_ERR
  # false friend
  HASP "lat.p9"
  LET path_val = LAST_N
  CLEAR_ERR
  IF peel_hit == 99 THEN
    IF load_hit == 0 THEN
      IF has_n == 1 THEN
        IF miss_n == 0 THEN
          IF gate_ok == 3 THEN
            IF path_val == 0 THEN
              LET hit = 1
              LET note_msg = "soft ok"
              LET admit_n = 1
              LET take_n = 0
            ELSE
              LET miss = 1
              LET note_msg = "soft false p9"
              FAIL "soft false p9"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft error after"
            FAIL "soft error after"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft empty bag"
          FAIL "soft empty bag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft hard miss ok"
        FAIL "soft hard miss ok"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft ghost or0"
      FAIL "soft ghost or0"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft or 99"
    FAIL "soft or 99"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:or99:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit gate_ok note_msg
  CLEAR_ERR
END

# gate — combined SLO admit using GETPN peels
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETPN "lat.p99"
  LET p99_n = LAST_N
  CLEAR_ERR
  GETPN "freq.error"
  LET err_n = LAST_N
  CLEAR_ERR
  GETPN "burn.rate"
  LET burn_n = LAST_N
  CLEAR_ERR
  GETPN "flags.live"
  LET has_n = LAST_N
  CLEAR_ERR
  NEEDP "host" "schema" "role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET admit_n = 0
  END
  CLEAR_ERR
  LET peel_hit = 0
  IF p99_n <= max_p99 THEN
    IF err_n <= max_err THEN
      IF burn_n <= 5 THEN
        IF has_n == 1 THEN
          LET peel_hit = 1
        END
      END
    END
  END
  CLEAR_ERR
  # false friend HASP
  HASP "freq.err"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF admit_n == 1 THEN
      IF miss_n == 0 THEN
        LET hit = 1
        LET note_msg = "gate ok"
        LET admit_n = 1
        LET gate_ok = 1
        LET take_n = 1
        LET load_hit = 1
        LET soft_ok = 1
      ELSE
        LET miss = 1
        LET note_msg = "gate false err"
        FAIL "gate false err"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate needp"
      FAIL "gate needp"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate slo fail"
    FAIL "gate slo fail"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:p99=" p99_n ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n p99_n err_n burn_n note_msg
  CLEAR_ERR
END

# probe — SYS JSONN dual + sticky after hard miss + empty bag
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS JSONN "lat.p99" FROM PLATE
  LET p99_n = LAST_N
  CLEAR_ERR
  SYS JSONN "freq.error" FROM PLATE
  LET err_n = LAST_N
  CLEAR_ERR
  SYS JSONN "ghost" FROM PLATE OR 7
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPN "burn.window"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS HAS LAST "svc-getpn"
  LET has_n = LAST_N
  CLEAR_ERR
  # hard miss then recover
  GETPN "nope"
  CLEAR_ERR
  GETPN "n"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF load_hit == 0 THEN
    IF p99_n == 180 THEN
      IF err_n == 3 THEN
        IF peel_hit == 7 THEN
          IF soft_ok == 60 THEN
            IF has_n == 1 THEN
              IF gate_ok == 1 THEN
                LET hit = 1
                LET note_msg = "probe ok"
                LET admit_n = 1
                LET take_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "probe recover n"
                FAIL "probe recover n"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe agent"
              FAIL "probe agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe window"
            FAIL "probe window"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe jsonn or"
          FAIL "probe jsonn or"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe jsonn err"
        FAIL "probe jsonn err"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe jsonn p99"
      FAIL "probe jsonn p99"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe empty bag"
    FAIL "probe empty bag"
    CLEAR_ERR
  END
  SYS CAT "probe:getpn:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n p99_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_getpn_slo.v1 host=" host_s " role=" role_s " req=" require_hit " max_p99=" max_p99 " max_err=" max_err " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " p99=" p99_n " err=" err_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n p99_n err_n note_msg
NOTE "svc_getpn_slo_board: end"
