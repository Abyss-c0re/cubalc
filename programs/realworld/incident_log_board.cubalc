# incident_log_board.cubalc — incident content search + stamp via GREPFILES/LOGALL
#
# Real use: on-call agent inventories log paths (PATHGLOB/WALK), filters those
# whose *file content* contains a needle (GREPFILES — not bag-field GREP),
# optionally inverts (GREPVFILES), and stamps a shared incident line across
# hit paths with LOGALL/APPENDFILES without EACH+READ/APPEND glue.
# Distinct from log_event_triage (in-memory bag GREP) and archive_walk_board
# (tree relocate): this board is content search over path bags + multi-log fanout.
#
# Plate under STATE:
#   PATHS.txt          — working path bag
#   HITS.txt           — last GREPFILES result
#   INCIDENT_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_IL_ACTION):
#   list      — depths (default)
#   scan      — PATHGLOB DIR PAT → PATHS
#   walk      — WALK ROOT PAT → PATHS
#   files     — KEEPFILES PATHS
#   grephit   — GREPFILES PATHS needle (ARG1) → HITS
#   grepi     — GREPFILESI case-insensitive
#   grepv     — GREPVFILES invert (paths without needle)
#   stamp     — LOGALL HITS (or PATHS) line (ARG1)
#   has       — HASLINE exact on PATHS
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_il_$$; mkdir -p "$CUBALC_STATE/logs"
#   # write log fixtures
#   CUBALC_IL_DIR=$CUBALC_STATE/logs CUBALC_ARG0=scan CUBALC_ARG1='*.log' \
#     ./out/cubalc run -q -s programs/realworld/incident_log_board.cubalc
#   CUBALC_ARG0=grephit CUBALC_ARG1=ERROR ./out/cubalc run -q -s ...
#   CUBALC_ARG0=stamp CUBALC_ARG1='incident=INC-42' ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_IL_DIR=…  CUBALC_IL_ROOT=…  CUBALC_IL_PAT=*
#   CUBALC_IL_REQUIRE=1
#
# Edges deliberately stressed:
#   GREPFILES vs SYS GREP (path content vs bag field text)
#   GREP case-sensitive ERROR misses Error; GREPFILESI hits
#   GREPVFILES invert; MISS paths excluded from invert keep
#   LOGALL creates missing paths; APPENDALL is string SUFFIXALL trap
#   WRITE NL; PRINT_JSON; soft READ; REQUIRE empty

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "incident_log_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT PFILE = "PATHS.txt"
DEFAULT HFILE = "HITS.txt"
DEFAULT REPORT = "INCIDENT_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT PAT = "*"
DEFAULT DIR = ""
DEFAULT ROOT = ""
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_IL_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_IL_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_IL_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_IL_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_IL_PAT" OR ""
IF LAST_N > 0 THEN
  LET PAT = LAST
END
SYS ENV "CUBALC_IL_DIR" OR ""
IF LAST_N > 0 THEN
  LET DIR = LAST
END
SYS ENV "CUBALC_IL_ROOT" OR ""
IF LAST_N > 0 THEN
  LET ROOT = LAST
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS BLANK DIR
IF LAST_N == 1 THEN
  LET DIR = state_dir
END
SYS BLANK ROOT
IF LAST_N == 1 THEN
  LET ROOT = DIR
END
SYS JOIN state_dir PFILE
LET paths_path = LAST
SYS JOIN state_dir HFILE
LET hits_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR paths_path OR ""
LET paths = LAST
CLEAR_ERR
SYS READ OR hits_path OR ""
LET hits = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET paths_ch = 0
LET hits_ch = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET pglob_n = 0
LET keep_n = 0
LET drop_n = 0
LET grep_n = 0
LET grep_scan = 0
LET grep_miss = 0
LET log_n = 0
LET log_fail = 0
LET log_bytes = 0

SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET PAT = NAME
  END
END
SYS EQS ACTION "walk"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET PAT = NAME
  END
END
SYS EQS ACTION "grephit"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "grephit needs needle"
  END
END
SYS EQS ACTION "grepi"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "grepi needs needle"
  END
END
SYS EQS ACTION "grepv"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "grepv needs needle"
  END
END
SYS EQS ACTION "stamp"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "stamp needs line"
  END
END
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs path"
  END
END

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS LINES paths
  LET np = LAST_N
  SYS LINES hits
  LET nh = LAST_N
  CLEAR_ERR
  STATUS
  PRINT "ilog" np nh ACTION
  PRINT_JSON np nh ACTION STATUS_OK
  PRINT_JSON paths
  PRINT_JSON hits
  LET note_msg = "list ok"
END

# --- scan ---
SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  NOTE "action scan"
  SYS PATHGLOB DIR PAT
  IF OK == 0 THEN
    LET miss = 1
    LET paths = ""
    LET paths_ch = 1
    LET note_msg = "scan miss"
    FAIL "scan miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "scan miss"
    END
  ELSE
    LET paths = LAST
    LET pglob_n = PATHGLOB_N
    LET paths_ch = 1
    LET hit = pglob_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "scan empty"
      FAIL "scan empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "scan empty"
      END
    ELSE
      LET note_msg = "scan ok"
    END
    PRINT_JSON PAT pglob_n
    PRINT_JSON paths
  END
END

# --- walk ---
SYS EQS ACTION "walk"
IF LAST_N == 1 THEN
  NOTE "action walk"
  SYS WALK ROOT PAT
  IF OK == 0 THEN
    LET miss = 1
    LET paths = ""
    LET paths_ch = 1
    LET note_msg = "walk miss"
    FAIL "walk miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "walk miss"
    END
  ELSE
    LET paths = LAST
    LET pglob_n = WALK_N
    LET paths_ch = 1
    LET hit = pglob_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "walk empty"
      FAIL "walk empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "walk empty"
      END
    ELSE
      LET note_msg = "walk ok"
    END
    PRINT_JSON PAT pglob_n WALK_FILES WALK_DIRS
    PRINT_JSON paths
  END
END

# --- files ---
SYS EQS ACTION "files"
IF LAST_N == 1 THEN
  NOTE "action files"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "files empty"
    FAIL "files empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "files empty"
    END
  ELSE
    SYS KEEPFILES paths
    LET paths = LAST
    LET keep_n = KEEPFILES_N
    LET drop_n = KEEPFILES_DROP
    LET paths_ch = 1
    LET hit = keep_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "files none"
      FAIL "files none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "files none"
      END
    ELSE
      LET note_msg = "files ok"
    END
    PRINT_JSON keep_n drop_n
    PRINT_JSON paths
  END
END

# --- grephit GREPFILES ---
SYS EQS ACTION "grephit"
IF LAST_N == 1 THEN
  NOTE "action grephit"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "grephit empty"
    FAIL "grephit empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "grephit empty"
    END
  ELSE
    SYS GREPFILES paths NAME
    LET hits = LAST
    LET grep_n = GREPFILES_N
    LET grep_scan = GREPFILES_SCAN
    LET grep_miss = GREPFILES_MISS
    LET hits_ch = 1
    LET hit = grep_n
    SYS BLANK hits
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "grephit none"
      FAIL "grephit none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "grephit none"
      END
    ELSE
      LET note_msg = "grephit ok"
    END
    PRINT_JSON NAME grep_n grep_scan grep_miss
    PRINT_JSON hits
  END
END

# --- grepi GREPFILESI ---
SYS EQS ACTION "grepi"
IF LAST_N == 1 THEN
  NOTE "action grepi"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "grepi empty"
    FAIL "grepi empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "grepi empty"
    END
  ELSE
    SYS GREPFILESI paths NAME
    LET hits = LAST
    LET grep_n = GREPFILES_N
    LET grep_scan = GREPFILES_SCAN
    LET grep_miss = GREPFILES_MISS
    LET hits_ch = 1
    LET hit = grep_n
    SYS BLANK hits
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "grepi none"
      FAIL "grepi none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "grepi none"
      END
    ELSE
      LET note_msg = "grepi ok"
    END
    PRINT_JSON NAME grep_n grep_scan grep_miss
    PRINT_JSON hits
  END
END

# --- grepv GREPVFILES ---
SYS EQS ACTION "grepv"
IF LAST_N == 1 THEN
  NOTE "action grepv"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "grepv empty"
    FAIL "grepv empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "grepv empty"
    END
  ELSE
    SYS GREPVFILES paths NAME
    LET hits = LAST
    LET grep_n = GREPFILES_N
    LET grep_scan = GREPFILES_SCAN
    LET grep_miss = GREPFILES_MISS
    LET hits_ch = 1
    LET hit = grep_n
    SYS BLANK hits
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "grepv none"
      FAIL "grepv none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "grepv none"
      END
    ELSE
      LET note_msg = "grepv ok"
    END
    PRINT_JSON NAME grep_n grep_scan grep_miss
    PRINT_JSON hits
  END
END

# --- stamp LOGALL ---
SYS EQS ACTION "stamp"
IF LAST_N == 1 THEN
  NOTE "action stamp"
  LET target = hits
  SYS BLANK target
  IF LAST_N == 1 THEN
    LET target = paths
  END
  SYS BLANK target
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "stamp empty"
    FAIL "stamp empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stamp empty"
    END
  ELSE
    SYS LOGALL target NAME
    LET stamped = LAST
    LET log_n = LOGALL_N
    LET log_fail = LOGALL_FAIL
    LET log_bytes = LOGALL_BYTES
    LET hit = log_n
    LET val_s = NAME
    IF log_n == 0 THEN
      LET miss = 1
      LET note_msg = "stamp none"
      FAIL "stamp none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "stamp none"
      END
    ELSE
      LET note_msg = "stamp ok"
    END
    PRINT_JSON log_n log_fail log_bytes NAME
    PRINT_JSON stamped
    CLEAR_ERR
  END
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS HASLINE paths NAME
  LET val_n = LAST_N
  LET hit = val_n
  IF val_n == 0 THEN
    LET miss = 1
    LET note_msg = "has miss"
    FAIL "has miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has miss"
    END
  ELSE
    LET note_msg = "has ok"
  END
  PRINT_JSON val_n NAME
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET paths = ""
  LET hits = ""
  LET paths_ch = 1
  LET hits_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "scan"
LET k = k + LAST_N
SYS EQS ACTION "walk"
LET k = k + LAST_N
SYS EQS ACTION "files"
LET k = k + LAST_N
SYS EQS ACTION "grephit"
LET k = k + LAST_N
SYS EQS ACTION "grepi"
LET k = k + LAST_N
SYS EQS ACTION "grepv"
LET k = k + LAST_N
SYS EQS ACTION "stamp"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF paths_ch > 0 THEN
  SYS WRITE paths_path paths
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "paths write failed"
  END
  CLEAR_ERR
END
IF hits_ch > 0 THEN
  SYS WRITE hits_path hits
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "hits write failed"
  END
  CLEAR_ERR
END

SYS LINES paths
LET depth_p = LAST_N
SYS LINES hits
LET depth_h = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.incident_log.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "grep_n"
LET report = LAST
SYS STR grep_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "grep_scan"
LET report = LAST
SYS STR grep_scan
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "grep_miss"
LET report = LAST
SYS STR grep_miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "log_n"
LET report = LAST
SYS STR log_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "log_fail"
LET report = LAST
SYS STR log_fail
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "log_bytes"
LET report = LAST
SYS STR log_bytes
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_p"
LET report = LAST
SYS STR depth_p
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_h"
LET report = LAST
SYS STR depth_h
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "dir"
LET report = LAST
SYS PUSH report DIR
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "incident_log_board" ACTION hit miss grep_n log_n note_msg elapsed
PRINT_JSON ACTION hit miss grep_n grep_scan grep_miss log_n log_fail log_bytes depth_p depth_h note_msg STATUS_OK
NOTE "incident_log_board: done"
