# svc_countmatchlibs_board.cubalc — COUNTMATCHLIBS fleet filter inventory size
#
# Real use: ops agents size lib families (plate*/fat*) for install gates and
# canary capacity without materializing MATCHLIBS bags. First realworld of
# proof 1313 COUNTMATCHLIBS/COUNTLIBS.
#
#   COUNTMATCHLIBS|COUNTLIBS needle
#   LAST = decimal count string · LAST_N = count · COUNTMATCHLIBS_N
#   soft miss OK=1 LAST_N=0 · empty needle hard OK=0 · case-insensitive
#   LAST is NOT a stem bag (HASLINE stem fails)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_scm_$$
#   ./out/cubalc run programs/realworld/svc_countmatchlibs_board.cubalc boot
#   ./out/cubalc run ... plate|fat|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SCM_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SCM_REQUIRE
#
# Edges: LAST_N is count not bag lines; soft miss OK=1 (unlike HASMATCH);
#   bare PLATE token vs quoted; empty needle; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_countmatchlibs_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_countmatchlibs -- boot|plate|fat|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SCM_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SCM_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET filt_s = ""
LET last_s = ""

ONEOF ACTION "boot", "plate", "fat", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "plate" THEN
    LET op = "plate"
  WHEN "fat" THEN
    LET op = "fat"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-countmatch\",\"schema\":\"cubalc.svc_countmatchlibs.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"plate\",\"min_count\":5,\"label\":\"countmatch\",\"cfg\":{\"fat_expect\":2}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"count\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_countmatchlibs"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# plate — COUNTMATCHLIBS plate family size
SYS EQS op "plate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTMATCHLIBS plate
  LET last_s = LAST
  LET sum_n = LAST_N
  LET find_n = COUNTMATCHLIBS_N
  LET filt_s = COUNTMATCHLIBS_FILTER
  CLEAR_ERR
  IF sum_n >= 10 THEN
    LET score = score + 1
  END
  IF find_n == sum_n THEN
    LET score = score + 1
  END
  SYS EQS filt_s "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # LAST is decimal count string not stem bag (not SYS EQS var,var — stringify)
  SYS STR sum_n
  SYS EQS last_s LAST
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE last_s "plate_boot"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "plate ok"
    LET admit_n = sum_n
    LET find_n = sum_n
  ELSE
    LET miss = 1
    LET note_msg = "plate score"
    FAIL "plate score"
    CLEAR_ERR
  END
  SYS CAT "plate:" sum_n ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "plate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n filt_s score note_msg
  CLEAR_ERR
END

# fat — COUNTLIBS fat == 2 + case-insensitive quoted PLATE
SYS EQS op "fat"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTLIBS fat
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 2 THEN
    LET score = score + 1
  END
  COUNTMATCHLIBS agent
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  # quoted case-insensitive — bare PLATE would bind plate JSON (W506 class)
  COUNTMATCHLIBS "PLATE"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n >= 10 THEN
    LET score = score + 1
  END
  GETP "cfg.fat_expect"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "min_count"
  SYS EQS LAST "5"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "fat ok"
    LET find_n = sum_n
  ELSE
    LET miss = 1
    LET note_msg = "fat score"
    FAIL "fat score"
    CLEAR_ERR
  END
  SYS CAT "fat:" sum_n ":ft"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fat:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

# soft — ghost miss soft OK=1 zero count
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTMATCHLIBS no_such_lib_xyz_zzz
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  COUNTMATCHLIBS ghostpath_lib_999
  LET admit_n = OK
  LET find_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  IF find_n == 0 THEN
    LET score = score + 1
  END
  # contrast HASMATCHLIBS hard miss
  HASMATCHLIBS no_such_lib_xyz_zzz
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

# gate — min_count floor
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTMATCHLIBS plate
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 5 THEN
    LET score = score + 1
  END
  GETP "min_count"
  SYS EQS LAST "5"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_countmatchlibs"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.fat_expect"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET admit_n = 1
    LET find_n = sum_n
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

# alias — COUNTLIBS == COUNTMATCHLIBS
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTLIBS fat
  LET sum_n = LAST_N
  CLEAR_ERR
  COUNTMATCHLIBS fat
  LET find_n = LAST_N
  CLEAR_ERR
  IF sum_n == 2 THEN
    LET score = score + 1
  END
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF sum_n == find_n THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.fat_expect"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" sum_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n find_n score note_msg
  CLEAR_ERR
END

# probe — empty needle + bag dual vs MATCHLIBS + soft polarity
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTMATCHLIBS ""
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  COUNTMATCHLIBS plate
  LET sum_n = LAST_N
  LET last_s = LAST
  CLEAR_ERR
  MATCHLIBS plate
  LET body = LAST
  LET find_n = LAST_N
  CLEAR_ERR
  IF sum_n == find_n THEN
    LET score = score + 1
  END
  # MATCHLIBS LAST is bag; COUNTMATCHLIBS LAST is count string
  SYS HASLINE body "plate_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE last_s "plate_boot"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss OK=1 for COUNT vs HASMATCH OK=0
  COUNTMATCHLIBS no_such_lib_xyz
  LET admit_n = OK
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASMATCHLIBS no_such_lib_xyz
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  # bare PLATE with loaded plate — false friend
  COUNTMATCHLIBS PLATE
  LET sum_v = OK
  LET find_n = LAST_N
  CLEAR_ERR
  # may miss when PLATE binds JSON; quoted form works
  COUNTMATCHLIBS "PLATE"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n >= 10 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-countmatch"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = sum_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" sum_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_countmatchlibs.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " sum_n=" sum_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n sum_n note_msg
NOTE "svc_countmatchlibs_board: end"
