# plate_share_board.cubalc — durable WRITE + HARDLINK share + DIRSYNC publish
#
# Real use: agents publish multi-agent plates with durable rename flush and
# hard-link aliases for zero-copy shared inodes (no shell ln/sync):
#   WRITEATOMIC + FSYNC + DIRSYNC  — classic durable plate publish
#   HARDLINK / HLINK               — same-inode alias path
#   NLINK / LINKS                  — link count probe
#   EQFILE                         — verify shared content
#   RM                             — drop alias only (content until last link)
# Distinct from release_pointer (SYMLINK) and plate_promote (COPY):
# this board is *hardlink share + durable dir fsync publish*.
#
# Plate under STATE:
#   ACTIVE.txt     — primary plate path
#   ALIAS.txt      — last hardlink path
#   VAL.txt        — last body / nlink / path
#   META.txt       — key:val bag
#   SHARE_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_PS_ACTION):
#   list      — plate (default)
#   pick      — ACTIVE = ARG1
#   put       — WRITEATOMIC ACTIVE ARG1 + FSYNC + DIRSYNC
#   link      — HARDLINK ACTIVE ARG1 → ALIAS
#   nlink     — NLINK ACTIVE → VAL
#   verify    — EQFILE ACTIVE ALIAS (or ARG1)
#   body      — READ ACTIVE
#   unlink    — RM ALIAS (or ARG1)
#   probe     — STAT ACTIVE
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ps_$$
#   CUBALC_ARG0=pick CUBALC_ARG1=$CUBALC_STATE/status.json ...
#   CUBALC_ARG0=put CUBALC_ARG1='{"ok":true}' ...
#   CUBALC_ARG0=link CUBALC_ARG1=$CUBALC_STATE/status.live ...
#   CUBALC_ARG0=nlink ...
#   CUBALC_ARG0=verify ...
#
# Env: CUBALC_PS_REQUIRE=1
#
# Edges:
#   HARDLINK dest exists soft; NLINK after RM; DIRSYNC parent of missing leaf
#   write via alias mutates primary; WRITE NL; REQUIRE; SYMLINK vs HARDLINK

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "plate_share_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT AFILE = "ACTIVE.txt"
DEFAULT LFILE = "ALIAS.txt"
DEFAULT VFILE = "VAL.txt"
DEFAULT MFILE = "META.txt"
DEFAULT REPORT = "SHARE_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_PS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_PS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_PS_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_PS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir AFILE
LET active_meta = LAST
SYS JOIN state_dir LFILE
LET alias_meta = LAST
SYS JOIN state_dir VFILE
LET val_path = LAST
SYS JOIN state_dir MFILE
LET meta_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR active_meta OR ""
LET active = LAST
CLEAR_ERR
SYS READ OR alias_meta OR ""
LET alias = LAST
CLEAR_ERR
SYS READ OR val_path OR ""
LET val = LAST
CLEAR_ERR
SYS READ OR meta_path OR ""
LET meta = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET active_ch = 0
LET alias_ch = 0
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET nlink_n = 0
LET same_n = 0
LET link_n = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "pshare" ACTION
  PRINT_JSON ACTION STATUS_OK
  PRINT_JSON active
  PRINT_JSON alias
  PRINT_JSON val
  PRINT_JSON meta
  LET note_msg = "list ok"
END

# --- pick ---
SYS EQS ACTION "pick"
IF LAST_N == 1 THEN
  NOTE "action pick"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "pick needs path"
  END
  LET active = NAME
  LET active_ch = 1
  LET hit = 1
  LET note_msg = "pick ok"
  PRINT_JSON active
END

# --- put WRITEATOMIC + FSYNC + DIRSYNC ---
SYS EQS ACTION "put"
IF LAST_N == 1 THEN
  NOTE "action put"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "put no active"
    FAIL "put no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "put no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      EXIT 2 "put needs body"
    END
    SYS WRITEATOMIC active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "put write fail"
      FAIL "put write fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "put write fail"
      END
    ELSE
      SYS FSYNC active
      IF OK == 0 THEN
        LET miss = 1
        LET note_msg = "put fsync fail"
        FAIL "put fsync fail"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "put fsync fail"
        END
      ELSE
        SYS DIRSYNC active
        IF OK == 0 THEN
          LET miss = 1
          LET note_msg = "put dirsync fail"
          FAIL "put dirsync fail"
          CLEAR_ERR
          IF REQUIRE_HIT > 0 THEN
            EXIT 2 "put dirsync fail"
          END
        ELSE
          LET val = NAME
          LET val_ch = 1
          LET hit = 1
          SYS CAT "path:" active
          LET meta = LAST
          SYS CAT "dirsync:" DIRSYNC_SRC
          SYS PUSH meta LAST
          LET meta = LAST
          LET meta_ch = 1
          LET note_msg = "put ok"
        END
      END
    END
  END
  PRINT_JSON active
  CLEAR_ERR
END

# --- link HARDLINK ---
SYS EQS ACTION "link"
IF LAST_N == 1 THEN
  NOTE "action link"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "link no active"
    FAIL "link no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "link no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      EXIT 2 "link needs dest path"
    END
    SYS HARDLINK active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET link_n = 0
      LET note_msg = "link fail"
      FAIL "link fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "link fail"
      END
    ELSE
      LET alias = NAME
      LET alias_ch = 1
      LET link_n = HARDLINK_N
      LET hit = 1
      LET note_msg = "link ok"
      SYS NLINK active
      LET nlink_n = LAST_N
      SYS STR nlink_n
      SYS CAT "nlink:" LAST
      LET meta = LAST
      SYS CAT "alias:" alias
      SYS PUSH meta LAST
      LET meta = LAST
      SYS CAT "src:" active
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
      SYS STR nlink_n
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON link_n nlink_n
  PRINT_JSON alias
  CLEAR_ERR
END

# --- nlink ---
SYS EQS ACTION "nlink"
IF LAST_N == 1 THEN
  NOTE "action nlink"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "nlink no active"
    FAIL "nlink no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "nlink no active"
    END
  ELSE
    SYS NLINK active
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "nlink miss"
      FAIL "nlink miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "nlink miss"
      END
    ELSE
      LET nlink_n = LAST_N
      LET hit = 1
      LET note_msg = "nlink ok"
      SYS STR nlink_n
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON nlink_n
  CLEAR_ERR
END

# --- verify EQFILE ---
SYS EQS ACTION "verify"
IF LAST_N == 1 THEN
  NOTE "action verify"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "verify no active"
    FAIL "verify no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "verify no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 0 THEN
      LET other = NAME
    ELSE
      SYS BLANK alias
      IF LAST_N == 1 THEN
        LET miss = 1
        LET note_msg = "verify no other"
        FAIL "verify no other"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "verify no other"
        END
        LET other = ""
      ELSE
        LET other = alias
      END
    END
    SYS BLANK other
    IF LAST_N == 0 THEN
      SYS EQFILE active other
      IF OK == 0 THEN
        LET miss = 1
        LET same_n = 0
        LET note_msg = "verify fail"
        FAIL "verify fail"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "verify fail"
        END
      ELSE
        LET same_n = LAST_N
        IF same_n == 0 THEN
          LET miss = 1
          LET note_msg = "verify differ"
          FAIL "verify differ"
          CLEAR_ERR
          IF REQUIRE_HIT > 0 THEN
            EXIT 2 "verify differ"
          END
        ELSE
          LET hit = 1
          LET note_msg = "verify ok"
        END
        SYS STR same_n
        LET val = LAST
        LET val_ch = 1
      END
    END
  END
  PRINT_JSON same_n
  CLEAR_ERR
END

# --- body READ ---
SYS EQS ACTION "body"
IF LAST_N == 1 THEN
  NOTE "action body"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "body no active"
    FAIL "body no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "body no active"
    END
  ELSE
    SYS READ OR active OR ""
    IF OK == 0 THEN
      LET miss = 1
      LET val = ""
      LET val_ch = 1
      LET note_msg = "body miss"
      FAIL "body miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "body miss"
      END
    ELSE
      LET val = LAST
      LET val_ch = 1
      LET hit = 1
      LET note_msg = "body ok"
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- unlink RM alias ---
SYS EQS ACTION "unlink"
IF LAST_N == 1 THEN
  NOTE "action unlink"
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET target = NAME
  ELSE
    SYS BLANK alias
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "unlink no path"
      FAIL "unlink no path"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "unlink no path"
      END
      LET target = ""
    ELSE
      LET target = alias
    END
  END
  SYS BLANK target
  IF LAST_N == 0 THEN
    SYS EXIST target
    LET exist_n = LAST_N
    SYS RM target
    CLEAR_ERR
    IF exist_n == 0 THEN
      LET miss = 1
      LET note_msg = "unlink free"
      FAIL "unlink free"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "unlink free"
      END
    ELSE
      LET hit = 1
      LET note_msg = "unlink ok"
      SYS EQS target alias
      IF LAST_N == 1 THEN
        LET alias = ""
        LET alias_ch = 1
      END
      SYS BLANK active
      IF LAST_N == 0 THEN
        SYS NLINK active
        IF OK == 1 THEN
          LET nlink_n = LAST_N
          SYS STR nlink_n
          LET val = LAST
          LET val_ch = 1
        END
      END
    END
  END
  PRINT_JSON nlink_n
  CLEAR_ERR
END

# --- probe STAT ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "probe no active"
    FAIL "probe no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "probe no active"
    END
  ELSE
    SYS STAT active
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "probe fail"
      FAIL "probe fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "probe fail"
      END
    ELSE
      IF STAT_EXIST == 0 THEN
        LET miss = 1
        LET note_msg = "probe missing"
        FAIL "probe missing"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "probe missing"
        END
      ELSE
        LET hit = 1
        LET note_msg = "probe ok"
      END
      SYS STR STAT_SIZE
      SYS CAT "size:" LAST
      LET meta = LAST
      SYS STR STAT_EXIST
      SYS CAT "exist:" LAST
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
      SYS STR STAT_SIZE
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET active = ""
  LET alias = ""
  LET val = ""
  LET meta = ""
  LET active_ch = 1
  LET alias_ch = 1
  LET val_ch = 1
  LET meta_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "pick"
LET k = k + LAST_N
SYS EQS ACTION "put"
LET k = k + LAST_N
SYS EQS ACTION "link"
LET k = k + LAST_N
SYS EQS ACTION "nlink"
LET k = k + LAST_N
SYS EQS ACTION "verify"
LET k = k + LAST_N
SYS EQS ACTION "body"
LET k = k + LAST_N
SYS EQS ACTION "unlink"
LET k = k + LAST_N
SYS EQS ACTION "probe"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF active_ch > 0 THEN
  SYS WRITE active_meta active
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "active write failed"
  END
  CLEAR_ERR
END
IF alias_ch > 0 THEN
  SYS WRITE alias_meta alias
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "alias write failed"
  END
  CLEAR_ERR
END
IF val_ch > 0 THEN
  SYS WRITE val_path val
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "val write failed"
  END
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "meta write failed"
  END
  CLEAR_ERR
END

SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.plate_share_board.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "nlink"
LET report = LAST
SYS STR nlink_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "same"
LET report = LAST
SYS STR same_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "active"
LET report = LAST
SYS PUSH report active
LET report = LAST
SYS PUSH report "alias"
LET report = LAST
SYS PUSH report alias
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "plate_share_board" ACTION hit miss nlink_n note_msg elapsed
