# svc_ifenv_feature_gate_board.cubalc — IFENV/IFHASENV feature + config gates
#
# Real use: agents branch on host env presence (feature flags, mode,
# credentials present) without SYS ENV + IF glue. First realworld of
# 1480 IFENV/IFHASENV (1.15.936 · MI ~937; was flaky at W863). Distinct
# from env_snapshot_board and dotenv_sync — this board is *content-
# branch env presence for feature admit / soft defaults*.
#
#   IFENV · IFHASENV · sticky IFENV_N · quoted names · var key
#   nest IFENV+IFEMPTY · SYS ENV SET/UNSET · FN-wrap (W853)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ife_$$
#   ./out/cubalc run programs/realworld/svc_ifenv_feature_gate_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IFE_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_IFE_REQUIRE CUBALC_IFE_MODE CUBALC_IFE_FLAG
#
# Edges: miss ELSE default; var key PATH; UNSET then soft default;
#   empty msg nest; FN-wrap; WRITE NL; REQUIRE soft

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# IFENV steals outer IF END — FN helpers (W853 class)
FN env_path
  IFENV PATH
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN env_miss
  IFENV CUBALC_IFE_NO_SUCH_ZZ
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN env_quoted_path
  IFENV "PATH"
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN env_has_path
  IFHASENV PATH
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN env_var_key
  IFENV key
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN mode_from_ife
  IFENV CUBALC_IFE_MODE
    LET state = "mode-on"
  ELSE
    LET state = "mode-default"
  END
END

FN flag_from_ife
  IFENV CUBALC_IFE_FLAG
    LET state = "flag-on"
  ELSE
    LET state = "flag-off"
  END
END

FN nest_cfg
  IFENV CUBALC_IFE_MODE
    IFEMPTY msg
      LET state = "cfg"
    ELSE
      LET state = "msg"
    END
  ELSE
    LET state = "no-env"
  END
END

FN admit_features
  IFENV CUBALC_IFE_FLAG
    IFENV CUBALC_IFE_MODE
      LET state = "admit-full"
    ELSE
      LET state = "admit-flag-only"
    END
  ELSE
    LET state = "deny-no-flag"
  END
END

NOTE "svc_ifenv_feature_gate_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ifenv_feature_gate -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IFE_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IFE_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET path = ""
LET msg = ""
LET peeld = ""
LET key = ""
LET state = ""
LET depth = 0
LET weight = 0
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ife\",\"schema\":\"cubalc.svc_ifenv_feature_gate.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ife\",\"want_filter\":\"ifenv_feature_gate\",\"cfg\":{\"surface\":\"IFENV,IFHASENV,IFENV_N\",\"contract\":\"host env presence branches for feature flags + soft defaults\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  CALL env_path
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ife"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFENV_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot path"
      FAIL "boot path"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFENV core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL env_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFENV_N == 1 THEN
    LET score = score + 1
  END
  CALL env_miss
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF IFENV_N == 0 THEN
    LET score = score + 1
  END
  CALL env_quoted_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL env_has_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET key = "PATH"
  CALL env_var_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET key = "CUBALC_IFE_NO_SUCH_ZZ"
  CALL env_var_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS ENV SET CUBALC_IFE_MODE "canary"
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-on"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — defaults · nest · empty msg
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # ensure unset
  SYS ENV UNSET CUBALC_IFE_MODE
  SYS ENV UNSET CUBALC_IFE_FLAG
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL flag_from_ife
  SYS EQS state "flag-off"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "deny-no-flag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET msg = ""
  SYS ENV SET CUBALC_IFE_MODE "yes"
  CLEAR_ERR
  CALL nest_cfg
  SYS EQS state "cfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET msg = "note"
  CALL nest_cfg
  SYS EQS state "msg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  CALL nest_cfg
  SYS EQS state "no-env"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL env_miss
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # HOME usually set on unix
  LET key = "HOME"
  CALL env_var_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL env_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# peel — feature ladder: flag then mode
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS ENV UNSET CUBALC_IFE_FLAG
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "deny-no-flag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV SET CUBALC_IFE_FLAG "1"
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "admit-flag-only"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV SET CUBALC_IFE_MODE "prod"
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "admit-full"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL flag_from_ife
  SYS EQS state "flag-on"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-on"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # read value after presence
  SYS ENV "CUBALC_IFE_MODE" OR ""
  LET peeld = LAST
  CLEAR_ERR
  SYS EQS peeld "prod"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_IFE_FLAG
  CLEAR_ERR
  CALL flag_from_ife
  SYS EQS state "flag-off"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifenv_feature_gate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score peeld note_msg
  CLEAR_ERR
END

# scale — multi flag inventory
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS ENV SET CUBALC_IFE_FLAG "a"
  SYS ENV SET CUBALC_IFE_MODE "b"
  CLEAR_ERR
  LET depth = 0
  CALL flag_from_ife
  SYS EQS state "flag-on"
  IF LAST_N == 1 THEN
    LET depth = depth + 1
    LET score = score + 1
  END
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-on"
  IF LAST_N == 1 THEN
    LET depth = depth + 1
    LET score = score + 1
  END
  CLEAR_ERR
  CALL env_path
  IF ok_v == 1 THEN
    LET depth = depth + 1
    LET score = score + 1
  END
  CALL env_has_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF depth == 3 THEN
    LET score = score + 1
  END
  SYS ENV UNSET CUBALC_IFE_FLAG
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "deny-no-flag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # mode still set
  CALL mode_from_ife
  SYS EQS state "mode-on"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  CALL mode_from_ife
  SYS EQS state "mode-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFENV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = depth
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score depth note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFENV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFHASENV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFENV_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFEMPTY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifenv_feature_gate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFENV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFHASENV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL env_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL env_miss
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — require flag for admit
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS ENV UNSET CUBALC_IFE_FLAG
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "deny-no-flag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV SET CUBALC_IFE_FLAG "release"
  SYS ENV SET CUBALC_IFE_MODE "prod"
  CLEAR_ERR
  CALL admit_features
  SYS EQS state "admit-full"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL env_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS ENV "CUBALC_IFE_FLAG" OR ""
  LET peeld = LAST
  CLEAR_ERR
  SYS EQS peeld "release"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit > 0 THEN
    IF score < 3 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ife"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF IFENV_N >= 0 THEN
    LET score = score + 1
  END
  CALL env_has_path
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  # cleanup flags
  SYS ENV UNSET CUBALC_IFE_FLAG
  SYS ENV UNSET CUBALC_IFE_MODE
  CLEAR_ERR
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score peeld note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CALL env_path
  LET saved = IFENV_N
  PRINT "probe-ifenv" saved
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "ife host=" host_s " role=" role_s " pathenv=" saved
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "pathenv=1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFHASENV"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL env_miss
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ife\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
