# svc_live_boot_fleet_board.cubalc — live_boot/live_session fleet live OOP contract
#
# Real use: fleet agents gate OOP catalogs (class+method+field) AND live NEW
# instances via INCLUDE live_boot before SEND/GETF, instead of multi-guard glue.
# First realworld of 1406 live_session + live_boot (1.15.860+ · MI 867 · init --live).
# Distinct from svc_oop_boot_catalog (catalog only) and obj-path boards.
#
#   NEED_CLASSES/METHODS/FIELDS + NEED_OBJS · *_GUARD_SOFT
#   INCLUDE live_boot|live_session → LIVE_SESSION_OK · OOP_SESSION_OK · OBJ_GUARD_OK
#   OBJHAVE/OBJMISS · class/method/field miss bags
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_slv_$$
#   ./out/cubalc run programs/realworld/svc_live_boot_fleet_board.cubalc boot
#   ./out/cubalc run ... pass|soft_obj|soft_cls|hard|spawn|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SLV_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SLV_REQUIRE
#
# Edges: NEW before obj gate; LET knobs each re-INCLUDE; hard FAIL no exit_code;
#   HASOBJ exact; LIVE zeros if OOP or OBJ miss; stack pressure vars_n;
#   WRITE NL; auto-seed plate; empty NEED_* skips

INCLUDE agent_boot
REQUIRE LIB hold_seed

# fleet OOP types + live instances
CLASS FleetWorker
  FIELD id ""
  FIELD load 0
  METHOD ping
    LET LAST = "pong"
  END
  METHOD bump
    LET load = load + 1
  END
END

CLASS FleetQueue
  FIELD depth 0
  METHOD drain
    LET depth = 0
  END
END

NEW FleetWorker w0
NEW FleetWorker w1
NEW FleetQueue q0

NOTE "svc_live_boot_fleet_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_live_boot_fleet -- boot|pass|soft_obj|soft_cls|hard|spawn|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeL"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SLV_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SLV_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_n = 0
LET live = 0
LET oop = 0
LET obg = 0
LET cgo = 0
LET have_n = 0
LET miss_n = 0

ONEOF ACTION "boot", "pass", "soft_obj", "soft_cls", "hard", "spawn", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_obj" THEN
    LET op = "soft_obj"
  WHEN "soft_cls" THEN
    LET op = "soft_cls"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "spawn" THEN
    LET op = "spawn"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

# auto-seed agent plate
SYS EQS op "list"
IF LAST_N == 0 THEN
  SYS EQS op "clear"
  IF LAST_N == 0 THEN
    LET need_seed = 1
    SYS EXIST agent_path
    IF LAST_N == 1 THEN
      SYS READ OR agent_path OR ""
      SYS HAS LAST "svc-slv"
      IF LAST_N == 1 THEN
        LET need_seed = 0
      END
      CLEAR_ERR
    END
    CLEAR_ERR
    IF need_seed == 1 THEN
      SYS TRIM host_s
      LET host_s = LAST
      SYS TRIM role_s
      LET role_s = LAST
      CLEAR_ERR
      LET PLATE_PATH = agent_path
      LET PEER_PATH = peer_path
      SYS CAT "{\"agent\":\"svc-slv\",\"schema\":\"cubalc.svc_live_boot_fleet.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"live_fleet\",\"label\":\"slv\",\"cfg\":{\"surface\":\"live_boot,live_session,oop_session,obj_guard,LIVE_SESSION_OK,NEED_OBJS,NEED_CLASSES,NEED_METHODS,NEED_FIELDS\",\"contract\":\"OOP catalog + live NEW · init --live\"}}"
      LET PLATE_SEED = LAST
      CLEAR_ERR
      SYS CAT "{\"peer\":\"live_fleet\",\"n\":1}"
      LET PEER_SEED = LAST
      CLEAR_ERR
      SYS RM agent_path
      CLEAR_ERR
      SYS RM peer_path
      CLEAR_ERR
      INCLUDE plate_peer_session
      CLEAR_ERR
      SYS SAVEPLATE agent_path PLATE
      CLEAR_ERR
    END
  END
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-slv\",\"schema\":\"cubalc.svc_live_boot_fleet.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"live_fleet\",\"label\":\"slv\",\"cfg\":{\"surface\":\"live_boot,live_session,oop_session,obj_guard,LIVE_SESSION_OK,NEED_OBJS,NEED_CLASSES,NEED_METHODS,NEED_FIELDS\",\"contract\":\"OOP catalog + live NEW · init --live\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"live_fleet\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  SYS RM agent_path
  CLEAR_ERR
  SYS RM peer_path
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_live_boot_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "live_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — full live plane green
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetWorker\nFleetQueue"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHODS = "FleetWorker.ping\nFleetWorker.bump\nFleetQueue.drain"
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELDS = "FleetWorker.id\nFleetWorker.load\nFleetQueue.depth"
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJS = "w0\nw1\nq0"
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 0
  INCLUDE live_boot
  LET live = LIVE_SESSION_OK
  LET oop = OOP_SESSION_OK
  LET obg = OBJ_GUARD_OK
  CLEAR_ERR
  IF live == 1 THEN
    LET score = score + 1
  END
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF obg == 1 THEN
    LET score = score + 1
  END
  HASOBJ w0
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ q0
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIVE_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "obj_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_OBJS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" live ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live oop obg note_msg
  CLEAR_ERR
END

# soft_obj — missing live instance sinks LIVE
SYS EQS op "soft_obj"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = ""
  LET NEED_METHODS = ""
  LET NEED_FIELDS = ""
  LET NEED_OBJS = "w0\nnosuch_live_obj_slv"
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 1
  INCLUDE live_session
  LET live = LIVE_SESSION_OK
  LET obg = OBJ_GUARD_OK
  LET oop = OOP_SESSION_OK
  LET miss_n = OBJMISS_N
  LET have_n = OBJHAVE_N
  CLEAR_ERR
  IF live == 0 THEN
    LET score = score + 1
  END
  IF obg == 0 THEN
    LET score = score + 1
  END
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE OBJMISS "nosuch_live_obj_slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE OBJHAVE "w0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend
  HASOBJ w
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "obj_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_obj ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_obj score"
    FAIL "soft_obj score"
    CLEAR_ERR
  END
  SYS CAT "soft_obj:" miss_n ":so"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_obj:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live miss_n note_msg
  CLEAR_ERR
END

# soft_cls — catalog miss sinks LIVE even if objs present
SYS EQS op "soft_cls"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "nosuch_live_class_slv"
  LET NEED_METHODS = ""
  LET NEED_FIELDS = ""
  LET NEED_OBJS = "w0\nw1"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 1
  INCLUDE live_session
  LET live = LIVE_SESSION_OK
  LET oop = OOP_SESSION_OK
  LET obg = OBJ_GUARD_OK
  LET cgo = CLASS_GUARD_OK
  CLEAR_ERR
  IF live == 0 THEN
    LET score = score + 1
  END
  IF oop == 0 THEN
    LET score = score + 1
  END
  IF cgo == 0 THEN
    LET score = score + 1
  END
  IF obg == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "oop_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIVE_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "live_boot_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_cls ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_cls score"
    FAIL "soft_cls score"
    CLEAR_ERR
  END
  SYS CAT "soft_cls:" cgo ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_cls:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live oop note_msg
  CLEAR_ERR
END

# hard — present catalog + objs under hard soft=0
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetWorker\nFleetQueue"
  LET NEED_METHODS = "FleetWorker.ping\nFleetQueue.drain"
  LET NEED_FIELDS = "FleetWorker.load\nFleetQueue.depth"
  LET NEED_OBJS = "w0\nq0"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 0
  INCLUDE live_boot
  LET live = LIVE_SESSION_OK
  LET oop = OOP_SESSION_OK
  LET obg = OBJ_GUARD_OK
  CLEAR_ERR
  IF live == 1 THEN
    LET score = score + 1
  END
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF obg == 1 THEN
    LET score = score + 1
  END
  # ANY duals
  LET NEED_CLASSES = ""
  LET NEED_METHODS = ""
  LET NEED_FIELDS = ""
  LET NEED_OBJS = ""
  LET NEED_CLASS_ANY = "nosuch_c\nFleetWorker"
  LET NEED_METHOD_ANY = "nosuch_m\nFleetWorker.bump"
  LET NEED_FIELD_ANY = "nosuch_f\nFleetWorker.id"
  LET NEED_OBJ_ANY = "nosuch_o\nw1"
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 0
  INCLUDE live_session
  LET live = LIVE_SESSION_OK
  CLEAR_ERR
  IF live == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "live_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_OBJS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "oop_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "NEW"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:" live ":hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live note_msg
  CLEAR_ERR
END

# spawn — NEW extra worker then gate NEED_OBJS includes it
SYS EQS op "spawn"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEW FleetWorker w2
  CLEAR_ERR
  HASOBJ w2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_CLASSES = "FleetWorker"
  LET NEED_METHODS = "FleetWorker.ping"
  LET NEED_FIELDS = "FleetWorker.load"
  LET NEED_OBJS = "w0\nw2"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  LET OBJ_GUARD_SOFT = 1
  INCLUDE live_session
  LET live = LIVE_SESSION_OK
  LET obg = OBJ_GUARD_OK
  LET have_n = OBJHAVE_N
  CLEAR_ERR
  IF live == 1 THEN
    LET score = score + 1
  END
  IF obg == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE OBJHAVE "w2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # SEND/METHOD field mutates are awkward (W735); count live gate only
  GETP "cfg.surface"
  SYS HAS LAST "LIVE_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "NEW"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "live_boot_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "spawn ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "spawn score"
    FAIL "spawn score"
    CLEAR_ERR
  END
  SYS CAT "spawn:" have_n ":sp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "spawn:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live have_n note_msg
  CLEAR_ERR
END

# form — HASLIB stack
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = ""
  LET NEED_METHODS = ""
  LET NEED_FIELDS = ""
  LET NEED_OBJS = ""
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 0
  INCLUDE live_boot
  CLEAR_ERR
  HASLIB live_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB live_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB oop_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB obj_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE live_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE obj_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "LIVE_SESSION_OK"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "live_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_OBJS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + soft full live
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetWorker\nFleetQueue"
  LET NEED_METHODS = "FleetWorker.ping\nFleetQueue.drain"
  LET NEED_FIELDS = "FleetWorker.load\nFleetQueue.depth"
  LET NEED_OBJS = "w0\nw1\nq0"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  LET OBJ_GUARD_SOFT = 1
  INCLUDE live_boot
  LET live = LIVE_SESSION_OK
  LET oop = OOP_SESSION_OK
  LET obg = OBJ_GUARD_OK
  CLEAR_ERR
  IF live == 1 THEN
    LET score = score + 1
  END
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF obg == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_CLASSES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_OBJS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "obj_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · LIVE_SESSION_OK + OBJHAVE
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetWorker"
  LET NEED_METHODS = "FleetWorker.ping"
  LET NEED_FIELDS = "FleetWorker.id"
  LET NEED_OBJS = "w0\nw1"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJ_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  LET OBJ_GUARD_SOFT = 1
  INCLUDE live_session
  LET live = LIVE_SESSION_OK
  LET have_n = OBJHAVE_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF live == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 2 THEN
    LET score = score + 1
  END
  SYS LINES OBJHAVE
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE OBJHAVE "w1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "live_boot_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "live_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "obj_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "live_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score live have_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " live=" live " oop=" oop " obg=" obg " have_n=" have_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "slv report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
