# svc_iflines_queue_depth_board.cubalc — IFLINES/IFMANY/IFFEW queue depth
#
# Real use: queue/batch agents admit work only when bag field-count is
# exact, at-least, or at-most — no LINESIN+IF glue. First realworld of
# 1494 IFLINES/IFMANY/IFFEW (1.15.950 · MI 955). Distinct from
# queue_depth_band (older band math) — this board is *bag field-count
# branches for work-queue admit / drain*.
#
#   IFLINES · IFMANY · IFFEW · IFLINES_N · IFLINES_NFIELDS · LINES
#   FN-wrap (W853) · empty=0 · undef=0 · num→1 field · PUSHTO bags
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ilq_$$
#   ./out/cubalc run programs/realworld/svc_iflines_queue_depth_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt ILQ_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_ILQ_REQUIRE
#
# Edges: empty/undef = 0 fields; num 42 → 1 field; band admit;
#   FN-wrap; STATUS bare; STRTO VAL; avoid var tries (W883)

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN is_exact_n
  IFLINES qbag lim_n
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_many
  IFMANY qbag lim_n
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_few
  IFFEW qbag lim_n
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# admit queue when depth in [min_n, max_n]
FN admit_depth
  LET state = "deny-empty"
  LET ok_v = 0
  LET lim_n = min_n
  CALL is_many
  IF ok_v == 0 THEN
    LET state = "deny-empty"
  END
  IF ok_v == 1 THEN
    LET lim_n = max_n
    CALL is_few
    IF ok_v == 0 THEN
      LET state = "deny-overflow"
    END
    IF ok_v == 1 THEN
      LET state = "admit"
      LET ok_v = 1
    END
  END
END

FN ghost_exact0
  IFLINES ghost_never_ilq 0
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

NOTE "svc_iflines_queue_depth_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_iflines_queue_depth -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_ILQ_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "ILQ_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "queues"
LET queue_dir = LAST
SYS JOIN queue_dir "hits.txt"
LET hits_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET qbag = ""
LET lim_n = 0
LET min_n = 0
LET max_n = 0
LET state = ""
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ilq\",\"schema\":\"cubalc.svc_iflines_queue_depth.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ilq\",\"want_filter\":\"iflines_queue_depth\",\"cfg\":{\"surface\":\"IFLINES,IFMANY,IFFEW,IFLINES_N,IFLINES_NFIELDS,LINES\",\"contract\":\"bag field-count branches for queue depth admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR queue_dir
  CLEAR_ERR
  SYS WRITE hits_path "err1\nerr2\nerr3"
  CLEAR_ERR
  LET qbag = ""
  PUSHTO qbag "a"
  PUSHTO qbag "b"
  PUSHTO qbag "c"
  LET lim_n = 3
  CALL is_exact_n
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ilq"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFLINES_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = IFLINES_NFIELDS
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot lines"
      FAIL "boot lines"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFLINES/IFMANY/IFFEW core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET qbag = ""
  PUSHTO qbag "a"
  PUSHTO qbag "b"
  PUSHTO qbag "c"
  LET lim_n = 3
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFLINES_N == 1 THEN
    LET score = score + 1
  END
  IF IFLINES_NFIELDS == 3 THEN
    LET score = score + 1
  END
  IF IFLINES_LIMIT == 3 THEN
    LET score = score + 1
  END
  IF LINES == 3 THEN
    LET score = score + 1
  END
  LET lim_n = 2
  CALL is_exact_n
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET lim_n = 3
  CALL is_many
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFMANY_N == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 3
  CALL is_few
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFFEW_N == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — empty · undef · num · band
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET qbag = ""
  LET lim_n = 0
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL ghost_exact0
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # numeric → one decimal field
  LET qbag = 42
  LET lim_n = 1
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET qbag = ""
  PUSHTO qbag "solo"
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 1
  CALL is_many
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET qbag = ""
  LET lim_n = 1
  CALL is_many
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET qbag = ""
  PUSHTO qbag "e1"
  PUSHTO qbag "e2"
  LET min_n = 1
  LET max_n = 5
  CALL admit_depth
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET qbag = ""
  CALL admit_depth
  SYS EQS state "deny-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET qbag = ""
  PUSHTO qbag "1"
  PUSHTO qbag "2"
  PUSHTO qbag "3"
  PUSHTO qbag "4"
  PUSHTO qbag "5"
  PUSHTO qbag "6"
  CALL admit_depth
  SYS EQS state "deny-overflow"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lim_n = 2
  LET qbag = ""
  PUSHTO qbag "a"
  PUSHTO qbag "b"
  PUSHTO qbag "c"
  CALL is_few
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi queue class
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET min_n = 2
  LET max_n = 4
  LET qbag = ""
  PUSHTO qbag "only"
  CALL admit_depth
  SYS EQS state "deny-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PUSHTO qbag "two"
  CALL admit_depth
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PUSHTO qbag "three"
  PUSHTO qbag "four"
  CALL admit_depth
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PUSHTO qbag "five"
  CALL admit_depth
  SYS EQS state "deny-overflow"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lim_n = 5
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFLINES_NFIELDS == 5 THEN
    LET score = score + 1
  END
  LET lim_n = 5
  CALL is_many
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL is_few
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iflines_queue_depth"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — depth ladder
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET qbag = ""
  PUSHTO qbag "w1"
  LET lim_n = 1
  CALL is_many
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  PUSHTO qbag "w2"
  PUSHTO qbag "w3"
  LET lim_n = 3
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 4
  CALL is_many
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET lim_n = 3
  CALL is_few
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 2
  CALL is_few
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET min_n = 2
  LET max_n = 8
  CALL admit_depth
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET qbag = ""
  CALL admit_depth
  SYS EQS state "deny-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET qbag = ""
  PUSHTO qbag "1"
  PUSHTO qbag "2"
  PUSHTO qbag "3"
  PUSHTO qbag "4"
  PUSHTO qbag "5"
  PUSHTO qbag "6"
  PUSHTO qbag "7"
  PUSHTO qbag "8"
  PUSHTO qbag "9"
  CALL admit_depth
  SYS EQS state "deny-overflow"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFLINES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFLINES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFMANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFFEW"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "WHENLINES"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENMANY"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFLINES_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFLINES_NFIELDS"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iflines_queue_depth"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFLINES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFMANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — band 1..8 admit; process when any hits
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET min_n = 1
  LET max_n = 8
  LET qbag = ""
  PUSHTO qbag "err1"
  PUSHTO qbag "err2"
  CALL admit_depth
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lim_n = 1
  CALL is_many
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET qbag = ""
  CALL admit_depth
  SYS EQS state "deny-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET qbag = ""
  PUSHTO qbag "1"
  PUSHTO qbag "2"
  PUSHTO qbag "3"
  PUSHTO qbag "4"
  PUSHTO qbag "5"
  PUSHTO qbag "6"
  PUSHTO qbag "7"
  PUSHTO qbag "8"
  PUSHTO qbag "9"
  CALL admit_depth
  SYS EQS state "deny-overflow"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lim_n = 9
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 8
  CALL is_few
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET qbag = ""
  PUSHTO qbag "hit"
  LET lim_n = 1
  CALL is_many
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL ghost_exact0
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "queue depth"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk hits · WRITE NL · NUM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR queue_dir
  CLEAR_ERR
  SYS WRITE hits_path "e1\ne2\ne3"
  CLEAR_ERR
  SYS READ hits_path
  LET qbag = LAST
  CLEAR_ERR
  LET lim_n = 3
  CALL is_exact_n
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET min_n = 1
  LET max_n = 8
  CALL admit_depth
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = IFLINES_NFIELDS
  IF saved == 3 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 3 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "iflines=" IFLINES_N " nfields=" IFLINES_NFIELDS " lim=" IFLINES_LIMIT
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iflines="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "ilq_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "ilq_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 3
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 3 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ilq"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ilq\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_iflines_queue_depth_board: done"
PASS
