  SYS CAT "hard:1:hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# skip — empty NEED_* both gates skip
SYS EQS op "skip"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET ARG_GUARD_SOFT = 0
  INCLUDE arg_guard
  CLEAR_ERR
  IF ARG_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  IF ARG_GUARD_ALL_OK == 1 THEN
    LET score = score + 1
  END
  IF ARG_GUARD_ANY_OK == 1 THEN
    LET score = score + 1
  END
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  CLEAR_ERR
  IF ARG_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  SYS ENV SET CUBALC_ARG0 "a"
  SYS ENV SET CUBALC_ARG1 "b"
  SYS ENV SET CUBALC_ARGC "2"
  LET NEED_ARGS = "0,1"
  LET NEED_ARG_ANY = ""
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  CLEAR_ERR
  IF ARG_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  IF ARG_GUARD_ANY_OK == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "arg_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARG_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "arg_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-ag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV UNSET CUBALC_ARG1
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "skip ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "skip score"
    FAIL "skip score"
    CLEAR_ERR
  END
  SYS CAT "skip:0:sk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "skip:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# combo — ALL positionals + ANY file/env
SYS EQS op "combo"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "a"
  SYS ENV SET CUBALC_ARG1 "b"
  SYS ENV SET CUBALC_ARGC "2"
  SYS ENV SET CUBALC_AG_FILE "f"
  LET NEED_ARGS = "0,1"
  LET NEED_ARG_ANY = "CUBALC_AG_FILE,9"
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_all = ARG_GUARD_ALL_OK
  LET g_any = ARG_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_all == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  SYS ENV UNSET CUBALC_ARG1
  SYS ENV SET CUBALC_ARGC "1"
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_all = ARG_GUARD_ALL_OK
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_all == 0 THEN
    LET score = score + 1
  END
  SYS ENV SET CUBALC_ARG1 "b"
  SYS ENV SET CUBALC_ARGC "2"
  SYS ENV UNSET CUBALC_AG_FILE
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_any = ARG_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_any == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.contract"
  SYS HAS LAST "ARG0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ARG_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_guard"
  IF LAST_N == 1 THEN
