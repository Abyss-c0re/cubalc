# svc_arg_guard_contract_board.cubalc — arg_guard NEED_ARGS+NEED_ARG_ANY fleet contract
#
# Real use: fleet intake agents gate CUBALC_ARGn + named env args with one
# INCLUDE arg_guard (ALL positionals + ANY source) instead of N× HASARG*.
# First realworld of 1388 arg_guard (1.15.840) · env_guard/cli_guard twin.
#
#   DEFAULT NEED_ARGS · NEED_ARG_ANY · ARG_GUARD_SOFT soft dual
#   ARG_GUARD_OK / ALL_OK / ANY_OK · ARGHAVE/ARGMISS
#   soft miss · hard pass · skip empty · combo dual · named env any-of
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ag_$$
#   ./out/cubalc run programs/realworld/svc_arg_guard_contract_board.cubalc boot
#   ./out/cubalc run ... soft|miss|hard|skip|combo|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt AG_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_AG_REQUIRE · CUBALC_AG_FILE synthetic
#
# Edges: LET NEED_* before each INCLUDE; hard miss exit_code 0;
#   ARGHAVE is index not value; PRINT clobber; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_arg_guard_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_arg_guard_contract -- boot|soft|miss|hard|skip|combo|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_AG_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "AG_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET g_ok = 0
LET g_all = 0
LET g_any = 0
LET miss_n = 0
LET have_n = 0

DEFAULT NEED_ARGS = ""
DEFAULT NEED_ARG_ANY = ""
DEFAULT ARG_GUARD_SOFT = 1

ONEOF ACTION "boot", "soft", "miss", "hard", "skip", "combo", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "miss" THEN
    LET op = "miss"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "skip" THEN
    LET op = "skip"
  WHEN "combo" THEN
    LET op = "combo"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-ag\",\"schema\":\"cubalc.svc_arg_guard_contract.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"arg_guard\",\"label\":\"ag\",\"cfg\":{\"surface\":\"arg_guard,NEED_ARGS,NEED_ARG_ANY,ARG_GUARD_SOFT,ARG_GUARD_OK,HASARGALL,HASARGANY\",\"contract\":\"ALL ARG0+ARG1 · ANY FILE|env\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"arg_guard\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-ag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_arg_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "ag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "arg_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — soft ALL + ANY hits
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "a.txt"
  SYS ENV SET CUBALC_ARG1 "b.txt"
  SYS ENV SET CUBALC_ARGC "2"
  LET NEED_ARGS = "0
1"
  LET NEED_ARG_ANY = ""
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_all = ARG_GUARD_ALL_OK
  LET g_any = ARG_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_all == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  # soft ANY named env
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV SET CUBALC_AG_FILE "x"
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = "0,CUBALC_AG_FILE"
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_any = ARG_GUARD_ANY_OK
  LET body = ARGHAVE
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "CUBALC_AG_FILE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # CSV ALL
  SYS ENV SET CUBALC_ARG0 "a"
  SYS ENV SET CUBALC_ARG1 "b"
  SYS ENV SET CUBALC_ARGC "2"
  LET NEED_ARGS = "0,1"
  LET NEED_ARG_ANY = ""
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  IF ARG_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARG_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ARGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "ag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_AG_FILE
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV UNSET CUBALC_ARG1
  SYS ENV SET CUBALC_ARGC "0"
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n g_ok score note_msg
  CLEAR_ERR
END

# miss — soft ALL/ANY miss
SYS EQS op "miss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV UNSET CUBALC_ARG1
  SYS ENV UNSET CUBALC_AG_FILE
  LET NEED_ARGS = "0
1"
  LET NEED_ARG_ANY = ""
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_all = ARG_GUARD_ALL_OK
  LET miss_n = ARGMISS_N
  LET stem_s = ARGMISS
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_all == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 2 THEN
    LET score = score + 1
  END
  SYS HASLINE stem_s "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = "0,CUBALC_AG_FILE"
  LET ARG_GUARD_SOFT = 1
  INCLUDE arg_guard
  LET g_ok = ARG_GUARD_OK
  LET g_any = ARG_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_any == 0 THEN
    LET score = score + 1
  END
  IF ARGMISS_N == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "ARG_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "ALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "miss ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "miss score"
    FAIL "miss score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE miss denied"
    END
  END
  SYS CAT "miss:" miss_n ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "miss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

