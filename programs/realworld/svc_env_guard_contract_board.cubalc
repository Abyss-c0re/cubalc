# svc_env_guard_contract_board.cubalc — env_guard NEED_ENVS+NEED_ENV_ANY fleet contract
#
# Real use: fleet agents gate host env with one INCLUDE env_guard instead of
# N× HASENVALL/HASENVANY + NEEDENVS/NEEDENVANY glue (cli_guard twin for env).
# First realworld of 1383 env_guard + 1384 env_boot (1.15.835+).
#
#   DEFAULT NEED_ENVS bag · NEED_ENV_ANY bag · ENV_GUARD_SOFT soft dual
#   ENV_GUARD_OK / ALL_OK / ANY_OK sticky · ENVMISS/ENVHAVE
#   soft miss · hard pass · skip empty · re-INCLUDE LET · combined dual
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_eg_$$
#   ./out/cubalc run programs/realworld/svc_env_guard_contract_board.cubalc boot
#   ./out/cubalc run ... soft|miss|hard|skip|combo|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt EG_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_EG_REQUIRE · synthetic CUBALC_EG_*
#
# Edges: LET NEED_* before each INCLUDE; hard miss exit_code 0; PRINT;
#   CLEAR_ERR LAST_N; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_env_guard_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_env_guard_contract -- boot|soft|miss|hard|skip|combo|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_EG_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "EG_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET g_ok = 0
LET g_all = 0
LET g_any = 0
LET miss_n = 0
LET have_n = 0

DEFAULT NEED_ENVS = ""
DEFAULT NEED_ENV_ANY = ""
DEFAULT ENV_GUARD_SOFT = 1

ONEOF ACTION "boot", "soft", "miss", "hard", "skip", "combo", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "miss" THEN
    LET op = "miss"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "skip" THEN
    LET op = "skip"
  WHEN "combo" THEN
    LET op = "combo"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-eg\",\"schema\":\"cubalc.svc_env_guard_contract.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"env_guard\",\"label\":\"eg\",\"cfg\":{\"surface\":\"env_guard,env_boot,NEED_ENVS,NEED_ENV_ANY,ENV_GUARD_SOFT,ENV_GUARD_OK,HASENVALL,HASENVANY\",\"contract\":\"ALL secrets + ANY location\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"env_guard\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_env_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — soft ALL + ANY hits
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_EG_A "1"
  SYS ENV SET CUBALC_EG_B "2"
  LET NEED_ENVS = "CUBALC_EG_A
CUBALC_EG_B"
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_all = ENV_GUARD_ALL_OK
  LET g_any = ENV_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_all == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  # soft ANY one of two
  SYS ENV SET CUBALC_EG_X "x"
  SYS ENV UNSET CUBALC_EG_Y
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = "CUBALC_EG_X,CUBALC_EG_Y"
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_any = ENV_GUARD_ANY_OK
  LET body = ENVHAVE
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "CUBALC_EG_X"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # CSV ALL
  LET NEED_ENVS = "CUBALC_EG_A,CUBALC_EG_B"
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  IF ENV_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ENV_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENVS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_EG_A
  SYS ENV UNSET CUBALC_EG_B
  SYS ENV UNSET CUBALC_EG_X
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n g_ok score note_msg
  CLEAR_ERR
END

# miss — soft ALL/ANY miss + ENVMISS
SYS EQS op "miss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV UNSET CUBALC_EG_A
  SYS ENV UNSET CUBALC_EG_B
  LET NEED_ENVS = "CUBALC_EG_A
CUBALC_EG_B"
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_all = ENV_GUARD_ALL_OK
  LET miss_n = ENVMISS_N
  LET stem_s = ENVMISS
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_all == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 2 THEN
    LET score = score + 1
  END
  SYS HASLINE stem_s "CUBALC_EG_A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = "CUBALC_EG_X,CUBALC_EG_Y"
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_any = ENV_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_any == 0 THEN
    LET score = score + 1
  END
  IF ENVMISS_N == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "ENV_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "ALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "miss ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "miss score"
    FAIL "miss score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE miss denied"
    END
  END
  SYS CAT "miss:" miss_n ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "miss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# hard — hard NEEDENVS/NEEDENVANY pass (miss leaves exit 0 — document)
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_EG_A "a"
  SYS ENV SET CUBALC_EG_B "b"
  LET NEED_ENVS = "CUBALC_EG_A,CUBALC_EG_B"
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 0
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_all = ENV_GUARD_ALL_OK
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_all == 1 THEN
    LET score = score + 1
  END
  SYS ENV SET CUBALC_EG_X "x"
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = "CUBALC_EG_X,CUBALC_EG_Y"
  LET ENV_GUARD_SOFT = 0
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_any = ENV_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENVS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASENVANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "location"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "env_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_EG_A
  SYS ENV UNSET CUBALC_EG_B
  SYS ENV UNSET CUBALC_EG_X
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:1:hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# skip — empty NEED_* both gates skip
SYS EQS op "skip"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 0
  INCLUDE env_guard
  CLEAR_ERR
  IF ENV_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  IF ENV_GUARD_ALL_OK == 1 THEN
    LET score = score + 1
  END
  IF ENV_GUARD_ANY_OK == 1 THEN
    LET score = score + 1
  END
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  CLEAR_ERR
  IF ENV_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  # ALL only skip ANY
  SYS ENV SET CUBALC_EG_A "1"
  SYS ENV SET CUBALC_EG_B "2"
  LET NEED_ENVS = "CUBALC_EG_A,CUBALC_EG_B"
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  CLEAR_ERR
  IF ENV_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  IF ENV_GUARD_ANY_OK == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ENV_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "env_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_EG_A
  SYS ENV UNSET CUBALC_EG_B
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "skip ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "skip score"
    FAIL "skip score"
    CLEAR_ERR
  END
  SYS CAT "skip:0:sk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "skip:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# combo — ALL + ANY together soft dual site contract
SYS EQS op "combo"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_EG_A "1"
  SYS ENV SET CUBALC_EG_B "2"
  SYS ENV SET CUBALC_EG_X "x"
  SYS ENV UNSET CUBALC_EG_Y
  LET NEED_ENVS = "CUBALC_EG_A,CUBALC_EG_B"
  LET NEED_ENV_ANY = "CUBALC_EG_X,CUBALC_EG_Y"
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_all = ENV_GUARD_ALL_OK
  LET g_any = ENV_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 1 THEN
    LET score = score + 1
  END
  IF g_all == 1 THEN
    LET score = score + 1
  END
  IF g_any == 1 THEN
    LET score = score + 1
  END
  # drop secret → combo fail
  SYS ENV UNSET CUBALC_EG_B
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_all = ENV_GUARD_ALL_OK
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_all == 0 THEN
    LET score = score + 1
  END
  # restore secret drop location
  SYS ENV SET CUBALC_EG_B "2"
  SYS ENV UNSET CUBALC_EG_X
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET g_any = ENV_GUARD_ANY_OK
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF g_any == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.contract"
  SYS HAS LAST "secrets"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENV_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_EG_A
  SYS ENV UNSET CUBALC_EG_B
  SYS ENV UNSET CUBALC_EG_X
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "combo ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "combo score"
    FAIL "combo score"
    CLEAR_ERR
  END
  SYS CAT "combo:1:cb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "combo:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASLIB env_guard/env_boot · HASFORM duals
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASLIB env_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB env_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  REQUIRE LIB env_guard
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  HASFORM "HASENVALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "HASENVANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEEDENVS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "env_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "env_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live combo soft
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_EG_A "g"
  SYS ENV SET CUBALC_EG_B "g"
  SYS ENV SET CUBALC_EG_X "z"
  LET NEED_ENVS = "CUBALC_EG_A,CUBALC_EG_B"
  LET NEED_ENV_ANY = "CUBALC_EG_X,CUBALC_EG_Y"
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  CLEAR_ERR
  IF ENV_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENVS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENV_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ENV_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "ALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "env_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASENVALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_EG_A
  SYS ENV UNSET CUBALC_EG_B
  SYS ENV UNSET CUBALC_EG_X
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · re-INCLUDE
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV UNSET CUBALC_EG_A
  LET NEED_ENVS = "CUBALC_EG_A"
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 1
  INCLUDE env_guard
  LET g_ok = ENV_GUARD_OK
  LET stem_s = ENVMISS
  LET miss_n = ENVMISS_N
  CLEAR_ERR
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE LAST "CUBALC_EG_A"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "CUBALC_EG_A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF g_ok == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 1 THEN
    LET score = score + 1
  END
  SYS ENV SET CUBALC_EG_A "ok"
  INCLUDE env_guard
  CLEAR_ERR
  IF ENV_GUARD_OK == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "env_guard_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ENV_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "location"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS ENV UNSET CUBALC_EG_A
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" miss_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " g_ok=" g_ok " g_all=" g_all " g_any=" g_any
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "eg report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
