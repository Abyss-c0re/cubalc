# deploy_wave_batcher.cubalc — rolling deploy waves under STATE
#
# Real use: agents batch fleet hosts into deploy waves (SYS CHUNK), peel
# host ids (BEFOREALL), and locate first failure (FIRSTMATCH) without shell.
#
# Row shape: host:status
#   status: pending | live | fail | skip
# Waves plate: each field is space-joined hosts (CHUNK n)
#
# Actions (CUBALC_ARG0 / CUBALC_DW_ACTION):
#   list     — depth + status tallies + wave count (default)
#   seed     — WORDS hosts → host:pending if absent
#   admit    — ensure host:pending (VAL unused; A2 unused)
#   peel     — BEFOREALL bag ":" → hosts-only bag (report, not persist default)
#   waves    — pending hosts → CHUNK SIZE → WAVES plate
#   next     — HEAD waves → current wave; soft empty
#   advance  — for each host in ARG1 (space list) pending→live SETMATCH
#   fail     — first host match → host:fail
#   skip     — first host match → host:skip
#   findfail — FIRSTMATCH bag ":fail" (or needle ARG1)
#   pinfail  — MOVELINE first :fail to front
#   drop     — REMOVELINE first host:* 
#   has      — identity present
#   count    — COUNTLINE exact host:status or tally host any
#   clear    — empty bag
#   clearwaves — empty waves plate
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1="h1 h2 h3 h4 h5" \
#     ./out/cubalc run -q -s programs/realworld/deploy_wave_batcher.cubalc
#   CUBALC_ARG0=waves CUBALC_ARG1=2 ./out/cubalc run -q -s ...
#   CUBALC_ARG0=next ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_DW_FILE=FLEET.txt
#   CUBALC_DW_WAVES=WAVES.txt
#   CUBALC_DW_REQUIRE=1
#   CUBALC_DW_SIZE=2
#
# Edges deliberately stressed:
#   CHUNK join sep: only string literals work — SYS CHUNK n bag sep_var → unknown form
#   CHUNK joins with space — hostnames with spaces break reverse-parse / WORDS advance
#   CHUNK n<=0 → empty soft (not FAIL sticky)
#   BEFOREALL miss keeps whole field (plain rows pollute host list)
#   AFTERALL miss → empty field (SQUEEZE needed)
#   FIRSTMATCH substring — :fail matches host:fail and also prefail:live?
#   SETMATCH first exact only; rebuild via REPLACEALL templates
#   no multi-host atomic advance — EACH SETMATCH
#   PRINT_JSON collapse; WRITE trailing NL; soft READ; REQUIRE miss

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "deploy_wave_batcher: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT RFILE = "FLEET.txt"
DEFAULT WFILE = "WAVES.txt"
DEFAULT REPORT = "WAVE_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT WSIZE = 2
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_DW_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_DW_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_DW_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_DW_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_DW_WAVES" OR ""
IF LAST_N > 0 THEN
  LET WFILE = LAST
END
SYS ENV "CUBALC_DW_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_DW_SIZE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET WSIZE = LAST_N
  END
END
SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir WFILE
LET waves_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR "soft fleet load"
SYS LINES bag
LET depth0 = LAST_N

SYS READ OR waves_path OR ""
LET waves = LAST
CLEAR_ERR
SYS LINES waves
LET wave_n0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET waves_changed = 0
LET note_msg = "ok"
LET n_pending = 0
LET n_live = 0
LET n_fail = 0
LET n_skip = 0
LET name_hit = 0
LET old_entry = ""
LET entry = ""
LET hosts = ""
LET pending_hosts = ""
LET filtered = ""
LET wave = ""
LET idx = -1

# waves/next size override from ARG1 when numeric action
SYS EQS ACTION "waves"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    SYS PREPEND "" NAME
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET WSIZE = LAST_N
    END
  END
END

# templates
LET e_pending = "NAME:pending"
SYS REPLACEALL e_pending "NAME" NAME
LET e_pending = LAST
LET e_live = "NAME:live"
SYS REPLACEALL e_live "NAME" NAME
LET e_live = LAST
LET e_fail = "NAME:fail"
SYS REPLACEALL e_fail "NAME" NAME
LET e_fail = LAST
LET e_skip = "NAME:skip"
SYS REPLACEALL e_skip "NAME" NAME
LET e_skip = LAST

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS GREP ":pending" bag
  SYS LINES LAST
  LET n_pending = LAST_N
  SYS GREP ":live" bag
  SYS LINES LAST
  LET n_live = LAST_N
  SYS GREP ":fail" bag
  SYS LINES LAST
  LET n_fail = LAST_N
  SYS GREP ":skip" bag
  SYS LINES LAST
  LET n_skip = LAST_N
  SYS LINES waves
  LET wave_n0 = LAST_N
  STATUS
  PRINT "depwave" depth0 n_pending n_live n_fail n_skip wave_n0 ACTION
  PRINT_JSON depth0 n_pending n_live n_fail n_skip wave_n0 ACTION STATUS_OK
  PRINT_JSON bag
  PRINT_JSON waves
  LET note_msg = "list ok"
END

# --- seed ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs host ids"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      LET name_hit = 0
      EACH LINE AS row IN bag
        SYS BEFORE row ":"
        SYS EQS LAST n
        IF LAST_N == 1 THEN
          LET name_hit = 1
        END
      END
      IF name_hit == 0 THEN
        LET e = "NAME:pending"
        SYS REPLACEALL e "NAME" n
        LET e = LAST
        SYS PUSH bag e
        LET bag = LAST
        LET changed = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded"
END

# --- admit host:pending ---
SYS EQS ACTION "admit"
IF LAST_N == 1 THEN
  NOTE "action admit"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "admit needs host"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    SYS PUSH bag e_pending
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "admit inserted"
  ELSE
    SYS EQS old_entry e_pending
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "admit already pending"
    ELSE
      SYS SETMATCH bag old_entry e_pending
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "admit setmatch miss"
        FAIL "admit setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "admit miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "admit reset pending"
      END
    END
  END
END

# --- peel: BEFOREALL host ids ---
SYS EQS ACTION "peel"
IF LAST_N == 1 THEN
  NOTE "action peel"
  SYS BLANK bag
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "peel empty"
    FAIL "peel empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "peel empty"
    END
  ELSE
    SYS BEFOREALL bag ":"
    LET hosts = LAST
    SYS LINES hosts
    LET hit = LAST_N
    LET note_msg = "peeled"
    PRINT_JSON hosts
  END
END

# --- waves: pending hosts CHUNK ---
SYS EQS ACTION "waves"
IF LAST_N == 1 THEN
  NOTE "action waves"
  SYS GREP ":pending" bag
  LET filtered = LAST
  SYS LINES filtered
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "waves no pending"
    FAIL "waves no pending"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "waves no pending"
    END
  ELSE
    SYS BEFOREALL filtered ":"
    LET pending_hosts = LAST
    SYS MAX WSIZE 1
    LET WSIZE = LAST_N
    # CHUNK join sep only accepts string literals — bare var → unknown form (lang gap).
    # Default space join; cannot pass CUBALC_DW_JOIN through a variable.
    SYS CHUNK WSIZE pending_hosts
    LET waves = LAST
    LET waves_changed = 1
    SYS LINES waves
    LET hit = LAST_N
    IF hit == 0 THEN
      LET miss = 1
      LET note_msg = "waves chunk empty"
      FAIL "waves chunk empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "waves chunk empty"
      END
    ELSE
      LET note_msg = "waved"
    END
    PRINT_JSON waves
  END
END

# --- next: HEAD waves ---
SYS EQS ACTION "next"
IF LAST_N == 1 THEN
  NOTE "action next"
  SYS BLANK waves
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "next no waves"
    FAIL "next no waves"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "next no waves"
    END
  ELSE
    SYS HEAD waves
    LET wave = LAST
    SYS BLANK wave
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "next empty wave"
      FAIL "next empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "next empty"
      END
    ELSE
      LET hit = 1
      LET note_msg = "next wave"
      # pop first wave field
      SYS DROPNTH waves 0
      LET waves = LAST
      LET waves_changed = 1
    END
    PRINT_JSON wave
  END
END

# --- advance: WORDS hosts pending→live ---
SYS EQS ACTION "advance"
IF LAST_N == 1 THEN
  NOTE "action advance"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "advance needs host list"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      LET e_p = "NAME:pending"
      SYS REPLACEALL e_p "NAME" n
      LET e_p = LAST
      LET e_l = "NAME:live"
      SYS REPLACEALL e_l "NAME" n
      LET e_l = LAST
      SYS COUNTLINE bag e_p
      IF LAST_N == 0 THEN
        LET miss = miss + 1
      ELSE
        SYS SETMATCH bag e_p e_l
        IF LAST_N == 0 THEN
          LET miss = miss + 1
        ELSE
          LET bag = LAST
          LET changed = 1
          LET hit = hit + 1
        END
      END
    END
  END
  IF hit == 0 THEN
    LET note_msg = "advance none"
    FAIL "advance none"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "advance none"
    END
  ELSE
    LET note_msg = "advanced"
  END
END

# --- fail host ---
SYS EQS ACTION "fail"
IF LAST_N == 1 THEN
  NOTE "action fail"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "fail needs host"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "fail miss"
    FAIL "fail miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "fail miss"
    END
  ELSE
    SYS SETMATCH bag old_entry e_fail
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "fail setmatch miss"
      FAIL "fail setmatch"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "fail setmatch"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "failed"
    END
  END
END

# --- skip host ---
SYS EQS ACTION "skip"
IF LAST_N == 1 THEN
  NOTE "action skip"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "skip needs host"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "skip miss"
    FAIL "skip miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "skip miss"
    END
  ELSE
    SYS SETMATCH bag old_entry e_skip
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "skip setmatch miss"
      FAIL "skip setmatch"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "skip setmatch"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "skipped"
    END
  END
END

# --- findfail: FIRSTMATCH ---
SYS EQS ACTION "findfail"
IF LAST_N == 1 THEN
  NOTE "action findfail"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET tok = ":fail"
  ELSE
    LET tok = NAME
  END
  SYS FIRSTMATCH bag tok
  LET filtered = LAST
  SYS BLANK filtered
  IF LAST_N == 1 THEN
    LET miss = 1
    LET hit = 0
    LET note_msg = "findfail none"
    FAIL "findfail none"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "findfail none"
    END
  ELSE
    LET hit = 1
    LET note_msg = "findfail hit"
  END
  PRINT_JSON filtered
END

# --- pinfail ---
SYS EQS ACTION "pinfail"
IF LAST_N == 1 THEN
  NOTE "action pinfail"
  SYS FIRSTMATCH bag ":fail"
  LET filtered = LAST
  SYS BLANK filtered
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "pinfail none"
    FAIL "pinfail none"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pinfail none"
    END
  ELSE
    SYS FINDLINE bag filtered
    LET idx = LAST_N
    SYS MOVELINE bag idx 0
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "pinfail moveline miss"
      FAIL "pinfail moveline"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "pinfailed"
    END
  END
END

# --- drop / has / count ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs host"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "drop miss"
    FAIL "drop miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop miss"
    END
  ELSE
    SYS REMOVELINE bag old_entry
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "dropped"
  END
END

SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs host"
  END
  LET name_hit = 0
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      LET name_hit = 1
    END
  END
  LET hit = name_hit
  LET note_msg = "has"
END

SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs exact token or host"
  END
  SYS COUNTLINE bag NAME
  LET hit = LAST_N
  IF hit == 0 THEN
    # try host any status via GREP host:
    LET tok = "NAME:"
    SYS REPLACEALL tok "NAME" NAME
    LET tok = LAST
    SYS GREP tok bag
    SYS LINES LAST
    LET hit = LAST_N
  END
  LET note_msg = "counted"
END

SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET bag = ""
  LET changed = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "clearwaves"
IF LAST_N == 1 THEN
  NOTE "action clearwaves"
  LET waves = ""
  LET waves_changed = 1
  LET hit = 1
  LET note_msg = "waves cleared"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "admit"
LET k = k + LAST_N
SYS EQS ACTION "peel"
LET k = k + LAST_N
SYS EQS ACTION "waves"
LET k = k + LAST_N
SYS EQS ACTION "next"
LET k = k + LAST_N
SYS EQS ACTION "advance"
LET k = k + LAST_N
SYS EQS ACTION "fail"
LET k = k + LAST_N
SYS EQS ACTION "skip"
LET k = k + LAST_N
SYS EQS ACTION "findfail"
LET k = k + LAST_N
SYS EQS ACTION "pinfail"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
SYS EQS ACTION "clearwaves"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "fleet write failed"
  END
  CLEAR_ERR
END
IF waves_changed > 0 THEN
  SYS WRITE waves_path waves
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "waves write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS LINES waves
LET wave_n1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.depwave.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_pending"
LET report = LAST
SYS STR n_pending
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "wsize"
LET report = LAST
SYS STR WSIZE
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "wave_n1"
LET report = LAST
SYS STR wave_n1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "depwave" ACTION hit miss WSIZE depth1 wave_n1
PRINT_JSON ACTION hit miss n_pending n_live n_fail n_skip WSIZE depth1 wave_n1 elapsed STATUS_OK
PASS "depwave tick"
NOTE "deploy_wave_batcher: done"
CLEAR_ERR
EXIT 0 "depwave ok"
