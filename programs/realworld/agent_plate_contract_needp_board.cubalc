# agent_plate_contract_needp_board.cubalc — NEEDP/HASPALL/KEYSP + MERGEP/DEFAULTP
#
# Real use: agent PLATE contract gate after boot — soft key probes, multi-key
# overlay, fill-if-missing defaults, fail-fast NEEDP before work.
# First realworld of proofs 1111/1113 (MERGEP + NEEDP family).
#
#   INCLUDE plate_boot · MERGEP|PATCHP · DEFAULTP|ENSUREP · TOGGLEP|FLIPP
#   HASP · HASPALL · KEYSP · NEEDP|REQUIREP (fail-fast missing keys)
#   INCLUDE plate_save
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_apcn_$$
#   ./out/cubalc run programs/realworld/agent_plate_contract_needp_board.cubalc \
#     boot -- --plate=/tmp/apcn/agent.json
#   ./out/cubalc run ... merge -- --plate=... --status=ready
#   ./out/cubalc run ... need -- --plate=...
#   ./out/cubalc run ... gate -- --plate=...
#
# Plate: STATUS.txt VAL.txt META.txt APCN_REPORT.txt
# Env: PLATE_PATH STATUS_S CUBALC_APCN_REQUIRE
#
# Edges:
#   HASP soft miss OK=1; HASPALL miss bag; NEEDP hard fail;
#   MERGEP overlay wins; DEFAULTP no clobber; KEYSP count;
#   GETP LAST_N strlen (W189); 128-var lean

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_plate_contract_needp_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "agent_plate_contract_needp -- boot|merge|defaults|toggle|keys|has|need|gate|probe|list -- [--plate=P] [--status=S]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/deep/agent.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
CLEAR_ERR

DEFAULT STATUS_S = "ready"
GETFLAG status|s OR ENV STATUS_S OR STATUS_S
LET status_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_APCN_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "APCN_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET peel_s = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "merge", "defaults", "toggle", "keys", "has", "need", "gate", "list", "ls", "soft", "clear", "probe", "alias"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "merge" THEN
    LET op = "merge"
  WHEN "defaults" THEN
    LET op = "defaults"
  WHEN "toggle" THEN
    LET op = "toggle"
  WHEN "keys" THEN
    LET op = "keys"
  WHEN "has" THEN
    LET op = "has"
  WHEN "need" THEN
    LET op = "need"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "alias" THEN
    LET op = "alias"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src status_s
  CLEAR_ERR
END

LET PLATE_PATH = plate_file
SYS JSONOBJ "n" 1 "ok" true "role" "worker" "schema" "cubalc.agent_contract.v1"
LET PLATE_SEED = LAST
CLEAR_ERR

# boot
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONHASALL body "n" "ok" "role"
  LET has_n = LAST_N
  CLEAR_ERR
  LET out = body
  LET take_n = load_hit
  IF load_hit == 1 THEN
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET created = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot keys"
      FAIL "boot keys"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot load"
    FAIL "boot load"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "boot fail"
    END
  END
  SYS CAT "boot:"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":bt"
  LET row = LAST
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit has_n p_src note_msg
  CLEAR_ERR
END

# merge — MERGEP overlay status + n
SYS EQS op "merge"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "status" status_s "n" 9 "peer" "a"
  MERGEP LAST
  LET take_n = LAST_N
  LET has_n = OK
  CLEAR_ERR
  IF has_n == 0 THEN
    LET miss = 1
    LET note_msg = "merge soft fail"
    FAIL "merge soft fail"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "merge fail"
    END
  ELSE
    GETP "status"
    LET peel_s = LAST
    CLEAR_ERR
    SYS EQS peel_s status_s
    LET peel_hit = LAST_N
    CLEAR_ERR
    INCLUDE plate_save
    CLEAR_ERR
    SYS LOADPLATE plate_file
    SYS JSONN "n" FROM LAST
    LET load_hit = LAST_N
    CLEAR_ERR
    LET out = PLATE
    IF peel_hit == 1 THEN
      IF load_hit == 9 THEN
        LET hit = 1
        LET note_msg = "merge ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "merge n"
        FAIL "merge n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "merge status"
      FAIL "merge status"
      CLEAR_ERR
    END
  END
  SYS CAT "merge:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS CAT row status_s
  LET row = LAST
  SYS CAT row ":mg"
  LET row = LAST
  SYS GREPV "merge:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit load_hit p_src note_msg
  CLEAR_ERR
END

# defaults — DEFAULTP retries no clobber
SYS EQS op "defaults"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  DEFAULTP "retries" 3
  LET take_n = LAST_N
  CLEAR_ERR
  SETP "retries" 99
  CLEAR_ERR
  DEFAULTP "retries" 3
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "retries"
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "99"
  LET peel_hit = LAST_N
  CLEAR_ERR
  INCLUDE plate_save
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 0 THEN
      LET hit = 1
      LET note_msg = "defaults ok"
      LET admit_n = 1
    ELSE
      LET miss = 1
      LET note_msg = "defaults clobber"
      FAIL "defaults clobber"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "defaults peel"
    FAIL "defaults peel"
    CLEAR_ERR
  END
  SYS CAT "defaults:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":df"
  LET row = LAST
  SYS GREPV "defaults:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit p_src note_msg
  CLEAR_ERR
END

# toggle — TOGGLEP debug 0↔1
SYS EQS op "toggle"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  TOGGLEP "debug"
  LET take_n = LAST_N
  CLEAR_ERR
  TOGGLEP "debug"
  LET has_n = LAST_N
  CLEAR_ERR
  TOGGLEP "debug"
  LET peel_hit = LAST_N
  CLEAR_ERR
  INCLUDE plate_save
  CLEAR_ERR
  # sequence miss→1, →0, →1
  IF take_n == 1 THEN
    IF has_n == 0 THEN
      IF peel_hit == 1 THEN
        LET hit = 1
        LET note_msg = "toggle ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "toggle third"
        FAIL "toggle third"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "toggle second"
      FAIL "toggle second"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "toggle first"
    FAIL "toggle first"
    CLEAR_ERR
  END
  SYS CAT "toggle:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":tg"
  LET row = LAST
  SYS GREPV "toggle:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit p_src note_msg
  CLEAR_ERR
END

# keys — KEYSP bag
SYS EQS op "keys"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  KEYSP
  LET take_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "n"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE body "role"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET out = body
  IF take_n >= 3 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        LET hit = 1
        LET note_msg = "keys ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "keys role"
        FAIL "keys role"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "keys n"
      FAIL "keys n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "keys count"
    FAIL "keys count"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "keys fail"
    END
  END
  SYS CAT "keys:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":ky"
  LET row = LAST
  SYS GREPV "keys:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit p_src note_msg
  CLEAR_ERR
END

# has — HASP soft + HASPALL
SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  HASP "n"
  LET take_n = LAST_N
  CLEAR_ERR
  HASP "missing"
  LET has_n = LAST_N
  LET peel_hit = OK
  CLEAR_ERR
  HASPALL "n" "ok" "role"
  LET load_hit = LAST_N
  CLEAR_ERR
  # intentional ghost key (status may exist after merge — do not use it)
  HASPALL "n" "ghost_key"
  LET admit_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ghost_key"
  LET created = LAST_N
  CLEAR_ERR
  # take_n 1 hit; has_n 0 miss; peel_hit OK=1 soft; load_hit 1 all; admit 0 partial
  IF take_n == 1 THEN
    IF has_n == 0 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF admit_n == 0 THEN
            IF created == 1 THEN
              LET hit = 1
              LET note_msg = "has ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "has missbag"
              FAIL "has missbag"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "has partial"
            FAIL "has partial"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "has all"
          FAIL "has all"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "has softok"
        FAIL "has softok"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "has n"
    FAIL "has n"
    CLEAR_ERR
  END
  SYS CAT "has:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":hs"
  LET row = LAST
  SYS GREPV "has:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n load_hit created p_src note_msg
  CLEAR_ERR
END

# need — NEEDP contract (soft path if keys missing without require)
SYS EQS op "need"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  HASPALL "n" "ok" "role" "status"
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    IF require_hit > 0 THEN
      # NEEDP alone leaves exit_code 0 (W194) — EXIT for shell-visible hard miss
      FAIL "need require missing status"
      CLEAR_ERR
      EXIT 2 "need require"
    END
    # soft: fill then admit
    DEFAULTP "role" "worker"
    CLEAR_ERR
    SYS JSONOBJ "status" status_s
    MERGEP LAST
    CLEAR_ERR
  END
  NEEDP "n" "ok" "role" "status"
  LET take_n = LAST_N
  LET peel_hit = OK
  CLEAR_ERR
  IF peel_hit == 1 THEN
    LET hit = 1
    LET note_msg = "need ok"
    LET admit_n = 1
    INCLUDE plate_save
    CLEAR_ERR
  ELSE
    LET miss = 1
    LET note_msg = "need fail"
    FAIL "need fail"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "need fail"
    END
  END
  SYS CAT "need:"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":nd"
  LET row = LAST
  SYS GREPV "need:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit p_src note_msg
  CLEAR_ERR
END

# gate — NEEDP + KEYSP after merge
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "status" status_s "schema" "cubalc.agent_contract.v1"
  MERGEP LAST
  CLEAR_ERR
  DEFAULTP "role" "worker"
  CLEAR_ERR
  NEEDP "n" "ok" "role" "status"
  LET take_n = OK
  CLEAR_ERR
  IF take_n == 0 THEN
    LET miss = 1
    LET note_msg = "gate need"
    FAIL "gate need"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate need"
    END
  ELSE
    KEYSP
    LET has_n = LAST_N
    CLEAR_ERR
    INCLUDE plate_save
    CLEAR_ERR
    SYS LOADPLATE plate_file
    LET load_hit = LAST_N
    CLEAR_ERR
    IF has_n >= 4 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "gate admit"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "gate load"
        FAIL "gate load"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate keys"
      FAIL "gate keys"
      CLEAR_ERR
    END
  END
  SYS CAT "gate:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":gt"
  LET row = LAST
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n load_hit admit_n p_src note_msg
  CLEAR_ERR
END

# alias — PATCHP / ENSUREP / FLIPP / REQUIREP
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/alias_needp.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  LET PLATE_PATH = row
  SYS JSONOBJ "n" 1 "ok" true
  LET PLATE_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_boot
  CLEAR_ERR
  SYS JSONOBJ "tag" "x"
  PATCHP LAST
  LET take_n = OK
  CLEAR_ERR
  ENSUREP "role" "worker"
  LET has_n = LAST_N
  CLEAR_ERR
  FLIPP "debug"
  LET peel_hit = LAST_N
  CLEAR_ERR
  REQUIREP "n" "ok" "role"
  LET load_hit = OK
  CLEAR_ERR
  LET PLATE_PATH = plate_file
  IF take_n == 1 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          LET hit = 1
          LET note_msg = "alias ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "alias require"
          FAIL "alias require"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "alias flip"
        FAIL "alias flip"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "alias ensure"
      FAIL "alias ensure"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "alias patch"
    FAIL "alias patch"
    CLEAR_ERR
  END
  SYS CAT "alias:"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":al"
  LET row = LAST
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit p_src note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — NEEDP fail-fast soft capture via HASPALL; MERGE empty; DEFAULTP
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/probe_needp.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  LET PLATE_PATH = row
  SYS JSONOBJ "n" 0
  LET PLATE_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_boot
  CLEAR_ERR
  # incomplete contract
  HASPALL "n" "status"
  LET take_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "status"
  LET has_n = LAST_N
  CLEAR_ERR
  # HASP soft miss
  HASP "status"
  LET peel_hit = LAST_N
  LET load_hit = OK
  CLEAR_ERR
  # MERGEP fills
  SYS JSONOBJ "status" "ready" "ok" true
  MERGEP LAST
  CLEAR_ERR
  HASPALL "n" "status" "ok"
  LET admit_n = LAST_N
  CLEAR_ERR
  DEFAULTP "retries" 3
  LET created = LAST_N
  CLEAR_ERR
  DEFAULTP "retries" 9
  LET bag_n = LAST_N
  CLEAR_ERR
  LET PLATE_PATH = plate_file
  IF take_n == 0 THEN
    IF has_n == 1 THEN
      IF peel_hit == 0 THEN
        IF load_hit == 1 THEN
          IF admit_n == 1 THEN
            IF created == 1 THEN
              IF bag_n == 0 THEN
                LET note_msg = "probe ok"
                LET hit = 1
                LET admit_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "probe defclobber"
                FAIL "probe defclobber"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe defset"
              FAIL "probe defset"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe merge"
            FAIL "probe merge"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe softok"
          FAIL "probe softok"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe hasp"
        FAIL "probe hasp"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe missname"
      FAIL "probe missname"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe hasall"
    FAIL "probe hasall"
    CLEAR_ERR
  END
  PRINT_JSON take_n has_n peel_hit load_hit admit_n created bag_n p_src note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_plate_contract_needp_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "admit"
LET row = LAST
SYS STR admit_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "plate"
LET row = LAST
SYS PUSH row plate_file
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "apcn op="
LET body = LAST
SYS CAT body op
LET body = LAST
SYS CAT body " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST
LET body = LAST
SYS CAT body " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST
LET body = LAST
SYS CAT body " note="
LET body = LAST
SYS CAT body note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n created load_hit peel_hit p_src note_msg
NOTE "agent_plate_contract_needp_board: done"
