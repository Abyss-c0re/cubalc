# svc_tryrename_swap_fleet_board.cubalc — TRYRENAME/TRYSWAP soft fleet slot ops
#
# Real use: fleet agents soft-rename live worker slots (canary promote) and
# soft-swap primary/backup roles without temp+RENAME glue or fatal miss.
# First realworld of 1412 TRYRENAME + 1413 TRYSWAP (1.15.866+ · MI 873).
#
#   TRYRENAME src dst · RENAMEOBJ SOFT · SOFTRENAME · MOVEOBJ SOFT AS · TRYMOVEOBJ TO
#   TRYSWAP a b · SWAPOBJ SOFT · SOFTSWAP WITH · EXCHANGEOBJ AND · XCHOBJ
#   TRYRENAME_N · TRYSWAP_N · RENAME_FROM · SWAP_A/SWAP_B · soft miss/redefine
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_trs_$$
#   ./out/cubalc run programs/realworld/svc_tryrename_swap_fleet_board.cubalc boot
#   ./out/cubalc run ... pass|soft_rn|soft_sw|redef|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt TRS_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_TRS_REQUIRE
#
# Edges: rename moves name (old HASOBJ 0); swap flips identity not fields;
#   soft miss unknown/redefine; no-op same name OK; WRITE NL; substring HASOBJ

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS FleetSlot
  FIELD role "idle"
  FIELD load 0
END

NOTE "svc_tryrename_swap_fleet_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_tryrename_swap_fleet -- boot|pass|soft_rn|soft_sw|redef|form|gate|probe|list"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_TRS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "TRS_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_n = 0
LET rn = 0
LET sw = 0
LET ok_v = 0

ONEOF ACTION "boot", "pass", "soft_rn", "soft_sw", "redef", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_rn" THEN
    LET op = "soft_rn"
  WHEN "soft_sw" THEN
    LET op = "soft_sw"
  WHEN "redef" THEN
    LET op = "redef"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-trs\",\"schema\":\"cubalc.svc_tryrename_swap_fleet.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"trs\",\"want_filter\":\"slot_flip\",\"cfg\":{\"surface\":\"TRYRENAME,RENAMEOBJ_SOFT,TRYSWAP,SWAPOBJ_SOFT,TRYRENAME_N,TRYSWAP_N,RENAME_FROM,SWAP_A,SWAP_B\",\"contract\":\"soft rename/swap fleet slots · canary promote\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS READ agent_path
  SYS HAS LAST "svc-trs"
  IF LAST_N == 1 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
    LET score = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — rename canary→live + swap primary/backup
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot canary
  SETF canary role "canary"
  SETF canary load 5
  NEW FleetSlot primary
  SETF primary role "primary"
  SETF primary load 9
  NEW FleetSlot backup
  SETF backup role "backup"
  SETF backup load 2
  CLEAR_ERR
  TRYRENAME canary live
  LET ok_v = OK
  LET rn = TRYRENAME_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF rn == 1 THEN
    LET score = score + 1
  END
  HASOBJ canary
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ live
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF live load
  IF LAST_N == 5 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSWAP primary backup
  LET ok_v = OK
  LET sw = TRYSWAP_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF sw == 1 THEN
    LET score = score + 1
  END
  # after swap: name primary has old backup load 2
  GETF primary load
  IF LAST_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF backup load
  IF LAST_N == 9 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  SYS HAS LAST "slot_flip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" rn ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score rn sw note_msg
  CLEAR_ERR
END

# soft_rn — missing source + redefine soft
SYS EQS op "soft_rn"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot s0
  SETF s0 load 4
  NEW FleetSlot held
  CLEAR_ERR
  TRYRENAME missing_zz ghost
  LET ok_v = OK
  LET rn = TRYRENAME_N
  # capture LAST_ERR before CLEAR_ERR (sticky err is the soft-miss signal)
  LET err_s = LAST_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF rn == 0 THEN
    LET score = score + 1
  END
  HASOBJ ghost
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI err_s "unknown"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYRENAME s0 held
  LET ok_v = OK
  LET err_s = LAST_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS HASI err_s "redefine"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ s0
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RENAMEOBJ SOFT s0 s1
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ s1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF s1 load
  IF LAST_N == 4 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "soft_rn ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_rn score"
    FAIL "soft_rn score"
    CLEAR_ERR
  END
  SYS CAT "soft_rn:" rn ":sr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_rn:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score rn note_msg
  CLEAR_ERR
END

# soft_sw — miss one side + aliases
SYS EQS op "soft_sw"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot p
  SETF p load 8
  NEW FleetSlot b
  SETF b load 1
  CLEAR_ERR
  TRYSWAP p missing_zz
  LET ok_v = OK
  LET sw = TRYSWAP_N
  LET err_s = LAST_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF sw == 0 THEN
    LET score = score + 1
  END
  SYS HASI err_s "unknown"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF p load
  IF LAST_N == 8 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSWAP p b
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF p load
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF b load
  IF LAST_N == 8 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SOFTSWAP p WITH b
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore-ish check primary-ish load back
  GETF p load
  IF LAST_N == 8 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSWAP p p
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "soft_sw ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_sw score"
    FAIL "soft_sw score"
    CLEAR_ERR
  END
  SYS CAT "soft_sw:" sw ":ss"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_sw:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score sw note_msg
  CLEAR_ERR
END

# redef — soft rename to taken name; soft move AS
SYS EQS op "redef"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot a
  SETF a load 6
  NEW FleetSlot taken
  CLEAR_ERR
  TRYRENAME a taken
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ a
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SOFTRENAME a a2
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ a
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ a2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MOVEOBJ SOFT a2 AS a3
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ a3
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYMOVEOBJ a3 TO a4
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF a4 load
  IF LAST_N == 6 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYRENAME a4 a4
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "redef ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "redef score"
    FAIL "redef score"
    CLEAR_ERR
  END
  SYS CAT "redef:1:rd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "redef:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot f0
  TRYRENAME f0 f1
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW FleetSlot f2
  SETF f2 load 2
  TRYSWAP f1 f2
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "TRYRENAME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "TRYSWAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "RENAMEOBJ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SWAPOBJ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ f1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ f2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  SYS HAS LAST "TRYRENAME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — promote canary + flip roles pipeline
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot canary
  SETF canary load 11
  NEW FleetSlot primary
  SETF primary load 20
  NEW FleetSlot backup
  SETF backup load 3
  CLEAR_ERR
  TRYRENAME canary live
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ live
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSWAP primary backup
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF primary load
  IF LAST_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss must not block gate recovery
  TRYSWAP primary missing_slot
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETF primary load
  IF LAST_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  SYS HAS LAST "svc-trs"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · TRYRENAME_N capture
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetSlot p0
  TRYRENAME p0 p1
  LET rn = TRYRENAME_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rn == 1 THEN
    LET score = score + 1
  END
  HASOBJ p1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW FleetSlot q0
  SETF q0 load 2
  TRYSWAP p1 q0
  LET sw = TRYSWAP_N
  CLEAR_ERR
  IF sw == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  SYS HAS LAST "TRYSWAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS LAST "slot_flip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend
  HASOBJ p
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYRENAME missing_z zz
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = rn
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score rn sw note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " rn=" rn " sw=" sw
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "trs report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
