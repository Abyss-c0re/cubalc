# release_stage_board.cubalc — release stage/mirror via COPYALL + MKDIRALL
#
# Real use: CI/release agent stages artifact bags into a dest dir (or
# multi-dir plate tree) without EACH+COPY/MKDIR glue. PATHGLOB→KEEPFILES
# inventory; MKDIRALL ensures stage/lease directory trees; COPYALL bulk
# copies basenames into dest (snapshot/mirror). Distinct from
# cache_reclaim_board (RMALL GC) and build_pathglob_board (inventory only):
# this board is bulk stage-out with mkdir ensure.
#
# Plate under STATE:
#   PATHS.txt          — source path bag
#   STAGED.txt         — last COPYALL dest paths (COPYALL bag)
#   DIRS.txt           — last MKDIRALL targets
#   STAGE_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_RS_ACTION):
#   list      — depths (default)
#   scan      — PATHGLOB DIR PAT → PATHS
#   files     — KEEPFILES PATHS
#   dest      — set DEST dir (ARG1/ENV); default STATE/stage
#   mkdirs    — MKDIRALL DIRS bag (ARG1 ||| paths) or DEST alone
#   stage     — COPYALL PATHS DEST → STAGED
#   has       — HASLINE exact on PATHS
#   hasdst    — HASLINE exact on STAGED
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rs_$$; mkdir -p "$CUBALC_STATE/out"
#   # drop fixtures into out/
#   CUBALC_RS_DIR=$CUBALC_STATE/out CUBALC_ARG0=scan CUBALC_ARG1='*' \
#     ./out/cubalc run -q -s programs/realworld/release_stage_board.cubalc
#   CUBALC_ARG0=files ./out/cubalc run -q -s ...
#   CUBALC_ARG0=dest CUBALC_ARG1=$CUBALC_STATE/stage ./out/cubalc run -q -s ...
#   CUBALC_ARG0=mkdirs ./out/cubalc run -q -s ...
#   CUBALC_ARG0=stage ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_RS_DIR=…  CUBALC_RS_PAT=*  CUBALC_RS_DEST=…  CUBALC_RS_REQUIRE=1
#
# Edges deliberately stressed:
#   COPYALL basenames only into dest (no preserve relative tree)
#   dirs in bag → COPYALL_FAIL; ghost → MISS; OK=0 partial
#   MKDIRALL over file path fails soft
#   COPYALL overwrites? same basename collision
#   WRITE NL; PRINT_JSON; soft READ; REQUIRE empty

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "release_stage_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT PFILE = "PATHS.txt"
DEFAULT SFILE = "STAGED.txt"
DEFAULT DFILE = "DIRS.txt"
DEFAULT DESTFILE = "DEST.txt"
DEFAULT REPORT = "STAGE_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT PAT = "*"
DEFAULT DIR = ""
DEFAULT DEST = ""
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_RS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_RS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_RS_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_RS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_RS_PAT" OR ""
IF LAST_N > 0 THEN
  LET PAT = LAST
END
SYS ENV "CUBALC_RS_DIR" OR ""
IF LAST_N > 0 THEN
  LET DIR = LAST
END
SYS ENV "CUBALC_RS_DEST" OR ""
IF LAST_N > 0 THEN
  LET DEST = LAST
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS BLANK DIR
IF LAST_N == 1 THEN
  LET DIR = state_dir
END
SYS JOIN state_dir PFILE
LET paths_path = LAST
SYS JOIN state_dir SFILE
LET staged_path = LAST
SYS JOIN state_dir DFILE
LET dirs_path = LAST
SYS JOIN state_dir DESTFILE
LET dest_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR paths_path OR ""
LET paths = LAST
CLEAR_ERR
SYS READ OR staged_path OR ""
LET staged = LAST
CLEAR_ERR
SYS READ OR dirs_path OR ""
LET dirs = LAST
CLEAR_ERR
SYS READ OR dest_path OR ""
LET dest_stored = LAST
CLEAR_ERR
SYS BLANK DEST
IF LAST_N == 1 THEN
  SYS BLANK dest_stored
  IF LAST_N == 0 THEN
    LET DEST = dest_stored
  ELSE
    SYS JOIN state_dir "stage"
    LET DEST = LAST
  END
END

LET hit = 0
LET miss = 0
LET paths_ch = 0
LET staged_ch = 0
LET dirs_ch = 0
LET dest_ch = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET pglob_n = 0
LET keep_n = 0
LET drop_n = 0
LET copy_n = 0
LET copy_miss = 0
LET copy_fail = 0
LET copy_bytes = 0
LET mkdir_n = 0
LET mkdir_fail = 0

SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET PAT = NAME
  END
END
SYS EQS ACTION "dest"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET DEST = NAME
  END
END
SYS EQS ACTION "mkdirs"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    # ARG1 as ||| dir list
    SYS SPLIT "|||" NAME
    LET dirs = LAST
    LET dirs_ch = 1
  END
END
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs path"
  END
END
SYS EQS ACTION "hasdst"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "hasdst needs path"
  END
END

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS LINES paths
  LET np = LAST_N
  SYS LINES staged
  LET ns = LAST_N
  SYS LINES dirs
  LET nd = LAST_N
  CLEAR_ERR
  STATUS
  PRINT "rstage" np ns nd DEST ACTION
  PRINT_JSON np ns nd DEST ACTION STATUS_OK
  PRINT_JSON paths
  PRINT_JSON staged
  PRINT_JSON dirs
  LET note_msg = "list ok"
END

# --- scan ---
SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  NOTE "action scan"
  SYS PATHGLOB DIR PAT
  IF OK == 0 THEN
    LET miss = 1
    LET paths = ""
    LET paths_ch = 1
    LET note_msg = "scan miss"
    FAIL "scan miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "scan miss"
    END
  ELSE
    LET paths = LAST
    LET pglob_n = PATHGLOB_N
    LET paths_ch = 1
    LET hit = pglob_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "scan empty"
      FAIL "scan empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "scan empty"
      END
    ELSE
      LET note_msg = "scan ok"
    END
    PRINT_JSON PAT pglob_n
    PRINT_JSON paths
  END
END

# --- files ---
SYS EQS ACTION "files"
IF LAST_N == 1 THEN
  NOTE "action files"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "files empty"
    FAIL "files empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "files empty"
    END
  ELSE
    SYS KEEPFILES paths
    LET paths = LAST
    LET keep_n = KEEPFILES_N
    LET drop_n = KEEPFILES_DROP
    LET paths_ch = 1
    LET hit = keep_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "files none"
      FAIL "files none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "files none"
      END
    ELSE
      LET note_msg = "files ok"
    END
    PRINT_JSON keep_n drop_n
    PRINT_JSON paths
  END
END

# --- dest ---
SYS EQS ACTION "dest"
IF LAST_N == 1 THEN
  NOTE "action dest"
  SYS BLANK DEST
  IF LAST_N == 1 THEN
    EXIT 2 "dest needs path"
  END
  LET dest_stored = DEST
  LET dest_ch = 1
  LET hit = 1
  LET val_s = DEST
  LET note_msg = "dest ok"
  PRINT_JSON DEST
END

# --- mkdirs ---
SYS EQS ACTION "mkdirs"
IF LAST_N == 1 THEN
  NOTE "action mkdirs"
  SYS BLANK dirs
  IF LAST_N == 1 THEN
    # default: ensure DEST only
    SYS PUSH "" DEST
    LET dirs = LAST
    LET dirs_ch = 1
  END
  SYS BLANK dirs
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "mkdirs empty"
    FAIL "mkdirs empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "mkdirs empty"
    END
  ELSE
    SYS MKDIRALL dirs
    LET made = LAST
    LET mkdir_n = MKDIRALL_N
    LET mkdir_fail = MKDIRALL_FAIL
    LET hit = mkdir_n
    LET dirs = made
    LET dirs_ch = 1
    IF mkdir_n == 0 THEN
      LET miss = 1
      LET note_msg = "mkdirs none"
      FAIL "mkdirs none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "mkdirs none"
      END
    ELSE
      LET note_msg = "mkdirs ok"
    END
    PRINT_JSON mkdir_n mkdir_fail DEST
    PRINT_JSON dirs
    CLEAR_ERR
  END
END

# --- stage COPYALL ---
SYS EQS ACTION "stage"
IF LAST_N == 1 THEN
  NOTE "action stage"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "stage empty"
    FAIL "stage empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stage empty"
    END
  ELSE
    SYS BLANK DEST
    IF LAST_N == 1 THEN
      EXIT 2 "stage needs dest"
    END
    # ensure dest dir exists
    SYS MKDIR DEST
    CLEAR_ERR
    SYS COPYALL paths DEST
    LET staged = LAST
    LET copy_n = COPYALL_N
    LET copy_miss = COPYALL_MISS
    LET copy_fail = COPYALL_FAIL
    LET copy_bytes = COPYALL_BYTES
    LET hit = copy_n
    LET staged_ch = 1
    IF copy_n == 0 THEN
      LET miss = 1
      LET note_msg = "stage none"
      FAIL "stage none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "stage none"
      END
    ELSE
      LET note_msg = "stage ok"
    END
    PRINT_JSON copy_n copy_miss copy_fail copy_bytes DEST
    PRINT_JSON staged
    CLEAR_ERR
  END
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS HASLINE paths NAME
  LET val_n = LAST_N
  LET hit = val_n
  IF val_n == 0 THEN
    LET miss = 1
    LET note_msg = "has miss"
    FAIL "has miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has miss"
    END
  ELSE
    LET note_msg = "has ok"
  END
  PRINT_JSON val_n NAME
END

# --- hasdst ---
SYS EQS ACTION "hasdst"
IF LAST_N == 1 THEN
  NOTE "action hasdst"
  SYS HASLINE staged NAME
  LET val_n = LAST_N
  LET hit = val_n
  IF val_n == 0 THEN
    LET miss = 1
    LET note_msg = "hasdst miss"
    FAIL "hasdst miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "hasdst miss"
    END
  ELSE
    LET note_msg = "hasdst ok"
  END
  PRINT_JSON val_n NAME
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET paths = ""
  LET staged = ""
  LET dirs = ""
  LET paths_ch = 1
  LET staged_ch = 1
  LET dirs_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "scan"
LET k = k + LAST_N
SYS EQS ACTION "files"
LET k = k + LAST_N
SYS EQS ACTION "dest"
LET k = k + LAST_N
SYS EQS ACTION "mkdirs"
LET k = k + LAST_N
SYS EQS ACTION "stage"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "hasdst"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF paths_ch > 0 THEN
  SYS WRITE paths_path paths
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "paths write failed"
  END
  CLEAR_ERR
END
IF staged_ch > 0 THEN
  SYS WRITE staged_path staged
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "staged write failed"
  END
  CLEAR_ERR
END
IF dirs_ch > 0 THEN
  SYS WRITE dirs_path dirs
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "dirs write failed"
  END
  CLEAR_ERR
END
IF dest_ch > 0 THEN
  SYS WRITE dest_path dest_stored
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "dest write failed"
  END
  CLEAR_ERR
END

SYS LINES paths
LET depth_p = LAST_N
SYS LINES staged
LET depth_s = LAST_N
SYS LINES dirs
LET depth_d = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.release_stage.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "dest"
LET report = LAST
SYS PUSH report DEST
LET report = LAST
SYS PUSH report "dir"
LET report = LAST
SYS PUSH report DIR
LET report = LAST
SYS PUSH report "copy_n"
LET report = LAST
SYS STR copy_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "copy_miss"
LET report = LAST
SYS STR copy_miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "copy_fail"
LET report = LAST
SYS STR copy_fail
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "copy_bytes"
LET report = LAST
SYS STR copy_bytes
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "mkdir_n"
LET report = LAST
SYS STR mkdir_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "mkdir_fail"
LET report = LAST
SYS STR mkdir_fail
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_p"
LET report = LAST
SYS STR depth_p
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_s"
LET report = LAST
SYS STR depth_s
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_d"
LET report = LAST
SYS STR depth_d
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "release_stage_board" ACTION hit miss copy_n mkdir_n note_msg elapsed
PRINT_JSON ACTION hit miss copy_n copy_miss copy_fail copy_bytes mkdir_n mkdir_fail depth_p depth_s note_msg STATUS_OK
NOTE "release_stage_board: done"
