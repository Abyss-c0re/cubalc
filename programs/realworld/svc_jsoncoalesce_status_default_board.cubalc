# svc_jsoncoalesce_status_default_board.cubalc — JSONCOALESCE/JSONNVL status default
#
# Real use: multi-vendor intake peels a *usable* status/id value when early
# candidate keys exist but are blank/null (JSONHITVAL would return ""). Soft
# dual of JSONHITVAL that skips empty; OR/DEFAULT supplies fallback. First
# realworld of SYS JSONCOALESCE/JSONNVL (1.15.961 · MI 961 · proof 1501).
#
#   JSONCOALESCE · JSONNVL · JCOALESCE · JSONCOALESCE_N · JSONCOALESCE_HIT
#   JSONCOALESCE_KEY · OF bag · OR/DEFAULT · null/"" skip · 0/false keep
#
# Dual (challenge):
#   JSONHITVAL first *present* key (may be empty string)
#   JSONCOALESCE first *non-empty* value among candidates
#   whitespace-only may skip; false→"0" and 0 have substance
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_jco_$$
#   ./out/cubalc run programs/realworld/svc_jsoncoalesce_status_default_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt JCO_REPORT.txt agent.json plates/*
# Env: HOST_S ROLE_S CUBALC_JCO_REQUIRE

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# peel first non-empty status value; OR unknown
FN peel_status_coalesce
  LET val = ""
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JSONCOALESCE plate "status" "state" "legacy_status" "phase" OR "unknown"
  LET val = LAST
  LET hit_key = JSONCOALESCE_KEY
  LET hit_idx = JSONCOALESCE_N
  IF JSONCOALESCE_HIT == 1 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# peel first non-empty identity value
FN peel_id_coalesce
  LET val = ""
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JSONCOALESCE plate "id" "uuid" "agent_id" "name" OR ""
  LET val = LAST
  LET hit_key = JSONCOALESCE_KEY
  LET hit_idx = JSONCOALESCE_N
  IF JSONCOALESCE_HIT == 1 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# JSONNVL alias path
FN peel_status_nvl
  LET val = ""
  LET hit_key = ""
  LET ok_v = 0
  SYS JSONNVL plate "status" "state" "legacy_status" "phase" OR "unknown"
  LET val = LAST
  LET hit_key = JSONCOALESCE_KEY
  IF JSONCOALESCE_HIT == 1 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# OF-bag coalesce
FN peel_status_ofbag
  LET val = ""
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JOIN "" "phase\nstate\nlegacy_status\nstatus"
  LET kbag = LAST
  SYS JSONCOALESCE plate OF kbag OR "unknown"
  LET val = LAST
  LET hit_key = JSONCOALESCE_KEY
  LET hit_idx = JSONCOALESCE_N
  IF JSONCOALESCE_HIT == 1 THEN
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# admit when coalesced status is ready/ok/live (not unknown default)
FN admit_ready
  LET state = "deny-status"
  LET ok_v = 0
  CALL peel_status_coalesce
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS val "live"
  IF LAST_N == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS val "unknown"
  IF LAST_N == 1 THEN
    LET state = "deny-default"
    LET ok_v = 0
  END
  CLEAR_ERR
END

# dual: HITVAL may bind empty first present key
FN hitval_status
  LET val = ""
  LET hit_key = ""
  LET ok_v = 0
  SYS JSONHITVAL plate "status" "state" "legacy_status" "phase"
  IF JSONHITVAL_HIT == 1 THEN
    LET val = LAST
    LET hit_key = JSONHITVAL_KEY
    LET ok_v = 1
  END
END

NOTE "svc_jsoncoalesce_status_default_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_jsoncoalesce_status_default -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_JCO_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JCO_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "intake.json"
LET intake_path = LAST
SYS JOIN plate_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET plate = ""
LET hit_key = ""
LET hit_idx = 0
LET val = ""
LET state = ""
LET saved = 0
LET kbag = ""
LET id_val = ""
LET hv_val = ""
LET hv_key = ""

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-jco\",\"schema\":\"cubalc.svc_jsoncoalesce_status_default.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"jco\",\"want_filter\":\"jsoncoalesce_status_default\",\"cfg\":{\"surface\":\"JSONCOALESCE,JSONNVL,JCOALESCE,JSONCOALESCE_N,JSONCOALESCE_HIT,JSONCOALESCE_KEY,JSONHITVAL\",\"contract\":\"first non-empty status/id peel with OR default (skip blank; dual of JSONHITVAL)\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  # blank status first, usable legacy
  SYS CAT "{\"status\":\"\",\"legacy_status\":\"ok\",\"agent_id\":\"w-9\",\"code\":0}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE intake_path body
  CLEAR_ERR
  SYS CAT "{\"uuid\":\"u-1\",\"state\":\"\",\"phase\":\"ready\",\"n\":1}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_status_coalesce
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jco"
  IF LAST_N == 1 THEN
    SYS EQS val "ok"
    IF LAST_N == 1 THEN
      SYS EQS hit_key "legacy_status"
      IF LAST_N == 1 THEN
        IF hit_idx == 3 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET score = 1
          LET find_n = hit_idx
        ELSE
          LET miss = 1
          LET note_msg = "boot idx"
          FAIL "boot idx"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot key"
        FAIL "boot key"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot val"
      FAIL "boot val"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core 10/10 coalesce vs hitval dual
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # blank status skipped → legacy ok
  LET plate = "{\"status\":\"\",\"legacy_status\":\"ok\",\"code\":0}"
  CALL peel_status_coalesce
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  # HITVAL dual: first present empty
  CALL hitval_status
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EMPTY val
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # null skipped
  LET plate = "{\"status\":null,\"state\":\"ready\"}"
  CALL peel_status_coalesce
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "state"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # JSONNVL alias
  CALL peel_status_nvl
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # id coalesce uuid
  LET plate = "{\"id\":\"\",\"uuid\":\"u-1\",\"name\":\"peer\"}"
  CALL peel_id_coalesce
  SYS EQS val "u-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "uuid"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — default OR · all empty · 0/false substance · OF bag
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # all blank → default unknown, HIT 0
  LET plate = "{\"status\":\"\",\"state\":\"\"}"
  CALL peel_status_coalesce
  SYS EQS val "unknown"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF JSONCOALESCE_HIT == 0 THEN
    LET score = score + 1
  END
  CALL admit_ready
  SYS EQS state "deny-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # admit ok
  LET plate = "{\"legacy_status\":\"ok\"}"
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OF bag prefers phase when non-empty first
  LET plate = "{\"phase\":\"beta\",\"status\":\"ok\"}"
  CALL peel_status_ofbag
  SYS EQS val "beta"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "phase"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 0 has substance
  LET plate = "{\"n\":0,\"m\":5}"
  SYS JSONCOALESCE plate "n" "m"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS JSONCOALESCE_KEY "n"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # false has substance as 0
  LET plate = "{\"f\":false,\"t\":true}"
  SYS JSONCOALESCE plate "f" "t"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty cand + DEFAULT
  LET plate = "{\"a\":1}"
  SYS JSONCOALESCE plate OR "none"
  SYS EQS LAST "none"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — disk plates
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"status\":\"\",\"legacy_status\":\"ok\",\"agent_id\":\"w-9\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE intake_path body
  CLEAR_ERR
  SYS CAT "{\"uuid\":\"u-1\",\"state\":\"\",\"phase\":\"ready\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE peer_path body
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_status_coalesce
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_id_coalesce
  SYS EQS val "w-9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "agent_id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_status_coalesce
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "phase"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_id_coalesce
  SYS EQS val "u-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # dual hitval empty first
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL hitval_status
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EMPTY val
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "JSONCOALESCE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — admit ladder · deny default · prefer first substance
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"status\":\"live\",\"legacy_status\":\"ok\"}"
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS val "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 1 THEN
    LET score = score + 1
  END
  LET plate = "{\"status\":\"down\"}"
  CALL admit_ready
  SYS EQS state "deny-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{}"
  CALL admit_ready
  SYS EQS state "deny-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"agent_id\":\"\",\"name\":\"solo\",\"phase\":\"ok\"}"
  CALL peel_id_coalesce
  SYS EQS val "solo"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # DEFAULT keyword form
  SYS JSONCOALESCE plate "gone" DEFAULT "dflt"
  SYS EQS LAST "dflt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "non-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "JSONCOALESCE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONNVL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JCOALESCE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHITVAL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHITKEY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONCOALESCE_KEY"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONCOALESCE_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONCOALESCE_HIT"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsoncoalesce_status_default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "JSONCOALESCE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit only usable non-default status
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"status\":\"\",\"state\":\"live\"}"
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS val "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"status\":\"\",\"legacy_status\":\"\"}"
  CALL admit_ready
  SYS EQS state "deny-default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"phase\":\"down\"}"
  CALL admit_ready
  SYS EQS state "deny-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"id\":\"\",\"agent_id\":\"g2\",\"status\":\"ok\"}"
  CALL peel_id_coalesce
  SYS EQS val "g2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "OR default"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "skip blank"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk · WRITE NL · NUM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS CAT "{\"status\":\"\",\"legacy_status\":\"ok\",\"agent_id\":\"probe-1\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE intake_path body
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL peel_status_coalesce
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  LET saved = hit_idx
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 3 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "hitkey=" hit_key " val=" val " idx=" hit_idx
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "hitkey="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "jco_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "jco_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_id_coalesce
  SYS EQS val "probe-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_ready
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jco"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-jco\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit ",\"hit_key\":\"" hit_key "\",\"hit_idx\":" hit_idx ",\"val\":\"" val "\"}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n " key=" hit_key " val=" val
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_jsoncoalesce_status_default_board: done"
PASS
