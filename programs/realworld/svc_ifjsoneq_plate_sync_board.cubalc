# svc_ifjsoneq_plate_sync_board.cubalc — IFJSONEQ/IFJSONNEQ plate semantic sync
#
# Real use: mesh/replica agents admit plates when JSON content is equal
# order-independently (not byte-identical IFEQFILE). First realworld of
# 1491 IFJSONEQ/IFJSONNEQ/IFSAMEJSON (1.15.950 · MI 952). Distinct from
# svc_ifeqfile_plate_sync (byte) — this board is *JSON semantic equality
# branches for promote/resync*.
#
#   IFJSONEQ · IFJSONNEQ · IFSAMEJSON · IFJSONEQ_N · JSONEQ
#   FN-wrap · key-order dual · resync-if-neq · empty≠content
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ije_$$
#   ./out/cubalc run programs/realworld/svc_ifjsoneq_plate_sync_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IJE_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_IJE_REQUIRE
#
# Edges: key order equal; value differ; empty vs content; resync copy;
#   FN-wrap; STATUS bare; STRTO VAL

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN plates_eq
  IFJSONEQ left right
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN plates_same
  IFSAMEJSON left right
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN plates_neq
  IFJSONNEQ left right
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# resync right from left when JSON differs
FN resync_if_neq
  LET state = "skip-same"
  LET ok_v = 0
  CALL plates_neq
  IF ok_v == 1 THEN
    LET right = left
    LET state = "resynced"
    LET ok_v = 1
  END
END

# admit only when semantic equal
FN admit_synced
  LET state = "deny-drift"
  LET ok_v = 0
  CALL plates_eq
  IF ok_v == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
END

NOTE "svc_ifjsoneq_plate_sync_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ifjsoneq_plate_sync -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IJE_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IJE_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "local.json"
LET local_path = LAST
SYS JOIN plate_dir "replica.json"
LET replica_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET left = ""
LET right = ""
LET state = ""
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ije\",\"schema\":\"cubalc.svc_ifjsoneq_plate_sync.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ije\",\"want_filter\":\"ifjsoneq_plate_sync\",\"cfg\":{\"surface\":\"IFJSONEQ,IFJSONNEQ,IFSAMEJSON,IFJSONEQ_N,JSONEQ\",\"contract\":\"JSON semantic plate equality for promote/resync\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE local_path "{\"ok\":1,\"n\":2}"
  SYS WRITE replica_path "{\"n\":2,\"ok\":1}"
  CLEAR_ERR
  SYS READ local_path
  LET left = LAST
  SYS READ replica_path
  LET right = LAST
  CLEAR_ERR
  CALL plates_eq
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ije"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFJSONEQ_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = JSONEQ
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot eq"
      FAIL "boot eq"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET left = "{\"ok\":1,\"n\":2}"
  LET right = "{\"n\":2,\"ok\":1}"
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFJSONEQ_N == 1 THEN
    LET score = score + 1
  END
  IF JSONEQ == 1 THEN
    LET score = score + 1
  END
  CALL plates_same
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL plates_neq
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET right = "{\"ok\":1,\"n\":3}"
  CALL plates_eq
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF JSONEQ == 0 THEN
    LET score = score + 1
  END
  CALL plates_neq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFJSONNEQ_N == 1 THEN
    LET score = score + 1
  END
  LET right = "{}"
  CALL plates_eq
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — resync · admit · empty
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET left = "{\"ok\":1,\"n\":2}"
  LET right = "{\"ok\":1,\"n\":9}"
  CALL admit_synced
  SYS EQS state "deny-drift"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resync_if_neq
  SYS EQS state "resynced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL resync_if_neq
  SYS EQS state "skip-same"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET left = "{}"
  LET right = "{}"
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET right = "{\"x\":1}"
  CALL plates_neq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL resync_if_neq
  SYS EQS state "resynced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL plates_same
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi plate class
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE local_path "{\"k\":\"a\",\"n\":1}"
  SYS WRITE replica_path "{\"n\":1,\"k\":\"a\"}"
  CLEAR_ERR
  SYS READ local_path
  LET left = LAST
  SYS READ replica_path
  LET right = LAST
  CLEAR_ERR
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE replica_path "{\"k\":\"a\",\"n\":2}"
  CLEAR_ERR
  SYS READ replica_path
  LET right = LAST
  CLEAR_ERR
  CALL plates_neq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL admit_synced
  SYS EQS state "deny-drift"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resync_if_neq
  SYS EQS state "resynced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL plates_same
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET left = "{\"x\":1}"
  LET right = "{\"x\":1}"
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifjsoneq_plate_sync"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — admit-drift-heal ladder
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET left = "{\"rev\":1,\"stage\":\"alpha\"}"
  LET right = "{\"stage\":\"alpha\",\"rev\":1}"
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET right = "{\"rev\":2,\"stage\":\"beta\"}"
  CALL admit_synced
  SYS EQS state "deny-drift"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL plates_neq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL resync_if_neq
  SYS EQS state "resynced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET left = "{\"rev\":3}"
  CALL plates_eq
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL resync_if_neq
  SYS EQS state "resynced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL plates_same
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFJSONEQ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFJSONEQ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFJSONNEQ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFSAMEJSON"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "WHENJSONEQ"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENJSONNEQ"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFJSONEQ_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONEQ"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifjsoneq_plate_sync"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFJSONEQ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFJSONNEQ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit only when equal; resync then admit
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET left = "{\"gate\":1,\"site\":\"a\"}"
  LET right = "{\"site\":\"a\",\"gate\":1}"
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET right = "{\"gate\":99}"
  CALL admit_synced
  SYS EQS state "deny-drift"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resync_if_neq
  SYS EQS state "resynced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET left = "{}"
  LET right = "{}"
  CALL admit_synced
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET right = "{\"x\":1}"
  CALL admit_synced
  SYS EQS state "deny-drift"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL plates_neq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL plates_same
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "semantic"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk · WRITE NL · NUM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE local_path "{\"probe\":1,\"n\":7}"
  SYS WRITE replica_path "{\"n\":7,\"probe\":1}"
  CLEAR_ERR
  SYS READ local_path
  LET left = LAST
  SYS READ replica_path
  LET right = LAST
  CLEAR_ERR
  CALL plates_eq
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF JSONEQ == 1 THEN
    LET score = score + 1
  END
  LET saved = IFJSONEQ_N
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "jsoneq=" JSONEQ " n=" IFJSONEQ_N
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsoneq="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "ije_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "ije_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ije"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ije\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_ifjsoneq_plate_sync_board: done"
