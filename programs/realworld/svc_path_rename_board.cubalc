# svc_path_rename_board.cubalc — path RENAMEP/COPYP/SWAPP config migrate plane
#
# Real use: ops agents restructure nested service config (port→listen, flag
# mirror, canary swap) without GETP+DELP+SETP glue. First realworld of proof
# 1200 path rename/copy/swap (+ soft miss, multi-plate FROM PEER).
#
#   RENAMEP|MOVEKEYP path path · COPYP|DUPKEYP · SWAPP|XCHGP
#   soft miss n=0 · slash path · FROM PEER · SAVEPLATE
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_spr_$$
#   ./out/cubalc run programs/realworld/svc_path_rename_board.cubalc boot
#   ./out/cubalc run ... rename|copy|swap|soft|peer|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SPR_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SPR_REQUIRE
#
# Edges:
#   soft miss rename/copy; false-friend paths; WRITE NL; NUM softens REQUIRE;
#   EXIT shell (W7); RENAMEP_N/COPYP_N specials vs LAST_N

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_path_rename_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_path_rename -- boot|rename|copy|swap|soft|peer|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeX"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SPR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SPR_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET path_val = ""

ONEOF ACTION "boot", "rename", "copy", "swap", "soft", "peer", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "rename" THEN
    LET op = "rename"
  WHEN "copy" THEN
    LET op = "copy"
  WHEN "swap" THEN
    LET op = "swap"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — seed nested cfg/flags for migrate plane
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-rename\",\"schema\":\"cubalc.svc_path_rename.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"n\":1,\"cfg\":{\"port\":8080,\"tls\":0,\"retries\":3},\"flags\":{\"debug\":0,\"trace\":1,\"live\":1},\"meta\":{\"role\":\"" role_s "\",\"zone\":\"east\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"schema\":\"cubalc.svc_path_rename.v1\",\"cfg\":{\"port\":9090,\"tls\":1},\"flags\":{\"debug\":1,\"trace\":0},\"meta\":{\"role\":\"edge\",\"n\":9},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  HASP "cfg.port"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  LET load_hit = LAST_N
  CLEAR_ERR
  HASP "flags.trace"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "flags.trace"
  SYS EQS LAST "1"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET take_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "boot trace val"
          FAIL "boot trace val"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot has trace"
        FAIL "boot has trace"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot port val"
      FAIL "boot port val"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot has port"
    FAIL "boot has port"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

# rename — path→path + cross-nest move + slash
SYS EQS op "rename"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # cfg.port → cfg.listen
  RENAMEP "cfg.port" "cfg.listen"
  CLEAR_ERR
  GETP "cfg.listen"
  SYS EQS LAST "8080"
  LET peel_hit = LAST_N
  CLEAR_ERR
  HASP "cfg.port"
  LET miss_n = LAST_N
  CLEAR_ERR
  # cross-nest: cfg.tls → net.tls
  RENAMEP "cfg.tls" "net.tls"
  CLEAR_ERR
  GETP "net.tls"
  SYS EQS LAST "0"
  LET load_hit = LAST_N
  CLEAR_ERR
  HASP "cfg.tls"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # slash path rename
  RENAMEP "cfg/retries" "cfg/retry_n"
  CLEAR_ERR
  GETP "cfg.retry_n"
  SYS EQS LAST "3"
  LET has_n = LAST_N
  CLEAR_ERR
  HASP "cfg.retries"
  LET gate_ok = LAST_N
  CLEAR_ERR
  # false friend: must not still have cfg.port after rename
  HASP "cfg.por"
  LET path_val = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF miss_n == 0 THEN
      IF load_hit == 1 THEN
        IF soft_ok == 0 THEN
          IF has_n == 1 THEN
            IF gate_ok == 0 THEN
              IF path_val == 0 THEN
                LET hit = 1
                LET note_msg = "rename ok"
                LET admit_n = 1
                LET take_n = 3
              ELSE
                LET miss = 1
                LET note_msg = "rename false por"
                FAIL "rename false por"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "rename slash src gone"
              FAIL "rename slash src gone"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "rename slash retry"
            FAIL "rename slash retry"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "rename tls src"
          FAIL "rename tls src"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "rename net.tls"
        FAIL "rename net.tls"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "rename port gone"
      FAIL "rename port gone"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "rename listen"
    FAIL "rename listen"
    CLEAR_ERR
  END
  SYS CAT "rename:listen:rn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "rename:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit has_n note_msg
  CLEAR_ERR
END

# copy — path copy keep src + soft miss
SYS EQS op "copy"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # need live flags (boot seed); after rename plate still has flags
  COPYP "flags.trace" "flags.mirror"
  CLEAR_ERR
  GETP "flags.mirror"
  SYS EQS LAST "1"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "flags.trace"
  SYS EQS LAST "1"
  LET load_hit = LAST_N
  CLEAR_ERR
  HASP "flags.trace"
  LET soft_ok = LAST_N
  CLEAR_ERR
  COPYP "flags.debug" "flags.verbose"
  CLEAR_ERR
  GETP "flags.verbose"
  SYS EQS LAST "0"
  LET has_n = LAST_N
  CLEAR_ERR
  # soft miss copy
  COPYP "flags.nope" "flags.x"
  CLEAR_ERR
  HASP "flags.x"
  LET miss_n = LAST_N
  CLEAR_ERR
  # false friend substring
  HASP "flags.mir"
  LET path_val = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 0 THEN
            IF path_val == 0 THEN
              LET hit = 1
              LET note_msg = "copy ok"
              LET admit_n = 1
              LET take_n = 2
            ELSE
              LET miss = 1
              LET note_msg = "copy false mir"
              FAIL "copy false mir"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "copy soft miss created"
            FAIL "copy soft miss created"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "copy verbose"
          FAIL "copy verbose"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "copy src keep"
        FAIL "copy src keep"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "copy trace keep"
      FAIL "copy trace keep"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "copy mirror"
    FAIL "copy mirror"
    CLEAR_ERR
  END
  SYS CAT "copy:mirror:cp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "copy:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit miss_n note_msg
  CLEAR_ERR
END

# swap — exchange nest flags
SYS EQS op "swap"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # after copy: debug=0 trace=1 (or swapped already) — force known state
  SETP "flags.debug" 0
  CLEAR_ERR
  SETP "flags.trace" 1
  CLEAR_ERR
  GETP "flags.debug"
  SYS EQS LAST "0"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "flags.trace"
  SYS EQS LAST "1"
  LET load_hit = LAST_N
  CLEAR_ERR
  SWAPP "flags.debug" "flags.trace"
  CLEAR_ERR
  GETP "flags.debug"
  SYS EQS LAST "1"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "flags.trace"
  SYS EQS LAST "0"
  LET has_n = LAST_N
  CLEAR_ERR
  # slash swap of other pair if present
  HASP "flags.live"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF gate_ok == 1 THEN
    GETP "flags.live"
    LET path_val = LAST
    CLEAR_ERR
    SWAPP "flags/live" "flags/debug"
    CLEAR_ERR
    GETP "flags.live"
    SYS EQS LAST "1"
    LET admit_n = LAST_N
    CLEAR_ERR
    GETP "flags.debug"
    SYS EQS LAST path_val
    LET miss_n = LAST_N
    CLEAR_ERR
  ELSE
    LET admit_n = 1
    LET miss_n = 1
  END
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF admit_n == 1 THEN
            IF miss_n == 1 THEN
              LET hit = 1
              LET note_msg = "swap ok"
              LET admit_n = 1
              LET take_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "swap slash debug"
              FAIL "swap slash debug"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "swap slash live"
            FAIL "swap slash live"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "swap trace after"
          FAIL "swap trace after"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "swap debug after"
        FAIL "swap debug after"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "swap pre trace"
      FAIL "swap pre trace"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "swap pre debug"
    FAIL "swap pre debug"
    CLEAR_ERR
  END
  SYS CAT "swap:flags:sw"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "swap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok has_n admit_n note_msg
  CLEAR_ERR
END

# soft — miss rename/copy n=0 no create
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEP "missing.path" "other.place"
  CLEAR_ERR
  HASP "other.place"
  LET peel_hit = LAST_N
  CLEAR_ERR
  HASP "missing.path"
  LET load_hit = LAST_N
  CLEAR_ERR
  COPYP "flags.ghost" "flags.spawn"
  CLEAR_ERR
  HASP "flags.spawn"
  LET soft_ok = LAST_N
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET has_n = LAST_N
  CLEAR_ERR
  # false friend
  HASP "flags.gho"
  LET miss_n = LAST_N
  CLEAR_ERR
  TYPEP "missing.path"
  SYS EQS LAST "missing"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF peel_hit == 0 THEN
    IF load_hit == 0 THEN
      IF soft_ok == 0 THEN
        IF has_n == 0 THEN
          IF miss_n == 0 THEN
            IF gate_ok == 1 THEN
              LET hit = 1
              LET note_msg = "soft ok"
              LET admit_n = 1
              LET take_n = 0
            ELSE
              LET miss = 1
              LET note_msg = "soft type missing"
              FAIL "soft type missing"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft false gho"
            FAIL "soft false gho"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft empty bag"
          FAIL "soft empty bag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft copy spawn"
        FAIL "soft copy spawn"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft has missing"
      FAIL "soft has missing"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft has other"
    FAIL "soft has other"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:miss0:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok gate_ok note_msg
  CLEAR_ERR
END

# peer — RENAMEP/COPYP FROM PEER path
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP FROM PEER "cfg.port"
  SYS EQS LAST "9090"
  LET peel_hit = LAST_N
  CLEAR_ERR
  RENAMEP FROM PEER "cfg.port" "cfg.listen"
  CLEAR_ERR
  GETP FROM PEER "cfg.listen"
  SYS EQS LAST "9090"
  LET load_hit = LAST_N
  CLEAR_ERR
  HASP FROM PEER "cfg.port"
  LET soft_ok = LAST_N
  CLEAR_ERR
  COPYP FROM PEER "flags.debug" "flags.mirror"
  CLEAR_ERR
  GETP FROM PEER "flags.mirror"
  SYS EQS LAST "1"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "flags.debug"
  SYS EQS LAST "1"
  LET gate_ok = LAST_N
  CLEAR_ERR
  # local plate not renamed for peer-only ops
  GETP "role"
  SYS EQS LAST role_s
  LET admit_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 0 THEN
        IF has_n == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "peer ok"
              LET admit_n = 1
              LET take_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "peer plate role"
              FAIL "peer plate role"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer copy src"
            FAIL "peer copy src"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer mirror"
          FAIL "peer mirror"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer port gone"
        FAIL "peer port gone"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer listen"
      FAIL "peer listen"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer port pre"
    FAIL "peer port pre"
    CLEAR_ERR
  END
  SYS CAT "peer:listen:pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit has_n note_msg
  CLEAR_ERR
END

# gate — post-migrate contract HASP/NEEDP path
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # after rename: expect cfg.listen (or port if rename not run — require listen OR port)
  HASP "cfg.listen"
  LET peel_hit = LAST_N
  CLEAR_ERR
  HASP "cfg.port"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    LET soft_ok = 1
  ELSE
    IF load_hit == 1 THEN
      LET soft_ok = 1
    ELSE
      LET soft_ok = 0
    END
  END
  CLEAR_ERR
  HASP "flags.trace"
  LET has_n = LAST_N
  CLEAR_ERR
  HASP "host"
  LET gate_ok = LAST_N
  CLEAR_ERR
  NEEDP "schema" "role" "n"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET admit_n = 0
  END
  CLEAR_ERR
  # false friend
  HASP "cfg.list"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF soft_ok == 1 THEN
    IF has_n == 1 THEN
      IF gate_ok == 1 THEN
        IF admit_n == 1 THEN
          IF miss_n == 0 THEN
            LET hit = 1
            LET note_msg = "gate ok"
            LET admit_n = 1
            LET take_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "gate false list"
            FAIL "gate false list"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate needp"
          FAIL "gate needp"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate host"
        FAIL "gate host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate flags.trace"
      FAIL "gate flags.trace"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate listen/port"
    FAIL "gate listen/port"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok has_n admit_n note_msg
  CLEAR_ERR
END

# probe — MOVEKEYP/DUPKEYP/XCHGP aliases + empty bag + DEFAULTP
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET load_hit = LAST_N
  CLEAR_ERR
  # alias MOVEKEYP
  DEFAULTP "cfg.alt" 1
  CLEAR_ERR
  MOVEKEYP "cfg.alt" "cfg.alt2"
  CLEAR_ERR
  HASP "cfg.alt2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  HASP "cfg.alt"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # DUPKEYP alias
  DUPKEYP "n" "n_copy"
  CLEAR_ERR
  GETP "n_copy"
  SYS EQS LAST "1"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "1"
  LET gate_ok = LAST_N
  CLEAR_ERR
  # XCHGP alias on n and n_copy (same value — still swap ok)
  XCHGP "n" "n_copy"
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "1"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS HAS LAST "svc-rename"
  LET miss_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF load_hit == 0 THEN
    IF peel_hit == 1 THEN
      IF soft_ok == 0 THEN
        IF has_n == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              IF miss_n == 1 THEN
                LET hit = 1
                LET note_msg = "probe ok"
                LET admit_n = 1
                LET take_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "probe agent"
                FAIL "probe agent"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe xchgp"
              FAIL "probe xchgp"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe n keep"
            FAIL "probe n keep"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe n_copy"
          FAIL "probe n_copy"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe alt gone"
        FAIL "probe alt gone"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe movekey"
      FAIL "probe movekey"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe empty bag"
    FAIL "probe empty bag"
    CLEAR_ERR
  END
  SYS CAT "probe:rename:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit has_n miss_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_path_rename.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_path_rename_board: end"
