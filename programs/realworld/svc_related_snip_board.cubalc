# svc_related_snip_board.cubalc — RELATED neighbors + SNIP mini sources
#
# Real use: fleet agents discover form neighbor bags (RELATED/SEEALSO) and
# pull curated mini runnable sources (SNIP/SNIPPET) to bootstrap plate/cap/lib
# ops without cookbook scrape — form→neighbors + topic→snippet packet.
# First realworld of proofs 1331 RELATED + 1332 SNIP.
#
#   RELATED|SEEALSO form → RELATED_OF · RELATED_N · neighbor bag
#   SNIP|SNIPPET [topic] → SNIP_TOPIC · SNIP_N lines · mini source LAST
#   soft miss unknown form/topic · var form/topic · WRITE snip body
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_srs_$$
#   ./out/cubalc run programs/realworld/svc_related_snip_board.cubalc boot
#   ./out/cubalc run ... related|snip|pair|soft|write|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SRS_REPORT.txt SNIP.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SRS_REQUIRE FORM_S TOPIC_S
#
# Edges: multi-word RELATED miss; PRINT clobber bag; HAS vs HASLINE;
#   SNIP forms→cap; WRITE NL; empty RELATED; soft topic

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_related_snip_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_related_snip -- boot|related|snip|pair|soft|write|gate|alias|probe|list -- [--host=H] [--role=R] [--form=F] [--topic=T]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT FORM_S = "SETP"
GETFLAG form|f OR ENV FORM_S OR FORM_S
LET form_s = LAST
CLEAR_ERR

DEFAULT TOPIC_S = "plate"
GETFLAG topic|t OR ENV TOPIC_S OR TOPIC_S
LET topic_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SRS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SRS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "SNIP.txt"
LET snip_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET rel_n = 0
LET snip_n = 0
LET topic_got = ""
LET form_got = ""

ONEOF ACTION "boot", "related", "snip", "pair", "soft", "write", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "related" THEN
    LET op = "related"
  WHEN "snip" THEN
    LET op = "snip"
  WHEN "pair" THEN
    LET op = "pair"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "write" THEN
    LET op = "write"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s form_s topic_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  SYS TRIM form_s
  LET form_s = LAST
  SYS TRIM topic_s
  LET topic_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-relsnip\",\"schema\":\"cubalc.svc_related_snip.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"related\",\"label\":\"relsnip\",\"cfg\":{\"form\":\"" form_s "\",\"topic\":\"" topic_s "\",\"surface\":\"RELATED,SNIP\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"snippet\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_related_snip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.form"
  SYS EQS LAST form_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  SYS EQS LAST topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# related — RELATED form neighbors (capture bag before PRINT)
SYS EQS op "related"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.form"
  LET form_s = LAST
  CLEAR_ERR
  RELATED form_s
  LET body = LAST
  LET rel_n = RELATED_N
  LET form_got = RELATED_OF
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS form_got form_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "GETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "NEEDP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # HASFORM neighbors
  RELATED HASFORM
  LET body = LAST
  LET rel_n = RELATED_N
  CLEAR_ERR
  IF rel_n >= 5 THEN
    LET score = score + 1
  END
  SYS HASLINE body "NEEDFORM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "FORMHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "RELATED"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "related ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "related score"
    FAIL "related score"
    CLEAR_ERR
  END
  SYS CAT "related:" rel_n ":rl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "related:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n form_got score note_msg
  CLEAR_ERR
END

# snip — SNIP topic mini source (capture before PRINT)
SYS EQS op "snip"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  SNIP topic_s
  LET body = LAST
  LET snip_n = SNIP_N
  LET topic_got = SNIP_TOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "NEEDP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS LINES body
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 3 THEN
    LET score = score + 1
  END
  # forms → cap alias
  SNIP forms
  LET topic_got = SNIP_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SNIP cap
  LET body = LAST
  CLEAR_ERR
  SYS HASI body "HASFORM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "RELATED"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "SNIP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "snip ok"
    LET admit_n = 1
    LET find_n = snip_n
  ELSE
    LET miss = 1
    LET note_msg = "snip score"
    FAIL "snip score"
    CLEAR_ERR
  END
  SYS CAT "snip:" snip_n ":sp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "snip:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n snip_n topic_got score note_msg
  CLEAR_ERR
END

# pair — RELATED form + SNIP topic as one evidence packet
SYS EQS op "pair"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.form"
  LET form_s = LAST
  CLEAR_ERR
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  RELATED form_s
  LET body = LAST
  LET rel_n = RELATED_N
  LET form_got = RELATED_OF
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SNIP topic_s
  LET row = LAST
  LET snip_n = SNIP_N
  LET topic_got = SNIP_TOPIC
  CLEAR_ERR
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  # first neighbor via NTH then FORMHINT optional dual
  SYS NTH 0 body
  LET stem_s = LAST
  CLEAR_ERR
  SYS TRIM stem_s
  LET stem_s = LAST
  CLEAR_ERR
  IF stem_s != "" THEN
    LET score = score + 1
  END
  HASFORM stem_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI row form_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "related"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "pair ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "pair score"
    FAIL "pair score"
    CLEAR_ERR
  END
  SYS CAT "pair:" rel_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pair:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n snip_n stem_s score note_msg
  CLEAR_ERR
END

# soft — miss paths
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RELATED ZZZ_NO_SUCH_FORM
  LET sum_v = OK
  LET rel_n = RELATED_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF rel_n == 0 THEN
    LET score = score + 1
  END
  SNIP zzz_nope
  LET sum_v = OK
  LET snip_n = SNIP_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF snip_n == 0 THEN
    LET score = score + 1
  END
  # multi-word form often missing from RELATED graph
  RELATED "REQUIRE FORM"
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  # empty RELATED bare
  RELATED
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# write — materialize SNIP source to SNIP.txt plate file
SYS EQS op "write"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  SNIP topic_s
  LET body = LAST
  LET snip_n = SNIP_N
  LET topic_got = SNIP_TOPIC
  CLEAR_ERR
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  SYS WRITE snip_path body
  CLEAR_ERR
  SYS READ OR snip_path OR ""
  LET row = LAST
  CLEAR_ERR
  SYS HASI row "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI row "NEEDP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS LINES row
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 3 THEN
    LET score = score + 1
  END
  SYS SIZE snip_path
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n > 20 THEN
    LET score = score + 1
  END
  GETP "cfg.topic"
  SYS EQS LAST topic_got
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "write ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "write score"
    FAIL "write score"
    CLEAR_ERR
  END
  SYS CAT "write:" snip_n ":wr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "write:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n snip_n find_n score note_msg
  CLEAR_ERR
END

# gate — plate cfg dual of live RELATED+SNIP
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.form"
  LET form_s = LAST
  CLEAR_ERR
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  RELATED form_s
  LET rel_n = RELATED_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SNIP topic_s
  LET snip_n = SNIP_N
  CLEAR_ERR
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "RELATED"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "SNIP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "related"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "related_snip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n snip_n score note_msg
  CLEAR_ERR
END

# alias — SEEALSO / SNIPPET / FORMSLIKE duals
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SEEALSO INCLUDE
  LET rel_n = RELATED_N
  LET form_got = RELATED_OF
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS form_got "INCLUDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE LAST "LISTLIBS"
  # LAST may still be bag if no PRINT — use capture
  SEEALSO INCLUDE
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "RECIPE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SNIPPET plate
  LET snip_n = SNIP_N
  LET topic_got = SNIP_TOPIC
  CLEAR_ERR
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "relsnip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.form"
  SYS EQS LAST "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n snip_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + HAS substring + multi-word miss
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RELATED SETP
  LET body = LAST
  LET rel_n = RELATED_N
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE stem_s "GETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE LAST "GETP"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend
  SYS HAS stem_s "GET"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "GET"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # multi-word RELATED miss (graph gap)
  RELATED "REQUIRE FORM"
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SNIP general
  LET snip_n = SNIP_N
  CLEAR_ERR
  IF snip_n >= 3 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "RELATED"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "related_snip"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = rel_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" rel_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n snip_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_related_snip.v1 host=" host_s " role=" role_s " form=" form_s " topic=" topic_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " rel_n=" rel_n " snip_n=" snip_n " form=" form_got " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_related_snip_board: done"
PASS
