# rate_budget_ledger.cubalc — durable named rate/API budgets under STATE
#
# Real use: agents track remaining call/token budgets as exact bag fields
# "name:N" without shell awk. Debit/credit rebuilds the token via SETMATCH.
#
# Actions (CUBALC_ARG0 / CUBALC_BUDGET_ACTION):
#   list     — depth + sum remaining + zero-count (default)
#   seed     — PUSH tokens from ARG1 space list of name:N (skip if name exists)
#   set      — ensure name:N (ARG1=name ARG2=N); insert or SETMATCH
#   debit    — subtract AMOUNT (ARG2, default 1); miss if absent or insufficient
#   credit   — add AMOUNT; optional max clamp via CUBALC_BUDGET_MAX
#   get      — remaining for name → hit=remaining
#   pinzero  — MOVELINE first exact *:0 identity (AFTER==0) to front
#   drop     — REMOVELINE first name:*
#   has      — identity present (1/0)
#   count    — COUNTLINE exact name:N token (ARG1 full token or name → any status count)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1="api:10 db:3 mesh:0" \
#     ./out/cubalc run -q -s programs/realworld/rate_budget_ledger.cubalc
#   CUBALC_ARG0=debit CUBALC_ARG1=api CUBALC_ARG2=2 ./out/cubalc run -q -s ...
#   CUBALC_ARG0=list ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_BUDGET_FILE=BUDGETS.txt
#   CUBALC_BUDGET_REQUIRE=1   # EXIT 2 on debit/get/drop/pin miss
#   CUBALC_BUDGET_MAX=N       # credit clamp upper bound (0=off)
#
# Edges deliberately stressed:
#   no bag-field integer mutate — rebuild name:N via STR+REPLACEALL+SETMATCH
#   SYS NUM only parses LAST — AFTER ":" must land in LAST before NUM
#   SYS CMP/MIN/CLAMP for insufficient / ceiling checks
#   COUNTLINE exact — cannot COUNTLINE ":0" zeros (use EACH+AFTER+NUM)
#   GREP "api:" matches myapi: / api_v2: substring — use BEFORE+EQS identity
#   SETMATCH first exact only — duplicate name:N residual
#   MOVELINE needs FINDLINE index (NUM shuttle of idx)
#   PRINT_JSON bag collapse; WRITE trailing NL often missing on last field
#   soft READ empty plate; REQUIRE soft-miss EXIT path

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "rate_budget_ledger: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT AMT_S = "1"
DEFAULT RFILE = "BUDGETS.txt"
DEFAULT REPORT = "BUDGET_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT MAX_CAP = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_BUDGET_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_BUDGET_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET AMT_S = LAST
ELSE
  SYS ENV "CUBALC_BUDGET_AMT" OR "1"
  LET AMT_S = LAST
END
SYS ENV "CUBALC_BUDGET_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_BUDGET_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_BUDGET_MAX" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MAX_CAP = LAST_N
  END
END

# parse amount string via NUM shuttle (NUM only on LAST)
SYS PREPEND "" AMT_S
SYS HEAD LAST
SYS NUM
LET amount = 0
IF OK == 1 THEN
  LET amount = LAST_N
END
# CLAMP amount to non-negative for debit/credit magnitude
SYS MAX amount 0
LET amount = LAST_N

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR "soft budget load"
SYS LINES bag
LET depth0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET remaining = 0
LET sum_rem = 0
LET n_zero = 0
LET n_pos = 0
LET idx = -1
LET old_entry = ""
LET entry = ""
LET note_msg = "ok"
LET name_hit = 0
LET cmp_v = 0

# --- helper: rebuild name:N token (no concat) ---
# entry built when needed from NAME + remaining via REPLACEALL

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  LET sum_rem = 0
  LET n_zero = 0
  LET n_pos = 0
  EACH LINE AS row IN bag
    SYS BLANK row
    IF LAST_N == 0 THEN
      SYS AFTER row ":"
      SYS NUM
      IF OK == 1 THEN
        LET remaining = LAST_N
        LET sum_rem = sum_rem + remaining
        SYS CMP remaining 0
        LET cmp_v = LAST_N
        IF cmp_v == 0 THEN
          LET n_zero = n_zero + 1
        END
        IF cmp_v > 0 THEN
          LET n_pos = n_pos + 1
        END
      END
    END
  END
  # if NAME given, also resolve that budget
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET name_hit = 0
    EACH LINE AS row IN bag
      SYS BEFORE row ":"
      SYS EQS LAST NAME
      IF LAST_N == 1 THEN
        IF name_hit == 0 THEN
          LET old_entry = row
          LET name_hit = 1
          SYS AFTER row ":"
          SYS NUM
          IF OK == 1 THEN
            LET remaining = LAST_N
            LET hit = remaining
          END
        END
      END
    END
    IF name_hit == 0 THEN
      LET miss = 1
    END
  END
  STATUS
  PRINT "budget" depth0 sum_rem n_zero n_pos ACTION
  PRINT_JSON depth0 sum_rem n_zero n_pos remaining ACTION STATUS_OK
  PRINT_JSON bag
  LET note_msg = "list ok"
END

# --- seed: WORDS of name:N tokens ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs name:N tokens (ARG1 space-separated)"
  END
  SYS WORDS NAME
  LET tokens = LAST
  EACH LINE AS tok IN tokens
    SYS BLANK tok
    IF LAST_N == 0 THEN
      SYS HASI tok ":"
      IF LAST_N == 1 THEN
        SYS BEFORE tok ":"
        LET n = LAST
        SYS AFTER tok ":"
        SYS NUM
        LET v = 0
        IF OK == 1 THEN
          LET v = LAST_N
        END
        # identity: skip if name already present
        LET name_hit = 0
        EACH LINE AS row IN bag
          SYS BEFORE row ":"
          SYS EQS LAST n
          IF LAST_N == 1 THEN
            LET name_hit = 1
          END
        END
        IF name_hit == 0 THEN
          # rebuild token with CLAMP v>=0
          SYS MAX v 0
          LET v = LAST_N
          SYS STR v
          LET vs = LAST
          LET e = "NAME:VAL"
          SYS REPLACEALL e "NAME" n
          LET e = LAST
          SYS REPLACEALL e "VAL" vs
          LET e = LAST
          SYS PUSH bag e
          LET bag = LAST
          LET changed = 1
          LET hit = hit + 1
        ELSE
          LET miss = miss + 1
        END
      ELSE
        # bare name → name:0
        LET name_hit = 0
        EACH LINE AS row IN bag
          SYS BEFORE row ":"
          SYS EQS LAST tok
          IF LAST_N == 1 THEN
            LET name_hit = 1
          END
        END
        IF name_hit == 0 THEN
          LET e = "NAME:0"
          SYS REPLACEALL e "NAME" tok
          LET e = LAST
          SYS PUSH bag e
          LET bag = LAST
          LET changed = 1
          LET hit = hit + 1
        ELSE
          LET miss = miss + 1
        END
      END
    END
  END
  LET note_msg = "seeded"
END

# --- set name to exact remaining ---
SYS EQS ACTION "set"
IF LAST_N == 1 THEN
  NOTE "action set"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "set needs name"
  END
  SYS MAX amount 0
  LET remaining = LAST_N
  SYS STR remaining
  LET vs = LAST
  LET entry = "NAME:VAL"
  SYS REPLACEALL entry "NAME" NAME
  LET entry = LAST
  SYS REPLACEALL entry "VAL" vs
  LET entry = LAST
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    SYS PUSH bag entry
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "set inserted"
  ELSE
    SYS SETMATCH bag old_entry entry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "set setmatch miss"
      FAIL "set setmatch miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "set miss"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "set matched"
    END
  END
END

# --- debit ---
SYS EQS ACTION "debit"
IF LAST_N == 1 THEN
  NOTE "action debit"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "debit needs name"
  END
  IF amount < 1 THEN
    LET amount = 1
  END
  LET name_hit = 0
  LET old_entry = ""
  LET remaining = 0
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
        SYS AFTER row ":"
        SYS NUM
        IF OK == 1 THEN
          LET remaining = LAST_N
        END
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "debit miss name"
    FAIL "debit name not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "debit miss"
    END
  ELSE
    # insufficient? CMP remaining amount → -1 means remaining < amount
    SYS CMP remaining amount
    LET cmp_v = LAST_N
    IF cmp_v < 0 THEN
      LET miss = 1
      LET hit = remaining
      LET note_msg = "debit insufficient"
      FAIL "debit insufficient"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "debit insufficient"
      END
    ELSE
      LET remaining = remaining - amount
      SYS MAX remaining 0
      LET remaining = LAST_N
      SYS STR remaining
      LET vs = LAST
      LET entry = "NAME:VAL"
      SYS REPLACEALL entry "NAME" NAME
      LET entry = LAST
      SYS REPLACEALL entry "VAL" vs
      LET entry = LAST
      SYS SETMATCH bag old_entry entry
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "debit setmatch miss"
        FAIL "debit setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "debit setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = remaining
        LET note_msg = "debited"
      END
    END
  END
END

# --- credit ---
SYS EQS ACTION "credit"
IF LAST_N == 1 THEN
  NOTE "action credit"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "credit needs name"
  END
  IF amount < 1 THEN
    LET amount = 1
  END
  LET name_hit = 0
  LET old_entry = ""
  LET remaining = 0
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
        SYS AFTER row ":"
        SYS NUM
        IF OK == 1 THEN
          LET remaining = LAST_N
        END
      END
    END
  END
  IF name_hit == 0 THEN
    # insert new budget at amount
    LET remaining = amount
    IF MAX_CAP > 0 THEN
      SYS MIN remaining MAX_CAP
      LET remaining = LAST_N
    END
    SYS STR remaining
    LET vs = LAST
    LET entry = "NAME:VAL"
    SYS REPLACEALL entry "NAME" NAME
    LET entry = LAST
    SYS REPLACEALL entry "VAL" vs
    LET entry = LAST
    SYS PUSH bag entry
    LET bag = LAST
    LET changed = 1
    LET hit = remaining
    LET note_msg = "credit inserted"
  ELSE
    LET remaining = remaining + amount
    IF MAX_CAP > 0 THEN
      SYS MIN remaining MAX_CAP
      LET remaining = LAST_N
      # also exercise CLAMP form
      SYS CLAMP remaining 0 MAX_CAP
      LET remaining = LAST_N
    END
    SYS STR remaining
    LET vs = LAST
    LET entry = "NAME:VAL"
    SYS REPLACEALL entry "NAME" NAME
    LET entry = LAST
    SYS REPLACEALL entry "VAL" vs
    LET entry = LAST
    SYS SETMATCH bag old_entry entry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "credit setmatch miss"
      FAIL "credit setmatch"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "credit setmatch miss"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = remaining
      LET note_msg = "credited"
    END
  END
END

# --- get remaining ---
SYS EQS ACTION "get"
IF LAST_N == 1 THEN
  NOTE "action get"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "get needs name"
  END
  LET name_hit = 0
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
        SYS AFTER row ":"
        SYS NUM
        IF OK == 1 THEN
          LET remaining = LAST_N
          LET hit = remaining
        END
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "get miss"
    FAIL "get miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "get miss"
    END
  ELSE
    LET note_msg = "got"
  END
END

# --- pinzero: first budget with remaining 0 to front ---
SYS EQS ACTION "pinzero"
IF LAST_N == 1 THEN
  NOTE "action pinzero"
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS AFTER row ":"
    SYS NUM
    IF OK == 1 THEN
      SYS CMP LAST_N 0
      IF LAST_N == 0 THEN
        IF name_hit == 0 THEN
          LET old_entry = row
          LET name_hit = 1
        END
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "pinzero none"
    FAIL "pinzero no zero budget"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pinzero miss"
    END
  ELSE
    SYS FINDLINE bag old_entry
    LET idx = LAST_N
    SYS MOVELINE bag idx 0
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "pinzero moveline miss"
      FAIL "pinzero moveline"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET idx = 0
      LET note_msg = "pinned zero"
    END
  END
END

# --- drop ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs name"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "drop miss"
    FAIL "drop miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop miss"
    END
  ELSE
    SYS REMOVELINE bag old_entry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "removeline miss"
      FAIL "removeline miss"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "dropped"
    END
  END
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs name or token"
  END
  SYS HASI NAME ":"
  IF LAST_N == 1 THEN
    SYS HASLINE bag NAME
    LET hit = LAST_N
  ELSE
    LET name_hit = 0
    EACH LINE AS row IN bag
      SYS BEFORE row ":"
      SYS EQS LAST NAME
      IF LAST_N == 1 THEN
        LET name_hit = 1
      END
    END
    LET hit = name_hit
  END
  LET note_msg = "has"
END

# --- count exact ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs token or name"
  END
  SYS HASI NAME ":"
  IF LAST_N == 1 THEN
    SYS COUNTLINE bag NAME
    LET hit = LAST_N
  ELSE
    # count how many rows for this name (should be 0/1 ideally)
    LET hit = 0
    EACH LINE AS row IN bag
      SYS BEFORE row ":"
      SYS EQS LAST NAME
      IF LAST_N == 1 THEN
        LET hit = hit + 1
      END
    END
  END
  LET note_msg = "counted"
END

# unknown action?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "set"
LET k = k + LAST_N
SYS EQS ACTION "debit"
LET k = k + LAST_N
SYS EQS ACTION "credit"
LET k = k + LAST_N
SYS EQS ACTION "get"
LET k = k + LAST_N
SYS EQS ACTION "pinzero"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

# post-tally sum / zeros
LET sum_rem = 0
LET n_zero = 0
LET n_pos = 0
EACH LINE AS row IN bag
  SYS BLANK row
  IF LAST_N == 0 THEN
    SYS AFTER row ":"
    SYS NUM
    IF OK == 1 THEN
      LET remaining = LAST_N
      LET sum_rem = sum_rem + remaining
      SYS CMP remaining 0
      IF LAST_N == 0 THEN
        LET n_zero = n_zero + 1
      END
      IF LAST_N > 0 THEN
        LET n_pos = n_pos + 1
      END
    END
  END
END

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "budget write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.budget.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "name"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "amount"
LET report = LAST
SYS STR amount
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "remaining"
LET report = LAST
SYS STR remaining
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "old_entry"
LET report = LAST
SYS PUSH report old_entry
LET report = LAST
SYS PUSH report "entry"
LET report = LAST
SYS PUSH report entry
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "sum_rem"
LET report = LAST
SYS STR sum_rem
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_zero"
LET report = LAST
SYS STR n_zero
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_pos"
LET report = LAST
SYS STR n_pos
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "changed"
LET report = LAST
SYS STR changed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth0"
LET report = LAST
SYS STR depth0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "budget" ACTION hit miss changed sum_rem n_zero n_pos depth0 depth1
PRINT_JSON ACTION hit miss changed sum_rem n_zero n_pos remaining depth0 depth1 idx elapsed STATUS_OK
PASS "budget tick"
NOTE "rate_budget_ledger: done"
CLEAR_ERR
EXIT 0 "budget ok"
