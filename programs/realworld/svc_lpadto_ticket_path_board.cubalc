# svc_lpadto_ticket_path_board.cubalc — LPADTO/RPADTO + STRIPPREFIXTO tickets
#
# Real use: intake/artifact agents zero-pad job/ticket IDs, right-pad
# status columns for digests, and strip state/root prefixes + suffixes
# from paths in place. First realworld of 1466 LPADTO/RPADTO/PADTO
# (1.15.921+ · MI ~928) + 1463 STRIPPREFIXTO/STRIPSUFFIXTO (MI ~925).
# Distinct from lenof_path_peel (LENOF/BEFOREIN) and column_align_export
# — this board is *named-var pad + affix strip for tickets/paths*.
#
#   LPADTO · RPADTO · PADTO · STRIPPREFIXTO · STRIPSUFFIXTO
#   DROPPREFIXTO · DROPSUFFIXTO · WITH pad · + NUMTO/STRTO chain
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ltp_$$
#   ./out/cubalc run programs/realworld/svc_lpadto_ticket_path_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt LTP_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_LTP_REQUIRE
#
# Edges: LPADTO already-wide truncates; miss strip HIT=0 keep; empty
#   affix no-op; chain peel+NUMTO+LPAD; WRITE NL; REQUIRE soft

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

NOTE "svc_lpadto_ticket_path_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_lpadto_ticket_path -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_LTP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "LTP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET path = ""
LET msg = ""
LET peeld = ""
LET ticket = ""
LET depth = 0
LET weight = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ltp\",\"schema\":\"cubalc.svc_lpadto_ticket_path.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ltp\",\"want_filter\":\"lpadto_ticket_path\",\"cfg\":{\"surface\":\"LPADTO,RPADTO,PADTO,STRIPPREFIXTO,STRIPSUFFIXTO,DROPPREFIXTO,DROPSUFFIXTO\",\"contract\":\"zero-pad tickets + strip path affixes for intake digests\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  LET ticket = 42
  LPADTO ticket 6 "0"
  LET find_n = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ltp"
  IF LAST_N == 1 THEN
    SYS EQS ticket "000042"
    IF LAST_N == 1 THEN
      IF find_n == 6 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot len"
        FAIL "boot len"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot pad"
      FAIL "boot pad"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — pad + strip core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET id = 42
  LPADTO id 6 "0"
  LET find_n = LAST_N
  CLEAR_ERR
  SYS EQS id "000042"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF find_n == 6 THEN
    LET score = score + 1
  END
  LET id2 = 7
  LPADTO id2 3 "0"
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  SYS EQS id2 "007"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lab = "ok"
  RPADTO lab 5 "."
  CLEAR_ERR
  SYS EQS lab "ok..."
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET n = 7
  PADTO n 3 "0"
  CLEAR_ERR
  SYS EQS n "007"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET path = "/tmp/work/file.txt"
  STRIPPREFIXTO path "/tmp/"
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS path "work/file.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  STRIPSUFFIXTO path ".txt"
  CLEAR_ERR
  IF STRIPSUFFIXTO_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS path "work/file"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — trunc · miss strip · empty affix · space pad
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # already wide → truncate
  LET long = "abcdef"
  LPADTO long 3
  CLEAR_ERR
  SYS EQS long "abc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # space left-pad default
  LET s = "hi"
  LPADTO s 5
  CLEAR_ERR
  LENOF s
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 5 THEN
    LET score = score + 1
  END
  # miss prefix
  LET p2 = "rel/path"
  STRIPPREFIXTO p2 "/tmp/"
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 0 THEN
    LET score = score + 1
  END
  SYS EQS p2 "rel/path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # miss suffix
  LET p3 = "note.md"
  STRIPSUFFIXTO p3 ".txt"
  CLEAR_ERR
  IF STRIPSUFFIXTO_HIT == 0 THEN
    LET score = score + 1
  END
  # empty affix no-op
  LET c = "keep"
  STRIPPREFIXTO c ""
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 0 THEN
    LET score = score + 1
  END
  SYS EQS c "keep"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # aliases
  LET a = "pre:value"
  DROPPREFIXTO a "pre:"
  CLEAR_ERR
  SYS EQS a "value"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET b = "name.cubalc"
  DROPSUFFIXTO b ".cubalc"
  CLEAR_ERR
  SYS EQS b "name"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# peel — real ticket + state path intake
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # ticket from count field
  LET raw = "ticket:9"
  AFTERIN raw ":"
  NUMTO raw
  INC raw
  STRTO raw
  LPADTO raw 4 "0"
  CLEAR_ERR
  SYS EQS raw "0010"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # state plate path
  LET full = "/home/agent/state/plate.json"
  STRIPPREFIXTO full "/home/agent/"
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 1 THEN
    LET score = score + 1
  END
  STRIPSUFFIXTO full ".json"
  CLEAR_ERR
  SYS EQS full "state/plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # digest row: padded id + status col
  LET ticket = 128
  LPADTO ticket 6 "0"
  LET st = "ok"
  RPADTO st 6 " "
  CLEAR_ERR
  SYS CAT ticket " " st
  LET peeld = LAST
  CLEAR_ERR
  STARTSIN peeld "000128"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LENOF peeld
  LET depth = LAST_N
  CLEAR_ERR
  IF depth >= 12 THEN
    LET score = score + 1
  END
  # WITH pad keyword
  LET w = "x"
  LPADTO w 4 WITH "0"
  CLEAR_ERR
  SYS EQS w "000x"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # num promote strip
  LET n = 12345
  STRIPPREFIXTO n "12"
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS n "345"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "lpadto_ticket_path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score peeld note_msg
  CLEAR_ERR
END

# scale — multi-ticket pad table + root strip chain
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET t1 = 1
  LET t2 = 99
  LET t3 = 1000
  LPADTO t1 5 "0"
  LPADTO t2 5 "0"
  LPADTO t3 5 "0"
  CLEAR_ERR
  SYS EQS t1 "00001"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS t2 "00099"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS t3 "01000"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # t3 was 4 digits, pad to 5
  # status columns
  LET s1 = "run"
  LET s2 = "done"
  RPADTO s1 6 "."
  RPADTO s2 6 "."
  CLEAR_ERR
  SYS EQS s1 "run..."
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS s2 "done.."
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # release path root strip
  LET rel = "/opt/releases/app/v1.2.3/bin"
  STRIPPREFIXTO rel "/opt/releases/"
  CLEAR_ERR
  STARTSIN rel "app/"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # pad width 0 or 1 edge?
  LET z = "ab"
  LPADTO z 2 "0"
  CLEAR_ERR
  SYS EQS z "ab"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # double strip suffix miss then hit
  LET f = "report.tar.gz"
  STRIPSUFFIXTO f ".zip"
  CLEAR_ERR
  IF STRIPSUFFIXTO_HIT == 0 THEN
    LET score = score + 1
  END
  STRIPSUFFIXTO f ".gz"
  CLEAR_ERR
  IF STRIPSUFFIXTO_HIT == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "LPADTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "LPADTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "RPADTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "PADTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "STRIPPREFIXTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "STRIPSUFFIXTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "DROPPREFIXTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "DROPSUFFIXTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NUMTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "STRTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "lpadto_ticket_path"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit when ticket padded and path under releases/
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET ticket = 55
  LPADTO ticket 4 "0"
  CLEAR_ERR
  SYS EQS ticket "0055"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LENOF ticket
  IF LAST_N == 4 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET path = "/opt/releases/app/v2/bin"
  STARTSIN path "/opt/releases/"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  STRIPPREFIXTO path "/opt/releases/"
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 1 THEN
    LET score = score + 1
  END
  STARTSIN path "app/"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # reject outside root
  LET bad = "/var/tmp/evil"
  STRIPPREFIXTO bad "/opt/releases/"
  CLEAR_ERR
  IF STRIPPREFIXTO_HIT == 0 THEN
    LET score = score + 1
  END
  IF require_hit > 0 THEN
    IF score < 5 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ltp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score ticket note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET ticket = 88
  LPADTO ticket 5 "0"
  LET find_n = LAST_N
  CLEAR_ERR
  LET saved = find_n
  PRINT "probe-ticket" ticket
  CLEAR_ERR
  IF saved == 5 THEN
    LET score = score + 1
  END
  SYS WRITE val_path ticket
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "00088"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "ltp host=" host_s " role=" role_s " ticket=" ticket
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ticket=00088"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "STRIPPREFIXTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ltp\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

PASS
