# agent_json_plate_contract_board.cubalc — JSONAVGN + JSONEQ + JSONSUBSET peer contract
#
# Real use: agent STATUS handoff — mean load gate + required-field cover +
# peer plate equality without VALUES+AVG glue or fragile string EQS:
#   JSONAVGN / JAVGN / JSONMEAN — integer mean → LAST_N; USED count (1076)
#   JSONEQ / JEQ · JSONNEQ / JNEQ — order-independent plate equality (1077)
#   JSONSUBSET / JSUBSET · JSONSUPERSET / JSONCOVERS — required fields (1078)
#   gate: subset(req,status) AND avgn in [minavg,maxavg]
#   peer: full JSONEQ against expected peer snapshot
#
# First realworld AVGN+EQ+SUBSET board. Distinct from extremes (MAXN/TOPKEY),
# health (LEN/EMPTY/SUMN), schema_contract (CLASSINFO OOP), field_contract.
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ajpct_$$
#   ./out/cubalc run programs/realworld/agent_json_plate_contract_board.cubalc \
#     mint -- --plate=/tmp/ajpct/status.json
#   ./out/cubalc run ... avgn -- --plate=...
#   ./out/cubalc run ... eq -- --plate=... --peer=...
#   ./out/cubalc run ... subset -- --plate=... --req=...
#   ./out/cubalc run ... gate -- --plate=... --minavg=2 --maxavg=20
#
# Plate: STATUS.txt VAL.txt META.txt AJPCT_REPORT.txt
# Env: PLATE_PATH PEER_PATH REQ_PATH
#      CUBALC_AJPCT_REQUIRE CUBALC_AJPCT_MINAVG CUBALC_AJPCT_MAXAVG
#
# Edges:
#   empty {}; non-object soft 0; bools in mean (USED inflates);
#   EQ key-order independent; SUBSET value match not just keys;
#   LAST kept as first arg after EQ/SUBSET; trunc mean toward 0;
#   REQUIRE EXIT n; WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_json_plate_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT MINAVG = 0
DEFAULT MAXAVG = 100
DEFAULT USAGE_LINE = "agent_json_plate_contract -- mint|avgn|eq|neq|subset|covers|gate|peer|list -- [--plate=P] [--peer=P] [--req=P] [--minavg=N] [--maxavg=N]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/status.json"
LET plate_file = LAST
SYS JOIN state_dir "sample/peer.json"
LET peer_file = LAST
SYS JOIN state_dir "sample/req.json"
LET req_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
CLEAR_ERR

GETFLAGOUT peer OR ENV PEER_PATH OR peer_file
LET peer_file = LAST
LET peer_src = GETFLAGOUT_SRC
CLEAR_ERR

GETFLAGOUT req OR ENV REQ_PATH OR req_file
LET req_file = LAST
LET req_src = GETFLAGOUT_SRC
CLEAR_ERR

GETFLAGN minavg OR ENV CUBALC_AJPCT_MINAVG OR MINAVG
LET MINAVG = LAST_N
CLEAR_ERR
GETFLAGN maxavg OR ENV CUBALC_AJPCT_MAXAVG OR MAXAVG
LET MAXAVG = LAST_N
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_AJPCT_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "AJPCT_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET line_i = 0
LET row = ""
LET out = ""
LET body = ""
LET peer = ""
LET req = ""
LET metrics = ""
LET used_n = 0
LET avg_n = 0
LET eq_n = 0
LET sub_n = 0

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "mint", "avgn", "eq", "neq", "subset", "covers", "gate", "peer", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "mint" THEN
    LET op = "mint"
  WHEN "avgn" THEN
    LET op = "avgn"
  WHEN "eq" THEN
    LET op = "eq"
  WHEN "neq" THEN
    LET op = "neq"
  WHEN "subset" THEN
    LET op = "subset"
  WHEN "covers" THEN
    LET op = "covers"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src peer_src req_src MINAVG MAXAVG
  CLEAR_ERR
END

SYS EQS op "mint"
IF LAST_N == 1 THEN
  LET known = 1
  # status plate: identity + metrics + bool flag
  SYS JSONOBJ "schema" "cubalc.agent_status.v1" "role" "worker" "ok" 1 "load" 10 "err" 2 "warn" 4 "live" true "zone" "east"
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "mint soft miss"
    FAIL "mint soft miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "mint failed"
    END
  ELSE
    LET take_n = JSONOBJ_N
    LET body = LAST
    LET out = body
    CLEAR_ERR
    WRITEOUT plate_file body
    EXPECT OK == 1
    IF OK == 0 THEN
      EXIT 2 "mint write failed"
    END
    CLEAR_ERR
    # peer: same fields different key order (EQ should hit)
    SYS JSONOBJ "zone" "east" "live" true "warn" 4 "err" 2 "load" 10 "ok" 1 "role" "worker" "schema" "cubalc.agent_status.v1"
    LET peer = LAST
    WRITEOUT peer_file peer
    CLEAR_ERR
    # required contract: schema+role+ok only
    SYS JSONOBJ "schema" "cubalc.agent_status.v1" "role" "worker" "ok" 1
    LET req = LAST
    WRITEOUT req_file req
    CLEAR_ERR
    SYS CAT "mint:"
    LET row = LAST
    SYS STR take_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":mt"
    LET row = LAST
    SYS GREPV "mint:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "mint ok"
  END
  PRINT_JSON admit_n bag_n take_n p_src peer_src req_src
  CLEAR_ERR
END

SYS EQS op "avgn"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "avgn empty plate"
    FAIL "avgn empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "avgn empty"
    END
  ELSE
    # pick pure metrics to avoid bool/schema pollution in mean
    # Capture LAST_N immediately — op-side JSONAVGN_N/USED may fail to
    # materialize when VM n_vars hits 128 (INCLUDE+flags+locals).
    SYS JSONPICK body "load" "err" "warn"
    LET metrics = LAST
    CLEAR_ERR
    SYS JSONLEN metrics
    LET used_n = LAST_N
    CLEAR_ERR
    SYS JSONAVGN metrics
    LET avg_n = LAST_N
    LET take_n = avg_n
    # LAST kept as metrics plate
    SYS JSONN "load" FROM LAST
    LET peel_hit = LAST_N
    CLEAR_ERR
    LET out = body
    SYS CAT "avgn:"
    LET row = LAST
    SYS STR take_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR used_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR peel_hit
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":av"
    LET row = LAST
    SYS GREPV "avgn:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "avgn ok"
  END
  PRINT_JSON admit_n bag_n take_n used_n peel_hit avg_n p_src
  CLEAR_ERR
END

SYS EQS op "eq"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS READ OR peer_file OR ""
  LET peer = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "eq empty plate"
    FAIL "eq empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "eq empty"
    END
  ELSE
    SYS BLANK peer
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "eq empty peer"
      FAIL "eq empty peer"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "eq empty peer"
      END
    ELSE
      SYS JSONEQ body peer
      LET eq_n = LAST_N
      LET take_n = eq_n
      # LAST kept as first plate (body)
      SYS JSONN "ok" FROM LAST
      LET peel_hit = LAST_N
      CLEAR_ERR
      LET out = body
      IF eq_n == 1 THEN
        LET hit = 1
        LET note_msg = "eq match"
      ELSE
        LET miss = 1
        LET note_msg = "eq mismatch"
        FAIL "eq mismatch"
        CLEAR_ERR
      END
      SYS CAT "eq:"
      LET row = LAST
      SYS STR take_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR peel_hit
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":eq"
      LET row = LAST
      SYS GREPV "eq:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
    END
  END
  PRINT_JSON admit_n bag_n take_n eq_n peel_hit p_src peer_src
  CLEAR_ERR
END

SYS EQS op "neq"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS READ OR peer_file OR ""
  LET peer = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "neq empty plate"
    FAIL "neq empty plate"
    CLEAR_ERR
  ELSE
    SYS BLANK peer
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "neq empty peer"
      FAIL "neq empty peer"
      CLEAR_ERR
    ELSE
      SYS JSONNEQ body peer
      LET eq_n = LAST_N
      LET take_n = eq_n
      LET out = body
      # for mint peer (equal) NEQ=0 is expected soft "same"
      IF eq_n == 1 THEN
        LET hit = 1
        LET note_msg = "neq differ"
      ELSE
        LET miss = 1
        LET note_msg = "neq same"
        FAIL "neq same"
        CLEAR_ERR
      END
      SYS CAT "neq:"
      LET row = LAST
      SYS STR take_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":nq"
      LET row = LAST
      SYS GREPV "neq:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
    END
  END
  PRINT_JSON admit_n bag_n take_n eq_n p_src peer_src note_msg
  CLEAR_ERR
END

SYS EQS op "subset"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS READ OR req_file OR ""
  LET req = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "subset empty plate"
    FAIL "subset empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "subset empty"
    END
  ELSE
    SYS BLANK req
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "subset empty req"
      FAIL "subset empty req"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "subset empty req"
      END
    ELSE
      SYS JSONSUBSET req body
      LET sub_n = LAST_N
      LET take_n = sub_n
      # LAST kept as first arg (req)
      SYS JSONN "ok" FROM LAST
      LET peel_hit = LAST_N
      CLEAR_ERR
      LET out = body
      IF sub_n == 1 THEN
        LET hit = 1
        LET note_msg = "subset ok"
      ELSE
        LET miss = 1
        LET note_msg = "subset miss"
        FAIL "subset miss"
        CLEAR_ERR
      END
      SYS CAT "subset:"
      LET row = LAST
      SYS STR take_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR peel_hit
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":sb"
      LET row = LAST
      SYS GREPV "subset:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
    END
  END
  PRINT_JSON admit_n bag_n take_n sub_n peel_hit p_src req_src
  CLEAR_ERR
END

SYS EQS op "covers"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS READ OR req_file OR ""
  LET req = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "covers empty plate"
    FAIL "covers empty plate"
    CLEAR_ERR
  ELSE
    SYS BLANK req
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "covers empty req"
      FAIL "covers empty req"
      CLEAR_ERR
    ELSE
      # body covers req ≡ SUPERSET body req
      SYS JSONSUPERSET body req
      LET sub_n = LAST_N
      LET take_n = sub_n
      CLEAR_ERR
      LET out = body
      IF sub_n == 1 THEN
        LET hit = 1
        LET note_msg = "covers ok"
      ELSE
        LET miss = 1
        LET note_msg = "covers miss"
        FAIL "covers miss"
        CLEAR_ERR
      END
      SYS CAT "covers:"
      LET row = LAST
      SYS STR take_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":cv"
      LET row = LAST
      SYS GREPV "covers:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
    END
  END
  PRINT_JSON admit_n bag_n take_n sub_n p_src req_src
  CLEAR_ERR
END

SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  # mutate peer extra key then NEQ + not EQ
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "peer empty plate"
    FAIL "peer empty plate"
    CLEAR_ERR
  ELSE
    SYS JSONSET body "extra" "noise"
    LET peer = LAST
    WRITEOUT peer_file peer
    CLEAR_ERR
    SYS JSONEQ body peer
    # wait body is original without extra — re-read
    SYS READ OR plate_file OR ""
    LET body = LAST
    CLEAR_ERR
    SYS JSONEQ body peer
    LET eq_n = LAST_N
    CLEAR_ERR
    SYS JSONNEQ body peer
    LET has_n = LAST_N
    CLEAR_ERR
    SYS JSONSUBSET body peer
    LET sub_n = LAST_N
    CLEAR_ERR
    LET take_n = eq_n
    LET out = peer
    # expect eq=0 neq=1 subset=1 (body keys still in peer)
    IF eq_n == 0 THEN
      IF has_n == 1 THEN
        IF sub_n == 1 THEN
          LET hit = 1
          LET note_msg = "peer diverge ok"
        ELSE
          LET miss = 1
          LET note_msg = "peer subset fail"
          FAIL "peer subset fail"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer neq fail"
        FAIL "peer neq fail"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer still eq"
      FAIL "peer still eq"
      CLEAR_ERR
    END
    SYS CAT "peer:"
    LET row = LAST
    SYS STR eq_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR has_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR sub_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":pr"
    LET row = LAST
    SYS GREPV "peer:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
  END
  PRINT_JSON admit_n bag_n take_n eq_n has_n sub_n p_src peer_src note_msg
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS READ OR req_file OR ""
  LET req = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "gate empty plate"
    FAIL "gate empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate empty"
    END
  ELSE
    SYS BLANK req
    IF LAST_N == 1 THEN
      # soft: use inline required schema if no req file
      SYS JSONOBJ "schema" "cubalc.agent_status.v1" "role" "worker" "ok" 1
      LET req = LAST
      CLEAR_ERR
    END
    SYS JSONSUBSET req body
    LET sub_n = LAST_N
    CLEAR_ERR
    SYS JSONPICK body "load" "err" "warn"
    LET metrics = LAST
    CLEAR_ERR
    SYS JSONLEN metrics
    LET used_n = LAST_N
    CLEAR_ERR
    SYS JSONAVGN metrics
    LET avg_n = LAST_N
    LET take_n = avg_n
    CLEAR_ERR
    LET out = body
    IF sub_n == 0 THEN
      LET miss = 1
      LET note_msg = "gate subset deny"
      FAIL "gate subset deny"
      CLEAR_ERR
    ELSE
      IF avg_n < MINAVG THEN
        LET miss = 1
        LET note_msg = "gate minavg deny"
        FAIL "gate minavg deny"
        CLEAR_ERR
      ELSE
        IF avg_n > MAXAVG THEN
          LET miss = 1
          LET note_msg = "gate maxavg deny"
          FAIL "gate maxavg deny"
          CLEAR_ERR
        ELSE
          LET hit = 1
          LET note_msg = "gate admit"
        END
      END
    END
    SYS CAT "gate:"
    LET row = LAST
    SYS STR sub_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR avg_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR used_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR hit
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":gt"
    LET row = LAST
    SYS GREPV "gate:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
  END
  PRINT_JSON admit_n bag_n take_n avg_n used_n sub_n MINAVG MAXAVG hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  # empty / non-obj
  SYS JSONAVGN "{}"
  LET avg_n = LAST_N
  CLEAR_ERR
  SYS JSONLEN "{}"
  LET used_n = LAST_N
  CLEAR_ERR
  SYS JSONEQ "not" "{}"
  LET eq_n = LAST_N
  CLEAR_ERR
  SYS JSONSUBSET "not" "{}"
  LET sub_n = LAST_N
  CLEAR_ERR
  # trunc mean (1+2)/2 = 1
  SYS JSONOBJ "x" 1 "y" 2
  SYS JSONAVGN LAST
  LET take_n = LAST_N
  CLEAR_ERR
  # bool pollution: ok:true flag:false n:9 → USED=3 mean=3
  SYS JSONOBJ "ok" true "flag" false "n" 9 "s" "hi"
  LET metrics = LAST
  SYS JSONAVGN metrics
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSONLEN metrics
  LET has_n = LAST_N
  CLEAR_ERR
  # order-independent EQ
  SYS JSONOBJ "a" 1 "b" 2
  LET body = LAST
  SYS JSONOBJ "b" 2 "a" 1
  LET peer = LAST
  SYS JSONEQ body peer
  LET line_i = LAST_N
  CLEAR_ERR
  # subset value mismatch
  SYS JSONOBJ "ok" true "n" 3
  LET req = LAST
  SYS JSONOBJ "ok" false "n" 3 "extra" 1
  SYS JSONSUBSET req LAST
  LET admit_n = LAST_N
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  PRINT_JSON avg_n used_n eq_n sub_n take_n peel_hit has_n line_i admit_n p_src
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_json_plate_contract_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "bag_n"
LET row = LAST
SYS STR bag_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "take_n"
LET row = LAST
SYS STR take_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "avg_n"
LET row = LAST
SYS STR avg_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "used_n"
LET row = LAST
SYS STR used_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "eq_n"
LET row = LAST
SYS STR eq_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "sub_n"
LET row = LAST
SYS STR sub_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE report_path row
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
SYS WRITE meta_path row
CLEAR_ERR

NOTE "agent_json_plate_contract_board: done"
PRINT_JSON hit miss bag_n take_n avg_n used_n eq_n sub_n p_src note_msg
EXIT 0
