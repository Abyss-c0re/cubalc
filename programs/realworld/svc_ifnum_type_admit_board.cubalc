# svc_ifnum_type_admit_board.cubalc — IFNUM/IFSTR/IFVARTYPE config type admit
#
# Real use: intake agents admit SLO/budget/role peels only when vars
# have the expected type — no TYPEOF+IF glue. First realworld of 1488
# IFNUM/IFSTR/IFVARTYPE/IFKIND (1.15.943 · MI 949). Distinct from
# payload_field_gate / field_contract (field names) — this board is
# *var type branches for config admit before numeric scale*.
#
#   IFNUM · IFSTR · IFVARTYPE · IFKIND · IFNUM_N · IFSTR_N · TYPEOF_N
#   FN-wrap (W853) · coerce path · undef soft · str≠num
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_itn_$$
#   ./out/cubalc run programs/realworld/svc_ifnum_type_admit_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt ITN_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_ITN_REQUIRE
#
# Edges: undef not num/str; str "0" not IFNUM; IFVARTYPE kind str/num/undef;
#   FN-wrap; STATUS bare; STRTO VAL

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN is_num
  IFNUM v
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_str
  IFSTR v
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_kind
  IFVARTYPE v kind
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_kind_alias
  IFKIND v kind
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# admit budget only when numeric and positive (sequential — no nest)
FN admit_budget
  LET state = "deny-not-num"
  LET ok_v = 0
  LET v = budget
  CALL is_num
  IF ok_v == 0 THEN
    LET state = "deny-not-num"
  ELSE
    IF budget > 0 THEN
      LET state = "admit"
      LET ok_v = 1
    ELSE
      LET state = "deny-zero"
      LET ok_v = 0
    END
  END
END

# role must be string non-empty contract
FN admit_role
  LET state = "deny-not-str"
  LET ok_v = 0
  LET v = role_v
  CALL is_str
  IF ok_v == 0 THEN
    LET state = "deny-not-str"
  ELSE
    SYS LEN role_v
    IF LAST_N > 0 THEN
      LET state = "admit"
      LET ok_v = 1
    ELSE
      LET state = "deny-empty-str"
      LET ok_v = 0
    END
  END
END

# peel ENV-like raw into typed budget (sequential type probes)
# Prefer NUMTO+NUMTO_OK — SYS NUM softens non-num to 0 with OK=1 (W880)
FN peel_budget
  LET v = raw
  LET state = "deny-undef"
  LET ok_v = 0
  CALL is_str
  IF ok_v == 1 THEN
    NUMTO v
    IF NUMTO_OK == 1 THEN
      LET budget = v
      LET state = "coerced"
      LET ok_v = 1
    ELSE
      LET state = "deny-nan"
      LET ok_v = 0
    END
  ELSE
    CALL is_num
    IF ok_v == 1 THEN
      LET budget = v
      LET state = "already-num"
      LET ok_v = 1
    ELSE
      LET state = "deny-undef"
      LET ok_v = 0
    END
  END
END

FN ghost_is_undef
  IFVARTYPE ghost_never_itn undef
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN ghost_is_num
  IFNUM ghost_never_itn
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN ghost_is_str
  IFSTR ghost_never_itn
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

NOTE "svc_ifnum_type_admit_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ifnum_type_admit -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_ITN_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "ITN_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "cfg"
LET cfg_dir = LAST
SYS JOIN cfg_dir "budget.txt"
LET budget_path = LAST
SYS JOIN cfg_dir "role.txt"
LET role_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET v = 0
LET kind = ""
LET state = ""
LET budget = 0
LET role_v = ""
LET raw = ""
LET saved = 0
LET nbytes = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-itn\",\"schema\":\"cubalc.svc_ifnum_type_admit.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"itn\",\"want_filter\":\"ifnum_type_admit\",\"cfg\":{\"surface\":\"IFNUM,IFSTR,IFVARTYPE,IFKIND,IFNUM_N,TYPEOF_N\",\"contract\":\"var type branches for config admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR cfg_dir
  CLEAR_ERR
  SYS WRITE budget_path "100"
  SYS WRITE role_path "worker"
  CLEAR_ERR
  LET v = 100
  CALL is_num
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-itn"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFNUM_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = TYPEOF_N
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot num"
      FAIL "boot num"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFNUM/IFSTR/IFVARTYPE core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET v = 42
  CALL is_num
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFNUM_N == 1 THEN
    LET score = score + 1
  END
  IF TYPEOF_N == 1 THEN
    LET score = score + 1
  END
  LET v = "hello"
  CALL is_num
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL is_str
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFSTR_N == 1 THEN
    LET score = score + 1
  END
  IF TYPEOF_N == 2 THEN
    LET score = score + 1
  END
  LET kind = "num"
  LET v = 7
  CALL is_kind
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFVARTYPE_N == 1 THEN
    LET score = score + 1
  END
  LET kind = "str"
  CALL is_kind
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — undef · str "0" · coerce · deny
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # undef ghost never set as num/str
  CALL ghost_is_undef
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL ghost_is_num
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL ghost_is_str
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # str "0" is str not num
  LET v = "0"
  CALL is_num
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL is_str
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # peel string budget
  LET raw = "64"
  CALL peel_budget
  SYS EQS state "coerced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF budget == 64 THEN
    LET score = score + 1
  END
  # already num
  LET raw = 32
  CALL peel_budget
  SYS EQS state "already-num"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # bad nan string
  LET raw = "abc"
  CALL peel_budget
  SYS EQS state "deny-nan"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # IFKIND alias
  LET v = "role"
  LET kind = "str"
  CALL is_kind_alias
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi typed fields admit
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cfg_dir
  CLEAR_ERR
  SYS READ OR budget_path OR "100"
  LET raw = LAST
  CLEAR_ERR
  CALL peel_budget
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET budget = 100
  CALL admit_budget
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET budget = 0
  CALL admit_budget
  SYS EQS state "deny-zero"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET budget = "nope"
  CALL admit_budget
  SYS EQS state "deny-not-num"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET role_v = "worker"
  CALL admit_role
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET role_v = ""
  CALL admit_role
  SYS EQS state "deny-empty-str"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET role_v = 99
  CALL admit_role
  SYS EQS state "deny-not-str"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET v = role_s
  CALL is_str
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifnum_type_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — type ladder then numeric scale
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET budget = 10
  CALL admit_budget
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET v = budget
  CALL is_num
  IF ok_v == 1 THEN
    LET budget = budget + budget
    LET score = score + 1
  ELSE
    LET miss = 1
  END
  CLEAR_ERR
  IF budget == 20 THEN
    LET score = score + 1
  END
  LET kind = "num"
  LET v = budget
  CALL is_kind
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # string scale path deny
  LET budget = "10"
  CALL admit_budget
  SYS EQS state "deny-not-num"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET raw = "25"
  CALL peel_budget
  SYS EQS state "coerced"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_budget
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF budget == 25 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFNUM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = budget
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFNUM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFSTR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFVARTYPE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFKIND"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENNUM"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENSTR"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFNUM_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifnum_type_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFNUM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFVARTYPE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — dual type contract budget+role
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET budget = 50
  LET role_v = "agent"
  CALL admit_budget
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_role
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET budget = 0
  CALL admit_budget
  SYS EQS state "deny-zero"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET budget = "x"
  CALL admit_budget
  SYS EQS state "deny-not-num"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET role_v = 1
  CALL admit_role
  SYS EQS state "deny-not-str"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET kind = "num"
  LET v = 1
  CALL is_kind
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET kind = "str"
  LET v = "a"
  CALL is_kind
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # numeric kind code 1 == num (proof uses IFVARTYPE s 2 for str)
  LET kind = 1
  LET v = 9
  CALL is_kind
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "var type"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — WRITE NL · NUM · stickies
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET v = 7
  CALL is_num
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET saved = IFNUM_N
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "ifnum=" IFNUM_N " typeof=" TYPEOF_N
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifnum="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "itn_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "itn_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-itn"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET v = "x"
  CALL is_str
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-itn\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_ifnum_type_admit_board: done"
PASS
