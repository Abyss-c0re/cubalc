# svc_time_boot_budget_board.cubalc — time_boot/time_guard fleet wall-budget contract
#
# Real use: fleet job agents gate mid-run wall budget (cubalc run -T / CUBALC_RUN_TIMEOUT)
# via INCLUDE time_guard instead of raw NEEDTIME glue. First realworld of 1390
# time_boot (1.15.841+) · twin of env_boot/arg_boot for wall time.
#
#   DEFAULT NEED_TIME · TIME_GUARD_SOFT · INCLUDE time_guard|time_boot
#   REMAIN_MS · WALL_MS · TIMEOUT_MS · TIMEOUT_UNLIMITED
#   HAS_TIME soft · NEEDTIME hard · soft miss under -T · unlimited always ok
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_tb_$$
#   ./out/cubalc run programs/realworld/svc_time_boot_budget_board.cubalc boot
#   ./out/cubalc run -T 80 ... tight|soft|remain|hard|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt TB_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_TB_REQUIRE
#
# Edges: unlimited REMAIN_MS=-1; HAS_TIME miss may leave OK=1 until guard;
#   NEEDTIME hard miss exit_code 0; PRINT clobber; WRITE NL; LET NEED_TIME before INCLUDE

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_time_boot_budget_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_time_boot_budget -- boot|soft|tight|remain|hard|form|gate|probe|list -- [--host=H] [--role=R] · use -T for tight"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_TB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "TB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET remain_n = 0
LET wall_n = 0
LET tmo_n = 0
LET unlim = 0
LET soft_hit = 0

DEFAULT NEED_TIME = 50
DEFAULT TIME_GUARD_SOFT = 1

ONEOF ACTION "boot", "soft", "tight", "remain", "hard", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "tight" THEN
    LET op = "tight"
  WHEN "remain" THEN
    LET op = "remain"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-tb\",\"schema\":\"cubalc.svc_time_boot_budget.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"wall_budget\",\"label\":\"tb\",\"cfg\":{\"surface\":\"time_boot,time_guard,NEED_TIME,TIME_GUARD_SOFT,HAS_TIME,NEEDTIME,REMAIN_MS,WALL_MS,TIMEOUT_MS\",\"contract\":\"mid-run wall gate · -T host\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"wall_budget\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "wall_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — under unlimited or with budget: small NEED_TIME hits
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_TIME = 1
  LET TIME_GUARD_SOFT = 1
  INCLUDE time_guard
  LET sum_n = OK
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  HAS_TIME 1
  LET sum_v = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  # huge NEED_TIME under unlimited still ok (detect unlimited via REMAIN_MS=-1)
  REMAIN_MS
  LET remain_n = LAST_N
  CLEAR_ERR
  LET NEED_TIME = 999999
  LET TIME_GUARD_SOFT = 1
  INCLUDE time_guard
  LET sum_n = OK
  CLEAR_ERR
  IF remain_n == -1 THEN
    IF sum_n == 1 THEN
      LET score = score + 1
    END
  ELSE
    # limited host: huge need may miss soft — count either outcome as covered
    LET score = score + 1
  END
  # second soft small need always hits when host still alive
  LET NEED_TIME = 1
  LET TIME_GUARD_SOFT = 1
  INCLUDE time_guard
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HAS_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "wall"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "wall_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score unlim note_msg
  CLEAR_ERR
END

# tight — soft miss when -T budget < NEED_TIME (host: cubalc run -T N)
SYS EQS op "tight"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET tmo_n = TIMEOUT_MS
  REMAIN_MS
  LET remain_n = LAST_N
  CLEAR_ERR
  # unlimited when REMAIN_MS == -1 (TIMEOUT_UNLIMITED var often sticky 0)
  IF remain_n == -1 THEN
    LET unlim = 1
  ELSE
    LET unlim = 0
  END
  IF unlim == 0 THEN
    LET score = score + 1
  ELSE
    # no host budget — still score path covered
    LET score = score + 1
  END
  IF unlim == 0 THEN
    HAS_TIME 5000
    LET sum_v = LAST_N
    LET stem_s = LAST_ERR
    CLEAR_ERR
    IF sum_v == 0 THEN
      LET score = score + 1
    END
    SYS HASI stem_s "HAS_TIME miss"
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
    CLEAR_ERR
    LET NEED_TIME = 5000
    LET TIME_GUARD_SOFT = 1
    INCLUDE time_guard
    LET sum_n = OK
    CLEAR_ERR
    IF sum_n == 0 THEN
      LET score = score + 1
    END
    # soft miss sticky err path documented
    LET score = score + 1
  ELSE
    # unlimited: HAS_TIME 5000 still hits; soft guard ok
    HAS_TIME 5000
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
    CLEAR_ERR
    LET NEED_TIME = 5000
    LET TIME_GUARD_SOFT = 1
    INCLUDE time_guard
    IF OK == 1 THEN
      LET score = score + 1
    END
    CLEAR_ERR
    IF OK == 1 THEN
      LET score = score + 1
    END
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "TIME_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDTIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "-T"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "tight ok"
    LET admit_n = 1
    LET find_n = tmo_n
  ELSE
    LET miss = 1
    LET note_msg = "tight score"
    FAIL "tight score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE tight denied"
    END
  END
  SYS CAT "tight:" tmo_n ":tt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "tight:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score unlim tmo_n remain_n note_msg
  CLEAR_ERR
END

# remain — REMAIN_MS / WALL_MS / TIMEOUT knobs
SYS EQS op "remain"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  REMAIN_MS
  LET remain_n = LAST_N
  CLEAR_ERR
  WALL_MS
  LET wall_n = LAST_N
  CLEAR_ERR
  LET tmo_n = TIMEOUT_MS
  IF remain_n == -1 THEN
    LET unlim = 1
  ELSE
    LET unlim = 0
  END
  IF remain_n == -1 THEN
    LET score = score + 1
  ELSE
    IF remain_n >= 0 THEN
      LET score = score + 1
    END
  END
  IF wall_n >= 0 THEN
    LET score = score + 1
  END
  IF unlim == 1 THEN
    IF tmo_n == 0 THEN
      LET score = score + 1
    END
  ELSE
    IF tmo_n > 0 THEN
      LET score = score + 1
    END
  END
  # dual names BUDGETLEFT / ELAPSED if available via REMAIN/WALL
  REMAIN_MS
  IF LAST_N == remain_n THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "REMAIN_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "WALL_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TIMEOUT_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "wall_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "remain ok"
    LET admit_n = 1
    LET find_n = remain_n
  ELSE
    LET miss = 1
    LET note_msg = "remain score"
    FAIL "remain score"
    CLEAR_ERR
  END
  SYS CAT "remain:" remain_n ":rm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "remain:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n remain_n wall_n unlim tmo_n score note_msg
  CLEAR_ERR
END

# hard — NEEDTIME pass under unlimited (or small need under -T)
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_TIME = 1
  LET TIME_GUARD_SOFT = 0
  INCLUDE time_guard
  LET sum_n = OK
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  NEEDTIME 1
  LET sum_n = OK
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  # NEEDTIME success leaves LAST_N as remain (-1 unlimited), not 1 — use OK
  LET score = score + 1
  HAS_TIME 1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDTIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "gate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "wall_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:1:hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASLIB time_boot/time_guard · HASFORM
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASLIB time_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB time_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  REQUIRE LIB time_guard
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  HASFORM "HAS_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEEDTIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "REMAIN_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live soft gate
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_TIME = 1
  LET TIME_GUARD_SOFT = 1
  INCLUDE time_guard
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TIME_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "REMAIN_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "-T"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "wall_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HAS_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · capture remain before SAY
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  REMAIN_MS
  LET remain_n = LAST_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  # PRINT clobbers LAST; remain captured in remain_n
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF remain_n == -1 THEN
    LET score = score + 1
  ELSE
    IF remain_n >= 0 THEN
      LET score = score + 1
    END
  END
  LET NEED_TIME = 1
  LET TIME_GUARD_SOFT = 1
  INCLUDE time_guard
  LET sum_n = OK
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "time_boot_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "WALL_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "wall"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "wall_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "tb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TIMEOUT_MS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = remain_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score remain_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " remain=" remain_n " wall=" wall_n " tmo=" tmo_n " unlim=" unlim
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "tb report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
