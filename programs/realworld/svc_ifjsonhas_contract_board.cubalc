# svc_ifjsonhas_contract_board.cubalc — IFJSONHAS/IFJSONMISS plate key contracts
#
# Real use: service agents admit/seed JSON plate contracts by key
# presence without SYS JSONHAS+IF glue. First realworld of 1487
# IFJSONHAS/IFJSONMISS/IFHASJSON (1.15.942 · MI 948). Distinct from
# agent_json_plate_contract / schema_contract (older surfaces) — this
# board is *key-branch path for plate admit / default-if-miss*.
#
#   IFJSONHAS · IFJSONMISS · IFHASJSON · IFJSONHAS_N · JSONHAS_N
#   FN-wrap (W853) · seed-if-miss · deny-incomplete · empty→miss
#   NOTE: do not name key-var `key` — KEY is glue (W877); use jkey.
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ijh_$$
#   ./out/cubalc run programs/realworld/svc_ifjsonhas_contract_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IJH_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_IJH_REQUIRE
#
# Edges: empty plate miss; bad json soft; key via jkey var;
#   seed status if miss; FN-wrap; STATUS bare; STRTO VAL

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN has_key
  IFJSONHAS plate jkey
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN has_json
  IFHASJSON plate jkey
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN miss_key
  IFJSONMISS plate jkey
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# seed jkey default when miss (contract hygiene)
FN seed_if_miss
  IFJSONMISS plate jkey
    SYS CAT plate
    LET body = LAST
    CLEAR_ERR
    # naive seed: replace trailing } with ,"jkey":"seeded"}
    SYS CAT "{\"ok\":1,\"n\":1,\"role\":\"agent\",\"status\":\"seeded\"}"
    LET plate = LAST
    LET state = "seeded"
    LET ok_v = 1
  ELSE
    LET state = "present"
    LET ok_v = 0
  END
END

# admit only when all contract keys present (sequential — nested IFJSONHAS
# steals END frames when FN body is later CALLed from action IF · W853)
FN admit_contract
  LET state = "deny-miss-ok"
  LET ok_v = 0
  LET jkey = "ok"
  CALL has_key
  IF ok_v == 0 THEN
    LET state = "deny-miss-ok"
  ELSE
    LET jkey = "role"
    CALL has_key
    IF ok_v == 0 THEN
      LET state = "deny-miss-role"
    ELSE
      LET jkey = "status"
      CALL has_key
      IF ok_v == 0 THEN
        LET state = "deny-miss-status"
      ELSE
        LET state = "admit"
        LET ok_v = 1
      END
    END
  END
END

NOTE "svc_ifjsonhas_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ifjsonhas_contract -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IJH_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IJH_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "contract.json"
LET contract_path = LAST
SYS JOIN plate_dir "partial.json"
LET partial_path = LAST
SYS JOIN plate_dir "empty.json"
LET empty_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET plate = ""
LET jkey = ""
LET state = ""
LET nbytes = 0
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ijh\",\"schema\":\"cubalc.svc_ifjsonhas_contract.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ijh\",\"want_filter\":\"ifjsonhas_contract\",\"cfg\":{\"surface\":\"IFJSONHAS,IFJSONMISS,IFHASJSON,IFJSONHAS_N,JSONHAS_N\",\"contract\":\"JSON plate jkey branches for admit/seed\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE contract_path "{\"ok\":1,\"n\":1,\"role\":\"agent\",\"status\":\"ready\"}"
  CLEAR_ERR
  SYS READ contract_path
  LET plate = LAST
  CLEAR_ERR
  LET jkey = "ok"
  CALL has_key
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ijh"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFJSONHAS_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = JSONHAS_N
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot has"
      FAIL "boot has"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFJSONHAS/IFJSONMISS/IFHASJSON core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  LET plate = "{\"ok\":1,\"n\":42,\"role\":\"agent\"}"
  LET jkey = "ok"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFJSONHAS_N == 1 THEN
    LET score = score + 1
  END
  IF JSONHAS_N == 1 THEN
    LET score = score + 1
  END
  CALL has_json
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET jkey = "missing"
  CALL has_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF IFJSONHAS_N == 0 THEN
    LET score = score + 1
  END
  LET jkey = "err"
  CALL miss_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFJSONMISS_N == 1 THEN
    LET score = score + 1
  END
  LET jkey = "ok"
  CALL miss_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # bare jkey name via LET jkey = role path — use quoted "role"
  LET jkey = "role"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — empty · bad · seed · miss paths
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  # empty object → all keys miss
  LET plate = "{}"
  LET jkey = "ok"
  CALL has_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL miss_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # empty string plate
  LET plate = ""
  CALL has_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL miss_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # non-json soft (not has)
  LET plate = "not-json"
  CALL has_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL miss_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # seed_if_miss when status absent
  LET plate = "{\"ok\":1,\"n\":1,\"role\":\"agent\"}"
  LET jkey = "status"
  CALL seed_if_miss
  SYS EQS state "seeded"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET jkey = "status"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # seed again → present
  CALL seed_if_miss
  SYS EQS state "present"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # admit after seed
  CALL admit_contract
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi plate shapes (tiny / mid / fat keys)
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  LET plate = "{}"
  LET jkey = "ok"
  CALL has_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET plate = "{\"ok\":1}"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET plate = "{\"ok\":1,\"role\":\"agent\",\"n\":7,\"status\":\"ready\",\"site\":\"cubeR\"}"
  LET jkey = "role"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET jkey = "site"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET jkey = "ghost"
  CALL miss_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL admit_contract
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # partial: no status
  LET plate = "{\"ok\":1,\"role\":\"agent\"}"
  CALL admit_contract
  SYS EQS state "deny-miss-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # no role
  LET plate = "{\"ok\":1}"
  CALL admit_contract
  SYS EQS state "deny-miss-role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifjsonhas_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — contract ladder: bare → seed → admit → strip → deny
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  LET plate = "{\"ok\":1}"
  CALL admit_contract
  SYS EQS state "deny-miss-role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"ok\":1,\"role\":\"agent\"}"
  CALL admit_contract
  SYS EQS state "deny-miss-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET jkey = "status"
  CALL seed_if_miss
  SYS EQS state "seeded"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_contract
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET jkey = "ok"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET jkey = "status"
  CALL miss_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # strip to incomplete
  LET plate = "{\"n\":9}"
  CALL admit_contract
  SYS EQS state "deny-miss-ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET jkey = "n"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFJSONHAS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFJSONHAS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFJSONMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFHASJSON"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "WHENJSONHAS"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENJSONMISS"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFJSONHAS_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONHAS_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifjsonhas_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFJSONHAS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFJSONMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — full contract admit; deny partials; empty deny
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  LET plate = "{\"ok\":1,\"role\":\"agent\",\"status\":\"ready\"}"
  CALL admit_contract
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{}"
  CALL admit_contract
  SYS EQS state "deny-miss-ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"ok\":1}"
  CALL admit_contract
  SYS EQS state "deny-miss-role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"ok\":1,\"role\":\"agent\"}"
  CALL admit_contract
  SYS EQS state "deny-miss-status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET jkey = "status"
  CALL seed_if_miss
  SYS EQS state "seeded"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_contract
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # literal plate string path via FN (no bare IFJSONHAS in action IF)
  LET plate = "{\"x\":1}"
  LET jkey = "x"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jkey branches"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk plate · WRITE NL · NUM · sticky
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE contract_path "{\"ok\":1,\"n\":7,\"role\":\"agent\",\"status\":\"ready\"}"
  CLEAR_ERR
  SYS READ contract_path
  LET plate = LAST
  CLEAR_ERR
  LET jkey = "n"
  CALL has_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF JSONHAS_N == 1 THEN
    LET score = score + 1
  END
  LET saved = JSONHAS_N
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "jsonhas=" JSONHAS_N " miss_n=" IFJSONMISS_N
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsonhas="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "ijh_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "ijh_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ijh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET jkey = "ghost"
  CALL miss_key
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ijh\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_ifjsonhas_contract_board: done"
PASS
