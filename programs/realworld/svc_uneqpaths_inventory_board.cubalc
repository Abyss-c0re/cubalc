# svc_uneqpaths_inventory_board.cubalc — UNEQPATHS bulk diverge path inventory
#
# Real use: fleet canary rollback needs ALL inconsistent leaf paths, not only
# the first (FIRSTUNEQFLAT). Bulk nest inconsistency without EACH FLAT+IF+PUSH.
# First realworld of proof 1251 UNEQPATHS/DIVERGEPATHS (MEANINGFUL chain).
#
#   UNEQPATHS|DIVERGEPATHS [FROM plate] needle
#   LAST = newline bag of diverge paths · LAST_N = path count
#   UNEQPATHS_TOTAL matching leaves · UNEQPATHS_REF first/ref value
#   UNEQPATHS_SRC plate name when FROM · soft empty LAST_N=0
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sup_$$
#   ./out/cubalc run programs/realworld/svc_uneqpaths_inventory_board.cubalc boot
#   ./out/cubalc run ... find|multi|peer|unify|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SUP_REPORT.txt PATHS.txt agent.json peer.json mix.json
# Env: HOST_S ROLE_S CUBALC_SUP_REQUIRE
#
# Edges: single other.role; multi MIX 3 paths; peer multi; SETBYVAL empty;
#   soft ghost; DIVERGEPATHS alias; WRITE NL; REQUIRE softens; empty needle

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_uneqpaths_inventory_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_uneqpaths_inventory -- boot|find|multi|peer|unify|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeU"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SUP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "mix.json"
LET mix_path = LAST
SYS JOIN state_dir "PATHS.txt"
LET paths_file = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SUP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ref_v = ""
LET total_n = 0

ONEOF ACTION "boot", "find", "multi", "peer", "unify", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "find" THEN
    LET op = "find"
  WHEN "multi" THEN
    LET op = "multi"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "unify" THEN
    LET op = "unify"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-uneqpaths\",\"schema\":\"cubalc.svc_uneqpaths_inventory.v1\",\"site\":\"" host_s "\",\"agent_job\":\"runner\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"worker\",\"host\":\"h1\"},\"other\":{\"host\":\"h2\",\"role\":\"leader\"},\"label\":\"uneqpaths\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_uneqpaths_inventory.v1\",\"site\":\"" host_s "\",\"a\":{\"status\":\"ok\"},\"b\":{\"status\":\"ok\"},\"c\":{\"status\":\"ok\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  # mix plate: multi-canary role inventory
  SYS CAT "{\"w1\":{\"role\":\"worker\"},\"w2\":{\"role\":\"leader\"},\"w3\":{\"role\":\"leader\"},\"w4\":{\"role\":\"standby\"},\"tag\":\"mix\"}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE mix_path body
  CLEAR_ERR
  LET score = 0
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:roles:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# find — single diverge path other.role (+ host)
SYS EQS op "find"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  SETP "cfg.host" "h1"
  CLEAR_ERR
  SETP "other.host" "h2"
  CLEAR_ERR
  UNEQPATHS "role"
  LET find_n = LAST_N
  LET body = LAST
  LET total_n = UNEQPATHS_TOTAL
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "other.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS UNEQPATHS_REF "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF total_n == 3 THEN
    LET score = score + 1
  END
  UNEQPATHS "host"
  LET admit_n = LAST_N
  LET row = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS row "other.host"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE paths_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "find ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "find score"
    FAIL "find score"
    CLEAR_ERR
  END
  SYS CAT "find:" body ":fd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "find:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n total_n score note_msg
  CLEAR_ERR
END

# multi — FROM MIX bag of 3 diverge paths (not first-only)
SYS EQS op "multi"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS READ OR mix_path OR ""
  LET MIX = LAST
  CLEAR_ERR
  SYS HAS MIX "w1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNEQPATHS FROM MIX "role"
  LET find_n = LAST_N
  LET body = LAST
  LET total_n = UNEQPATHS_TOTAL
  CLEAR_ERR
  IF find_n == 3 THEN
    LET score = score + 1
  END
  IF total_n == 4 THEN
    LET score = score + 1
  END
  SYS EQS UNEQPATHS_REF "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS UNEQPATHS_SRC "MIX"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "w2.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "w3.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "w4.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # first leaf (w1) is REF — not listed as diverge
  SYS HASLINE body "w1.role"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # FIRSTUNEQFLAT only returns one; UNEQPATHS returns all
  FIRSTUNEQFLAT FROM MIX "role"
  LET admit_n = LAST_N
  LET row = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS row "w2.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE paths_file body
  CLEAR_ERR
  IF score == 11 THEN
    LET hit = 1
    LET note_msg = "multi ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "multi score"
    FAIL "multi score"
    CLEAR_ERR
  END
  SYS CAT "multi:" find_n ":mu"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "multi:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n total_n score note_msg
  CLEAR_ERR
END

# peer — uniform miss then multi-status diverge bag
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP FROM PEER "a.status" "ok"
  CLEAR_ERR
  SETP FROM PEER "b.status" "ok"
  CLEAR_ERR
  SETP FROM PEER "c.status" "ok"
  CLEAR_ERR
  UNEQPATHS FROM PEER "status"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  SETP FROM PEER "b.status" "fail"
  CLEAR_ERR
  SETP FROM PEER "c.status" "degraded"
  CLEAR_ERR
  UNEQPATHS FROM PEER "status"
  LET find_n = LAST_N
  LET body = LAST
  LET total_n = UNEQPATHS_TOTAL
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF total_n == 3 THEN
    LET score = score + 1
  END
  SYS EQS UNEQPATHS_REF "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "b.status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "c.status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # a.status is REF — not in bag
  SYS HASLINE body "a.status"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SETP FROM PEER "b.status" "ok"
  CLEAR_ERR
  SETP FROM PEER "c.status" "ok"
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  SYS WRITE paths_file body
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" find_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n total_n score note_msg
  CLEAR_ERR
END

# unify — SETBYVAL then empty diverge bag
SYS EQS op "unify"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  UNEQPATHS "role"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  SETBYVAL "leader" "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  UNEQPATHS "role"
  LET find_n = LAST_N
  LET body = LAST
  LET total_n = UNEQPATHS_TOTAL
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF total_n == 3 THEN
    LET score = score + 1
  END
  UNIFORMFLAT "role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE paths_file body
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "unify ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "unify score"
    FAIL "unify score"
    CLEAR_ERR
  END
  SYS CAT "unify:0:un"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "unify:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — ghost + single leaf never diverge
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  UNEQPATHS "ghostpath"
  LET find_n = LAST_N
  LET body = LAST
  LET total_n = UNEQPATHS_TOTAL
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF total_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNEQPATHS "label"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  UNEQPATHS "agent_job"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — admit when no role diverge
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "worker"
  CLEAR_ERR
  UNEQPATHS "role"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  UNEQPATHS FROM PEER "status"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_uneqpaths_inventory"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNIFORMFLAT "role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — DIVERGEPATHS dual
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  DIVERGEPATHS "role"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "other.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # Prefer special direct (LET ref_v can fail under 128-var pressure → unknown form)
  SYS EQS DIVERGEPATHS_REF "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SETP "other.role" "worker"
  CLEAR_ERR
  DIVERGEPATHS "role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE paths_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" body ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — empty needle + false friends + substring
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "a" "1"
  CLEAR_ERR
  SETP "b" "1"
  CLEAR_ERR
  SETP "c" "2"
  CLEAR_ERR
  UNEQPATHS ""
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n > 0 THEN
    LET score = score + 1
  END
  SYS HAS body "c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNEQPATHS "nope"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  # substring false friend: needle "rol" matches path segment "role" (not token-exact)
  UNEQPATHS "rol"
  LET admit_n = LAST_N
  LET row = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS row "other.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNEQPATHS "role"
  LET admit_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "other.role"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "uneqpaths"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE paths_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" body ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_uneqpaths_inventory.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " total=" total_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_uneqpaths_inventory_board: end"
