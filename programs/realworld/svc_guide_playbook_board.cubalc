# svc_guide_playbook_board.cubalc — GUIDE playbook + FORMTOPICS + ERRGUIDE
#
# Real use: fleet agents pull a full discovery playbook plate (GUIDE =
# hint+related+tips+forms+snip), reverse-map forms to covering topics
# (FORMTOPICS), and one-shot classify sticky incidents into a playbook
# (ERRGUIDE/RECOVERGUIDE) without cookbook scrape.
# First realworld of proofs 1341 FORMTOPICS + 1342 GUIDE + 1343 ERRGUIDE.
#
#   GUIDE|PLAYGUIDE [topic] → cubalc.guide.v1 · GUIDE_* bags/counts
#   FORMTOPICS|TOPICSOF form → covering topics · FORMTOPICS_OF/N
#   ERRGUIDE|RECOVERGUIDE [err] → ERRGUIDE_TOPIC + GUIDE playbook
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sgp_$$
#   ./out/cubalc run programs/realworld/svc_guide_playbook_board.cubalc boot
#   ./out/cubalc run ... guide|forms|recover|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SGP_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SGP_REQUIRE TOPIC_S
#
# Edges: PRINT clobbers GUIDE JSON; FORMTOPICS self-name needs quotes;
#   soft miss; sticky FAIL→ERRGUIDE; WRITE NL; forms→cap

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_guide_playbook_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_guide_playbook -- boot|guide|forms|recover|soft|gate|alias|probe|list -- [--host=H] [--role=R] [--topic=T]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT TOPIC_S = "plate"
GETFLAG topic|t OR ENV TOPIC_S OR TOPIC_S
LET topic_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SGP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SGP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET rel_n = 0
LET tips_n = 0
LET forms_n = 0
LET topic_got = ""

ONEOF ACTION "boot", "guide", "forms", "recover", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "guide" THEN
    LET op = "guide"
  WHEN "forms" THEN
    LET op = "forms"
  WHEN "recover" THEN
    LET op = "recover"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s topic_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  SYS TRIM topic_s
  LET topic_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-guide\",\"schema\":\"cubalc.svc_guide_playbook.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"playbook\",\"label\":\"guide\",\"cfg\":{\"topic\":\"" topic_s "\",\"surface\":\"GUIDE,FORMTOPICS,ERRGUIDE\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"playbook\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_guide_playbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.topic"
  SYS EQS LAST topic_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "GUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# guide — full playbook plate (capture JSON before PRINT)
SYS EQS op "guide"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  GUIDE topic_s
  LET body = LAST
  LET topic_got = TOPIC_NAME
  LET rel_n = GUIDE_RELATED_N
  LET tips_n = GUIDE_TIPS_N
  LET forms_n = GUIDE_FORMS_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  IF tips_n >= 1 THEN
    LET score = score + 1
  END
  IF forms_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.guide.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # default general
  GUIDE
  LET stem_s = TOPIC_NAME
  CLEAR_ERR
  SYS EQS stem_s "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # forms synonym → cap
  GUIDE forms
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "GUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "guide ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "guide score"
    FAIL "guide score"
    CLEAR_ERR
  END
  SYS CAT "guide:" forms_n ":gd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "guide:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n rel_n tips_n forms_n score note_msg
  CLEAR_ERR
END

# forms — FORMTOPICS reverse map
SYS EQS op "forms"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FORMTOPICS SETP
  LET body = LAST
  LET stem_s = FORMTOPICS_OF
  LET sum_n = FORMTOPICS_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMTOPICS HASFORM
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMTOPICS INCLUDE
  LET sum_n = FORMTOPICS_N
  LET body = LAST
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE body "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # quoted self-name
  FORMTOPICS "FORMTOPICS"
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # chain first topic → GUIDE
  FORMTOPICS HASFORM
  SYS NTH 0 LAST
  LET stem_s = LAST
  CLEAR_ERR
  GUIDE stem_s
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMTOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "forms ok"
    LET admit_n = 1
    LET find_n = sum_n
  ELSE
    LET miss = 1
    LET note_msg = "forms score"
    FAIL "forms score"
    CLEAR_ERR
  END
  SYS CAT "forms:" sum_n ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "forms:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n topic_got score note_msg
  CLEAR_ERR
END

# recover — ERRGUIDE classify + playbook
SYS EQS op "recover"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  CLEAR_ERR
  ERRGUIDE
  LET topic_got = ERRGUIDE_TOPIC
  LET rel_n = GUIDE_RELATED_N
  LET body = LAST
  CLEAR_ERR
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.errguide.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FAIL "INCLUDE missing hold_seed"
  ERRGUIDE
  LET topic_got = ERRGUIDE_TOPIC
  LET body = LAST
  LET tips_n = ERRTIPS_N
  LET rel_n = GUIDE_RELATED_N
  CLEAR_ERR
  SYS EQS topic_got "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF tips_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASI body "LISTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ERRGUIDE "SMX DIAL timeout"
  LET topic_got = ERRGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RECOVERGUIDE "VARROOM NEEDVARROOM"
  LET topic_got = ERRGUIDE_TOPIC
  LET rel_n = GUIDE_RELATED_N
  CLEAR_ERR
  SYS EQS topic_got "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "ERRGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "recover ok"
    LET admit_n = 1
    LET find_n = tips_n
  ELSE
    LET miss = 1
    LET note_msg = "recover score"
    FAIL "recover score"
    CLEAR_ERR
  END
  SYS CAT "recover:" tips_n ":rc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "recover:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n topic_got score note_msg
  CLEAR_ERR
END

# soft — miss paths
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GUIDE zzz_nope
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  FORMTOPICS ZZZ_NO_SUCH_FORM
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  FORMTOPICS
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "playbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "GUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate surface + live GUIDE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.topic"
  LET topic_s = LAST
  CLEAR_ERR
  GUIDE topic_s
  LET forms_n = GUIDE_FORMS_N
  LET rel_n = GUIDE_RELATED_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF forms_n >= 2 THEN
    LET score = score + 1
  END
  IF rel_n >= 3 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "GUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMTOPICS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ERRGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "guide_playbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n rel_n score note_msg
  CLEAR_ERR
END

# alias — PLAYGUIDE / TOPICSOF / RECOVERGUIDE
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PLAYGUIDE forms
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPICSOF SETP
  LET stem_s = FORMTOPICS_OF
  LET body = LAST
  CLEAR_ERR
  SYS EQS stem_s "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RECOVERGUIDE "ASSERT is false"
  LET topic_got = ERRGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "run"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ERRGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topic_got score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + FORMTOPICS bare-name trap note
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GUIDE plate
  LET body = LAST
  LET forms_n = GUIDE_FORMS_N
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASI stem_s "cubalc.guide.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI LAST "cubalc.guide.v1"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # mesh synonym
  GUIDE mesh
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMTOPICS STATUS
  LET body = LAST
  LET sum_n = FORMTOPICS_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE body "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ERRGUIDE "NEEDP missing key"
  LET topic_got = ERRGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF forms_n >= 2 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "guide_playbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = forms_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" forms_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n forms_n topic_got score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_guide_playbook.v1 host=" host_s " role=" role_s " topic=" topic_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " rel_n=" rel_n " tips_n=" tips_n " forms_n=" forms_n " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_guide_playbook_board: done"
PASS
