# svc_nest_mergeobj_board.cubalc — MERGEOBJ/DEFAULTOBJ nested service config
#
# Real use: fleet service agents keep durable nested cfg/limits/labels on the
# agent plate and a peer overlay for mesh handoff. One-shot MERGEOBJ clobbers
# keys (fleet overlay wins); DEFAULTOBJ fills missing only (no clobber). Avoids
# GETOBJ+MERGEP+SETOBJ glue for nest merge (proof 1171 / MEANINGFUL 630).
#
#   MERGEOBJ "cfg" overlay         · PATCHNEST alias
#   DEFAULTOBJ "cfg" defaults      · ENSUREOBJ alias
#   MERGEOBJ FROM PEER "cfg" …
#   DEFAULTOBJ "cfg" … FROM PEER
#   GETOBJ "cfg" [OR "{}"] [INTO X]
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_snm_$$
#   ./out/cubalc run programs/realworld/svc_nest_mergeobj_board.cubalc boot
#   ./out/cubalc run ... defaults|overlay|peer|peel|patch|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt SNM_REPORT.txt agent.json peer.json cfg.txt
# Env: HOST_S ROLE_S PORT_S CUBALC_SNM_REQUIRE
#
# Edges:
#   DEFAULTOBJ no-clobber; MERGEOBJ wins; soft non-object overlay;
#   soft GETOBJ OR; scalar nest replace; WRITE omit NL; NUM softens REQUIRE

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_nest_mergeobj_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_nest_mergeobj -- boot|defaults|overlay|peer|peel|patch|gate|probe|soft|list -- [--host=H] [--role=R] [--port=P]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeS"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

DEFAULT PORT_S = "9090"
GETFLAG port|p OR ENV PORT_S OR PORT_S
LET port_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SNM_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SNM_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "cfg.txt"
LET cfg_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET cfg_json = ""
LET port_n = 0
LET merge_n = 0
LET def_n = 0
LET soft_ok = 0
LET gate_ok = 0
LET applied = 0

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "defaults", "overlay", "peer", "peel", "patch", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "defaults" THEN
    LET op = "defaults"
  WHEN "overlay" THEN
    LET op = "overlay"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "patch" THEN
    LET op = "patch"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s port_s
  CLEAR_ERR
END

# boot — seed nested agent + peer plates (cfg/limits/labels)
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  # nested seed: cfg partial, limits partial, labels empty-ish, outer identity
  SYS CAT "{\"agent\":\"svc-nest\",\"schema\":\"cubalc.svc_nest_mergeobj.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"cfg\":{\"port\":8080,\"retries\":2},\"limits\":{\"cpu\":1},\"labels\":{\"env\":\"dev\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"zone\":\"us-east\",\"cfg\":{\"port\":8080},\"schema\":\"cubalc.svc_nest_mergeobj.v1\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETOBJ "cfg"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS WRITE cfg_path cfg_json
  CLEAR_ERR
  SYS HAS cfg_json "8080"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST host_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  TYPEP "cfg"
  SYS EQS LAST "obj"
  LET load_hit = LAST_N
  CLEAR_ERR
  TYPEP "limits"
  SYS EQS LAST "obj"
  LET take_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET created = 1
          LET merge_n = 2
          SYS CAT "boot:" host_s ":bt"
          LET row = LAST
          CLEAR_ERR
          SYS GREPV "boot:" bag
          LET bag = LAST
          CLEAR_ERR
          SYS PUSH bag row
          LET bag = LAST
          LET bag_ch = 1
        ELSE
          LET miss = 1
          LET note_msg = "boot limits type"
          FAIL "boot limits type"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot cfg type"
        FAIL "boot cfg type"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot host"
      FAIL "boot host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot cfg port"
    FAIL "boot cfg port"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit take_n note_msg
  CLEAR_ERR
END

# defaults — DEFAULTOBJ fill missing only (no clobber of port/retries)
SYS EQS op "defaults"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # seed missing timeout + mem; try clobber port/retries (must not win)
  DEFAULTOBJ "cfg" "{\"port\":1,\"retries\":99,\"timeout\":30,\"tls\":0}"
  LET applied = MERGEOBJ_DEFAULT
  CLEAR_ERR
  DEFAULTOBJ "limits" "{\"cpu\":99,\"mem\":512,\"disk\":10}"
  LET def_n = MERGEOBJ_DEFAULT
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETOBJ "cfg"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS WRITE cfg_path cfg_json
  CLEAR_ERR
  # port still 8080 (boot), not 1
  SYS HAS cfg_json "\"port\":8080"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "\"timeout\":30"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "\"retries\":2"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETOBJ "limits"
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "\"mem\":512"
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HAS body "\"cpu\":1"
  LET merge_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF merge_n == 1 THEN
            LET hit = 1
            LET note_msg = "defaults ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "defaults cpu clobber"
            FAIL "defaults cpu clobber"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "defaults mem fill"
          FAIL "defaults mem fill"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "defaults retries"
        FAIL "defaults retries"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "defaults timeout"
      FAIL "defaults timeout"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "defaults port clobber"
    FAIL "defaults port clobber"
    CLEAR_ERR
  END
  SYS CAT "defaults:to" applied ":df"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "defaults:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit take_n applied note_msg
  CLEAR_ERR
END

# overlay — MERGEOBJ fleet wins (port + tls)
SYS EQS op "overlay"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS TRIM port_s
  LET port_s = LAST
  CLEAR_ERR
  SYS NUM port_s
  IF OK == 1 THEN
    LET port_n = LAST_N
  ELSE
    LET port_n = 9090
  END
  CLEAR_ERR
  SYS CAT "{\"port\":" port_n ",\"tls\":1,\"zone\":\"edge\"}"
  LET body = LAST
  CLEAR_ERR
  MERGEOBJ "cfg" body
  LET merge_n = MERGEOBJ_N
  CLEAR_ERR
  # labels overlay (env promote)
  MERGEOBJ "labels" "{\"env\":\"prod\",\"tier\":\"hot\"}"
  LET applied = MERGEOBJ_N
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETOBJ "cfg"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS WRITE cfg_path cfg_json
  CLEAR_ERR
  SYS STR port_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "\"port\":" w_s
  LET d_s = LAST
  CLEAR_ERR
  SYS HAS cfg_json d_s
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "\"tls\":1"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "zone"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETOBJ "labels"
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "prod"
  LET take_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          LET hit = 1
          LET note_msg = "overlay ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "overlay labels"
          FAIL "overlay labels"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "overlay zone"
        FAIL "overlay zone"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "overlay tls"
      FAIL "overlay tls"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "overlay port"
    FAIL "overlay port"
    CLEAR_ERR
  END
  SYS CAT "overlay:" w_s ":ov"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "overlay:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit merge_n take_n note_msg
  CLEAR_ERR
END

# peer — MERGEOBJ/DEFAULTOBJ FROM PEER (mesh handoff nest)
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # Merge into PEER nest; verify via GETOBJ FROM PEER + SYS HAS
  # (MERGEOBJ_SRC/FROM specials are flaky to LET/SYS EQS in long boards)
  MERGEOBJ FROM PEER "cfg" "{\"tls\":1,\"zone\":\"A\"}"
  CLEAR_ERR
  DEFAULTOBJ "cfg" "{\"port\":1,\"retries\":3,\"timeout\":45}" FROM PEER
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETOBJ FROM PEER "cfg"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS WRITE cfg_path cfg_json
  CLEAR_ERR
  SYS HAS cfg_json "\"tls\":1"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "zone"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # port stays 8080 from peer seed; retries filled by default (no clobber)
  SYS HAS cfg_json "\"port\":8080"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "retries"
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "timeout"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # outer peer identity intact
  GETP FROM PEER "agent"
  SYS EQS LAST "hive-peer"
  LET applied = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF soft_ok == 1 THEN
            IF applied == 1 THEN
              LET hit = 1
              LET note_msg = "peer ok"
              LET admit_n = 1
              LET merge_n = 2
            ELSE
              LET miss = 1
              LET note_msg = "peer agent"
              FAIL "peer agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer timeout fill"
            FAIL "peer timeout fill"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer retries fill"
          FAIL "peer retries fill"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer port"
        FAIL "peer port"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer zone"
      FAIL "peer zone"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer tls"
    FAIL "peer tls"
    CLEAR_ERR
  END
  SYS CAT "peer:from" merge_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit take_n merge_n note_msg
  CLEAR_ERR
END

# peel — GETOBJ + INTO + OR soft
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # Peel nest as JSON string (GETP FROM INTO plate flaky after plate_peer_session)
  GETOBJ "cfg"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS WRITE cfg_path cfg_json
  CLEAR_ERR
  SYS HAS cfg_json "port"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "retries"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # post-overlay port 9090 should be present when chain ran; also accept boot 8080
  SYS HAS cfg_json "\"port\":9090"
  LET port_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "\"port\":8080"
  LET load_hit = LAST_N
  CLEAR_ERR
  LET w_s = "0"
  IF port_n == 1 THEN
    LET w_s = "9090"
    LET port_n = 9090
  ELSE
    IF load_hit == 1 THEN
      LET w_s = "8080"
      LET port_n = 8080
    ELSE
      LET port_n = 0
    END
  END
  CLEAR_ERR
  # soft miss path
  GETOBJ "no_such_nest" OR "{}"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "{}"
  LET take_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n == 1 THEN
        IF port_n > 0 THEN
          LET hit = 1
          LET note_msg = "peel ok"
          LET admit_n = 1
          LET merge_n = port_n
          LET load_hit = 1
        ELSE
          LET miss = 1
          LET note_msg = "peel port val"
          FAIL "peel port val"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peel OR fb"
        FAIL "peel OR fb"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peel retries"
      FAIL "peel retries"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peel cfg"
    FAIL "peel cfg"
    CLEAR_ERR
  END
  SYS CAT "peel:" w_s ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit port_n take_n note_msg
  CLEAR_ERR
END

# patch — PATCHNEST alias (same as MERGEOBJ)
SYS EQS op "patch"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PATCHNEST "cfg" "{\"m\":3,\"k\":2}"
  CLEAR_ERR
  GETOBJ "cfg"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS WRITE cfg_path cfg_json
  CLEAR_ERR
  SYS HAS cfg_json "\"m\":3"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "\"k\":2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # outer host intact
  GETP "host"
  SYS EQS LAST host_s
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "patch ok"
        LET admit_n = 1
        LET take_n = 2
        INCLUDE plate_both_save
        CLEAR_ERR
      ELSE
        LET miss = 1
        LET note_msg = "patch host"
        FAIL "patch host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "patch k"
      FAIL "patch k"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "patch m"
    FAIL "patch m"
    CLEAR_ERR
  END
  SYS CAT "patch:mk:pt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "patch:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# gate — required nest keys present after merge chain
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # Prefer SYS HAS / LAST_N over GETOBJ_HIT rebind — flag LET can stick at 0
  # after prior soft-miss paths in long boards (see W-new).
  GETOBJ "cfg" OR "{}"
  LET cfg_json = LAST
  CLEAR_ERR
  SYS HAS cfg_json "port"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "retries"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS cfg_json "{"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_nest"
  LET take_n = LAST_N
  CLEAR_ERR
  GETOBJ "limits" OR "{}"
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "cpu"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF soft_ok == 1 THEN
            LET hit = 1
            LET gate_ok = 1
            LET admit_n = 1
            LET note_msg = "gate ok"
          ELSE
            LET miss = 1
            LET note_msg = "gate limits"
            FAIL "gate limits"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate schema"
          FAIL "gate schema"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate retries"
        FAIL "gate retries"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate port"
      FAIL "gate port"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate cfg miss"
    FAIL "gate cfg miss"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# soft — non-object overlay + empty bag soft + soft GETOBJ
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  MERGEOBJ "cfg" "not-obj"
  LET soft_ok = 0
  IF OK == 0 THEN
    SYS HAS LAST_ERR "not object"
    LET soft_ok = LAST_N
  END
  CLEAR_ERR
  GETOBJ "zzz_missing" OR "{}"
  LET has_n = GETOBJ_HIT
  CLEAR_ERR
  # empty bag soft
  LET body = ""
  SYS LINES body
  LET take_n = LAST_N
  CLEAR_ERR
  IF soft_ok == 1 THEN
    IF has_n == 0 THEN
      IF take_n == 0 THEN
        LET hit = 1
        LET note_msg = "soft ok"
        LET admit_n = 1
        LET peel_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "soft empty lines"
        FAIL "soft empty lines"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft getobj hit"
      FAIL "soft getobj hit"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft non-obj"
    FAIL "soft non-obj"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok has_n take_n note_msg
  CLEAR_ERR
END

# probe — create missing nest via MERGEOBJ; scalar replace; empty defaults
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # create nest if missing
  MERGEOBJ "stats" "{\"hits\":1,\"ok\":1}"
  CLEAR_ERR
  GETOBJ "stats"
  SYS HAS LAST "hits"
  LET has_n = LAST_N
  CLEAR_ERR
  # scalar key replaced by object merge
  SETP "scratch" "scalar"
  CLEAR_ERR
  MERGEOBJ "scratch" "{\"now\":1}"
  CLEAR_ERR
  GETOBJ "scratch"
  SYS HAS LAST "now"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # DEFAULTOBJ on empty nest create path
  DEFAULTOBJ "fresh" "{\"a\":1,\"b\":2}"
  CLEAR_ERR
  GETOBJ "fresh"
  SYS HAS LAST "\"a\":1"
  LET load_hit = LAST_N
  CLEAR_ERR
  # no clobber of existing plate via empty soft bag
  LET body = ""
  SYS LINES body
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-nest"
  LET merge_n = LAST_N
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 0 THEN
          IF merge_n == 1 THEN
            LET hit = 1
            LET note_msg = "probe ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "probe agent"
            FAIL "probe agent"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe empty"
          FAIL "probe empty"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe fresh"
        FAIL "probe fresh"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe scalar"
      FAIL "probe scalar"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe stats"
    FAIL "probe stats"
    CLEAR_ERR
  END
  SYS CAT "probe:stats:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit merge_n note_msg
  CLEAR_ERR
END

# clear — wipe STATUS bag only (plates stay)
SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

# --- settle plate ---
IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_nest_mergeobj.v1 host=" host_s " role=" role_s " port=" port_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " merge_n=" merge_n " def_n=" def_n " peel=" peel_hit " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

# hard require wall: any miss with REQUIRE set
IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_nest_mergeobj_board: end"
