# svc_lib_boot_module_board.cubalc — lib_boot/lib_guard fleet module roster contract
#
# Real use: fleet agents gate required programs/lib modules (ALL + optional ANY)
# via INCLUDE lib_boot instead of N× HASLIB / REQUIRE LIB glue before plugin
# load / mesh join. First realworld of 1397 lib_guard + lib_boot
# (1.15.849+ · MEANINGFUL_ITER 857 · init --lib).
#
#   DEFAULT NEED_LIBS · NEED_LIB_ANY · LIB_GUARD_SOFT
#   INCLUDE lib_boot|lib_guard → LIB_GUARD_OK / ALL_OK / ANY_OK
#   LIBHAVE / LIBMISS bags · LIBHAVE_N / LIBMISS_N
#   HASLIB exact stem · soft miss · hard REQUIRE LIB
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_slb_$$
#   ./out/cubalc run programs/realworld/svc_lib_boot_module_board.cubalc boot
#   ./out/cubalc run ... pass|soft_all|soft_any|hard|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SLB_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SLB_REQUIRE
#
# Edges: LET knobs before each re-INCLUDE (DEFAULT sticky);
#   LIBHAVE multiline · PRINT clobbers / may show first line only;
#   hard REQUIRE LIB miss exit_code 0 class; substring false friend stems;
#   REQUIRE LIB bare stem vs string-var shadow (LET hold_seed=… steals);
#   double agent_boot via lib_boot; WRITE NL; empty NEED_* skips

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_lib_boot_module_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_lib_boot_module -- boot|pass|soft_all|soft_any|hard|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeL"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SLB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SLB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET lgo = 0
LET allo = 0
LET anyo = 0
LET have_n = 0
LET miss_n = 0
LET have_s = ""
LET miss_s = ""

ONEOF ACTION "boot", "pass", "soft_all", "soft_any", "hard", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_all" THEN
    LET op = "soft_all"
  WHEN "soft_any" THEN
    LET op = "soft_any"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

# ensure agent plate for plate-using ops (standalone actions without prior boot)
SYS EQS op "list"
IF LAST_N == 0 THEN
  SYS EQS op "clear"
  IF LAST_N == 0 THEN
    LET PLATE_PATH = agent_path
    LET PEER_PATH = peer_path
    INCLUDE plate_peer_session
    CLEAR_ERR
    GETP "agent"
    SYS EQS LAST "svc-slb"
    IF LAST_N == 0 THEN
      SYS TRIM host_s
      LET host_s = LAST
      SYS TRIM role_s
      LET role_s = LAST
      CLEAR_ERR
      SYS CAT "{\"agent\":\"svc-slb\",\"schema\":\"cubalc.svc_lib_boot_module.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"lib_roster\",\"label\":\"slb\",\"cfg\":{\"surface\":\"lib_boot,lib_guard,NEED_LIBS,NEED_LIB_ANY,LIB_GUARD_SOFT,LIB_GUARD_OK,LIBHAVE,LIBMISS,HASLIB\",\"contract\":\"INCLUDE-path module gate · init --lib\"}}"
      LET PLATE_SEED = LAST
      CLEAR_ERR
      SYS CAT "{\"peer\":\"lib_roster\",\"n\":1}"
      LET PEER_SEED = LAST
      CLEAR_ERR
      INCLUDE plate_peer_session
      CLEAR_ERR
      SYS SAVEPLATE agent_path PLATE
      CLEAR_ERR
    END
    CLEAR_ERR
  END
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-slb\",\"schema\":\"cubalc.svc_lib_boot_module.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"lib_roster\",\"label\":\"slb\",\"cfg\":{\"surface\":\"lib_boot,lib_guard,NEED_LIBS,NEED_LIB_ANY,LIB_GUARD_SOFT,LIB_GUARD_OK,LIBHAVE,LIBMISS,HASLIB\",\"contract\":\"INCLUDE-path module gate · init --lib\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"lib_roster\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_lib_boot_module"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "lib_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "lib_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — required modules present (ALL + ANY)
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = "agent_boot\nhold_seed"
  LET NEED_LIB_ANY = "lib_guard\nnosuch_lib_pass_any"
  LET LIB_GUARD_SOFT = 0
  INCLUDE lib_boot
  LET lgo = LIB_GUARD_OK
  LET allo = LIB_GUARD_ALL_OK
  LET anyo = LIB_GUARD_ANY_OK
  CLEAR_ERR
  IF lgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  HASLIB agent_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB hold_seed
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_LIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "lib_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIB_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "lib_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" lgo ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score lgo allo anyo note_msg
  CLEAR_ERR
END

# soft_all — missing lib under LIB_GUARD_SOFT · LIBMISS bag
SYS EQS op "soft_all"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = "agent_boot\nnosuch_cubalc_lib_slb_all"
  LET NEED_LIB_ANY = ""
  LET LIB_GUARD_SOFT = 1
  INCLUDE lib_guard
  LET lgo = LIB_GUARD_OK
  LET allo = LIB_GUARD_ALL_OK
  LET miss_n = LIBMISS_N
  LET have_n = LIBHAVE_N
  LET miss_s = LIBMISS
  LET have_s = LIBHAVE
  CLEAR_ERR
  IF lgo == 0 THEN
    LET score = score + 1
  END
  IF allo == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE miss_s "nosuch_cubalc_lib_slb_all"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE have_s "agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend: stem must be exact, not partial
  HASLIB agent
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "LIBMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIB_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # recover empty contract
  LET NEED_LIBS = ""
  LET NEED_LIB_ANY = ""
  LET LIB_GUARD_SOFT = 0
  INCLUDE lib_guard
  LET lgo = LIB_GUARD_OK
  CLEAR_ERR
  IF lgo == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_all ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_all score"
    FAIL "soft_all score"
    CLEAR_ERR
  END
  SYS CAT "soft_all:" miss_n ":sa"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_all:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score miss_n have_n note_msg
  CLEAR_ERR
END

# soft_any — none of ANY list · then hit one of
SYS EQS op "soft_any"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = ""
  LET NEED_LIB_ANY = "nosuch_lib_a_slb\nnosuch_lib_b_slb"
  LET LIB_GUARD_SOFT = 1
  INCLUDE lib_guard
  LET lgo = LIB_GUARD_OK
  LET anyo = LIB_GUARD_ANY_OK
  CLEAR_ERR
  IF lgo == 0 THEN
    LET score = score + 1
  END
  IF anyo == 0 THEN
    LET score = score + 1
  END
  # hit ANY with real module mixed in
  LET NEED_LIB_ANY = "nosuch_lib_a_slb\nagent_boot"
  LET LIB_GUARD_SOFT = 1
  INCLUDE lib_guard
  LET lgo = LIB_GUARD_OK
  LET anyo = LIB_GUARD_ANY_OK
  CLEAR_ERR
  IF lgo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_LIB_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIBHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "module"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "lib_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "lib_boot_module"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_any ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_any score"
    FAIL "soft_any score"
    CLEAR_ERR
  END
  SYS CAT "soft_any:" anyo ":sy"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score lgo anyo note_msg
  CLEAR_ERR
END

# hard — REQUIRE LIB present modules via lib_boot (hard miss tested off-board)
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = "agent_boot\nlib_guard\nlib_boot"
  LET NEED_LIB_ANY = ""
  LET LIB_GUARD_SOFT = 0
  INCLUDE lib_boot
  LET lgo = LIB_GUARD_OK
  LET allo = LIB_GUARD_ALL_OK
  CLEAR_ERR
  IF lgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  # hard ANY with real stem
  LET NEED_LIBS = ""
  LET NEED_LIB_ANY = "nosuch_lib_hard_z\nhold_seed"
  LET LIB_GUARD_SOFT = 0
  INCLUDE lib_guard
  LET anyo = LIB_GUARD_ANY_OK
  LET lgo = LIB_GUARD_OK
  CLEAR_ERR
  IF anyo == 1 THEN
    LET score = score + 1
  END
  IF lgo == 1 THEN
    LET score = score + 1
  END
  HASLIB lib_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB lib_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASLIB"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "lib_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "lib_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:" lgo ":hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score lgo note_msg
  CLEAR_ERR
END

# form — HASLIB / HASINCLUDE stack · HASFORM knobs miss
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = ""
  LET NEED_LIB_ANY = ""
  LET LIB_GUARD_SOFT = 0
  INCLUDE lib_boot
  CLEAR_ERR
  HASLIB lib_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB lib_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE lib_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE lib_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE agent_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM HASLIB
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "LIB_GUARD_OK"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "lib_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_LIB_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live soft combined ALL+ANY
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = "agent_boot\nhold_seed"
  LET NEED_LIB_ANY = "lib_boot\nnosuch_gate_x"
  LET LIB_GUARD_SOFT = 1
  INCLUDE lib_boot
  LET lgo = LIB_GUARD_OK
  LET allo = LIB_GUARD_ALL_OK
  LET anyo = LIB_GUARD_ANY_OK
  LET have_n = LIBHAVE_N
  CLEAR_ERR
  IF lgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_LIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIBHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "INCLUDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "lib_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score lgo note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · capture LIB_GUARD_OK / multiline LIBHAVE
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_LIBS = "agent_boot\nhold_seed"
  LET NEED_LIB_ANY = ""
  LET LIB_GUARD_SOFT = 1
  INCLUDE lib_guard
  LET lgo = LIB_GUARD_OK
  LET have_n = LIBHAVE_N
  LET have_s = LIBHAVE
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF lgo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 2 THEN
    LET score = score + 1
  END
  # multiline bag: SYS LINES counts stems
  SYS LINES have_s
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE have_s "hold_seed"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "lib_boot_module"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "lib_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LIBMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "lib_roster"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score lgo have_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " lgo=" lgo " allo=" allo " anyo=" anyo " have_n=" have_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "slb report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
