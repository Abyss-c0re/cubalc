# svc_movelinein_priority_board.cubalc — MOVELINEIN + COUNTLINEIN priority queue
#
# Real use: incident/job agents reorder a named priority bag (promote P0
# to front, demote resolved to end) and tally severity/status via
# COUNTLINEIN exact + COUNTIN substring without rebuild. First realworld
# of 1470 MOVELINEIN/MOVEATIN (1.15.925+ · MI ~932) + 1471
# COUNTIN/COUNTLINEIN/OCCURSIN. Distinct from findlinein_runbook (set/
# insert/drop) and priority_fifo_inbox — this board is *reorder + tally*.
#
#   MOVELINEIN · MOVEATIN · COUNTIN · COUNTLINEIN · OCCURSIN · FINDLINEIN
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_mlp_$$
#   ./out/cubalc run programs/realworld/svc_movelinein_priority_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt MLP_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_MLP_REQUIRE
#
# Edges: MOVELINEIN OOR HIT=0; same-index no-op HIT=1; empty bag soft;
#   COUNTIN non-overlap "aa" in aaa=1; empty needle 0; COUNTLINEIN exact;
#   capture LAST_N before PRINT; WRITE NL; REQUIRE soft

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

NOTE "svc_movelinein_priority_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_movelinein_priority -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_MLP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "MLP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET path = ""
LET msg = ""
LET peeld = ""
LET work = ""
LET idx = 0
LET depth = 0
LET weight = 0
LET p0_n = 0
LET p2_n = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-mlp\",\"schema\":\"cubalc.svc_movelinein_priority.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"mlp\",\"want_filter\":\"movelinein_priority\",\"cfg\":{\"surface\":\"MOVELINEIN,MOVEATIN,COUNTIN,COUNTLINEIN,OCCURSIN,FINDLINEIN\",\"contract\":\"priority bag reorder + severity tally without rebuild\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  CLEARSTR work
  PUSHTO work "p2:disk"
  PUSHTO work "p1:api"
  PUSHTO work "p0:outage"
  FINDLINEIN work "p0:outage"
  LET idx = LAST_N
  CLEAR_ERR
  MOVELINEIN work idx 0
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    IF idx == 2 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET score = 1
      LET find_n = idx
    ELSE
      LET miss = 1
      LET note_msg = "boot idx"
      FAIL "boot idx"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot move"
    FAIL "boot move"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — MOVELINEIN/MOVEATIN/COUNTIN/COUNTLINEIN core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "a"
  PUSHTO work "b"
  PUSHTO work "c"
  PUSHTO work "d"
  CLEAR_ERR
  MOVELINEIN work 3 0
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS work "d
a
b
c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MOVEATIN work 0 99
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS work "a
b
c
d"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # same index no-op
  MOVELINEIN work 1 1
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  FINDLINEIN work "c"
  LET idx = LAST_N
  CLEAR_ERR
  MOVELINEIN work idx 0
  CLEAR_ERR
  SYS EQS work "c
a
b
d"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET path = "/a/b/c/d"
  COUNTIN path "/"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 4 THEN
    LET score = score + 1
  END
  IF COUNTIN_N == 4 THEN
    LET score = score + 1
  END
  CLEARSTR work
  PUSHTO work "a"
  PUSHTO work "b"
  PUSHTO work "a"
  PUSHTO work "a"
  COUNTLINEIN work "a"
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  LET log = "err:1 err:2 err:3"
  OCCURSIN log "err:"
  LET weight = LAST_N
  CLEAR_ERR
  IF weight == 3 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — OOR · empty · non-overlap · empty needle · exact vs substr
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "a"
  PUSHTO work "b"
  PUSHTO work "c"
  PUSHTO work "d"
  CLEAR_ERR
  MOVELINEIN work 9 0
  CLEAR_ERR
  IF MOVELINEIN_HIT == 0 THEN
    LET score = score + 1
  END
  SYS EQS work "a
b
c
d"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CLEARSTR empty
  MOVELINEIN empty 0 1
  CLEAR_ERR
  IF MOVELINEIN_HIT == 0 THEN
    LET score = score + 1
  END
  LET s = "aaa"
  COUNTIN s "aa"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  COUNTIN s ""
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTIN s "z"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CLEARSTR work
  PUSHTO work "error:timeout"
  PUSHTO work "ok"
  PUSHTO work "error"
  COUNTLINEIN work "error"
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 1 THEN
    LET score = score + 1
  END
  COUNTLINEIN work "z"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # num promote COUNTIN
  LET n = 10101
  COUNTIN n "1"
  IF LAST_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# peel — incident queue promote P0 + severity tallies
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "p2:disk"
  PUSHTO work "p1:api"
  PUSHTO work "p0:outage"
  PUSHTO work "p2:noise"
  CLEAR_ERR
  COUNTIN work "p2:"
  LET p2_n = LAST_N
  CLEAR_ERR
  IF p2_n == 2 THEN
    LET score = score + 1
  END
  COUNTIN work "p0:"
  LET p0_n = LAST_N
  CLEAR_ERR
  IF p0_n == 1 THEN
    LET score = score + 1
  END
  FINDLINEIN work "p0:outage"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 2 THEN
    LET score = score + 1
  END
  MOVELINEIN work idx 0
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  FINDLINEIN work "p0:outage"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  COUNTLINEIN work "p2:disk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # demote resolved p0 to end after ack
  SETLINEIN work 0 "done:outage"
  CLEAR_ERR
  FINDLINEIN work "done:outage"
  LET idx = LAST_N
  CLEAR_ERR
  MOVEATIN work idx 99
  CLEAR_ERR
  FINDLINEIN work "done:outage"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 3 THEN
    LET score = score + 1
  END
  COUNTIN work "p2:"
  LET p2_n = LAST_N
  CLEAR_ERR
  IF p2_n == 2 THEN
    LET score = score + 1
  END
  LINESIN work
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 4 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "movelinein_priority"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = p0_n
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score p2_n note_msg
  CLEAR_ERR
END

# scale — multi promote + path depth + OCCURSIN log
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET work = "low
med
high
crit"
  CLEAR_ERR
  FINDLINEIN work "crit"
  LET idx = LAST_N
  CLEAR_ERR
  MOVELINEIN work idx 0
  CLEAR_ERR
  FINDLINEIN work "crit"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FINDLINEIN work "high"
  LET idx = LAST_N
  CLEAR_ERR
  MOVELINEIN work idx 1
  CLEAR_ERR
  FINDLINEIN work "high"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # path shard depth gate
  LET path = "/svc/api/v1/jobs/run"
  COUNTIN path "/"
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 5 THEN
    LET score = score + 1
  END
  IF depth > 3 THEN
    LET score = score + 1
  END
  LET log = "warn:1 err:1 err:2 ok"
  OCCURSIN log "err:"
  LET weight = LAST_N
  CLEAR_ERR
  IF weight == 2 THEN
    LET score = score + 1
  END
  COUNTIN log "warn:"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # double promote same front is no-op hit
  MOVELINEIN work 0 0
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  LINESIN work
  IF LAST_N == 4 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "MOVELINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score depth note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "MOVELINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "MOVEATIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "COUNTIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "COUNTLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "OCCURSIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "FINDLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SETLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "LINESIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "COUNTIN_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "movelinein_priority"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit when p0 at front and p0 count==1
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "p1:api"
  PUSHTO work "p0:outage"
  PUSHTO work "p2:disk"
  CLEAR_ERR
  FINDLINEIN work "p0:outage"
  LET idx = LAST_N
  CLEAR_ERR
  MOVELINEIN work idx 0
  CLEAR_ERR
  FINDLINEIN work "p0:outage"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  COUNTIN work "p0:"
  LET p0_n = LAST_N
  CLEAR_ERR
  IF p0_n == 1 THEN
    LET score = score + 1
  END
  COUNTLINEIN work "p0:outage"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend: COUNTLINEIN "p0" exact miss
  COUNTLINEIN work "p0"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # COUNTIN still sees prefix
  COUNTIN work "p0"
  IF LAST_N >= 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit > 0 THEN
    IF p0_n < 1 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-mlp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF MOVELINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score p0_n note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "x"
  PUSHTO work "y"
  PUSHTO work "z"
  CLEAR_ERR
  FINDLINEIN work "z"
  LET idx = LAST_N
  CLEAR_ERR
  LET saved = idx
  PRINT "probe-idx" saved
  CLEAR_ERR
  IF saved == 2 THEN
    LET score = score + 1
  END
  MOVELINEIN work saved 0
  CLEAR_ERR
  FINDLINEIN work "z"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  COUNTIN work "y"
  LET weight = LAST_N
  CLEAR_ERR
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "mlp host=" host_s " role=" role_s " idx=" saved
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "idx=2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "COUNTLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF weight >= 0 THEN
    LET score = score + 1
  END
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-mlp\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
