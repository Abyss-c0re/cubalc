# gate
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "ready"
  PUSHTO work "pool-a"
  LET depth = 4
  LET maxd = 10
  LET retries = 2
  CALL gate_full
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET a = depth
  LET b = 4
  CALL eqn_ab
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET a = depth
  LET b = maxd
  CALL le_ab
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET needle = "pool-a"
  CALL inbag_work
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET retries = 0
  CALL admit_retries
  SYS EQS state "deny-retries"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit > 0 THEN
    IF score < 4 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-iha"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF IFHASLINE_N >= 0 THEN
    LET score = score + 1
  END
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET a = 5
  LET b = 0
  CALL gt_ab
  LET saved = IFGT_N
  PRINT "probe-ifgt" saved
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  LET retries = 5
  STRTO retries
  SYS WRITE val_path retries
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "5"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "iha host=" host_s " role=" role_s " retries=" retries
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "retries=5"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFEQN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CLEARSTR work
  PUSHTO work "ready"
  LET needle = "ready"
  CALL hasline_work
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF ok_v == 1 THEN
    LET find_n = 1
  END
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-iha\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

PASS
