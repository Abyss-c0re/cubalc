# agent_json_plate_peel_board.cubalc — JSONKEYS + JSONHAS + JSON FROM plate peels
#
# Real use: agent handoff STATUS.json plates — discover top-level keys, soft
# probe fields, multi-field peel without JOIN/LAST reload glue between keys:
#   JSONKEYS / KEYSJSON / JKEYS — top-level key bag (1052)
#   JSONHAS / HASJSON / JHAS — soft key probe, LAST string kept (1052)
#   JSON key FROM|IN|OF plate [OR fallback] — multi-field peel (1053)
#   JSON key OR — miss defaults without FROM
#   WRITEOUT / SYS WRITE — seed plate; plate STATUS bag
#
# First realworld JSONKEYS+JSONHAS+JSON FROM board. Distinct from
# svc_config_object (OOP DUMPOBJ slots) and status_handoff (atomic/hash wait).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ajpp_$$
#   ./out/cubalc run programs/realworld/agent_json_plate_peel_board.cubalc \
#     seed -- --plate=/tmp/ajpp/status.json
#   ./out/cubalc run ... keys -- --plate=...
#   ./out/cubalc run ... has -- --plate=... version
#   ./out/cubalc run ... peel -- --plate=... version
#   ./out/cubalc run ... multi -- --plate=...
#
# Plate: STATUS.txt VAL.txt META.txt AJPP_REPORT.txt
# Env: PLATE_PATH CUBALC_AJPP_REQUIRE CUBALC_AJPP_MIN CUBALC_AJPP_DEFAULT
#
# Edges:
#   empty object keys N=0; array root soft not-object
#   JSONHAS miss HIT=0 keeps LAST; JSON miss soft; OR fallback
#   FROM multi-field without reload; nested keys not in JSONKEYS
#   REQUIRE EXIT n; WRITE omit NL; lean VARS

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_json_plate_peel_board: start"
DEFAULT ACTION = "list"
DEFAULT MIN = 1
DEFAULT FALLBACK = "none"
DEFAULT USAGE_LINE = "agent_json_plate_peel -- seed|keys|has|peel|multi|list -- [--plate=P] [key]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/status.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
LET p_ok = OK
CLEAR_ERR

LET key_name = "version"
IF has_rest == 1 THEN
  SYS NTH 0 targets
  LET key_name = LAST
END
CLEAR_ERR

SYS ENV "CUBALC_AJPP_DEFAULT" OR FALLBACK
IF LAST_N > 0 THEN
  LET FALLBACK = LAST
END
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_AJPP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
SYS ENV "CUBALC_AJPP_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN = LAST_N
  END
END

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "AJPP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET line_i = 0
LET row = ""
LET out = ""
LET body = ""
LET keep_probe = "preserve-me"
LET ver = ""
LET role = ""
LET n_field = ""
LET ok_field = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "seed", "keys", "has", "peel", "multi", "list", "ls", "drop", "gate", "soft", "clear", "probe", "or"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "seed" THEN
    LET op = "seed"
  WHEN "keys" THEN
    LET op = "keys"
  WHEN "has" THEN
    LET op = "has"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "multi" THEN
    LET op = "multi"
  WHEN "or" THEN
    LET op = "or"
  WHEN "drop" THEN
    LET op = "drop"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src MIN
  CLEAR_ERR
END

SYS EQS op "seed"
IF LAST_N == 1 THEN
  LET known = 1
  # agent STATUS.json plate with nested + empty err + numeric n
  LET body = "{\"ok\":true,\"version\":\"1.15.503\",\"err\":\"\",\"n\":7,\"role\":\"agent\",\"nested\":{\"x\":1}}"
  WRITEOUT plate_file body
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "seed write failed"
  END
  CLEAR_ERR
  SYS CAT "seed:"
  LET row = LAST
  SYS CAT row plate_file
  LET row = LAST
  SYS CAT row ":ok"
  LET row = LAST
  SYS GREPV "seed:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  LET admit_n = 1
  LET out = body
  SYS LINES bag
  LET bag_n = LAST_N
  LET hit = 1
  LET note_msg = "seed ok"
  PRINT_JSON admit_n bag_n p_src
  CLEAR_ERR
END

SYS EQS op "keys"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "keys empty plate"
    FAIL "keys empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "keys empty"
    END
  ELSE
    SYS JSONKEYS body
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "keys soft miss"
      FAIL "keys soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "keys failed"
      END
    ELSE
      LET take_n = JSONKEYS_N
      LET out = LAST
      CLEAR_ERR
      SYS CAT "keys:"
      LET row = LAST
      SYS STR take_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":jk"
      LET row = LAST
      SYS GREPV "keys:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      # nested.x must not appear as top-level key
      SYS HASLINE out "nested"
      LET peel_hit = LAST_N
      CLEAR_ERR
      SYS HASLINE out "x"
      LET has_n = LAST_N
      CLEAR_ERR
      IF take_n > 0 THEN
        LET hit = 1
        LET note_msg = "keys hit"
      ELSE
        LET miss = 1
        LET note_msg = "keys empty"
        FAIL "keys empty"
        CLEAR_ERR
      END
    END
  END
  PRINT_JSON admit_n bag_n take_n peel_hit has_n p_src
  CLEAR_ERR
END

SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "has empty plate"
    FAIL "has empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "has empty"
    END
  ELSE
    # JSONHAS key token is literal-only (W115) — EQS-branch known plate keys
    SYS JOIN "" keep_probe
    LET peel_hit = 0
    SYS EQS key_name "version"
    IF LAST_N == 1 THEN
      SYS JSONHAS "version" body
      LET peel_hit = JSONHAS_HIT
    END
    CLEAR_ERR
    SYS EQS key_name "role"
    IF LAST_N == 1 THEN
      SYS JSONHAS "role" body
      LET peel_hit = JSONHAS_HIT
    END
    CLEAR_ERR
    SYS EQS key_name "n"
    IF LAST_N == 1 THEN
      SYS JSONHAS "n" body
      LET peel_hit = JSONHAS_HIT
    END
    CLEAR_ERR
    SYS EQS key_name "ok"
    IF LAST_N == 1 THEN
      SYS JSONHAS "ok" body
      LET peel_hit = JSONHAS_HIT
    END
    CLEAR_ERR
    SYS EQS key_name "err"
    IF LAST_N == 1 THEN
      SYS JSONHAS "err" body
      LET peel_hit = JSONHAS_HIT
    END
    CLEAR_ERR
    SYS EQS key_name "nested"
    IF LAST_N == 1 THEN
      SYS JSONHAS "nested" body
      LET peel_hit = JSONHAS_HIT
    END
    CLEAR_ERR
    LET has_n = peel_hit
    LET out = LAST
    CLEAR_ERR
    SYS CAT "has:"
    LET row = LAST
    SYS CAT row key_name
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR peel_hit
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":jh"
    LET row = LAST
    SYS GREPV "has:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "has hit"
    ELSE
      LET miss = 1
      LET note_msg = "has empty"
      FAIL "has empty"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "has empty"
      END
    END
  END
  PRINT_JSON admit_n bag_n peel_hit has_n p_src
  CLEAR_ERR
END

SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "peel empty plate"
    FAIL "peel empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "peel empty"
    END
  ELSE
    # JSON key FROM also literal-only for key token (W115)
    LET peel_hit = 0
    LET out = ""
    LET line_i = 0
    SYS EQS key_name "version"
    IF LAST_N == 1 THEN
      SYS JSON "version" FROM body
      LET peel_hit = JSON_HIT
      LET out = LAST
      LET line_i = JSON_FROM
    END
    CLEAR_ERR
    SYS EQS key_name "role"
    IF LAST_N == 1 THEN
      SYS JSON "role" FROM body
      LET peel_hit = JSON_HIT
      LET out = LAST
      LET line_i = JSON_FROM
    END
    CLEAR_ERR
    SYS EQS key_name "n"
    IF LAST_N == 1 THEN
      SYS JSON "n" FROM body
      LET peel_hit = JSON_HIT
      LET out = LAST
      LET line_i = JSON_FROM
    END
    CLEAR_ERR
    SYS EQS key_name "ok"
    IF LAST_N == 1 THEN
      SYS JSON "ok" FROM body
      LET peel_hit = JSON_HIT
      LET out = LAST
      LET line_i = JSON_FROM
    END
    CLEAR_ERR
    SYS EQS key_name "err"
    IF LAST_N == 1 THEN
      SYS JSON "err" FROM body
      LET peel_hit = JSON_HIT
      LET out = LAST
      LET line_i = JSON_FROM
    END
    CLEAR_ERR
    IF peel_hit == 0 THEN
      LET miss = 1
      LET note_msg = "peel soft miss"
      FAIL "peel soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "peel failed"
      END
    ELSE
      CLEAR_ERR
      SYS CAT "peel:"
      LET row = LAST
      SYS CAT row key_name
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS CAT row out
      LET row = LAST
      SYS CAT row ":jp"
      LET row = LAST
      SYS GREPV "peel:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      LET hit = 1
      LET note_msg = "peel hit"
    END
  END
  PRINT_JSON admit_n bag_n peel_hit line_i p_src
  CLEAR_ERR
END

SYS EQS op "multi"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "multi empty plate"
    FAIL "multi empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "multi empty"
    END
  ELSE
    # multi-field peel without reloading LAST/body between keys
    SYS JSON "version" FROM body
    LET ver = LAST
    CLEAR_ERR
    SYS JSON "role" FROM body
    LET role = LAST
    CLEAR_ERR
    SYS JSON "n" FROM body
    LET n_field = LAST
    CLEAR_ERR
    SYS JSON "ok" FROM body
    LET ok_field = LAST
    CLEAR_ERR
    SYS JSON "missing_xyz" FROM body OR FALLBACK
    LET out = LAST
    LET peel_hit = JSON_OR
    CLEAR_ERR
    SYS CAT "multi:"
    LET row = LAST
    SYS CAT row ver
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS CAT row role
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS CAT row n_field
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS CAT row out
    LET row = LAST
    SYS CAT row ":mm"
    LET row = LAST
    SYS GREPV "multi:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    # VAL bag of peels
    SYS PUSH "" ver
    LET out = LAST
    SYS PUSH out role
    LET out = LAST
    SYS PUSH out n_field
    LET out = LAST
    SYS PUSH out ok_field
    LET out = LAST
    SYS PUSH out FALLBACK
    LET out = LAST
    SYS LINES bag
    LET bag_n = LAST_N
    LET take_n = 5
    LET hit = 1
    LET note_msg = "multi ok"
  END
  PRINT_JSON admit_n bag_n take_n peel_hit p_src
  CLEAR_ERR
END

SYS EQS op "or"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "or empty plate"
    FAIL "or empty plate"
    CLEAR_ERR
  ELSE
    # literal key + OR; unknown CLI keys fall through to OR default
    LET peel_hit = 0
    LET has_n = 1
    LET out = FALLBACK
    SYS EQS key_name "version"
    IF LAST_N == 1 THEN
      SYS JSON "version" FROM body OR FALLBACK
      LET out = LAST
      LET peel_hit = JSON_HIT
      LET has_n = JSON_OR
    END
    CLEAR_ERR
    SYS EQS key_name "role"
    IF LAST_N == 1 THEN
      SYS JSON "role" FROM body OR FALLBACK
      LET out = LAST
      LET peel_hit = JSON_HIT
      LET has_n = JSON_OR
    END
    CLEAR_ERR
    SYS EQS key_name "n"
    IF LAST_N == 1 THEN
      SYS JSON "n" FROM body OR FALLBACK
      LET out = LAST
      LET peel_hit = JSON_HIT
      LET has_n = JSON_OR
    END
    CLEAR_ERR
    SYS EQS key_name "ok"
    IF LAST_N == 1 THEN
      SYS JSON "ok" FROM body OR FALLBACK
      LET out = LAST
      LET peel_hit = JSON_HIT
      LET has_n = JSON_OR
    END
    CLEAR_ERR
    # unknown key_name (not in EQS branches) keeps FALLBACK, has_n=1 (OR path)
    SYS CAT "or:"
    LET row = LAST
    SYS CAT row key_name
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS CAT row out
    LET row = LAST
    SYS CAT row ":jo"
    LET row = LAST
    SYS GREPV "or:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "or ok"
  END
  PRINT_JSON admit_n bag_n peel_hit has_n p_src
  CLEAR_ERR
END

SYS EQS op "drop"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "drop needs key"
    FAIL "drop needs key"
    CLEAR_ERR
  ELSE
    SYS NTH 0 targets
    LET row = LAST
    SYS CAT row ":"
    SYS GREPV LAST bag
    LET bag = LAST
    CLEAR_ERR
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "drop ok"
  END
  PRINT_JSON admit_n bag_n
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n >= MIN THEN
    LET hit = 1
    LET note_msg = "gate admit"
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    FAIL "gate deny"
    CLEAR_ERR
  END
  PRINT_JSON bag_n MIN hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JSONKEYS "{}"
  LET take_n = JSONKEYS_N
  CLEAR_ERR
  SYS JSONKEYS "[1,2]"
  LET has_n = OK
  CLEAR_ERR
  SYS JOIN "" "preserve-me"
  SYS JSONHAS "nope" "{\"a\":1}"
  LET peel_hit = JSONHAS_HIT
  LET out = LAST
  CLEAR_ERR
  SYS JSON "gone" FROM "{\"a\":1}"
  LET admit_n = OK
  CLEAR_ERR
  SYS JSON "gone" FROM "{\"a\":1}" OR FALLBACK
  LET line_i = JSON_OR
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  PRINT_JSON take_n has_n peel_hit admit_n line_i p_src
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_json_plate_peel_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "bag_n"
LET row = LAST
SYS STR bag_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "take_n"
LET row = LAST
SYS STR take_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE report_path row
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
SYS WRITE meta_path row
CLEAR_ERR

NOTE "agent_json_plate_peel_board: done"
PRINT_JSON hit miss bag_n take_n peel_hit has_n p_src note_msg
EXIT 0
