# svc_send_dispatch_board.cubalc — SEND/TRYSEND arity + EQF status dispatch
#
# Real use: mesh agents dispatch service methods (bump counters, set status,
# ping) and gate on status equality without guessing arity. Under-arity
# TRYSEND yields needs-N got-M LAST_ERR; over-arity may soft-accept.
#
# Surfaces forced (1.15.422–423 / proof 973 CALL/SEND arity, 946 EQF):
#   SEND / TRYSEND · ARITY_NEED / ARITY_GOT · LAST_ERR needs/got
#   EQF / EQFI / NEQF status probes
#   INCF via METHOD bump · SETF via setst · ping zero-arg
#   soft miss + REQUIRE wall
#
# Distinct from svc_method_catalog (EACH METHOD list), schema_contract
# (METHODINFO arity plate): this is *live SEND dispatch + arity wall*.
#
# Slots: s0 s1 s2
#
# Plate under STATE:
#   dump/s0 dump/s1 dump/s2
#   VAL.txt META.txt OBJS.txt SEND_REPORT.txt
#
# Actions:
#   list | open | bump | setst | ping | status | eq | gate | probe | dump | clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ssd_$$
#   CUBALC_ARG0=open CUBALC_ARG1=s0
#   CUBALC_FS_BY=5 CUBALC_ARG0=bump CUBALC_ARG1=s0
#   CUBALC_FS_ST=hot CUBALC_ARG0=setst CUBALC_ARG1=s0
#   CUBALC_FS_WANT=hot CUBALC_ARG0=eq CUBALC_ARG1=s0
#   CUBALC_FS_MINN=3 CUBALC_ARG0=gate CUBALC_ARG1=s0
#
# Env: CUBALC_FS_REQUIRE NAME BY ST WANT MINN ACTION
#
# Edges:
#   TRYSEND under-arity soft needs N got M
#   over-arity may OK=1 (extra ignored) — document
#   HASMETHOD var still broken; SEND uses literal method names
#   EQF case-sensitive; EQFI icase
#   WRITE NL; NUM softens REQUIRE=abc

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS Svc
  FIELD id ""
  FIELD n 0
  FIELD status "idle"
  FIELD last ""
  METHOD init i
    SETF THIS id i
    SETF THIS n 0
    SETF THIS status "idle"
    SETF THIS last ""
  END
  METHOD bump by
    INCF THIS n by
  END
  METHOD setst st
    SETF THIS status st
  END
  METHOD ping
    SETF THIS last "pong"
  END
END

REQUIRE CLASS Svc
REQUIRE METHOD Svc init

NOTE "svc_send_dispatch_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT NEED_HIT = 0
DEFAULT BY = 1
DEFAULT ST = "hot"
DEFAULT WANT = "hot"
DEFAULT MINN = 1
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_FS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_FS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
  LET ST = LAST
  LET WANT = LAST
  SYS NUM
  IF OK == 1 THEN
    LET BY = LAST_N
  END
ELSE
  SYS ENV "CUBALC_FS_A2" OR ""
  IF LAST_N > 0 THEN
    LET A2 = LAST
  END
END
SYS ENV "CUBALC_FS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET NEED_HIT = LAST_N
  END
END
SYS ENV "CUBALC_FS_BY" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET BY = LAST_N
  END
END
SYS ENV "CUBALC_FS_ST" OR ""
IF LAST_N > 0 THEN
  LET ST = LAST
END
SYS ENV "CUBALC_FS_WANT" OR ""
IF LAST_N > 0 THEN
  LET WANT = LAST
END
SYS ENV "CUBALC_FS_MINN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MINN = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "dump"
LET dump_dir = LAST
SYS MKDIR dump_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SEND_REPORT.txt"
LET report_path = LAST
SYS JOIN dump_dir "s0"
LET d_s0 = LAST
SYS JOIN dump_dir "s1"
LET d_s1 = LAST
SYS JOIN dump_dir "s2"
LET d_s2 = LAST

LET slot = -1
SYS EQS NAME "s0"
IF LAST_N == 1 THEN
  LET slot = 0
END
SYS EQS NAME "s1"
IF LAST_N == 1 THEN
  LET slot = 1
END
SYS EQS NAME "s2"
IF LAST_N == 1 THEN
  LET slot = 2
END
LET sn = ""
IF slot == 0 THEN
  LET sn = "s0"
END
IF slot == 1 THEN
  LET sn = "s1"
END
IF slot == 2 THEN
  LET sn = "s2"
END

# rehydrate
SYS READ OR d_s0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ s0
  IF LAST_N == 1 THEN
    DELETEOBJ s0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUPN snap "n"
  LET rn = LAST_N
  SYS LOOKUP snap "status"
  LET rst = LAST
  SYS LOOKUP snap "last"
  LET rlast = LAST
  CLEAR_ERR
  NEW Svc s0 rid
  SYS BLANK rid
  IF LAST_N == 0 THEN
    TRYSETF s0 id rid
  END
  TRYSETF s0 n rn
  SYS BLANK rst
  IF LAST_N == 0 THEN
    TRYSETF s0 status rst
  END
  SYS BLANK rlast
  IF LAST_N == 0 THEN
    TRYSETF s0 last rlast
  END
  CLEAR_ERR
END
SYS READ OR d_s1 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ s1
  IF LAST_N == 1 THEN
    DELETEOBJ s1
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUPN snap "n"
  LET rn = LAST_N
  SYS LOOKUP snap "status"
  LET rst = LAST
  SYS LOOKUP snap "last"
  LET rlast = LAST
  CLEAR_ERR
  NEW Svc s1 rid
  SYS BLANK rid
  IF LAST_N == 0 THEN
    TRYSETF s1 id rid
  END
  TRYSETF s1 n rn
  SYS BLANK rst
  IF LAST_N == 0 THEN
    TRYSETF s1 status rst
  END
  SYS BLANK rlast
  IF LAST_N == 0 THEN
    TRYSETF s1 last rlast
  END
  CLEAR_ERR
END
SYS READ OR d_s2 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ s2
  IF LAST_N == 1 THEN
    DELETEOBJ s2
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUPN snap "n"
  LET rn = LAST_N
  SYS LOOKUP snap "status"
  LET rst = LAST
  SYS LOOKUP snap "last"
  LET rlast = LAST
  CLEAR_ERR
  NEW Svc s2 rid
  SYS BLANK rid
  IF LAST_N == 0 THEN
    TRYSETF s2 id rid
  END
  TRYSETF s2 n rn
  SYS BLANK rst
  IF LAST_N == 0 THEN
    TRYSETF s2 status rst
  END
  SYS BLANK rlast
  IF LAST_N == 0 THEN
    TRYSETF s2 last rlast
  END
  CLEAR_ERR
END

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET nobjs = 0
LET ret_n = 0
LET changed = 0
LET board_rep = "svc_send_dispatch_board"

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS Svc
  LET bag = LAST
  LET nobjs = NOBJS
  SYS WRITE objs_path bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- open ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        DELETEOBJ s0
        CLEAR_ERR
      END
      NEW Svc s0 sn
      DUMPOBJ s0
      SYS WRITE d_s0 LAST
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        DELETEOBJ s1
        CLEAR_ERR
      END
      NEW Svc s1 sn
      DUMPOBJ s1
      SYS WRITE d_s1 LAST
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        DELETEOBJ s2
        CLEAR_ERR
      END
      NEW Svc s2 sn
      DUMPOBJ s2
      SYS WRITE d_s2 LAST
      CLEAR_ERR
    END
    LISTOBJS Svc
    LET nobjs = NOBJS
    SYS WRITE objs_path LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "open ok"
    LET val = sn
    LET val_ch = 1
    LET meta = "open"
    SYS PUSH meta sn
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- bump: SEND bump BY ---
SYS EQS ACTION "bump"
IF LAST_N == 1 THEN
  NOTE "action bump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "bump bad slot"
    FAIL "bump bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "bump bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        SEND s0 bump BY
        LET o_ok = OK
        GETF s0 n
        LET ret_n = LAST_N
        DUMPOBJ s0
        SYS WRITE d_s0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        SEND s1 bump BY
        LET o_ok = OK
        GETF s1 n
        LET ret_n = LAST_N
        DUMPOBJ s1
        SYS WRITE d_s1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        SEND s2 bump BY
        LET o_ok = OK
        GETF s2 n
        LET ret_n = LAST_N
        DUMPOBJ s2
        SYS WRITE d_s2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "bump miss"
      FAIL "bump miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "bump miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "bump ok"
      SYS STR ret_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "bump"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR ret_n
      SYS PUSH meta LAST
      LET meta = LAST
      SYS STR BY
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- setst ---
SYS EQS ACTION "setst"
IF LAST_N == 1 THEN
  NOTE "action setst"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "setst bad slot"
    FAIL "setst bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "setst bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        SEND s0 setst ST
        LET o_ok = OK
        GETF s0 status
        LET val = LAST
        DUMPOBJ s0
        SYS WRITE d_s0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        SEND s1 setst ST
        LET o_ok = OK
        GETF s1 status
        LET val = LAST
        DUMPOBJ s1
        SYS WRITE d_s1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        SEND s2 setst ST
        LET o_ok = OK
        GETF s2 status
        LET val = LAST
        DUMPOBJ s2
        SYS WRITE d_s2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "setst miss"
      FAIL "setst miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "setst miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "setst ok"
      LET val_ch = 1
      LET meta = "setst"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- ping zero-arg ---
SYS EQS ACTION "ping"
IF LAST_N == 1 THEN
  NOTE "action ping"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "ping bad slot"
    FAIL "ping bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "ping bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        SEND s0 ping
        LET o_ok = OK
        GETF s0 last
        LET val = LAST
        DUMPOBJ s0
        SYS WRITE d_s0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        SEND s1 ping
        LET o_ok = OK
        GETF s1 last
        LET val = LAST
        DUMPOBJ s1
        SYS WRITE d_s1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        SEND s2 ping
        LET o_ok = OK
        GETF s2 last
        LET val = LAST
        DUMPOBJ s2
        SYS WRITE d_s2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "ping miss"
      FAIL "ping miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "ping miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "ping ok"
      LET val_ch = 1
      LET meta = "ping"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- status GETF ---
SYS EQS ACTION "status"
IF LAST_N == 1 THEN
  NOTE "action status"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "status bad slot"
    FAIL "status bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "status bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        GETF s0 status
        LET val = LAST
        GETF s0 n
        LET ret_n = LAST_N
        LET o_ok = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        GETF s1 status
        LET val = LAST
        GETF s1 n
        LET ret_n = LAST_N
        LET o_ok = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        GETF s2 status
        LET val = LAST
        GETF s2 n
        LET ret_n = LAST_N
        LET o_ok = 1
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "status miss"
      FAIL "status miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "status miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "status ok"
      LET val_ch = 1
      LET meta = "status"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      SYS STR ret_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- eq: EQF status WANT ---
SYS EQS ACTION "eq"
IF LAST_N == 1 THEN
  NOTE "action eq"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "eq bad slot"
    FAIL "eq bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "eq bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        EQF s0 status WANT
        LET o_ok = OK
        LET ret_n = LAST_N
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        EQFI s1 status WANT
        LET o_ok = OK
        LET ret_n = LAST_N
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        NEQF s2 status WANT
        LET o_ok = OK
        LET ret_n = LAST_N
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "eq miss"
      FAIL "eq miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "eq miss"
      END
    ELSE
      IF ret_n == 0 THEN
        LET miss = 1
        LET note_msg = "eq false"
        LET val = WANT
        LET val_ch = 1
        LET meta = "eq false"
        SYS PUSH meta sn
        LET meta = LAST
        SYS PUSH meta WANT
        LET meta = LAST
        LET meta_ch = 1
        FAIL "eq false"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "eq false"
        END
      ELSE
        LET hit = 1
        LET note_msg = "eq true"
        LET val = WANT
        LET val_ch = 1
        LET meta = "eq true"
        SYS PUSH meta sn
        LET meta = LAST
        SYS PUSH meta WANT
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- gate: n >= MINN ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET o_ok = 0
    LET dnow = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        GETF s0 n
        LET dnow = LAST_N
        LET o_ok = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        GETF s1 n
        LET dnow = LAST_N
        LET o_ok = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        GETF s2 n
        LET dnow = LAST_N
        LET o_ok = 1
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "gate miss"
      FAIL "gate miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "gate miss"
      END
    ELSE
      LET ret_n = dnow
      IF dnow < MINN THEN
        LET miss = 1
        LET note_msg = "gate deny"
        SYS STR dnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate deny"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR dnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINN
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "gate deny"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "gate deny"
        END
      ELSE
        LET hit = 1
        LET note_msg = "gate admit"
        SYS STR dnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate admit"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR dnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINN
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- probe: TRYSEND under/over arity ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET p_ok = 1
  TRYSEND nosuch bump 1
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYSEND nosuch should soft-fail"
  END
  CLEAR_ERR
  HASOBJ s0
  IF LAST_N == 1 THEN
    # under-arity
    TRYSEND s0 bump
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe under-arity should fail"
    END
    SYS HAS LAST_ERR "needs 1"
    IF LAST_N != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe LAST_ERR should needs 1"
    END
    SYS HAS LAST_ERR "got 0"
    IF LAST_N != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe LAST_ERR should got 0"
    END
    IF ARITY_NEED != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe ARITY_NEED should 1"
    END
    IF ARITY_GOT != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe ARITY_GOT should 0"
    END
    CLEAR_ERR
    # correct after soft
    SEND s0 bump 1
    IF OK == 0 THEN
      LET p_ok = 0
      LET note_msg = "probe SEND after soft broken"
    END
    CLEAR_ERR
    # over-arity: document behavior
    TRYSEND s0 bump 1 2
    LET over_ok = OK
    LET over_got = ARITY_GOT
    # zero-arg ping ok
    SEND s0 ping
    IF OK == 0 THEN
      LET p_ok = 0
      LET note_msg = "probe ping should ok"
    END
    CLEAR_ERR
    # EQF case
    SEND s0 setst "Hot"
    EQF s0 status "hot"
    IF LAST_N != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe EQF case should miss"
    END
    EQFI s0 status "hot"
    IF LAST_N != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe EQFI should hit"
    END
    CLEAR_ERR
    DUMPOBJ s0
    SYS WRITE d_s0 LAST
    CLEAR_ERR
    LET ret_n = over_ok
    LET changed = over_got
  END
  IF p_ok == 1 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET val = "probe"
    LET val_ch = 1
    LET meta = "probe soft"
    SYS STR over_ok
    SYS PUSH meta LAST
    LET meta = LAST
    SYS STR over_got
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  ELSE
    LET miss = 1
    FAIL note_msg
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "dump bad slot"
    FAIL "dump bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "dump bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ s0
      IF LAST_N == 1 THEN
        DUMPOBJ s0
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_s0 val
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ s1
      IF LAST_N == 1 THEN
        DUMPOBJ s1
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_s1 val
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ s2
      IF LAST_N == 1 THEN
        DUMPOBJ s2
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_s2 val
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "dump miss"
      FAIL "dump miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "dump miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "dump ok"
      LET val_ch = 1
      LET meta = "dump"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ s0
  IF LAST_N == 1 THEN
    DELETEOBJ s0
    CLEAR_ERR
  END
  HASOBJ s1
  IF LAST_N == 1 THEN
    DELETEOBJ s1
    CLEAR_ERR
  END
  HASOBJ s2
  IF LAST_N == 1 THEN
    DELETEOBJ s2
    CLEAR_ERR
  END
  SYS WRITE d_s0 ""
  SYS WRITE d_s1 ""
  SYS WRITE d_s2 ""
  SYS WRITE objs_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

