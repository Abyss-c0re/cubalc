# svc_hasflagall_contract_board.cubalc — HASFLAGS/HASFLAGALL fleet CLI flag contract
#
# Real use: fleet agents gate CLI contracts by flag count (HASFLAGS/HASFLAGC)
# and multi named-flag presence (HASFLAGALL/NEEDFLAGS) without N× HASFLAG
# branches or LISTFLAGS bag soup. First realworld of 1359 HASFLAGS + 1362
# HASFLAGALL (1.15.814).
#
#   HASFLAGS [min] · HASFLAGC min → soft 0|1 count probe
#   HASFLAGALL names… · NEEDFLAGS names… → all-present gate · FLAGMISS/HAVE
#   soft miss partial · short -w vs workers · bare -- ends flags
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_hfa_$$
#   ./out/cubalc run programs/realworld/svc_hasflagall_contract_board.cubalc boot
#   ./out/cubalc run ... count|all|need|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt HFA_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_HFA_REQUIRE
#
# Edges: CUBALC_ARG* via SYS ENV SET only (export host dead W1);
#   forms catalog omits HASFLAG* prefix; PRINT clobber; WRITE NL;
#   NEEDFLAGS sticky ERR on miss exit_code may stay 0

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_hasflagall_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_hasflagall_contract -- boot|count|all|need|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_HFA_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "HFA_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET flag_n = 0
LET miss_n = 0
LET have_n = 0

ONEOF ACTION "boot", "count", "all", "need", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "count" THEN
    LET op = "count"
  WHEN "all" THEN
    LET op = "all"
  WHEN "need" THEN
    LET op = "need"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-hfa\",\"schema\":\"cubalc.svc_hasflagall_contract.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"flag_contract\",\"label\":\"hfa\",\"cfg\":{\"surface\":\"HASFLAGS,HASFLAGC,HASFLAGALL,NEEDFLAGS,LISTFLAGS\",\"contract\":\"mode,verbose\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"flag_contract\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-hfa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_hasflagall_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "flag_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# count — HASFLAGS / HASFLAGC min probes
SYS EQS op "count"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # empty
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV UNSET CUBALC_ARG1
  SYS ENV UNSET CUBALC_ARG2
  SYS ENV SET CUBALC_ARGC "0"
  HASFLAGS
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # positionals only
  SYS ENV SET CUBALC_ARG0 "a.txt"
  SYS ENV SET CUBALC_ARG1 "b.txt"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGS 1
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # two flags
  SYS ENV SET CUBALC_ARG0 "--mode=seal"
  SYS ENV SET CUBALC_ARG1 "--verbose"
  SYS ENV SET CUBALC_ARG2 "out.bin"
  SYS ENV SET CUBALC_ARGC "3"
  HASFLAGS
  LET flag_n = LAST_N
  CLEAR_ERR
  IF flag_n == 1 THEN
    LET score = score + 1
  END
  HASFLAGS 2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGS 3
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGC 2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF LISTFLAGS_N == 2 THEN
    LET score = score + 1
  END
  LISTFLAGS
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "count ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "count score"
    FAIL "count score"
    CLEAR_ERR
  END
  SYS CAT "count:2:ct"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "count:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n flag_n score note_msg
  CLEAR_ERR
END

# all — HASFLAGALL multi named presence
SYS EQS op "all"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # full contract present
  SYS ENV SET CUBALC_ARG0 "--mode=seal"
  SYS ENV SET CUBALC_ARG1 "--verbose"
  SYS ENV SET CUBALC_ARG2 "a.bin"
  SYS ENV SET CUBALC_ARGC "3"
  HASFLAGALL mode verbose
  LET sum_v = LAST_N
  LET have_n = HASFLAGALL_N
  LET miss_n = FLAGMISS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF have_n == 2 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  # CSV bag form
  HASFLAGALL "mode,verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # short -w is name w not workers
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "--out=hi.txt"
  SYS ENV SET CUBALC_ARG2 "-w"
  SYS ENV SET CUBALC_ARG3 "4"
  SYS ENV SET CUBALC_ARGC "4"
  HASFLAGALL verbose out w
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGALL verbose out workers
  LET sum_n = LAST_N
  LET miss_n = FLAGMISS_N
  LET stem_s = FLAGMISS
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE stem_s "workers"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "all ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "all score"
    FAIL "all score"
    CLEAR_ERR
  END
  SYS CAT "all:" have_n ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "all:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n have_n miss_n score note_msg
  CLEAR_ERR
END

# need — NEEDFLAGS hard twin when present
SYS EQS op "need"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--mode=x"
  SYS ENV SET CUBALC_ARG1 "--verbose=1"
  SYS ENV SET CUBALC_ARGC "2"
  NEEDFLAGS mode verbose
  LET sum_v = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF FLAGMISS_N == 0 THEN
    LET score = score + 1
  END
  # soft miss then sticky
  SYS ENV SET CUBALC_ARG0 "--only"
  SYS ENV SET CUBALC_ARGC "1"
  HASFLAGALL mode verbose
  LET sum_n = LAST_N
  LET miss_n = FLAGMISS_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 2 THEN
    LET score = score + 1
  END
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE FLAGMISS "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDFLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "need ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "need score"
    FAIL "need score"
    CLEAR_ERR
  END
  SYS CAT "need:" miss_n ":nd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "need:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n miss_n score note_msg
  CLEAR_ERR
END

# soft — empty names · bare -- ends flags
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV SET CUBALC_ARGC "0"
  HASFLAGALL
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF FLAGMISS_N == 0 THEN
    LET score = score + 1
  END
  # bare -- ends flags
  SYS ENV SET CUBALC_ARG0 "--dry"
  SYS ENV SET CUBALC_ARG1 "--"
  SYS ENV SET CUBALC_ARG2 "--notflag"
  SYS ENV SET CUBALC_ARGC "3"
  HASFLAGS 1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGS 2
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF LISTFLAGS_N == 1 THEN
    LET score = score + 1
  END
  # IF branch style
  SYS ENV SET CUBALC_ARG0 "--mode=x"
  SYS ENV SET CUBALC_ARG1 "--dry"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGALL mode dry
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-hfa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LISTFLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate surface + live HASFLAGALL
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--mode=seal"
  SYS ENV SET CUBALC_ARG1 "--verbose"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGALL mode verbose
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGS 2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDFLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasflagall_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "flag_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# alias — HASFLAGC twin + dash-prefixed names
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "--out=x"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGC 2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGALL "--verbose" "--out"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM HASFLAGALL
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM NEEDFLAGS
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LISTFLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS EQS LAST "mode,verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — FLAGHAVE bag · PRINT · partial miss
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "file.txt"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGALL verbose out
  LET sum_v = LAST_N
  LET miss_n = FLAGMISS_N
  LET have_n = HASFLAGALL_N
  LET body = FLAGHAVE
  LET stem_s = FLAGMISS
  CLEAR_ERR
  PRINT "probe-mark"
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 1 THEN
    LET score = score + 1
  END
  IF have_n == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "out"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # LAST after PRINT is not FLAGHAVE
  SYS HASLINE LAST "verbose"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasflagall_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "flag_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" miss_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n miss_n have_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_hasflagall_contract.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " flag_n=" flag_n " miss_n=" miss_n " have_n=" have_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_hasflagall_contract_board: done"
PASS
