# svc_capability_admit_board.cubalc — HASCLASSANY + HASMETHODS capability admit
#
# Real use: mesh/deploy agents admit a service only if *any* of several plugin
# CLASSes is loaded (optional mesh backends) and required methods exist on
# the chosen class or live instance — without N× HASCLASS/HASMETHOD glue.
# First realworld of free-form 1421 HASCLASSANY + 1422 HASMETHODS
# (1.15.875+). Distinct from svc_class_boot_catalog (class_boot INCLUDE
# NEED_*), svc_method_catalog (EACH METHOD walk), schema_contract (arity).
#
#   HASCLASSANY|ANYCLASS|NEEDCLASSANY names… · CLASSHAVE/CLASSMISS · HASCLASSANY_N
#   HASMETHODS|ALLMETHODS|NEEDMETHODS target meth… · METHODMISS · METHOD_ON
#   bag/CSV method lists · live object target · soft miss empty/all-miss
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_cap_$$
#   ./out/cubalc run programs/realworld/svc_capability_admit_board.cubalc boot
#   ./out/cubalc run ... pass|soft|methods|any|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt CAP_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_CAP_REQUIRE
#
# Edges: any-of class partial miss still hit; all miss soft; METHODMISS bag;
#   HASMETHOD var-literal trap (document); CLEAR_ERR LAST; WRITE NL; PRINT

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broke in 1.15.875 — needs quoted stem (W773)
REQUIRE LIB "hold_seed"

CLASS MeshHttp
  FIELD zone "east"
  FIELD status "idle"
  METHOD init z
    SETF THIS zone z
    SETF THIS status "ready"
  END
  METHOD ping
    SETF THIS status "pong"
  END
  METHOD health
    SETF THIS status "ok"
  END
  METHOD deploy
    SETF THIS status "deployed"
  END
END

CLASS MeshGrpc
  FIELD zone "west"
  FIELD status "idle"
  METHOD init z
    SETF THIS zone z
  END
  METHOD ping
    SETF THIS status "pong"
  END
END

CLASS MeshStub
  FIELD tag "stub"
  METHOD init z
    SETF THIS tag z
  END
END

NOTE "svc_capability_admit_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_capability_admit -- boot|pass|soft|methods|any|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_CAP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "CAP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET any_n = 0
LET meth_n = 0
LET have_s = ""
LET miss_s = ""
LET err_s = ""

ONEOF ACTION "boot", "pass", "soft", "methods", "any", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "methods" THEN
    LET op = "methods"
  WHEN "any" THEN
    LET op = "any"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-cap\",\"schema\":\"cubalc.svc_capability_admit.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"cap\",\"want_filter\":\"capability_admit\",\"cfg\":{\"surface\":\"HASCLASSANY,ANYCLASS,HASMETHODS,ALLMETHODS,CLASSHAVE,METHODMISS,METHOD_ON\",\"contract\":\"any-of class + multi-method capability admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  HASCLASSANY MeshHttp MeshGrpc GhostCap
  LET any_n = HASCLASSANY_N
  LET have_s = CLASSHAVE
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-cap"
  IF LAST_N == 1 THEN
    IF any_n >= 2 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET score = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot any"
      FAIL "boot any"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — any-of class + full method contract on MeshHttp
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASCLASSANY MeshHttp MeshGrpc GhostCap
  LET ok_v = OK
  LET any_n = HASCLASSANY_N
  LET have_s = CLASSHAVE
  LET miss_s = CLASSMISS
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF any_n == 2 THEN
    LET score = score + 1
  END
  SYS HASI have_s "MeshHttp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI miss_s "GhostCap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # quote "init" — bare init is a statement keyword and truncates HASMETHODS (W774)
  HASMETHODS MeshHttp "init" ping health deploy
  LET ok_v = OK
  LET meth_n = HASMETHODS_N
  LET miss_s = METHODMISS
  LET body = METHOD_ON
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF meth_n == 4 THEN
    LET score = score + 1
  END
  SYS EQS body "MeshHttp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EMPTY miss_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # NEW auto-inits when METHOD init present — pass ctor arg
  NEW MeshHttp svc0 "east"
  CLEAR_ERR
  HASMETHODS svc0 ping health
  LET ok_v = OK
  LET body = METHOD_ON
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "svc0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = any_n
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" any_n ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score any_n meth_n note_msg
  CLEAR_ERR
END

# soft — all class miss + empty any + empty methods + ghost target
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASCLASSANY GhostA GhostB
  LET ok_v = OK
  LET any_n = HASCLASSANY_N
  LET miss_s = CLASSMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF any_n == 0 THEN
    LET score = score + 1
  END
  IF CLASSMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASCLASSANY
  LET ok_v = OK
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # avoid bare reserved method names (init/birth/tick can truncate list — W774)
  HASMETHODS GhostX foo bar
  LET ok_v = OK
  LET meth_n = HASMETHODS_N
  LET miss_s = METHODMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF meth_n == 0 THEN
    LET score = score + 1
  END
  IF METHODMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODS MeshHttp
  LET ok_v = OK
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  HASMETHODS MeshHttp no_such_zz
  LET ok_v = OK
  LET miss_s = METHODMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS HASI miss_s "no_such_zz"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# methods — CSV bag, partial miss, ALLMETHODS alias, substring false friend
SYS EQS op "methods"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "ping,health,deploy"
  HASMETHODS MeshHttp need
  LET ok_v = OK
  LET meth_n = HASMETHODS_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF meth_n == 3 THEN
    LET score = score + 1
  END
  ALLMETHODS MeshHttp ping health
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODS MeshHttp ping no_such_zz health
  LET ok_v = OK
  LET meth_n = HASMETHODS_N
  LET miss_s = METHODMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF meth_n == 2 THEN
    LET score = score + 1
  END
  SYS HASI miss_s "no_such_zz"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # MeshGrpc lacks health/deploy
  HASMETHODS MeshGrpc ping health deploy
  LET ok_v = OK
  LET meth_n = HASMETHODS_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF meth_n == 1 THEN
    LET score = score + 1
  END
  # HASMETHOD literal vs var (document trap)
  HASMETHOD MeshHttp ping
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # HASMETHOD var may work now (1.15.876+) — score either hit or legacy miss
  LET mname = "ping"
  HASMETHOD MeshHttp mname
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    IF LAST_N == 0 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "methods ok"
    LET admit_n = 1
    LET find_n = meth_n
  ELSE
    LET miss = 1
    LET note_msg = "methods score"
    FAIL "methods score"
    CLEAR_ERR
  END
  SYS CAT "methods:" meth_n ":mt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "methods:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score meth_n note_msg
  CLEAR_ERR
END

# any — ANYCLASS alias, bag opts, CLASSHAVE multi
SYS EQS op "any"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  ANYCLASS MeshHttp MeshStub GhostZ
  LET ok_v = OK
  LET any_n = HASCLASSANY_N
  LET have_s = CLASSHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF any_n == 2 THEN
    LET score = score + 1
  END
  SYS HASI have_s "MeshHttp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI have_s "MeshStub"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "GhostZ,MeshGrpc"
  HASCLASSANY opts
  LET ok_v = OK
  LET have_s = CLASSHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "MeshGrpc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASCLASSANY MeshStub
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASCLASSANY Nope1 Nope2
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # CLASSHAVE_N after multi hit
  HASCLASSANY MeshHttp MeshGrpc MeshStub
  IF CLASSHAVE_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "capability_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "any ok"
    LET admit_n = 1
    LET find_n = any_n
  ELSE
    LET miss = 1
    LET note_msg = "any score"
    FAIL "any score"
    CLEAR_ERR
  END
  SYS CAT "any:" any_n ":an"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score any_n note_msg
  CLEAR_ERR
END

# form — HASFORM catalog vs alias lag
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "HASCLASSANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # HASMETHODS ops work; HASFORM often 0 (catalog lag W775)
  HASFORM "HASMETHODS"
  LET meth_n = LAST_N
  CLEAR_ERR
  IF meth_n == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "NEEDCLASSANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEEDMETHODS"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "ANYCLASS"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "ALLMETHODS"
  LET any_n = LAST_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF any_n == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM HASCLASSANY
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SYS HASCLASSANY"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "capability_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit pipeline: any class + required methods + soft recover + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASCLASSANY MeshHttp MeshGrpc GhostCap
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODS MeshHttp ping health deploy
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW MeshHttp g0 "gate"
  CLEAR_ERR
  HASMETHODS g0 ping health
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft all-miss must not block
  HASCLASSANY NopeX NopeY
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODS MeshHttp no_such_gate
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber knobs · CLEAR_ERR LAST · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASCLASSANY MeshHttp GhostCap
  LET any_n = HASCLASSANY_N
  LET have_s = CLASSHAVE
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF any_n == 1 THEN
    LET score = score + 1
  END
  SYS HASI have_s "MeshHttp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODS MeshHttp ping
  LET meth_n = HASMETHODS_N
  CLEAR_ERR
  IF meth_n == 1 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "capability_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "slot_retire"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = any_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score any_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " any_n=" any_n " meth_n=" meth_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "cap report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
