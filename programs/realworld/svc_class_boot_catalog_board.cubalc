# svc_class_boot_catalog_board.cubalc — class_boot/class_guard fleet CLASS catalog
#
# Real use: fleet agents gate required OOP CLASS names (ALL + optional ANY)
# via INCLUDE class_boot before NEW/SEND, instead of N× LISTCLASSES glue.
# First realworld of 1401 class_guard + class_boot (1.15.854+ · MI 862
# · init --class). Distinct from svc_method_catalog_board (methods plane).
#
#   DEFAULT NEED_CLASSES · NEED_CLASS_ANY · CLASS_GUARD_SOFT
#   INCLUDE class_boot|class_guard → CLASS_GUARD_OK / ALL_OK / ANY_OK
#   CLASSHAVE / CLASSMISS bags · CLASSHAVE_N / CLASSMISS_N
#   LISTCLASSES + SYS HASLINE exact · soft miss · hard HASLINE+FAIL
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_scc_$$
#   ./out/cubalc run programs/realworld/svc_class_boot_catalog_board.cubalc boot
#   ./out/cubalc run ... pass|soft_all|soft_any|hard|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SCC_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SCC_REQUIRE
#
# Edges: LET knobs before each re-INCLUDE; hard miss exit_code 0;
#   HASLINE exact class name (substring false friend);
#   FAIL LAST_ERR hard path may form-break (W719 class);
#   REQUIRE CLASS avoided inside INCLUDE; double agent_boot via class_boot;
#   CLASSHAVE multiline PRINT; WRITE NL; auto-seed plate; empty NEED_* skips

INCLUDE agent_boot
REQUIRE LIB hold_seed

# fleet OOP type catalog (defined before gates so LISTCLASSES can see them)
CLASS FleetTicket
  FIELD id ""
  FIELD status "open"
END

CLASS FleetOrder
  FIELD n 0
  FIELD tag "ord"
END

CLASS FleetCell
  FIELD slot ""
END

NOTE "svc_class_boot_catalog_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_class_boot_catalog -- boot|pass|soft_all|soft_any|hard|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeC"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SCC_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SCC_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET cgo = 0
LET allo = 0
LET anyo = 0
LET have_n = 0
LET miss_n = 0
LET have_s = ""
LET miss_s = ""

ONEOF ACTION "boot", "pass", "soft_all", "soft_any", "hard", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_all" THEN
    LET op = "soft_all"
  WHEN "soft_any" THEN
    LET op = "soft_any"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

# auto-seed agent plate (ENSUREPLATE will not reseed {})
SYS EQS op "list"
IF LAST_N == 0 THEN
  SYS EQS op "clear"
  IF LAST_N == 0 THEN
    LET need_seed = 1
    SYS EXIST agent_path
    IF LAST_N == 1 THEN
      SYS READ OR agent_path OR ""
      SYS HAS LAST "svc-scc"
      IF LAST_N == 1 THEN
        LET need_seed = 0
      END
      CLEAR_ERR
    END
    CLEAR_ERR
    IF need_seed == 1 THEN
      SYS TRIM host_s
      LET host_s = LAST
      SYS TRIM role_s
      LET role_s = LAST
      CLEAR_ERR
      LET PLATE_PATH = agent_path
      LET PEER_PATH = peer_path
      SYS CAT "{\"agent\":\"svc-scc\",\"schema\":\"cubalc.svc_class_boot_catalog.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"class_catalog\",\"label\":\"scc\",\"cfg\":{\"surface\":\"class_boot,class_guard,NEED_CLASSES,NEED_CLASS_ANY,CLASS_GUARD_SOFT,CLASS_GUARD_OK,CLASSHAVE,CLASSMISS,LISTCLASSES\",\"contract\":\"CLASS catalog gate · init --class\"}}"
      LET PLATE_SEED = LAST
      CLEAR_ERR
      SYS CAT "{\"peer\":\"class_catalog\",\"n\":1}"
      LET PEER_SEED = LAST
      CLEAR_ERR
      SYS RM agent_path
      CLEAR_ERR
      SYS RM peer_path
      CLEAR_ERR
      INCLUDE plate_peer_session
      CLEAR_ERR
      SYS SAVEPLATE agent_path PLATE
      CLEAR_ERR
    END
  END
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-scc\",\"schema\":\"cubalc.svc_class_boot_catalog.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"class_catalog\",\"label\":\"scc\",\"cfg\":{\"surface\":\"class_boot,class_guard,NEED_CLASSES,NEED_CLASS_ANY,CLASS_GUARD_SOFT,CLASS_GUARD_OK,CLASSHAVE,CLASSMISS,LISTCLASSES\",\"contract\":\"CLASS catalog gate · init --class\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"class_catalog\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  SYS RM agent_path
  CLEAR_ERR
  SYS RM peer_path
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_class_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "class_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "class_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — required CLASSes present (ALL + ANY)
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetTicket\nFleetOrder"
  LET NEED_CLASS_ANY = "FleetCell\nnosuch_class_pass_any"
  LET CLASS_GUARD_SOFT = 0
  INCLUDE class_boot
  LET cgo = CLASS_GUARD_OK
  LET allo = CLASS_GUARD_ALL_OK
  LET anyo = CLASS_GUARD_ANY_OK
  CLEAR_ERR
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  LISTCLASSES
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "FleetTicket"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "FleetOrder"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_CLASSES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "class_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "CLASS_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "class_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" cgo ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score cgo allo anyo note_msg
  CLEAR_ERR
END

# soft_all — missing CLASS under soft · CLASSMISS bag · substring false friend
SYS EQS op "soft_all"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetTicket\nnosuch_cubalc_class_scc_all"
  LET NEED_CLASS_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  INCLUDE class_guard
  LET cgo = CLASS_GUARD_OK
  LET allo = CLASS_GUARD_ALL_OK
  LET miss_n = CLASSMISS_N
  LET have_n = CLASSHAVE_N
  LET miss_s = CLASSMISS
  LET have_s = CLASSHAVE
  CLEAR_ERR
  IF cgo == 0 THEN
    LET score = score + 1
  END
  IF allo == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE miss_s "nosuch_cubalc_class_scc_all"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE have_s "FleetTicket"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend: partial class name must not match
  LISTCLASSES
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "Fleet"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "CLASSMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "CLASS_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_CLASSES = ""
  LET NEED_CLASS_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  INCLUDE class_guard
  LET cgo = CLASS_GUARD_OK
  CLEAR_ERR
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_all ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_all score"
    FAIL "soft_all score"
    CLEAR_ERR
  END
  SYS CAT "soft_all:" miss_n ":sa"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_all:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score miss_n have_n note_msg
  CLEAR_ERR
END

# soft_any — none of ANY · then hit
SYS EQS op "soft_any"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = ""
  LET NEED_CLASS_ANY = "nosuch_class_a_scc\nnosuch_class_b_scc"
  LET CLASS_GUARD_SOFT = 1
  INCLUDE class_guard
  LET cgo = CLASS_GUARD_OK
  LET anyo = CLASS_GUARD_ANY_OK
  CLEAR_ERR
  IF cgo == 0 THEN
    LET score = score + 1
  END
  IF anyo == 0 THEN
    LET score = score + 1
  END
  LET NEED_CLASS_ANY = "nosuch_class_a_scc\nFleetTicket"
  LET CLASS_GUARD_SOFT = 1
  INCLUDE class_guard
  LET cgo = CLASS_GUARD_OK
  LET anyo = CLASS_GUARD_ANY_OK
  CLEAR_ERR
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_CLASS_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "CLASSHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "class_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "class_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_any ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_any score"
    FAIL "soft_any score"
    CLEAR_ERR
  END
  SYS CAT "soft_any:" anyo ":sy"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score cgo anyo note_msg
  CLEAR_ERR
END

# hard — present CLASSes under hard guard
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetTicket\nFleetOrder\nFleetCell"
  LET NEED_CLASS_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  INCLUDE class_boot
  LET cgo = CLASS_GUARD_OK
  LET allo = CLASS_GUARD_ALL_OK
  CLEAR_ERR
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  LET NEED_CLASSES = ""
  LET NEED_CLASS_ANY = "nosuch_class_hard_z\nFleetTicket"
  LET CLASS_GUARD_SOFT = 0
  INCLUDE class_guard
  LET anyo = CLASS_GUARD_ANY_OK
  LET cgo = CLASS_GUARD_OK
  CLEAR_ERR
  IF anyo == 1 THEN
    LET score = score + 1
  END
  IF cgo == 1 THEN
    LET score = score + 1
  END
  LISTCLASSES
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "FleetCell"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "FleetOrder"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LISTCLASSES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "class_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "class_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:" cgo ":hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score cgo note_msg
  CLEAR_ERR
END

# form — HASLIB / HASINCLUDE · HASFORM knobs miss
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = ""
  LET NEED_CLASS_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  INCLUDE class_boot
  CLEAR_ERR
  HASLIB class_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB class_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE class_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE class_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE agent_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "LISTCLASSES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "CLASS_GUARD_OK"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "class_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_CLASS_ANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + soft combined ALL+ANY
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetTicket\nFleetOrder"
  LET NEED_CLASS_ANY = "FleetCell\nnosuch_gate_x"
  LET CLASS_GUARD_SOFT = 1
  INCLUDE class_boot
  LET cgo = CLASS_GUARD_OK
  LET allo = CLASS_GUARD_ALL_OK
  LET anyo = CLASS_GUARD_ANY_OK
  LET have_n = CLASSHAVE_N
  CLEAR_ERR
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_CLASSES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "CLASSHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "CLASS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "class_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score cgo note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · multiline CLASSHAVE
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetTicket\nFleetOrder"
  LET NEED_CLASS_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  INCLUDE class_guard
  LET cgo = CLASS_GUARD_OK
  LET have_n = CLASSHAVE_N
  LET have_s = CLASSHAVE
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 2 THEN
    LET score = score + 1
  END
  SYS LINES have_s
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE have_s "FleetOrder"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "class_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "class_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "CLASSMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "class_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "scc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score cgo have_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " cgo=" cgo " allo=" allo " anyo=" anyo " have_n=" have_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "scc report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
