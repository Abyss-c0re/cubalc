SYS PUSH report LAST
LET report = LAST
SYS PUSH report "find_total"
LET report = LAST
SYS STR find_total
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "first_i"
LET report = LAST
SYS STR first_i
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "last_i"
LET report = LAST
SYS STR last_i
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "op_n"
LET report = LAST
SYS STR op_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "op_total"
LET report = LAST
