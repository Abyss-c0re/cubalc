# peer_contract_needp_from_board.cubalc — NEEDP/HASP/KEYSP/DUMPP FROM peer gate
#
# Real use: mesh admit gate probes a peer session object for required keys
# without LET PLATE = peer. KEYSP discovers contract; HASPALL soft-misses;
# NEEDP hard-requires; DUMPP emits cubalc.plate_info.v1 for health inspect.
# First realworld of proofs 1132 + 1133.
#
#   KEYSP|HASP|HASPALL|NEEDP|DUMPP FROM peer
#   *_FROM knobs · PLATE identity preserved
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_pcnf_$$
#   ./out/cubalc run programs/realworld/peer_contract_needp_from_board.cubalc boot
#   ./out/cubalc run ... peer -- --host=cubeB
#   ./out/cubalc run ... keys|has|need|dump|softmiss|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt PCNF_REPORT.txt peer.json agent.json
# Env: HOST_S ROLE_S CUBALC_PCNF_REQUIRE
#
# Edges:
#   HASPALL miss bag lists status; NEEDP success only; DUMPP_SRC=peer;
#   PLATE KEYSP_N different; empty peer; soft empty bag; WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "peer_contract_needp_from_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "peer_contract_needp_from -- boot|peer|keys|has|need|dump|softmiss|gate|probe|soft|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeB"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_PCNF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "PCNF_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET from_n = 0
LET peer = "{}"

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "peer", "keys", "has", "need", "dump", "softmiss", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "keys" THEN
    LET op = "keys"
  WHEN "has" THEN
    LET op = "has"
  WHEN "need" THEN
    LET op = "need"
  WHEN "dump" THEN
    LET op = "dump"
  WHEN "softmiss" THEN
    LET op = "softmiss"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — durable agent PLATE
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "agent" "plate-agent" "n" 1 "schema" "cubalc.peer_contract.v1"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_session
  CLEAR_ERR
  SETP "agent" "plate-agent"
  CLEAR_ERR
  SETP "n" 1
  CLEAR_ERR
  INCLUDE plate_save
  CLEAR_ERR
  SYS WRITE peer_path "{}"
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
    LET created = 1
    LET take_n = 1
    SYS CAT "boot:plate-agent:bt"
    LET row = LAST
    CLEAR_ERR
    SYS GREPV "boot:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot agent"
    FAIL "boot agent"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n note_msg
  CLEAR_ERR
END

# peer — seed complete peer contract object
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  CLEAR_ERR
  SYS JSONOBJ "agent" "hive-02" "host" host_s "n" 9 "role" role_s
  LET peer = LAST
  CLEAR_ERR
  SYS WRITE peer_path peer
  CLEAR_ERR
  SYS READ peer_path
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  HASP FROM peer "host"
  LET from_n = HASP_FROM
  LET peel_hit = HASP_HIT
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET has_n = LAST_N
  CLEAR_ERR
  IF from_n == 1 THEN
    IF peel_hit == 1 THEN
      IF has_n == 1 THEN
        LET hit = 1
        LET note_msg = "peer ok"
        LET admit_n = 1
        LET take_n = 1
        SYS CAT "peer:" host_s ":pr"
        LET row = LAST
        CLEAR_ERR
        SYS GREPV "peer:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
      ELSE
        LET miss = 1
        LET note_msg = "peer plate"
        FAIL "peer plate"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer host"
      FAIL "peer host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer from"
    FAIL "peer from"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n peel_hit has_n note_msg
  CLEAR_ERR
END

# keys — KEYSP FROM peer vs PLATE
SYS EQS op "keys"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  KEYSP FROM peer
  LET from_n = KEYSP_FROM
  LET take_n = KEYSP_N
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "host"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "role"
  LET has_n = LAST_N
  CLEAR_ERR
  KEYSP
  LET load_hit = KEYSP_FROM
  LET miss_n = KEYSP_N
  CLEAR_ERR
  # peer 4 keys, plate has agent+n+schema maybe 3
  IF from_n == 1 THEN
    IF take_n == 4 THEN
      IF peel_hit == 1 THEN
        IF has_n == 1 THEN
          IF load_hit == 0 THEN
            LET hit = 1
            LET note_msg = "keys ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "keys plate from"
            FAIL "keys plate from"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "keys role"
          FAIL "keys role"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "keys host"
        FAIL "keys host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "keys n"
      FAIL "keys n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "keys from"
    FAIL "keys from"
    CLEAR_ERR
  END
  SYS CAT "keys:" take_n ":" miss_n ":ky"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "keys:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n take_n peel_hit has_n miss_n note_msg
  CLEAR_ERR
END

# has — HASP + HASPALL complete contract
SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  HASP FROM peer "host"
  LET from_n = HASP_FROM
  LET peel_hit = HASP_HIT
  CLEAR_ERR
  HASPALL FROM peer "agent" "host" "n" "role"
  LET take_n = HASPALL_FROM
  LET has_n = HASPALL_N
  CLEAR_ERR
  # PLATE lacks host
  HASP "host"
  LET load_hit = HASP_HIT
  LET miss_n = HASP_FROM
  CLEAR_ERR
  IF from_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n == 1 THEN
        IF has_n == 1 THEN
          IF load_hit == 0 THEN
            IF miss_n == 0 THEN
              LET hit = 1
              LET note_msg = "has ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "has plate from"
              FAIL "has plate from"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "has plate host"
            FAIL "has plate host"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "has all n"
          FAIL "has all n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "has all from"
        FAIL "has all from"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "has host"
      FAIL "has host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "has from"
    FAIL "has from"
    CLEAR_ERR
  END
  SYS CAT "has:" peel_hit ":" has_n ":hs"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "has:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n peel_hit take_n has_n load_hit note_msg
  CLEAR_ERR
END

# need — NEEDP FROM required keys (success path)
SYS EQS op "need"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  NEEDP FROM peer "agent" "host"
  LET from_n = NEEDP_FROM
  LET take_n = NEEDP_N
  CLEAR_ERR
  NEEDP "n" "role" FROM peer
  LET peel_hit = NEEDP_FROM
  CLEAR_ERR
  NEEDP "agent" "n"
  LET has_n = NEEDP_FROM
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF from_n == 1 THEN
    IF take_n == 1 THEN
      IF peel_hit == 1 THEN
        IF has_n == 0 THEN
          IF load_hit == 1 THEN
            LET hit = 1
            LET note_msg = "need ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "need plate"
            FAIL "need plate"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "need plate from"
          FAIL "need plate from"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "need trail"
        FAIL "need trail"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "need n"
      FAIL "need n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "need from"
    FAIL "need from"
    CLEAR_ERR
  END
  SYS CAT "need:" from_n ":" peel_hit ":nd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "need:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n take_n peel_hit has_n load_hit note_msg
  CLEAR_ERR
END

# dump — DUMPP FROM peer health snapshot
SYS EQS op "dump"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  DUMPP FROM peer
  LET from_n = DUMPP_FROM
  LET take_n = DUMPP_N
  LET peel_hit = DUMPP_HAS
  LET body = LAST
  CLEAR_ERR
  SYS EQS DUMPP_SRC "peer"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS body "cubalc.plate_info.v1"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS DUMPP_KEYS "host"
  LET miss_n = LAST_N
  CLEAR_ERR
  SYS HAS body "\"from\":true"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET created = LAST_N
  CLEAR_ERR
  IF from_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n == 4 THEN
        IF has_n == 1 THEN
          IF load_hit == 1 THEN
            IF miss_n == 1 THEN
              IF admit_n == 1 THEN
                IF created == 1 THEN
                  LET hit = 1
                  LET note_msg = "dump ok"
                  LET out = body
                ELSE
                  LET miss = 1
                  LET note_msg = "dump plate"
                  FAIL "dump plate"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "dump from true"
                FAIL "dump from true"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "dump keys host"
              FAIL "dump keys host"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "dump schema"
            FAIL "dump schema"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "dump src"
          FAIL "dump src"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "dump n"
        FAIL "dump n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "dump has"
      FAIL "dump has"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "dump from"
    FAIL "dump from"
    CLEAR_ERR
  END
  SYS CAT "dump:" take_n ":" from_n ":dp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "dump:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n take_n peel_hit has_n load_hit note_msg
  CLEAR_ERR
END

# softmiss — HASPALL incomplete lists miss keys (no hard NEEDP fail)
SYS EQS op "softmiss"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  HASPALL FROM peer "agent" "status"
  LET from_n = HASPALL_FROM
  LET take_n = HASPALL_N
  LET miss_n = HASPALL_MISS_N
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "status"
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF from_n == 1 THEN
    IF take_n == 0 THEN
      IF miss_n == 1 THEN
        IF peel_hit == 1 THEN
          LET hit = 1
          LET note_msg = "softmiss ok"
          LET admit_n = 0
          LET miss = 1
          FAIL "softmiss status"
          CLEAR_ERR
          IF require_hit > 0 THEN
            EXIT 2 "softmiss require"
          END
        ELSE
          LET miss = 1
          LET note_msg = "softmiss list"
          FAIL "softmiss list"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "softmiss n"
        FAIL "softmiss n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "softmiss all"
      FAIL "softmiss all"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "softmiss from"
    FAIL "softmiss from"
    CLEAR_ERR
  END
  SYS CAT "softmiss:" miss_n ":" peel_hit ":sm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "softmiss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n take_n miss_n peel_hit note_msg
  CLEAR_ERR
END

# gate — need host+role + dump has keys
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR peer_path OR "{}"
  LET peer = LAST
  CLEAR_ERR
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  NEEDP FROM peer "host" "role"
  LET from_n = NEEDP_FROM
  CLEAR_ERR
  DUMPP FROM peer
  LET take_n = DUMPP_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET has_n = LAST_N
  CLEAR_ERR
  IF from_n == 1 THEN
    IF take_n == 4 THEN
      IF has_n == 1 THEN
        LET hit = 1
        LET note_msg = "gate ok"
        LET admit_n = 1
        LET peel_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "gate plate"
        FAIL "gate plate"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate dump n"
      FAIL "gate dump n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate need"
    FAIL "gate need"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate need"
    END
  END
  SYS CAT "gate:" from_n ":" take_n ":ga"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n from_n take_n has_n note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — empty peer KEYSP 0; HASP miss; DUMPP empty; PLATE DUMPP from false
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LOADPLATE agent_path
  LET PLATE = LAST
  CLEAR_ERR
  LET peer = "{}"
  CLEAR_ERR
  KEYSP FROM peer
  LET from_n = KEYSP_FROM
  LET take_n = KEYSP_N
  CLEAR_ERR
  HASP FROM peer "host"
  LET peel_hit = HASP_HIT
  CLEAR_ERR
  DUMPP FROM peer
  LET has_n = DUMPP_N
  LET load_hit = DUMPP_FROM
  CLEAR_ERR
  DUMPP
  LET miss_n = DUMPP_FROM
  CLEAR_ERR
  SYS EQS DUMPP_SRC "PLATE"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET created = LAST_N
  CLEAR_ERR
  IF from_n == 1 THEN
    IF take_n == 0 THEN
      IF peel_hit == 0 THEN
        IF has_n == 0 THEN
          IF load_hit == 1 THEN
            IF miss_n == 0 THEN
              IF admit_n == 1 THEN
                IF created == 1 THEN
                  LET hit = 1
                  LET note_msg = "probe ok"
                ELSE
                  LET miss = 1
                  LET note_msg = "probe agent"
                  FAIL "probe agent"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "probe plate src"
                FAIL "probe plate src"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe plate from"
              FAIL "probe plate from"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe dump from"
            FAIL "probe dump from"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe dump n"
          FAIL "probe dump n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe hasp"
        FAIL "probe hasp"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe keys n"
      FAIL "probe keys n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe keys from"
    FAIL "probe keys from"
    CLEAR_ERR
  END
  PRINT_JSON from_n take_n peel_hit has_n load_hit miss_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS CAT "schema=cubalc.peer_contract_needp_from.v1 op=" op " hit="
LET row = LAST
SYS STR hit
SYS CAT row LAST " miss="
LET row = LAST
SYS STR miss
SYS CAT row LAST " admit="
LET row = LAST
SYS STR admit_n
SYS CAT row LAST " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "pcnf op=" op " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n from_n peel_hit has_n load_hit created note_msg
