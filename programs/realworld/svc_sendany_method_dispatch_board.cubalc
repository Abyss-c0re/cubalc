# svc_sendany_method_dispatch_board.cubalc — SENDANY/TRYSENDANY method priority
#
# Real use: fleet agents invoke the first existing method on a live worker
# (canary tick → update → bump) without N× HASMETHOD+SEND glue.
# First realworld of 1439 SENDANY / TRYSENDANY / SENDFIRST (1.15.895+).
# Distinct from svc_callany_hook_dispatch (FN plane CALLANY) and
# svc_send_dispatch (single SEND/TRYSEND).
#
#   SENDANY|SENDFIRST obj methods… [WITH args…] · SENDANY_METHOD · SENDANY_N
#   TRYSENDANY|SOFTSENDANY soft miss OK=0 · object or method miss
#   bag/CSV method lists · WITH multi-arg · 0-arity
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sad_$$
#   ./out/cubalc run programs/realworld/svc_sendany_method_dispatch_board.cubalc boot
#   ./out/cubalc run ... pass|soft|bag|args|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SAD_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_SAD_REQUIRE
#
# Edges: first method wins; soft obj/method miss; CSV/bag; WITH args;
#   capture LAST_N before EQS; CLEAR_ERR LAST; REQUIRE LIB quoted; WRITE NL

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

CLASS FleetWorker
  FIELD n 0
  FIELD tag "w"
  METHOD tick
    GETF THIS n
    LET v = LAST_N + 1
    SETF THIS n v
    RET v
  END
  METHOD update
    GETF THIS n
    LET v = LAST_N + 10
    SETF THIS n v
    RET v
  END
  METHOD bump d
    GETF THIS n
    LET v = LAST_N + d
    SETF THIS n v
    RET v
  END
  METHOD refresh
    SETF THIS n 5
    RET 5
  END
END

NOTE "svc_sendany_method_dispatch_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_sendany_method_dispatch -- boot|pass|soft|bag|args|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SAD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SAD_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET meth = ""
LET send_n = 0
LET ret_n = 0

ONEOF ACTION "boot", "pass", "soft", "bag", "args", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "bag" THEN
    LET op = "bag"
  WHEN "args" THEN
    LET op = "args"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-sad\",\"schema\":\"cubalc.svc_sendany_method_dispatch.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"sad\",\"want_filter\":\"sendany_method\",\"cfg\":{\"surface\":\"SENDANY,TRYSENDANY,SENDFIRST,SOFTSENDANY,SENDANY_METHOD,SENDANY_N\",\"contract\":\"first-existing method dispatch on live worker\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  NEW FleetWorker w0
  SETF w0 n 0
  CLEAR_ERR
  SENDANY w0 ghost_m tick update
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-sad"
  IF LAST_N == 1 THEN
    SYS EQS meth "tick"
    IF LAST_N == 1 THEN
      IF ret_n == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot ret"
        FAIL "boot ret"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot meth"
      FAIL "boot meth"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — first-hit tick, then update priority, SENDFIRST refresh
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker w1
  SETF w1 n 0
  CLEAR_ERR
  SENDANY w1 ghost_m tick update
  LET ok_v = OK
  LET meth = SENDANY_METHOD
  LET send_n = SENDANY_N
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF send_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS meth "tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  # only update exists as second priority after ghost
  NEW FleetWorker w2
  SETF w2 n 0
  CLEAR_ERR
  SENDANY w2 ghost_a ghost_b update tick
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "update"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 10 THEN
    LET score = score + 1
  END
  NEW FleetWorker w3
  SETF w3 n 0
  CLEAR_ERR
  SENDFIRST w3 ghost_x refresh tick
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "refresh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 5 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "sendany_method"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" meth ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score meth note_msg
  CLEAR_ERR
END

# soft — method miss + object miss + recover
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker s0
  SETF s0 n 0
  CLEAR_ERR
  TRYSENDANY s0 ghost_a ghost_b
  LET ok_v = OK
  LET send_n = SENDANY_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF send_n == 0 THEN
    LET score = score + 1
  END
  SOFTSENDANY s0 missing_m1 missing_m2
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSENDANY missing_obj tick update
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # recover
  TRYSENDANY s0 ghost_z tick
  LET ok_v = OK
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS meth "tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-sad"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# bag — newline + CSV method lists
SYS EQS op "bag"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker b0
  SETF b0 n 0
  CLEAR_ERR
  LET hooks = "nope
update
tick"
  SENDANY b0 hooks
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "update"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 10 THEN
    LET score = score + 1
  END
  NEW FleetWorker b1
  SETF b1 n 0
  CLEAR_ERR
  LET opts = "ghost,tick,update"
  SENDANY b1 opts
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  NEW FleetWorker b2
  SETF b2 n 0
  CLEAR_ERR
  LET opts = "ghost_x,ghost_y,refresh"
  SENDANY b2 opts
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "refresh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 5 THEN
    LET score = score + 1
  END
  LET hooks = "ghost_only
still_ghost"
  TRYSENDANY b0 hooks
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "sendany_method"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHOD FleetWorker tick
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "bag ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "bag score"
    FAIL "bag score"
    CLEAR_ERR
  END
  SYS CAT "bag:" meth ":bg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "bag:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score meth note_msg
  CLEAR_ERR
END

# args — WITH arity bump
SYS EQS op "args"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker a0
  SETF a0 n 0
  CLEAR_ERR
  SENDANY a0 ghost_add bump WITH 3
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "bump"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 3 THEN
    LET score = score + 1
  END
  SENDANY a0 bump WITH 4
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ret_n == 7 THEN
    LET score = score + 1
  END
  SENDANY a0 ghost_z tick
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 8 THEN
    LET score = score + 1
  END
  GETF a0 n
  IF LAST_N == 8 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW FleetWorker a1
  SETF a1 n 0
  CLEAR_ERR
  SENDFIRST a1 bump WITH 2
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ret_n == 2 THEN
    LET score = score + 1
  END
  SYS EQS SENDANY_METHOD "bump"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-sad"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "args ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "args score"
    FAIL "args score"
    CLEAR_ERR
  END
  SYS CAT "args:" meth ":ar"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "args:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score meth note_msg
  CLEAR_ERR
END

# form — HASFORM catalog
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "SENDANY"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "TRYSENDANY"
  LET send_n = LAST_N
  CLEAR_ERR
  HASFORM "SENDFIRST"
  LET ret_n = LAST_N
  CLEAR_ERR
  HASFORM "SOFTSENDANY"
  LET find_n = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF send_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF ret_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF find_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "SYS SENDANY"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM SENDANY
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODANY FleetWorker ghost_f tick
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "sendany_method"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "SENDANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — priority dispatch + soft recover + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker g0
  SETF g0 n 0
  CLEAR_ERR
  SENDANY g0 ghost_g tick update
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS EQS meth "tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  TRYSENDANY g0 ghost_only
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SENDANY g0 update
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ret_n == 11 THEN
    LET score = score + 1
  END
  SENDANY g0 bump WITH 2
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ret_n == 13 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-sad"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · CLEAR_ERR LAST · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker p0
  SETF p0 n 0
  CLEAR_ERR
  SENDANY p0 tick
  LET meth = SENDANY_METHOD
  LET ret_n = LAST_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS meth "tick"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "sendany_method"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "callany_hook"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSENDANY p0 ghost_probe
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score meth note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " meth=" meth " send_n=" send_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "sad report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
