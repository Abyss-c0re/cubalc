# match_purge_board.cubalc — purge matching config/deny lines by needle
#
# Real use: ops agent removes DEBUG/TODO/expired allowlist rows from a durable
# plate without FIND+DROPFILELINE loops:
#   DROPMATCHFILE     — drop first matching line (ack one)
#   DROPALLMATCHFILE  — purge all matching lines (file GREPV write-back)
#   COUNTFILELINE     — before/after residual tally
# Distinct from severity_file_gate (count/extract/set) and file_line_surgery
# (index surgery): this board is *needle-driven delete* first vs all.
#
# Plate under STATE:
#   ACTIVE.txt      — target path
#   DROPPED.txt     — last dropped line(s) text from DROP*MATCH
#   COUNT.txt       — residual count plate
#   PURGE_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_PU_ACTION):
#   list      — plate (default)
#   pick      — ACTIVE = ARG1
#   count     — COUNTFILELINE ACTIVE needle(ARG1)
#   counti    — COUNTFILELINEI
#   drop1     — DROPMATCHFILE ACTIVE needle
#   drop1i    — DROPMATCHFILEI
#   purge     — DROPALLMATCHFILE ACTIVE needle
#   purgei    — DROPALLMATCHFILEI
#   residual  — count after purge (same as count)
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_pu_$$
#   printf 'keep a\nDEBUG x\nkeep b\nDEBUG y\nTODO z\n' > $CUBALC_STATE/cfg.txt
#   CUBALC_ARG0=pick CUBALC_ARG1=$CUBALC_STATE/cfg.txt \
#     ./out/cubalc run -q -s programs/realworld/match_purge_board.cubalc
#   CUBALC_ARG0=drop1 CUBALC_ARG1=DEBUG ...
#   CUBALC_ARG0=purge CUBALC_ARG1=DEBUG ...
#
# Env: CUBALC_PU_PATH=… CUBALC_PU_REQUIRE=1
#
# Edges:
#   DROP first vs ALL; DROPALL returns multi-line LAST bag of removed
#   no-match N=0 I=-1 OK=1; path miss OK=0
#   empty needle; substring DEB/DEBUG; case I variants
#   DROPMATCH vs DROPFILELINE (index); REMOVELINE bag; PRINT_JSON; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "match_purge_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT AFILE = "ACTIVE.txt"
DEFAULT DFILE = "DROPPED.txt"
DEFAULT CFILE = "COUNT.txt"
DEFAULT REPORT = "PURGE_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_PU_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_PU_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_PU_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_PU_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_PU_PATH" OR ""
IF LAST_N > 0 THEN
  LET ENV_PATH = LAST
ELSE
  LET ENV_PATH = ""
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir AFILE
LET active_meta = LAST
SYS JOIN state_dir DFILE
LET dropped_path = LAST
SYS JOIN state_dir CFILE
LET count_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR active_meta OR ""
LET active = LAST
CLEAR_ERR
SYS READ OR dropped_path OR ""
LET dropped = LAST
CLEAR_ERR
SYS READ OR count_path OR ""
LET count_txt = LAST
CLEAR_ERR

SYS BLANK ENV_PATH
IF LAST_N == 0 THEN
  SYS EQS ACTION "pick"
  IF LAST_N == 1 THEN
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = ENV_PATH
    END
  END
END

LET hit = 0
LET miss = 0
LET active_ch = 0
LET drop_ch = 0
LET count_ch = 0
LET note_msg = "ok"
LET cnt = 0
LET total = 0
LET op_n = 0
LET op_i = -1
LET op_total = 0

SYS EQS ACTION "pick"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "pick needs path"
  END
END
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs needle"
  END
END
SYS EQS ACTION "counti"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "counti needs needle"
  END
END
SYS EQS ACTION "drop1"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop1 needs needle"
  END
END
SYS EQS ACTION "drop1i"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop1i needs needle"
  END
END
SYS EQS ACTION "purge"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "purge needs needle"
  END
END
SYS EQS ACTION "purgei"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "purgei needs needle"
  END
END
SYS EQS ACTION "residual"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "residual needs needle"
  END
END

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "mpurge" ACTION
  PRINT_JSON ACTION STATUS_OK
  PRINT_JSON active
  PRINT_JSON dropped
  PRINT_JSON count_txt
  LET note_msg = "list ok"
END

# --- pick ---
SYS EQS ACTION "pick"
IF LAST_N == 1 THEN
  NOTE "action pick"
  LET active = NAME
  LET active_ch = 1
  LET hit = 1
  LET note_msg = "pick ok"
  PRINT_JSON active
END

# --- count ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "count no active"
    FAIL "count no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "count no active"
    END
  ELSE
    SYS COUNTFILELINE active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "count path miss"
      FAIL "count path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "count path miss"
      END
    ELSE
      LET cnt = COUNTFILELINE_N
      LET total = COUNTFILELINE_TOTAL
      LET hit = cnt
      LET count_txt = "needle"
      SYS PUSH count_txt NAME
      LET count_txt = LAST
      SYS PUSH count_txt "count"
      LET count_txt = LAST
      SYS STR cnt
      SYS PUSH count_txt LAST
      LET count_txt = LAST
      SYS PUSH count_txt "total"
      LET count_txt = LAST
      SYS STR total
      SYS PUSH count_txt LAST
      LET count_txt = LAST
      LET count_ch = 1
      IF cnt == 0 THEN
        LET miss = 1
        LET note_msg = "count zero"
        FAIL "count zero"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "count zero"
        END
      ELSE
        LET note_msg = "count ok"
      END
    END
    PRINT_JSON NAME cnt total
    PRINT_JSON count_txt
    CLEAR_ERR
  END
END

# --- counti ---
SYS EQS ACTION "counti"
IF LAST_N == 1 THEN
  NOTE "action counti"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "counti no active"
    FAIL "counti no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "counti no active"
    END
  ELSE
    SYS COUNTFILELINEI active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "counti path miss"
      FAIL "counti path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "counti path miss"
      END
    ELSE
      LET cnt = COUNTFILELINE_N
      LET total = COUNTFILELINE_TOTAL
      LET hit = cnt
      LET count_txt = "needle"
      SYS PUSH count_txt NAME
      LET count_txt = LAST
      SYS PUSH count_txt "count"
      LET count_txt = LAST
      SYS STR cnt
      SYS PUSH count_txt LAST
      LET count_txt = LAST
      SYS PUSH count_txt "total"
      LET count_txt = LAST
      SYS STR total
      SYS PUSH count_txt LAST
      LET count_txt = LAST
      LET count_ch = 1
      IF cnt == 0 THEN
        LET miss = 1
        LET note_msg = "counti zero"
        FAIL "counti zero"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "counti zero"
        END
      ELSE
        LET note_msg = "counti ok"
      END
    END
    PRINT_JSON NAME cnt total
    CLEAR_ERR
  END
END

# --- drop1 DROPMATCHFILE ---
SYS EQS ACTION "drop1"
IF LAST_N == 1 THEN
  NOTE "action drop1"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "drop1 no active"
    FAIL "drop1 no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop1 no active"
    END
  ELSE
    SYS DROPMATCHFILE active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET dropped = ""
      LET drop_ch = 1
      LET note_msg = "drop1 path miss"
      FAIL "drop1 path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "drop1 path miss"
      END
    ELSE
      LET dropped = LAST
      LET op_n = DROPMATCHFILE_N
      LET op_i = DROPMATCHFILE_I
      LET op_total = DROPMATCHFILE_TOTAL
      LET drop_ch = 1
      LET hit = op_n
      IF op_n == 0 THEN
        LET miss = 1
        LET note_msg = "drop1 none"
        FAIL "drop1 none"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "drop1 none"
        END
      ELSE
        LET note_msg = "drop1 ok"
      END
    END
    PRINT_JSON NAME op_n op_i op_total
    PRINT_JSON dropped
    CLEAR_ERR
  END
END

# --- drop1i ---
SYS EQS ACTION "drop1i"
IF LAST_N == 1 THEN
  NOTE "action drop1i"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "drop1i no active"
    FAIL "drop1i no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop1i no active"
    END
  ELSE
    SYS DROPMATCHFILEI active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET dropped = ""
      LET drop_ch = 1
      LET note_msg = "drop1i path miss"
      FAIL "drop1i path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "drop1i path miss"
      END
    ELSE
      LET dropped = LAST
      LET op_n = DROPMATCHFILE_N
      LET op_i = DROPMATCHFILE_I
      LET op_total = DROPMATCHFILE_TOTAL
      LET drop_ch = 1
      LET hit = op_n
      IF op_n == 0 THEN
        LET miss = 1
        LET note_msg = "drop1i none"
        FAIL "drop1i none"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "drop1i none"
        END
      ELSE
        LET note_msg = "drop1i ok"
      END
    END
    PRINT_JSON NAME op_n op_i op_total
    PRINT_JSON dropped
    CLEAR_ERR
  END
END

# --- purge DROPALLMATCHFILE ---
SYS EQS ACTION "purge"
IF LAST_N == 1 THEN
  NOTE "action purge"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "purge no active"
    FAIL "purge no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "purge no active"
    END
  ELSE
    SYS DROPALLMATCHFILE active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET dropped = ""
      LET drop_ch = 1
      LET note_msg = "purge path miss"
      FAIL "purge path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "purge path miss"
      END
    ELSE
      LET dropped = LAST
      LET op_n = DROPALLMATCHFILE_N
      LET op_i = DROPALLMATCHFILE_I
      LET op_total = DROPALLMATCHFILE_TOTAL
      LET drop_ch = 1
      LET hit = op_n
      IF op_n == 0 THEN
        LET miss = 1
        LET note_msg = "purge none"
        FAIL "purge none"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "purge none"
        END
      ELSE
        LET note_msg = "purge ok"
      END
    END
    PRINT_JSON NAME op_n op_i op_total
    PRINT_JSON dropped
    CLEAR_ERR
  END
END

# --- purgei ---
SYS EQS ACTION "purgei"
IF LAST_N == 1 THEN
  NOTE "action purgei"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "purgei no active"
    FAIL "purgei no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "purgei no active"
    END
  ELSE
    SYS DROPALLMATCHFILEI active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET dropped = ""
      LET drop_ch = 1
      LET note_msg = "purgei path miss"
      FAIL "purgei path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "purgei path miss"
      END
    ELSE
      LET dropped = LAST
      LET op_n = DROPALLMATCHFILE_N
      LET op_i = DROPALLMATCHFILE_I
      LET op_total = DROPALLMATCHFILE_TOTAL
      LET drop_ch = 1
      LET hit = op_n
      IF op_n == 0 THEN
        LET miss = 1
        LET note_msg = "purgei none"
        FAIL "purgei none"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "purgei none"
        END
      ELSE
        LET note_msg = "purgei ok"
      END
    END
    PRINT_JSON NAME op_n op_i op_total
    PRINT_JSON dropped
    CLEAR_ERR
  END
END

# --- residual (count alias semantics for post-purge) ---
SYS EQS ACTION "residual"
IF LAST_N == 1 THEN
  NOTE "action residual"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "residual no active"
    FAIL "residual no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "residual no active"
    END
  ELSE
    SYS COUNTFILELINE active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "residual path miss"
      FAIL "residual path miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "residual path miss"
      END
    ELSE
      LET cnt = COUNTFILELINE_N
      LET total = COUNTFILELINE_TOTAL
      LET hit = 1
      LET count_txt = "needle"
      SYS PUSH count_txt NAME
      LET count_txt = LAST
      SYS PUSH count_txt "residual"
      LET count_txt = LAST
      SYS STR cnt
      SYS PUSH count_txt LAST
      LET count_txt = LAST
      SYS PUSH count_txt "total"
      LET count_txt = LAST
      SYS STR total
      SYS PUSH count_txt LAST
      LET count_txt = LAST
      LET count_ch = 1
      IF cnt > 0 THEN
        LET miss = 1
        LET note_msg = "residual left"
        FAIL "residual left"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "residual left"
        END
      ELSE
        LET note_msg = "residual clean"
      END
    END
    PRINT_JSON NAME cnt total
    PRINT_JSON count_txt
    CLEAR_ERR
  END
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET active = ""
  LET dropped = ""
  LET count_txt = ""
  LET active_ch = 1
  LET drop_ch = 1
  LET count_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "pick"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
SYS EQS ACTION "counti"
LET k = k + LAST_N
SYS EQS ACTION "drop1"
LET k = k + LAST_N
SYS EQS ACTION "drop1i"
LET k = k + LAST_N
SYS EQS ACTION "purge"
LET k = k + LAST_N
SYS EQS ACTION "purgei"
LET k = k + LAST_N
SYS EQS ACTION "residual"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF active_ch > 0 THEN
  SYS WRITE active_meta active
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "active write failed"
  END
  CLEAR_ERR
END
IF drop_ch > 0 THEN
  SYS WRITE dropped_path dropped
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "dropped write failed"
  END
  CLEAR_ERR
END
IF count_ch > 0 THEN
  SYS WRITE count_path count_txt
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "count write failed"
  END
  CLEAR_ERR
END

SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.match_purge_board.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "cnt"
LET report = LAST
SYS STR cnt
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "total"
LET report = LAST
SYS STR total
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "op_n"
LET report = LAST
SYS STR op_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "op_i"
LET report = LAST
SYS STR op_i
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "op_total"
LET report = LAST
SYS STR op_total
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "active"
LET report = LAST
SYS PUSH report active
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "match_purge_board" ACTION hit miss op_n cnt note_msg elapsed
