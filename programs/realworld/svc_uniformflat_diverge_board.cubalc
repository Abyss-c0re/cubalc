# svc_uniformflat_diverge_board.cubalc — UNIFORMFLAT nest consistency gate
#
# Real use: fleet agents one-shot equality check (roles uniform? peer ok?)
# without ALLEQ+UNEQ glue. Prefer LAST_N 0|1 under 128-var pressure —
# UNIFORM_PATH specials hard-fail when vars full (W408 class).
# First realworld of proof 1252 UNIFORMFLAT (MEANINGFUL 711).
#
#   UNIFORMFLAT|CHECKFLAT [FROM plate] needle
#   LAST_N=1 equal (LAST=value) · LAST_N=0 mixed/empty
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sufd_$$
#   ./out/cubalc run programs/realworld/svc_uniformflat_diverge_board.cubalc boot
#   ./out/cubalc run ... check|unify|peer|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SUFD_REPORT.txt agent.json peer.json uni.txt
# Env: HOST_S ROLE_S CUBALC_SUFD_REQUIRE
#
# Edges: mixed→0; SETBYVAL unify→1; FROM PEER; soft miss; CHECKFLAT;
#   WRITE NL; REQUIRE softens; specials avoided under var pressure

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_uniformflat_diverge_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_uniformflat_diverge -- boot|check|unify|peer|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeU"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SUFD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "uni.txt"
LET uni_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SUFD_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET uni_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "check", "unify", "peer", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "check" THEN
    LET op = "check"
  WHEN "unify" THEN
    LET op = "unify"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-uniformflat\",\"schema\":\"cubalc.svc_uniformflat_diverge.v1\",\"site\":\"" host_s "\",\"agent_job\":\"runner\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"worker\",\"host\":\"h1\"},\"other\":{\"host\":\"h2\",\"role\":\"leader\"},\"label\":\"uni\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_uniformflat_diverge.v1\",\"site\":\"" host_s "\",\"a\":{\"status\":\"ok\"},\"b\":{\"status\":\"ok\"},\"c\":{\"status\":\"ok\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-uniformflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:roles:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# check — mixed roles/hosts → LAST_N 0
SYS EQS op "check"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  SETP "cfg.host" "h1"
  CLEAR_ERR
  SETP "other.host" "h2"
  CLEAR_ERR
  UNIFORMFLAT "role"
  LET uni_n = LAST_N
  CLEAR_ERR
  IF uni_n == 0 THEN
    LET score = score + 1
  END
  UNIFORMFLAT "host"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  UNIFORMFLAT "agent_job"
  LET admit_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "runner"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "check ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "check score"
    FAIL "check score"
    CLEAR_ERR
  END
  SYS STR uni_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE uni_path body
  CLEAR_ERR
  SYS CAT "check:" body ":ck"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "check:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

# unify — SETBYVAL then uniform worker
SYS EQS op "unify"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  UNIFORMFLAT "role"
  LET uni_n = LAST_N
  CLEAR_ERR
  IF uni_n == 0 THEN
    LET score = score + 1
  END
  SETBYVAL "leader" "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  UNIFORMFLAT "role"
  LET uni_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF uni_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTBYVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 3 THEN
    LET score = score + 1
  END
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "unify ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "unify score"
    FAIL "unify score"
    CLEAR_ERR
  END
  SYS WRITE uni_path body
  CLEAR_ERR
  SYS CAT "unify:" body ":un"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "unify:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

# peer — all ok; inject fail → mixed
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP FROM PEER "a.status" "ok"
  CLEAR_ERR
  SETP FROM PEER "b.status" "ok"
  CLEAR_ERR
  SETP FROM PEER "c.status" "ok"
  CLEAR_ERR
  UNIFORMFLAT FROM PEER "status"
  LET uni_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF uni_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SETP FROM PEER "b.status" "fail"
  CLEAR_ERR
  UNIFORMFLAT FROM PEER "status"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP FROM PEER "b.status"
  SYS EQS LAST "fail"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-uniformflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SETP FROM PEER "b.status" "ok"
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS WRITE uni_path body
  CLEAR_ERR
  SYS CAT "peer:" body ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

# soft — ghost miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  UNIFORMFLAT "ghostpath"
  LET uni_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF uni_n == 0 THEN
    LET score = score + 1
  END
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-uniformflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNIFORMFLAT "label"
  LET admit_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

# gate — uniform roles + peer
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "worker"
  CLEAR_ERR
  UNIFORMFLAT "role"
  LET uni_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF uni_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNIFORMFLAT FROM PEER "status"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_uniformflat_diverge"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS WRITE uni_path body
  CLEAR_ERR
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

# alias — CHECKFLAT
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "worker"
  CLEAR_ERR
  CHECKFLAT "role"
  LET uni_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF uni_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  CHECKFLAT "role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-uniformflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" uni_n ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

# probe — multi diverge LAST_N 0 + ALLEQ label
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "w1.role" "worker"
  CLEAR_ERR
  SETP "w2.role" "leader"
  CLEAR_ERR
  SETP "w3.role" "leader"
  CLEAR_ERR
  UNIFORMFLAT "role"
  LET uni_n = LAST_N
  CLEAR_ERR
  IF uni_n == 0 THEN
    LET score = score + 1
  END
  # GETP diverge leaves still present
  GETP "w2.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "w3.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ALLEQFLAT "label"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "uniformflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "uni"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS STR uni_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE uni_path body
  CLEAR_ERR
  SYS CAT "probe:" body ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n uni_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_uniformflat_diverge.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " uni_n=" uni_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_uniformflat_diverge_board: end"
