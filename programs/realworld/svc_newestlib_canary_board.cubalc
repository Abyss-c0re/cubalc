# svc_newestlib_canary_board.cubalc — NEWESTLIB/OLDESTLIB mtime canary pick
#
# Real use: fleet agents pick newest/oldest lib stem by mtime for canary
# INCLUDE (hot patch vs baseline) without shelling ls -t programs/lib.
# First realworld of proof 1317 NEWESTLIB/OLDESTLIB/LATESTLIB.
#
#   NEWESTLIB|LATESTLIB needle [OR fallback] · OLDESTLIB needle
#   LAST = stem · LAST_N=1 · NEWESTLIB_N family · NEWESTLIB_MTIME · FALLBACK
#   soft miss OK=0 · capture stem before CLEAR_ERR before INCLUDE
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_snw_$$
#   ./out/cubalc run programs/realworld/svc_newestlib_canary_board.cubalc boot
#   ./out/cubalc run ... new|old|guard|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SNW_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SNW_REQUIRE
#
# Edges: fat_session newer than fat_boot; time_guard newest guard;
#   OR fallback; soft miss; CLEAR_ERR LAST=cleared; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_newestlib_canary_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_newestlib_canary -- boot|new|old|guard|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SNW_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SNW_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET mtime_n = 0
LET fb_n = 0

ONEOF ACTION "boot", "new", "old", "guard", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "new" THEN
    LET op = "new"
  WHEN "old" THEN
    LET op = "old"
  WHEN "guard" THEN
    LET op = "guard"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-newestlib\",\"schema\":\"cubalc.svc_newestlib_canary.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"fat\",\"label\":\"newestlib\",\"cfg\":{\"want_new\":\"fat_session\",\"want_old\":\"fat_boot\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"canary\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_newestlib_canary"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# new — NEWESTLIB fat → fat_session canary
SYS EQS op "new"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEWESTLIB fat
  LET stem_s = LAST
  LET sum_n = LAST_N
  LET find_n = NEWESTLIB_N
  LET mtime_n = NEWESTLIB_MTIME
  CLEAR_ERR
  SYS EQS stem_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF mtime_n > 0 THEN
    LET score = score + 1
  END
  GETP "cfg.want_new"
  SYS EQS LAST "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "new ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "new score"
    FAIL "new score"
    CLEAR_ERR
  END
  SYS CAT "new:" stem_s ":nw"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "new:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s find_n mtime_n score note_msg
  CLEAR_ERR
END

# old — OLDESTLIB fat → fat_boot baseline
SYS EQS op "old"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  OLDESTLIB fat
  LET stem_s = LAST
  LET sum_n = LAST_N
  LET find_n = OLDESTLIB_N
  CLEAR_ERR
  SYS EQS stem_s "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF find_n == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.want_old"
  SYS EQS LAST "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "old ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "old score"
    FAIL "old score"
    CLEAR_ERR
  END
  SYS CAT "old:" stem_s ":od"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "old:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s find_n score note_msg
  CLEAR_ERR
END

# guard — LATESTLIB guard → time_guard
SYS EQS op "guard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LATESTLIB guard
  LET stem_s = LAST
  LET find_n = NEWESTLIB_N
  CLEAR_ERR
  SYS EQS stem_s "time_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  # plate family has many — just hit
  NEWESTLIB plate
  LET sum_n = LAST_N
  LET admit_n = NEWESTLIB_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF admit_n >= 10 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "guard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "guard score"
    FAIL "guard score"
    CLEAR_ERR
  END
  SYS CAT "guard:" stem_s ":gd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "guard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s score note_msg
  CLEAR_ERR
END

# soft — ghost miss + OR fallback
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  OLDESTLIB no_such_lib_xyz
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  NEWESTLIB no_such_lib_xyz OR agent_boot
  LET stem_s = LAST
  LET fb_n = NEWESTLIB_FALLBACK
  CLEAR_ERR
  SYS EQS stem_s "agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF fb_n == 1 THEN
    LET score = score + 1
  END
  NEWESTLIB ghostpath_lib_999
  LET admit_n = OK
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s score note_msg
  CLEAR_ERR
END

# gate — family size + canary stem present
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEWESTLIB fat
  LET stem_s = LAST
  LET find_n = NEWESTLIB_N
  CLEAR_ERR
  IF find_n >= 2 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_newestlib_canary"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.want_new"
  SYS EQS LAST "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n stem_s score note_msg
  CLEAR_ERR
END

# alias — LATESTLIB + OLDESTLIB dual
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LATESTLIB fat
  LET stem_s = LAST
  CLEAR_ERR
  SYS EQS stem_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  OLDESTLIB fat
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # newest != oldest for multi-stem family
  SYS EQS stem_s body
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.want_old"
  SYS EQS LAST "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" stem_s ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n stem_s body score note_msg
  CLEAR_ERR
END

# probe — LAST_N dual + CLEAR_ERR + alpha false friend + INCLUDE stem
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEWESTLIB fat
  LET stem_s = LAST
  LET sum_n = LAST_N
  LET find_n = NEWESTLIB_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF sum_n != find_n THEN
    LET score = score + 1
  END
  # false friend: alpha first fat_boot is OLDEST not NEWEST
  SYS EQS stem_s "fat_boot"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS stem_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # CLEAR_ERR clobber
  NEWESTLIB fat
  LET body = LAST
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # INCLUDE via captured stem not LAST
  INCLUDE ONCE body
  CLEAR_ERR
  INCLUDESTEMS
  LET row = LAST
  CLEAR_ERR
  SYS HASLINE row "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-newestlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n stem_s score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_newestlib_canary.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " stem=" stem_s " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n find_n note_msg
NOTE "svc_newestlib_canary_board: end"
