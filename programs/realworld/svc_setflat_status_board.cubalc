# svc_setflat_status_board.cubalc — SETFLAT bulk leaf value rewrite by path needle
#
# Real use: fleet status/flag bulk set without multi SETP glue (degraded all
# status leaves, peer tls flip). First realworld of proof 1218 SETFLAT/MAPFLAT.
#
#   SETFLAT|MAPFLAT [FROM plate] needle value
#   LAST_N = SETFLAT_N rewritten · SETFLAT_TOTAL · SRC/FROM
#   empty needle sets ALL leaves (identity-clobber hazard)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ssf_$$
#   ./out/cubalc run programs/realworld/svc_setflat_status_board.cubalc boot
#   ./out/cubalc run ... flag|port|peer|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SSF_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SSF_REQUIRE
#
# Edges: multi status; exact cfg.port; FROM PEER; soft miss; MAPFLAT alias;
#   empty all-leaf hazard; substring stat; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_setflat_status_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_setflat_status -- boot|flag|port|peer|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeS"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SSF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SSF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "flag", "port", "peer", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "flag" THEN
    LET op = "flag"
  WHEN "port" THEN
    LET op = "port"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-setflat\",\"schema\":\"cubalc.svc_setflat_status.v1\",\"site\":\"" host_s "\",\"cfg\":{\"meta\":{\"role\":\"worker\",\"debug\":1},\"port\":8080,\"status\":\"ok\",\"debug\":1},\"other\":{\"status\":\"ok\"},\"label\":\"setflat\",\"n\":3}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"net\":{\"tls\":0,\"peer\":{\"tls\":0}},\"keep\":1,\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "cfg.status"
  SYS EQS LAST "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.debug"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# flag — SETFLAT status degraded (multi-leaf)
SYS EQS op "flag"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "cfg.status" "ok"
  CLEAR_ERR
  SETP "other.status" "ok"
  CLEAR_ERR
  SETFLAT "status" "degraded"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF SETFLAT_N == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.status"
  SYS EQS LAST "degraded"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.status"
  SYS EQS LAST "degraded"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "flag ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "flag score"
    FAIL "flag score"
    CLEAR_ERR
  END
  SYS CAT "flag:" find_n ":fl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "flag:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# port — exact path needle cfg.port
SYS EQS op "port"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "cfg.port" "8080"
  CLEAR_ERR
  SETFLAT "cfg.port" "9090"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.port"
  SYS EQS LAST "9090"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "port ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "port score"
    FAIL "port score"
    CLEAR_ERR
  END
  SYS CAT "port:" find_n ":pt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "port:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# peer — SETFLAT FROM PEER tls
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP FROM PEER "net.tls" "0"
  CLEAR_ERR
  SETP FROM PEER "net.peer.tls" "0"
  CLEAR_ERR
  SETFLAT FROM PEER "tls" "1"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF SETFLAT_FROM == 1 THEN
    LET score = score + 1
  END
  SYS EQS SETFLAT_SRC "PEER"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "net.tls"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "net.peer.tls"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "keep"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" find_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — ghost miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETFLAT "ghostpath" "x"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF SETFLAT_N == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SETFLAT "nope" "9"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — debug cleared to 0
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "cfg.meta.debug" "1"
  CLEAR_ERR
  SETP "cfg.debug" "1"
  CLEAR_ERR
  SETFLAT "debug" "0"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.meta.debug"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.debug"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_setflat_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — MAPFLAT
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET PLATE = "{\"meta\":{\"role\":\"x\",\"zone\":\"y\"},\"label\":\"mp\"}"
  MAPFLAT "meta" "none"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF MAPFLAT_N == 2 THEN
    LET score = score + 1
  END
  GETP "meta.role"
  SYS EQS LAST "none"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "meta.zone"
  SYS EQS LAST "none"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" find_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — empty needle hazard + substring
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # substring stat matches status
  SETP "cfg.status" "ok"
  CLEAR_ERR
  SETP "other.status" "ok"
  CLEAR_ERR
  SETFLAT "stat" "warm"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.status"
  SYS EQS LAST "warm"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty needle on scratch plate — all leaves (do NOT use on agent)
  LET PLATE = "{\"a\":1,\"b\":{\"c\":2}}"
  SETFLAT "" "0"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 2 THEN
    LET score = score + 1
  END
  GETP "a"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "b.c"
  SYS EQS LAST "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "setflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_setflat_status.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_setflat_status_board: end"
