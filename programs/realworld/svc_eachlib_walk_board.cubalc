# svc_eachlib_walk_board.cubalc — EACH LIB MATCH walk + HASCOUNTMATCHLIBS gate
#
# Real use: fleet agents walk sorted lib stems for inventory digests and
# min-count install gates without shelling `cubalc libs | grep`. First
# realworld of proofs 1315 EACH LIB + 1314 HASCOUNTMATCHLIBS/NEEDCOUNTMATCHLIBS.
#
#   EACH LIB [AS name] [MATCH needle] … END · LIB/STEM/LINE binds
#   EACHLIBS_N after walk · HASCOUNTMATCHLIBS min needle · soft empty walk
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sel_$$
#   ./out/cubalc run programs/realworld/svc_eachlib_walk_board.cubalc boot
#   ./out/cubalc run ... fat|plate|all|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SEL_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SEL_REQUIRE
#
# Edges: empty MATCH walk n=0; AS bind; STEM/LINE dual; min-count soft fail;
#   HASCOUNT vs COUNTMATCH polarity; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_eachlib_walk_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_eachlib_walk -- boot|fat|plate|all|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SEL_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SEL_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET first_s = ""
LET last_s = ""
LET walk_n = 0

ONEOF ACTION "boot", "fat", "plate", "all", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "fat" THEN
    LET op = "fat"
  WHEN "plate" THEN
    LET op = "plate"
  WHEN "all" THEN
    LET op = "all"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-eachlib\",\"schema\":\"cubalc.svc_eachlib_walk.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"plate\",\"min_count\":2,\"label\":\"eachlib\",\"cfg\":{\"fat_expect\":2}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"walk\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_eachlib_walk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# fat — EACH LIB MATCH fat
SYS EQS op "fat"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET walk_n = 0
  LET first_s = ""
  LET last_s = ""
  EACH LIB MATCH fat
    LET walk_n = walk_n + 1
    IF walk_n == 1 THEN
      LET first_s = LIB
    END
    LET last_s = LIB
  END
  LET sum_n = walk_n
  LET find_n = EACHLIBS_N
  CLEAR_ERR
  IF walk_n == 2 THEN
    LET score = score + 1
  END
  IF find_n == 2 THEN
    LET score = score + 1
  END
  SYS EQS first_s "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS last_s "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.fat_expect"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "fat ok"
    LET admit_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "fat score"
    FAIL "fat score"
    CLEAR_ERR
  END
  SYS CAT "fat:" walk_n ":ft"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fat:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n first_s last_s score note_msg
  CLEAR_ERR
END

# plate — first/last alpha via STEM/LINE
SYS EQS op "plate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET walk_n = 0
  LET first_s = ""
  LET last_s = ""
  EACH LIB MATCH plate
    LET walk_n = walk_n + 1
    IF walk_n == 1 THEN
      LET first_s = STEM
    END
    LET last_s = LINE
  END
  LET sum_n = walk_n
  CLEAR_ERR
  IF walk_n >= 10 THEN
    LET score = score + 1
  END
  SYS EQS first_s "plate_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS last_s "plate_uniform"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF EACHLIBS_N == walk_n THEN
    LET score = score + 1
  END
  GETP "want_filter"
  SYS EQS LAST "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "plate ok"
    LET admit_n = walk_n
    LET find_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "plate score"
    FAIL "plate score"
    CLEAR_ERR
  END
  SYS CAT "plate:" walk_n ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "plate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n first_s last_s score note_msg
  CLEAR_ERR
END

# all — EACH LIB full inventory
SYS EQS op "all"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET walk_n = 0
  EACH LIB
    LET walk_n = walk_n + 1
  END
  LET sum_n = walk_n
  LET find_n = EACHLIBS_N
  CLEAR_ERR
  IF walk_n >= 15 THEN
    LET score = score + 1
  END
  IF find_n == walk_n THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_eachlib_walk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "all ok"
    LET admit_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "all score"
    FAIL "all score"
    CLEAR_ERR
  END
  SYS CAT "all:" walk_n ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "all:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n score note_msg
  CLEAR_ERR
END

# soft — empty walk + min-count soft fail
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET walk_n = 0
  EACH LIB MATCH no_such_lib_xyz_zzz
    LET walk_n = walk_n + 1
  END
  CLEAR_ERR
  IF walk_n == 0 THEN
    LET score = score + 1
  END
  IF EACHLIBS_N == 0 THEN
    LET score = score + 1
  END
  HASCOUNTMATCHLIBS 1 no_such_lib_xyz_zzz
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  # need 50 plate libs soft fail
  HASCOUNTMATCHLIBS 50 plate
  LET admit_n = OK
  LET find_n = HASCOUNTMATCHLIBS_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  IF find_n >= 10 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n find_n score note_msg
  CLEAR_ERR
END

# gate — HASCOUNTMATCHLIBS min_count on fat
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASCOUNTMATCHLIBS 2 fat
  LET sum_v = OK
  LET sum_n = LAST_N
  LET find_n = HASCOUNTMATCHLIBS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF find_n == 2 THEN
    LET score = score + 1
  END
  NEEDCOUNTMATCHLIBS 2 fat
  LET admit_n = OK
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "min_count"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_eachlib_walk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — EACH LIB AS x MATCH guard
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET walk_n = 0
  LET sum_v = 0
  LET find_n = 0
  EACH LIB AS x MATCH guard
    LET walk_n = walk_n + 1
    SYS EQS x "time_guard"
    IF LAST_N == 1 THEN
      LET sum_v = 1
    END
    SYS EQS x "var_guard"
    IF LAST_N == 1 THEN
      LET find_n = 1
    END
  END
  CLEAR_ERR
  IF walk_n == 2 THEN
    LET score = score + 1
  END
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF find_n == 1 THEN
    LET score = score + 1
  END
  HASCOUNTMATCHLIBS 1 guard
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" walk_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n score note_msg
  CLEAR_ERR
END

# probe — HASCOUNT LAST_N boolean vs count · empty walk · false friend
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASCOUNTMATCHLIBS 1 plate
  LET sum_n = LAST_N
  LET find_n = HASCOUNTMATCHLIBS_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF find_n >= 10 THEN
    LET score = score + 1
  END
  IF sum_n != find_n THEN
    LET score = score + 1
  END
  COUNTMATCHLIBS plate
  LET walk_n = LAST_N
  CLEAR_ERR
  IF walk_n == find_n THEN
    LET score = score + 1
  END
  # default min=1 when only needle
  HASCOUNTMATCHLIBS agent
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  # false friend: plate_tick not first in walk
  LET first_s = ""
  LET walk_n = 0
  EACH LIB MATCH plate
    LET walk_n = walk_n + 1
    IF walk_n == 1 THEN
      LET first_s = LIB
    END
  END
  CLEAR_ERR
  SYS EQS first_s "plate_tick"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS first_s "plate_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-eachlib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n first_s score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_eachlib_walk.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " walk=" walk_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n walk_n note_msg
NOTE "svc_eachlib_walk_board: end"
