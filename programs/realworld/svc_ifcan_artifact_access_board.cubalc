# svc_ifcan_artifact_access_board.cubalc — IFCANREAD/IFCANWRITE/IFCANEXEC access
#
# Real use: deploy agents write artifacts only when the stage dir is
# writable, and load only when the plate is readable — no SYS
# CANREAD+IF glue. First realworld of 1490 IFCANREAD/IFCANWRITE/
# IFCANEXEC (1.15.950 · MI 951). Distinct from svc_iffile_artifact_gate
# (existence) — this board is *access-mode branches for admit*.
#
#   IFCANREAD · IFCANWRITE · IFCANEXEC · IFCANREAD_N · stickies
#   FN-wrap · miss path soft · var path · write-if-can
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ica_$$
#   ./out/cubalc run programs/realworld/svc_ifcan_artifact_access_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt ICA_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_ICA_REQUIRE
#
# Edges: miss not readable/writable; dir typically executable;
#   FN-wrap; STATUS bare; STRTO VAL; avoid tries (W883)

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN can_read
  IFCANREAD pth
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN can_write
  IFCANWRITE pth
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN can_exec
  IFCANEXEC pth
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# write artifact only if parent dir writable
FN write_if_can
  LET state = "deny-nowrite"
  LET ok_v = 0
  LET pth = stage_dir
  CALL can_write
  IF ok_v == 1 THEN
    SYS WRITE art_path body
    CLEAR_ERR
    LET state = "wrote"
    LET ok_v = 1
  END
END

# admit load only if artifact readable
FN admit_load
  LET state = "deny-noread"
  LET ok_v = 0
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
END

NOTE "svc_ifcan_artifact_access_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ifcan_artifact_access -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_ICA_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "ICA_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "stage"
LET stage_dir = LAST
SYS JOIN stage_dir "artifact.json"
LET art_path = LAST
SYS JOIN stage_dir "ghost.json"
LET ghost_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET pth = ""
LET state = ""
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ica\",\"schema\":\"cubalc.svc_ifcan_artifact_access.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ica\",\"want_filter\":\"ifcan_artifact_access\",\"cfg\":{\"surface\":\"IFCANREAD,IFCANWRITE,IFCANEXEC,IFCANREAD_N\",\"contract\":\"path access branches for artifact admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR stage_dir
  CLEAR_ERR
  SYS WRITE art_path "{\"rev\":1,\"ok\":true}"
  CLEAR_ERR
  LET pth = art_path
  CALL can_read
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ica"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFCANREAD_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = IFCANREAD_N
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot read"
      FAIL "boot read"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core access 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR stage_dir
  CLEAR_ERR
  SYS WRITE art_path "{\"rev\":1}"
  CLEAR_ERR
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFCANREAD_N == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFCANWRITE_N == 1 THEN
    LET score = score + 1
  END
  LET pth = stage_dir
  CALL can_exec
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFCANEXEC_N == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # miss soft
  LET pth = ghost_path
  CALL can_read
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — miss · write-if-can · admit
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR stage_dir
  CLEAR_ERR
  LET pth = "/no/such/cubalc_ica_zz"
  CALL can_read
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL can_exec
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF IFCANREAD_N == 0 THEN
    LET score = score + 1
  END
  LET body = "{\"soft\":1}"
  CALL write_if_can
  SYS EQS state "wrote"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_load
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET art_path = ghost_path
  CALL admit_load
  SYS EQS state "deny-noread"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore art_path
  SYS JOIN stage_dir "artifact.json"
  LET art_path = LAST
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET pth = stage_dir
  CALL can_exec
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi path class
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR stage_dir
  CLEAR_ERR
  SYS WRITE art_path "{\"peel\":1}"
  CLEAR_ERR
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET pth = stage_dir
  CALL can_exec
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET body = "{\"peel\":2}"
  CALL write_if_can
  SYS EQS state "wrote"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_load
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET pth = ghost_path
  CALL can_read
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifcan_artifact_access"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — write/load ladder
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR stage_dir
  CLEAR_ERR
  LET body = "{\"n\":1}"
  CALL write_if_can
  SYS EQS state "wrote"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_load
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET body = "{\"n\":2}"
  CALL write_if_can
  SYS EQS state "wrote"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET pth = stage_dir
  CALL can_exec
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET pth = ghost_path
  CALL can_read
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET art_path = ghost_path
  CALL admit_load
  SYS EQS state "deny-noread"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JOIN stage_dir "artifact.json"
  LET art_path = LAST
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFCANREAD"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFCANREAD"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFCANWRITE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFCANEXEC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "WHENCANREAD"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENCANWRITE"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFCANREAD_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFCANWRITE_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifcan_artifact_access"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFCANREAD"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFCANWRITE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — write then admit; miss deny
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR stage_dir
  CLEAR_ERR
  LET body = "{\"gate\":1}"
  CALL write_if_can
  SYS EQS state "wrote"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_load
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET pth = art_path
  CALL can_read
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET pth = stage_dir
  CALL can_exec
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET art_path = ghost_path
  CALL admit_load
  SYS EQS state "deny-noread"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET pth = ghost_path
  CALL can_read
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL can_write
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS JOIN stage_dir "artifact.json"
  LET art_path = LAST
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "artifact admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — WRITE NL · NUM · stickies
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR stage_dir
  CLEAR_ERR
  LET body = "{\"probe\":1}"
  CALL write_if_can
  SYS EQS state "wrote"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_load
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET pth = art_path
  CALL can_read
  LET saved = IFCANREAD_N
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "ifcanread=" IFCANREAD_N " write=" IFCANWRITE_N
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifcanread="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "ica_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "ica_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ica"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ica\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_ifcan_artifact_access_board: done"
PASS
