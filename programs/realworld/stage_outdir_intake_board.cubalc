# stage_outdir_intake_board.cubalc — GETFLAGDIR + RESTPATHS staging intake
#
# Real use: release/intake agents mkdir an --out staging dir and register
# absolute input paths without shell realpath + mkdir -p glue:
#   GETFLAGDIR / MKFLAGDIR out|o OR ENV OUTDIR — abs + mkdir -p (1011)
#   RESTPATHS / POSPATHS — positionals → abs path bag + EXIST_N (1012)
#   SUBCMD peels verb; RESTPATHS still counts verb as path (peel DROPNTH 0)
#   GREPV plate rows for staged basenames
#
# First realworld GETFLAGDIR + RESTPATHS board (after 1011-1012).
# Distinct from chunk_path_pages (single GETFLAGPATH+DIVCEILN) and path_root:
# this board is *out dir create + multi abs input inventory*.
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_soi_$$
#   export OUTDIR=/tmp/stage_$$
#   ./out/cubalc run programs/realworld/stage_outdir_intake_board.cubalc \
#     stage -- --out=/tmp/stage_$$ Makefile include/cubalc_law.h
#   ./out/cubalc run ... list
#
# Plate: STAGE.txt VAL.txt META.txt SOI_REPORT.txt
# Subcmds: list|ls stage drop has gate soft clear probe
# Env: OUTDIR CUBALC_SOI_REQUIRE CUBALC_SOI_MIN
#
# Edges:
#   GETFLAGDIR creates missing; CREATED 0|1; CLI>ENV>default
#   RESTPATHS includes SUBCMD token as abs path — DROPNTH 0 when basename=ACTION
#   RESTPATHS_EXIST_N not updated after manual peel
#   Missing inputs still abs; soft exist count
#   W47 lean LET; no EACH if possible; GREPV drop
#   WRITE NL; known latch

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "stage_outdir_intake_board: start"
DEFAULT ACTION = "list"
DEFAULT TFILE = "STAGE.txt"
DEFAULT VFILE = "VAL.txt"
DEFAULT MFILE = "META.txt"
DEFAULT REPORT = "SOI_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT MIN = 1
DEFAULT USAGE_LINE = "stage_outdir_intake -- stage|list|drop -- [--out=DIR] file [file...]"
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
LET sub_hit = SUBCMD_HIT
CLEAR_ERR

# out dir: peel + mkdir -p
SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "stage_out"
LET def_out = LAST
CLEAR_ERR
GETFLAGDIR out|o OR ENV OUTDIR OR def_out
LET outdir = LAST
LET o_src = GETFLAGDIR_SRC
LET o_created = GETFLAGDIR_CREATED
LET o_ok = OK
CLEAR_ERR

# abs path bag from positionals (includes subcmd — peel below)
RESTPATHS
LET paths = LAST
LET path_n = LAST_N
LET exist_n = RESTPATHS_EXIST_N
CLEAR_ERR

# drop verb path when SUBCMD hit and first basename matches ACTION
IF sub_hit == 1 THEN
  SYS NTH 0 paths
  IF LAST_N > 0 THEN
    SYS BASENAME LAST
    SYS EQS LAST ACTION
    IF LAST_N == 1 THEN
      SYS DROPNTH paths 0
      LET paths = LAST
      CLEAR_ERR
      SYS LINES paths
      LET path_n = LAST_N
    END
  END
END
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

SYS ENV "CUBALC_SOI_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_SOI_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN = LAST_N
  END
END

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir TFILE
LET stage_path = LAST
SYS JOIN state_dir VFILE
LET val_path = LAST
SYS JOIN state_dir MFILE
LET meta_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR stage_path OR ""
LET bag = LAST
CLEAR_ERR

LET row = ""
LET pref = ""
LET hit = 0
LET miss = 0
LET val_ch = 0
LET meta_ch = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET val = ""
LET meta = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "stage", "list", "ls", "drop", "has", "gate", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "stage" THEN
    LET op = "stage"
  WHEN "drop" THEN
    LET op = "drop"
  WHEN "has" THEN
    LET op = "has"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "bag_n"
  SYS STR bag_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON bag_n path_n exist_n o_src o_created
  CLEAR_ERR
END

SYS EQS op "stage"
IF LAST_N == 1 THEN
  LET known = 1
  IF path_n < 1 THEN
    LET miss = 1
    LET note_msg = "stage needs files"
    FAIL "stage needs files"
    CLEAR_ERR
    LET val = USAGE
    LET val_ch = 1
    IF REQUIRE_HIT > 0 THEN
      REQUIRE RESTPOS 1
    END
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stage needs files"
    END
  ELSE
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "stage needs outdir"
      FAIL "stage needs outdir"
      CLEAR_ERR
    ELSE
      # inventory up to 2 paths (basename:abs:staged); no EACH (W47)
      SYS NTH 0 paths
      LET pref = LAST
      SYS BASENAME pref
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS CAT row pref
      LET row = LAST
      SYS CAT row ":staged"
      LET row = LAST
      SYS BASENAME pref
      SYS CAT LAST ":"
      SYS GREPV LAST bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET admit_n = 1
      IF path_n > 1 THEN
        SYS NTH 1 paths
        LET pref = LAST
        SYS BASENAME pref
        LET row = LAST
        SYS CAT row ":"
        LET row = LAST
        SYS CAT row pref
        LET row = LAST
        SYS CAT row ":staged"
        LET row = LAST
        SYS BASENAME pref
        SYS CAT LAST ":"
        SYS GREPV LAST bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET admit_n = 2
      END
      LET bag_ch = 1
      SYS LINES bag
      LET bag_n = LAST_N
      LET hit = 1
      LET note_msg = "stage ok"
      LET val = bag
      LET val_ch = 1
      LET meta = "outdir"
      SYS PUSH meta outdir
      LET meta = LAST
      SYS PUSH meta "paths"
      LET meta = LAST
      SYS STR path_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON admit_n bag_n path_n exist_n o_src o_created
  CLEAR_ERR
END

SYS EQS op "drop"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "drop needs name"
    FAIL "drop needs name"
    CLEAR_ERR
  ELSE
    SYS NTH 0 targets
    LET pref = LAST
    SYS CAT pref ":"
    SYS GREPV LAST bag
    LET bag = LAST
    CLEAR_ERR
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "drop ok"
    LET val = bag
    LET val_ch = 1
    LET meta = "drop"
    LET meta_ch = 1
  END
  PRINT_JSON admit_n bag_n
  CLEAR_ERR
END

SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  SYS NTH 0 targets
  LET pref = LAST
  SYS BLANK pref
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "has needs name"
    FAIL "has needs name"
    CLEAR_ERR
  ELSE
    SYS CAT pref ":"
    SYS GREP LAST bag
    SYS LINES LAST
    LET has_n = LAST_N
    IF has_n > 1 THEN
      LET has_n = 1
    END
    CLEAR_ERR
    LET val = pref
    LET val_ch = 1
    LET meta = "has"
    SYS STR has_n
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "has ok"
    ELSE
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
    END
  END
  PRINT_JSON has_n
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  SYS STR bag_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "gate"
  LET meta_ch = 1
  IF bag_n >= MIN THEN
    LET hit = 1
    LET note_msg = "gate admit"
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    FAIL "gate deny"
    CLEAR_ERR
  END
  PRINT_JSON bag_n MIN hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    LET val = ""
    LET val_ch = 1
    LET meta = "soft"
    LET meta_ch = 1
  ELSE
    LET hit = 1
    LET note_msg = "soft has stage"
    LET val = bag
    LET val_ch = 1
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  # RESTPATHS empty + GETFLAGDIR empty soft edges
  LET hit = 1
  LET note_msg = "probe ok"
  SYS STR path_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "exist_n"
  SYS STR exist_n
  SYS PUSH meta LAST
  LET meta = LAST
  SYS PUSH meta "o_src"
  LET meta = LAST
  SYS PUSH meta o_src
  LET meta = LAST
  SYS PUSH meta "created"
  LET meta = LAST
  SYS STR o_created
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON path_n exist_n o_src o_created o_ok
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET val = ""
  LET meta = ""
  LET bag_ch = 1
  LET val_ch = 1
  LET meta_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE stage_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "stage write failed"
  END
  CLEAR_ERR
END
IF val_ch > 0 THEN
  SYS WRITE val_path val
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "val write failed"
  END
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "meta write failed"
  END
  CLEAR_ERR
END

LET meta = "schema=cubalc.stage_outdir_intake_board.v1"
SYS PUSH meta "date"
LET meta = LAST
SYS PUSH meta run_date
LET meta = LAST
SYS PUSH meta "action"
LET meta = LAST
SYS PUSH meta ACTION
LET meta = LAST
SYS PUSH meta "op"
LET meta = LAST
SYS PUSH meta op
LET meta = LAST
SYS PUSH meta "hit"
LET meta = LAST
SYS STR hit
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "miss"
LET meta = LAST
SYS STR miss
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "outdir"
LET meta = LAST
SYS PUSH meta outdir
LET meta = LAST
SYS PUSH meta "o_src"
LET meta = LAST
SYS PUSH meta o_src
LET meta = LAST
SYS PUSH meta "o_created"
LET meta = LAST
SYS STR o_created
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "path_n"
LET meta = LAST
SYS STR path_n
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "exist_n"
LET meta = LAST
SYS STR exist_n
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "bag_n"
LET meta = LAST
SYS STR bag_n
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "note"
LET meta = LAST
SYS PUSH meta note_msg
LET meta = LAST

SYS WRITE report_path meta
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END

NOTE "stage_outdir_intake_board: done"
PRINT_JSON hit miss bag_n path_n exist_n o_src o_created note_msg
EXIT 0
