# mesh_renamep_promote_board.cubalc — RENAMEP/MOVEKEYP mesh staging-field promote
#
# Real use: intake agents stage values under tmp_* keys, then promote to
# canonical names (tmp→status, tmp_host→host) with write-back — no
# GETP+DELP+SETP glue. Soft miss on missing staging keys. COPYP snapshots
# prev before overwrite. First realworld of proof 1152 RENAMEP (+ light COPYP).
#
#   RENAMEP "tmp" "status"              # promote on PLATE
#   RENAMEP FROM PEER "tmp_host" "host"
#   COPYP "status" "prev"               # dual-buffer snapshot
#   MOVEKEYP alias · soft miss RENAMEP_N 0
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_mrp_$$
#   ./out/cubalc run programs/realworld/mesh_renamep_promote_board.cubalc boot
#   ./out/cubalc run ... promote|peer|softmiss|snap|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt MRP_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_MRP_REQUIRE
#
# Edges:
#   soft miss no new key; source key gone after rename; peer independent;
#   WRITE omit NL; LAST_N not RENAMEP_N knobs; empty bag soft; NUM shuttle

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "mesh_renamep_promote_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "mesh_renamep_promote -- boot|promote|peer|softmiss|snap|gate|probe|soft|list -- [--host=H]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_MRP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "MRP_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "promote", "peer", "softmiss", "snap", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "promote" THEN
    LET op = "promote"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "softmiss" THEN
    LET op = "softmiss"
  WHEN "snap" THEN
    LET op = "snap"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — staging keys tmp / tmp_host on dual plates
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "agent" "rename-ctl" "n" 1 "role" role_s "tmp" "ready" "schema" "cubalc.mesh_renamep.v1"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS JSONOBJ "agent" "hive-peer" "n" 2 "tmp_host" host_s "role" role_s "schema" "cubalc.mesh_renamep.v1"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETP "tmp"
  SYS EQS LAST "ready"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "tmp_host"
  SYS EQS LAST host_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  HASP "status"
  LET load_hit = LAST_N
  CLEAR_ERR
  # load_hit should be 0 — status not yet promoted
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 0 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET created = 1
        LET take_n = 1
        SYS CAT "boot:" host_s ":bt"
        LET row = LAST
        CLEAR_ERR
        SYS GREPV "boot:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot has status early"
        FAIL "boot has status early"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot peer tmp_host"
      FAIL "boot peer tmp_host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot tmp"
    FAIL "boot tmp"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# promote — RENAMEP tmp → status + both_save
SYS EQS op "promote"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEP "tmp" "status"
  LET take_n = LAST_N
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETP "status"
  SYS EQS LAST "ready"
  LET has_n = LAST_N
  CLEAR_ERR
  HASP "tmp"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "ready"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS JSON "tmp" FROM body
  SYS EMPTY LAST
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 0 THEN
      IF load_hit == 1 THEN
        IF miss_n == 1 THEN
          LET hit = 1
          LET note_msg = "promote ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "promote disk tmp"
          FAIL "promote disk tmp"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "promote disk status"
        FAIL "promote disk status"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "promote tmp remains"
      FAIL "promote tmp remains"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "promote status"
    FAIL "promote status"
    CLEAR_ERR
  END
  SYS CAT "promote:ready:pm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "promote:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit miss_n note_msg
  CLEAR_ERR
END

# peer — RENAMEP FROM PEER tmp_host → host
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEP FROM PEER "tmp_host" "host"
  LET take_n = LAST_N
  CLEAR_ERR
  INCLUDE plate_peer_save
  CLEAR_ERR
  GETP FROM PEER "host"
  SYS EQS LAST host_s
  LET has_n = LAST_N
  CLEAR_ERR
  HASP FROM PEER "tmp_host"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS READ peer_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "host" FROM body
  SYS EQS LAST host_s
  LET load_hit = LAST_N
  CLEAR_ERR
  # PLATE status (if promoted) untouched by peer rename
  GETP "role"
  SYS EQS LAST role_s
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 0 THEN
      IF load_hit == 1 THEN
        IF miss_n == 1 THEN
          LET hit = 1
          LET note_msg = "peer ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "peer plate role"
          FAIL "peer plate role"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer disk host"
        FAIL "peer disk host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer tmp_host remains"
      FAIL "peer tmp_host remains"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer host"
    FAIL "peer host"
    CLEAR_ERR
  END
  SYS CAT "peer:" host_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# softmiss — RENAMEP missing key → no new key, soft ok
SYS EQS op "softmiss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEP "nope_staging" "phantom"
  LET take_n = LAST_N
  CLEAR_ERR
  HASP "phantom"
  LET peel_hit = LAST_N
  CLEAR_ERR
  HASP "nope_staging"
  LET has_n = LAST_N
  CLEAR_ERR
  # soft miss: no phantom, no staging; LAST_N after RENAMEP often 0
  IF peel_hit == 0 THEN
    IF has_n == 0 THEN
      LET hit = 1
      LET note_msg = "softmiss ok"
      LET admit_n = 0
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "softmiss staging appeared"
      FAIL "softmiss staging appeared"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "softmiss phantom"
    FAIL "softmiss phantom"
    CLEAR_ERR
  END
  SYS CAT "softmiss:none:sm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "softmiss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit has_n note_msg
  CLEAR_ERR
END

# snap — COPYP status → prev (after promote) then SETP status live
SYS EQS op "snap"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # ensure status exists (re-promote if boot-only)
  HASP "status"
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    HASP "tmp"
    LET peel_hit = LAST_N
    CLEAR_ERR
    IF peel_hit == 1 THEN
      RENAMEP "tmp" "status"
      CLEAR_ERR
    ELSE
      SETP "status" "ready"
      CLEAR_ERR
    END
  END
  COPYP "status" "prev"
  LET take_n = LAST_N
  CLEAR_ERR
  SETP "status" "live"
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETP "prev"
  SYS EQS LAST "ready"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "status"
  SYS EQS LAST "live"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "prev" FROM body
  SYS EQS LAST "ready"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "snap ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "snap disk prev"
        FAIL "snap disk prev"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "snap status live"
      FAIL "snap status live"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "snap prev"
    FAIL "snap prev"
    CLEAR_ERR
  END
  SYS CAT "snap:prev:ready:sp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "snap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# gate — disk: status live, no tmp; peer host present no tmp_host
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "live"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "tmp" FROM body
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "prev" FROM body
  SYS EQS LAST "ready"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS READ peer_path
  LET out = LAST
  CLEAR_ERR
  SYS JSON "host" FROM out
  SYS EQS LAST host_s
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JSON "tmp_host" FROM out
  SYS EMPTY LAST
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF miss_n == 1 THEN
            LET hit = 1
            LET note_msg = "gate ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "gate peer tmp_host"
            FAIL "gate peer tmp_host"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate peer host"
          FAIL "gate peer host"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate prev"
        FAIL "gate prev"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate tmp remains"
      FAIL "gate tmp remains"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate status"
    FAIL "gate status"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate status"
    END
  END
  SYS CAT "gate:" host_s ":ga"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit take_n miss_n note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — MOVEKEYP alias, same-name no-op, lit form
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # same-name present no-op hit
  HASP "status"
  LET has_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    RENAMEP "status" "status"
    LET take_n = LAST_N
    CLEAR_ERR
    GETP "status"
    LET w_s = LAST
    CLEAR_ERR
    SYS EMPTY w_s
    LET peel_hit = LAST_N
    CLEAR_ERR
    # peel_hit 0 means status non-empty
    IF peel_hit == 0 THEN
      LET peel_hit = 1
    ELSE
      LET peel_hit = 0
    END
  ELSE
    LET take_n = 0
    LET peel_hit = 0
  END
  # COPYP dual-buffer on PLATE (MOVEKEYP FROM arbitrary var fails in large boards)
  COPYP "n" "n0"
  CLEAR_ERR
  GETP "n0"
  SYS NUM
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "n"
  SYS NUM
  LET miss_n = LAST_N
  CLEAR_ERR
  # soft miss already proven in softmiss action
  IF load_hit == miss_n THEN
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "probe ok"
      LET admit_n = 1
      LET has_n = 1
    ELSE
      LET miss = 1
      LET note_msg = "probe status empty"
      FAIL "probe status empty"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe copyp n0"
    FAIL "probe copyp n0"
    CLEAR_ERR
  END
  PRINT_JSON has_n peel_hit load_hit miss_n take_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
SYS STR admit_n
LET out = LAST
CLEAR_ERR
SYS CAT "schema=cubalc.mesh_renamep.v1 op=" op " hit=" w_s " miss=" d_s " admit=" out " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "mrp op=" op " hit=" w_s " miss=" d_s " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n peel_hit has_n load_hit miss_n created note_msg
