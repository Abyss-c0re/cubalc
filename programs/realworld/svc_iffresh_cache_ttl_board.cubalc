# svc_iffresh_cache_ttl_board.cubalc — IFFRESH/IFSTALE cache TTL gates
#
# Real use: cache/lease agents branch on path age (fresh within TTL vs
# stale beyond min) and rebuild on miss/stale without mtime glue.
# First realworld of 1482 IFFRESH/IFSTALE (1.15.937+ · MI ~938).
# Distinct from cache_ttl_gc_board (GC loops) and cache_freshness —
# this board is *content-branch path age for cache admit/rebuild*.
#
#   IFFRESH · IFSTALE · IFFRESH_AGE · IFFRESH_LIMIT · IFSTALE_N
#   nest rebuild · var path · FN-wrap (W853)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ifc_$$
#   ./out/cubalc run programs/realworld/svc_iffresh_cache_ttl_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IFC_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_IFC_REQUIRE
#
# Edges: missing → not fresh + stale; fresh age~0; IFSTALE huge min
#   keeps fresh; rebuild on stale; IFBIG unlinked (W868); FN-wrap

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN is_fresh
  IFFRESH p limit
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_stale
  IFSTALE p limit
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN rebuild_if_stale
  IFSTALE p limit
    SYS WRITE p body
    LET state = "rebuilt"
  ELSE
    LET state = "keep"
  END
END

FN admit_cache
  IFFRESH p limit
    LET state = "admit-fresh"
  ELSE
    IFSTALE p 0
      LET state = "deny-stale"
    ELSE
      LET state = "deny-other"
    END
  END
END

NOTE "svc_iffresh_cache_ttl_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_iffresh_cache_ttl -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IFC_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IFC_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "cache"
LET cache_dir = LAST
SYS JOIN cache_dir "entry.json"
LET cache_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET path = ""
LET msg = ""
LET peeld = ""
LET p = ""
LET limit = 0
LET state = ""
LET depth = 0
LET weight = 0
LET saved = 0
LET age = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ifc\",\"schema\":\"cubalc.svc_iffresh_cache_ttl.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ifc\",\"want_filter\":\"iffresh_cache_ttl\",\"cfg\":{\"surface\":\"IFFRESH,IFSTALE,IFFRESH_AGE,IFFRESH_LIMIT\",\"contract\":\"path age branches for cache admit and stale rebuild\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS CAT "{\"cache\":1,\"ttl\":3600}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cache_path body
  CLEAR_ERR
  LET p = cache_path
  LET limit = 3600
  CALL is_fresh
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ifc"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFFRESH_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = IFFRESH_AGE
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot fresh"
      FAIL "boot fresh"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFFRESH/IFSTALE core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS CAT "{\"ok\":1}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cache_path body
  CLEAR_ERR
  LET p = cache_path
  LET limit = 3600
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFFRESH_N == 1 THEN
    LET score = score + 1
  END
  LET age = IFFRESH_AGE
  IF age >= 0 THEN
    LET score = score + 1
  END
  IF IFFRESH_LIMIT == 3600 THEN
    LET score = score + 1
  END
  # default limit via huge TTL (omit-arg form tested in soft rebuild)
  LET limit = 86400
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # not stale with huge min
  LET limit = 99999999
  CALL is_stale
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # missing
  SYS JOIN cache_dir "nope.json"
  LET p = LAST
  LET limit = 3600
  CALL is_fresh
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF IFFRESH_N == 0 THEN
    LET score = score + 1
  END
  LET limit = 60
  CALL is_stale
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFSTALE_N == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score age note_msg
  CLEAR_ERR
END

# soft — rebuild nest · miss · keep fresh
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS JOIN cache_dir "soft.json"
  LET p = LAST
  # missing → rebuild
  LET limit = 60
  LET body = "rebuilt-soft"
  CALL rebuild_if_stale
  SYS EQS state "rebuilt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET limit = 3600
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # second rebuild should keep
  LET body = "should-not"
  LET limit = 99999999
  CALL rebuild_if_stale
  SYS EQS state "keep"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ p
  LET peeld = LAST
  CLEAR_ERR
  SYS EQS peeld "rebuilt-soft"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # admit fresh
  LET limit = 3600
  CALL admit_cache
  SYS EQS state "admit-fresh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # admit miss path
  SYS JOIN cache_dir "ghost.json"
  LET p = LAST
  LET limit = 10
  CALL admit_cache
  SYS EQS state "deny-stale"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL is_fresh
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL is_stale
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # IFBIG not linked
  HASFORM "IFBIG"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# peel — multi-entry cache window
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS JOIN cache_dir "a.json"
  LET pa = LAST
  SYS JOIN cache_dir "b.json"
  LET pb = LAST
  SYS WRITE pa "{\"k\":\"a\"}"
  SYS WRITE pb "{\"k\":\"b\"}"
  CLEAR_ERR
  LET p = pa
  LET limit = 3600
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET p = pb
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET age = IFFRESH_AGE
  IF age >= 0 THEN
    LET score = score + 1
  END
  LET limit = 99999999
  CALL is_stale
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS JOIN cache_dir "c.json"
  LET p = LAST
  LET limit = 30
  CALL is_stale
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET body = "{\"k\":\"c\",\"rebuilt\":1}"
  CALL rebuild_if_stale
  SYS EQS state "rebuilt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET limit = 3600
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL admit_cache
  SYS EQS state "admit-fresh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iffresh_cache_ttl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score age note_msg
  CLEAR_ERR
END

# scale — TTL ladder
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS WRITE cache_path "{\"scale\":1}"
  CLEAR_ERR
  LET p = cache_path
  LET limit = 1
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET limit = 60
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET limit = 3600
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET limit = 86400
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  # still not stale at high bar
  LET limit = 8640000
  CALL is_stale
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # limit sticky
  LET limit = 120
  CALL is_fresh
  IF IFFRESH_LIMIT == 120 THEN
    LET score = score + 1
  END
  LET admit_n = 0
  LET p = cache_path
  LET limit = 3600
  CALL admit_cache
  SYS EQS state "admit-fresh"
  IF LAST_N == 1 THEN
    LET admit_n = 1
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JOIN cache_dir "ghost2.json"
  LET p = LAST
  CALL admit_cache
  SYS EQS state "deny-stale"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFSTALE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET find_n = admit_n
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFFRESH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFSTALE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFFRESH_AGE"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFFRESH_LIMIT"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFSTALE_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFFILE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iffresh_cache_ttl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFFRESH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit only fresh cache under TTL
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS CAT "{\"gate\":1,\"ttl\":300}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cache_path body
  CLEAR_ERR
  LET p = cache_path
  LET limit = 300
  CALL is_fresh
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL admit_cache
  SYS EQS state "admit-fresh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF IFFRESH_LIMIT == 300 THEN
    LET score = score + 1
  END
  # miss sibling denied
  SYS JOIN cache_dir "sidecar.json"
  LET p = LAST
  LET limit = 300
  CALL admit_cache
  SYS EQS state "deny-stale"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit > 0 THEN
    IF score < 3 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ifc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF IFFRESH_N >= 0 THEN
    LET score = score + 1
  END
  LET p = cache_path
  LET limit = 300
  CALL is_stale
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR cache_dir
  CLEAR_ERR
  SYS WRITE cache_path "{\"probe\":1}"
  CLEAR_ERR
  LET p = cache_path
  LET limit = 3600
  CALL is_fresh
  LET saved = IFFRESH_N
  LET age = IFFRESH_AGE
  PRINT "probe-fresh" saved age
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "ifc host=" host_s " role=" role_s " fresh=" saved
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "fresh=1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFSTALE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF age >= 0 THEN
    LET score = score + 1
  END
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n age note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ifc\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

PASS
