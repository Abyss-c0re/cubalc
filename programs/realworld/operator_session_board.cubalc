# operator_session_board.cubalc — GECOS/FULLNAME + TTYNAME + ISATTY session
#
# Real use: ops agents stamp human operator labels and session terminal
# before interactive vs batch runbook branches without shell getent/tty:
#   GECOS / FULLNAME / REALNAME — passwd display name
#   TTYNAME / CTTY [IN|OUT|ERR|CTRL] — terminal device path
#   ISATTY / TTY               — 0|1 interactive stream probe
#   USER / HOME / SHELL        — login identity companions
# Distinct from process_priv (EUID/ISROOT/PPID) and identity_heartbeat
# (multi-probe health): this board is *display name + tty session gate*.
#
# Plate under STATE:
#   VAL.txt        — last stamp / path / bit
#   META.txt
#   OP_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_OS_ACTION):
#   list      — plate (default)
#   who       — user + fullname composite
#   full      — FULLNAME → VAL
#   gecos     — raw GECOS → VAL
#   tty       — TTYNAME ARG1 stream (default CTRL)
#   interactive — ISATTY ARG1 (default OUT) → VAL 0|1
#   gate      — ARG1=tty|batch admit (REQUIRE optional)
#   home      — HOME path
#   shell     — SHELL path
#   stamp     — durable operator session plate
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_os_$$
#   CUBALC_ARG0=who ...
#   CUBALC_ARG0=full ...
#   CUBALC_ARG0=tty CUBALC_ARG1=OUT ...
#   CUBALC_ARG0=interactive ...
#   CUBALC_ARG0=gate CUBALC_ARG1=batch ...
#   CUBALC_ARG0=stamp ...
#
# Env: CUBALC_OS_REQUIRE=1  CUBALC_OS_GATE=tty|batch  CUBALC_OS_STREAM=OUT
#
# Edges:
#   TTYNAME empty under pipes OK=1 LAST empty (not soft-fail)
#   ISATTY 0 with empty TTYNAME dual — agents may only check one
#   GECOS may equal USER when passwd comment empty
#   FULLNAME peels before first comma; GECOS keeps office fields
#   HAS fullname false friends; WRITE NL; REQUIRE; NUM
#   gate tty under -q pipes soft-denies

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "operator_session_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT VFILE = "VAL.txt"
DEFAULT MFILE = "META.txt"
DEFAULT REPORT = "OP_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT DEF_GATE = "batch"
DEFAULT DEF_STREAM = "OUT"
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_OS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_OS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_OS_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_OS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_OS_GATE" OR ""
IF LAST_N > 0 THEN
  LET ENV_GATE = LAST
ELSE
  LET ENV_GATE = ""
END
SYS ENV "CUBALC_OS_STREAM" OR ""
IF LAST_N > 0 THEN
  LET ENV_STREAM = LAST
ELSE
  LET ENV_STREAM = ""
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir VFILE
LET val_path = LAST
SYS JOIN state_dir MFILE
LET meta_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR val_path OR ""
LET val = LAST
CLEAR_ERR
SYS READ OR meta_path OR ""
LET meta = LAST
CLEAR_ERR

SYS BLANK ENV_GATE
IF LAST_N == 0 THEN
  SYS EQS ACTION "gate"
  IF LAST_N == 1 THEN
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = ENV_GATE
    END
  END
END
SYS BLANK ENV_STREAM
IF LAST_N == 0 THEN
  SYS EQS ACTION "tty"
  IF LAST_N == 1 THEN
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = ENV_STREAM
    END
  END
END
SYS BLANK ENV_STREAM
IF LAST_N == 0 THEN
  SYS EQS ACTION "interactive"
  IF LAST_N == 1 THEN
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = ENV_STREAM
    END
  END
END

LET hit = 0
LET miss = 0
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET tty_n = 0
LET isatty_n = 0
LET gate_n = 0
LET name_eq_user = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "opsess" ACTION
  PRINT_JSON ACTION STATUS_OK
  PRINT_JSON val
  PRINT_JSON meta
  LET note_msg = "list ok"
END

# --- who USER + FULLNAME ---
SYS EQS ACTION "who"
IF LAST_N == 1 THEN
  NOTE "action who"
  SYS USER
  LET uname = LAST
  SYS FULLNAME
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "who fullname fail"
    FAIL "who fullname fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "who fullname fail"
    END
  ELSE
    LET fname = LAST
    SYS GECOS
    LET gstr = LAST
    CLEAR_ERR
    SYS EQS fname uname
    LET name_eq_user = LAST_N
    SYS CAT uname " ("
    LET val = LAST
    SYS CAT val fname
    LET val = LAST
    SYS CAT val ")"
    LET val = LAST
    LET val_ch = 1
    LET hit = 1
    LET note_msg = "who ok"
    LET meta = "user"
    SYS PUSH meta uname
    LET meta = LAST
    SYS PUSH meta "fullname"
    LET meta = LAST
    SYS PUSH meta fname
    LET meta = LAST
    SYS PUSH meta "gecos"
    LET meta = LAST
    SYS PUSH meta gstr
    LET meta = LAST
    SYS PUSH meta "name_eq_user"
    LET meta = LAST
    SYS STR name_eq_user
    SYS PUSH meta LAST
    LET meta = LAST
    # HAS false friend on fullname
    SYS HAS fname uname
    LET has_u = LAST_N
    SYS PUSH meta "has_user_sub"
    LET meta = LAST
    SYS STR has_u
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON name_eq_user
  PRINT_JSON val
  CLEAR_ERR
END

# --- full FULLNAME ---
SYS EQS ACTION "full"
IF LAST_N == 1 THEN
  NOTE "action full"
  SYS FULLNAME
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "full fail"
    FAIL "full fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "full fail"
    END
  ELSE
    LET val = LAST
    SYS LEN val
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "full empty"
      FAIL "full empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "full empty"
      END
    ELSE
      LET hit = 1
      LET note_msg = "full ok"
    END
    LET val_ch = 1
    LET meta = "fullname"
    SYS PUSH meta val
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- gecos raw ---
SYS EQS ACTION "gecos"
IF LAST_N == 1 THEN
  NOTE "action gecos"
  SYS GECOS
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "gecos fail"
    FAIL "gecos fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gecos fail"
    END
  ELSE
    LET val = LAST
    LET val_ch = 1
    LET hit = 1
    LET note_msg = "gecos ok"
    # comma field count via HAS
    SYS HAS val ","
    LET has_comma = LAST_N
    CLEAR_ERR
    LET meta = "gecos"
    SYS PUSH meta val
    LET meta = LAST
    SYS PUSH meta "has_comma"
    LET meta = LAST
    SYS STR has_comma
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- tty TTYNAME stream ---
SYS EQS ACTION "tty"
IF LAST_N == 1 THEN
  NOTE "action tty"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET NAME = "CTRL"
  END
  SYS UPPER NAME
  LET stream = LAST
  # dispatch stream variants
  SYS EQS stream "IN"
  IF LAST_N == 1 THEN
    SYS TTYNAME IN
  ELSE
    SYS EQS stream "OUT"
    IF LAST_N == 1 THEN
      SYS TTYNAME OUT
    ELSE
      SYS EQS stream "ERR"
      IF LAST_N == 1 THEN
        SYS TTYNAME ERR
      ELSE
        SYS TTYNAME CTRL
        LET stream = "CTRL"
      END
    END
  END
  IF OK == 0 THEN
    LET miss = 1
    LET tty_n = 0
    LET note_msg = "tty fail"
    FAIL "tty fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "tty fail"
    END
  ELSE
    LET val = LAST
    LET tty_n = LAST_N
    IF tty_n == 0 THEN
      LET miss = 1
      LET note_msg = "tty none"
      FAIL "tty none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "tty none"
      END
    ELSE
      LET hit = 1
      LET note_msg = "tty ok"
    END
    LET val_ch = 1
    SYS HAS val "/dev"
    LET has_dev = LAST_N
    CLEAR_ERR
    LET meta = "stream"
    SYS PUSH meta stream
    LET meta = LAST
    SYS PUSH meta "path"
    LET meta = LAST
    SYS PUSH meta val
    LET meta = LAST
    SYS PUSH meta "n"
    LET meta = LAST
    SYS STR tty_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta "has_dev"
    LET meta = LAST
    SYS STR has_dev
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON tty_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- interactive ISATTY ---
SYS EQS ACTION "interactive"
IF LAST_N == 1 THEN
  NOTE "action interactive"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET NAME = DEF_STREAM
  END
  SYS UPPER NAME
  LET stream = LAST
  SYS EQS stream "IN"
  IF LAST_N == 1 THEN
    SYS ISATTY IN
  ELSE
    SYS EQS stream "ERR"
    IF LAST_N == 1 THEN
      SYS ISATTY ERR
    ELSE
      SYS ISATTY OUT
      LET stream = "OUT"
    END
  END
  IF OK == 0 THEN
    LET miss = 1
    LET isatty_n = 0
    LET note_msg = "isatty fail"
    FAIL "isatty fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "isatty fail"
    END
  ELSE
    LET isatty_n = LAST_N
    IF isatty_n == 0 THEN
      LET miss = 1
      LET note_msg = "not interactive"
      FAIL "not interactive"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "not interactive"
      END
    ELSE
      LET hit = 1
      LET note_msg = "interactive ok"
    END
    SYS STR isatty_n
    LET val = LAST
    LET val_ch = 1
    LET meta = "stream"
    SYS PUSH meta stream
    LET meta = LAST
    SYS PUSH meta "isatty"
    LET meta = LAST
    SYS STR isatty_n
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON isatty_n
  CLEAR_ERR
END

# --- gate tty|batch ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET NAME = DEF_GATE
  END
  SYS LOWER NAME
  LET want = LAST
  SYS ISATTY OUT
  LET isatty_n = LAST_N
  SYS TTYNAME OUT
  LET tpath = LAST
  LET tty_n = LAST_N
  CLEAR_ERR
  LET gate_n = 0
  SYS EQS want "tty"
  IF LAST_N == 1 THEN
    IF isatty_n == 1 THEN
      LET gate_n = 1
    END
  ELSE
    SYS EQS want "batch"
    IF LAST_N == 1 THEN
      IF isatty_n == 0 THEN
        LET gate_n = 1
      END
    ELSE
      SYS EQS want "interactive"
      IF LAST_N == 1 THEN
        IF isatty_n == 1 THEN
          LET gate_n = 1
        END
      ELSE
        # false friend: HAS want "tty" matches "notty" / "batchty"
        SYS HAS want "tty"
        IF LAST_N == 1 THEN
          SYS HAS want "no"
          IF LAST_N == 1 THEN
            IF isatty_n == 0 THEN
              LET gate_n = 1
            END
          ELSE
            IF isatty_n == 1 THEN
              LET gate_n = 1
            END
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate unknown mode"
          FAIL "gate unknown mode"
          CLEAR_ERR
          IF REQUIRE_HIT > 0 THEN
            EXIT 2 "gate unknown mode"
          END
        END
      END
    END
  END
  SYS EQS note_msg "gate unknown mode"
  IF LAST_N == 0 THEN
    IF gate_n == 0 THEN
      LET miss = 1
      LET note_msg = "gate deny"
      FAIL "gate deny"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "gate deny"
      END
    ELSE
      LET hit = 1
      LET note_msg = "gate ok"
    END
    SYS STR gate_n
    LET val = LAST
    LET val_ch = 1
    LET meta = "want"
    SYS PUSH meta want
    LET meta = LAST
    SYS PUSH meta "isatty"
    LET meta = LAST
    SYS STR isatty_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta "ttyname"
    LET meta = LAST
    SYS PUSH meta tpath
    LET meta = LAST
    SYS PUSH meta "tty_n"
    LET meta = LAST
    SYS STR tty_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta "ok"
    LET meta = LAST
    SYS STR gate_n
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON gate_n isatty_n tty_n
  CLEAR_ERR
END

# --- home ---
SYS EQS ACTION "home"
IF LAST_N == 1 THEN
  NOTE "action home"
  SYS HOME
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "home fail"
    FAIL "home fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "home fail"
    END
  ELSE
    LET val = LAST
    SYS LEN val
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "home empty"
      FAIL "home empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "home empty"
      END
    ELSE
      LET hit = 1
      LET note_msg = "home ok"
    END
    LET val_ch = 1
    LET meta = "home"
    SYS PUSH meta val
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- shell ---
SYS EQS ACTION "shell"
IF LAST_N == 1 THEN
  NOTE "action shell"
  SYS SHELL
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "shell fail"
    FAIL "shell fail"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "shell fail"
    END
  ELSE
    LET val = LAST
    LET val_ch = 1
    LET hit = 1
    LET note_msg = "shell ok"
    LET meta = "shell"
    SYS PUSH meta val
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- stamp durable session ---
SYS EQS ACTION "stamp"
IF LAST_N == 1 THEN
  NOTE "action stamp"
  SYS USER
  LET uname = LAST
  SYS FULLNAME
  LET fname = LAST
  SYS GECOS
  LET gstr = LAST
  SYS HOME
  LET hdir = LAST
  SYS SHELL
  LET sh = LAST
  SYS HOSTNAME
  LET hname = LAST
  SYS ISATTY OUT
  LET isatty_n = LAST_N
  SYS TTYNAME OUT
  LET tpath = LAST
  LET tty_n = LAST_N
  SYS TTYNAME CTRL
  LET ctty = LAST
  CLEAR_ERR
  SYS EQS fname uname
  LET name_eq_user = LAST_N
  # VAL = fullname <user@host> tty|batch
  SYS CAT fname " <"
  LET val = LAST
  SYS CAT val uname
  LET val = LAST
  SYS CAT val "@"
  LET val = LAST
  SYS CAT val hname
  LET val = LAST
  SYS CAT val "> "
  LET val = LAST
  IF isatty_n == 1 THEN
    SYS CAT val "tty"
  ELSE
    SYS CAT val "batch"
  END
  LET val = LAST
  LET val_ch = 1
  LET hit = 1
  LET note_msg = "stamp ok"
  LET meta = "user"
  SYS PUSH meta uname
  LET meta = LAST
  SYS PUSH meta "fullname"
  LET meta = LAST
  SYS PUSH meta fname
  LET meta = LAST
  SYS PUSH meta "gecos"
  LET meta = LAST
  SYS PUSH meta gstr
  LET meta = LAST
  SYS PUSH meta "home"
  LET meta = LAST
  SYS PUSH meta hdir
  LET meta = LAST
  SYS PUSH meta "shell"
  LET meta = LAST
  SYS PUSH meta sh
  LET meta = LAST
  SYS PUSH meta "host"
  LET meta = LAST
  SYS PUSH meta hname
  LET meta = LAST
  SYS PUSH meta "isatty"
  LET meta = LAST
  SYS STR isatty_n
  SYS PUSH meta LAST
  LET meta = LAST
  SYS PUSH meta "tty_out"
  LET meta = LAST
  SYS PUSH meta tpath
  LET meta = LAST
  SYS PUSH meta "ctty"
  LET meta = LAST
  SYS PUSH meta ctty
  LET meta = LAST
  SYS PUSH meta "name_eq_user"
  LET meta = LAST
  SYS STR name_eq_user
  SYS PUSH meta LAST
  LET meta = LAST
  SYS PUSH meta "identity"
  LET meta = LAST
  SYS PUSH meta IDENTITY
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON isatty_n tty_n name_eq_user
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET val = ""
  LET meta = ""
  LET val_ch = 1
  LET meta_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "who"
LET k = k + LAST_N
SYS EQS ACTION "full"
LET k = k + LAST_N
SYS EQS ACTION "gecos"
LET k = k + LAST_N
SYS EQS ACTION "tty"
LET k = k + LAST_N
SYS EQS ACTION "interactive"
LET k = k + LAST_N
SYS EQS ACTION "gate"
LET k = k + LAST_N
SYS EQS ACTION "home"
LET k = k + LAST_N
SYS EQS ACTION "shell"
LET k = k + LAST_N
SYS EQS ACTION "stamp"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF val_ch > 0 THEN
  SYS WRITE val_path val
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "val write failed"
  END
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "meta write failed"
  END
  CLEAR_ERR
END

SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.operator_session_board.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "isatty"
LET report = LAST
SYS STR isatty_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "tty_n"
LET report = LAST
SYS STR tty_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "gate"
LET report = LAST
SYS STR gate_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "name_eq_user"
LET report = LAST
SYS STR name_eq_user
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "operator_session_board" ACTION hit miss isatty_n tty_n gate_n note_msg elapsed
