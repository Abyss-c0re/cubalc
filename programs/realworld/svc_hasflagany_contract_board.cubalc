# svc_hasflagany_contract_board.cubalc — HASFLAGANY/NEEDFLAGANY fleet any-of flag contract
#
# Real use: fleet export/format agents admit when ANY of a flag set is present
# (json|yaml|xml|csv) without N× HASFLAG OR chains. First realworld of 1374/1376
# HASFLAGANY (1.15.826+) · HASFLAGALL twin for any-of.
#
#   HASFLAGANY names… · NEEDFLAGANY names… → any-present gate
#   FLAGHAVE / FLAGMISS bags · HASFLAGANY_N count of hits
#   CSV/bag forms · dash-prefixed names · soft miss sticky ERR
#   hard NEEDFLAGANY miss often exit_code 0 (W7/W16 class)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_hfy_$$
#   ./out/cubalc run programs/realworld/svc_hasflagany_contract_board.cubalc boot
#   ./out/cubalc run ... any|miss|hard|bag|short|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt HFY_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_HFY_REQUIRE
#
# Edges: CUBALC_ARG* via SYS ENV SET only (W1); PRINT clobber FLAGHAVE;
#   NEEDFLAGANY hard miss exit_code 0; short -w is name w; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_hasflagany_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_hasflagany_contract -- boot|any|miss|hard|bag|short|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_HFY_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "HFY_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET flag_n = 0
LET miss_n = 0
LET have_n = 0
LET peel_s = ""

ONEOF ACTION "boot", "any", "miss", "hard", "bag", "short", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "any" THEN
    LET op = "any"
  WHEN "miss" THEN
    LET op = "miss"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "bag" THEN
    LET op = "bag"
  WHEN "short" THEN
    LET op = "short"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-hfy\",\"schema\":\"cubalc.svc_hasflagany_contract.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"flag_any\",\"label\":\"hfy\",\"cfg\":{\"surface\":\"HASFLAGANY,NEEDFLAGANY,FLAGHAVE,FLAGMISS,HASFLAGALL\",\"contract\":\"json|yaml|xml any-of format\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"flag_any\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-hfy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_hasflagany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "flag_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# any — partial hit succeeds (any-of)
SYS EQS op "any"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # one of three present
  SYS ENV SET CUBALC_ARG0 "--yaml"
  SYS ENV SET CUBALC_ARG1 "file.txt"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGANY json yaml xml
  LET sum_v = LAST_N
  LET have_n = HASFLAGANY_N
  LET miss_n = FLAGMISS_N
  LET body = FLAGHAVE
  LET stem_s = FLAGMISS
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF have_n == 1 THEN
    LET score = score + 1
  END
  IF miss_n == 2 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "yaml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "json"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "xml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # all present
  SYS ENV SET CUBALC_ARG0 "--json"
  SYS ENV SET CUBALC_ARG1 "--xml"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGANY json yaml xml
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  IF HASFLAGANY_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF FLAGMISS_N == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.contract"
  SYS HAS LAST "json"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "any ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "any score"
    FAIL "any score"
    CLEAR_ERR
  END
  SYS CAT "any:" have_n ":an"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n have_n score note_msg
  CLEAR_ERR
END

# miss — none present soft
SYS EQS op "miss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  HASFLAGANY
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASFLAGANY_N == 0 THEN
    LET score = score + 1
  END
  HASFLAGANY json yaml xml
  LET sum_v = LAST_N
  LET miss_n = FLAGMISS_N
  LET stem_s = FLAGMISS
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 3 THEN
    LET score = score + 1
  END
  IF OK == 0 THEN
    LET score = score + 1
  END
  SYS HASLINE stem_s "json"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "yaml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI "HASFLAGANY miss"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # wrong flag only
  SYS ENV SET CUBALC_ARG0 "--only"
  SYS ENV SET CUBALC_ARGC "1"
  HASFLAGANY json yaml
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF FLAGMISS_N == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "FLAGMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "miss ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "miss score"
    FAIL "miss score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE miss denied"
    END
  END
  SYS CAT "miss:" miss_n ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "miss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n miss_n score note_msg
  CLEAR_ERR
END

# hard — NEEDFLAGANY pass when any present
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--yaml=1"
  SYS ENV SET CUBALC_ARGC "1"
  NEEDFLAGANY json yaml xml
  LET sum_v = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF HASFLAGANY_N == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE FLAGHAVE "yaml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft dual still works after hard pass
  HASFLAGANY json yaml
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # HASFLAGALL still requires all
  HASFLAGALL json yaml
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "yaml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "flag_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:1:hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# bag — CSV / newline bag forms + dash-prefixed names
SYS EQS op "bag"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--json"
  SYS ENV SET CUBALC_ARG1 "--xml"
  SYS ENV SET CUBALC_ARGC "2"
  HASFLAGANY "json,yaml,xml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASFLAGANY_N == 2 THEN
    LET score = score + 1
  END
  HASFLAGANY "json
yaml
xml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGANY "--json" "--yaml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE FLAGHAVE "json"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE FLAGMISS "yaml"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FLAGHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "any-of"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasflagany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "bag ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "bag score"
    FAIL "bag score"
    CLEAR_ERR
  END
  SYS CAT "bag:2:bg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "bag:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# short — short -w is name w not workers (false friend dual of HASFLAGALL)
SYS EQS op "short"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "-w"
  SYS ENV SET CUBALC_ARG2 "4"
  SYS ENV SET CUBALC_ARGC "3"
  HASFLAGANY verbose out w
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASFLAGANY_N == 2 THEN
    LET score = score + 1
  END
  SYS HASLINE FLAGHAVE "verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE FLAGHAVE "w"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE FLAGMISS "out"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # workers not present as long name
  HASFLAGANY workers
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFLAGANY w
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "flag_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-hfy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "short ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "short score"
    FAIL "short score"
    CLEAR_ERR
  END
  SYS CAT "short:2:sh"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "short:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM discovery + ALL vs ANY contrast
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORM "HASFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEEDFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM HASFLAGANY
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "HASFLAGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDFLAGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FLAGHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "format"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasflagany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hfy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
