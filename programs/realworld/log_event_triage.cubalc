# log_event_triage.cubalc — LIST + GREP + EACH LINE event log triage
#
# Real use: agents dump multi-line event/status logs under CUBALC_STATE/logs/.
# This program:
#   SYS LIST logs/ → GREP file-filter → GREPV noise → EACH LINE walk basenames
#   READ each log, GREP severity needle (default "ERROR"), GREPV drop noise lines
#   nested EACH LINE over hit lines to count + capture first hit
#   write TRIAGE_REPORT.txt under out/; optional severity FOLDBITS/DECIDE digit
#   optional REQUIRE hits / REQUIRE files for CI gates
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$
#   mkdir -p "$CUBALC_STATE/logs"
#   printf 'ok line\nERROR disk full\nDEBUG noise\n' > "$CUBALC_STATE/logs/app.log"
#   ./out/cubalc run -q -s programs/realworld/log_event_triage.cubalc
#
# Optional env:
#   CUBALC_TRIAGE_FILTER=.log     # LIST keep needle (empty = all names)
#   CUBALC_TRIAGE_DROP=.tmp       # LIST drop needle (GREPV)
#   CUBALC_TRIAGE_NEEDLE=ERROR    # content severity needle
#   CUBALC_TRIAGE_NOISE=DEBUG     # content drop needle
#   CUBALC_TRIAGE_MAX_BYTES=65536
#   CUBALC_TRIAGE_REQUIRE_HITS=1  # EXIT 2 if zero hit lines
#   CUBALC_TRIAGE_REQUIRE_FILES=1 # EXIT 2 if zero log files after filter
#
# Edges deliberately hit:
#   EACH LINE without WHILE+NTH glue (post-617 usability)
#   GREP/GREPV chain after LIST; nested EACH over GREP hits
#   GREP is case-sensitive substring only — no OR/regex (gap)
#   GREP/EACH field truncates at 512 chars per line (host buffer edge)
#   nested EACH clobbers shared LINE/IT/IDX (outer AS name ok)
#   var_slot cap 64 vs LET cap 128 — DECIDE silent bind miss (high)
#   VARS JSON collapses newlines in LIST/GREP multi-line strings
#   SYS JOIN still undiscoverable via forms/search (catalog gap)
#   LIST non-recursive; basenames only; LIST soft err_line=0
#   soft READ OR miss + sticky last_err vs -s

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "log_event_triage: start"
DEFAULT FILTER = ".log"
DEFAULT DROP = ".tmp"
DEFAULT NEEDLE = "ERROR"
DEFAULT NOISE = "DEBUG"
DEFAULT MAX_BYTES = 65536
DEFAULT REQUIRE_HITS = 0
DEFAULT REQUIRE_FILES = 0
# Pre-bind DECIDE/DIGIT while n_vars is low. var_slot create-cap is 64;
# once LIST/EACH fills the table, DECIDE brain still prints but cannot
# create the plate var (silent dig=0). Updating an existing slot works.
LET DECIDE = -1
LET DIGIT = -1
IDENTITY
SYS DATE
LET triage_date = DATE
SYS MS
LET t0 = MS

# --- config from ENV (empty string keeps DEFAULT) ---
SYS ENV "CUBALC_TRIAGE_FILTER" OR ""
IF LAST_N > 0 THEN
  LET FILTER = LAST
END
SYS ENV "CUBALC_TRIAGE_DROP" OR ""
IF LAST_N > 0 THEN
  LET DROP = LAST
END
SYS ENV "CUBALC_TRIAGE_NEEDLE" OR ""
IF LAST_N > 0 THEN
  LET NEEDLE = LAST
END
SYS ENV "CUBALC_TRIAGE_NOISE" OR ""
IF LAST_N > 0 THEN
  LET NOISE = LAST
END
SYS ENV "CUBALC_TRIAGE_MAX_BYTES" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MAX_BYTES = LAST_N
  END
END
SYS ENV "CUBALC_TRIAGE_REQUIRE_HITS" OR "0"
SYS EQS LAST "1"
IF LAST_N == 1 THEN
  LET REQUIRE_HITS = 1
END
SYS ENV "CUBALC_TRIAGE_REQUIRE_FILES" OR "0"
SYS EQS LAST "1"
IF LAST_N == 1 THEN
  LET REQUIRE_FILES = 1
END

# --- workspace plates ---
SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
CLEAR_ERR
SYS JOIN state_dir "logs"
LET logs_dir = LAST
SYS JOIN state_dir "out"
LET out_dir = LAST
SYS MKDIR logs_dir
SYS MKDIR out_dir
ASSERT OK == 1 "out mkdir"

SYS ISDIR logs_dir
ASSERT LAST_N == 1 "logs is dir"

# --- LIST → GREP keep → GREPV drop → snapshot listing ---
SYS LIST logs_dir
IF OK == 0 THEN
  FAIL "LIST logs failed"
  CLEAR_ERR
  EXIT 2 "list failed"
END
LET raw_n = LIST_N
LET listing = LAST
NOTE "listed logs"

# keep only names matching FILTER (empty FILTER → keep all)
SYS EQS FILTER ""
IF LAST_N == 1 THEN
  LET filtered = listing
  LET file_n = raw_n
ELSE
  SYS GREP FILTER listing
  LET filtered = LAST
  LET file_n = GREP_N
END

# drop noise basenames
SYS EQS DROP ""
IF LAST_N == 0 THEN
  SYS GREPV DROP filtered
  LET filtered = LAST
  LET file_n = GREP_N
END

CLEAR_ERR "list filter clean"

IF REQUIRE_FILES == 1 THEN
  IF file_n == 0 THEN
    FAIL "no log files after filter"
    EXIT 2 "no files"
  END
END

# --- walk basenames with EACH LINE (no NTH index glue) ---
LET files_seen = 0
LET files_read = 0
LET files_skipped = 0
LET hit_total = 0
LET first_hit = ""
LET first_file = ""
LET dig = -1

EACH LINE AS fname IN filtered
  LET files_seen = files_seen + 1
  SYS JOIN logs_dir fname
  LET path = LAST

  SYS ISFILE path
  IF LAST_N == 0 THEN
    LET files_skipped = files_skipped + 1
    NOTE "skip non-file"
    CONTINUE
  END

  SYS SIZE path
  IF OK == 0 THEN
    CLEAR_ERR
    LET files_skipped = files_skipped + 1
    CONTINUE
  END
  IF SIZE == 0 THEN
    LET files_skipped = files_skipped + 1
    CONTINUE
  END
  IF SIZE > MAX_BYTES THEN
    LET files_skipped = files_skipped + 1
    NOTE "skip oversize"
    CONTINUE
  END

  SYS READ path
  IF OK == 0 THEN
    CLEAR_ERR
    LET files_skipped = files_skipped + 1
    CONTINUE
  END
  LET body = LAST
  LET files_read = files_read + 1

  # drop noise lines then keep severity needle
  SYS GREPV NOISE body
  LET cleaned = LAST
  SYS GREP NEEDLE cleaned
  LET hits = LAST
  LET hn = GREP_N
  LET hit_total = hit_total + hn

  IF hn > 0 THEN
    # nested walk — bind hitline so outer fname/LINE plane is not the only name
    # (LINE/IT/IDX still clobbered — language shared-slot edge)
    EACH LINE AS hitline IN hits
      SYS EQS first_hit ""
      IF LAST_N == 1 THEN
        LET first_hit = hitline
        LET first_file = fname
      END
      BREAK
    END
    NOTE "hits in file"
  END
END

# --- severity fold: hit_total → bits → DECIDE digit for agents ---
# Weakness: var_slot (DECIDE/DIGIT/UNITY) hard-caps at 64 vars while LET
# allows 128. After a LIST/EACH/GREP walk, n_vars often exceeds 64 and
# DECIDE silently fails to bind (board prints "decide N" but DECIDE var
# stays 0). Free temps before fold so DECIDE can create its plate slot.
IF hit_total > 0 THEN
  UNSET listing
  UNSET filtered
  UNSET body
  UNSET cleaned
  UNSET hits
  UNSET path
  UNSET fname
  UNSET hitline
  UNSET line
  CLEAR_ERR
  CUBE peer0 ROLE host PROTON 1
  CUBE brain ROLE braincube PROTON 1
  PLUG peer0 brain
  # compact presence bits: high hits → denser 1s
  IF hit_total >= 4 THEN
    FOLDBITS peer0 "11111111"
  ELSE
    IF hit_total >= 2 THEN
      FOLDBITS peer0 "11110000"
    ELSE
      FOLDBITS peer0 "11000000"
    END
  END
  IMPULSE peer0 1
  IMPULSE brain 1
  FLOW 2
  DECIDE brain
  LET dig = DECIDE
  NOTE "severity fold done"
END

# --- require gates ---
IF REQUIRE_HITS == 1 THEN
  IF hit_total == 0 THEN
    FAIL "no severity hits"
    EXIT 2 "no hits"
  END
END

# --- report plate ---
SYS JOIN out_dir "TRIAGE_REPORT.txt"
LET report = LAST
SYS CAT "cubalc.log_event_triage.v1 ok=1 date=" triage_date
LET line = LAST
SYS CAT line " files=" 
LET line = LAST
# numeric fields via CAT of stringified path: use PRINT_JSON for machine plate
SYS WRITE report line
# richer sidecar as key=value lines rebuilt
SYS CAT "files_seen=" ""
# Write multi-field summary via successive CAT into summary then WRITE
SYS CAT "schema=cubalc.log_event_triage.v1"
LET summary = LAST
SYS CAT summary " date="
LET summary = LAST
SYS CAT summary triage_date
LET summary = LAST
SYS CAT summary " needle="
LET summary = LAST
SYS CAT summary NEEDLE
LET summary = LAST
SYS CAT summary " filter="
LET summary = LAST
SYS CAT summary FILTER
LET summary = LAST
SYS CAT summary " first_file="
LET summary = LAST
SYS CAT summary first_file
LET summary = LAST
SYS CAT summary " first_hit="
LET summary = LAST
SYS CAT summary first_hit
LET summary = LAST
SYS WRITE report summary
SYS EXIST report
ASSERT EXIST == 1 "report written"

SYS MS
LET elapsed_ms = MS - t0

STATUS
ASSERT STATUS_OK == 1
NOTE "log_event_triage: done"
PRINT "triage" files_seen files_read files_skipped hit_total dig file_n raw_n
PRINT_JSON files_seen files_read files_skipped hit_total dig file_n raw_n first_file first_hit elapsed_ms STATUS_OK
VARS
STATUS
CLEAR_ERR "triage clean"
EXIT 0 "triage ok"
