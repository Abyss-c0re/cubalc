# svc_delbyval_scrub_board.cubalc — DELBYVAL scrub leaves by exact value
#
# Real use: fleet agents drop all leaves matching a value (scrub workers,
# drop ok peers) without PATHSBYVAL+EACH+DELP glue — value-based GC.
# First realworld of proof 1248 DELBYVAL (MEANINGFUL 707).
#
#   DELBYVAL|DROPVAL [FROM plate] value
#   LAST_N / DELBYVAL_N = dropped · plate mutated · HASVAL after scrub
#   Prefer LAST_N near 128-var cap (W408). SAVEPLATE for durable.
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sdb_$$
#   ./out/cubalc run programs/realworld/svc_delbyval_scrub_board.cubalc boot
#   ./out/cubalc run ... del|peer|soft|gate|alias|cross|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SDB_REPORT.txt agent.json peer.json del.txt
# Env: HOST_S ROLE_S CUBALC_SDB_REQUIRE
#
# Edges: soft miss n=0; FROM PEER; DROPVAL; HASVAL after scrub; exact partials;
#   WRITE NL; REQUIRE softens; durable SAVEPLATE

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_delbyval_scrub_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_delbyval_scrub -- boot|del|peer|soft|gate|alias|cross|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeD"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SDB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "del.txt"
LET del_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SDB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET del_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "del", "peer", "soft", "gate", "alias", "cross", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "del" THEN
    LET op = "del"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "cross" THEN
    LET op = "cross"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — dual worker + leader + peer ok/fail
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-delbyval\",\"schema\":\"cubalc.svc_delbyval_scrub.v1\",\"site\":\"" host_s "\",\"agent_job\":\"runner\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"worker\",\"host\":\"h1\"},\"other\":{\"host\":\"h2\",\"role\":\"leader\"},\"label\":\"del\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_delbyval_scrub.v1\",\"site\":\"" host_s "\",\"a\":{\"status\":\"ok\"},\"b\":{\"status\":\"fail\"},\"c\":{\"status\":\"ok\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "del"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:roles:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# del — DELBYVAL worker scrub (2 drops)
SYS EQS op "del"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # re-seed in case prior runs scrubbed
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  SETP "cfg.host" "h1"
  CLEAR_ERR
  SETP "other.host" "h2"
  CLEAR_ERR
  DELBYVAL "worker"
  LET del_n = LAST_N
  CLEAR_ERR
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE del_path body
  CLEAR_ERR
  IF del_n == 2 THEN
    LET score = score + 1
  END
  HASVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASP "meta.role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  COUNTBYVAL "h1"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "del"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "del ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "del score"
    FAIL "del score"
    CLEAR_ERR
  END
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "del:" body ":dl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "del:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

# peer — DELBYVAL FROM PEER ok scrub
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # re-seed peer statuses
  SETP FROM PEER "a.status" "ok"
  CLEAR_ERR
  SETP FROM PEER "b.status" "fail"
  CLEAR_ERR
  SETP FROM PEER "c.status" "ok"
  CLEAR_ERR
  DELBYVAL FROM PEER "ok"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 2 THEN
    LET score = score + 1
  END
  HASVAL FROM PEER "ok"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP FROM PEER "b.status"
  SYS EQS LAST "fail"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTBYVAL FROM PEER "fail"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-delbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE peer_path PEER
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE del_path body
  CLEAR_ERR
  SYS CAT "peer:" body ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

# soft — no match leaves plate intact
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  DELBYVAL "ghostpath"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 0 THEN
    LET score = score + 1
  END
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTBYVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 2 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-delbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "del"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

# gate — scrub workers then admit when no worker remains
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  SETP "cfg.host" "h1"
  CLEAR_ERR
  DELBYVAL "worker"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 2 THEN
    LET score = score + 1
  END
  HASVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  HASVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASVAL "h1"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_delbyval_scrub"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE del_path body
  CLEAR_ERR
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

# alias — DROPVAL leader
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "other.role" "leader"
  CLEAR_ERR
  SETP "cfg.host" "h1"
  CLEAR_ERR
  DROPVAL "leader"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 1 THEN
    LET score = score + 1
  END
  HASVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-delbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "del"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "alias:" body ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

# cross — DELBYVAL n == prior COUNTBYVAL of value
SYS EQS op "cross"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  SETP "other.role" "leader"
  CLEAR_ERR
  COUNTBYVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  DELBYVAL "worker"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == admit_n THEN
    LET score = score + 1
  END
  IF del_n == 2 THEN
    LET score = score + 1
  END
  HASVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  COUNTBYVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-delbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "del"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "cross ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "cross score"
    FAIL "cross score"
    CLEAR_ERR
  END
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "cross:" body ":xr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "cross:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

# probe — exact value; partials do not scrub
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.role" "worker"
  CLEAR_ERR
  DELBYVAL "work"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 0 THEN
    LET score = score + 1
  END
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  DELBYVAL "orker"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 0 THEN
    LET score = score + 1
  END
  DELBYVAL "worker"
  LET del_n = LAST_N
  CLEAR_ERR
  IF del_n == 2 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "delbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "del"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS STR del_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE del_path body
  CLEAR_ERR
  SYS CAT "probe:" body ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n del_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_delbyval_scrub.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " del_n=" del_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_delbyval_scrub_board: end"
