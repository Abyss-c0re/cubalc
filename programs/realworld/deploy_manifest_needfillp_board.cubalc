# deploy_manifest_needfillp_board.cubalc — NEEDFILLP/FILLP STRICT deploy gate
#
# Real use: canary/deploy agents expand release manifests from PLATE. Soft
# FILLP drafts leave miss keys empty; NEEDFILLP/FILLP STRICT refuse to ship
# half-filled plates (lists missing {{keys}}). FILLPKEYS discovers contract.
# First realworld of proof 1124 fillp_strict.
#
#   FILLPKEYS [tmpl]          → LAST bag of unique {{keys}} · FILLPKEYS_N
#   FILLP [tmpl]              → soft expand · FILLP_MISS · FILLP_MISS_KEYS
#   NEEDFILLP|FILLP STRICT    → fail-fast if any {{key}} missing
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_dmnf_$$
#   ./out/cubalc run programs/realworld/deploy_manifest_needfillp_board.cubalc \
#     boot -- --plate=/tmp/dmnf/deploy.json
#   ./out/cubalc run ... keys|draft|ship|softship|gate|probe|list -- --plate=...
#
# Plate: STATUS.txt VAL.txt META.txt DMNF_REPORT.txt
# Env: PLATE_PATH REL_S WAVE_S HOST_S CUBALC_DMNF_REQUIRE
#
# Edges:
#   soft miss empty slots; empty PLATE; empty-string key is hit;
#   FILLPKEYS dedupe; STRICT hard-fail host-side; WRITE omit NL; soft empty bag
#   var table 128: keep knobs tight (W-varcap)

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "deploy_manifest_needfillp_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "deploy_manifest_needfillp -- boot|keys|draft|ship|softship|gate|probe|list -- [--plate=P] [--rel=R] [--wave=W] [--host=H]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/deep/deploy.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
CLEAR_ERR

DEFAULT REL_S = "1.15.574"
GETFLAG rel|r OR ENV REL_S OR REL_S
LET rel_s = LAST
CLEAR_ERR

DEFAULT WAVE_S = "canary"
GETFLAG wave|w OR ENV WAVE_S OR WAVE_S
LET wave_s = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeA"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_DMNF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "DMNF_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "out/manifest.out"
LET out_file = LAST
SYS JOIN state_dir "out"
LET out_dir = LAST
SYS MKDIR out_dir
CLEAR_ERR

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

# tight knobs — reuse; avoid var-table thrash (128 cap)
LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET keys_n = 0

# manifest template: 4 unique keys (wave deduped in FILLPKEYS)
DEFAULT TPL = "release={{rel}} wave={{wave}} host={{host}} path=/opt/cube/{{rel}}/bin miss={{nope}} tag={{wave}}"
LET tpl = TPL
CLEAR_ERR

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "keys", "draft", "ship", "softship", "gate", "list", "ls", "soft", "clear", "probe", "alias"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "keys" THEN
    LET op = "keys"
  WHEN "draft" THEN
    LET op = "draft"
  WHEN "ship" THEN
    LET op = "ship"
  WHEN "softship" THEN
    LET op = "softship"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "alias" THEN
    LET op = "alias"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src rel_s wave_s host_s
  CLEAR_ERR
END

LET PLATE_PATH = plate_file
SYS JSONOBJ "n" 0 "ok" true "role" "deploy" "schema" "cubalc.deploy_manifest.v1"
LET PLATE_SEED = LAST
CLEAR_ERR

# boot — plate_session + release identity (UPDATEPLATE disk stamp)
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SYS UPDATEPLATE plate_file "rel" rel_s
  CLEAR_ERR
  SYS UPDATEPLATE plate_file "wave" wave_s
  CLEAR_ERR
  SYS UPDATEPLATE plate_file "host" host_s
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSON "rel" FROM body
  SYS EQS LAST rel_s
  LET has_n = LAST_N
  CLEAR_ERR
  LET out = body
  LET take_n = load_hit
  IF load_hit == 1 THEN
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET created = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot rel"
      FAIL "boot rel"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot load"
    FAIL "boot load"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "boot fail"
    END
  END
  SYS CAT "boot:" rel_s ":" wave_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n load_hit p_src note_msg
  CLEAR_ERR
END

# keys — FILLPKEYS contract discovery (dedupe wave → 4 unique)
SYS EQS op "keys"
IF LAST_N == 1 THEN
  LET known = 1
  FILLPKEYS tpl
  LET keys_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "rel"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE body "wave"
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HASLINE body "host"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "nope"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF keys_n == 4 THEN
    IF has_n == 1 THEN
      IF take_n == 1 THEN
        IF peel_hit == 1 THEN
          IF load_hit == 1 THEN
            LET hit = 1
            LET note_msg = "keys ok"
            LET admit_n = 1
            LET out = body
          ELSE
            LET miss = 1
            LET note_msg = "keys nope"
            FAIL "keys nope"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "keys host"
          FAIL "keys host"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "keys wave"
        FAIL "keys wave"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "keys rel"
      FAIL "keys rel"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "keys n"
    FAIL "keys n"
    CLEAR_ERR
  END
  SYS CAT "keys:" keys_n ":" load_hit ":ky"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "keys:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keys_n has_n take_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# draft — soft FILLP; {{nope}} empty; body contract (avoid FILLP_MISS_KEYS under var pressure)
SYS EQS op "draft"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "rel" rel_s
  CLEAR_ERR
  SETP "wave" wave_s
  CLEAR_ERR
  SETP "host" host_s
  CLEAR_ERR
  DELP "nope"
  CLEAR_ERR
  FILLP tpl
  LET has_n = OK
  LET take_n = FILLP_N
  LET miss_n = FILLP_MISS
  LET body = LAST
  CLEAR_ERR
  # soft miss: miss= empty before tag=
  SYS HAS body "miss= tag="
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "release="
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS CAT "release=" rel_s " wave=" wave_s " host=" host_s " path=/opt/cube/" rel_s "/bin miss= tag=" wave_s
  LET row = LAST
  CLEAR_ERR
  SYS EQS body row
  LET admit_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF admit_n == 1 THEN
        LET hit = 1
        LET note_msg = "draft ok"
        LET out = body
        SYS WRITE out_file body
        CLEAR_ERR
        INCLUDE plate_save
        CLEAR_ERR
      ELSE
        LET miss = 1
        LET note_msg = "draft body"
        FAIL "draft body"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "draft softmiss"
      FAIL "draft softmiss"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "draft fillp"
    FAIL "draft fillp"
    CLEAR_ERR
  END
  SYS CAT "draft:" peel_hit ":" take_n ":dr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "draft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n miss_n peel_hit admit_n note_msg
  CLEAR_ERR
END

# softship — preflight: soft FILLP; block if miss= empty still present
SYS EQS op "softship"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "rel" rel_s
  CLEAR_ERR
  SETP "wave" wave_s
  CLEAR_ERR
  SETP "host" host_s
  CLEAR_ERR
  DELP "nope"
  CLEAR_ERR
  FILLP tpl
  LET take_n = FILLP_N
  LET miss_n = FILLP_MISS
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "miss= tag="
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    LET miss = 1
    LET note_msg = "softship blocked"
    LET hit = 0
    LET admit_n = 0
    LET out = body
    IF require_hit > 0 THEN
      FAIL "softship miss require"
      CLEAR_ERR
      EXIT 2 "softship miss"
    END
    FAIL "softship miss soft"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "softship ready"
    LET admit_n = 1
    LET out = body
  END
  # prefix sship: avoids GREPV "ship:" false-friend clobber (softship contains ship:)
  SYS CAT "sship:" peel_hit ":" take_n ":ss"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "sship:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n miss_n peel_hit hit admit_n note_msg
  CLEAR_ERR
END

# ship — complete plate + NEEDFILLP + FILLP STRICT alias
SYS EQS op "ship"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "rel" rel_s
  CLEAR_ERR
  SETP "wave" wave_s
  CLEAR_ERR
  SETP "host" host_s
  CLEAR_ERR
  SETP "nope" "ok"
  CLEAR_ERR
  NEEDFILLP tpl
  LET has_n = OK
  LET take_n = FILLP_N
  LET miss_n = FILLP_MISS
  LET body = LAST
  CLEAR_ERR
  SYS CAT "release=" rel_s " wave=" wave_s " host=" host_s " path=/opt/cube/" rel_s "/bin miss=ok tag=" wave_s
  LET row = LAST
  CLEAR_ERR
  SYS EQS body row
  LET peel_hit = LAST_N
  CLEAR_ERR
  FILLP STRICT tpl
  LET load_hit = OK
  LET out = LAST
  CLEAR_ERR
  SYS EQS out body
  LET admit_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF miss_n == 0 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF admit_n == 1 THEN
            LET hit = 1
            LET note_msg = "ship ok"
            SYS WRITE out_file body
            CLEAR_ERR
            INCLUDE plate_save
            CLEAR_ERR
          ELSE
            LET miss = 1
            LET note_msg = "ship strict body"
            FAIL "ship strict body"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "ship strict"
          FAIL "ship strict"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "ship body"
        FAIL "ship body"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "ship miss"
      FAIL "ship miss"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "ship needfillp"
    FAIL "ship needfillp"
    CLEAR_ERR
  END
  # prefix nship: not substring of softship/sship
  SYS CAT "nship:" take_n ":" miss_n ":sh"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "nship:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n miss_n peel_hit admit_n note_msg
  CLEAR_ERR
END

# alias — SUBSTPLATE soft twin
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "rel" rel_s
  CLEAR_ERR
  SETP "wave" wave_s
  CLEAR_ERR
  SETP "host" host_s
  CLEAR_ERR
  SETP "nope" "ok"
  CLEAR_ERR
  SUBSTPLATE tpl
  LET body = LAST
  CLEAR_ERR
  FILLP tpl
  LET out = LAST
  CLEAR_ERR
  SYS EQS body out
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET take_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias body"
    FAIL "alias body"
    CLEAR_ERR
  END
  SYS CAT "alias:" peel_hit ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit admit_n note_msg
  CLEAR_ERR
END

# gate — shipped out present + soft FILLP complete
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "rel" rel_s
  CLEAR_ERR
  SETP "wave" wave_s
  CLEAR_ERR
  SETP "host" host_s
  CLEAR_ERR
  SETP "nope" "ok"
  CLEAR_ERR
  FILLPKEYS tpl
  LET keys_n = LAST_N
  CLEAR_ERR
  FILLP tpl
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "miss=ok"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS READ OR out_file OR ""
  LET out = LAST
  CLEAR_ERR
  SYS BLANK out
  LET load_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF keys_n == 4 THEN
      IF load_hit == 0 THEN
        SYS HAS out "release="
        LET has_n = LAST_N
        CLEAR_ERR
        IF has_n == 1 THEN
          LET hit = 1
          LET note_msg = "gate ok"
          LET admit_n = 1
          LET take_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "gate out body"
          FAIL "gate out body"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate no out"
        FAIL "gate no out"
        CLEAR_ERR
        IF require_hit > 0 THEN
          EXIT 2 "gate no out"
        END
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate keys"
      FAIL "gate keys"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate fill miss"
    FAIL "gate fill miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate miss"
    END
  END
  SYS CAT "gate:" peel_hit ":" keys_n ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keys_n peel_hit has_n load_hit note_msg
  CLEAR_ERR
END

# soft — empty bag soft miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — empty plate soft; empty-string key is hit; incomplete brace
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE = "{}"
  CLEAR_ERR
  FILLP "x={{rel}} y={{wave}}"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "x= y="
  LET has_n = LAST_N
  CLEAR_ERR
  # empty-string present is hit (not miss) — capture LAST before CLEAR_ERR
  SETP "rel" ""
  CLEAR_ERR
  FILLP "z={{rel}}"
  LET row = LAST
  LET miss_n = FILLP_MISS
  CLEAR_ERR
  SYS EQS row "z="
  LET load_hit = LAST_N
  CLEAR_ERR
  # incomplete brace left literal
  FILLP "lit={{wave"
  LET out = LAST
  CLEAR_ERR
  SYS HAS out "{{wave"
  LET admit_n = LAST_N
  CLEAR_ERR
  # empty-str key must not count as FILLP_MISS
  IF miss_n != 0 THEN
    LET load_hit = 0
  END
  IF has_n == 1 THEN
    IF load_hit == 1 THEN
      IF admit_n == 1 THEN
        LET hit = 1
        LET note_msg = "probe ok"
        LET out = body
        LET take_n = 1
        LET peel_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "probe brace"
        FAIL "probe brace"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe emptystr"
      FAIL "probe emptystr"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe body"
    FAIL "probe body"
    CLEAR_ERR
  END
  PRINT_JSON has_n load_hit admit_n peel_hit take_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.deploy_manifest_needfillp_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "admit"
LET row = LAST
SYS STR admit_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "plate"
LET row = LAST
SYS PUSH row plate_file
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "dmnf op=" op " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n miss_n keys_n created load_hit peel_hit p_src note_msg
