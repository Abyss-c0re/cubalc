# svc_argv_navigate_board.cubalc — FINDARG/AFTERARG/FIRSTARG fleet argv navigation
#
# Real use: fleet agents locate exact argv tokens (subcmd/flags), peel the
# following payload, and inventory ends without NTHARG+ARGC glue or RESTPOS
# hop math. First realworld of 1371 FINDARG + 1372 AFTERARG + 1373 FIRSTARG
# (1.15.823+).
#
#   FINDARG|ARGINDEX token → index · FINDARG_HIT · LAST_N=-1 on miss
#   AFTERARG|NEXTARG token [OR def] → next value · AFTERARG_FROM/N
#   FIRSTARG|HEADARG · LASTARG|TAILARG ends · OR miss LAST_N hit-shuttle
#   exact token only (--from ≠ --from=val)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_avn_$$
#   ./out/cubalc run programs/realworld/svc_argv_navigate_board.cubalc boot
#   ./out/cubalc run ... find|after|ends|miss|runbook|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt AVN_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_AVN_REQUIRE
#
# Edges: CUBALC_ARG* via SYS ENV SET only (W1); FINDARG miss LAST_N=-1;
#   AFTERARG exact only; OR LAST_N=0; PRINT clobber; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_argv_navigate_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_argv_navigate -- boot|find|after|ends|miss|runbook|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_AVN_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "AVN_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET flag_n = 0
LET rest_n = 0
LET peel_s = ""
LET hit_n = 0
LET from_n = 0
LET idx_n = 0

ONEOF ACTION "boot", "find", "after", "ends", "miss", "runbook", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "find" THEN
    LET op = "find"
  WHEN "after" THEN
    LET op = "after"
  WHEN "ends" THEN
    LET op = "ends"
  WHEN "miss" THEN
    LET op = "miss"
  WHEN "runbook" THEN
    LET op = "runbook"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-avn\",\"schema\":\"cubalc.svc_argv_navigate.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"argv_nav\",\"label\":\"avn\",\"cfg\":{\"surface\":\"FINDARG,ARGINDEX,AFTERARG,NEXTARG,FIRSTARG,LASTARG,HEADARG,TAILARG\",\"contract\":\"exact token→index + after peel + ends\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"argv_nav\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-avn"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_argv_navigate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "avn"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "argv_nav"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FINDARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# find — FINDARG/ARGINDEX exact token → index
SYS EQS op "find"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "seal"
  SYS ENV SET CUBALC_ARG2 "out.bin"
  SYS ENV SET CUBALC_ARGC "3"
  FINDARG "--verbose"
  LET hit_n = FINDARG_HIT
  LET idx_n = FINDARG_N
  LET sum_v = LAST_N
  LET peel_s = LAST
  CLEAR_ERR
  IF hit_n == 1 THEN
    LET score = score + 1
  END
  IF idx_n == 0 THEN
    LET score = score + 1
  END
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "--verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FINDARG "seal"
  IF FINDARG_HIT == 1 THEN
    LET score = score + 1
  END
  IF FINDARG_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FINDARG "out.bin"
  IF LAST_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend: job ≠ --job style
  FINDARG "verbose"
  IF FINDARG_HIT == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ARGINDEX "seal"
  IF FINDARG_HIT == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # first match wins on duplicates
  SYS ENV SET CUBALC_ARG0 "x"
  SYS ENV SET CUBALC_ARG1 "y"
  SYS ENV SET CUBALC_ARG2 "x"
  SYS ENV SET CUBALC_ARGC "3"
  FINDARG "x"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FINDARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGINDEX"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "find ok"
    LET admit_n = 1
    LET find_n = idx_n
  ELSE
    LET miss = 1
    LET note_msg = "find score"
    FAIL "find score"
    CLEAR_ERR
  END
  SYS CAT "find:" score ":fd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "find:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# after — AFTERARG/NEXTARG peel following exact token
SYS EQS op "after"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "--out"
  SYS ENV SET CUBALC_ARG2 "report.json"
  SYS ENV SET CUBALC_ARG3 "extra.bin"
  SYS ENV SET CUBALC_ARGC "4"
  AFTERARG "--out"
  LET peel_s = LAST
  LET hit_n = AFTERARG_HIT
  LET from_n = AFTERARG_FROM
  LET idx_n = AFTERARG_N
  CLEAR_ERR
  IF hit_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "report.json"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF from_n == 1 THEN
    LET score = score + 1
  END
  IF idx_n == 2 THEN
    LET score = score + 1
  END
  NEXTARG "--verbose"
  LET peel_s = LAST
  CLEAR_ERR
  SYS EQS peel_s "--out"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # exact: bare --from fails on --from=shardA form
  SYS ENV SET CUBALC_ARG0 "--from=shardA"
  SYS ENV SET CUBALC_ARG1 "file.bin"
  SYS ENV SET CUBALC_ARGC "2"
  AFTERARG "--from"
  IF AFTERARG_HIT == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERARG "--from=shardA"
  LET peel_s = LAST
  CLEAR_ERR
  IF AFTERARG_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "file.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # space form works
  SYS ENV SET CUBALC_ARG0 "--from"
  SYS ENV SET CUBALC_ARG1 "shardB"
  SYS ENV SET CUBALC_ARGC "2"
  AFTERARG "--from"
  SYS EQS LAST "shardB"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "AFTERARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEXTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "after"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "after ok"
    LET admit_n = 1
    LET find_n = from_n
  ELSE
    LET miss = 1
    LET note_msg = "after score"
    FAIL "after score"
    CLEAR_ERR
  END
  SYS CAT "after:" score ":af"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "after:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# ends — FIRSTARG/LASTARG/HEADARG/TAILARG
SYS EQS op "ends"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "mid.txt"
  SYS ENV SET CUBALC_ARG2 "tail.bin"
  SYS ENV SET CUBALC_ARGC "3"
  FIRSTARG
  LET peel_s = LAST
  CLEAR_ERR
  IF FIRSTARG_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "--verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF FIRSTARG_N == 0 THEN
    LET score = score + 1
  END
  LASTARG
  LET peel_s = LAST
  CLEAR_ERR
  IF LASTARG_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "tail.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF LASTARG_N == 2 THEN
    LET score = score + 1
  END
  HEADARG
  SYS EQS LAST "--verbose"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TAILARG
  SYS EQS LAST "tail.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # single arg both ends
  SYS ENV SET CUBALC_ARG0 "only"
  SYS ENV SET CUBALC_ARGC "1"
  FIRSTARG
  SYS EQS LAST "only"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LASTARG
  SYS EQS LAST "only"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FIRSTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "LASTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "ends ok"
    LET admit_n = 1
    LET find_n = 2
  ELSE
    LET miss = 1
    LET note_msg = "ends score"
    FAIL "ends score"
    CLEAR_ERR
  END
  SYS CAT "ends:" score ":en"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "ends:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# miss — soft OOR · LAST_N=-1 · OR fallbacks
SYS EQS op "miss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  FINDARG "seal"
  LET hit_n = FINDARG_HIT
  LET sum_v = LAST_N
  CLEAR_ERR
  IF hit_n == 0 THEN
    LET score = score + 1
  END
  # miss index is -1 (unusual LAST_N)
  IF sum_v == -1 THEN
    LET score = score + 1
  END
  IF OK == 0 THEN
    LET score = score + 1
  END
  AFTERARG "--out"
  IF AFTERARG_HIT == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF AFTERARG_FROM == -1 THEN
    LET score = score + 1
  END
  AFTERARG "--out" OR "default.txt"
  LET sum_n = LAST_N
  LET peel_s = LAST
  CLEAR_ERR
  IF AFTERARG_HIT == 0 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "default.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # OR LAST_N hit-shuttle 0
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  FIRSTARG OR "help"
  LET peel_s = LAST
  CLEAR_ERR
  IF FIRSTARG_HIT == 0 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "help"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # token present but no following
  SYS ENV SET CUBALC_ARG0 "seal"
  SYS ENV SET CUBALC_ARGC "1"
  AFTERARG "seal" OR "none"
  LET peel_s = LAST
  CLEAR_ERR
  IF AFTERARG_HIT == 0 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "none"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "exact"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "avn"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 12 THEN
    LET hit = 1
    LET note_msg = "miss ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "miss score"
    FAIL "miss score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE miss denied"
    END
  END
  SYS CAT "miss:" score ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "miss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# runbook — tool --v run script.cubalc pattern (AFTERARG run → script)
SYS EQS op "runbook"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--v"
  SYS ENV SET CUBALC_ARG1 "run"
  SYS ENV SET CUBALC_ARG2 "script.cubalc"
  SYS ENV SET CUBALC_ARGC "3"
  FINDARG "run"
  IF FINDARG_HIT == 1 THEN
    LET score = score + 1
  END
  IF FINDARG_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERARG "run"
  LET peel_s = LAST
  CLEAR_ERR
  IF AFTERARG_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS peel_s "script.cubalc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF AFTERARG_FROM == 1 THEN
    LET score = score + 1
  END
  IF AFTERARG_N == 2 THEN
    LET score = score + 1
  END
  FIRSTARG
  SYS EQS LAST "--v"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LASTARG
  SYS EQS LAST "script.cubalc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # chain FINDARG+NTHARG for next after seal
  SYS ENV SET CUBALC_ARG0 "--verbose"
  SYS ENV SET CUBALC_ARG1 "seal"
  SYS ENV SET CUBALC_ARG2 "out.bin"
  SYS ENV SET CUBALC_ARGC "3"
  FINDARG "seal"
  IF FINDARG_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NTHARG 2
  SYS EQS LAST "out.bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "AFTERARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "argv_nav"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "runbook ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "runbook score"
    FAIL "runbook score"
    CLEAR_ERR
  END
  SYS CAT "runbook:" score ":rb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "runbook:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM / RELATED
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORM "FINDARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "ARGINDEX"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "AFTERARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEXTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "FIRSTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "LASTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RELATED "FINDARG"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "NTHARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  RELATED "AFTERARG"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "FINDARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HEADARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "argv_navigate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live hop peel
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--job"
  SYS ENV SET CUBALC_ARG1 "ingest"
  SYS ENV SET CUBALC_ARG2 "--from"
  SYS ENV SET CUBALC_ARG3 "shardA"
  SYS ENV SET CUBALC_ARGC "4"
  FINDARG "--from"
  IF FINDARG_HIT == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERARG "--from"
  SYS EQS LAST "shardA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERARG "--job"
  SYS EQS LAST "ingest"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LASTARG
  SYS EQS LAST "shardA"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FINDARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "AFTERARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FIRSTARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "argv_nav"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "argv_navigate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · capture knobs
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "run"
  SYS ENV SET CUBALC_ARG1 "job.cubalc"
  SYS ENV SET CUBALC_ARGC "2"
  AFTERARG "run"
  LET peel_s = LAST
  LET hit_n = AFTERARG_HIT
  CLEAR_ERR
  PRINT "probe-mark"
  CLEAR_ERR
  SYS EQS LAST "job.cubalc"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS peel_s "job.cubalc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_n == 1 THEN
    LET score = score + 1
  END
  FINDARG "run"
  LET idx_n = FINDARG_N
  CLEAR_ERR
  IF idx_n == 0 THEN
    LET score = score + 1
  END
  LASTARG
  LET stem_s = LAST
  CLEAR_ERR
  SYS EQS stem_s "job.cubalc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "argv_navigate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TAILARG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "token"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "argv_nav"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "avn"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = idx_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:1:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " peel=" peel_s " idx=" idx_n " from=" from_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "avn report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
