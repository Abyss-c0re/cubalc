# svc_start_formguide_board.cubalc — START onboard + FORMGUIDE form playbook
#
# Real use: fleet agents cold-start with START/ONBOARD/WELCOME (topics +
# next-step bag), then FORMGUIDE a form into docs+covering topics+first
# GUIDE playbook without cookbook scrape. First realworld of proofs
# 1344 FORMGUIDE + 1345 START/ONBOARD.
#
#   START|ONBOARD|WELCOME → cubalc.start.v1 · START_TOPICS_N · START_NEXT
#   FORMGUIDE|GUIDEFORM form → FORMGUIDE_OF · FORMGUIDE_TOPIC · formguide.v1
#   soft miss · quoted FORMHINT · chain START→GUIDE general
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ssf_$$
#   ./out/cubalc run programs/realworld/svc_start_formguide_board.cubalc boot
#   ./out/cubalc run ... start|form|chain|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SSF_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SSF_REQUIRE
#
# Edges: PRINT clobber START/FORMGUIDE JSON; FORMGUIDE "FORMHINT" quotes;
#   CLI next_n skew; WRITE NL; soft miss empty name

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_start_formguide_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_start_formguide -- boot|start|form|chain|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SSF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SSF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET next_n = 0
LET topics_n = 0
LET topic_got = ""

ONEOF ACTION "boot", "start", "form", "chain", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "start" THEN
    LET op = "start"
  WHEN "form" THEN
    LET op = "form"
  WHEN "chain" THEN
    LET op = "chain"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-startfg\",\"schema\":\"cubalc.svc_start_formguide.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"onboard\",\"label\":\"startfg\",\"cfg\":{\"surface\":\"START,ONBOARD,FORMGUIDE\",\"form\":\"SETP\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"onboard\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-startfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_start_formguide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "startfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "onboard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "START"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# start — START onboard plate (capture before PRINT)
SYS EQS op "start"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  START
  LET body = LAST
  LET topics_n = START_TOPICS_N
  LET next_n = START_NEXT_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF topics_n == 8 THEN
    LET score = score + 1
  END
  IF next_n >= 8 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.start.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET N = START_NEXT
  SYS HASI N "cubalc doctor"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI N "INCLUDE agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI N "cubalc guide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "START"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "start ok"
    LET admit_n = 1
    LET find_n = next_n
  ELSE
    LET miss = 1
    LET note_msg = "start score"
    FAIL "start score"
    CLEAR_ERR
  END
  SYS CAT "start:" next_n ":st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "start:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n next_n score note_msg
  CLEAR_ERR
END

# form — FORMGUIDE form→docs+topics+playbook
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.form"
  LET stem_s = LAST
  CLEAR_ERR
  FORMGUIDE stem_s
  LET body = LAST
  LET topic_got = FORMGUIDE_TOPIC
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS FORMGUIDE_OF "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "cubalc.formguide.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF GUIDE_RELATED_N >= 3 THEN
    LET score = score + 1
  END
  FORMGUIDE HASFORM
  LET topic_got = FORMGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMGUIDE INCLUDE
  LET topic_got = FORMGUIDE_TOPIC
  LET sum_n = FORMTOPICS_N
  CLEAR_ERR
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  # quoted FORMHINT
  FORMGUIDE "FORMHINT"
  LET topic_got = FORMGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = sum_n
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" topic_got ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topic_got score note_msg
  CLEAR_ERR
END

# chain — START then GUIDE general
SYS EQS op "chain"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  START
  LET topics_n = START_TOPICS_N
  LET next_n = START_NEXT_N
  CLEAR_ERR
  IF topics_n == 8 THEN
    LET score = score + 1
  END
  GUIDE general
  LET topic_got = TOPIC_NAME
  LET sum_n = GUIDE_RELATED_N
  LET body = LAST
  CLEAR_ERR
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sum_n >= 3 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.guide.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # formguide → plate playbook
  FORMGUIDE SETP
  LET topic_got = FORMGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "onboard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.form"
  SYS EQS LAST "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "start_formguide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "chain ok"
    LET admit_n = 1
    LET find_n = next_n
  ELSE
    LET miss = 1
    LET note_msg = "chain score"
    FAIL "chain score"
    CLEAR_ERR
  END
  SYS CAT "chain:" next_n ":ch"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "chain:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n next_n score note_msg
  CLEAR_ERR
END

# soft — FORMGUIDE miss
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FORMGUIDE ZZZ_NO_SUCH
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  FORMGUIDE
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  # START always succeeds
  START
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-startfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "startfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "onboard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate surface + live START
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  START
  LET topics_n = START_TOPICS_N
  LET next_n = START_NEXT_N
  CLEAR_ERR
  IF topics_n == 8 THEN
    LET score = score + 1
  END
  IF next_n >= 8 THEN
    LET score = score + 1
  END
  FORMGUIDE SETP
  LET topic_got = FORMGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "START"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ONBOARD"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "start_formguide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = next_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n next_n score note_msg
  CLEAR_ERR
END

# alias — ONBOARD / WELCOME / GUIDEFORM
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  ONBOARD
  LET topics_n = START_TOPICS_N
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  IF topics_n == 8 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  WELCOME
  LET next_n = START_NEXT_N
  CLEAR_ERR
  IF next_n >= 8 THEN
    LET score = score + 1
  END
  GUIDEFORM SETP
  LET topic_got = FORMGUIDE_TOPIC
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "startfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.form"
  SYS EQS LAST "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = next_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topics_n next_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + STATUS multi-topic
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  START
  LET body = LAST
  LET next_n = START_NEXT_N
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASI stem_s "cubalc.start.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI LAST "cubalc.start.v1"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FORMGUIDE STATUS
  LET sum_n = FORMTOPICS_N
  LET body = LAST
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASI body "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET N = START_NEXT
  SYS HASI N "cubalc formguide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF next_n >= 8 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "start_formguide"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FORMGUIDE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = next_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" next_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n next_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_start_formguide.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " topics_n=" topics_n " next_n=" next_n " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_start_formguide_board: done"
PASS
