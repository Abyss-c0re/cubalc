# logtree_count_harvest_board.cubalc — COUNTINTREE + GREPLINESTREE log rollup
#
# Real use: SRE agents tally error/severity occurrences across nested log trees
# then harvest matching lines for digests without shell grep -rc / grep -rn:
#   COUNTINTREE / COUNTTREE — recursive occurrence tally (1037)
#   COUNTINTREEI — case-insensitive count
#   GREPLINESTREE / HARVESTTREE — recursive matching-line harvest (1038)
#   GREPLINESTREEI — case-insensitive harvest
#   WRITEOUT — seed nested multi-line logs
#
# First realworld COUNTINTREE + GREPLINESTREE board. Distinct from
# greptree_scrub (path hits only) and log_line_harvest (single-file GREP).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_lch_$$
#   ./out/cubalc run programs/realworld/logtree_count_harvest_board.cubalc \
#     seed -- --root=/tmp/lch/logs
#   ./out/cubalc run ... count -- --root=... error
#   ./out/cubalc run ... harvest -- --root=... error
#
# Plate: STATUS.txt VAL.txt META.txt LCH_REPORT.txt
# Env: LOG_ROOT CUBALC_LCH_REQUIRE CUBALC_LCH_MIN CUBALC_LCH_MAXC
#
# Edges:
#   COUNTINTREE N/FILES; zero match OK=1; empty needle 0; missing soft
#   GREPLINESTREE N/FILES line bag; substring false friends; icase
#   lean VARS (W81); WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "logtree_count_harvest_board: start"
DEFAULT ACTION = "list"
DEFAULT MIN = 1
DEFAULT MAXC = 0
DEFAULT USAGE_LINE = "logtree_count_harvest -- seed|count|counti|harvest|harvesti|list -- [--root=D] [needle]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "logs/tree"
LET root_dir = LAST
CLEAR_ERR

GETFLAGOUT root|r OR ENV LOG_ROOT OR root_dir
LET root_dir = LAST
LET r_src = GETFLAGOUT_SRC
LET r_ok = OK
CLEAR_ERR

LET needle = "error"
IF has_rest == 1 THEN
  SYS NTH 0 targets
  LET needle = LAST
END
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_LCH_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
SYS ENV "CUBALC_LCH_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN = LAST_N
  END
END
SYS ENV "CUBALC_LCH_MAXC" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MAXC = LAST_N
  END
END

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "LCH_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET count_n = 0
LET files_n = 0
LET line_n = 0
LET row = ""
LET lines = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "seed", "count", "counti", "harvest", "harvesti", "list", "ls", "drop", "has", "gate", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "seed" THEN
    LET op = "seed"
  WHEN "count" THEN
    LET op = "count"
  WHEN "counti" THEN
    LET op = "counti"
  WHEN "harvest" THEN
    LET op = "harvest"
  WHEN "harvesti" THEN
    LET op = "harvesti"
  WHEN "drop" THEN
    LET op = "drop"
  WHEN "has" THEN
    LET op = "has"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n r_src
  CLEAR_ERR
END

SYS EQS op "seed"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "seed needs root"
    FAIL "seed needs root"
    CLEAR_ERR
  ELSE
    SYS JOIN root_dir "a/err.log"
    WRITEOUT LAST "ok start\nerror: boom\nerror: again\nok end"
    EXPECT OK == 1
    IF OK == 0 THEN
      EXIT 2 "seed write failed"
    END
    CLEAR_ERR
    SYS JOIN root_dir "a/b/note.txt"
    WRITEOUT LAST "all good\nno problem"
    CLEAR_ERR
    SYS JOIN root_dir "a/b/warn.log"
    WRITEOUT LAST "info\nWARNING: careful\ninfo"
    CLEAR_ERR
    SYS JOIN root_dir "plain.txt"
    WRITEOUT LAST "nothing here"
    CLEAR_ERR
    SYS JOIN root_dir "empty"
    SYS MKDIR LAST
    CLEAR_ERR
    SYS CAT "seed:"
    LET row = LAST
    SYS CAT row root_dir
    LET row = LAST
    SYS CAT row ":ok"
    LET row = LAST
    SYS GREPV "seed:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "seed ok"
  END
  PRINT_JSON admit_n bag_n r_src
  CLEAR_ERR
END

SYS EQS op "count"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "count needs root"
    FAIL "count needs root"
    CLEAR_ERR
  ELSE
    COUNTINTREE root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "count soft miss"
      FAIL "count soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "count failed"
      END
    ELSE
      LET count_n = COUNTINTREE
      LET files_n = COUNTINTREE_FILES
      CLEAR_ERR
      IF MAXC > 0 THEN
        IF count_n > MAXC THEN
          LET miss = 1
          LET note_msg = "count over budget"
          FAIL "count over budget"
          CLEAR_ERR
          IF require_hit > 0 THEN
            EXIT 2 "count over budget"
          END
        ELSE
          LET hit = 1
          LET note_msg = "count ok"
        END
      ELSE
        LET hit = 1
        LET note_msg = "count ok"
      END
      IF hit == 1 THEN
        SYS CAT "count:"
        LET row = LAST
        SYS CAT row needle
        LET row = LAST
        SYS CAT row ":"
        LET row = LAST
        SYS STR count_n
        SYS CAT row LAST
        LET row = LAST
        SYS CAT row ":"
        LET row = LAST
        SYS STR files_n
        SYS CAT row LAST
        LET row = LAST
        SYS CAT row ":ct"
        LET row = LAST
        SYS GREPV "count:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
        LET admit_n = 1
        SYS LINES bag
        LET bag_n = LAST_N
      END
    END
  END
  PRINT_JSON admit_n bag_n count_n files_n r_src
  CLEAR_ERR
END

SYS EQS op "counti"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "counti needs root"
    FAIL "counti needs root"
    CLEAR_ERR
  ELSE
    COUNTINTREEI root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "counti soft miss"
      FAIL "counti soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "counti failed"
      END
    ELSE
      LET count_n = COUNTINTREE
      LET files_n = COUNTINTREE_FILES
      CLEAR_ERR
      SYS CAT "counti:"
      LET row = LAST
      SYS CAT row needle
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR count_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":cti"
      LET row = LAST
      SYS GREPV "counti:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      LET hit = 1
      LET note_msg = "counti ok"
    END
  END
  PRINT_JSON admit_n bag_n count_n files_n
  CLEAR_ERR
END

SYS EQS op "harvest"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "harvest needs root"
    FAIL "harvest needs root"
    CLEAR_ERR
  ELSE
    GREPLINESTREE root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "harvest soft miss"
      FAIL "harvest soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "harvest failed"
      END
    ELSE
      LET line_n = GREPLINESTREE_N
      LET files_n = GREPLINESTREE_FILES
      LET lines = LAST
      CLEAR_ERR
      SYS CAT "harvest:"
      LET row = LAST
      SYS CAT row needle
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR line_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR files_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":hl"
      LET row = LAST
      SYS GREPV "harvest:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      IF line_n > 0 THEN
        LET hit = 1
        LET note_msg = "harvest hits"
      ELSE
        LET miss = 1
        LET note_msg = "harvest empty"
        FAIL "harvest empty"
        CLEAR_ERR
        IF require_hit > 0 THEN
          EXIT 2 "harvest empty"
        END
      END
    END
  END
  PRINT_JSON admit_n bag_n line_n files_n r_src
  CLEAR_ERR
END

SYS EQS op "harvesti"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "harvesti needs root"
    FAIL "harvesti needs root"
    CLEAR_ERR
  ELSE
    GREPLINESTREEI root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "harvesti soft miss"
      FAIL "harvesti soft miss"
      CLEAR_ERR
    ELSE
      LET line_n = GREPLINESTREE_N
      LET files_n = GREPLINESTREE_FILES
      LET lines = LAST
      CLEAR_ERR
      SYS CAT "harvesti:"
      LET row = LAST
      SYS CAT row needle
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR line_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":hli"
      LET row = LAST
      SYS GREPV "harvesti:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      IF line_n > 0 THEN
        LET hit = 1
        LET note_msg = "harvesti hits"
      ELSE
        LET miss = 1
        LET note_msg = "harvesti empty"
        FAIL "harvesti empty"
        CLEAR_ERR
      END
    END
  END
  PRINT_JSON admit_n bag_n line_n files_n
  CLEAR_ERR
END

SYS EQS op "drop"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "drop needs key"
    FAIL "drop needs key"
    CLEAR_ERR
  ELSE
    SYS NTH 0 targets
    LET row = LAST
    SYS CAT row ":"
    SYS GREPV LAST bag
    LET bag = LAST
    CLEAR_ERR
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "drop ok"
  END
  PRINT_JSON admit_n bag_n
  CLEAR_ERR
END

SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  SYS NTH 0 targets
  LET row = LAST
  SYS BLANK row
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "has needs key"
    FAIL "has needs key"
    CLEAR_ERR
  ELSE
    SYS CAT row ":"
    SYS GREP LAST bag
    SYS LINES LAST
    LET has_n = LAST_N
    IF has_n > 1 THEN
      LET has_n = 1
    END
    CLEAR_ERR
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "has ok"
    ELSE
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
    END
  END
  PRINT_JSON has_n
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n >= MIN THEN
    LET hit = 1
    LET note_msg = "gate admit"
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    FAIL "gate deny"
    CLEAR_ERR
  END
  PRINT_JSON bag_n MIN hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  COUNTINTREE "" "x"
  LET has_n = OK
  CLEAR_ERR
  GREPLINESTREE "" "x"
  LET admit_n = OK
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  PRINT_JSON has_n admit_n r_src
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
  # also dump harvest lines to VAL when present
  SYS BLANK lines
  IF LAST_N == 0 THEN
    SYS WRITE val_path lines
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.logtree_count_harvest_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "bag_n"
LET row = LAST
SYS STR bag_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "count"
LET row = LAST
SYS STR count_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "lines"
LET row = LAST
SYS STR line_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE report_path row
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
SYS WRITE meta_path row
CLEAR_ERR

NOTE "logtree_count_harvest_board: done"
PRINT_JSON hit miss bag_n count_n files_n line_n r_src note_msg
EXIT 0
