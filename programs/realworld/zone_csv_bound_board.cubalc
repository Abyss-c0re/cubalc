# zone_csv_bound_board.cubalc — GETFLAGCSV zones + FLOORN/CAPN pool capacity
#
# Real use: fleet/capacity agents pin comma-or-multi zone labels on pools and
# raise/lower replica floors/caps without shell getopt or dual-sided CLAMPN:
#   GETFLAGCSV zone|zones|z — --zones=a,b + multi --zone c (1006)
#   GETFLAGN replicas|r OR ENV REPLICAS OR 3
#   FLOORN then CAPN — one-sided bounds (1007), not CLAMPN
#   SUBCMD + RESTPOS / HASRESTPOS — verb then pool ids
#   SYS GREPV + JOINLINES — upsert without nested EACH
#
# First realworld GETFLAGCSV + FLOORN/CAPN board.
# Distinct from tag_multiflag_env (GETFLAGALL) and rate_clampn (CLAMPN both sides).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_zcb_$$
#   export ZONES=eu,us REPLICAS=2
#   ./out/cubalc run programs/realworld/zone_csv_bound_board.cubalc \
#     pin -- --zones=canary,eu --zone=apac --replicas=100 pool-a pool-b
#
# Plate: POOLS.txt VAL.txt META.txt ZCB_REPORT.txt
# Subcmds: list|ls pin drop has gate soft clear probe
# Env: ZONES REPLICAS CUBALC_ZCB_REQUIRE CUBALC_ZCB_MIN
#
# Edges:
#   GETFLAGCSV multi+comma+trim; CLI>ENV>default; zone|zones|z aliases
#   FLOORN 0→1; CAPN 100→16; mid-band unchanged
#   W47 lean LET; no WORKERS name (W50); GREPV upsert
#   HASRESTPOS soft; REQUIRE RESTPOS often exit 0; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "zone_csv_bound_board: start"
DEFAULT ACTION = "list"
DEFAULT TFILE = "POOLS.txt"
DEFAULT VFILE = "VAL.txt"
DEFAULT MFILE = "META.txt"
DEFAULT REPORT = "ZCB_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT MIN = 1
DEFAULT USAGE_LINE = "zone_csv_bound -- pin|list|drop -- [--zones=a,b] [--zone x] [--replicas=N] pool..."
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

GETFLAGCSV zone|zones|z OR ENV ZONES OR "default"
LET zones = LAST
LET zone_n = LAST_N
LET z_src = GETFLAGCSV_SRC
CLEAR_ERR

GETFLAGN replicas|r OR ENV REPLICAS OR 3
LET rcount = LAST_N
LET r_src = GETFLAGN_SRC
CLEAR_ERR

# one-sided: floor 1 then cap 16
FLOORN rcount 1
LET rcount = LAST_N
CLEAR_ERR
CAPN rcount 16
LET rcount = LAST_N
CLEAR_ERR

SYS ENV "CUBALC_ZCB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_ZCB_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir TFILE
LET pools_path = LAST
SYS JOIN state_dir VFILE
LET val_path = LAST
SYS JOIN state_dir MFILE
LET meta_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR pools_path OR ""
LET bag = LAST
CLEAR_ERR

SYS JOINLINES "|" zones
LET zone_join = LAST
CLEAR_ERR

LET row = ""
LET pref = ""
LET hit = 0
LET miss = 0
LET val_ch = 0
LET meta_ch = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET val = ""
LET meta = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "pin", "list", "ls", "drop", "has", "gate", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "pin" THEN
    LET op = "pin"
  WHEN "drop" THEN
    LET op = "drop"
  WHEN "has" THEN
    LET op = "has"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "bag_n"
  SYS STR bag_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON bag_n zone_n rcount z_src r_src
  CLEAR_ERR
END

SYS EQS op "pin"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "pin needs pools"
    FAIL "pin needs pools"
    CLEAR_ERR
    LET val = USAGE
    LET val_ch = 1
    IF REQUIRE_HIT > 0 THEN
      REQUIRE RESTPOS 1
    END
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pin needs pools"
    END
  ELSE
    EACH LINE AS tid IN targets
      SYS BLANK tid
      IF LAST_N == 0 THEN
        SYS CAT tid ":"
        LET pref = LAST
        SYS GREPV pref bag
        LET bag = LAST
        CLEAR_ERR
        SYS CAT tid ":"
        LET row = LAST
        SYS CAT row zone_join
        LET row = LAST
        SYS CAT row ":"
        LET row = LAST
        SYS STR rcount
        SYS CAT row LAST
        LET row = LAST
        SYS CAT row ":live"
        LET row = LAST
        SYS PUSH bag row
        LET bag = LAST
        LET admit_n = admit_n + 1
      END
    END
    LET bag_ch = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "pin ok"
    LET val = bag
    LET val_ch = 1
    LET meta = "admit"
    SYS STR admit_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta zone_join
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON admit_n bag_n zone_n rcount z_src r_src
  CLEAR_ERR
END

SYS EQS op "drop"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "drop needs pools"
    FAIL "drop needs pools"
    CLEAR_ERR
  ELSE
    EACH LINE AS tid IN targets
      SYS BLANK tid
      IF LAST_N == 0 THEN
        SYS CAT tid ":"
        LET pref = LAST
        SYS GREPV pref bag
        LET bag = LAST
        LET admit_n = admit_n + 1
        CLEAR_ERR
      END
    END
    LET bag_ch = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "drop ok"
    LET val = bag
    LET val_ch = 1
    LET meta = "drop"
    SYS STR admit_n
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON admit_n bag_n
  CLEAR_ERR
END

SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  SYS NTH 0 targets
  LET pref = LAST
  SYS BLANK pref
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "has needs name"
    FAIL "has needs name"
    CLEAR_ERR
  ELSE
    SYS CAT pref ":"
    SYS GREP LAST bag
    SYS LINES LAST
    LET has_n = LAST_N
    IF has_n > 1 THEN
      LET has_n = 1
    END
    CLEAR_ERR
    LET val = pref
    LET val_ch = 1
    LET meta = "has"
    SYS STR has_n
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "has ok"
    ELSE
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
    END
  END
  PRINT_JSON has_n
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  SYS STR bag_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "gate"
  LET meta_ch = 1
  IF bag_n >= MIN THEN
    LET hit = 1
    LET note_msg = "gate admit"
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    FAIL "gate deny"
    CLEAR_ERR
  END
  PRINT_JSON bag_n MIN hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    LET val = ""
    LET val_ch = 1
    LET meta = "soft"
    LET meta_ch = 1
  ELSE
    LET hit = 1
    LET note_msg = "soft has pools"
    LET val = bag
    LET val_ch = 1
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  FLOORN 0 1
  LET admit_n = LAST_N
  CLEAR_ERR
  CAPN 100 16
  LET has_n = LAST_N
  CLEAR_ERR
  FLOORN 5 1
  LET bag_n = LAST_N
  CLEAR_ERR
  CAPN 8 16
  LET zone_n = LAST_N
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  SYS STR admit_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "probe"
  SYS STR admit_n
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR has_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON admit_n has_n bag_n zone_n z_src r_src
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET val = ""
  LET meta = ""
  LET bag_ch = 1
  LET val_ch = 1
  LET meta_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE pools_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "pools write failed"
  END
  CLEAR_ERR
END
IF val_ch > 0 THEN
  SYS WRITE val_path val
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "val write failed"
  END
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "meta write failed"
  END
  CLEAR_ERR
END

LET meta = "schema=cubalc.zone_csv_bound_board.v1"
SYS PUSH meta "date"
LET meta = LAST
SYS PUSH meta run_date
LET meta = LAST
SYS PUSH meta "action"
LET meta = LAST
SYS PUSH meta ACTION
LET meta = LAST
SYS PUSH meta "op"
LET meta = LAST
SYS PUSH meta op
LET meta = LAST
SYS PUSH meta "hit"
LET meta = LAST
SYS STR hit
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "miss"
LET meta = LAST
SYS STR miss
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "rcount"
LET meta = LAST
SYS STR rcount
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "zone_n"
LET meta = LAST
SYS STR zone_n
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "z_src"
LET meta = LAST
SYS PUSH meta z_src
LET meta = LAST
SYS PUSH meta "r_src"
LET meta = LAST
SYS PUSH meta r_src
LET meta = LAST
SYS PUSH meta "bag_n"
LET meta = LAST
SYS STR bag_n
SYS PUSH meta LAST
LET meta = LAST
SYS PUSH meta "note"
LET meta = LAST
SYS PUSH meta note_msg
LET meta = LAST

SYS WRITE report_path meta
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END

NOTE "zone_csv_bound_board: done"
PRINT_JSON hit miss bag_n zone_n rcount z_src r_src note_msg
EXIT 0
