# svc_schema_live_ready_board.cubalc — HASFIELDS/HASFIELDANY/HASMETHODANY/HASOBJS preflight
#
# Real use: deploy agents preflight a service unit schema (required fields +
# any-of optional fields/methods) and confirm live worker slots exist before
# SEND — without N× HASFIELD/HASMETHOD/HASOBJ glue.
# First realworld of free-form 1424 HASFIELDS + 1425 HASFIELDANY +
# 1423 HASMETHODANY + 1426 HASOBJS (1.15.880+). Distinct from
# svc_capability_admit (HASCLASSANY+HASMETHODS all-of methods) and
# field_contract / schema_contract (CLASSINFO/METHODINFO).
#
#   HASFIELDS|ALLFIELDS|NEEDFIELDS target fld… · FIELDMISS · FIELD_ON
#   HASFIELDANY|ANYFIELD|NEEDFIELDANY target fld… · FIELDHAVE · FIELDMISS
#   HASMETHODANY|ANYMETHOD|NEEDMETHODANY target meth… · METHODHAVE
#   HASOBJS|ALLOBJS|NEEDOBJS names… · OBJMISS · HASOBJS_N
#   Prefer CSV bags for multi names (W774 keyword collide class)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_slr_$$
#   ./out/cubalc run programs/realworld/svc_schema_live_ready_board.cubalc boot
#   ./out/cubalc run ... pass|soft|fields|any|objs|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SLR_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_SLR_REQUIRE
#
# Edges: CSV bags; soft all-miss; partial OBJMISS; live vs class target;
#   HASFORM lag; CLEAR_ERR LAST; REQUIRE LIB quoted; WRITE NL; PRINT

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

CLASS DeployUnit
  FIELD zone "east"
  FIELD status "idle"
  FIELD load 0
  FIELD ready 0
  METHOD ping
    SETF THIS status "pong"
  END
  METHOD health
    SETF THIS status "ok"
  END
  METHOD deploy
    SETF THIS status "deployed"
  END
END

CLASS DeployStub
  FIELD tag "stub"
  METHOD ping
    SETF THIS tag "pong"
  END
END

NOTE "svc_schema_live_ready_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_schema_live_ready -- boot|pass|soft|fields|any|objs|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SLR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SLR_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET fld_n = 0
LET any_n = 0
LET obj_n = 0
LET have_s = ""
LET miss_s = ""

ONEOF ACTION "boot", "pass", "soft", "fields", "any", "objs", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "fields" THEN
    LET op = "fields"
  WHEN "any" THEN
    LET op = "any"
  WHEN "objs" THEN
    LET op = "objs"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-slr\",\"schema\":\"cubalc.svc_schema_live_ready.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"slr\",\"want_filter\":\"schema_live_ready\",\"cfg\":{\"surface\":\"HASFIELDS,HASFIELDANY,HASMETHODANY,HASOBJS,FIELDMISS,METHODHAVE,OBJMISS\",\"contract\":\"field/method/live-slot preflight before SEND\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  LET need = "zone,status,load"
  HASFIELDS DeployUnit need
  LET fld_n = HASFIELDS_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-slr"
  IF LAST_N == 1 THEN
    IF fld_n == 3 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET score = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot fields"
      FAIL "boot fields"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — full fields + any-of field/method + live objs
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "zone,status,load,ready"
  HASFIELDS DeployUnit need
  LET ok_v = OK
  LET fld_n = HASFIELDS_N
  LET body = FIELD_ON
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF fld_n == 4 THEN
    LET score = score + 1
  END
  SYS EQS body "DeployUnit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost_zz,zone,nope"
  HASFIELDANY DeployUnit opts
  LET ok_v = OK
  LET have_s = FIELDHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "zone"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost_zz,ping,nope"
  HASMETHODANY DeployUnit opts
  LET ok_v = OK
  LET have_s = METHODHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "ping"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW DeployUnit w0
  NEW DeployUnit w1
  CLEAR_ERR
  HASOBJS w0 w1
  LET ok_v = OK
  LET obj_n = HASOBJS_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF obj_n == 2 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "schema_live_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = obj_n
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" obj_n ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score obj_n fld_n note_msg
  CLEAR_ERR
END

# soft — all-miss paths + empty
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "ghost_a,ghost_b"
  HASFIELDS DeployUnit need
  LET ok_v = OK
  LET fld_n = HASFIELDS_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF fld_n == 0 THEN
    LET score = score + 1
  END
  IF FIELDMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFIELDS DeployUnit
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost_a,ghost_b"
  HASFIELDANY DeployUnit opts
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost_a,ghost_b"
  HASMETHODANY DeployUnit opts
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASMETHODANY DeployUnit
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJS ghost_x ghost_y
  LET ok_v = OK
  LET miss_s = OBJMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF OBJMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJS
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# fields — ALLFIELDS alias, partial miss, live target, unknown class
SYS EQS op "fields"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "zone,status,load"
  HASFIELDS DeployUnit need
  LET fld_n = HASFIELDS_N
  CLEAR_ERR
  IF fld_n == 3 THEN
    LET score = score + 1
  END
  ALLFIELDS DeployUnit zone status
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "zone,no_such_zz,status"
  HASFIELDS DeployUnit need
  LET ok_v = OK
  LET fld_n = HASFIELDS_N
  LET miss_s = FIELDMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF fld_n == 2 THEN
    LET score = score + 1
  END
  SYS HASI miss_s "no_such_zz"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW DeployUnit f0
  CLEAR_ERR
  LET need = "zone,ready"
  HASFIELDS f0 need
  LET body = FIELD_ON
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "f0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "zone,status"
  HASFIELDS GhostUnit need
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # DeployStub lacks load/ready
  LET need = "tag,load"
  HASFIELDS DeployStub need
  LET fld_n = HASFIELDS_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET score = score + 1
  END
  IF fld_n == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "fields ok"
    LET admit_n = 1
    LET find_n = fld_n
  ELSE
    LET miss = 1
    LET note_msg = "fields score"
    FAIL "fields score"
    CLEAR_ERR
  END
  SYS CAT "fields:" fld_n ":fd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fields:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fld_n note_msg
  CLEAR_ERR
END

# any — HASFIELDANY + HASMETHODANY aliases + live
SYS EQS op "any"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET opts = "ghost,ready,nope"
  HASFIELDANY DeployUnit opts
  LET ok_v = OK
  LET have_s = FIELDHAVE
  LET any_n = HASFIELDANY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # bare status is STATUS form keyword — truncates field list (W779); use CSV
  LET opts = "zone,status"
  ANYFIELD DeployUnit opts
  LET fld_n = FIELDHAVE_N
  CLEAR_ERR
  IF fld_n == 2 THEN
    LET score = score + 1
  END
  LET opts = "ghost,health,nope"
  HASMETHODANY DeployUnit opts
  LET have_s = METHODHAVE
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "health"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ping,deploy"
  ANYMETHOD DeployUnit opts
  LET any_n = METHODHAVE_N
  CLEAR_ERR
  IF any_n == 2 THEN
    LET score = score + 1
  END

  NEW DeployUnit a0
  CLEAR_ERR
  LET opts = "ghost,load"
  HASFIELDANY a0 opts
  LET body = FIELD_ON
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "a0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost,ping"
  HASMETHODANY a0 opts
  LET body = METHOD_ON
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "a0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "any ok"
    LET admit_n = 1
    LET find_n = any_n
  ELSE
    LET miss = 1
    LET note_msg = "any score"
    FAIL "any score"
    CLEAR_ERR
  END
  SYS CAT "any:" any_n ":an"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score any_n note_msg
  CLEAR_ERR
END

# objs — HASOBJS / ALLOBJS / CSV / partial miss
SYS EQS op "objs"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW DeployUnit s0
  NEW DeployUnit s1
  NEW DeployStub st0
  CLEAR_ERR
  HASOBJS s0 s1
  LET ok_v = OK
  LET obj_n = HASOBJS_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF obj_n == 2 THEN
    LET score = score + 1
  END
  ALLOBJS s0 s1 st0
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJS s0 ghost_zz s1
  LET ok_v = OK
  LET miss_s = OBJMISS
  LET obj_n = HASOBJS_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF obj_n == 2 THEN
    LET score = score + 1
  END
  SYS HASI miss_s "ghost_zz"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "s0,s1"
  HASOBJS need
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "ghost,s0,s1"
  HASOBJS need
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF OBJMISS_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "schema_live_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "objs ok"
    LET admit_n = 1
    LET find_n = obj_n
  ELSE
    LET miss = 1
    LET note_msg = "objs score"
    FAIL "objs score"
    CLEAR_ERR
  END
  SYS CAT "objs:" obj_n ":ob"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "objs:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score obj_n note_msg
  CLEAR_ERR
END

# form — HASFORM catalog lag for new stems
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "HASFIELDS"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "HASFIELDANY"
  LET fld_n = LAST_N
  CLEAR_ERR
  HASFORM "HASMETHODANY"
  LET any_n = LAST_N
  CLEAR_ERR
  HASFORM "HASOBJS"
  LET obj_n = LAST_N
  CLEAR_ERR
  # score presence or document lag either way
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF fld_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF any_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF obj_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "ALLFIELDS"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "ANYFIELD"
  LET fld_n = LAST_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF fld_n == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "ALLOBJS"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "SYS HASFIELDS"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "schema_live_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — schema + any method + live slots + soft recover + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "zone,status,load"
  HASFIELDS DeployUnit need
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost,ping"
  HASMETHODANY DeployUnit opts
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW DeployUnit g0
  NEW DeployUnit g1
  CLEAR_ERR
  HASOBJS g0 g1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss must not block
  HASOBJS ghost_gate
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "nope_a,nope_b"
  HASFIELDS DeployUnit need
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-slr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · CLEAR_ERR LAST · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "zone,status"
  HASFIELDS DeployUnit need
  LET fld_n = HASFIELDS_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF fld_n == 2 THEN
    LET score = score + 1
  END
  LET opts = "ghost,ping"
  HASMETHODANY DeployUnit opts
  LET have_s = METHODHAVE
  CLEAR_ERR
  SYS EQS have_s "ping"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "schema_live_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "capability_admit"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJS
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = fld_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fld_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " fld_n=" fld_n " any_n=" any_n " obj_n=" obj_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "slr report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
