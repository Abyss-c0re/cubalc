# svc_pathp_board.cubalc — dotted path GETP/SETP/INCP nest path plane
#
# Real use: ops agents peel and mutate nested plate fields via "freq.error"
# paths without GETPOBJ+SETPOBJ glue; DEFAULTP seeds, TOGGLEP flips flags.
# First realworld of proofs 1192-1193 (MEANINGFUL 651-652).
#
#   GETP/SETP/INCP/DELP/HASP "a.b.c"   · slash alias a/b/c
#   DEFAULTP path val · TOGGLEP path · TYPEP path
#   … FROM PEER multi-plate
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_spp_$$
#   ./out/cubalc run programs/realworld/svc_pathp_board.cubalc boot
#   ./out/cubalc run ... get|set|bump|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SPP_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SPP_REQUIRE
#
# Edges:
#   soft path miss OR; HASP miss; DELP miss soft; intermediate create on SET;
#   WRITE NL; NUM softens REQUIRE; EXIT shell (W7)

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_pathp_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_pathp -- boot|get|set|bump|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeX"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SPP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SPP_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET path_val = ""

ONEOF ACTION "boot", "get", "set", "bump", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "get" THEN
    LET op = "get"
  WHEN "set" THEN
    LET op = "set"
  WHEN "bump" THEN
    LET op = "bump"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — seed nested plate
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-path\",\"schema\":\"cubalc.svc_pathp.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"cfg\":{\"port\":8080,\"tls\":0},\"freq\":{\"error\":2,\"warn\":5},\"meta\":{\"role\":\"" role_s "\"},\"flags\":{\"debug\":0}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"cfg\":{\"port\":8080},\"tag\":\"t\",\"schema\":\"cubalc.svc_pathp.v1\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "freq.error"
  SYS EQS LAST "2"
  LET has_n = LAST_N
  CLEAR_ERR
  HASP "freq.warn"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST host_s
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET take_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot host"
        FAIL "boot host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot has warn"
      FAIL "boot has warn"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot get error"
    FAIL "boot get error"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# get — path peel + slash alias + OR miss
SYS EQS op "get"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "freq.error"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val "2"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "freq/warn"
  SYS EQS LAST "5"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "freq.crit" OR "0"
  SYS EQS LAST "0"
  LET load_hit = LAST_N
  CLEAR_ERR
  HASP "freq.crit"
  LET miss_n = LAST_N
  CLEAR_ERR
  # substring false friend: HASP freq.err must not hit freq.error
  HASP "freq.err"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF miss_n == 0 THEN
          IF soft_ok == 0 THEN
            LET hit = 1
            LET note_msg = "get ok"
            LET admit_n = 1
            LET take_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "get false err"
            FAIL "get false err"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "get crit has"
          FAIL "get crit has"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "get OR"
        FAIL "get OR"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "get slash warn"
      FAIL "get slash warn"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "get error"
    FAIL "get error"
    CLEAR_ERR
  END
  SYS CAT "get:" path_val ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "get:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

# set — SETP path + deep create
SYS EQS op "set"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "freq.error" 9
  CLEAR_ERR
  SETP "deep.a.b" 1
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "freq.error"
  SYS EQS LAST "9"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "deep.a.b"
  SYS EQS LAST "1"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "freq.warn"
  SYS EQS LAST "5"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST host_s
  LET take_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          LET hit = 1
          LET note_msg = "set ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "set host"
          FAIL "set host"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "set warn intact"
        FAIL "set warn intact"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "set deep"
      FAIL "set deep"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "set error"
    FAIL "set error"
    CLEAR_ERR
  END
  SYS CAT "set:9:st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "set:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# bump — INCP path
SYS EQS op "bump"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "freq.warn"
  LET path_val = LAST
  CLEAR_ERR
  SYS NUM path_val
  LET take_n = LAST_N
  CLEAR_ERR
  INCP "freq.warn"
  CLEAR_ERR
  GETP "freq.warn"
  LET body = LAST
  CLEAR_ERR
  SYS NUM body
  LET has_n = LAST_N
  CLEAR_ERR
  LET peel_hit = 0
  LET load_hit = take_n + 1
  IF has_n == load_hit THEN
    LET peel_hit = 1
  END
  CLEAR_ERR
  INCP "stats.hits" 2
  CLEAR_ERR
  GETP "stats.hits"
  SYS EQS LAST "2"
  LET miss_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF miss_n == 1 THEN
      LET hit = 1
      LET note_msg = "bump ok"
      LET admit_n = 1
      LET soft_ok = 1
    ELSE
      LET miss = 1
      LET note_msg = "bump create hits"
      FAIL "bump create hits"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "bump warn"
    FAIL "bump warn"
    CLEAR_ERR
  END
  SYS STR has_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "bump:" w_s ":bp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "bump:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit miss_n note_msg
  CLEAR_ERR
END

# peer — path FROM PEER
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP FROM PEER "cfg.port"
  SYS EQS LAST "8080"
  LET has_n = LAST_N
  CLEAR_ERR
  SETP FROM PEER "cfg.port" 9090
  CLEAR_ERR
  GETP FROM PEER "cfg.port"
  SYS EQS LAST "9090"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SAVEP FROM PEER peer_path
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          LET hit = 1
          LET note_msg = "peer ok"
          LET admit_n = 1
          LET soft_ok = 1
        ELSE
          LET miss = 1
          LET note_msg = "peer tag"
          FAIL "peer tag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer agent port"
        FAIL "peer agent port"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer set port"
      FAIL "peer set port"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer get port"
    FAIL "peer get port"
    CLEAR_ERR
  END
  SYS CAT "peer:9090:pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# soft — path miss soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  HASP "nope.x"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "nope.x" OR "fb"
  SYS EQS LAST "fb"
  LET soft_ok = LAST_N
  CLEAR_ERR
  DELP "nope.y"
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET take_n = LAST_N
  CLEAR_ERR
  TYPEP "freq.ghost"
  SYS EQS LAST "missing"
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF has_n == 0 THEN
    IF soft_ok == 1 THEN
      IF take_n == 0 THEN
        IF peel_hit == 1 THEN
          LET hit = 1
          LET note_msg = "soft ok"
          LET admit_n = 1
          LET load_hit = 1
        ELSE
          LET miss = 1
          LET note_msg = "soft type missing"
          FAIL "soft type missing"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft empty bag"
        FAIL "soft empty bag"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft OR"
      FAIL "soft OR"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft has"
    FAIL "soft has"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok has_n peel_hit note_msg
  CLEAR_ERR
END

# gate — required paths after mutations
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  HASP "freq.error"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "freq.error"
  LET path_val = LAST
  CLEAR_ERR
  SYS NUM path_val
  LET take_n = LAST_N
  CLEAR_ERR
  HASP "cfg.port"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_pathp"
  LET load_hit = LAST_N
  CLEAR_ERR
  # false friend
  HASP "freq.err"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF take_n >= 2 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF miss_n == 0 THEN
            LET hit = 1
            LET gate_ok = 1
            LET admit_n = 1
            LET note_msg = "gate ok"
          ELSE
            LET miss = 1
            LET note_msg = "gate false err"
            FAIL "gate false err"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate schema"
          FAIL "gate schema"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate cfg.port"
        FAIL "gate cfg.port"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate error lo"
      FAIL "gate error lo"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate has error"
    FAIL "gate has error"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok has_n take_n peel_hit note_msg
  CLEAR_ERR
END

# probe — DEFAULTP TOGGLEP TYPEP DELP
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  DEFAULTP "cfg.retries" 3
  CLEAR_ERR
  GETP "cfg.retries"
  SYS EQS LAST "3"
  LET has_n = LAST_N
  CLEAR_ERR
  DEFAULTP "cfg.retries" 9
  CLEAR_ERR
  GETP "cfg.retries"
  SYS EQS LAST "3"
  LET peel_hit = LAST_N
  CLEAR_ERR
  TOGGLEP "flags.debug"
  CLEAR_ERR
  GETP "flags.debug"
  SYS EQS LAST "1"
  LET load_hit = LAST_N
  CLEAR_ERR
  TYPEP "freq.error"
  SYS EQS LAST "num"
  LET take_n = LAST_N
  CLEAR_ERR
  DELP "meta.role"
  CLEAR_ERR
  HASP "meta.role"
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-path"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF miss_n == 0 THEN
            IF soft_ok == 1 THEN
              LET hit = 1
              LET note_msg = "probe ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "probe agent"
              FAIL "probe agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe del role"
            FAIL "probe del role"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe type"
          FAIL "probe type"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe toggle"
        FAIL "probe toggle"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe default keep"
      FAIL "probe default keep"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe default set"
    FAIL "probe default set"
    CLEAR_ERR
  END
  SYS CAT "probe:path:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_pathp.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_pathp_board: end"
