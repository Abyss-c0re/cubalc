  SYS WRITE val_path val
  CLEAR_ERR
END
IF meta_ch == 1 THEN
  SYS WRITE meta_path meta
  CLEAR_ERR
END

SYS MS
LET t1ms = MS
LET dt = t1ms - t0ms
SYS PUSH board_rep run_date
LET board_rep = LAST
SYS PUSH board_rep ACTION
LET board_rep = LAST
SYS PUSH board_rep note_msg
LET board_rep = LAST
