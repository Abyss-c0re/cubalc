SYS PUSH board_rep LAST
LET board_rep = LAST
SYS WRITE report_path board_rep
CLEAR_ERR

NOTE "schema_contract_board: done"
SYS EQS note_msg "unknown action"
IF LAST_N == 0 THEN
  IF miss > 0 THEN
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
END
EXIT 0 note_msg
