# agent_json_plate_stamp_board.cubalc — JSONOBJ + JSONSET agent STATUS plate stamps
#
# Real use: agents mint STATUS.json plates in one shot and stamp fields
# (ok/err/phase/n) without hand string rebuild or JOIN-glue rewrites:
#   JSONOBJ / MKJSON / JOBJ — multi-pair plate construct (1055)
#   JSONSET / JSET / JSONPUT — set/update top-level keys (1054)
#   JSONOBJ FROM base — extend existing plate
#   JSON / JSONKEYS / JSONHAS — peel/verify after write
#   WRITEOUT — persist plate to path
#
# First realworld JSONOBJ+JSONSET board. Distinct from agent_json_plate_peel
# (read-only peels) and status_handoff (atomic/hash wait without JSON ops).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ajps_$$
#   ./out/cubalc run programs/realworld/agent_json_plate_stamp_board.cubalc \
#     mint -- --plate=/tmp/ajps/status.json
#   ./out/cubalc run ... stamp -- --plate=... --phase=run --n=3
#   ./out/cubalc run ... fail -- --plate=... --err=boom
#   ./out/cubalc run ... show -- --plate=...
#
# Plate: STATUS.txt VAL.txt META.txt AJPS_REPORT.txt
# Env: PLATE_PATH CUBALC_AJPS_REQUIRE CUBALC_AJPS_MIN CUBALC_AJPS_PHASE
#      CUBALC_AJPS_N CUBALC_AJPS_ERR CUBALC_AJPS_SCHEMA
#
# Edges:
#   empty JSONOBJ → {}; empty key JSONSET soft; update vs insert UPDATED
#   quote escape; RAW nested; FROM extend; REQUIRE EXIT n; WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_json_plate_stamp_board: start"
DEFAULT ACTION = "list"
DEFAULT MIN = 1
DEFAULT PHASE = "boot"
DEFAULT TN = 0
DEFAULT ERRMSG = ""
DEFAULT SCHEMA = "cubalc.agent_status.v1"
DEFAULT USAGE_LINE = "agent_json_plate_stamp -- mint|stamp|fail|show|list -- [--plate=P] [--phase=S] [--n=K] [--err=S]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/status.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
LET p_ok = OK
CLEAR_ERR

GETFLAG phase OR ENV CUBALC_AJPS_PHASE OR PHASE
LET PHASE = LAST
CLEAR_ERR
GETFLAGN n OR ENV CUBALC_AJPS_N OR TN
LET TN = LAST_N
CLEAR_ERR
GETFLAG err OR ENV CUBALC_AJPS_ERR OR ERRMSG
LET ERRMSG = LAST
CLEAR_ERR
GETFLAG schema OR ENV CUBALC_AJPS_SCHEMA OR SCHEMA
LET SCHEMA = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_AJPS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
SYS ENV "CUBALC_AJPS_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN = LAST_N
  END
END

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "AJPS_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET line_i = 0
LET row = ""
LET out = ""
LET body = ""
LET updated = 0

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "mint", "stamp", "fail", "show", "extend", "list", "ls", "drop", "gate", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "mint" THEN
    LET op = "mint"
  WHEN "stamp" THEN
    LET op = "stamp"
  WHEN "fail" THEN
    LET op = "fail"
  WHEN "show" THEN
    LET op = "show"
  WHEN "extend" THEN
    LET op = "extend"
  WHEN "drop" THEN
    LET op = "drop"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src PHASE TN
  CLEAR_ERR
END

SYS EQS op "mint"
IF LAST_N == 1 THEN
  LET known = 1
  # JSONOBJ rejects bare numeric vars as values (W118) — STR shuttle
  SYS STR TN
  LET n_str = LAST
  CLEAR_ERR
  # one-shot agent STATUS plate (string vars OK; num vars need STR)
  SYS JSONOBJ "schema" SCHEMA "ok" 1 "err" "" "phase" PHASE "n" n_str "ts" run_date
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "mint soft miss"
    FAIL "mint soft miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "mint failed"
    END
  ELSE
    LET take_n = JSONOBJ_N
    LET body = LAST
    LET out = body
    CLEAR_ERR
    WRITEOUT plate_file body
    EXPECT OK == 1
    IF OK == 0 THEN
      EXIT 2 "mint write failed"
    END
    CLEAR_ERR
    SYS CAT "mint:"
    LET row = LAST
    SYS CAT row SCHEMA
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR take_n
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":jo"
    LET row = LAST
    SYS GREPV "mint:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "mint ok"
  END
  PRINT_JSON admit_n bag_n take_n p_src
  CLEAR_ERR
END

SYS EQS op "stamp"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "stamp empty plate"
    FAIL "stamp empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "stamp empty"
    END
  ELSE
    # update phase + n + ts; track UPDATED on phase
    # JSONSET also needs STR for numeric vars (W118)
    SYS STR TN
    LET n_str = LAST
    CLEAR_ERR
    SYS JSONSET body "phase" PHASE
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "stamp soft miss"
      FAIL "stamp soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "stamp failed"
      END
    ELSE
      LET updated = JSONSET_UPDATED
      LET body = LAST
      CLEAR_ERR
      SYS JSONSET body "n" n_str
      LET body = LAST
      CLEAR_ERR
      SYS JSONSET body "ts" run_date
      LET body = LAST
      CLEAR_ERR
      SYS JSONSET body "ok" 1
      LET body = LAST
      CLEAR_ERR
      SYS JSONSET body "err" ""
      LET body = LAST
      LET out = body
      CLEAR_ERR
      WRITEOUT plate_file body
      EXPECT OK == 1
      IF OK == 0 THEN
        EXIT 2 "stamp write failed"
      END
      CLEAR_ERR
      SYS CAT "stamp:"
      LET row = LAST
      SYS CAT row PHASE
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS CAT row n_str
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR updated
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":js"
      LET row = LAST
      SYS GREPV "stamp:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      LET hit = 1
      LET note_msg = "stamp ok"
    END
  END
  PRINT_JSON admit_n bag_n updated TN p_src
  CLEAR_ERR
END

SYS EQS op "fail"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "fail empty plate"
    FAIL "fail empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "fail empty"
    END
  ELSE
    SYS BLANK ERRMSG
    IF LAST_N == 1 THEN
      LET ERRMSG = "failed"
    END
    CLEAR_ERR
    SYS JSONSET body "ok" 0
    LET body = LAST
    CLEAR_ERR
    SYS JSONSET body "err" ERRMSG
    LET body = LAST
    CLEAR_ERR
    SYS JSONSET body "phase" "fail"
    LET body = LAST
    LET out = body
    LET updated = JSONSET_UPDATED
    CLEAR_ERR
    WRITEOUT plate_file body
    EXPECT OK == 1
    IF OK == 0 THEN
      EXIT 2 "fail write failed"
    END
    CLEAR_ERR
    SYS CAT "fail:"
    LET row = LAST
    SYS CAT row ERRMSG
    LET row = LAST
    SYS CAT row ":ff"
    LET row = LAST
    SYS GREPV "fail:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "fail stamped"
  END
  PRINT_JSON admit_n bag_n updated p_src
  CLEAR_ERR
END

SYS EQS op "show"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "show empty plate"
    FAIL "show empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "show empty"
    END
  ELSE
    LET out = body
    SYS JSONKEYS body
    LET take_n = JSONKEYS_N
    CLEAR_ERR
    # literal peels only (W115)
    SYS JSON "phase" FROM body
    LET PHASE = LAST
    CLEAR_ERR
    SYS JSON "n" FROM body
    LET TN = LAST_N
    # LAST_N after JSON may not be numeric n — use NUM shuttle
    SYS NUM
    IF OK == 1 THEN
      LET TN = LAST_N
    END
    CLEAR_ERR
    SYS JSON "ok" FROM body
    LET peel_hit = LAST_N
    CLEAR_ERR
    SYS JSON "err" FROM body OR ""
    LET ERRMSG = LAST
    CLEAR_ERR
    SYS CAT "show:"
    LET row = LAST
    SYS CAT row PHASE
    LET row = LAST
    SYS CAT row ":"
    LET row = LAST
    SYS STR peel_hit
    SYS CAT row LAST
    LET row = LAST
    SYS CAT row ":sh"
    LET row = LAST
    SYS GREPV "show:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "show ok"
  END
  PRINT_JSON admit_n bag_n take_n peel_hit p_src
  CLEAR_ERR
END

SYS EQS op "extend"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ OR plate_file OR ""
  LET body = LAST
  CLEAR_ERR
  SYS BLANK body
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "extend empty plate"
    FAIL "extend empty plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "extend empty"
    END
  ELSE
    # JSONOBJ FROM base adds pairs; note may overwrite existing keys
    SYS STR TN
    LET n_str = LAST
    CLEAR_ERR
    SYS JSONOBJ FROM body "extra" "yes" "stamp_n" n_str
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "extend soft miss"
      FAIL "extend soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "extend failed"
      END
    ELSE
      LET take_n = JSONOBJ_N
      LET body = LAST
      LET out = body
      CLEAR_ERR
      WRITEOUT plate_file body
      EXPECT OK == 1
      IF OK == 0 THEN
        EXIT 2 "extend write failed"
      END
      CLEAR_ERR
      SYS JSONHAS "extra" body
      LET peel_hit = JSONHAS_HIT
      CLEAR_ERR
      SYS CAT "extend:"
      LET row = LAST
      SYS STR take_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR peel_hit
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":ex"
      LET row = LAST
      SYS GREPV "extend:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      LET hit = 1
      LET note_msg = "extend ok"
    END
  END
  PRINT_JSON admit_n bag_n take_n peel_hit p_src
  CLEAR_ERR
END

SYS EQS op "drop"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "drop needs key"
    FAIL "drop needs key"
    CLEAR_ERR
  ELSE
    SYS NTH 0 targets
    LET row = LAST
    SYS CAT row ":"
    SYS GREPV LAST bag
    LET bag = LAST
    CLEAR_ERR
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "drop ok"
  END
  PRINT_JSON admit_n bag_n
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n >= MIN THEN
    LET hit = 1
    LET note_msg = "gate admit"
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    FAIL "gate deny"
    CLEAR_ERR
  END
  PRINT_JSON bag_n MIN hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JSONOBJ
  LET take_n = JSONOBJ_N
  LET out = LAST
  CLEAR_ERR
  SYS JSONSET "{}" "" "nope"
  LET has_n = OK
  CLEAR_ERR
  SYS JSONSET "" "ok" 1
  LET peel_hit = OK
  LET body = LAST
  CLEAR_ERR
  SYS JSONSET body "ok" 0
  LET updated = JSONSET_UPDATED
  CLEAR_ERR
  SYS JSONSET body "msg" "say \"hi\""
  LET admit_n = OK
  LET out = LAST
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  PRINT_JSON take_n has_n peel_hit updated admit_n p_src
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_json_plate_stamp_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "bag_n"
LET row = LAST
SYS STR bag_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "take_n"
LET row = LAST
SYS STR take_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE report_path row
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
SYS WRITE meta_path row
CLEAR_ERR

NOTE "agent_json_plate_stamp_board: done"
PRINT_JSON hit miss bag_n take_n updated peel_hit p_src note_msg
EXIT 0
