# svc_form_capability_board.cubalc — HASFORM/HASFORMS + form_guard preflight
#
# Real use: fleet agents preflight HELP-catalog capability contracts before
# calling mtime/lib forms (SORTLIBS, LIBAGE, FRESHLIBS) so older runtimes
# soft-miss with FORMMISS bag instead of unknown-form crash. First realworld
# of proofs 1323 HASFORM/NEEDFORM/REQUIRE FORM + 1324 HASFORMS/form_guard.
#
#   HASFORM|KNOWNFORM name → LAST_N 0|1 · HASFORM_N · FORM · FORM_HINT
#   HASFORMS|ALLFORMS names…|bag → FORMMISS bag · HASFORMS_N known · FORMS_N
#   NEEDFORM|NEEDFORMS hard · REQUIRE FORM dual · INCLUDE form_guard
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sfc_$$
#   ./out/cubalc run programs/realworld/svc_form_capability_board.cubalc boot
#   ./out/cubalc run ... probe|multi|guard|soft|need|alias|gate|list
#
# Plate: STATUS.txt VAL.txt META.txt SFC_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SFC_REQUIRE
#
# Edges: soft FORMMISS; bag CSV vs idents; form name as HASFORMS arg;
#   form_guard soft DEFAULT; WRITE NL; REQUIRE softens; CLI hasform dual

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_form_capability_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_form_capability -- boot|probe|multi|guard|soft|need|alias|gate|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SFC_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SFC_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET miss_n = 0
LET forms_n = 0

ONEOF ACTION "boot", "probe", "multi", "guard", "soft", "need", "alias", "gate", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "multi" THEN
    LET op = "multi"
  WHEN "guard" THEN
    LET op = "guard"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "need" THEN
    LET op = "need"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-formcap\",\"schema\":\"cubalc.svc_form_capability.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"form\",\"label\":\"formcap\",\"cfg\":{\"need\":\"SORTLIBS,LIBAGE,FRESHLIBS\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"formgate\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_form_capability"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "form"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — single HASFORM / KNOWNFORM / FORM_HINT / var name
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORM SORTLIBS
  LET sum_v = OK
  LET sum_n = LAST_N
  LET forms_n = HASFORM_N
  LET stem_s = FORM
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF forms_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM LIBAGE
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM FRESHLIBS
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  KNOWNFORM INCLUDE
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET f = "NEWESTLIB"
  HASFORM f
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # multi-word catalog entry
  HASFORM "REQUIRE FN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:1:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

# multi — HASFORMS idents + bag/CSV + FORMMISS dual
SYS EQS op "multi"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORMS SORTLIBS LIBAGE FRESHLIBS
  LET sum_v = OK
  LET sum_n = LAST_N
  LET forms_n = FORMS_N
  LET admit_n = HASFORMS_N
  LET miss_n = FORMMISS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF forms_n == 3 THEN
    LET score = score + 1
  END
  IF admit_n == 3 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  # bag/CSV of self-gate forms (HASFORM is a valid form name as token)
  HASFORMS "HASFORM,NEEDFORM,HASFORMS"
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  # form names as bare idents after stop-list fix
  NEEDFORMS HASFORM SORTLIBS
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.need"
  SYS HAS LAST "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "form"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "multi ok"
    LET find_n = admit_n
  ELSE
    LET miss = 1
    LET note_msg = "multi score"
    FAIL "multi score"
    CLEAR_ERR
  END
  SYS CAT "multi:" admit_n ":mu"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "multi:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n admit_n forms_n score note_msg
  CLEAR_ERR
END

# guard — hard form_guard default NEED_FORMS
SYS EQS op "guard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # hard contract: capability gates themselves must exist
  DEFAULT FORM_GUARD_SOFT = 0
  DEFAULT NEED_FORMS = "HASFORM\nNEEDFORM\nHASFORMS\nNEEDFORMS\nSORTLIBS\nLIBAGE"
  INCLUDE form_guard
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  REQUIRE FORM SORTLIBS
  LET sum_v = OK
  LET stem_s = REQUIRE_FORM
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS stem_s "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  REQUIRE FORM LIBAGE
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "form_capability"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "guard ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "guard score"
    FAIL "guard score"
    CLEAR_ERR
  END
  SYS CAT "guard:1:gd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "guard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — FORMMISS bag + soft form_guard
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORMS SORTLIBS NO_SUCH_FORM_XYZ_ZZZ LIBAGE
  LET sum_v = OK
  LET sum_n = LAST_N
  LET miss_n = FORMMISS_N
  LET forms_n = FORMS_N
  LET admit_n = HASFORMS_N
  LET body = FORMMISS
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 1 THEN
    LET score = score + 1
  END
  IF forms_n == 3 THEN
    LET score = score + 1
  END
  IF admit_n == 2 THEN
    LET score = score + 1
  END
  SYS HASLINE body "NO_SUCH_FORM_XYZ_ZZZ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft form_guard — miss does not hard-fail
  DEFAULT FORM_GUARD_SOFT = 1
  DEFAULT NEED_FORMS = "SORTLIBS\nNO_SUCH_FORM_XYZ_ZZZ"
  INCLUDE form_guard
  LET sum_v = OK
  LET miss_n = FORMMISS_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  # ghost single
  HASFORM NO_SUCH_FORM_XYZ_ZZZ
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_v miss_n score note_msg
  CLEAR_ERR
END

# need — NEEDFORM + NEEDFORMS + REQUIRE FORM hard path
SYS EQS op "need"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEEDFORM HASFORM
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  NEEDFORMS SORTLIBS LIBAGE FRESHLIBS
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  REQUIRE FORM SORTLIBS
  LET stem_s = LAST
  CLEAR_ERR
  SYS EQS stem_s "SORTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  REQUIRE FORM LIBAGE
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.need"
  SYS HAS LAST "LIBAGE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "need ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "need score"
    FAIL "need score"
    CLEAR_ERR
  END
  SYS CAT "need:1:nd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "need:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

# alias — KNOWNFORM / ALLFORMS / REQUIREFORM duals
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  KNOWNFORM SORTLIBS
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  ALLFORMS SORTLIBS LIBAGE
  LET sum_v = OK
  LET admit_n = HASFORMS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF admit_n == 2 THEN
    LET score = score + 1
  END
  REQUIREFORM HASFORM
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  FORMSOK SORTLIBS
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "form"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n score note_msg
  CLEAR_ERR
END

# gate — plate cfg.need contract vs live catalog
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "cfg.need"
  LET body = LAST
  CLEAR_ERR
  # plate lists required forms as CSV; HASFORMS expands bag
  HASFORMS body
  LET sum_v = OK
  LET miss_n = FORMMISS_N
  LET forms_n = FORMS_N
  LET admit_n = HASFORMS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  IF forms_n == 3 THEN
    LET score = score + 1
  END
  IF admit_n == 3 THEN
    LET score = score + 1
  END
  GETP "want_filter"
  SYS EQS LAST "form"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_form_capability"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-formcap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET find_n = admit_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n admit_n forms_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_form_capability.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " forms_n=" forms_n " miss_n=" miss_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_form_capability_board: done"
PASS
