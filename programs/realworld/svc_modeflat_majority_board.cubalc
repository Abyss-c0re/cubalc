# svc_modeflat_majority_board.cubalc — MODEFLAT/TOPVALFLAT majority digests
#
# Real use: fleet agents need the *dominant* role/status leaf without
# FREQFLAT+SORTFREQ+BEFORE glue — canary majority, peer health winner.
# First realworld of proof 1242 MODEFLAT (MEANINGFUL 701).
#
#   MODEFLAT|TOPVALFLAT|MAJORFLAT [FROM plate] needle
#   LAST = dominant value · LAST_N = winner count (prefer over MODEFLAT_N
#   when near 128-var cap — specials silently drop; see W128)
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_smf_$$
#   ./out/cubalc run programs/realworld/svc_modeflat_majority_board.cubalc boot
#   ./out/cubalc run ... mode|top|peer|soft|gate|tie|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SMF_REPORT.txt agent.json peer.json mode.txt
# Env: HOST_S ROLE_S CUBALC_SMF_REQUIRE
#
# Edges: soft miss; FROM PEER; empty needle; first-seen tie; substring "ro";
#   WRITE NL; REQUIRE softens; LAST_N capture under var pressure

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_modeflat_majority_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_modeflat_majority -- boot|mode|top|peer|soft|gate|tie|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeM"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SMF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

# path pool — reuse to stay under 128-var hard cap
SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "mode.txt"
LET mode_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SMF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

# lean counters (reuse across actions)
LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET mode_val = ""
LET win_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "mode", "top", "peer", "soft", "gate", "tie", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "mode" THEN
    LET op = "mode"
  WHEN "top" THEN
    LET op = "top"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "tie" THEN
    LET op = "tie"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — multi-zone role plate + peer status
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-modeflat\",\"schema\":\"cubalc.svc_modeflat_majority.v1\",\"site\":\"" host_s "\",\"agent_job\":\"" role_s "\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"worker\",\"endpoint\":\"h1\"},\"other\":{\"endpoint\":\"h2\",\"role\":\"leader\"},\"label\":\"mode\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_modeflat_majority.v1\",\"site\":\"" host_s "\",\"a\":{\"status\":\"ok\"},\"b\":{\"status\":\"fail\"},\"c\":{\"status\":\"ok\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.endpoint"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:roles:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# mode — MODEFLAT role majority + endpoint + soft miss
SYS EQS op "mode"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  MODEFLAT "role"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS WRITE mode_path mode_val
  CLEAR_ERR
  SYS EQS mode_val "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 2 THEN
    LET score = score + 1
  END
  MODEFLAT "endpoint"
  LET body = LAST
  LET admit_n = LAST_N
  CLEAR_ERR
  SYS EQS body "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  MODEFLAT "nope"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "mode ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "mode score"
    FAIL "mode score"
    CLEAR_ERR
  END
  SYS STR win_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "mode:" mode_val ":" body ":md"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "mode:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n mode_val win_n score note_msg
  CLEAR_ERR
END

# top — TOPVALFLAT + MAJORFLAT + empty/bare MODEFLAT
SYS EQS op "top"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  TOPVALFLAT "role"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS EQS mode_val "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 2 THEN
    LET score = score + 1
  END
  MAJORFLAT "role"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MODEFLAT ""
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MODEFLAT
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-modeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "top ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "top score"
    FAIL "top score"
    CLEAR_ERR
  END
  SYS WRITE mode_path mode_val
  CLEAR_ERR
  SYS STR win_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "top:" mode_val ":" body ":tp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "top:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n mode_val win_n score note_msg
  CLEAR_ERR
END

# peer — MODEFLAT FROM PEER status majority
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  MODEFLAT FROM PEER "status"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS WRITE mode_path mode_val
  CLEAR_ERR
  SYS EQS mode_val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 2 THEN
    LET score = score + 1
  END
  TOPVALFLAT FROM PEER "status"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-modeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS STR win_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "peer:" mode_val ":" body ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n mode_val win_n score note_msg
  CLEAR_ERR
END

# soft — ghost miss + role still majority
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  MODEFLAT "ghostpath"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS EQS mode_val ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 0 THEN
    LET score = score + 1
  END
  MODEFLAT "role"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS EQS mode_val "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 2 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-modeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n win_n score note_msg
  CLEAR_ERR
END

# gate — majority admit worker wins
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  MODEFLAT "role"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS EQS mode_val "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n > 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_modeflat_majority"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MODEFLAT "endpoint"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n mode_val win_n score note_msg
  CLEAR_ERR
END

# tie — first-seen wins on equal counts
SYS EQS op "tie"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SETP "probe.a.v" "x"
  CLEAR_ERR
  SETP "probe.b.v" "y"
  CLEAR_ERR
  SETP "probe.c.v" "x"
  CLEAR_ERR
  SETP "probe.d.v" "y"
  CLEAR_ERR
  MODEFLAT "v"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS WRITE mode_path mode_val
  CLEAR_ERR
  SYS EQS mode_val "x"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 2 THEN
    LET score = score + 1
  END
  SETP "rev.a.v" "y"
  CLEAR_ERR
  SETP "rev.b.v" "x"
  CLEAR_ERR
  SETP "rev.c.v" "y"
  CLEAR_ERR
  SETP "rev.d.v" "x"
  CLEAR_ERR
  MODEFLAT "v"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "x"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-modeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "tie ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "tie score"
    FAIL "tie score"
    CLEAR_ERR
  END
  SYS CAT "tie:" mode_val ":ti"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "tie:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n mode_val win_n score note_msg
  CLEAR_ERR
END

# probe — substring needle "ro" soft-matches role (language gap)
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  MODEFLAT "role"
  LET win_n = LAST_N
  LET mode_val = LAST
  CLEAR_ERR
  SYS EQS mode_val "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF win_n == 2 THEN
    LET score = score + 1
  END
  MODEFLAT "agent_job"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MODEFLAT "ro"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "modeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mode"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS WRITE mode_path mode_val
  CLEAR_ERR
  SYS CAT "probe:" mode_val ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n mode_val win_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_modeflat_majority.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " mode=" mode_val " win=" win_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_modeflat_majority_board: end"
