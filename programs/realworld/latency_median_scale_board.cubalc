SYS MS
LET t1ms = MS
LET dt = t1ms - t0ms
SYS PUSH board_rep run_date
LET board_rep = LAST
SYS PUSH board_rep ACTION
LET board_rep = LAST
SYS PUSH board_rep note_msg
LET board_rep = LAST
SYS STR hit
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS STR miss
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS STR dt
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS WRITE report_path board_rep
CLEAR_ERR

NOTE "latency_median_scale_board: done"
SYS EQS note_msg "unknown action"
IF LAST_N == 0 THEN
  IF miss > 0 THEN
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
END
EXIT 0 note_msg
