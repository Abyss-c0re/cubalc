# pathline_freq_digest_board.cubalc — PATHLINETEXTS + PATHLINEFREQ digest rollup
#
# Real use: SRE agents harvest path:lineno:text cites then peel message texts
# and per-file hit histograms for digests/hotspots without EACH+PARSEPATHLINE:
#   PATHLINETREE — annotated cite bag (1041)
#   PATHLINETEXTS / TEXTSFROMPL — message text bag (1044)
#   PATHLINEFREQ / COUNTBYPATH — path:count hist + TOTAL (1045)
#   TOPKEY / LOOKUPN — hottest file
#   WRITEOUT — seed nested multi-line logs
#
# First realworld PATHLINETEXTS + PATHLINEFREQ board. Distinct from
# pathline_evidence (peel first cite + unique paths only).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_pfd_$$
#   ./out/cubalc run programs/realworld/pathline_freq_digest_board.cubalc \
#     seed -- --root=/tmp/pfd/logs
#   ./out/cubalc run ... harvest -- --root=... error
#   ./out/cubalc run ... texts -- --root=... error
#   ./out/cubalc run ... freq -- --root=... error
#
# Plate: STATUS.txt VAL.txt META.txt PFD_REPORT.txt
# Env: LOG_ROOT CUBALC_PFD_REQUIRE CUBALC_PFD_MIN CUBALC_PFD_MAXT
#
# Edges:
#   TEXTS keep duplicates; SKIP plain; empty bag N=0
#   FREQ path:count LOOKUP/TOPKEY; SKIP; empty TOTAL 0
#   harvest empty OK=1 N=0; missing soft; lean VARS (W81)

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "pathline_freq_digest_board: start"
DEFAULT ACTION = "list"
DEFAULT MIN = 1
DEFAULT MAXT = 0
DEFAULT USAGE_LINE = "pathline_freq_digest -- seed|harvest|texts|freq|list -- [--root=D] [needle]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

LET targets = RESTPOS
HASRESTPOS 1
LET has_rest = LAST_N
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "digest/tree"
LET root_dir = LAST
CLEAR_ERR

GETFLAGOUT root|r OR ENV LOG_ROOT OR root_dir
LET root_dir = LAST
LET r_src = GETFLAGOUT_SRC
LET r_ok = OK
CLEAR_ERR

LET needle = "error"
IF has_rest == 1 THEN
  SYS NTH 0 targets
  LET needle = LAST
END
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_PFD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
SYS ENV "CUBALC_PFD_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN = LAST_N
  END
END
SYS ENV "CUBALC_PFD_MAXT" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MAXT = LAST_N
  END
END

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "PFD_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET line_n = 0
LET files_n = 0
LET total_n = 0
LET skip_n = 0
LET row = ""
LET cites = ""
LET out = ""
LET hot = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "seed", "harvest", "texts", "freq", "list", "ls", "drop", "has", "gate", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "seed" THEN
    LET op = "seed"
  WHEN "harvest" THEN
    LET op = "harvest"
  WHEN "texts" THEN
    LET op = "texts"
  WHEN "freq" THEN
    LET op = "freq"
  WHEN "drop" THEN
    LET op = "drop"
  WHEN "has" THEN
    LET op = "has"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n r_src
  CLEAR_ERR
END

SYS EQS op "seed"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "seed needs root"
    FAIL "seed needs root"
    CLEAR_ERR
  ELSE
    SYS JOIN root_dir "a/err.log"
    WRITEOUT LAST "ok\nerror: boom\nerror: boom\nerror: other"
    EXPECT OK == 1
    IF OK == 0 THEN
      EXIT 2 "seed write failed"
    END
    CLEAR_ERR
    SYS JOIN root_dir "a/b/warn.log"
    WRITEOUT LAST "info\nerror: boom\ninfo"
    CLEAR_ERR
    SYS JOIN root_dir "plain.txt"
    WRITEOUT LAST "nope"
    CLEAR_ERR
    SYS CAT "seed:"
    LET row = LAST
    SYS CAT row root_dir
    LET row = LAST
    SYS CAT row ":ok"
    LET row = LAST
    SYS GREPV "seed:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "seed ok"
  END
  PRINT_JSON admit_n bag_n r_src
  CLEAR_ERR
END

SYS EQS op "harvest"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "harvest needs root"
    FAIL "harvest needs root"
    CLEAR_ERR
  ELSE
    PATHLINETREE root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "harvest soft miss"
      FAIL "harvest soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "harvest failed"
      END
    ELSE
      LET line_n = PATHLINETREE_N
      LET files_n = PATHLINETREE_FILES
      LET cites = LAST
      LET out = LAST
      CLEAR_ERR
      SYS CAT "cite:"
      LET row = LAST
      SYS CAT row needle
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR line_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR files_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":pl"
      LET row = LAST
      SYS GREPV "cite:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      IF line_n > 0 THEN
        LET hit = 1
        LET note_msg = "harvest hits"
      ELSE
        LET miss = 1
        LET note_msg = "harvest empty"
        FAIL "harvest empty"
        CLEAR_ERR
        IF require_hit > 0 THEN
          EXIT 2 "harvest empty"
        END
      END
    END
  END
  PRINT_JSON admit_n bag_n line_n files_n r_src
  CLEAR_ERR
END

SYS EQS op "texts"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "texts needs root"
    FAIL "texts needs root"
    CLEAR_ERR
  ELSE
    PATHLINETREE root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "texts soft miss"
      FAIL "texts soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "texts failed"
      END
    ELSE
      LET cites = LAST
      CLEAR_ERR
      PATHLINETEXTS cites
      LET line_n = PATHLINETEXTS_N
      LET skip_n = PATHLINETEXTS_SKIP
      LET out = LAST
      CLEAR_ERR
      SYS CAT "texts:"
      LET row = LAST
      SYS CAT row needle
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR line_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":"
      LET row = LAST
      SYS STR skip_n
      SYS CAT row LAST
      LET row = LAST
      SYS CAT row ":tx"
      LET row = LAST
      SYS GREPV "texts:" bag
      LET bag = LAST
      CLEAR_ERR
      SYS PUSH bag row
      LET bag = LAST
      LET bag_ch = 1
      LET admit_n = 1
      SYS LINES bag
      LET bag_n = LAST_N
      IF line_n > 0 THEN
        LET hit = 1
        LET note_msg = "texts hit"
      ELSE
        LET miss = 1
        LET note_msg = "texts empty"
        FAIL "texts empty"
        CLEAR_ERR
        IF require_hit > 0 THEN
          EXIT 2 "texts empty"
        END
      END
    END
  END
  PRINT_JSON admit_n bag_n line_n skip_n r_src
  CLEAR_ERR
END

SYS EQS op "freq"
IF LAST_N == 1 THEN
  LET known = 1
  IF r_ok == 0 THEN
    LET miss = 1
    LET note_msg = "freq needs root"
    FAIL "freq needs root"
    CLEAR_ERR
  ELSE
    PATHLINETREE root_dir needle
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "freq soft miss"
      FAIL "freq soft miss"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "freq failed"
      END
    ELSE
      LET cites = LAST
      CLEAR_ERR
      PATHLINEFREQ cites
      LET files_n = PATHLINEFREQ_N
      LET total_n = PATHLINEFREQ_TOTAL
      LET skip_n = PATHLINEFREQ_SKIP
      LET out = LAST
      CLEAR_ERR
      SYS TOPKEY PATHLINEFREQ
      LET hot = LAST
      CLEAR_ERR
      # optional total budget
      IF MAXT > 0 THEN
        IF total_n > MAXT THEN
          LET miss = 1
          LET note_msg = "freq over budget"
          FAIL "freq over budget"
          CLEAR_ERR
          IF require_hit > 0 THEN
            EXIT 2 "freq over budget"
          END
        ELSE
          LET hit = 1
          LET note_msg = "freq ok"
        END
      ELSE
        IF total_n > 0 THEN
          LET hit = 1
          LET note_msg = "freq ok"
        ELSE
          LET miss = 1
          LET note_msg = "freq empty"
          FAIL "freq empty"
          CLEAR_ERR
          IF require_hit > 0 THEN
            EXIT 2 "freq empty"
          END
        END
      END
      IF hit == 1 THEN
        SYS CAT "freq:"
        LET row = LAST
        SYS CAT row needle
        LET row = LAST
        SYS CAT row ":"
        LET row = LAST
        SYS STR total_n
        SYS CAT row LAST
        LET row = LAST
        SYS CAT row ":"
        LET row = LAST
        SYS STR files_n
        SYS CAT row LAST
        LET row = LAST
        SYS CAT row ":fq"
        LET row = LAST
        SYS GREPV "freq:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
        LET admit_n = 1
        SYS LINES bag
        LET bag_n = LAST_N
      END
    END
  END
  PRINT_JSON admit_n bag_n total_n files_n skip_n r_src
  CLEAR_ERR
END

SYS EQS op "drop"
IF LAST_N == 1 THEN
  LET known = 1
  IF has_rest == 0 THEN
    LET miss = 1
    LET note_msg = "drop needs key"
    FAIL "drop needs key"
    CLEAR_ERR
  ELSE
    SYS NTH 0 targets
    LET row = LAST
    SYS CAT row ":"
    SYS GREPV LAST bag
    LET bag = LAST
    CLEAR_ERR
    LET bag_ch = 1
    LET admit_n = 1
    SYS LINES bag
    LET bag_n = LAST_N
    LET hit = 1
    LET note_msg = "drop ok"
  END
  PRINT_JSON admit_n bag_n
  CLEAR_ERR
END

SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  SYS NTH 0 targets
  LET row = LAST
  SYS BLANK row
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "has needs key"
    FAIL "has needs key"
    CLEAR_ERR
  ELSE
    SYS CAT row ":"
    SYS GREP LAST bag
    SYS LINES LAST
    LET has_n = LAST_N
    IF has_n > 1 THEN
      LET has_n = 1
    END
    CLEAR_ERR
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "has ok"
    ELSE
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
    END
  END
  PRINT_JSON has_n
  CLEAR_ERR
END

SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n >= MIN THEN
    LET hit = 1
    LET note_msg = "gate admit"
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    FAIL "gate deny"
    CLEAR_ERR
  END
  PRINT_JSON bag_n MIN hit miss
  CLEAR_ERR
END

SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  PATHLINETEXTS ""
  LET has_n = PATHLINETEXTS_N
  CLEAR_ERR
  PATHLINEFREQ ""
  LET admit_n = PATHLINEFREQ_N
  CLEAR_ERR
  PATHLINETREE "" "x"
  LET skip_n = OK
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  PRINT_JSON has_n admit_n skip_n r_src
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.pathline_freq_digest_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "bag_n"
LET row = LAST
SYS STR bag_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "total"
LET row = LAST
SYS STR total_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "files"
LET row = LAST
SYS STR files_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE report_path row
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
SYS WRITE meta_path row
CLEAR_ERR

NOTE "pathline_freq_digest_board: done"
PRINT_JSON hit miss bag_n line_n files_n total_n skip_n r_src note_msg
EXIT 0
