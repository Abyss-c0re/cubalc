# fleet_drift_board.cubalc — signed drift bag → DROPZERO / ABSKV / SIGNKV
#
# Real use: fleet agent holds signed service:delta counts (from DIFFKV upstream
# or host inject). DROPZERO drops flat, ABSKV ranks magnitude movers, SIGNKV
# builds a direction plate (-1|0|1) for rise/fall counts without EACH+SIGN.
#
# Distinct from canary_delta_board (two-plate DIFFKV source): this board is the
# post-delta lens (clean / magnitude / direction) for paging digests.
#
# Plate under STATE:
#   DRIFT.txt         — signed key:delta SoT
#   MAG.txt           — last ABSKV result
#   DIR.txt           — last SIGNKV result
#   DRIFT_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_FD_ACTION):
#   list      — depth + sum + top (default)
#   seed      — WORDS svc:n signed tokens
#   loadlines — ||| events FREQ as positive-only inject
#   dropz     — DROPZERO → rewrite DRIFT
#   abs       — ABSKV → MAG plate
#   sign      — SIGNKV → DIR plate
#   rank      — DROPZERO+ABSKV then TOPKEY (biggest mover)
#   pulse     — SIGNKV counts POS/NEG/ZERO into report
#   getn      — LOOKUPN DRIFT OR 0
#   del       — KVDEL
#   clear     — empty all
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_fd_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1='api:4 db:-1 mesh:0 crit:3 edge:-5' \
#     ./out/cubalc run -q -s programs/realworld/fleet_drift_board.cubalc
#   CUBALC_ARG0=dropz ./out/cubalc run -q -s ...
#   CUBALC_ARG0=rank ./out/cubalc run -q -s ...
#   CUBALC_ARG0=pulse ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_FD_REQUIRE=1
#
# Edges deliberately stressed:
#   DROPZERO keeps negatives (unlike THRESHKV min1)
#   ABSKV_N counts only fields that changed sign; zeros stay 0
#   SIGNKV maps to -1|0|1; POS/NEG/ZERO counters
#   non-numeric: DROPZERO/ABS/SIGN behavior
#   LOOKUPN OR; empty soft+REQUIRE; WRITE NL; PRINT_JSON

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "fleet_drift_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT RFILE = "DRIFT.txt"
DEFAULT MFILE = "MAG.txt"
DEFAULT DFILE = "DIR.txt"
DEFAULT REPORT = "DRIFT_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_FD_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_FD_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_FD_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_FD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir MFILE
LET mag_path = LAST
SYS JOIN state_dir DFILE
LET dir_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR
SYS READ OR mag_path OR ""
LET mag = LAST
CLEAR_ERR
SYS READ OR dir_path OR ""
LET dir = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET changed = 0
LET mag_ch = 0
LET dir_ch = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET total_n = 0
LET drop_n = 0
LET abs_n = 0
LET pos_n = 0
LET neg_n = 0
LET zero_n = 0
LET used_or = 0
LET top_k = ""
LET top_v = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS LINES bag
  LET depth0 = LAST_N
  SYS BLANK bag
  IF LAST_N == 0 THEN
    SYS SUMKV bag ":"
    LET total_n = LAST_N
    SYS TOPKEY bag ":"
    IF OK == 1 THEN
      LET top_k = LAST
      LET top_v = TOPKEY_V
    END
    CLEAR_ERR
  END
  STATUS
  PRINT "fdrift" depth0 total_n ACTION
  PRINT_JSON depth0 total_n top_k top_v ACTION STATUS_OK
  PRINT_JSON bag
  PRINT_JSON mag
  PRINT_JSON dir
  LET note_msg = "list ok"
END

# --- seed ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs svc:n tokens"
  END
  SYS WORDS NAME
  LET toks = LAST
  EACH LINE AS t IN toks
    SYS BLANK t
    IF LAST_N == 0 THEN
      SYS BEFORE t ":"
      LET k = LAST
      SYS AFTER t ":"
      LET v = LAST
      SYS BLANK k
      IF LAST_N == 0 THEN
        SYS LOOKUP bag k ":"
        IF OK == 0 THEN
          SYS KVSET bag k v ":"
          LET bag = LAST
          LET changed = 1
          LET hit = hit + 1
        ELSE
          LET miss = miss + 1
        END
        CLEAR_ERR
      END
    END
  END
  LET note_msg = "seeded"
END

# --- loadlines FREQ ---
SYS EQS ACTION "loadlines"
IF LAST_N == 1 THEN
  NOTE "action loadlines"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "loadlines needs ||| events"
  END
  SYS SPLIT "|||" NAME
  SYS FREQ LAST
  LET bag = LAST
  LET changed = 1
  SYS LINES bag
  LET hit = LAST_N
  LET note_msg = "freq loaded"
END

# --- dropz DROPZERO ---
SYS EQS ACTION "dropz"
IF LAST_N == 1 THEN
  NOTE "action dropz"
  SYS BLANK bag
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "dropz empty"
    FAIL "dropz empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "dropz empty"
    END
  ELSE
    SYS DROPZERO bag ":"
    LET bag = LAST
    LET drop_n = DROPZERO_N
    LET changed = 1
    SYS LINES bag
    LET hit = LAST_N
    SYS BLANK bag
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "dropz all flat"
      FAIL "dropz all flat"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "dropz all flat"
      END
    ELSE
      LET note_msg = "dropz ok"
    END
    PRINT_JSON drop_n hit
    PRINT_JSON bag
  END
END

# --- abs ABSKV ---
SYS EQS ACTION "abs"
IF LAST_N == 1 THEN
  NOTE "action abs"
  SYS BLANK bag
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "abs empty"
    FAIL "abs empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "abs empty"
    END
  ELSE
    SYS ABSKV bag ":"
    LET mag = LAST
    LET abs_n = ABSKV_N
    LET mag_ch = 1
    SYS LINES mag
    LET hit = LAST_N
    LET note_msg = "abs ok"
    PRINT_JSON abs_n hit
    PRINT_JSON mag
  END
END

# --- sign SIGNKV ---
SYS EQS ACTION "sign"
IF LAST_N == 1 THEN
  NOTE "action sign"
  SYS BLANK bag
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "sign empty"
    FAIL "sign empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "sign empty"
    END
  ELSE
    SYS SIGNKV bag ":"
    LET dir = LAST
    LET pos_n = SIGNKV_POS
    LET neg_n = SIGNKV_NEG
    LET zero_n = SIGNKV_ZERO
    LET dir_ch = 1
    SYS LINES dir
    LET hit = LAST_N
    LET note_msg = "sign ok"
    PRINT_JSON pos_n neg_n zero_n
    PRINT_JSON dir
  END
END

# --- rank: DROPZERO + ABSKV + TOPKEY ---
SYS EQS ACTION "rank"
IF LAST_N == 1 THEN
  NOTE "action rank"
  SYS BLANK bag
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "rank empty"
    FAIL "rank empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "rank empty"
    END
  ELSE
    SYS DROPZERO bag ":"
    LET tmp = LAST
    LET drop_n = DROPZERO_N
    SYS BLANK tmp
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "rank all flat"
      FAIL "rank all flat"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "rank all flat"
      END
    ELSE
      SYS ABSKV tmp ":"
      LET mag = LAST
      LET abs_n = ABSKV_N
      LET mag_ch = 1
      SYS TOPKEY mag ":"
      IF OK == 0 THEN
        LET miss = 1
        LET note_msg = "rank top miss"
        FAIL "rank top miss"
        CLEAR_ERR
      ELSE
        LET top_k = LAST
        LET top_v = TOPKEY_V
        LET val_s = top_k
        LET val_n = top_v
        LET hit = top_v
        LET note_msg = "rank ok"
      END
      PRINT_JSON top_k top_v drop_n abs_n
      PRINT_JSON mag
    END
  END
END

# --- pulse: SIGNKV counters only (also writes DIR) ---
SYS EQS ACTION "pulse"
IF LAST_N == 1 THEN
  NOTE "action pulse"
  SYS BLANK bag
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "pulse empty"
    FAIL "pulse empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pulse empty"
    END
  ELSE
    SYS SIGNKV bag ":"
    LET dir = LAST
    LET pos_n = SIGNKV_POS
    LET neg_n = SIGNKV_NEG
    LET zero_n = SIGNKV_ZERO
    LET dir_ch = 1
    LET hit = pos_n + neg_n
    # net direction bias: pos - neg
    LET val_n = pos_n - neg_n
    SYS STR val_n
    LET val_s = LAST
    LET note_msg = "pulse ok"
    PRINT_JSON pos_n neg_n zero_n val_n
  END
END

# --- getn ---
SYS EQS ACTION "getn"
IF LAST_N == 1 THEN
  NOTE "action getn"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "getn needs key"
  END
  SYS LOOKUPN bag NAME ":" OR 0
  LET val_n = LAST_N
  LET used_or = LOOKUPN_OR
  SYS STR val_n
  LET val_s = LAST
  LET hit = val_n
  IF used_or == 1 THEN
    LET miss = 1
    LET note_msg = "getn default"
    IF REQUIRE_HIT > 0 THEN
      FAIL "getn default only"
      CLEAR_ERR
      EXIT 2 "getn default only"
    END
  ELSE
    LET note_msg = "getn ok"
  END
END

# --- del ---
SYS EQS ACTION "del"
IF LAST_N == 1 THEN
  NOTE "action del"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "del needs key"
  END
  SYS KVDEL bag NAME ":"
  LET bag = LAST
  IF KVDEL_HIT == 0 THEN
    LET miss = 1
    LET note_msg = "del miss"
    FAIL "del miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "del miss"
    END
  ELSE
    LET val_s = KVDEL_V
    LET changed = 1
    LET hit = 1
    LET note_msg = "deleted"
  END
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET bag = ""
  LET mag = ""
  LET dir = ""
  LET changed = 1
  LET mag_ch = 1
  LET dir_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "loadlines"
LET k = k + LAST_N
SYS EQS ACTION "dropz"
LET k = k + LAST_N
SYS EQS ACTION "abs"
LET k = k + LAST_N
SYS EQS ACTION "sign"
LET k = k + LAST_N
SYS EQS ACTION "rank"
LET k = k + LAST_N
SYS EQS ACTION "pulse"
LET k = k + LAST_N
SYS EQS ACTION "getn"
LET k = k + LAST_N
SYS EQS ACTION "del"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "drift write failed"
  END
  CLEAR_ERR
END
IF mag_ch > 0 THEN
  SYS WRITE mag_path mag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "mag write failed"
  END
  CLEAR_ERR
END
IF dir_ch > 0 THEN
  SYS WRITE dir_path dir
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "dir write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.fdrift.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "val"
LET report = LAST
SYS PUSH report val_s
LET report = LAST
SYS PUSH report "val_n"
LET report = LAST
SYS STR val_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "total"
LET report = LAST
SYS STR total_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "drop_n"
LET report = LAST
SYS STR drop_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "abs_n"
LET report = LAST
SYS STR abs_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "pos_n"
LET report = LAST
SYS STR pos_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "neg_n"
LET report = LAST
SYS STR neg_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "zero_n"
LET report = LAST
SYS STR zero_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "top_k"
LET report = LAST
SYS PUSH report top_k
LET report = LAST
SYS PUSH report "top_v"
LET report = LAST
SYS STR top_v
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "used_or"
LET report = LAST
SYS STR used_or
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "fdrift" ACTION hit miss depth1
PRINT_JSON ACTION hit miss depth1 val_n pos_n neg_n top_k elapsed STATUS_OK
PASS "fdrift tick"
NOTE "fleet_drift_board: done"
CLEAR_ERR
EXIT 0 "fdrift ok"
