# evidence_packet_gate.cubalc — multi-tag incident evidence plate under STATE
#
# Real use: SOC/ops agents accumulate evidence rows and gate packets with
# multi-needle AND (GREPALL) + severity OR (GREPANY) without shell awk.
#
# Row shape (exact field): host:status:sev:tag
#   status: open | review | closed | junk
#   sev:    info | warn | error | fatal
#   tag:    free token (disk, mem, net, boot, …)
#
# Actions (CUBALC_ARG0 / CUBALC_EP_ACTION):
#   list     — depth + status/sev tallies (default)
#   seed     — WORDS hosts → host:open:info:boot if host absent
#   admit    — ensure host:open:SEV:TAG (VAL=sev, A2=tag)
#   filter   — GREPALL multi-tag AND (ARG1 + ARG2 needles; optional N3 env)
#   triage   — GREPANY high severity tokens (error/warn/fatal case mix)
#   review   — first host row → status review (SETMATCH rebuild)
#   close    — first host row → status closed
#   escalate — sev ladder info→warn→error→fatal (SETMATCH)
#   pin      — MOVELINE first open:error:* to front (attention)
#   drop     — REMOVELINE exact full row (ARG1)
#   has      — HASLINE exact
#   count    — COUNTLINE exact
#   gate     — soft/REQUIRE host env CUBALC_EP_PACKET non-empty
#   clear    — empty plate
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1="db01 app02 web03" \
#     ./out/cubalc run -q -s programs/realworld/evidence_packet_gate.cubalc
#   CUBALC_ARG0=admit CUBALC_ARG1=db01 CUBALC_ARG2=disk CUBALC_EP_VAL=error \
#     ./out/cubalc run -q -s ...
#   CUBALC_ARG0=filter CUBALC_ARG1=error CUBALC_ARG2=disk ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_EP_FILE=EVIDENCE.txt
#   CUBALC_EP_REQUIRE=1
#   CUBALC_EP_VAL=error          # sev for admit
#   CUBALC_EP_N3=open            # optional third GREPALL needle
#   CUBALC_EP_PACKET=ready       # gate payload
#
# Edges deliberately stressed:
#   GREPALL multi-needle bag argument does not expand fields (same class as GREPANY)
#   GREPALL/GREPANY are substring-unsafe (error matches error_soft host token)
#   SETMATCH first exact only; rebuild full row — no in-field column update
#   host identity via BEFORE first ":" — host names with colon break
#   no string concat — REPLACEALL templates only
#   MOVELINE needs FINDLINE; from OOR soft
#   PRINT_JSON collapses multi-line bags; WRITE trailing NL
#   soft READ empty; REQUIRE miss soft+EXIT path
#   REQUIRE ENV hard-fail available but gate uses soft ENV for dual path

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "evidence_packet_gate: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT VAL = "error"
DEFAULT A2 = "disk"
DEFAULT RFILE = "EVIDENCE.txt"
DEFAULT REPORT = "EVIDENCE_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT N3 = ""
DEFAULT PACKET = ""
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_EP_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_EP_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_EP_A2" OR "disk"
  LET A2 = LAST
END
SYS ENV "CUBALC_EP_VAL" OR ""
IF LAST_N > 0 THEN
  LET VAL = LAST
END
SYS ENV "CUBALC_EP_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_EP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_EP_N3" OR ""
IF LAST_N > 0 THEN
  LET N3 = LAST
END
SYS ENV "CUBALC_EP_PACKET" OR ""
IF LAST_N > 0 THEN
  LET PACKET = LAST
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR "soft evidence load"
SYS LINES bag
LET depth0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET n_open = 0
LET n_review = 0
LET n_closed = 0
LET n_junk = 0
LET n_high = 0
LET idx = -1
LET old_entry = ""
LET entry = ""
LET filtered = ""
LET note_msg = "ok"
LET name_hit = 0
LET st = ""
LET sev = ""
LET tag = ""
LET host = ""

# template helpers for admit defaults
LET e_admit = "NAME:open:SEV:TAG"
SYS REPLACEALL e_admit "NAME" NAME
LET e_admit = LAST
SYS REPLACEALL e_admit "SEV" VAL
LET e_admit = LAST
SYS REPLACEALL e_admit "TAG" A2
LET e_admit = LAST

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS GREP ":open:" bag
  SYS LINES LAST
  LET n_open = LAST_N
  SYS GREP ":review:" bag
  SYS LINES LAST
  LET n_review = LAST_N
  SYS GREP ":closed:" bag
  SYS LINES LAST
  LET n_closed = LAST_N
  SYS GREP ":junk:" bag
  SYS LINES LAST
  LET n_junk = LAST_N
  SYS GREPANY bag "error" "fatal" "ERROR" "FATAL" "warn" "WARN"
  SYS LINES LAST
  LET n_high = LAST_N
  STATUS
  PRINT "evidence" depth0 n_open n_review n_closed n_junk n_high ACTION
  PRINT_JSON depth0 n_open n_review n_closed n_junk n_high ACTION STATUS_OK
  PRINT_JSON bag
  LET note_msg = "list ok"
END

# --- seed: WORDS hosts → host:open:info:boot if absent ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs host ids (ARG1 space-separated)"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      LET name_hit = 0
      EACH LINE AS row IN bag
        SYS BEFORE row ":"
        SYS EQS LAST n
        IF LAST_N == 1 THEN
          LET name_hit = 1
        END
      END
      IF name_hit == 0 THEN
        LET e = "NAME:open:info:boot"
        SYS REPLACEALL e "NAME" n
        LET e = LAST
        SYS PUSH bag e
        LET bag = LAST
        LET changed = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded"
END

# --- admit: ensure host:open:SEV:TAG ---
SYS EQS ACTION "admit"
IF LAST_N == 1 THEN
  NOTE "action admit"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "admit needs host id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    SYS PUSH bag e_admit
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "admit inserted"
  ELSE
    SYS EQS old_entry e_admit
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "admit already"
    ELSE
      SYS SETMATCH bag old_entry e_admit
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "admit setmatch miss"
        FAIL "admit setmatch miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "admit miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "admit reset open"
      END
    END
  END
END

# --- filter: GREPALL multi-tag AND ---
SYS EQS ACTION "filter"
IF LAST_N == 1 THEN
  NOTE "action filter"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "filter needs needle1 (ARG1) and usually needle2 (ARG2)"
  END
  SYS BLANK A2
  IF LAST_N == 1 THEN
    # single needle behaves like GREP
    SYS GREPALL bag NAME
    LET filtered = LAST
  ELSE
    SYS BLANK N3
    IF LAST_N == 1 THEN
      SYS GREPALL bag NAME A2
      LET filtered = LAST
    ELSE
      SYS GREPALL bag NAME A2 N3
      LET filtered = LAST
    END
  END
  SYS LINES filtered
  LET hit = LAST_N
  IF hit == 0 THEN
    LET miss = 1
    LET note_msg = "filter empty"
    FAIL "filter empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "filter empty"
    END
  ELSE
    LET note_msg = "filtered"
  END
  PRINT_JSON filtered
END

# --- triage: GREPANY high sev ---
SYS EQS ACTION "triage"
IF LAST_N == 1 THEN
  NOTE "action triage"
  SYS GREPANY bag "error" "warn" "fatal" "ERROR" "WARN" "FATAL"
  LET filtered = LAST
  SYS LINES filtered
  LET hit = LAST_N
  IF hit == 0 THEN
    LET miss = 1
    LET note_msg = "triage none"
    FAIL "triage empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "triage empty"
    END
  ELSE
    LET note_msg = "triaged"
  END
  PRINT_JSON filtered
END

# --- review: first host → status review ---
SYS EQS ACTION "review"
IF LAST_N == 1 THEN
  NOTE "action review"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "review needs host id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "review miss"
    FAIL "review host not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "review miss"
    END
  ELSE
    SYS SPLIT ":" old_entry
    LET parts = LAST
    SYS NTH 0 parts
    LET host = LAST
    SYS NTH 1 parts
    LET st = LAST
    SYS NTH 2 parts
    LET sev = LAST
    SYS NTH 3 parts
    LET tag = LAST
    SYS EQS st "review"
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "review already"
    ELSE
      LET entry = "HOST:review:SEV:TAG"
      SYS REPLACEALL entry "HOST" host
      LET entry = LAST
      SYS REPLACEALL entry "SEV" sev
      LET entry = LAST
      SYS REPLACEALL entry "TAG" tag
      LET entry = LAST
      SYS SETMATCH bag old_entry entry
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "review setmatch miss"
        FAIL "review setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "review setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "reviewed"
      END
    END
  END
END

# --- close: first host → closed ---
SYS EQS ACTION "close"
IF LAST_N == 1 THEN
  NOTE "action close"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "close needs host id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "close miss"
    FAIL "close host not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "close miss"
    END
  ELSE
    SYS SPLIT ":" old_entry
    LET parts = LAST
    SYS NTH 0 parts
    LET host = LAST
    SYS NTH 2 parts
    LET sev = LAST
    SYS NTH 3 parts
    LET tag = LAST
    LET entry = "HOST:closed:SEV:TAG"
    SYS REPLACEALL entry "HOST" host
    LET entry = LAST
    SYS REPLACEALL entry "SEV" sev
    LET entry = LAST
    SYS REPLACEALL entry "TAG" tag
    LET entry = LAST
    SYS EQS old_entry entry
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "close already"
    ELSE
      SYS SETMATCH bag old_entry entry
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "close setmatch miss"
        FAIL "close setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "close setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "closed"
      END
    END
  END
END

# --- escalate: sev ladder info→warn→error→fatal ---
SYS EQS ACTION "escalate"
IF LAST_N == 1 THEN
  NOTE "action escalate"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "escalate needs host id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "escalate miss"
    FAIL "escalate host not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "escalate miss"
    END
  ELSE
    SYS SPLIT ":" old_entry
    LET parts = LAST
    SYS NTH 0 parts
    LET host = LAST
    SYS NTH 1 parts
    LET st = LAST
    SYS NTH 2 parts
    LET sev = LAST
    SYS NTH 3 parts
    LET tag = LAST
    LET entry = sev
    SYS EQS sev "info"
    IF LAST_N == 1 THEN
      LET entry = "warn"
    ELSE
      SYS EQS sev "warn"
      IF LAST_N == 1 THEN
        LET entry = "error"
      ELSE
        SYS EQS sev "error"
        IF LAST_N == 1 THEN
          LET entry = "fatal"
        ELSE
          LET entry = "fatal"
          LET note_msg = "escalate already fatal"
        END
      END
    END
    SYS EQS note_msg "escalate already fatal"
    IF LAST_N == 1 THEN
      LET hit = 1
    ELSE
      LET sev = entry
      LET entry = "HOST:ST:SEV:TAG"
      SYS REPLACEALL entry "HOST" host
      LET entry = LAST
      SYS REPLACEALL entry "ST" st
      LET entry = LAST
      SYS REPLACEALL entry "SEV" sev
      LET entry = LAST
      SYS REPLACEALL entry "TAG" tag
      LET entry = LAST
      SYS SETMATCH bag old_entry entry
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "escalate setmatch miss"
        FAIL "escalate setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "escalate setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "escalated"
      END
    END
  END
END

# --- pin: MOVELINE first open:error to front ---
SYS EQS ACTION "pin"
IF LAST_N == 1 THEN
  NOTE "action pin"
  SYS GREP ":open:error:" bag
  LET hot = LAST
  SYS LINES hot
  IF LAST_N > 0 THEN
    SYS HEAD hot
    LET old_entry = LAST
    SYS FINDLINE bag old_entry
    LET idx = LAST_N
    SYS MOVELINE bag idx 0
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "pin moveline miss"
      FAIL "pin moveline"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "pin moveline miss"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET idx = 0
      LET note_msg = "pinned open error"
    END
  ELSE
    LET miss = 1
    LET note_msg = "pin nothing"
    FAIL "pin empty attention"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pin miss"
    END
  END
END

# --- drop exact ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs exact row"
  END
  SYS HASLINE bag NAME
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "drop miss"
    FAIL "drop miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop miss"
    END
  ELSE
    SYS REMOVELINE bag NAME
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "dropped"
  END
END

# --- has / count ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs exact row"
  END
  SYS HASLINE bag NAME
  LET hit = LAST_N
  LET note_msg = "has"
END

SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs exact row"
  END
  SYS COUNTLINE bag NAME
  LET hit = LAST_N
  LET note_msg = "counted"
END

# --- gate: soft/REQUIRE packet env ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  SYS BLANK PACKET
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "gate packet empty"
    FAIL "gate packet missing"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate packet missing"
    END
  ELSE
    LET hit = 1
    LET note_msg = "gate ok"
    PRINT_JSON PACKET
  END
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET bag = ""
  LET changed = 1
  LET hit = 1
  LET note_msg = "cleared"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "admit"
LET k = k + LAST_N
SYS EQS ACTION "filter"
LET k = k + LAST_N
SYS EQS ACTION "triage"
LET k = k + LAST_N
SYS EQS ACTION "review"
LET k = k + LAST_N
SYS EQS ACTION "close"
LET k = k + LAST_N
SYS EQS ACTION "escalate"
LET k = k + LAST_N
SYS EQS ACTION "pin"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
SYS EQS ACTION "gate"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "evidence write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.evidence.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_open"
LET report = LAST
SYS STR n_open
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_high"
LET report = LAST
SYS STR n_high
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth0"
LET report = LAST
SYS STR depth0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "evidence" ACTION hit miss n_open n_high depth0 depth1
PRINT_JSON ACTION hit miss n_open n_review n_closed n_junk n_high depth0 depth1 elapsed STATUS_OK
PASS "evidence tick"
NOTE "evidence_packet_gate: done"
CLEAR_ERR
EXIT 0 "evidence ok"
