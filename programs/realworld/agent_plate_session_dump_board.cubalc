# agent_plate_session_dump_board.cubalc — plate_session + DUMPP/PLATEINFO
#
# Real use: one-INCLUDE agent session (version + durable PLATE), mutate,
# snapshot cubalc.plate_info.v1 via DUMPP, save, re-session load.
# First realworld of proofs 1116/1117 (DUMPP + plate_session).
#
#   DEFAULT PLATE_PATH / PLATE_SEED
#   INCLUDE plate_session   — agent_boot + plate_boot
#   SETP / INCP / MERGEP / NEEDP
#   DUMPP|PLATEINFO         — cubalc.plate_info.v1 · keys_n/bytes/path
#   INCLUDE plate_save
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_apsd_$$
#   ./out/cubalc run programs/realworld/agent_plate_session_dump_board.cubalc \
#     session -- --plate=/tmp/apsd/agent.json
#   ./out/cubalc run ... tick -- --plate=...
#   ./out/cubalc run ... dump -- --plate=...
#   ./out/cubalc run ... gate -- --plate=...
#
# Plate: STATUS.txt VAL.txt META.txt APSD_REPORT.txt
# Env: PLATE_PATH CUBALC_APSD_REQUIRE
#
# Edges:
#   DUMPP empty PLATE has_plate:false; DUMPP_N keys; PLATE preserved;
#   re-session ENSUREPLATE_CREATED=0; WRITE omit NL; 128-var lean

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "agent_plate_session_dump_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "agent_plate_session_dump -- session|tick|dump|reload|gate|probe|list -- [--plate=P]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
SYS JOIN state_dir "sample/deep/agent.json"
LET plate_file = LAST
CLEAR_ERR

GETFLAGOUT plate|p OR ENV PLATE_PATH OR plate_file
LET plate_file = LAST
LET p_src = GETFLAGOUT_SRC
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_APSD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "APSD_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET peel_s = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "session", "tick", "dump", "reload", "gate", "list", "ls", "soft", "clear", "probe", "alias"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "session" THEN
    LET op = "session"
  WHEN "tick" THEN
    LET op = "tick"
  WHEN "dump" THEN
    LET op = "dump"
  WHEN "reload" THEN
    LET op = "reload"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "alias" THEN
    LET op = "alias"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n p_src
  CLEAR_ERR
END

LET PLATE_PATH = plate_file
SYS JSONOBJ "n" 0 "ok" true "role" "worker" "schema" "cubalc.agent_session.v1"
LET PLATE_SEED = LAST
CLEAR_ERR

# session — INCLUDE plate_session
SYS EQS op "session"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SYS HAS VERSION "1.15"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONHASALL body "n" "ok" "role"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET out = body
  LET take_n = load_hit
  IF has_n == 1 THEN
    IF load_hit == 1 THEN
      IF peel_hit == 1 THEN
        LET hit = 1
        LET note_msg = "session ok"
        LET admit_n = 1
        LET created = 1
      ELSE
        LET miss = 1
        LET note_msg = "session keys"
        FAIL "session keys"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "session load"
      FAIL "session load"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "session load"
      END
    END
  ELSE
    LET miss = 1
    LET note_msg = "session version"
    FAIL "session version"
    CLEAR_ERR
  END
  SYS CAT "session:"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":ss"
  LET row = LAST
  SYS GREPV "session:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit peel_hit has_n p_src note_msg
  CLEAR_ERR
END

# tick — mutate + save (SETP status, INCP n)
SYS EQS op "tick"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "status" "ready"
  CLEAR_ERR
  INCP "n"
  LET take_n = LAST_N
  CLEAR_ERR
  NEEDP "n" "ok" "status"
  LET has_n = OK
  CLEAR_ERR
  INCLUDE plate_save
  CLEAR_ERR
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS JSONN "n" FROM body
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "ready"
  LET admit_n = LAST_N
  CLEAR_ERR
  LET out = body
  IF has_n == 1 THEN
    IF load_hit == 1 THEN
      IF peel_hit == take_n THEN
        IF admit_n == 1 THEN
          LET hit = 1
          LET note_msg = "tick ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "tick status"
          FAIL "tick status"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "tick n"
        FAIL "tick n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "tick load"
      FAIL "tick load"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "tick need"
    FAIL "tick need"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "tick need"
    END
  END
  SYS CAT "tick:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":tk"
  LET row = LAST
  SYS GREPV "tick:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit load_hit p_src note_msg
  CLEAR_ERR
END

# dump — DUMPP plate_info snapshot
SYS EQS op "dump"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  DUMPP
  LET body = LAST
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HAS body "cubalc.plate_info.v1"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS body "\"has_plate\":true"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "keys_n"
  LET load_hit = LAST_N
  CLEAR_ERR
  # PLATE not clobbered
  SYS JSON "role" FROM PLATE
  SYS EQS LAST "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  LET out = body
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF admit_n == 1 THEN
          LET hit = 1
          LET note_msg = "dump ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "dump plate clobber"
          FAIL "dump plate clobber"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "dump keys_n"
        FAIL "dump keys_n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "dump has_plate"
      FAIL "dump has_plate"
      CLEAR_ERR
      IF require_hit > 0 THEN
        EXIT 2 "dump empty"
      END
    END
  ELSE
    LET miss = 1
    LET note_msg = "dump schema"
    FAIL "dump schema"
    CLEAR_ERR
  END
  SYS CAT "dump:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":dp"
  LET row = LAST
  SYS GREPV "dump:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit admit_n p_src note_msg
  CLEAR_ERR
END

# reload — soft LOADPLATE only (no plate_session create-on-miss)
SYS EQS op "reload"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LOADPLATE plate_file
  LET load_hit = LAST_N
  LET body = LAST
  CLEAR_ERR
  LET take_n = load_hit
  LET out = body
  IF load_hit == 1 THEN
    SYS JSONN "n" FROM body
    LET peel_hit = LAST_N
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "reload hit"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "reload miss"
    FAIL "reload miss"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "reload miss"
    END
  END
  SYS CAT "reload:"
  LET row = LAST
  SYS STR load_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR peel_hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":rl"
  LET row = LAST
  SYS GREPV "reload:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n load_hit peel_hit p_src note_msg
  CLEAR_ERR
END

# gate — NEEDP + DUMPP keys_n after tick fields
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "status" "ready"
  CLEAR_ERR
  NEEDP "n" "ok" "role" "status"
  LET take_n = OK
  CLEAR_ERR
  IF take_n == 0 THEN
    LET miss = 1
    LET note_msg = "gate need"
    FAIL "gate need"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate need"
    END
  ELSE
    DUMPP
    LET body = LAST
    CLEAR_ERR
    SYS HAS body "\"has_plate\":true"
    LET has_n = LAST_N
    CLEAR_ERR
    INCLUDE plate_save
    CLEAR_ERR
    SYS LOADPLATE plate_file
    LET load_hit = LAST_N
    CLEAR_ERR
    LET out = body
    IF has_n == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "gate admit"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "gate load"
        FAIL "gate load"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate dump"
      FAIL "gate dump"
      CLEAR_ERR
    END
  END
  SYS CAT "gate:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR hit
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":gt"
  LET row = LAST
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n load_hit admit_n p_src note_msg
  CLEAR_ERR
END

# alias — PLATEINFO
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  INCLUDE plate_session
  CLEAR_ERR
  SETP "tag" "x"
  CLEAR_ERR
  PLATEINFO
  LET body = LAST
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HAS body "plate_info"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS body "cubalc.plate_info.v1"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET out = body
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n >= 3 THEN
        LET hit = 1
        LET note_msg = "alias ok"
        LET admit_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "alias n"
        FAIL "alias n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "alias schema"
      FAIL "alias schema"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "alias info"
    FAIL "alias info"
    CLEAR_ERR
  END
  SYS CAT "alias:"
  LET row = LAST
  SYS STR take_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":"
  LET row = LAST
  SYS STR has_n
  SYS CAT row LAST
  LET row = LAST
  SYS CAT row ":al"
  LET row = LAST
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit p_src note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — empty DUMPP; session mutate; re-session
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  SYS JOIN state_dir "sample/probe_session.json"
  LET row = LAST
  SYS RM row
  CLEAR_ERR
  # empty PLATE dump
  UNSET PLATE
  CLEAR_ERR
  DUMPP
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "\"has_plate\":false"
  LET take_n = LAST_N
  CLEAR_ERR
  # session boot
  LET PLATE_PATH = row
  SYS JSONOBJ "n" 0 "ok" true "role" "worker"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_session
  CLEAR_ERR
  SETP "status" "ready"
  CLEAR_ERR
  INCP "n"
  LET has_n = LAST_N
  CLEAR_ERR
  DUMPP
  LET peel_hit = LAST_N
  CLEAR_ERR
  INCLUDE plate_save
  CLEAR_ERR
  # re-session
  INCLUDE plate_session
  CLEAR_ERR
  SYS JSONN "n" FROM PLATE
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS JSON "status" FROM PLATE
  SYS EQS LAST "ready"
  LET admit_n = LAST_N
  CLEAR_ERR
  LET PLATE_PATH = plate_file
  IF take_n == 1 THEN
    IF has_n >= 1 THEN
      IF peel_hit >= 3 THEN
        IF load_hit == has_n THEN
          IF admit_n == 1 THEN
            LET note_msg = "probe ok"
            LET hit = 1
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "probe re status"
            FAIL "probe re status"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe re n"
          FAIL "probe re n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe dump n"
        FAIL "probe dump n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe inc"
      FAIL "probe inc"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe empty"
    FAIL "probe empty"
    CLEAR_ERR
  END
  PRINT_JSON take_n has_n peel_hit load_hit admit_n p_src note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS BLANK out
  IF LAST_N == 0 THEN
    SYS WRITE val_path out
    CLEAR_ERR
  ELSE
    SYS WRITE val_path bag
    CLEAR_ERR
  END
END

LET row = "schema=cubalc.agent_plate_session_dump_board.v1"
SYS PUSH row "date"
LET row = LAST
SYS PUSH row run_date
LET row = LAST
SYS PUSH row "op"
LET row = LAST
SYS PUSH row op
LET row = LAST
SYS PUSH row "hit"
LET row = LAST
SYS STR hit
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "miss"
LET row = LAST
SYS STR miss
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "admit"
LET row = LAST
SYS STR admit_n
SYS PUSH row LAST
LET row = LAST
SYS PUSH row "plate"
LET row = LAST
SYS PUSH row plate_file
LET row = LAST
SYS PUSH row "note"
LET row = LAST
SYS PUSH row note_msg
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS CAT "apsd op="
LET body = LAST
SYS CAT body op
LET body = LAST
SYS CAT body " hit="
LET body = LAST
SYS STR hit
SYS CAT body LAST
LET body = LAST
SYS CAT body " miss="
LET body = LAST
SYS STR miss
SYS CAT body LAST
LET body = LAST
SYS CAT body " note="
LET body = LAST
SYS CAT body note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n created load_hit peel_hit p_src note_msg
NOTE "agent_plate_session_dump_board: done"
