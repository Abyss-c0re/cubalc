  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENVS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "PRODUCT_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "product_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "product_session_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # recover with empty env contract
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET ENV_GUARD_SOFT = 0
  LET NEED_TIME = 1
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  CLEAR_ERR
  IF pso == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_env ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_env score"
    FAIL "soft_env score"
    CLEAR_ERR
  END
  SYS CAT "soft_env:" ego ":se"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_env:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score pso ego note_msg
  CLEAR_ERR
END

