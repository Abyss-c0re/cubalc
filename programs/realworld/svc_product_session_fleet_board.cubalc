# svc_product_session_fleet_board.cubalc — product_session fleet product-tool contract
#
# Real use: fleet product agents gate full CLI+host+wall contract in one INCLUDE
# (tool_session = cli_boot+cli_guard+arg_guard, plus env_guard + time_guard)
# instead of multi-guard glue. First realworld of 1392 product_session
# (1.15.843+ · pairs tool_session / init --product).
#
#   DEFAULT NEED_FLAGS · NEED_FLAG_ANY · NEED_REST_N · NEED_ARGS · NEED_ARG_ANY
#   DEFAULT NEED_ENVS · NEED_ENV_ANY · NEED_TIME
#   *_GUARD_SOFT · INCLUDE product_session → PRODUCT_SESSION_OK / TOOL_SESSION_OK
#   CLI_GUARD_OK · ARG_GUARD_OK · ENV_GUARD_OK · TIME_GUARD_OK sticky
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_psf_$$
#   ./out/cubalc run programs/realworld/svc_product_session_fleet_board.cubalc boot
#   ./out/cubalc run ... pass|soft_flag|soft_env|soft_arg|soft_time|form|gate|probe|list
#   ./out/cubalc run -T 40 ... soft_time   # wall soft-miss under tight budget
#
# Plate: STATUS.txt VAL.txt META.txt PSF_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_PSF_REQUIRE
#
# Edges: LET knobs before each re-INCLUDE product_session (DEFAULT sticky);
#   hard NEED* miss exit_code 0; HASFORM misses sticky knobs (not forms);
#   PRINT clobber; WRITE NL; CUBALC_ARG* env for flag surface (not SYS ARG);
#   product_session re-INCLUDEs agent_boot (double boot OK); empty NEED_* skips

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_product_session_fleet_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_product_session_fleet -- boot|pass|soft_flag|soft_env|soft_arg|soft_time|form|gate|probe|list -- [--host=H] [--role=R] · -T for soft_time"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_PSF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "PSF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET pso = 0
LET tso = 0
LET cgo = 0
LET ago = 0
LET ego = 0
LET tgo = 0
LET remain_n = 0

ONEOF ACTION "boot", "pass", "soft_flag", "soft_env", "soft_arg", "soft_time", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_flag" THEN
    LET op = "soft_flag"
  WHEN "soft_env" THEN
    LET op = "soft_env"
  WHEN "soft_arg" THEN
    LET op = "soft_arg"
  WHEN "soft_time" THEN
    LET op = "soft_time"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-psf\",\"schema\":\"cubalc.svc_product_session_fleet.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"product_contract\",\"label\":\"psf\",\"cfg\":{\"surface\":\"product_session,tool_session,env_guard,time_guard,PRODUCT_SESSION_OK,TOOL_SESSION_OK,NEED_FLAGS,NEED_ENVS,NEED_TIME\",\"contract\":\"full CLI+env+wall · init --product\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"product_contract\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_product_session_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "product_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "product_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — full soft product_session green (flags+rest+env+time)
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # seed argv surface for flag/rest (CLI layer reads CUBALC_ARG*)
  SYS ENV SET CUBALC_ARG0 "--out=x"
  SYS ENV SET CUBALC_ARG1 "job0"
  SYS ENV SET CUBALC_ARGC "2"
  CLEAR_ERR
  LET NEED_FLAGS = "out"
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 1
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = "HOME"
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 0
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  LET tso = TOOL_SESSION_OK
  LET cgo = CLI_GUARD_OK
  LET ego = ENV_GUARD_OK
  LET tgo = TIME_GUARD_OK
  CLEAR_ERR
  IF pso == 1 THEN
    LET score = score + 1
  END
  IF tso == 1 THEN
    LET score = score + 1
  END
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF ego == 1 THEN
    LET score = score + 1
  END
  IF tgo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "PRODUCT_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "tool_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "env_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" pso ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score pso tso note_msg
  CLEAR_ERR
END

# soft_flag — missing required flag under CLI_GUARD_SOFT
SYS EQS op "soft_flag"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV UNSET CUBALC_ARG1
  CLEAR_ERR
  LET NEED_FLAGS = "missing_psf_flag"
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 1
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 0
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  LET tso = TOOL_SESSION_OK
  LET cgo = CLI_GUARD_OK
  CLEAR_ERR
  # expect soft miss on flags → product 0
  IF pso == 0 THEN
    LET score = score + 1
  END
  IF tso == 0 THEN
    LET score = score + 1
  END
  IF cgo == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOOL_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "product_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "product_session_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "CLI"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # second empty-contract soft re-INCLUDE recovers
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 0
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  CLEAR_ERR
  IF pso == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_flag ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_flag score"
    FAIL "soft_flag score"
    CLEAR_ERR
  END
  SYS CAT "soft_flag:" cgo ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_flag:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score pso cgo note_msg
  CLEAR_ERR
END

