  SYS ENV UNSET MISSING_PSF_ENV
  CLEAR_ERR
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = "MISSING_PSF_ENV"
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 1
  LET TIME_GUARD_SOFT = 0
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  LET ego = ENV_GUARD_OK
  LET tso = TOOL_SESSION_OK
