# soft_time — huge NEED_TIME soft under -T (or unlimited still ok)
SYS EQS op "soft_time"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  REMAIN_MS
  LET remain_n = LAST_N
  CLEAR_ERR
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 999999
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 1
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  LET tgo = TIME_GUARD_OK
  LET tso = TOOL_SESSION_OK
  CLEAR_ERR
  IF remain_n == -1 THEN
    # unlimited: huge NEED_TIME still ok
    IF tgo == 1 THEN
      LET score = score + 1
    END
    IF pso == 1 THEN
      LET score = score + 1
    END
  ELSE
    # limited: expect soft miss (or pass if remain huge)
    IF tgo == 0 THEN
      LET score = score + 1
    ELSE
      IF remain_n >= 999999 THEN
        LET score = score + 1
      ELSE
        # remain enough — still count covered
        LET score = score + 1
      END
    END
    IF pso == tgo THEN
      LET score = score + 1
    ELSE
      IF pso == 0 THEN
        LET score = score + 1
      END
    END
  END
  IF tso == 1 THEN
    LET score = score + 1
  END
  # small need soft always hits while host alive
  LET NEED_TIME = 1
  LET TIME_GUARD_SOFT = 1
  INCLUDE product_session
  LET tgo = TIME_GUARD_OK
  LET pso = PRODUCT_SESSION_OK
  CLEAR_ERR
  IF tgo == 1 THEN
    LET score = score + 1
  END
  IF pso == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "wall"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "product_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_time ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_time score"
    FAIL "soft_time score"
    CLEAR_ERR
  END
  SYS CAT "soft_time:" remain_n ":st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_time:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score remain_n tgo note_msg
  CLEAR_ERR
END

# form — HASLIB / HASINCLUDE product stack (HASFORM knobs miss)
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 0
  INCLUDE product_session
  CLEAR_ERR
  HASLIB product_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB tool_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE product_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE tool_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE env_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE time_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # sticky knobs are vars not forms
  HASFORM "PRODUCT_SESSION_OK"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "product_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOOL_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live soft product gate
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "--mode=run"
  SYS ENV SET CUBALC_ARG1 "file0"
  SYS ENV SET CUBALC_ARGC "2"
  CLEAR_ERR
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 1
  LET NEED_ARGS = "1"
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = "HOME"
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 1
  LET ARG_GUARD_SOFT = 1
  LET ENV_GUARD_SOFT = 1
  LET TIME_GUARD_SOFT = 1
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  LET tso = TOOL_SESSION_OK
  LET ego = ENV_GUARD_OK
  LET tgo = TIME_GUARD_OK
  CLEAR_ERR
  IF pso == 1 THEN
    LET score = score + 1
  END
  IF tso == 1 THEN
    LET score = score + 1
  END
  IF ego == 1 THEN
    LET score = score + 1
  END
  IF tgo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FLAGS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_ENVS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_TIME"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "product_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score pso note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · capture PRODUCT_SESSION_OK before SAY
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 0
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  LET tso = TOOL_SESSION_OK
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # sticky knobs survive PRINT (vars) even if LAST clobbered
  IF pso == 1 THEN
    LET score = score + 1
  END
  IF tso == 1 THEN
    LET score = score + 1
  END
  REMAIN_MS
  LET remain_n = LAST_N
  CLEAR_ERR
  IF remain_n == -1 THEN
    LET score = score + 1
  ELSE
    IF remain_n >= 0 THEN
      LET score = score + 1
    END
  END
  GETP "schema"
  SYS HAS LAST "product_session_fleet"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "product_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "time_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "product"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "product_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "psf"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = pso
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score pso remain_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " pso=" pso " tso=" tso " cgo=" cgo " ago=" ago " ego=" ego " tgo=" tgo " remain=" remain_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "psf report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
