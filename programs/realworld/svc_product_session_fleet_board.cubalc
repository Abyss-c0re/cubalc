  END
  CLEAR_ERR
  # recover empty arg contract
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET ARG_GUARD_SOFT = 0
  LET NEED_TIME = 1
  INCLUDE product_session
  LET pso = PRODUCT_SESSION_OK
  CLEAR_ERR
  IF pso == 1 THEN
    LET score = score + 1
