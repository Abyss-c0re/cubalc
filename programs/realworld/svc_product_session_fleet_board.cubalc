  LET NEED_REST_N = 0
  LET NEED_ARGS = "0"
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 1
