        EXIT 2 "startswith miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "startswith ok"
      SYS STR ret_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "startswith"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR ret_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
