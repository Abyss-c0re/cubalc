  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- gate: LENF >= MINLEN and COUNTINF >= MINHITS ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET o_ok = 0
    LET ln = 0
    LET hn = 0
    IF slot == 0 THEN
      HASOBJ i0
      IF LAST_N == 1 THEN
        LENF i0 note
        LET ln = LAST_N
        COUNTINF i0 note WANT
        LET hn = LAST_N
        SETF i0 nlen ln
        SETF i0 hits hn
        LET o_ok = 1
        DUMPOBJ i0
        SYS WRITE d_i0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ i1
      IF LAST_N == 1 THEN
        LENF i1 note
        LET ln = LAST_N
        COUNTINF i1 note WANT
        LET hn = LAST_N
        SETF i1 nlen ln
        SETF i1 hits hn
        LET o_ok = 1
        DUMPOBJ i1
        SYS WRITE d_i1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ i2
      IF LAST_N == 1 THEN
        LENF i2 note
        LET ln = LAST_N
        COUNTINF i2 note WANT
        LET hn = LAST_N
        SETF i2 nlen ln
        SETF i2 hits hn
        LET o_ok = 1
        DUMPOBJ i2
        SYS WRITE d_i2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "gate miss"
      FAIL "gate miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "gate miss"
      END
    ELSE
      LET ret_n = ln
      IF ln < MINLEN THEN
        LET miss = 1
        LET note_msg = "gate deny len"
        SYS STR ln
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate deny len"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR ln
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINLEN
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "gate deny len"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "gate deny len"
        END
      ELSE
        IF hn < MINHITS THEN
          LET miss = 1
          LET note_msg = "gate deny hits"
          SYS STR hn
          LET val = LAST
          LET val_ch = 1
          LET meta = "gate deny hits"
          SYS PUSH meta sn
          LET meta = LAST
          SYS STR hn
          SYS PUSH meta LAST
          LET meta = LAST
          SYS STR MINHITS
          SYS PUSH meta LAST
          LET meta = LAST
          LET meta_ch = 1
          FAIL "gate deny hits"
          CLEAR_ERR
          IF NEED_HIT > 0 THEN
            EXIT 2 "gate deny hits"
          END
        ELSE
          LET hit = 1
          LET note_msg = "gate admit"
          SYS STR ln
          LET val = LAST
          LET val_ch = 1
          LET meta = "gate admit"
          SYS PUSH meta sn
          LET meta = LAST
          SYS STR ln
          SYS PUSH meta LAST
          LET meta = LAST
          SYS STR hn
          SYS PUSH meta LAST
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- probe ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET p_ok = 1
  TRYHASINF nosuch note "x"
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYHASINF should soft-fail"
  END
  CLEAR_ERR
  TRYLENF nosuch note
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYLENF should soft-fail"
  END
  CLEAR_ERR
  TRYCOUNTINF nosuch note "x"
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYCOUNTINF should soft-fail"
  END
  CLEAR_ERR
  TRYCLEARF nosuch note
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYCLEARF should soft-fail"
  END
  CLEAR_ERR
  HASOBJ i0
  IF LAST_N == 1 THEN
    # case sensitive miss
    GETF i0 note
    LET save_n = LAST
    SETF i0 note "error lower only"
    HASINF i0 note "ERROR"
    IF LAST_N != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe HASINF case should miss"
    END
    HASIFI i0 note "ERROR"
    IF LAST_N != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe HASIFI should hit"
    END
    SETF i0 note save_n
    CLEAR_ERR
    # empty LEN
    SETF i0 note ""
    LENF i0 note
    IF LAST_N != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe empty LEN should 0"
    END
    EMPTYF i0 note
    IF LAST_N != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe EMPTYF should 1"
    END
    SETF i0 note save_n
    CLEAR_ERR
  END
  IF p_ok == 1 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET val = "probe"
    LET val_ch = 1
    LET meta = "probe soft"
    LET meta_ch = 1
  ELSE
    LET miss = 1
    FAIL note_msg
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "dump bad slot"
    FAIL "dump bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "dump bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ i0
      IF LAST_N == 1 THEN
        DUMPOBJ i0
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_i0 val
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ i1
      IF LAST_N == 1 THEN
        DUMPOBJ i1
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_i1 val
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ i2
      IF LAST_N == 1 THEN
        DUMPOBJ i2
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_i2 val
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "dump miss"
      FAIL "dump miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "dump miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "dump ok"
      LET val_ch = 1
      LET meta = "dump"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ i0
  IF LAST_N == 1 THEN
    DELETEOBJ i0
    CLEAR_ERR
  END
  HASOBJ i1
  IF LAST_N == 1 THEN
    DELETEOBJ i1
    CLEAR_ERR
  END
  HASOBJ i2
  IF LAST_N == 1 THEN
    DELETEOBJ i2
    CLEAR_ERR
  END
  SYS WRITE d_i0 ""
  SYS WRITE d_i1 ""
  SYS WRITE d_i2 ""
  SYS WRITE objs_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

