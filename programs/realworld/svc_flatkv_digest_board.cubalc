# svc_flatkv_digest_board.cubalc — FLATKV path:value nest digest + UNFLATKV rebuild
#
# Real use: export service nest as flat path:value inventory for digests/handoffs,
# slice under cfg.*, peer lat bags, then rebuild nest without multi SETP glue.
# First realworld of proof 1211 FLATKV + 1212 UNFLATKV.
#
#   FLATKV|LEAFKV|FLATTENP [FROM plate] [path]
#   UNFLATKV|FROMFLAT bag [UNDER path] [INTO plate]
#   LAST = path:value bag · LAST_N = FLATKV_N · FLATKV_PATH/SRC/FROM
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sfk_$$
#   ./out/cubalc run programs/realworld/svc_flatkv_digest_board.cubalc boot
#   ./out/cubalc run ... flat|slice|peer|rebuild|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SFK_REPORT.txt LEAVES.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SFK_REQUIRE
#
# Edges: full flat; relative cfg; peer FROM; UNFLATKV round-trip; soft miss;
#   LEAFKV alias; empty bag; empty object terminal; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_flatkv_digest_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_flatkv_digest -- boot|flat|slice|peer|rebuild|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeK"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SFK_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "LEAVES.txt"
LET leaves_file = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SFK_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "flat", "slice", "peer", "rebuild", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "flat" THEN
    LET op = "flat"
  WHEN "slice" THEN
    LET op = "slice"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "rebuild" THEN
    LET op = "rebuild"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-flatkv\",\"schema\":\"cubalc.svc_flatkv_digest.v1\",\"site\":\"" host_s "\",\"cfg\":{\"meta\":{\"role\":\"worker\",\"zone\":\"A\"},\"port\":\"8080\",\"ttl\":30},\"other\":{\"peer_host\":\"h2\",\"role\":\"leader\"},\"label\":\"flatkv\",\"n\":3,\"empty\":{}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_flatkv_digest.v1\",\"a\":{\"lat\":12},\"b\":{\"lat\":8},\"c\":{\"lat\":20},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "cfg.meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# flat — full plate path:value digest
SYS EQS op "flat"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n > 8 THEN
    LET score = score + 1
  END
  IF FLATKV_N == find_n THEN
    LET score = score + 1
  END
  SYS HASLINE body "cfg.meta.role:worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "cfg.port:8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "n:3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "label:flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # intermediates not listed
  SYS HASLINE body "cfg:"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # empty object terminal
  SYS HASLINE body "empty:"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "flat ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "flat score"
    FAIL "flat score"
    CLEAR_ERR
  END
  SYS CAT "flat:" find_n ":fl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "flat:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# slice — relative under cfg
SYS EQS op "slice"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV "cfg"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 4 THEN
    LET score = score + 1
  END
  SYS EQS FLATKV_PATH "cfg"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "meta.role:worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "port:8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "ttl:30"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # absolute path not in relative bag
  SYS HASLINE body "cfg.port:8080"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FLATKV "cfg.meta"
  LET admit_n = LAST_N
  LET row = LAST
  CLEAR_ERR
  IF admit_n == 2 THEN
    LET score = score + 1
  END
  SYS HASLINE row "role:worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "slice ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "slice score"
    FAIL "slice score"
    CLEAR_ERR
  END
  SYS CAT "slice:" find_n ":sl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "slice:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# peer — FROM PEER flat lat inventory
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV FROM PEER
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n >= 4 THEN
    LET score = score + 1
  END
  IF GREPFLAT_FROM == 1 THEN
    LET score = score + 0
  END
  IF FLATKV_FROM == 1 THEN
    LET score = score + 1
  END
  SYS EQS FLATKV_SRC "PEER"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "a.lat:12"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "b.lat:8"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "c.lat:20"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "tag:t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # agent plate intact
  GETP "label"
  SYS EQS LAST "flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" find_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# rebuild — FLATKV → UNFLATKV round-trip on scratch
SYS EQS op "rebuild"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n > 8 THEN
    LET score = score + 1
  END
  LET PLATE = "{}"
  UNFLATKV body
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == find_n THEN
    LET score = score + 1
  END
  IF UNFLATKV_N == find_n THEN
    LET score = score + 1
  END
  GETP "cfg.meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore agent plate from disk
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "rebuild ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "rebuild score"
    FAIL "rebuild score"
    CLEAR_ERR
  END
  SYS CAT "rebuild:" find_n ":rb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "rebuild:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — missing nest + empty bag unflat
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV "missing.nest"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF FLATKV_N == 0 THEN
    LET score = score + 1
  END
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  UNFLATKV ""
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — admit when leaf count meets inventory floor
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n >= 8 THEN
    LET score = score + 1
  END
  FLATKV "cfg"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n >= 4 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_flatkv_digest"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — LEAFKV + FLATTENP + FROMFLAT
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LEAFKV "cfg.meta"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF LEAFKV_N == 2 THEN
    LET score = score + 1
  END
  SYS HASLINE body "zone:A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FLATTENP
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n > 8 THEN
    LET score = score + 1
  END
  IF FLATTENP_N == admit_n THEN
    LET score = score + 1
  END
  LET PLATE = "{}"
  FROMFLAT "a.b:2"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "a.b"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore agent
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" find_n ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — edges: empty path, overlay merge, substring false friend
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FLATKV ""
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n > 8 THEN
    LET score = score + 1
  END
  # path prefix false friend: FLATKV path is nest root not bag filter
  FLATKV "cf"
  LET admit_n = LAST_N
  CLEAR_ERR
  # "cf" is not a path — soft miss expected (unlike GREPFLAT substring)
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  FLATKV "cfg"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 4 THEN
    LET score = score + 1
  END
  # overlay merge keeps n
  LET PLATE = "{\"host\":\"old\",\"n\":1}"
  UNFLATKV "host:new\ncfg.meta.zone:A"
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST "new"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.zone"
  SYS EQS LAST "A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "flatkv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_flatkv_digest.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_flatkv_digest_board: end"
