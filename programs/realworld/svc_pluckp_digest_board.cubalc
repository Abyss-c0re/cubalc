# svc_pluckp_digest_board.cubalc — multi-key PLUCKP health digest + NEEDP path gate
#
# Real use: ops agents harvest several nest fields (host, freq.error, lat.p99)
# in one PLUCKP shot (HIT/MISS/FROM/SRC), gate with NEEDP/HASPALL path keys,
# and emit STATUS digests. First realworld of proofs 1195 + 1194 path plane.
#
#   PLUCKP|GETPALL key… / path.nest · PLUCKP_HIT/MISS/N/FROM/SRC
#   HASPALL|NEEDP path keys · HASPALL_MISS soft list
#   … FROM PEER multi-plate · slash alias a/b
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_spd_$$
#   ./out/cubalc run programs/realworld/svc_pluckp_digest_board.cubalc boot
#   ./out/cubalc run ... pluck|peer|soft|gate|digest|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SPD_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SPD_REQUIRE
#
# Edges:
#   PLUCKP miss empty + MISS count; HASPALL miss bag; false-friend paths;
#   WRITE NL; NUM softens REQUIRE; EXIT shell (W7); SYS NTH bag-name glue

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_pluckp_digest_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_pluckp_digest -- boot|pluck|peer|soft|gate|digest|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeX"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SPD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SPD_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET path_val = ""
LET dig_host = ""
LET dig_err = ""
LET dig_p99 = ""

ONEOF ACTION "boot", "pluck", "peer", "soft", "gate", "digest", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pluck" THEN
    LET op = "pluck"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "digest" THEN
    LET op = "digest"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — seed nested health + peer mesh; PLUCKP multi-key smoke
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-pluck\",\"schema\":\"cubalc.svc_pluckp_digest.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"n\":1,\"freq\":{\"error\":3,\"warn\":7,\"info\":12},\"lat\":{\"p50\":40,\"p99\":180},\"flags\":{\"live\":1,\"debug\":0},\"meta\":{\"role\":\"" role_s "\",\"zone\":\"east\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"schema\":\"cubalc.svc_pluckp_digest.v1\",\"meta\":{\"role\":\"edge\",\"n\":9},\"freq\":{\"error\":1,\"warn\":2},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  PLUCKP "host" "freq.error" "lat.p99" "n"
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "host"
  LET dig_host = LAST
  CLEAR_ERR
  SYS EQS dig_host host_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "freq.error"
  LET dig_err = LAST
  CLEAR_ERR
  SYS EQS dig_err "3"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "lat.p99"
  LET dig_p99 = LAST
  CLEAR_ERR
  SYS EQS dig_p99 "180"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF take_n == 4 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF soft_ok == 1 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET miss_n = 0
          LET has_n = 4
        ELSE
          LET miss = 1
          LET note_msg = "boot p99"
          FAIL "boot p99"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot error"
        FAIL "boot error"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot host"
      FAIL "boot host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot pluck n"
    FAIL "boot pluck n"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n miss_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# pluck — multi-key PLUCKP dotted + slash + GETPALL alias
SYS EQS op "pluck"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PLUCKP "host" "freq.error" "lat.p99" "role"
  LET take_n = LAST_N
  LET has_n = LAST_N
  LET miss_n = 0
  CLEAR_ERR
  GETP "host"
  LET dig_host = LAST
  CLEAR_ERR
  GETP "freq.error"
  LET dig_err = LAST
  CLEAR_ERR
  GETP "lat.p99"
  LET dig_p99 = LAST
  CLEAR_ERR
  SYS EQS dig_err "3"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS EQS dig_p99 "180"
  LET load_hit = LAST_N
  CLEAR_ERR
  # slash alias multi-key
  PLUCKP "freq/error" "lat/p50"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "freq.error"
  SYS EQS LAST "3"
  LET gate_ok = LAST_N
  CLEAR_ERR
  GETPALL "n" "freq.warn"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "freq.warn"
  SYS EQS LAST "7"
  LET path_val = LAST_N
  CLEAR_ERR
  IF take_n == 4 THEN
    IF has_n == 4 THEN
      IF miss_n == 0 THEN
        IF peel_hit == 1 THEN
          IF load_hit == 1 THEN
            IF soft_ok == 2 THEN
              IF gate_ok == 1 THEN
                IF admit_n == 2 THEN
                  IF path_val == 1 THEN
                    LET hit = 1
                    LET note_msg = "pluck ok"
                    LET admit_n = 1
                  ELSE
                    LET miss = 1
                    LET note_msg = "pluck warn val"
                    FAIL "pluck warn val"
                    CLEAR_ERR
                  END
                ELSE
                  LET miss = 1
                  LET note_msg = "pluck getpall hit"
                  FAIL "pluck getpall hit"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "pluck slash val"
                FAIL "pluck slash val"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "pluck slash hit"
              FAIL "pluck slash hit"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "pluck p99"
            FAIL "pluck p99"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "pluck error"
          FAIL "pluck error"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "pluck miss n"
        FAIL "pluck miss n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "pluck hit n"
      FAIL "pluck hit n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "pluck n"
    FAIL "pluck n"
    CLEAR_ERR
  END
  SYS CAT "pluck:" dig_host ":" dig_err ":" dig_p99 ":pk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pluck:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n dig_host dig_err dig_p99 has_n soft_ok note_msg
  CLEAR_ERR
END

# peer — PLUCKP FROM PEER + NEEDP FROM PEER path
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PLUCKP FROM PEER "meta.role" "meta.n" "freq.error" "agent"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS EQS PLUCKP_SRC "PEER"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET take_n = peel_hit
  LET miss_n = 0
  CLEAR_ERR
  GETP FROM PEER "meta.role"
  SYS EQS LAST "edge"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "meta.n"
  SYS EQS LAST "9"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP FROM PEER "freq.error"
  SYS EQS LAST "1"
  LET gate_ok = LAST_N
  CLEAR_ERR
  NEEDP FROM PEER "meta.role" "freq.error"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET admit_n = 0
  END
  CLEAR_ERR
  GETP "role"
  LET dig_host = LAST
  CLEAR_ERR
  SYS EQS dig_host role_s
  LET path_val = LAST_N
  CLEAR_ERR
  IF take_n == 1 THEN
    IF has_n == 4 THEN
      IF miss_n == 0 THEN
        IF peel_hit == 1 THEN
          IF load_hit == 1 THEN
            IF soft_ok == 1 THEN
              IF gate_ok == 1 THEN
                IF admit_n == 1 THEN
                  IF path_val == 1 THEN
                    LET hit = 1
                    LET note_msg = "peer ok"
                    LET admit_n = 1
                  ELSE
                    LET miss = 1
                    LET note_msg = "peer plate role"
                    FAIL "peer plate role"
                    CLEAR_ERR
                  END
                ELSE
                  LET miss = 1
                  LET note_msg = "peer needp"
                  FAIL "peer needp"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "peer freq.error"
                FAIL "peer freq.error"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "peer meta.n"
              FAIL "peer meta.n"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer meta.role"
            FAIL "peer meta.role"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer src"
          FAIL "peer src"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer miss"
        FAIL "peer miss"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer hit"
      FAIL "peer hit"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer from"
    FAIL "peer from"
    CLEAR_ERR
  END
  SYS CAT "peer:edge:pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

# soft — PLUCKP miss counts + HASPALL miss bag + false friends
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PLUCKP "host" "freq.crit" "ghost.x" "lat.p99"
  LET take_n = LAST_N
  CLEAR_ERR
  PLUCKP "freq.crit"
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  PLUCKP "ghost.x"
  SYS EMPTY LAST
  LET load_hit = LAST_N
  CLEAR_ERR
  PLUCKP "lat.p99"
  SYS EQS LAST "180"
  LET soft_ok = LAST_N
  CLEAR_ERR
  PLUCKP "host"
  SYS EQS LAST host_s
  LET has_n = LAST_N
  CLEAR_ERR
  LET miss_n = 0
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      LET miss_n = 2
    END
  END
  CLEAR_ERR
  HASPALL "host" "freq.crit" "freq.error"
  LET admit_n = LAST_N
  LET w_s = LAST
  CLEAR_ERR
  SYS HASLINE w_s "freq.crit"
  LET gate_ok = LAST_N
  CLEAR_ERR
  HASP "freq.err"
  LET path_val = LAST_N
  CLEAR_ERR
  IF take_n == 4 THEN
    IF has_n == 1 THEN
      IF miss_n == 2 THEN
        IF peel_hit == 1 THEN
          IF load_hit == 1 THEN
            IF soft_ok == 1 THEN
              IF admit_n == 0 THEN
                IF gate_ok == 1 THEN
                  IF path_val == 0 THEN
                    LET hit = 1
                    LET note_msg = "soft ok"
                    LET admit_n = 1
                  ELSE
                    LET miss = 1
                    LET note_msg = "soft false err"
                    FAIL "soft false err"
                    CLEAR_ERR
                  END
                ELSE
                  LET miss = 1
                  LET note_msg = "soft hasall miss list"
                  FAIL "soft hasall miss list"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "soft hasall n"
                FAIL "soft hasall n"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "soft p99 keep"
              FAIL "soft p99 keep"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft ghost empty"
            FAIL "soft ghost empty"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft crit empty"
          FAIL "soft crit empty"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft miss n"
        FAIL "soft miss n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft host"
      FAIL "soft host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft pluck n"
    FAIL "soft pluck n"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:hit" has_n ":miss" miss_n ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n miss_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

# gate — NEEDP path contract + HASPALL all present
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  HASPALL "host" "freq.error" "lat.p99" "role"
  LET has_n = LAST_N
  LET take_n = 4
  CLEAR_ERR
  IF has_n == 0 THEN
    LET take_n = 0
  END
  CLEAR_ERR
  NEEDP "host" "freq.error" "lat.p99"
  LET peel_hit = LAST_N
  LET load_hit = 3
  CLEAR_ERR
  IF OK == 0 THEN
    LET peel_hit = 0
    LET load_hit = 0
  END
  CLEAR_ERR
  NEEDP "freq/warn" "lat/p50"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET soft_ok = 0
  END
  CLEAR_ERR
  HASP "lat.p9"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF take_n == 4 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 3 THEN
          IF soft_ok == 1 THEN
            IF miss_n == 0 THEN
              LET hit = 1
              LET gate_ok = 1
              LET admit_n = 1
              LET note_msg = "gate ok"
            ELSE
              LET miss = 1
              LET note_msg = "gate false p9"
              FAIL "gate false p9"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "gate slash need"
            FAIL "gate slash need"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate need hit"
          FAIL "gate need hit"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate need n"
        FAIL "gate need n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate has hit"
      FAIL "gate has hit"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate hasall"
    FAIL "gate hasall"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok has_n take_n peel_hit note_msg
  CLEAR_ERR
END

# digest — harvest multi-key peel into ops STATUS digest row
SYS EQS op "digest"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  NEEDP "host" "freq.error" "lat.p99" "n"
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET peel_hit = 0
  END
  CLEAR_ERR
  PLUCKP "host" "freq.error" "lat.p99" "freq.warn" "n"
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "host"
  LET dig_host = LAST
  CLEAR_ERR
  GETP "freq.error"
  LET dig_err = LAST
  CLEAR_ERR
  GETP "lat.p99"
  LET dig_p99 = LAST
  CLEAR_ERR
  GETP "freq.warn"
  LET path_val = LAST
  CLEAR_ERR
  SYS NUM dig_err
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS NUM dig_p99
  LET miss_n = LAST_N
  CLEAR_ERR
  PLUCKP FROM PEER "freq.error" "meta.role"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "freq.error"
  LET soft_ok = LAST
  CLEAR_ERR
  GETP FROM PEER "meta.role"
  LET w_s = LAST
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF take_n == 5 THEN
      IF load_hit >= 3 THEN
        IF miss_n >= 180 THEN
          SYS EQS soft_ok "1"
          LET gate_ok = LAST_N
          CLEAR_ERR
          SYS EQS w_s "edge"
          LET admit_n = LAST_N
          CLEAR_ERR
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              IF has_n == 2 THEN
                LET hit = 1
                LET note_msg = "digest ok"
                LET admit_n = 1
                SYS CAT "digest:" dig_host ":err=" dig_err ":p99=" dig_p99 ":warn=" path_val ":peer_err=" soft_ok ":dg"
                LET row = LAST
                CLEAR_ERR
              ELSE
                LET miss = 1
                LET note_msg = "digest peer hit"
                FAIL "digest peer hit"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "digest peer role"
              FAIL "digest peer role"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "digest peer err"
            FAIL "digest peer err"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "digest p99 lo"
          FAIL "digest p99 lo"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "digest err lo"
        FAIL "digest err lo"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "digest pluck hit"
      FAIL "digest pluck hit"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "digest need"
    FAIL "digest need"
    CLEAR_ERR
  END
  IF hit == 1 THEN
    SYS GREPV "digest:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n dig_host dig_err dig_p99 take_n note_msg
  CLEAR_ERR
END

# probe — FROM flags, empty bag, peer partial miss, GETPALL shallow
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PLUCKP "host" "n"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS EQS PLUCKP_SRC "PLATE"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LET take_n = 0
  IF peel_hit == 0 THEN
    LET take_n = 1
  END
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET load_hit = LAST_N
  CLEAR_ERR
  PLUCKP FROM PEER "tag" "ghost"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # one hit (tag) one miss (ghost) → soft_ok bag n=2
  LET miss_n = 1
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  LET gate_ok = LAST_N
  CLEAR_ERR
  PLUCKP FROM PEER "ghost"
  SYS EMPTY LAST
  LET admit_n = LAST_N
  CLEAR_ERR
  GETPALL "agent" "schema"
  LET path_val = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS HAS LAST "svc-pluck"
  LET dig_err = LAST_N
  CLEAR_ERR
  IF has_n == 2 THEN
    IF take_n == 0 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 0 THEN
          IF miss_n == 1 THEN
            IF soft_ok == 2 THEN
              IF gate_ok == 1 THEN
                IF admit_n == 1 THEN
                  IF path_val == 2 THEN
                    IF dig_err == 1 THEN
                      LET hit = 1
                      LET note_msg = "probe ok"
                      LET admit_n = 1
                    ELSE
                      LET miss = 1
                      LET note_msg = "probe agent"
                      FAIL "probe agent"
                      CLEAR_ERR
                    END
                  ELSE
                    LET miss = 1
                    LET note_msg = "probe getpall"
                    FAIL "probe getpall"
                    CLEAR_ERR
                  END
                ELSE
                  LET miss = 1
                  LET note_msg = "probe ghost empty"
                  FAIL "probe ghost empty"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "probe tag"
                FAIL "probe tag"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe peer hit"
              FAIL "probe peer hit"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe peer miss"
            FAIL "probe peer miss"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe empty bag"
          FAIL "probe empty bag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe src plate"
        FAIL "probe src plate"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe from flag"
      FAIL "probe from flag"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe host n"
    FAIL "probe host n"
    CLEAR_ERR
  END
  SYS CAT "probe:pluck:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit miss_n soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_pluckp_digest.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_pluckp_digest_board: end"
