# svc_checkdeps_install_board.cubalc — CHECKDEPS/HASDEPS/NEEDDEPS install gate
#
# Real use: fleet agents gate INCLUDE/deploy on complete transitive lib trees
# before boot — miss bag for install plans, soft absent stems. First realworld
# of proof 1302 CHECKDEPS/HASDEPS/NEEDDEPS.
#
#   HASDEPS stem  → LAST_N=1 hit / 0 miss · DEPS_N · DEPS_OK · DEPS_MISS
#   CHECKDEPS stem → LAST = miss bag · LAST_N=0 means complete (OK always 1!)
#   NEEDDEPS stem → hard-style assert helper · LAST_N=1 on complete
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_scd_$$
#   ./out/cubalc run programs/realworld/svc_checkdeps_install_board.cubalc boot
#   ./out/cubalc run ... fat|check|leaf|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SCD_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SCD_REQUIRE
#
# Edges: CHECKDEPS OK always 1 even on miss; LAST_N=0 is success false friend;
#   HASDEPS OK=0 on miss; WRITE NL; REQUIRE softens; EXIT shell (W7)

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_checkdeps_install_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_checkdeps_install -- boot|fat|check|leaf|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SCD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SCD_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET deps_n = 0
LET ok_n = 0
LET miss_n = 0
LET has_hit = 0

ONEOF ACTION "boot", "fat", "check", "leaf", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "fat" THEN
    LET op = "fat"
  WHEN "check" THEN
    LET op = "check"
  WHEN "leaf" THEN
    LET op = "leaf"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-checkdeps\",\"schema\":\"cubalc.svc_checkdeps_install.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_stem\":\"fat_session\",\"min_deps\":3,\"label\":\"checkdeps\",\"cfg\":{\"gate\":\"install\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"install\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_checkdeps_install"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_stem"
  SYS EQS LAST "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# fat — HASDEPS complete tree
SYS EQS op "fat"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASDEPS fat_session
  LET has_hit = LAST_N
  LET deps_n = DEPS_N
  LET ok_n = DEPS_OK_N
  LET miss_n = DEPS_MISS_N
  LET sum_v = OK
  LET sum_n = has_hit
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF has_hit == 1 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  IF deps_n >= 3 THEN
    LET score = score + 1
  END
  IF ok_n == deps_n THEN
    LET score = score + 1
  END
  SYS HASLINE DEPS_OK "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE DEPS_OK "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE DEPS_OK "plate_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "fat ok"
    LET admit_n = deps_n
    LET find_n = ok_n
  ELSE
    LET miss = 1
    LET note_msg = "fat score"
    FAIL "fat score"
    CLEAR_ERR
  END
  SYS CAT "fat:" deps_n ":ft"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fat:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n ok_n miss_n score note_msg
  CLEAR_ERR
END

# check — CHECKDEPS empty miss bag = complete
SYS EQS op "check"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  CHECKDEPS fat_session
  LET sum_v = OK
  LET sum_n = LAST_N
  LET miss_n = DEPS_MISS_N
  LET deps_n = DEPS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  # LAST_N=0 is success (empty miss bag) — false friend vs HASDEPS hit
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  GETP "want_stem"
  SYS EQS LAST "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.gate"
  SYS EQS LAST "install"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "min_deps"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "check ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "check score"
    FAIL "check score"
    CLEAR_ERR
  END
  SYS CAT "check:0:ck"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "check:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_n miss_n score note_msg
  CLEAR_ERR
END

# leaf — NEEDDEPS + HASDEPS agent_boot (single node)
SYS EQS op "leaf"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEEDDEPS plate_tick
  LET sum_v = OK
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  HASDEPS agent_boot
  LET has_hit = LAST_N
  LET deps_n = DEPS_N
  LET ok_n = DEPS_OK_N
  LET miss_n = DEPS_MISS_N
  CLEAR_ERR
  IF has_hit == 1 THEN
    LET score = score + 1
  END
  IF deps_n == 1 THEN
    LET score = score + 1
  END
  IF ok_n == 1 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  SYS HASLINE DEPS_OK "agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "leaf ok"
    LET admit_n = deps_n
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "leaf score"
    FAIL "leaf score"
    CLEAR_ERR
  END
  SYS CAT "leaf:1:lf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "leaf:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n score note_msg
  CLEAR_ERR
END

# soft — ghost stem miss paths
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASDEPS no_such_lib_xyz_zzz
  LET sum_v = OK
  LET has_hit = LAST_N
  LET miss_n = DEPS_MISS_N
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF has_hit == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE DEPS_MISS "no_such_lib_xyz_zzz"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # CHECKDEPS: OK stays 1, LAST_N is miss bag size
  CHECKDEPS ghostpath_lib_999
  LET sum_n = OK
  LET find_n = LAST_N
  LET admit_n = DEPS_MISS_N
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF find_n >= 1 THEN
    LET score = score + 1
  END
  IF admit_n >= 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n sum_v find_n score note_msg
  CLEAR_ERR
END

# gate — min_deps floor via HASDEPS
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASDEPS fat_session
  LET deps_n = DEPS_N
  LET miss_n = DEPS_MISS_N
  LET has_hit = LAST_N
  CLEAR_ERR
  IF has_hit == 1 THEN
    LET score = score + 1
  END
  IF deps_n >= 3 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_checkdeps_install"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "min_deps"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_stem"
  SYS EQS LAST "fat_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET admit_n = 1
    LET find_n = deps_n
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n score note_msg
  CLEAR_ERR
END

# alias — CHECKDEPS vs HASDEPS dual on complete tree
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASDEPS fat_session
  LET has_hit = LAST_N
  LET deps_n = DEPS_N
  CLEAR_ERR
  IF has_hit == 1 THEN
    LET score = score + 1
  END
  CHECKDEPS fat_session
  LET sum_n = LAST_N
  LET miss_n = DEPS_MISS_N
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 0 THEN
    LET score = score + 1
  END
  NEEDDEPS fat_session
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = deps_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" deps_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n has_hit sum_n score note_msg
  CLEAR_ERR
END

# probe — dual LAST_N + CHECKDEPS OK-always-1 + false friend stem
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASDEPS fat_session
  LET has_hit = LAST_N
  LET deps_n = DEPS_N
  CLEAR_ERR
  # HASDEPS LAST_N is boolean hit (1), not DEPS_N
  IF has_hit == 1 THEN
    LET score = score + 1
  END
  IF has_hit != deps_n THEN
    LET score = score + 1
  END
  IF deps_n >= 3 THEN
    LET score = score + 1
  END
  CHECKDEPS fat_session
  LET sum_n = LAST_N
  LET sum_v = OK
  CLEAR_ERR
  # CHECKDEPS success: LAST_N=0 empty miss
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  CHECKDEPS no_such_lib_xyz_zzz
  LET find_n = LAST_N
  LET admit_n = OK
  LET miss_n = DEPS_MISS_N
  CLEAR_ERR
  # miss still OK=1 (not soft-fail like HASDEPS)
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  IF find_n >= 1 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  # false friend: fat_boot is dep not root of this HASDEPS
  HASDEPS fat_session
  SYS HASLINE DEPS_OK "fat_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "checkdeps"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = deps_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" deps_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n deps_n has_hit sum_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_checkdeps_install.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " deps=" deps_n " miss_n=" miss_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n deps_n note_msg
NOTE "svc_checkdeps_install_board: end"
