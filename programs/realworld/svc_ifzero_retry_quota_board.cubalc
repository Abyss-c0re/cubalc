# svc_ifzero_retry_quota_board.cubalc — IFZERO/IFNZ/IFPOS/IFNEG retry quota
#
# Real use: job/pool agents admit or drain retry/quota counters by
# numeric sign without IFEQN/IFGT glue. First realworld of 1489
# IFZERO/IFNZ/IFPOS/IFNEG (1.15.948 · MI 950). Distinct from
# retry_budget_band / quota_floor_cap (band math) — this board is
# *sign branches for try_n left / overdraft / countdown*.
#
#   IFZERO · IFNZ · IFPOS · IFNEG · IFZERO_N · IFZERO_VAL · stickies
#   FN-wrap (W853) · str "0" not zero · undef soft · countdown DEC
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_izq_$$
#   ./out/cubalc run programs/realworld/svc_ifzero_retry_quota_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IZQ_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_IZQ_REQUIRE
#
# Edges: str "0" not IFZERO; undef not zero; neg overdraft; pos admit;
#   FN-wrap; STATUS bare; STRTO VAL

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN is_zero
  IFZERO v
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_nz
  IFNZ v
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_pos
  IFPOS v
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_neg
  IFNEG v
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# admit retry only when try_n left (flat probes — nested IF steals FN END)
FN admit_retry
  LET state = "deny-bad"
  LET ok_v = 0
  LET v = try_n
  CALL is_pos
  LET pos_hit = ok_v
  CALL is_zero
  LET zero_hit = ok_v
  CALL is_neg
  LET neg_hit = ok_v
  IF pos_hit == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
  IF pos_hit == 0 THEN
    IF zero_hit == 1 THEN
      LET state = "deny-exhausted"
      LET ok_v = 0
    END
  END
  IF pos_hit == 0 THEN
    IF zero_hit == 0 THEN
      IF neg_hit == 1 THEN
        LET state = "deny-overdraft"
        LET ok_v = 0
      END
    END
  END
END

# spend one try if nz
FN spend_try
  LET state = "skip-empty"
  LET ok_v = 0
  LET v = try_n
  CALL is_nz
  IF ok_v == 1 THEN
    DEC try_n
    LET state = "spent"
    LET ok_v = 1
  END
END

# classify quota sign (flat)
FN class_quota
  LET state = "unknown"
  LET ok_v = 0
  LET v = try_n
  CALL is_pos
  LET pos_hit = ok_v
  CALL is_zero
  LET zero_hit = ok_v
  CALL is_neg
  LET neg_hit = ok_v
  IF pos_hit == 1 THEN
    LET state = "healthy"
    LET ok_v = 1
  END
  IF pos_hit == 0 THEN
    IF zero_hit == 1 THEN
      LET state = "empty"
      LET ok_v = 0
    END
  END
  IF pos_hit == 0 THEN
    IF zero_hit == 0 THEN
      IF neg_hit == 1 THEN
        LET state = "overdraft"
        LET ok_v = 0
      END
    END
  END
END

FN ghost_is_zero
  IFZERO ghost_never_izq
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN ghost_is_nz
  IFNZ ghost_never_izq
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

NOTE "svc_ifzero_retry_quota_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_ifzero_retry_quota -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IZQ_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IZQ_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "quota"
LET quota_dir = LAST
SYS JOIN quota_dir "tries.txt"
LET try_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET v = 0
LET try_n = 0
LET state = ""
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-izq\",\"schema\":\"cubalc.svc_ifzero_retry_quota.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"izq\",\"want_filter\":\"ifzero_retry_quota\",\"cfg\":{\"surface\":\"IFZERO,IFNZ,IFPOS,IFNEG,IFZERO_N,IFZERO_VAL\",\"contract\":\"sign branches for retry/quota counters\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR quota_dir
  CLEAR_ERR
  SYS WRITE try_path "3"
  CLEAR_ERR
  LET v = 0
  CALL is_zero
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-izq"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFZERO_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = IFZERO_VAL
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot zero"
      FAIL "boot zero"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFZERO/IFNZ/IFPOS/IFNEG core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET v = 0
  CALL is_zero
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFZERO_N == 1 THEN
    LET score = score + 1
  END
  IF IFZERO_VAL == 0 THEN
    LET score = score + 1
  END
  LET v = 7
  CALL is_zero
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL is_nz
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFNZ_N == 1 THEN
    LET score = score + 1
  END
  CALL is_pos
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFPOS_N == 1 THEN
    LET score = score + 1
  END
  LET v = -3
  CALL is_neg
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFNEG_N == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — str "0" · undef · signs · spend
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # str "0" is not numeric zero
  LET v = "0"
  CALL is_zero
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CALL is_nz
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  # undef ghost
  CALL ghost_is_zero
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL ghost_is_nz
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # zero vs pos vs neg class
  LET try_n = 0
  CALL class_quota
  SYS EQS state "empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = 5
  CALL class_quota
  SYS EQS state "healthy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = -2
  CALL class_quota
  SYS EQS state "overdraft"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # spend from 2 → 1
  LET try_n = 2
  CALL spend_try
  SYS EQS state "spent"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF try_n == 1 THEN
    LET score = score + 1
  END
  # spend from 0 → skip
  LET try_n = 0
  CALL spend_try
  SYS EQS state "skip-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi counter class
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET try_n = 3
  CALL admit_retry
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = 0
  CALL admit_retry
  SYS EQS state "deny-exhausted"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = -1
  CALL admit_retry
  SYS EQS state "deny-overdraft"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = 1
  CALL spend_try
  IF try_n == 0 THEN
    LET score = score + 1
  END
  CALL admit_retry
  SYS EQS state "deny-exhausted"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET v = 0
  CALL is_zero
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET v = 9
  CALL is_pos
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET v = -9
  CALL is_neg
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifzero_retry_quota"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — countdown ladder 3→0
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET try_n = 3
  CALL admit_retry
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL spend_try
  IF try_n == 2 THEN
    LET score = score + 1
  END
  CALL spend_try
  IF try_n == 1 THEN
    LET score = score + 1
  END
  CALL class_quota
  SYS EQS state "healthy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL spend_try
  IF try_n == 0 THEN
    LET score = score + 1
  END
  CALL class_quota
  SYS EQS state "empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL spend_try
  SYS EQS state "skip-empty"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = -1
  CALL class_quota
  SYS EQS state "overdraft"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFZERO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFZERO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFNZ"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFPOS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "IFNEG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "WHENZERO"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "WHENNZ"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "IFZERO_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifzero_retry_quota"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFZERO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "IFPOS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit only positive try_n; deny zero/neg
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET try_n = 4
  CALL admit_retry
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = 0
  CALL admit_retry
  SYS EQS state "deny-exhausted"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = -5
  CALL admit_retry
  SYS EQS state "deny-overdraft"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET try_n = 1
  CALL admit_retry
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL spend_try
  IF try_n == 0 THEN
    LET score = score + 1
  END
  CALL admit_retry
  SYS EQS state "deny-exhausted"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET v = 0
  CALL is_zero
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET v = 1
  CALL is_pos
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "sign branches"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk try_n · WRITE NL · NUM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR quota_dir
  CLEAR_ERR
  SYS WRITE try_path "2"
  CLEAR_ERR
  SYS READ try_path
  LET body = LAST
  CLEAR_ERR
  NUMTO body
  IF NUMTO_OK == 1 THEN
    LET try_n = body
    LET score = score + 1
  END
  CALL admit_retry
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET v = 0
  CALL is_zero
  LET saved = IFZERO_N
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 1 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "ifzero=" IFZERO_N " val=" IFZERO_VAL
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "ifzero="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "izq_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "izq_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-izq"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-izq\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_ifzero_retry_quota_board: done"
PASS
