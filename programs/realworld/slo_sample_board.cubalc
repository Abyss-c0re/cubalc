# slo_sample_board.cubalc — durable pure-ms latency sample bag under STATE
#
# Real use: agents append probe samples, SQUEEZE blank intake noise, and
# report SUM/AVG/MEDIAN/MIN/MAX without shell awk. Breach counts samples
# above threshold via EACH+CMP.
#
# Actions (CUBALC_ARG0 / CUBALC_SLO_ACTION):
#   list     — depth + sum/avg/median/min/max + breach_n (default)
#   seed     — WORDS of ms ints into bag
#   observe  — PUSH one sample (ARG1=ms)
#   squeeze  — SQUEEZE [BLANK] drop empty/blank fields
#   breach   — count samples > THRESH (ARG1 or CUBALC_SLO_THRESH)
#   trim     — TAKE last-window? use TAKE N (ARG1) keep first N after SORTN DESC hot
#   clear    — empty bag
#   has      — HASLINE exact ms token
#   count    — COUNTLINE exact ms token
#   drop     — REMOVELINE first exact ms
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1="120 50 200 50 95" \
#     ./out/cubalc run -q -s programs/realworld/slo_sample_board.cubalc
#   CUBALC_ARG0=list ./out/cubalc run -q -s ...
#   CUBALC_ARG0=observe CUBALC_ARG1=180 ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_SLO_FILE=SAMPLES.txt
#   CUBALC_SLO_THRESH=100
#   CUBALC_SLO_REQUIRE=1
#   CUBALC_SLO_BLANK=1   # squeeze BLANK mode
#
# Edges deliberately stressed:
#   MEDIAN empty bag → 0 OK=1 (not soft miss) — silent zero
#   MEDIAN skips non-numeric; even count lower mid
#   SQUEEZE without BLANK keeps whitespace-only fields
#   SQUEEZE/MEDIAN/SUM return LAST — need LET bag = LAST after squeeze
#   pure tokens avoid name:ms peel tax of probe_latency_board
#   COUNTLINE exact value only
#   PRINT_JSON bag collapse; WRITE trailing NL
#   soft READ empty; REQUIRE on drop miss / empty list optional

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "slo_sample_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT RFILE = "SAMPLES.txt"
DEFAULT REPORT = "SAMPLES_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT THRESH = 100
DEFAULT BLANK_MODE = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_SLO_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_SLO_NAME" OR ""
  LET NAME = LAST
END
SYS ENV "CUBALC_SLO_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_SLO_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_SLO_THRESH" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET THRESH = LAST_N
  END
END
SYS ENV "CUBALC_SLO_BLANK" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET BLANK_MODE = LAST_N
  END
END

# breach: ARG1 may override thresh when action=breach
SYS EQS ACTION "breach"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    SYS PREPEND "" NAME
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET THRESH = LAST_N
    END
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR "soft samples load"
SYS LINES bag
LET depth0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET sum_ms = 0
LET avg_ms = 0
LET med_ms = 0
LET min_ms = 0
LET max_ms = 0
LET n_breach = 0
LET n_num = 0
LET note_msg = "ok"
LET sample = 0

# helper: compute stats into vars (does not mutate bag)
# used by list/breach post

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS SQUEEZE bag
  LET clean = LAST
  SYS LINES clean
  LET n_num = LAST_N
  IF n_num == 0 THEN
    LET sum_ms = 0
    LET avg_ms = 0
    LET med_ms = 0
    LET min_ms = 0
    LET max_ms = 0
    LET n_breach = 0
    LET note_msg = "list empty"
    IF REQUIRE_HIT > 0 THEN
      FAIL "list empty samples"
      CLEAR_ERR
      EXIT 2 "list empty"
    END
  ELSE
    SYS SUM clean
    LET sum_ms = LAST_N
    SYS AVG clean
    LET avg_ms = LAST_N
    SYS MEDIAN clean
    LET med_ms = LAST_N
    SYS SORTN clean
    LET sorted = LAST
    SYS HEAD sorted
    SYS NUM
    LET min_ms = LAST_N
    SYS TAIL sorted
    SYS NUM
    LET max_ms = LAST_N
    LET n_breach = 0
    EACH LINE AS row IN clean
      SYS PREPEND "" row
      SYS HEAD LAST
      SYS NUM
      IF OK == 1 THEN
        SYS CMP LAST_N THRESH
        IF LAST_N > 0 THEN
          LET n_breach = n_breach + 1
        END
      END
    END
    LET note_msg = "list ok"
  END
  STATUS
  PRINT "slo" depth0 n_num sum_ms avg_ms med_ms min_ms max_ms n_breach ACTION
  PRINT_JSON depth0 n_num sum_ms avg_ms med_ms min_ms max_ms n_breach THRESH ACTION STATUS_OK
  PRINT_JSON bag
  PRINT_JSON clean
END

# --- seed WORDS of ms ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs ms values"
  END
  SYS WORDS NAME
  LET vals = LAST
  EACH LINE AS v IN vals
    SYS BLANK v
    IF LAST_N == 0 THEN
      SYS PREPEND "" v
      SYS HEAD LAST
      SYS NUM
      IF OK == 1 THEN
        SYS STR LAST_N
        SYS PUSH bag LAST
        LET bag = LAST
        LET changed = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded"
END

# --- observe one sample ---
SYS EQS ACTION "observe"
IF LAST_N == 1 THEN
  NOTE "action observe"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "observe needs ms"
  END
  SYS PREPEND "" NAME
  SYS HEAD LAST
  SYS NUM
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "observe not num"
    FAIL "observe not numeric"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "observe not num"
    END
  ELSE
    LET sample = LAST_N
    SYS STR sample
    SYS PUSH bag LAST
    LET bag = LAST
    LET changed = 1
    LET hit = sample
    LET note_msg = "observed"
  END
END

# --- squeeze ---
SYS EQS ACTION "squeeze"
IF LAST_N == 1 THEN
  NOTE "action squeeze"
  IF BLANK_MODE > 0 THEN
    SYS SQUEEZE BLANK bag
    LET bag = LAST
  ELSE
    SYS SQUEEZE bag
    LET bag = LAST
  END
  SYS LINES bag
  LET hit = LAST_N
  LET changed = 1
  LET note_msg = "squeezed"
END

# --- breach count only ---
SYS EQS ACTION "breach"
IF LAST_N == 1 THEN
  NOTE "action breach"
  SYS SQUEEZE bag
  LET clean = LAST
  LET n_breach = 0
  EACH LINE AS row IN clean
    SYS PREPEND "" row
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      SYS CMP LAST_N THRESH
      IF LAST_N > 0 THEN
        LET n_breach = n_breach + 1
      END
    END
  END
  LET hit = n_breach
  LET note_msg = "breach counted"
END

# --- trim keep first N after SORTN DESC (hottest first) ---
SYS EQS ACTION "trim"
IF LAST_N == 1 THEN
  NOTE "action trim"
  LET n = 10
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    SYS PREPEND "" NAME
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET n = LAST_N
    END
  END
  SYS MAX n 0
  LET n = LAST_N
  SYS SQUEEZE bag
  LET clean = LAST
  SYS LINES clean
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "trim empty"
    FAIL "trim empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "trim empty"
    END
  ELSE
    SYS SORTN DESC clean
    LET sorted = LAST
    SYS TAKE n sorted
    LET bag = LAST
    LET changed = 1
    SYS LINES bag
    LET hit = LAST_N
    LET note_msg = "trimmed hot"
  END
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET bag = ""
  LET changed = 1
  LET hit = 1
  LET note_msg = "cleared"
END

# --- has exact ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs token"
  END
  SYS HASLINE bag NAME
  LET hit = LAST_N
  LET note_msg = "has"
END

# --- count exact ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs token"
  END
  SYS COUNTLINE bag NAME
  LET hit = LAST_N
  LET note_msg = "counted"
END

# --- drop exact ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs exact ms token"
  END
  SYS HASLINE bag NAME
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "drop miss"
    FAIL "drop miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop miss"
    END
  ELSE
    SYS REMOVELINE bag NAME
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "dropped"
  END
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "observe"
LET k = k + LAST_N
SYS EQS ACTION "squeeze"
LET k = k + LAST_N
SYS EQS ACTION "breach"
LET k = k + LAST_N
SYS EQS ACTION "trim"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

# post stats for report
SYS SQUEEZE bag
LET clean = LAST
SYS LINES clean
LET n_num = LAST_N
IF n_num > 0 THEN
  SYS SUM clean
  LET sum_ms = LAST_N
  SYS AVG clean
  LET avg_ms = LAST_N
  SYS MEDIAN clean
  LET med_ms = LAST_N
  SYS SORTN clean
  LET sorted = LAST
  SYS HEAD sorted
  SYS NUM
  LET min_ms = LAST_N
  SYS TAIL sorted
  SYS NUM
  LET max_ms = LAST_N
  LET n_breach = 0
  EACH LINE AS row IN clean
    SYS PREPEND "" row
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      SYS CMP LAST_N THRESH
      IF LAST_N > 0 THEN
        LET n_breach = n_breach + 1
      END
    END
  END
ELSE
  LET sum_ms = 0
  LET avg_ms = 0
  LET med_ms = 0
  LET min_ms = 0
  LET max_ms = 0
  LET n_breach = 0
END

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "samples write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.slo.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "name"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "sum_ms"
LET report = LAST
SYS STR sum_ms
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "avg_ms"
LET report = LAST
SYS STR avg_ms
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "med_ms"
LET report = LAST
SYS STR med_ms
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "min_ms"
LET report = LAST
SYS STR min_ms
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "max_ms"
LET report = LAST
SYS STR max_ms
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_breach"
LET report = LAST
SYS STR n_breach
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "thresh"
LET report = LAST
SYS STR THRESH
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_num"
LET report = LAST
SYS STR n_num
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth0"
LET report = LAST
SYS STR depth0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "slo" ACTION hit miss sum_ms avg_ms med_ms min_ms max_ms n_breach depth0 depth1
PRINT_JSON ACTION hit miss sum_ms avg_ms med_ms min_ms max_ms n_breach THRESH n_num depth0 depth1 elapsed STATUS_OK
PASS "slo tick"
NOTE "slo_sample_board: done"
CLEAR_ERR
EXIT 0 "slo ok"
