# svc_lenof_path_peel_board.cubalc — LENOF/STARTSIN probes + LEFTTO/BEFOREIN peels
#
# Real use: deploy agents gate log/path strings (LENOF/STARTSIN/ENDSIN/CONTAINSIN)
# and peel host/dir/basename/fields in place (LEFTTO/RIGHTTO/MIDTO/BEFOREIN/
# AFTERIN/BETWEENIN) without LET x = SYS LEFT/BEFORE glue.
# First realworld of 1461 LENOF/STARTSIN (1.15.916+ · MI 923) + 1462
# LEFTTO/BEFOREIN (MI 924). Distinct from pathline_* (file bags) and
# metric_label_peel (plate peel) — this board is *named-var string probes+peels*.
#
#   LENOF · STARTSIN · ENDSIN · CONTAINSIN|HASSTRIN · EQSIN · INDEXIN
#   LEFTTO|RIGHTTO name n · MIDTO|SLICETO · BEFOREIN|AFTERIN · BETWEENIN
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_lpp_$$
#   ./out/cubalc run programs/realworld/svc_lenof_path_peel_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|slice|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt LPP_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_LPP_REQUIRE
#
# Edges: INDEXIN miss → -1; BEFORE miss keeps all; AFTER miss → empty;
#   BETWEENIN_N; multi AFTERIN chain; LENOF ghost 0; CLEAR_ERR LAST;
#   WRITE NL; substring false friends; in-place mutates source

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

NOTE "svc_lenof_path_peel_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_lenof_path_peel -- boot|pass|soft|peel|slice|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_LPP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "LPP_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET path = ""
LET msg = ""
LET peeld = ""

ONEOF ACTION "boot", "pass", "soft", "peel", "slice", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "slice" THEN
    LET op = "slice"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-lpp\",\"schema\":\"cubalc.svc_lenof_path_peel.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"lpp\",\"want_filter\":\"lenof_path_peel\",\"cfg\":{\"surface\":\"LENOF,STARTSIN,ENDSIN,CONTAINSIN,EQSIN,INDEXIN,LEFTTO,RIGHTTO,MIDTO,BEFOREIN,AFTERIN,BETWEENIN\",\"contract\":\"path/log string probes + in-place peels without SYS LEFT glue\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  LET msg = "hello/world.log"
  LENOF msg
  LET find_n = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-lpp"
  IF LAST_N == 1 THEN
    IF find_n == 15 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET score = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot len"
      FAIL "boot len"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — LENOF/STARTSIN/ENDSIN/CONTAINSIN/EQSIN/INDEXIN
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET msg = "hello/world.log"
  LENOF msg
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 15 THEN
    LET score = score + 1
  END
  IF LENOF_N == 15 THEN
    LET score = score + 1
  END
  STARTSIN msg "hello"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  STARTSIN msg "nope"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ENDSIN msg ".log"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ENDSIN msg ".txt"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CONTAINSIN msg "world"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASSTRIN msg "xyz"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  INDEXIN msg "/"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 5 THEN
    LET score = score + 1
  END
  INDEXIN msg ":"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == -1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — miss paths · ghost LENOF · EQSIN · substring false friend
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LENOF ghost_lpp
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET a = "same"
  LET b = "same"
  EQSIN a b
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  EQSIN a "other"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET msg = "hello/world.log"
  # substring false friend: CONTAINSIN "ello" true but STARTSIN "ello" false
  CONTAINSIN msg "ello"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  STARTSIN msg "ello"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET n = 42
  LENOF n
  IF LAST_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  EQSIN n "42"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET z = "nocolon"
  BEFOREIN z ":"
  CLEAR_ERR
  SYS EQS z "nocolon"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET z2 = "nocolon"
  AFTERIN z2 ":"
  CLEAR_ERR
  SYS EQS z2 ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# peel — BEFOREIN/AFTERIN/BETWEENIN path surgery
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET path = "dir/file.txt"
  BEFOREIN path "/"
  CLEAR_ERR
  SYS EQS path "dir"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET path2 = "dir/file.txt"
  AFTERIN path2 "/"
  CLEAR_ERR
  SYS EQS path2 "file.txt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET br = "x[hello]y"
  BETWEENIN br "[" "]"
  LET find_n = BETWEENIN_N
  CLEAR_ERR
  SYS EQS br "hello"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF find_n == 5 THEN
    LET score = score + 1
  END
  LET p = "a/b/c"
  AFTERIN p "/"
  AFTERIN p "/"
  CLEAR_ERR
  SYS EQS p "c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # multi-hop host:svc:job
  LET route = "web01:api:deploy"
  BEFOREIN route ":"
  CLEAR_ERR
  SYS EQS route "web01"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET route = "web01:api:deploy"
  AFTERIN route ":"
  CLEAR_ERR
  SYS EQS route "api:deploy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERIN route ":"
  CLEAR_ERR
  SYS EQS route "deploy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET line = "sev=error host=web01"
  CONTAINSIN line "sev=error"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "lenof_path_peel"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# slice — LEFTTO/RIGHTTO/MIDTO/SLICETO
SYS EQS op "slice"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET s = "abcdef"
  LEFTTO s 3
  LET find_n = LAST_N
  CLEAR_ERR
  SYS EQS s "abc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF find_n == 3 THEN
    LET score = score + 1
  END
  LET t = "abcdef"
  RIGHTTO t 2
  CLEAR_ERR
  SYS EQS t "ef"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET m = "hello"
  MIDTO m 1 3
  CLEAR_ERR
  SYS EQS m "ell"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET m2 = "hello"
  SLICETO m2 2
  CLEAR_ERR
  SYS EQS m2 "llo"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # LEFTTO 0?
  LET s = "abc"
  LEFTTO s 0
  CLEAR_ERR
  SYS EQS s ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET s = "abc"
  LEFTTO s 99
  CLEAR_ERR
  SYS EQS s "abc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET s = "token=sekrit"
  AFTERIN s "="
  CLEAR_ERR
  SYS EQS s "sekrit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LEFTTO s 3
  CLEAR_ERR
  SYS EQS s "sek"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "LEFTTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "slice ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "slice score"
    FAIL "slice score"
    CLEAR_ERR
  END
  SYS CAT "slice:" score ":sl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "slice:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM surface
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "LENOF"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "STARTSIN"
  LET find_n = LAST_N
  CLEAR_ERR
  HASFORM "LEFTTO"
  LET depth = LAST_N
  CLEAR_ERR
  HASFORM "BEFOREIN"
  LET weight = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF find_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF depth == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF weight == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "ENDSIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "CONTAINSIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "INDEXIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "BETWEENIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "MIDTO"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "lenof_path_peel"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — path admit pipeline
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET path = "releases/app/v1.2.3/bin"
  STARTSIN path "releases/"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CONTAINSIN path "v1.2.3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERIN path "/"
  CLEAR_ERR
  SYS EQS path "app/v1.2.3/bin"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERIN path "/"
  BEFOREIN path "/"
  CLEAR_ERR
  SYS EQS path "v1.2.3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LENOF path
  IF LAST_N == 6 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-lpp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "lenof_path_peel"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score path note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET msg = "probe/path.log"
  LENOF msg
  LET find_n = LAST_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF find_n == 14 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "lenof_path_peel"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "mul_coalesce_scale"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  AFTERIN msg "/"
  SYS EQS msg "path.log"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ENDSIN msg ".log"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " path=" path
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "lpp report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
