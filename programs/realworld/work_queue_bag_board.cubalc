        GETF w1 bag
        SYS WRITE b_w1 LAST
        GETF w1 keep
        SYS WRITE k_w1 LAST
        SYS WRITE bag_path val
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ w2
      IF LAST_N == 1 THEN
        GETF w2 bag
