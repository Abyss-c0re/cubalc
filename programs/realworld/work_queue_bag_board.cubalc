# --- gate: depth >= MINQ ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET o_ok = 0
    LET dnow = 0
    IF slot == 0 THEN
      HASOBJ w0
      IF LAST_N == 1 THEN
        GETF w0 bag
        SYS LINES LAST
        LET dnow = LAST_N
        SETF w0 depth dnow
        LET o_ok = 1
        DUMPOBJ w0
        SYS WRITE d_w0 LAST
        GETF w0 bag
        SYS WRITE b_w0 LAST
        GETF w0 keep
        SYS WRITE k_w0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ w1
      IF LAST_N == 1 THEN
        GETF w1 bag
        SYS LINES LAST
        LET dnow = LAST_N
        SETF w1 depth dnow
        LET o_ok = 1
        DUMPOBJ w1
        SYS WRITE d_w1 LAST
        GETF w1 bag
        SYS WRITE b_w1 LAST
        GETF w1 keep
        SYS WRITE k_w1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ w2
      IF LAST_N == 1 THEN
        GETF w2 bag
        SYS LINES LAST
        LET dnow = LAST_N
        SETF w2 depth dnow
        LET o_ok = 1
        DUMPOBJ w2
        SYS WRITE d_w2 LAST
        GETF w2 bag
        SYS WRITE b_w2 LAST
        GETF w2 keep
        SYS WRITE k_w2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "gate miss"
      FAIL "gate miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "gate miss"
      END
    ELSE
      LET ret_n = dnow
      IF dnow < MINQ THEN
        LET miss = 1
        LET note_msg = "gate deny"
        SYS STR dnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate deny"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR dnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINQ
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "gate deny"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "gate deny"
        END
      ELSE
        LET hit = 1
        LET note_msg = "gate admit"
        SYS STR dnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate admit"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR dnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINQ
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- probe ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET p_ok = 1
  TRYPUSHF nosuch bag "x"
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYPUSHF should soft-fail"
  END
  CLEAR_ERR
  TRYPOPF nosuch bag
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYPOPF should soft-fail"
  END
  CLEAR_ERR
  TRYGREPF nosuch bag "x"
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYGREPF should soft-fail"
  END
  CLEAR_ERR
  TRYLINEF nosuch bag 0
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYLINEF should soft-fail"
  END
  CLEAR_ERR
  HASOBJ w0
  IF LAST_N == 1 THEN
    # empty claim soft HIT=0
    GETF w0 bag
    LET save_b = LAST
    SETF w0 bag ""
    POPHEADF w0 bag
    IF POPHEADF_HIT != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe empty POPHEAD should HIT=0"
    END
    SETF w0 bag save_b
    CLEAR_ERR
    PUSHF SOFT w0 nosuch "z"
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe PUSHF missing field should soft"
    END
    CLEAR_ERR
    PUSHF w0 bag "probe-item"
    IF OK == 0 THEN
      LET p_ok = 0
      LET note_msg = "probe PUSHF after soft broken"
    END
    LET ret_n = PUSHF_N
    CLEAR_ERR
  END
  IF p_ok == 1 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET val = "probe"
    LET val_ch = 1
    LET meta = "probe soft"
    LET meta_ch = 1
  ELSE
    LET miss = 1
    FAIL note_msg
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

