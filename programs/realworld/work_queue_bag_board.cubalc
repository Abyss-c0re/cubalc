# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ w0
  IF LAST_N == 1 THEN
    DELETEOBJ w0
    CLEAR_ERR
  END
  HASOBJ w1
  IF LAST_N == 1 THEN
    DELETEOBJ w1
    CLEAR_ERR
  END
  HASOBJ w2
  IF LAST_N == 1 THEN
    DELETEOBJ w2
    CLEAR_ERR
  END
  SYS WRITE d_w0 ""
  SYS WRITE d_w1 ""
  SYS WRITE d_w2 ""
  SYS WRITE b_w0 ""
  SYS WRITE b_w1 ""
  SYS WRITE b_w2 ""
  SYS WRITE k_w0 ""
  SYS WRITE k_w1 ""
  SYS WRITE k_w2 ""
  SYS WRITE objs_path ""
  SYS WRITE bag_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

