      SYS PUSH meta LAST
      LET meta = LAST
      SYS STR changed
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

