        GETF w0 bag
        SETF w0 keep LAST
        GREPF w0 bag WANT
        LET o_ok = OK
        LET ret_n = GREPF_N
        LET changed = GREPF_HIT
        LET val = LAST
        SETF w0 depth ret_n
        DUMPOBJ w0
        SYS WRITE d_w0 LAST
        GETF w0 bag
        SYS WRITE b_w0 LAST
        GETF w0 keep
        SYS WRITE k_w0 LAST
        SYS WRITE bag_path val
        CLEAR_ERR
