    ELSE
      IF changed == 0 THEN
        LET miss = 1
        LET note_msg = "pop empty"
        FAIL "pop empty"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "pop empty"
        END
      ELSE
        LET hit = 1
        LET note_msg = "pop ok"
        LET val_ch = 1
        LET meta = "pop"
        SYS PUSH meta sn
        LET meta = LAST
        SYS PUSH meta val
        LET meta = LAST
        SYS STR ret_n
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- peek: LINEF on keep or bag without permanently losing if OOR ---
# LINEF mutates field — peek uses keep copy into claim only via temp
SYS EQS ACTION "peek"
IF LAST_N == 1 THEN
  NOTE "action peek"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "peek bad slot"
    FAIL "peek bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "peek bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ w0
      IF LAST_N == 1 THEN
        GETF w0 bag
        SETF w0 keep LAST
        # destructive LINEF on keep so bag intact
        LINEF w0 keep LIDX
        LET o_ok = OK
        LET changed = LINEF_HIT
        LET val = LAST
        # restore keep full bag
        GETF w0 bag
        SETF w0 keep LAST
        DUMPOBJ w0
        SYS WRITE d_w0 LAST
        GETF w0 bag
        SYS WRITE b_w0 LAST
        GETF w0 keep
        SYS WRITE k_w0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ w1
      IF LAST_N == 1 THEN
        GETF w1 bag
        SETF w1 keep LAST
        # LINENOF is 1-based — map LIDX 0 → line 1
        LET li = LIDX + 1
        IF li < 1 THEN
          LET li = 1
        END
        LINENOF w1 keep li
        LET o_ok = OK
        LET changed = LINENOF_HIT
        LET val = LAST
        GETF w1 bag
        SETF w1 keep LAST
        DUMPOBJ w1
        SYS WRITE d_w1 LAST
        GETF w1 bag
        SYS WRITE b_w1 LAST
        GETF w1 keep
        SYS WRITE k_w1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ w2
      IF LAST_N == 1 THEN
        GETF w2 bag
        SETF w2 keep LAST
        NTHLINEF w2 keep LIDX
        LET o_ok = OK
        LET changed = LINEF_HIT
        LET val = LAST
        GETF w2 bag
        SETF w2 keep LAST
        DUMPOBJ w2
        SYS WRITE d_w2 LAST
        GETF w2 bag
        SYS WRITE b_w2 LAST
        GETF w2 keep
        SYS WRITE k_w2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "peek miss"
      FAIL "peek miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "peek miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "peek ok"
      LET val_ch = 1
      LET meta = "peek"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      SYS STR changed
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- filter: GREPF bag WANT (destructive; snapshot keep first) ---
