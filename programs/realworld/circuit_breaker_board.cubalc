# persist journal
IF j_changed == 1 THEN
  SYS WRITE journal_path jbag
  CLEAR_ERR
END

# VAL/META
IF val_ch == 1 THEN
  SYS WRITE val_path val
  CLEAR_ERR
END
IF meta_ch == 1 THEN
  SYS WRITE meta_path meta
  CLEAR_ERR
END

# report
SYS MS
LET t1ms = MS
LET dt = t1ms - t0ms
LET report = "circuit_breaker_board"
SYS PUSH report run_date
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS STR dt
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report
CLEAR_ERR

NOTE "circuit_breaker_board: done"
IF miss > 0 THEN
  IF REQUIRE_HIT > 0 THEN
    EXIT 2 note_msg
  END
END
EXIT 0 note_msg
