# --- setmatch ---
SYS EQS ACTION "setmatch"
IF LAST_N == 1 THEN
  NOTE "action setmatch"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "setmatch needs old"
    FAIL "setmatch needs old"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "setmatch needs old"
    END
  ELSE
    SYS BLANK A2
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "setmatch needs new"
      FAIL "setmatch needs new"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "setmatch needs new"
      END
    ELSE
      SYS HASLINE jbag NAME
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "setmatch miss"
        FAIL "setmatch miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "setmatch miss"
        END
      ELSE
        SYS SETMATCH jbag NAME A2
        IF LAST_N == 0 THEN
          LET miss = 1
          LET note_msg = "setmatch fail"
          FAIL "setmatch fail"
          CLEAR_ERR
        ELSE
          LET jbag = LAST
          LET j_changed = 1
          LET hit = 1
          LET note_msg = "setmatch ok"
          LET val = A2
          LET val_ch = 1
          LET meta = "setmatch"
          SYS PUSH meta NAME
          LET meta = LAST
          SYS PUSH meta A2
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- probe soft ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET soft_m = 0
  LET soft_f = 0
  LET soft_o = 0
  # TRYSEND ghost method on live obj if present else ghost obj
  HASOBJ api
  IF LAST_N == 1 THEN
    TRYSEND api no_such_method
    IF OK == 0 THEN
      LET soft_m = 1
    END
    CLEAR_ERR
    TRYSETF api no_such_field 1
    IF OK == 0 THEN
      LET soft_f = 1
    END
    CLEAR_ERR
    TRYGETF api no_such_field OR "miss"
    LET val = LAST
    CLEAR_ERR
  ELSE
    TRYSEND ghost_obj tick
    IF OK == 0 THEN
      LET soft_o = 1
    END
    CLEAR_ERR
    LET soft_m = 1
    LET soft_f = 1
  END
  LET hit = 1
  LET note_msg = "probe ok"
  LET meta = "probe"
  SYS STR soft_m
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR soft_f
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR soft_o
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  LET val_ch = 1
  PRINT_JSON meta
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  HASOBJ api
  IF LAST_N == 1 THEN
    DUMPOBJ api
    SYS WRITE d_api LAST
    CLEAR_ERR
  END
  HASOBJ db
  IF LAST_N == 1 THEN
    DUMPOBJ db
    SYS WRITE d_db LAST
    CLEAR_ERR
  END
  HASOBJ cache
  IF LAST_N == 1 THEN
    DUMPOBJ cache
    SYS WRITE d_cache LAST
    CLEAR_ERR
  END
  LISTOBJS Breaker
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "dump ok"
  SYS STR nobjs
  LET val = LAST
  LET val_ch = 1
  LET meta = "dump"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- gate ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET ok_send = 0
    IF slot == 0 THEN
      HASOBJ api
      IF LAST_N == 1 THEN
        SEND api admit
        LET ret_n = LAST_N
        LET ok_send = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ db
      IF LAST_N == 1 THEN
        SEND db admit
        LET ret_n = LAST_N
        LET ok_send = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ cache
      IF LAST_N == 1 THEN
        SEND cache admit
        LET ret_n = LAST_N
        LET ok_send = 1
      END
    END
    IF ok_send == 0 THEN
      LET miss = 1
      LET note_msg = "gate no obj"
      FAIL "gate no obj"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "gate no obj"
      END
    ELSE
      IF ret_n == 1 THEN
        LET hit = 1
        LET gate_n = 1
        LET note_msg = "gate admit"
        LET val = "admit"
        LET val_ch = 1
      ELSE
        LET miss = 1
        LET gate_n = 0
        LET note_msg = "gate deny"
        LET val = "deny"
        LET val_ch = 1
        FAIL "gate deny open circuit"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "gate deny open circuit"
        END
      END
      LET meta = "gate"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- delete ---
SYS EQS ACTION "delete"
IF LAST_N == 1 THEN
  NOTE "action delete"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "delete bad slot"
    FAIL "delete bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "delete bad slot"
    END
  ELSE
    LET ok_del = 0
    IF slot == 0 THEN
      HASOBJ api
      IF LAST_N == 1 THEN
        DELETEOBJ api
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_api
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ db
      IF LAST_N == 1 THEN
        DELETEOBJ db
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_db
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ cache
      IF LAST_N == 1 THEN
        DELETEOBJ cache
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_cache
      CLEAR_ERR
    END
    IF ok_del == 0 THEN
      LET miss = 1
      LET note_msg = "delete miss"
      FAIL "delete miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "delete miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "delete ok"
      LET val = sn
      LET val_ch = 1
      LET meta = "delete"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ api
  IF LAST_N == 1 THEN
    DELETEOBJ api
    CLEAR_ERR
  END
  HASOBJ db
  IF LAST_N == 1 THEN
    DELETEOBJ db
    CLEAR_ERR
  END
  HASOBJ cache
  IF LAST_N == 1 THEN
    DELETEOBJ cache
    CLEAR_ERR
  END
  SYS RM d_api
  CLEAR_ERR
  SYS RM d_db
  CLEAR_ERR
  SYS RM d_cache
  CLEAR_ERR
  SYS RM journal_path
  CLEAR_ERR
  SYS RM objs_path
  CLEAR_ERR
  SYS RM val_path
  CLEAR_ERR
  SYS RM meta_path
  CLEAR_ERR
  SYS RM report_path
  CLEAR_ERR
  LET jbag = ""
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

