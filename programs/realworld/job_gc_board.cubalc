SYS PUSH board_rep LAST
LET board_rep = LAST
SYS STR miss
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS STR dt
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS WRITE report_path board_rep
CLEAR_ERR

NOTE "job_gc_board: done"
IF miss > 0 THEN
  IF REQUIRE_HIT > 0 THEN
    EXIT 2 note_msg
  END
END
EXIT 0 note_msg
