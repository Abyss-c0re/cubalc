# job_gc_board.cubalc — DELETEWHERE/SENDWHERE job GC + selective dispatch
#
# Real use: agents track a small job fleet (j0..j2) with lifecycle states
# (queued|running|done|failed|stale). After a batch window they must:
#   - SENDWHERE state done ack     — acknowledge completed jobs only
#   - SENDWHERE state failed requeue — retry only failures
#   - DELETEWHERE state stale      — GC poisoned slots without wiping live work
#   - DELETEWHERE state done       — free completed after ack
# Without EACH+GETF+IF+DELETEOBJ/SEND glue.
#
# Surfaces forced (1.15.333–334):
#   DELETEWHERE / FREEWHERE / PURGEWHERE  — free by field equality
#   SENDWHERE / INVOKEWHERE               — method on field matches
#   WHEREOBJ / FINDOBJ / GETFALL          — query + harvest
#   DUMPOBJ plate rehydrate               — multi-run ARG dispatch
#   bag journal COUNTLINE/SETMATCH/MOVELINE
#   TRYSEND soft + REQUIRE miss
#
# Distinct from conn_pool (DELETEALL class wipe), replica_fleet (GETFALL stamp),
# stale_plate_gc (file mtime GC): this board is *predicate free + predicate SEND*.
#
# Slots (fixed idents): j0 j1 j2
#
# Plate under STATE:
#   dump/j0 dump/j1 dump/j2
#   JOURNAL.txt OBJS.txt VAL.txt META.txt GC_REPORT.txt FREED.txt
#
# Actions (CUBALC_ARG0 / CUBALC_JG_ACTION):
#   list      — LISTOBJS Job
#   open      — NEW Job ARG1=jN [state=ARG2 default queued]
#   setstate  — SETF state ARG2 on slot
#   bump      — SEND bump (tries++)
#   harvest   — GETFALL Job tries → SUM
#   where     — WHEREOBJ Job state ARG1
#   find      — FINDOBJ Job state ARG1
#   ack       — SENDWHERE Job state done ack
#   requeue   — SENDWHERE Job state failed requeue
#   mark_stale— SENDWHERE Job state running stale_out (poison running)
#   gc_stale  — DELETEWHERE Job state stale + RM dumps for freed names
#   gc_done   — DELETEWHERE Job state done + RM dumps
#   gc_state  — DELETEWHERE Job state ARG1 (generic) + RM dumps
#   journal   — PUSH slot:event
#   count     — COUNTLINE exact
#   pin       — MOVELINE first exact to front
#   setmatch  — SETMATCH old→new first
#   probe     — soft TRYSEND + SENDWHERE miss method skip
#   dump      — DUMPOBJ live
#   gate      — no stale (WHEREOBJ stale N==0); REQUIRE→2 if any
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_jg_$$
#   CUBALC_ARG0=open CUBALC_ARG1=j0 CUBALC_ARG2=done
#   CUBALC_ARG0=ack
#   CUBALC_ARG0=gc_done
#   CUBALC_ARG0=gate CUBALC_JG_REQUIRE=1
#
# Env: CUBALC_JG_REQUIRE CUBALC_JG_NAME CUBALC_JG_ACTION CUBALC_JG_A2
#
# Edges:
#   DELETEWHERE process-local — must RM dump plates for freed names or rehydrate undoes GC
#   SENDWHERE missing method soft SENDWHERE_SKIP; empty match N=0
#   equality only (no state in {done,failed}); SETFALL still unfiltered
#   late bag LET+PUSH under -s after WHERE — predeclare board_rep
#   SETMATCH first-only; COUNTLINE exact; WRITE NL; REQUIRE NUM softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS Job
  FIELD id ""
  FIELD state "queued"
  FIELD tries 0
  FIELD acked 0
  METHOD init i st
    SETF THIS id i
    SETF THIS state st
    SETF THIS tries 0
    SETF THIS acked 0
  END
  METHOD bump
    GETF THIS tries
    LET t = LAST_N + 1
    SETF THIS tries t
    RET t
  END
  METHOD ack
    GETF THIS state
    LET st = LAST
    SYS EQS st "done"
    IF LAST_N == 0 THEN
      RET 0
    END
    SETF THIS acked 1
    RET 1
  END
  METHOD requeue
    GETF THIS state
    LET st = LAST
    SYS EQS st "failed"
    IF LAST_N == 0 THEN
      RET 0
    END
    SETF THIS state "queued"
    GETF THIS tries
    LET t = LAST_N + 1
    SETF THIS tries t
    RET t
  END
  METHOD stale_out
    SETF THIS state "stale"
    RET 1
  END
END

NOTE "job_gc_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_JG_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_JG_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_JG_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_JG_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "dump"
LET dump_dir = LAST
SYS MKDIR dump_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JOURNAL.txt"
LET journal_path = LAST
SYS JOIN state_dir "FREED.txt"
LET freed_path = LAST
SYS JOIN state_dir "GC_REPORT.txt"
LET report_path = LAST
SYS JOIN dump_dir "j0"
LET d_j0 = LAST
SYS JOIN dump_dir "j1"
LET d_j1 = LAST
SYS JOIN dump_dir "j2"
LET d_j2 = LAST

# slot resolve
LET slot = -1
SYS EQS NAME "j0"
IF LAST_N == 1 THEN
  LET slot = 0
END
SYS EQS NAME "j1"
IF LAST_N == 1 THEN
  LET slot = 1
END
SYS EQS NAME "j2"
IF LAST_N == 1 THEN
  LET slot = 2
END
LET sn = ""
IF slot == 0 THEN
  LET sn = "j0"
END
IF slot == 1 THEN
  LET sn = "j1"
END
IF slot == 2 THEN
  LET sn = "j2"
END

# rehydrate j0
SYS READ OR d_j0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ j0
  IF LAST_N == 1 THEN
    DELETEOBJ j0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "state"
  LET rst = LAST
  SYS LOOKUPN snap "tries"
  LET rtr = LAST_N
  SYS LOOKUPN snap "acked"
  LET rack = LAST_N
  CLEAR_ERR
  NEW Job j0 rid rst
  TRYSETF j0 tries rtr
  CLEAR_ERR
  TRYSETF j0 acked rack
  CLEAR_ERR
  TRYSETF j0 state rst
  CLEAR_ERR
END
# rehydrate j1
SYS READ OR d_j1 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ j1
  IF LAST_N == 1 THEN
    DELETEOBJ j1
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "state"
  LET rst = LAST
  SYS LOOKUPN snap "tries"
  LET rtr = LAST_N
  SYS LOOKUPN snap "acked"
  LET rack = LAST_N
  CLEAR_ERR
  NEW Job j1 rid rst
  TRYSETF j1 tries rtr
  CLEAR_ERR
  TRYSETF j1 acked rack
  CLEAR_ERR
  TRYSETF j1 state rst
  CLEAR_ERR
END
# rehydrate j2
SYS READ OR d_j2 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ j2
  IF LAST_N == 1 THEN
    DELETEOBJ j2
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "state"
  LET rst = LAST
  SYS LOOKUPN snap "tries"
  LET rtr = LAST_N
  SYS LOOKUPN snap "acked"
  LET rack = LAST_N
  CLEAR_ERR
  NEW Job j2 rid rst
  TRYSETF j2 tries rtr
  CLEAR_ERR
  TRYSETF j2 acked rack
  CLEAR_ERR
  TRYSETF j2 state rst
  CLEAR_ERR
END

SYS READ OR journal_path OR ""
LET jbag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET nobjs = 0
LET ret_n = 0
LET j_changed = 0
LET where_n = 0
LET freed_n = 0
LET skip_n = 0
LET sum_tries = 0
# predeclare report bag (late LET+PUSH after WHERE/-s was flaky on prior board)
LET board_rep = "job_gc_board"

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS Job
  LET bag = LAST
  LET nobjs = NOBJS
  SYS WRITE objs_path bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- open ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    LET st0 = "queued"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET st0 = A2
    END
    IF slot == 0 THEN
      HASOBJ j0
      IF LAST_N == 1 THEN
        DELETEOBJ j0
        CLEAR_ERR
      END
      NEW Job j0 sn st0
      DUMPOBJ j0
      SYS WRITE d_j0 LAST
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ j1
      IF LAST_N == 1 THEN
        DELETEOBJ j1
        CLEAR_ERR
      END
      NEW Job j1 sn st0
      DUMPOBJ j1
      SYS WRITE d_j1 LAST
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ j2
      IF LAST_N == 1 THEN
        DELETEOBJ j2
        CLEAR_ERR
      END
      NEW Job j2 sn st0
      DUMPOBJ j2
      SYS WRITE d_j2 LAST
      CLEAR_ERR
    END
    LISTOBJS Job
    LET nobjs = NOBJS
    SYS WRITE objs_path LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "open ok"
    LET val = sn
    LET val_ch = 1
    LET meta = "open"
    SYS PUSH meta sn
    LET meta = LAST
    SYS PUSH meta st0
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- setstate ---
SYS EQS ACTION "setstate"
IF LAST_N == 1 THEN
  NOTE "action setstate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "setstate bad slot"
    FAIL "setstate bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "setstate bad slot"
    END
  ELSE
    LET st0 = "queued"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET st0 = A2
    END
    LET ok_set = 0
    IF slot == 0 THEN
      HASOBJ j0
      IF LAST_N == 1 THEN
        SETF j0 state st0
        LET ok_set = 1
        DUMPOBJ j0
        SYS WRITE d_j0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ j1
      IF LAST_N == 1 THEN
        SETF j1 state st0
        LET ok_set = 1
        DUMPOBJ j1
        SYS WRITE d_j1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ j2
      IF LAST_N == 1 THEN
        SETF j2 state st0
        LET ok_set = 1
        DUMPOBJ j2
        SYS WRITE d_j2 LAST
        CLEAR_ERR
      END
    END
    IF ok_set == 0 THEN
      LET miss = 1
      LET note_msg = "setstate no obj"
      FAIL "setstate no obj"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "setstate no obj"
      END
    ELSE
      LET jev = "SLOT:state"
      SYS REPLACEALL jev "SLOT" sn
      LET jev = LAST
      SYS PUSH jbag jev
      LET jbag = LAST
      LET j_changed = 1
      LET hit = 1
      LET note_msg = "setstate ok"
      LET val = st0
      LET val_ch = 1
      LET meta = "setstate"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta st0
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- bump ---
SYS EQS ACTION "bump"
IF LAST_N == 1 THEN
  NOTE "action bump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "bump bad slot"
    FAIL "bump bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "bump bad slot"
    END
  ELSE
    LET ok_send = 0
    IF slot == 0 THEN
      HASOBJ j0
      IF LAST_N == 1 THEN
        SEND j0 bump
        LET ret_n = LAST_N
        LET ok_send = 1
        DUMPOBJ j0
        SYS WRITE d_j0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ j1
      IF LAST_N == 1 THEN
        SEND j1 bump
        LET ret_n = LAST_N
        LET ok_send = 1
        DUMPOBJ j1
        SYS WRITE d_j1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ j2
      IF LAST_N == 1 THEN
        SEND j2 bump
        LET ret_n = LAST_N
        LET ok_send = 1
        DUMPOBJ j2
        SYS WRITE d_j2 LAST
        CLEAR_ERR
      END
    END
    IF ok_send == 0 THEN
      LET miss = 1
      LET note_msg = "bump no obj"
      FAIL "bump no obj"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "bump no obj"
      END
    ELSE
      LET hit = 1
      LET note_msg = "bump ok"
      SYS STR ret_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "bump"
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- harvest GETFALL tries ---
SYS EQS ACTION "harvest"
IF LAST_N == 1 THEN
  NOTE "action harvest"
  GETFALL Job tries
  LET hbag = LAST
  LET ret_n = GETFALL_N
  IF ret_n == 0 THEN
    LET sum_tries = 0
  ELSE
    SYS SUM hbag
    LET sum_tries = LAST_N
  END
  LET hit = 1
  LET note_msg = "harvest ok"
  LET val = "n:N sum:S"
  SYS STR ret_n
  SYS REPLACEALL val "N" LAST
  LET val = LAST
  SYS STR sum_tries
  SYS REPLACEALL val "S" LAST
  LET val = LAST
  LET val_ch = 1
  LET meta = "harvest"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- where ---
SYS EQS ACTION "where"
IF LAST_N == 1 THEN
  NOTE "action where"
  LET st0 = "done"
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET st0 = NAME
  END
  WHEREOBJ Job state st0
  LET wbag = LAST
  LET where_n = WHEREOBJ_N
  LET hit = 1
  LET note_msg = "where ok"
  LET val = wbag
  LET val_ch = 1
  LET meta = "where"
  SYS PUSH meta st0
  LET meta = LAST
  SYS STR where_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON where_n
  CLEAR_ERR
END

# --- find ---
SYS EQS ACTION "find"
IF LAST_N == 1 THEN
  NOTE "action find"
  LET st0 = "stale"
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET st0 = NAME
  END
  FINDOBJ Job state st0
  LET found = LAST
  LET ret_n = FINDOBJ_N
  IF ret_n == 0 THEN
    LET miss = 1
    LET note_msg = "find miss"
    FAIL "find miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "find miss"
    END
    LET val = ""
    LET val_ch = 1
  ELSE
    LET hit = 1
    LET note_msg = "find ok"
    LET val = found
    LET val_ch = 1
  END
  LET meta = "find"
  SYS PUSH meta st0
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- ack SENDWHERE state done ---
SYS EQS ACTION "ack"
IF LAST_N == 1 THEN
  NOTE "action ack"
  SENDWHERE Job state "done" ack
  LET ret_n = SENDWHERE_N
  LET skip_n = SENDWHERE_SKIP
  # persist dumps for live jobs
  HASOBJ j0
  IF LAST_N == 1 THEN
    DUMPOBJ j0
    SYS WRITE d_j0 LAST
    CLEAR_ERR
  END
  HASOBJ j1
  IF LAST_N == 1 THEN
    DUMPOBJ j1
    SYS WRITE d_j1 LAST
    CLEAR_ERR
  END
  HASOBJ j2
  IF LAST_N == 1 THEN
    DUMPOBJ j2
    SYS WRITE d_j2 LAST
    CLEAR_ERR
  END
  LET jev = "fleet:ack"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "ack ok"
  SYS STR ret_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "ack"
  SYS PUSH meta val
  LET meta = LAST
  SYS STR skip_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- requeue SENDWHERE failed ---
SYS EQS ACTION "requeue"
IF LAST_N == 1 THEN
  NOTE "action requeue"
  SENDWHERE Job state "failed" requeue
  LET ret_n = SENDWHERE_N
  LET skip_n = SENDWHERE_SKIP
  HASOBJ j0
  IF LAST_N == 1 THEN
    DUMPOBJ j0
    SYS WRITE d_j0 LAST
    CLEAR_ERR
  END
  HASOBJ j1
  IF LAST_N == 1 THEN
    DUMPOBJ j1
    SYS WRITE d_j1 LAST
    CLEAR_ERR
  END
  HASOBJ j2
  IF LAST_N == 1 THEN
    DUMPOBJ j2
    SYS WRITE d_j2 LAST
    CLEAR_ERR
  END
  LET jev = "fleet:requeue"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "requeue ok"
  SYS STR ret_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "requeue"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- mark_stale: SENDWHERE running → stale_out ---
SYS EQS ACTION "mark_stale"
IF LAST_N == 1 THEN
  NOTE "action mark_stale"
  SENDWHERE Job state "running" stale_out
  LET ret_n = SENDWHERE_N
  HASOBJ j0
  IF LAST_N == 1 THEN
    DUMPOBJ j0
    SYS WRITE d_j0 LAST
    CLEAR_ERR
  END
  HASOBJ j1
  IF LAST_N == 1 THEN
    DUMPOBJ j1
    SYS WRITE d_j1 LAST
    CLEAR_ERR
  END
  HASOBJ j2
  IF LAST_N == 1 THEN
    DUMPOBJ j2
    SYS WRITE d_j2 LAST
    CLEAR_ERR
  END
  LET hit = 1
  LET note_msg = "mark_stale ok"
  SYS STR ret_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "mark_stale"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON ret_n
  CLEAR_ERR
END

# helper body: DELETEWHERE state + RM dumps for freed names in bag
# --- gc_stale ---
SYS EQS ACTION "gc_stale"
IF LAST_N == 1 THEN
  NOTE "action gc_stale"
  DELETEWHERE Job state "stale"
  LET freed_n = DELETEWHERE_N
  LET fbag = DELETEWHERE
  SYS WRITE freed_path fbag
  CLEAR_ERR
  # plate hygiene — RM dump if name was freed
  SYS HASLINE fbag "j0"
  IF LAST_N == 1 THEN
    SYS RM d_j0
    CLEAR_ERR
  END
  SYS HASLINE fbag "j1"
  IF LAST_N == 1 THEN
    SYS RM d_j1
    CLEAR_ERR
  END
  SYS HASLINE fbag "j2"
  IF LAST_N == 1 THEN
    SYS RM d_j2
    CLEAR_ERR
  END
  LISTOBJS Job
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET jev = "fleet:gc_stale"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "gc_stale ok"
  SYS STR freed_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "gc_stale"
  SYS PUSH meta val
  LET meta = LAST
  SYS PUSH meta fbag
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON freed_n
  CLEAR_ERR
END

# --- gc_done ---
SYS EQS ACTION "gc_done"
IF LAST_N == 1 THEN
  NOTE "action gc_done"
  DELETEWHERE Job state "done"
  LET freed_n = DELETEWHERE_N
  LET fbag = DELETEWHERE
  SYS WRITE freed_path fbag
  CLEAR_ERR
  SYS HASLINE fbag "j0"
  IF LAST_N == 1 THEN
    SYS RM d_j0
    CLEAR_ERR
  END
  SYS HASLINE fbag "j1"
  IF LAST_N == 1 THEN
    SYS RM d_j1
    CLEAR_ERR
  END
  SYS HASLINE fbag "j2"
  IF LAST_N == 1 THEN
    SYS RM d_j2
    CLEAR_ERR
  END
  LISTOBJS Job
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET jev = "fleet:gc_done"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "gc_done ok"
  SYS STR freed_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "gc_done"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON freed_n
  CLEAR_ERR
END

# --- gc_state generic ---
SYS EQS ACTION "gc_state"
IF LAST_N == 1 THEN
  NOTE "action gc_state"
  LET st0 = "failed"
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET st0 = NAME
  END
  DELETEWHERE Job state st0
  LET freed_n = DELETEWHERE_N
  LET fbag = DELETEWHERE
  SYS WRITE freed_path fbag
  CLEAR_ERR
  SYS HASLINE fbag "j0"
  IF LAST_N == 1 THEN
    SYS RM d_j0
    CLEAR_ERR
  END
  SYS HASLINE fbag "j1"
  IF LAST_N == 1 THEN
    SYS RM d_j1
    CLEAR_ERR
  END
  SYS HASLINE fbag "j2"
  IF LAST_N == 1 THEN
    SYS RM d_j2
    CLEAR_ERR
  END
  LISTOBJS Job
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "gc_state ok"
  SYS STR freed_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "gc_state"
  SYS PUSH meta st0
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON freed_n
  CLEAR_ERR
END

# --- journal ---
SYS EQS ACTION "journal"
IF LAST_N == 1 THEN
  NOTE "action journal"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "journal needs slot"
    FAIL "journal needs slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "journal needs slot"
    END
  ELSE
    LET ev = "note"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET ev = A2
    END
    LET jev = "DEP:EV"
    SYS REPLACEALL jev "DEP" NAME
    LET jev = LAST
    SYS REPLACEALL jev "EV" ev
    LET jev = LAST
    SYS PUSH jbag jev
    LET jbag = LAST
    LET j_changed = 1
    LET hit = 1
    LET note_msg = "journal ok"
    LET val = jev
    LET val_ch = 1
    LET meta = "journal"
    SYS PUSH meta jev
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- count ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "count needs needle"
    FAIL "count needs needle"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "count needs needle"
    END
  ELSE
    SYS COUNTLINE jbag NAME
    LET ret_n = LAST_N
    LET hit = 1
    SYS STR ret_n
    LET val = LAST
    LET val_ch = 1
    LET note_msg = "count ok"
    LET meta = "count"
    SYS PUSH meta NAME
    LET meta = LAST
    SYS PUSH meta val
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- pin ---
SYS EQS ACTION "pin"
IF LAST_N == 1 THEN
  NOTE "action pin"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "pin needs row"
    FAIL "pin needs row"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pin needs row"
    END
  ELSE
    SYS FINDLINE jbag NAME
    LET idx = LAST_N
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "pin miss"
      FAIL "pin miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "pin miss"
      END
    ELSE
      SYS MOVELINE jbag idx 0
      LET jbag = LAST
      LET j_changed = 1
      LET hit = 1
      LET note_msg = "pin ok"
      LET val = NAME
      LET val_ch = 1
      LET meta = "pin"
      SYS PUSH meta NAME
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- setmatch ---
SYS EQS ACTION "setmatch"
IF LAST_N == 1 THEN
  NOTE "action setmatch"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "setmatch needs old"
    FAIL "setmatch needs old"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "setmatch needs old"
    END
  ELSE
    SYS BLANK A2
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "setmatch needs new"
      FAIL "setmatch needs new"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "setmatch needs new"
      END
    ELSE
      SYS HASLINE jbag NAME
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "setmatch miss"
        FAIL "setmatch miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "setmatch miss"
        END
      ELSE
        SYS SETMATCH jbag NAME A2
        IF LAST_N == 0 THEN
          LET miss = 1
          LET note_msg = "setmatch fail"
          FAIL "setmatch fail"
          CLEAR_ERR
        ELSE
          LET jbag = LAST
          LET j_changed = 1
          LET hit = 1
          LET note_msg = "setmatch ok"
          LET val = A2
          LET val_ch = 1
          LET meta = "setmatch"
          SYS PUSH meta NAME
          LET meta = LAST
          SYS PUSH meta A2
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- probe ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET soft_m = 0
  LET soft_f = 0
  HASOBJ j0
  IF LAST_N == 1 THEN
    TRYSEND j0 no_such_method
    IF OK == 0 THEN
      LET soft_m = 1
    END
    CLEAR_ERR
    TRYSETF j0 no_such_field 1
    IF OK == 0 THEN
      LET soft_f = 1
    END
    CLEAR_ERR
  ELSE
    LET soft_m = 1
    LET soft_f = 1
  END
  # SENDWHERE miss method soft skip
  SENDWHERE Job state "queued" no_meth_zz
  LET skip_n = SENDWHERE_SKIP
  CLEAR_ERR
  # empty DELETEWHERE
  DELETEWHERE Job state "no_such_state_zz"
  LET freed_n = DELETEWHERE_N
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "probe ok"
  LET meta = "probe"
  SYS STR soft_m
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR soft_f
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR skip_n
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR freed_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  LET val = meta
  LET val_ch = 1
  PRINT_JSON meta
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  HASOBJ j0
  IF LAST_N == 1 THEN
    DUMPOBJ j0
    SYS WRITE d_j0 LAST
    CLEAR_ERR
  END
  HASOBJ j1
  IF LAST_N == 1 THEN
    DUMPOBJ j1
    SYS WRITE d_j1 LAST
    CLEAR_ERR
  END
  HASOBJ j2
  IF LAST_N == 1 THEN
    DUMPOBJ j2
    SYS WRITE d_j2 LAST
    CLEAR_ERR
  END
  LISTOBJS Job
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "dump ok"
  SYS STR nobjs
  LET val = LAST
  LET val_ch = 1
  LET meta = "dump"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- gate: no stale ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  WHEREOBJ Job state "stale"
  LET where_n = WHEREOBJ_N
  IF where_n == 0 THEN
    LET hit = 1
    LET note_msg = "gate admit"
    LET val = "admit"
    LET val_ch = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate deny"
    LET val = "deny"
    LET val_ch = 1
    FAIL "gate deny stale jobs present"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate deny stale jobs present"
    END
  END
  LET meta = "gate"
  SYS STR where_n
  SYS PUSH meta LAST
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  DELETEALL Job
  CLEAR_ERR
  SYS RM d_j0
  CLEAR_ERR
  SYS RM d_j1
  CLEAR_ERR
  SYS RM d_j2
  CLEAR_ERR
  SYS RM journal_path
  CLEAR_ERR
  SYS RM objs_path
  CLEAR_ERR
  SYS RM val_path
  CLEAR_ERR
  SYS RM meta_path
  CLEAR_ERR
  SYS RM freed_path
  CLEAR_ERR
  SYS RM report_path
  CLEAR_ERR
  LET jbag = ""
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

