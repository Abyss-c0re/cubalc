  LET score = 0
  LET tok = "ticket"
  LET lim_n = 1
  CALL is_long_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 6
  CALL is_long_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 7
  CALL is_long_enough
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET lim_n = 6
  CALL is_exact_len
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 6
  CALL is_short_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 5
  CALL is_short_enough
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET min_n = 3
  LET max_n = 10
  CALL admit_id
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET max_n = 5
  CALL admit_id
  SYS EQS state "deny-long"
  IF LAST_N == 1 THEN
    LET score = score + 1
