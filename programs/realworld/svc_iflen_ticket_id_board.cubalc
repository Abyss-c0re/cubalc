# svc_iflen_ticket_id_board.cubalc — IFLEN/IFLONG/IFSHORT ticket ID length
#
# Real use: intake agents admit ticket IDs / slugs only inside a length
# band (exact, min, max) without LENOF+IF glue. First realworld of 1493
# IFLEN/IFLONG/IFSHORT (1.15.950 · MI 954). Distinct from
# svc_ifblank_note_hygiene (blankness) — this board is *string length
# branches for ID/slug admit*.
#
#   IFLEN · IFLONG · IFSHORT · IFLEN_N · IFLEN_LEN · IFLEN_LIMIT
#   FN-wrap (W853) · num decimal length · undef len0 · var limit
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_iln_$$
#   ./out/cubalc run programs/realworld/svc_iflen_ticket_id_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt ILN_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_ILN_REQUIRE
#
# Edges: empty len0; undef len0; num 42 → len2; short deny; long admit;
#   FN-wrap; STATUS bare; STRTO VAL; avoid var tries (W883)

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN is_exact_len
  IFLEN tok lim_n
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_long_enough
  IFLONG tok lim_n
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

FN is_short_enough
  IFSHORT tok lim_n
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

# admit ticket id in [min_n, max_n] inclusive via long+short
FN admit_id
  LET state = "deny-short"
  LET ok_v = 0
  LET lim_n = min_n
  CALL is_long_enough
  IF ok_v == 0 THEN
    LET state = "deny-short"
  END
  IF ok_v == 1 THEN
    LET lim_n = max_n
    CALL is_short_enough
    IF ok_v == 0 THEN
      LET state = "deny-long"
    END
    IF ok_v == 1 THEN
      LET state = "admit"
      LET ok_v = 1
    END
  END
END

FN ghost_exact0
  IFLEN ghost_never_iln 0
    LET ok_v = 1
  ELSE
    LET ok_v = 0
  END
END

NOTE "svc_iflen_ticket_id_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_iflen_ticket_id -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_ILN_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "ILN_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "ids"
LET id_dir = LAST
SYS JOIN id_dir "ticket.txt"
LET ticket_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET tok = ""
LET lim_n = 0
LET min_n = 0
LET max_n = 0
LET state = ""
LET saved = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-iln\",\"schema\":\"cubalc.svc_iflen_ticket_id.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"iln\",\"want_filter\":\"iflen_ticket_id\",\"cfg\":{\"surface\":\"IFLEN,IFLONG,IFSHORT,IFLEN_N,IFLEN_LEN,IFLEN_LIMIT\",\"contract\":\"string length branches for ticket ID admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR id_dir
  CLEAR_ERR
  SYS WRITE ticket_path "INC-1042"
  CLEAR_ERR
  LET tok = "hello"
  LET lim_n = 5
  CALL is_exact_len
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-iln"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF IFLEN_N == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = IFLEN_LEN
      ELSE
        LET miss = 1
        LET note_msg = "boot sticky"
        FAIL "boot sticky"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot len"
      FAIL "boot len"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — IFLEN/IFLONG/IFSHORT core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET tok = "hello"
  LET lim_n = 5
  CALL is_exact_len
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFLEN_N == 1 THEN
    LET score = score + 1
  END
  IF IFLEN_LEN == 5 THEN
    LET score = score + 1
  END
  IF IFLEN_LIMIT == 5 THEN
    LET score = score + 1
  END
  LET lim_n = 4
  CALL is_exact_len
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET lim_n = 5
  CALL is_long_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFLONG_N == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 6
  CALL is_long_enough
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET lim_n = 5
  CALL is_short_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFSHORT_N == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — empty · undef · num len · band
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET tok = ""
  LET lim_n = 0
  CALL is_exact_len
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL ghost_exact0
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # numeric → decimal string length
  LET tok = 42
  LET lim_n = 2
  CALL is_exact_len
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET tok = "ab"
  LET lim_n = 3
  CALL is_short_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 1
  CALL is_short_enough
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  LET tok = "secret"
  LET lim_n = 6
  CALL is_long_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET min_n = 4
  LET max_n = 12
  LET tok = "INC-1042"
  CALL admit_id
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET tok = "ab"
  CALL admit_id
  SYS EQS state "deny-short"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET tok = "xxxxxxxxxxxxxxxxxxxxxxx"
  CALL admit_id
  SYS EQS state "deny-long"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lim_n = 4
  LET tok = "hello"
  CALL is_long_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — multi id class
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET min_n = 6
  LET max_n = 16
  LET tok = "INC-1"
  CALL admit_id
  SYS EQS state "deny-short"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET tok = "INC-1042"
  CALL admit_id
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET tok = "INC-1042-EXTRA-LONG-ID"
  CALL admit_id
  SYS EQS state "deny-long"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET lim_n = 8
  LET tok = "INC-1042"
  CALL is_exact_len
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF IFLEN_LEN == 8 THEN
    LET score = score + 1
  END
  LET lim_n = 8
  CALL is_long_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL is_short_enough
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET lim_n = 7
  CALL is_short_enough
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iflen_ticket_id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

