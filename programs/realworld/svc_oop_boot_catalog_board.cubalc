# svc_oop_boot_catalog_board.cubalc — oop_boot/oop_session fleet OOP catalog contract
#
# Real use: fleet agents gate full OOP plane (CLASS + Class.method + Class.field)
# via INCLUDE oop_boot before NEW/SEND, instead of triple class/method/field glue.
# First realworld of 1404 oop_session + oop_boot (1.15.858+ · MI 865 · init --oop).
# Distinct from svc_class_boot_catalog (classes only) and svc_method_catalog_board.
#
#   DEFAULT NEED_CLASSES · NEED_CLASS_ANY · CLASS_GUARD_SOFT
#   DEFAULT NEED_METHODS · NEED_METHOD_ANY · METHOD_GUARD_SOFT
#   DEFAULT NEED_FIELDS · NEED_FIELD_ANY · FIELD_GUARD_SOFT
#   INCLUDE oop_boot|oop_session → OOP_SESSION_OK + CLASS/METHOD/FIELD_GUARD_OK
#   CLASSHAVE/CLASSMISS · METHHAVE/METHMISS · FLDHAVE/FLDMISS bags
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sob_$$
#   ./out/cubalc run programs/realworld/svc_oop_boot_catalog_board.cubalc boot
#   ./out/cubalc run ... pass|soft_cls|soft_meth|soft_fld|hard|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SOB_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SOB_REQUIRE
#
# Edges: LET knobs before each re-INCLUDE; hard FAIL no halt/exit_code 0;
#   Class.method / Class.field exact dots; substring false friends;
#   triple guard stack vars_n pressure; double agent_boot via oop_boot;
#   WRITE NL; auto-seed plate; empty NEED_* skips

INCLUDE agent_boot
REQUIRE LIB hold_seed

# fleet OOP catalog (class + methods + fields) before gates
CLASS FleetJob
  FIELD id ""
  FIELD status "open"
  METHOD ping
    LET LAST = "pong"
  END
  METHOD admit
    LET status = "live"
  END
END

CLASS FleetSlot
  FIELD n 0
  FIELD tag "slot"
  METHOD take
    LET n = n + 1
  END
END

NOTE "svc_oop_boot_catalog_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_oop_boot_catalog -- boot|pass|soft_cls|soft_meth|soft_fld|hard|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeO"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SOB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SOB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_n = 0
LET oop = 0
LET cgo = 0
LET mgo = 0
LET fgo = 0
LET have_n = 0
LET miss_n = 0

ONEOF ACTION "boot", "pass", "soft_cls", "soft_meth", "soft_fld", "hard", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_cls" THEN
    LET op = "soft_cls"
  WHEN "soft_meth" THEN
    LET op = "soft_meth"
  WHEN "soft_fld" THEN
    LET op = "soft_fld"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

# auto-seed agent plate (ENSUREPLATE will not reseed {})
SYS EQS op "list"
IF LAST_N == 0 THEN
  SYS EQS op "clear"
  IF LAST_N == 0 THEN
    LET need_seed = 1
    SYS EXIST agent_path
    IF LAST_N == 1 THEN
      SYS READ OR agent_path OR ""
      SYS HAS LAST "svc-sob"
      IF LAST_N == 1 THEN
        LET need_seed = 0
      END
      CLEAR_ERR
    END
    CLEAR_ERR
    IF need_seed == 1 THEN
      SYS TRIM host_s
      LET host_s = LAST
      SYS TRIM role_s
      LET role_s = LAST
      CLEAR_ERR
      LET PLATE_PATH = agent_path
      LET PEER_PATH = peer_path
      SYS CAT "{\"agent\":\"svc-sob\",\"schema\":\"cubalc.svc_oop_boot_catalog.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"oop_catalog\",\"label\":\"sob\",\"cfg\":{\"surface\":\"oop_boot,oop_session,class_guard,method_guard,field_guard,OOP_SESSION_OK,NEED_CLASSES,NEED_METHODS,NEED_FIELDS\",\"contract\":\"full OOP plane · init --oop\"}}"
      LET PLATE_SEED = LAST
      CLEAR_ERR
      SYS CAT "{\"peer\":\"oop_catalog\",\"n\":1}"
      LET PEER_SEED = LAST
      CLEAR_ERR
      SYS RM agent_path
      CLEAR_ERR
      SYS RM peer_path
      CLEAR_ERR
      INCLUDE plate_peer_session
      CLEAR_ERR
      SYS SAVEPLATE agent_path PLATE
      CLEAR_ERR
    END
  END
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-sob\",\"schema\":\"cubalc.svc_oop_boot_catalog.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"oop_catalog\",\"label\":\"sob\",\"cfg\":{\"surface\":\"oop_boot,oop_session,class_guard,method_guard,field_guard,OOP_SESSION_OK,NEED_CLASSES,NEED_METHODS,NEED_FIELDS\",\"contract\":\"full OOP plane · init --oop\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"oop_catalog\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  SYS RM agent_path
  CLEAR_ERR
  SYS RM peer_path
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_oop_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "oop_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "oop_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — full OOP plane green
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob\nFleetSlot"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHODS = "FleetJob.ping\nFleetJob.admit\nFleetSlot.take"
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELDS = "FleetJob.id\nFleetJob.status\nFleetSlot.n"
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  INCLUDE oop_boot
  LET oop = OOP_SESSION_OK
  LET cgo = CLASS_GUARD_OK
  LET mgo = METHOD_GUARD_OK
  LET fgo = FIELD_GUARD_OK
  CLEAR_ERR
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF mgo == 1 THEN
    LET score = score + 1
  END
  IF fgo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "OOP_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "method_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "field_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_METHODS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "oop_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" oop ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop cgo mgo fgo note_msg
  CLEAR_ERR
END

# soft_cls — class soft miss sinks OOP_SESSION_OK
SYS EQS op "soft_cls"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob\nnosuch_class_oop_sob"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHODS = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELDS = ""
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  INCLUDE oop_session
  LET oop = OOP_SESSION_OK
  LET cgo = CLASS_GUARD_OK
  LET miss_n = CLASSMISS_N
  CLEAR_ERR
  IF oop == 0 THEN
    LET score = score + 1
  END
  IF cgo == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE CLASSMISS "nosuch_class_oop_sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # exact false friend
  LISTCLASSES
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "Fleet"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "class_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "OOP_SESSION_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "oop_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # recover empty
  LET NEED_CLASSES = ""
  LET CLASS_GUARD_SOFT = 0
  INCLUDE oop_session
  LET oop = OOP_SESSION_OK
  CLEAR_ERR
  IF oop == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_cls ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_cls score"
    FAIL "soft_cls score"
    CLEAR_ERR
  END
  SYS CAT "soft_cls:" miss_n ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_cls:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop miss_n note_msg
  CLEAR_ERR
END

# soft_meth — method soft miss sinks OOP
SYS EQS op "soft_meth"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHODS = "FleetJob.ping\nFleetJob.nosuch_meth_sob"
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELDS = ""
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 0
  INCLUDE oop_session
  LET oop = OOP_SESSION_OK
  LET mgo = METHOD_GUARD_OK
  LET cgo = CLASS_GUARD_OK
  LET miss_n = METHMISS_N
  CLEAR_ERR
  IF oop == 0 THEN
    LET score = score + 1
  END
  IF mgo == 0 THEN
    LET score = score + 1
  END
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE METHMISS "FleetJob.nosuch_meth_sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend: method name alone
  LISTMETHODS FleetJob
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "pin"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_METHODS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "method_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "oop_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_meth ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_meth score"
    FAIL "soft_meth score"
    CLEAR_ERR
  END
  SYS CAT "soft_meth:" miss_n ":sm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_meth:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop mgo note_msg
  CLEAR_ERR
END

# soft_fld — field soft miss sinks OOP
SYS EQS op "soft_fld"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob"
  LET NEED_METHODS = "FleetJob.ping"
  LET NEED_FIELDS = "FleetJob.id\nFleetJob.nosuch_fld_sob"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  INCLUDE oop_session
  LET oop = OOP_SESSION_OK
  LET fgo = FIELD_GUARD_OK
  LET mgo = METHOD_GUARD_OK
  LET miss_n = FLDMISS_N
  CLEAR_ERR
  IF oop == 0 THEN
    LET score = score + 1
  END
  IF fgo == 0 THEN
    LET score = score + 1
  END
  IF mgo == 1 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE FLDMISS "FleetJob.nosuch_fld_sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LISTFIELDS FleetJob
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "i"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FIELDS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "field_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "OOP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_fld ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_fld score"
    FAIL "soft_fld score"
    CLEAR_ERR
  END
  SYS CAT "soft_fld:" miss_n ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_fld:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop fgo note_msg
  CLEAR_ERR
END

# hard — present full plane under hard soft=0
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob\nFleetSlot"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHODS = "FleetJob.ping\nFleetSlot.take"
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELDS = "FleetJob.id\nFleetSlot.tag"
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  INCLUDE oop_boot
  LET oop = OOP_SESSION_OK
  LET cgo = CLASS_GUARD_OK
  LET mgo = METHOD_GUARD_OK
  LET fgo = FIELD_GUARD_OK
  CLEAR_ERR
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF mgo == 1 THEN
    LET score = score + 1
  END
  IF fgo == 1 THEN
    LET score = score + 1
  END
  # ANY path with real dual
  LET NEED_CLASSES = ""
  LET NEED_METHODS = ""
  LET NEED_FIELDS = ""
  LET NEED_CLASS_ANY = "nosuch_z\nFleetJob"
  LET NEED_METHOD_ANY = "nosuch_m\nFleetJob.admit"
  LET NEED_FIELD_ANY = "nosuch_f\nFleetJob.status"
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  INCLUDE oop_session
  LET oop = OOP_SESSION_OK
  CLEAR_ERR
  IF oop == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "oop_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FIELDS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "oop_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "plane"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:" oop ":hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop note_msg
  CLEAR_ERR
END

# form — HASLIB / HASINCLUDE stack
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = ""
  LET NEED_METHODS = ""
  LET NEED_FIELDS = ""
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  INCLUDE oop_boot
  CLEAR_ERR
  HASLIB oop_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB oop_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB class_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB method_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB field_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE oop_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "OOP_SESSION_OK"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "oop_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "field_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + soft full plane
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob\nFleetSlot"
  LET NEED_METHODS = "FleetJob.ping\nFleetSlot.take"
  LET NEED_FIELDS = "FleetJob.id\nFleetSlot.n"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  INCLUDE oop_boot
  LET oop = OOP_SESSION_OK
  LET cgo = CLASS_GUARD_OK
  LET mgo = METHOD_GUARD_OK
  LET fgo = FIELD_GUARD_OK
  CLEAR_ERR
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF cgo == 1 THEN
    LET score = score + 1
  END
  IF mgo == 1 THEN
    LET score = score + 1
  END
  IF fgo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_CLASSES"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_METHODS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FIELDS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "oop_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · capture OOP_SESSION_OK
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_CLASSES = "FleetJob"
  LET NEED_METHODS = "FleetJob.ping"
  LET NEED_FIELDS = "FleetJob.id\nFleetJob.status"
  LET NEED_CLASS_ANY = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELD_ANY = ""
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  INCLUDE oop_session
  LET oop = OOP_SESSION_OK
  LET fgo = FIELD_GUARD_OK
  LET have_n = FLDHAVE_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF oop == 1 THEN
    LET score = score + 1
  END
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 2 THEN
    LET score = score + 1
  END
  SYS LINES FLDHAVE
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "oop_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "oop_session"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "method_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "oop_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sob"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oop have_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " oop=" oop " cgo=" cgo " mgo=" mgo " fgo=" fgo " have_n=" have_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "sob report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
