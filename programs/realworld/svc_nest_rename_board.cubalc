# svc_nest_rename_board.cubalc — RENAMEPOBJ nest key rename / schema promote
#
# Real use: fleet schema-migration agents rename nested cfg keys in place
# (legacy field → canonical) without GETOBJ+RENAMEP+SETOBJ glue, including
# peer mesh plates. First realworld of proof 1180 (MEANINGFUL 639).
#
#   RENAMEPOBJ nest old new       · MOVEKEYOBJ / NESTRENAME aliases
#   RENAMEPOBJ FROM PEER …
#   RENAMEPOBJ nest old AS new FROM PEER
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_snr_$$
#   ./out/cubalc run programs/realworld/svc_nest_rename_board.cubalc boot
#   ./out/cubalc run ... rename|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SNR_REPORT.txt agent.json peer.json keys.txt
# Env: HOST_S ROLE_S CUBALC_SNR_REQUIRE
#
# Edges:
#   soft old-key miss n=0; soft nest miss; same-name no-op; WRITE NL;
#   substring false friend; NUM softens REQUIRE; EXIT shell (W7)

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_nest_rename_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_nest_rename -- boot|rename|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SNR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SNR_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "keys.txt"
LET keys_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET key_bag = ""
LET soft_ok = 0
LET gate_ok = 0
LET ren_n = 0

ONEOF ACTION "boot", "rename", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "rename" THEN
    LET op = "rename"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — seed legacy nest keys
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-rename\",\"schema\":\"cubalc.svc_nest_rename.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"cfg\":{\"port\":8080,\"retries\":2,\"old_name\":\"legacy\",\"tls\":0},\"labels\":{\"env\":\"dev\",\"tier\":\"cold\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"cfg\":{\"port\":8080,\"svc_name\":\"api\",\"zone\":\"east\",\"tls\":1},\"schema\":\"cubalc.svc_nest_rename.v1\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  KEYSOBJ "cfg"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "old_name"
  LET has_n = LAST_N
  CLEAR_ERR
  GETPOBJ "cfg" "old_name"
  SYS EQS LAST "legacy"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST host_s
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET take_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot host"
        FAIL "boot host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot old_name val"
      FAIL "boot old_name val"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot old_name key"
    FAIL "boot old_name key"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# rename — promote old_name -> name on agent cfg
SYS EQS op "rename"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEPOBJ "cfg" "old_name" "name"
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  KEYSOBJ "cfg"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "name"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "old_name"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPOBJ "cfg" "name"
  SYS EQS LAST "legacy"
  LET load_hit = LAST_N
  CLEAR_ERR
  # siblings intact
  GETPOBJ "cfg" "port"
  SYS EQS LAST "8080"
  LET take_n = LAST_N
  CLEAR_ERR
  # false friend: old substring must not match as key line
  SYS HASLINE key_bag "old"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 0 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF miss_n == 0 THEN
            LET hit = 1
            LET note_msg = "rename ok"
            LET admit_n = 1
            LET ren_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "rename false old"
            FAIL "rename false old"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "rename port"
          FAIL "rename port"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "rename name val"
        FAIL "rename name val"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "rename old remain"
      FAIL "rename old remain"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "rename name key"
    FAIL "rename name key"
    CLEAR_ERR
  END
  SYS CAT "rename:name:rn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "rename:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit take_n note_msg
  CLEAR_ERR
END

# peer — rename svc_name -> name on PEER cfg
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEPOBJ FROM PEER "cfg" "svc_name" "name"
  CLEAR_ERR
  KEYSOBJ FROM PEER "cfg"
  LET key_bag = LAST
  CLEAR_ERR
  SYS WRITE keys_path key_bag
  CLEAR_ERR
  SYS HASLINE key_bag "name"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "svc_name"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPOBJ FROM PEER "cfg" "name"
  SYS EQS LAST "api"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "agent"
  SYS EQS LAST "hive-peer"
  LET take_n = LAST_N
  CLEAR_ERR
  # agent plate not clobbered by peer rename
  GETPOBJ "cfg" "port"
  SYS EQS LAST "8080"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SAVEP FROM PEER peer_path
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 0 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF soft_ok == 1 THEN
            LET hit = 1
            LET note_msg = "peer ok"
            LET admit_n = 1
            LET ren_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "peer agent plate"
            FAIL "peer agent plate"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer agent"
          FAIL "peer agent"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer name val"
        FAIL "peer name val"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer svc remain"
      FAIL "peer svc remain"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer name key"
    FAIL "peer name key"
    CLEAR_ERR
  END
  SYS CAT "peer:name:pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

# soft — old miss + nest miss (n=0, OK soft)
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  RENAMEPOBJ "cfg" "nope_key" "x"
  LET soft_ok = 0
  IF OK == 1 THEN
    LET soft_ok = 1
  END
  CLEAR_ERR
  HASPOBJ "cfg" "x"
  LET has_n = LAST_N
  CLEAR_ERR
  RENAMEPOBJ "ghost_nest" "a" "b"
  LET peel_hit = 0
  IF OK == 1 THEN
    LET peel_hit = 1
  END
  CLEAR_ERR
  HASP "ghost_nest"
  LET load_hit = LAST_N
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET take_n = LAST_N
  CLEAR_ERR
  IF soft_ok == 1 THEN
    IF has_n == 0 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 0 THEN
          IF take_n == 0 THEN
            LET hit = 1
            LET note_msg = "soft ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "soft empty bag"
            FAIL "soft empty bag"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft ghost created"
          FAIL "soft ghost created"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft nest miss ok"
        FAIL "soft nest miss ok"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft x created"
      FAIL "soft x created"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft key miss"
    FAIL "soft key miss"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# gate — canonical name present, legacy gone
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  HASPOBJ "cfg" "name"
  LET has_n = LAST_N
  CLEAR_ERR
  HASPOBJ "cfg" "old_name"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETPOBJ "cfg" "name" OR ""
  SYS EQS LAST "legacy"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_nest_rename"
  LET take_n = LAST_N
  CLEAR_ERR
  LENOBJ "cfg"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 0 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF miss_n >= 3 THEN
            LET hit = 1
            LET gate_ok = 1
            LET admit_n = 1
            LET note_msg = "gate ok"
          ELSE
            LET miss = 1
            LET note_msg = "gate len"
            FAIL "gate len"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate schema"
          FAIL "gate schema"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate name val"
        FAIL "gate name val"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate old remain"
      FAIL "gate old remain"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate name miss"
    FAIL "gate name miss"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# probe — MOVEKEYOBJ / NESTRENAME aliases + same-name + trailing AS FROM
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  MOVEKEYOBJ "labels" "env" "environment"
  CLEAR_ERR
  KEYSOBJ "labels"
  LET key_bag = LAST
  CLEAR_ERR
  SYS HASLINE key_bag "environment"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE key_bag "env"
  LET peel_hit = LAST_N
  CLEAR_ERR
  NESTRENAME "labels" "tier" "class"
  CLEAR_ERR
  HASPOBJ "labels" "class"
  LET load_hit = LAST_N
  CLEAR_ERR
  # same-name no-op hit
  RENAMEPOBJ "cfg" "port" "port"
  CLEAR_ERR
  GETPOBJ "cfg" "port"
  SYS EQS LAST "8080"
  LET take_n = LAST_N
  CLEAR_ERR
  # trailing AS FROM PEER if zone still present
  HASPOBJ FROM PEER "cfg" "zone"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF soft_ok == 1 THEN
    RENAMEPOBJ "cfg" "zone" AS "region" FROM PEER
    CLEAR_ERR
    HASPOBJ FROM PEER "cfg" "region"
    LET soft_ok = LAST_N
    CLEAR_ERR
  END
  GETP "agent"
  SYS EQS LAST "svc-rename"
  LET miss_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SAVEP FROM PEER peer_path
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 0 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF soft_ok == 1 THEN
            IF miss_n == 1 THEN
              LET hit = 1
              LET note_msg = "probe ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "probe agent"
              FAIL "probe agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe peer AS"
            FAIL "probe peer AS"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe port same"
          FAIL "probe port same"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe nestrename"
        FAIL "probe nestrename"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe env remain"
      FAIL "probe env remain"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe movekey"
    FAIL "probe movekey"
    CLEAR_ERR
  END
  SYS CAT "probe:alias:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_nest_rename.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " ren=" ren_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_nest_rename_board: end"
