# conn_pool_drain_board.cubalc — OOP conn pool + DELETEALL/FREEALL drain
#
# Real use: agents hold a small DB/HTTP connection pool (c0..c2) with free/busy
# lifecycle, plus a Guard marker object that must survive pool wipe. When the
# pool is poisoned or a deploy rolls, drain with class-filtered DELETEALL Conn
# without shell loops — then optionally FREEALL everything.
#
# Surfaces forced:
#   CLASS Conn + Guard / NEW / SEND / GETF / SETF
#   DELETEALL Conn          — class-filtered bulk free (1.15.329+)
#   FREEALL / DELETEALL     — unfiltered wipe
#   EACH OBJ Conn           — free/busy/stale rollup
#   DUMPOBJ plate rehydrate — multi-run ARG dispatch
#   bag journal + COUNTLINE / SETMATCH / MOVELINE / REMOVELINE
#   TRYSEND / TRYSETF soft   — probe missing methods/fields
#   ARG/ENV dispatch + REQUIRE soft miss
#
# Distinct from work_slot_pool (bag tokens only), worker_fleet (claim/tick),
# circuit_breaker (trip/half state machine): this board is *pool drain* via
# DELETEALL + plate dump hygiene (drain without RM rehydrates next run!).
#
# Slots (fixed idents — string-var names still fail GETF outside EACH):
#   Conn: c0 c1 c2
#   Guard: g0
#
# Plate under STATE:
#   dump/c0 dump/c1 dump/c2 dump/g0
#   JOURNAL.txt OBJS.txt VAL.txt META.txt POOL_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_CP_ACTION):
#   list      — LISTOBJS Conn (+ Guard count in meta)
#   open      — NEW Conn ARG1=c0|c1|c2
#   guard     — NEW Guard g0
#   use       — SEND use → busy, uses++
#   release   — SEND release → free
#   stale     — SEND stale
#   rollup    — EACH: n_free n_busy n_stale
#   drain     — DELETEALL Conn + RM conn dumps (keeps Guard)
#   wipe      — DELETEALL (all live) + RM all dumps
#   freeall   — FREEALL alias of wipe body (same)
#   kill      — DELETEOBJ one slot
#   journal   — PUSH slot:event (ARG2 or use)
#   count     — COUNTLINE exact journal needle
#   pin       — MOVELINE first exact journal row to front
#   drop      — REMOVELINE exact
#   setmatch  — SETMATCH old=ARG1 new=ARG2
#   probe     — soft TRYSEND/TRYSETF
#   dump      — DUMPOBJ live slots
#   gate      — n_free >= MIN (default 1); REQUIRE→2 deny
#   clear     — free all + wipe plate files
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_cp_$$
#   CUBALC_ARG0=open CUBALC_ARG1=c0
#   CUBALC_ARG0=use CUBALC_ARG1=c0
#   CUBALC_ARG0=drain
#   CUBALC_ARG0=gate CUBALC_CP_MIN=1 CUBALC_CP_REQUIRE=1
#
# Env: CUBALC_CP_REQUIRE CUBALC_CP_NAME CUBALC_CP_MIN CUBALC_CP_ACTION
#
# Edges:
#   DELETEALL is process-local — without RM dumps, next run rehydrates "drained" conns
#   DUMPOBJ on EACH bind o fails; string-var object names fail GETF
#   SETMATCH first-only; COUNTLINE exact (c0 false-friends c0:use)
#   sticky last_err after soft; WRITE no trailing NL; REQUIRE softens non-numeric

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS Conn
  FIELD id ""
  FIELD state "free"
  FIELD uses 0
  METHOD init i
    SETF THIS id i
    SETF THIS state "free"
    SETF THIS uses 0
  END
  METHOD use
    GETF THIS state
    LET st = LAST
    SYS EQS st "stale"
    IF LAST_N == 1 THEN
      RET 0
    END
    SETF THIS state "busy"
    GETF THIS uses
    LET u = LAST_N + 1
    SETF THIS uses u
    RET u
  END
  METHOD release
    GETF THIS state
    LET st = LAST
    SYS EQS st "stale"
    IF LAST_N == 1 THEN
      RET 0
    END
    SETF THIS state "free"
    RET 1
  END
  METHOD stale
    SETF THIS state "stale"
    RET 1
  END
  METHOD is_free
    GETF THIS state
    LET st = LAST
    SYS EQS st "free"
    RET LAST_N
  END
END

CLASS Guard
  FIELD id ""
  FIELD tag "pool"
  METHOD init i
    SETF THIS id i
    SETF THIS tag "pool"
  END
END

NOTE "conn_pool_drain_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT REQUIRE_HIT = 0
DEFAULT MIN_FREE = 1
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_CP_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_CP_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_CP_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_CP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_CP_MIN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MIN_FREE = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "dump"
LET dump_dir = LAST
SYS MKDIR dump_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JOURNAL.txt"
LET journal_path = LAST
SYS JOIN state_dir "POOL_REPORT.txt"
LET report_path = LAST
SYS JOIN dump_dir "c0"
LET d_c0 = LAST
SYS JOIN dump_dir "c1"
LET d_c1 = LAST
SYS JOIN dump_dir "c2"
LET d_c2 = LAST
SYS JOIN dump_dir "g0"
LET d_g0 = LAST

# slot resolve: c0=0 c1=1 c2=2 g0=10
LET slot = -1
SYS EQS NAME "c0"
IF LAST_N == 1 THEN
  LET slot = 0
END
SYS EQS NAME "c1"
IF LAST_N == 1 THEN
  LET slot = 1
END
SYS EQS NAME "c2"
IF LAST_N == 1 THEN
  LET slot = 2
END
SYS EQS NAME "g0"
IF LAST_N == 1 THEN
  LET slot = 10
END
LET sn = ""
IF slot == 0 THEN
  LET sn = "c0"
END
IF slot == 1 THEN
  LET sn = "c1"
END
IF slot == 2 THEN
  LET sn = "c2"
END
IF slot == 10 THEN
  LET sn = "g0"
END

# rehydrate c0
SYS READ OR d_c0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ c0
  IF LAST_N == 1 THEN
    DELETEOBJ c0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "state"
  LET rst = LAST
  SYS LOOKUPN snap "uses"
  LET rus = LAST_N
  CLEAR_ERR
  NEW Conn c0 rid
  TRYSETF c0 state rst
  CLEAR_ERR
  TRYSETF c0 uses rus
  CLEAR_ERR
END
# rehydrate c1
SYS READ OR d_c1 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ c1
  IF LAST_N == 1 THEN
    DELETEOBJ c1
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "state"
  LET rst = LAST
  SYS LOOKUPN snap "uses"
  LET rus = LAST_N
  CLEAR_ERR
  NEW Conn c1 rid
  TRYSETF c1 state rst
  CLEAR_ERR
  TRYSETF c1 uses rus
  CLEAR_ERR
END
# rehydrate c2
SYS READ OR d_c2 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ c2
  IF LAST_N == 1 THEN
    DELETEOBJ c2
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "state"
  LET rst = LAST
  SYS LOOKUPN snap "uses"
  LET rus = LAST_N
  CLEAR_ERR
  NEW Conn c2 rid
  TRYSETF c2 state rst
  CLEAR_ERR
  TRYSETF c2 uses rus
  CLEAR_ERR
END
# rehydrate g0
SYS READ OR d_g0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ g0
  IF LAST_N == 1 THEN
    DELETEOBJ g0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUP snap "tag"
  LET rtag = LAST
  CLEAR_ERR
  NEW Guard g0 rid
  TRYSETF g0 tag rtag
  CLEAR_ERR
END

SYS READ OR journal_path OR ""
LET jbag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET gate_n = 0
LET nobjs = 0
LET n_free = 0
LET n_busy = 0
LET n_stale = 0
LET ret_n = 0
LET j_changed = 0
LET freed_n = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS Conn
  LET bag = LAST
  LET nobjs = NOBJS
  LISTOBJS Guard
  LET ng = NOBJS
  SYS WRITE objs_path bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR ng
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- open Conn ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    IF slot == 10 THEN
      LET miss = 1
      LET note_msg = "open use guard action"
      FAIL "open use guard action"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "open use guard action"
      END
    ELSE
      IF slot == 0 THEN
        HASOBJ c0
        IF LAST_N == 1 THEN
          DELETEOBJ c0
          CLEAR_ERR
        END
        NEW Conn c0 sn
        DUMPOBJ c0
        SYS WRITE d_c0 LAST
        CLEAR_ERR
      END
      IF slot == 1 THEN
        HASOBJ c1
        IF LAST_N == 1 THEN
          DELETEOBJ c1
          CLEAR_ERR
        END
        NEW Conn c1 sn
        DUMPOBJ c1
        SYS WRITE d_c1 LAST
        CLEAR_ERR
      END
      IF slot == 2 THEN
        HASOBJ c2
        IF LAST_N == 1 THEN
          DELETEOBJ c2
          CLEAR_ERR
        END
        NEW Conn c2 sn
        DUMPOBJ c2
        SYS WRITE d_c2 LAST
        CLEAR_ERR
      END
      LISTOBJS Conn
      LET nobjs = NOBJS
      SYS WRITE objs_path LAST
      CLEAR_ERR
      LET hit = 1
      LET note_msg = "open ok"
      LET val = sn
      LET val_ch = 1
      LET meta = "open"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- guard ---
SYS EQS ACTION "guard"
IF LAST_N == 1 THEN
  NOTE "action guard"
  HASOBJ g0
  IF LAST_N == 1 THEN
    DELETEOBJ g0
    CLEAR_ERR
  END
  NEW Guard g0 "g0"
  DUMPOBJ g0
  SYS WRITE d_g0 LAST
  CLEAR_ERR
  LISTOBJS Guard
  LET nobjs = NOBJS
  LET hit = 1
  LET note_msg = "guard ok"
  LET val = "g0"
  LET val_ch = 1
  LET meta = "guard"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- use ---
SYS EQS ACTION "use"
IF LAST_N == 1 THEN
  NOTE "action use"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "use bad slot"
    FAIL "use bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "use bad slot"
    END
  ELSE
    IF slot == 10 THEN
      LET miss = 1
      LET note_msg = "use not on guard"
      FAIL "use not on guard"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "use not on guard"
      END
    ELSE
      LET ok_send = 0
      IF slot == 0 THEN
        HASOBJ c0
        IF LAST_N == 1 THEN
          SEND c0 use
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c0
          SYS WRITE d_c0 LAST
          CLEAR_ERR
        END
      END
      IF slot == 1 THEN
        HASOBJ c1
        IF LAST_N == 1 THEN
          SEND c1 use
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c1
          SYS WRITE d_c1 LAST
          CLEAR_ERR
        END
      END
      IF slot == 2 THEN
        HASOBJ c2
        IF LAST_N == 1 THEN
          SEND c2 use
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c2
          SYS WRITE d_c2 LAST
          CLEAR_ERR
        END
      END
      IF ok_send == 0 THEN
        LET miss = 1
        LET note_msg = "use no obj"
        FAIL "use no obj"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "use no obj"
        END
      ELSE
        IF ret_n == 0 THEN
          LET miss = 1
          LET note_msg = "use blocked stale"
          FAIL "use blocked stale"
          CLEAR_ERR
          IF REQUIRE_HIT > 0 THEN
            EXIT 2 "use blocked stale"
          END
        ELSE
          LET jev = "SLOT:use"
          SYS REPLACEALL jev "SLOT" sn
          LET jev = LAST
          SYS PUSH jbag jev
          LET jbag = LAST
          LET j_changed = 1
          LET hit = 1
          LET note_msg = "use ok"
          SYS STR ret_n
          LET val = LAST
          LET val_ch = 1
          LET meta = "use"
          SYS PUSH meta sn
          LET meta = LAST
          SYS PUSH meta val
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- release ---
SYS EQS ACTION "release"
IF LAST_N == 1 THEN
  NOTE "action release"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "release bad slot"
    FAIL "release bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "release bad slot"
    END
  ELSE
    IF slot == 10 THEN
      LET miss = 1
      LET note_msg = "release not on guard"
      FAIL "release not on guard"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "release not on guard"
      END
    ELSE
      LET ok_send = 0
      IF slot == 0 THEN
        HASOBJ c0
        IF LAST_N == 1 THEN
          SEND c0 release
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c0
          SYS WRITE d_c0 LAST
          CLEAR_ERR
        END
      END
      IF slot == 1 THEN
        HASOBJ c1
        IF LAST_N == 1 THEN
          SEND c1 release
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c1
          SYS WRITE d_c1 LAST
          CLEAR_ERR
        END
      END
      IF slot == 2 THEN
        HASOBJ c2
        IF LAST_N == 1 THEN
          SEND c2 release
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c2
          SYS WRITE d_c2 LAST
          CLEAR_ERR
        END
      END
      IF ok_send == 0 THEN
        LET miss = 1
        LET note_msg = "release no obj"
        FAIL "release no obj"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "release no obj"
        END
      ELSE
        IF ret_n == 0 THEN
          LET miss = 1
          LET note_msg = "release blocked stale"
          FAIL "release blocked stale"
          CLEAR_ERR
          IF REQUIRE_HIT > 0 THEN
            EXIT 2 "release blocked stale"
          END
        ELSE
          LET jev = "SLOT:release"
          SYS REPLACEALL jev "SLOT" sn
          LET jev = LAST
          SYS PUSH jbag jev
          LET jbag = LAST
          LET j_changed = 1
          LET hit = 1
          LET note_msg = "release ok"
          LET val = sn
          LET val_ch = 1
          LET meta = "release"
          SYS PUSH meta sn
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- stale ---
SYS EQS ACTION "stale"
IF LAST_N == 1 THEN
  NOTE "action stale"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "stale bad slot"
    FAIL "stale bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stale bad slot"
    END
  ELSE
    IF slot == 10 THEN
      LET miss = 1
      LET note_msg = "stale not on guard"
      FAIL "stale not on guard"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "stale not on guard"
      END
    ELSE
      LET ok_send = 0
      IF slot == 0 THEN
        HASOBJ c0
        IF LAST_N == 1 THEN
          SEND c0 stale
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c0
          SYS WRITE d_c0 LAST
          CLEAR_ERR
        END
      END
      IF slot == 1 THEN
        HASOBJ c1
        IF LAST_N == 1 THEN
          SEND c1 stale
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c1
          SYS WRITE d_c1 LAST
          CLEAR_ERR
        END
      END
      IF slot == 2 THEN
        HASOBJ c2
        IF LAST_N == 1 THEN
          SEND c2 stale
          LET ret_n = LAST_N
          LET ok_send = 1
          DUMPOBJ c2
          SYS WRITE d_c2 LAST
          CLEAR_ERR
        END
      END
      IF ok_send == 0 THEN
        LET miss = 1
        LET note_msg = "stale no obj"
        FAIL "stale no obj"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "stale no obj"
        END
      ELSE
        LET jev = "SLOT:stale"
        SYS REPLACEALL jev "SLOT" sn
        LET jev = LAST
        SYS PUSH jbag jev
        LET jbag = LAST
        LET j_changed = 1
        LET hit = 1
        LET note_msg = "stale ok"
        LET val = sn
        LET val_ch = 1
        LET meta = "stale"
        SYS PUSH meta sn
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- rollup EACH ---
SYS EQS ACTION "rollup"
IF LAST_N == 1 THEN
  NOTE "action rollup"
  LET n_free = 0
  LET n_busy = 0
  LET n_stale = 0
  EACH OBJ Conn AS o
    GETF o state
    LET st = LAST
    SYS EQS st "free"
    IF LAST_N == 1 THEN
      LET n_free = n_free + 1
    END
    SYS EQS st "busy"
    IF LAST_N == 1 THEN
      LET n_busy = n_busy + 1
    END
    SYS EQS st "stale"
    IF LAST_N == 1 THEN
      LET n_stale = n_stale + 1
    END
  END
  LISTOBJS Conn
  LET nobjs = NOBJS
  LET hit = 1
  LET note_msg = "rollup ok"
  LET meta = "rollup"
  SYS STR n_free
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR n_busy
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR n_stale
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  # SYS JOIN is path-join only — use REPLACEALL template
  LET val = "f:F b:B s:S"
  SYS STR n_free
  SYS REPLACEALL val "F" LAST
  LET val = LAST
  SYS STR n_busy
  SYS REPLACEALL val "B" LAST
  LET val = LAST
  SYS STR n_stale
  SYS REPLACEALL val "S" LAST
  LET val = LAST
  LET val_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- drain: DELETEALL Conn + RM conn dumps (Guard stays) ---
SYS EQS ACTION "drain"
IF LAST_N == 1 THEN
  NOTE "action drain"
  DELETEALL Conn
  LET freed_n = DELETEALL_N
  # plate hygiene — without RM, next process rehydrates "drained" conns
  SYS RM d_c0
  CLEAR_ERR
  SYS RM d_c1
  CLEAR_ERR
  SYS RM d_c2
  CLEAR_ERR
  HASOBJ g0
  LET has_g = LAST_N
  LISTOBJS Conn
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET jev = "pool:drain"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "drain ok"
  SYS STR freed_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "drain"
  SYS PUSH meta val
  LET meta = LAST
  SYS STR has_g
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON freed_n
  CLEAR_ERR
END

# --- wipe / freeall: DELETEALL all + RM dumps ---
SYS EQS ACTION "wipe"
IF LAST_N == 1 THEN
  NOTE "action wipe"
  DELETEALL
  LET freed_n = DELETEALL_N
  SYS RM d_c0
  CLEAR_ERR
  SYS RM d_c1
  CLEAR_ERR
  SYS RM d_c2
  CLEAR_ERR
  SYS RM d_g0
  CLEAR_ERR
  LISTOBJS
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET jev = "pool:wipe"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "wipe ok"
  SYS STR freed_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "wipe"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON freed_n
  CLEAR_ERR
END

SYS EQS ACTION "freeall"
IF LAST_N == 1 THEN
  NOTE "action freeall"
  FREEALL
  LET freed_n = FREEALL_N
  SYS RM d_c0
  CLEAR_ERR
  SYS RM d_c1
  CLEAR_ERR
  SYS RM d_c2
  CLEAR_ERR
  SYS RM d_g0
  CLEAR_ERR
  LISTOBJS
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET jev = "pool:freeall"
  SYS PUSH jbag jev
  LET jbag = LAST
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "freeall ok"
  SYS STR freed_n
  LET val = LAST
  LET val_ch = 1
  LET meta = "freeall"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON freed_n
  CLEAR_ERR
END

# --- kill one ---
SYS EQS ACTION "kill"
IF LAST_N == 1 THEN
  NOTE "action kill"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "kill bad slot"
    FAIL "kill bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "kill bad slot"
    END
  ELSE
    LET ok_del = 0
    IF slot == 0 THEN
      HASOBJ c0
      IF LAST_N == 1 THEN
        DELETEOBJ c0
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_c0
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ c1
      IF LAST_N == 1 THEN
        DELETEOBJ c1
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_c1
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ c2
      IF LAST_N == 1 THEN
        DELETEOBJ c2
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_c2
      CLEAR_ERR
    END
    IF slot == 10 THEN
      HASOBJ g0
      IF LAST_N == 1 THEN
        DELETEOBJ g0
        CLEAR_ERR
        LET ok_del = 1
      END
      SYS RM d_g0
      CLEAR_ERR
    END
    IF ok_del == 0 THEN
      LET miss = 1
      LET note_msg = "kill miss"
      FAIL "kill miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "kill miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "kill ok"
      LET val = sn
      LET val_ch = 1
      LET meta = "kill"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- journal ---
SYS EQS ACTION "journal"
IF LAST_N == 1 THEN
  NOTE "action journal"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "journal needs slot"
    FAIL "journal needs slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "journal needs slot"
    END
  ELSE
    LET ev = "use"
    SYS BLANK A2
    IF LAST_N == 0 THEN
      LET ev = A2
    END
    LET jev = "DEP:EV"
    SYS REPLACEALL jev "DEP" NAME
    LET jev = LAST
    SYS REPLACEALL jev "EV" ev
    LET jev = LAST
    SYS PUSH jbag jev
    LET jbag = LAST
    LET j_changed = 1
    LET hit = 1
    LET note_msg = "journal ok"
    LET val = jev
    LET val_ch = 1
    LET meta = "journal"
    SYS PUSH meta jev
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

