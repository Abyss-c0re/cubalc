SYS MS
LET t1ms = MS
LET dt = t1ms - t0ms
LET report = "conn_pool_drain_board"
SYS PUSH report run_date
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS STR dt
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report
CLEAR_ERR

NOTE "conn_pool_drain_board: done"
IF miss > 0 THEN
  IF REQUIRE_HIT > 0 THEN
    EXIT 2 note_msg
  END
END
EXIT 0 note_msg
