# --- setmatch ---
SYS EQS ACTION "setmatch"
IF LAST_N == 1 THEN
  NOTE "action setmatch"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "setmatch needs old"
    FAIL "setmatch needs old"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "setmatch needs old"
    END
  ELSE
    SYS BLANK A2
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "setmatch needs new"
      FAIL "setmatch needs new"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "setmatch needs new"
      END
    ELSE
      SYS HASLINE jbag NAME
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "setmatch miss"
        FAIL "setmatch miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "setmatch miss"
        END
      ELSE
        SYS SETMATCH jbag NAME A2
        IF LAST_N == 0 THEN
          LET miss = 1
          LET note_msg = "setmatch fail"
          FAIL "setmatch fail"
          CLEAR_ERR
        ELSE
          LET jbag = LAST
          LET j_changed = 1
          LET hit = 1
          LET note_msg = "setmatch ok"
          LET val = A2
          LET val_ch = 1
          LET meta = "setmatch"
          SYS PUSH meta NAME
          LET meta = LAST
          SYS PUSH meta A2
          LET meta = LAST
          LET meta_ch = 1
        END
      END
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- probe soft ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET soft_m = 0
  LET soft_f = 0
  LET soft_o = 0
  HASOBJ c0
  IF LAST_N == 1 THEN
    TRYSEND c0 no_such_method
    IF OK == 0 THEN
      LET soft_m = 1
    END
    CLEAR_ERR
    TRYSETF c0 no_such_field 1
    IF OK == 0 THEN
      LET soft_f = 1
    END
    CLEAR_ERR
    TRYGETF c0 no_such_field OR "miss"
    LET val = LAST
    CLEAR_ERR
  ELSE
    TRYSEND ghost_conn tick
    IF OK == 0 THEN
      LET soft_o = 1
    END
    CLEAR_ERR
    LET soft_m = 1
    LET soft_f = 1
  END
  LET hit = 1
  LET note_msg = "probe ok"
  LET meta = "probe"
  SYS STR soft_m
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR soft_f
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR soft_o
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  LET val_ch = 1
  PRINT_JSON meta
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  HASOBJ c0
  IF LAST_N == 1 THEN
    DUMPOBJ c0
    SYS WRITE d_c0 LAST
    CLEAR_ERR
  END
  HASOBJ c1
  IF LAST_N == 1 THEN
    DUMPOBJ c1
    SYS WRITE d_c1 LAST
    CLEAR_ERR
  END
  HASOBJ c2
  IF LAST_N == 1 THEN
    DUMPOBJ c2
    SYS WRITE d_c2 LAST
    CLEAR_ERR
  END
  HASOBJ g0
  IF LAST_N == 1 THEN
    DUMPOBJ g0
    SYS WRITE d_g0 LAST
    CLEAR_ERR
  END
  LISTOBJS Conn
  LET nobjs = NOBJS
  SYS WRITE objs_path LAST
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "dump ok"
  SYS STR nobjs
  LET val = LAST
  LET val_ch = 1
  LET meta = "dump"
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- gate: n_free >= MIN_FREE ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  LET n_free = 0
  EACH OBJ Conn AS o
    GETF o state
    LET st = LAST
    SYS EQS st "free"
    IF LAST_N == 1 THEN
      LET n_free = n_free + 1
    END
  END
  IF n_free >= MIN_FREE THEN
    LET hit = 1
    LET gate_n = 1
    LET note_msg = "gate admit"
    LET val = "admit"
    LET val_ch = 1
  ELSE
    LET miss = 1
    LET gate_n = 0
    LET note_msg = "gate deny"
    LET val = "deny"
    LET val_ch = 1
    FAIL "gate deny pool free low"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate deny pool free low"
    END
  END
  LET meta = "gate"
  SYS STR n_free
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR MIN_FREE
  SYS PUSH meta LAST
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  DELETEALL
  CLEAR_ERR
  SYS RM d_c0
  CLEAR_ERR
  SYS RM d_c1
  CLEAR_ERR
  SYS RM d_c2
  CLEAR_ERR
  SYS RM d_g0
  CLEAR_ERR
  SYS RM journal_path
  CLEAR_ERR
  SYS RM objs_path
  CLEAR_ERR
  SYS RM val_path
  CLEAR_ERR
  SYS RM meta_path
  CLEAR_ERR
  SYS RM report_path
  CLEAR_ERR
  LET jbag = ""
  LET j_changed = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

