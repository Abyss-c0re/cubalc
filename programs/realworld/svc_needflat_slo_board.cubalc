# svc_needflat_slo_board.cubalc — NEEDFLAT contract + GETFLATN peel + AVGFLAT mean
#
# Real use: mesh SLO agents fail-fast on missing leaf needles (tls/port/role),
# peel pure-int latency/hits without GETFLAT+NUM glue, and mean score bands
# for canary admit. First realworld of proofs 1228 NEEDFLAT + 1229 GETFLATN
# + 1230 AVGFLAT.
#
#   NEEDFLAT|REQUIREFLAT [FROM plate] needle… · soft twin HASFLAT
#   GETFLATN|FIRSTFLATN needle [OR n] · AVGFLAT|MEANFLAT needle
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sns_$$
#   ./out/cubalc run programs/realworld/svc_needflat_slo_board.cubalc boot
#   ./out/cubalc run ... need|getn|avg|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SNS_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SNS_REQUIRE
#
# Edges:
#   NEEDFLAT hard-fail on miss (shell≠0); soft uses HASFLAT twin; GETFLATN
#   skips non-int; AVG truncates toward 0; substring needle; WRITE NL; NUM softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_needflat_slo_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_needflat_slo -- boot|need|getn|avg|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeN"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SNS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SNS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET keep_n = 0
LET sum_n = 0
LET path_val = ""

ONEOF ACTION "boot", "need", "getn", "avg", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "need" THEN
    LET op = "need"
  WHEN "getn" THEN
    LET op = "getn"
  WHEN "avg" THEN
    LET op = "avg"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — tls/port/scores/hits plate for contract + numeric SLO
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-needflat\",\"schema\":\"cubalc.svc_needflat_slo.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"tls\":{\"on\":1},\"agent_id\":\"a1\",\"cfg\":{\"port\":8080,\"host\":\"h\"},\"scores\":{\"a\":10,\"b\":20,\"c\":30},\"hits\":{\"x\":3,\"y\":9},\"label\":\"slo\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_needflat_slo.v1\",\"host\":\"" host_s "\",\"role\":\"leader\",\"lat\":{\"p50\":100,\"p95\":200},\"hits\":{\"a\":4,\"b\":8},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "tls.on"
  SYS EQS LAST "1"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "scores.b"
  SYS EQS LAST "20"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "agent_id"
  SYS EQS LAST "a1"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slo"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 1 THEN
            LET hit = 1
            LET note_msg = "boot ok"
            LET admit_n = 1
            LET take_n = 1
            LET keep_n = 3
          ELSE
            LET miss = 1
            LET note_msg = "boot label"
            FAIL "boot label"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "boot agent_id"
          FAIL "boot agent_id"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot scores.b"
        FAIL "boot scores.b"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot port"
      FAIL "boot port"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot tls"
    FAIL "boot tls"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok has_n note_msg
  CLEAR_ERR
END

# need — NEEDFLAT multi-needle contract (pass path)
SYS EQS op "need"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  NEEDFLAT "tls" "agent_id" "port"
  LET keep_n = NEEDFLAT_N
  LET miss_n = NEEDFLAT_MISS_N
  CLEAR_ERR
  REQUIREFLAT "cfg"
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-needflat"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slo"
  LET load_hit = LAST_N
  CLEAR_ERR
  # soft twin: HASFLAT still true for same needles
  HASFLAT "tls"
  LET soft_ok = LAST_N
  CLEAR_ERR
  HASFLAT "port"
  LET has_n = LAST_N
  CLEAR_ERR
  IF keep_n == 3 THEN
    IF miss_n == 0 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              LET hit = 1
              LET note_msg = "need ok"
              LET admit_n = 1
              LET take_n = 3
            ELSE
              LET miss = 1
              LET note_msg = "need has port"
              FAIL "need has port"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "need has tls"
            FAIL "need has tls"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "need label"
          FAIL "need label"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "need agent"
        FAIL "need agent"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "need miss_n"
      FAIL "need miss_n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "need n"
    FAIL "need n"
    CLEAR_ERR
  END
  SYS STR keep_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "need:" w_s ":nd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "need:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n miss_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

# getn — GETFLATN pure-int peel + OR fallback (host string skipped)
SYS EQS op "getn"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETFLATN "port"
  LET take_n = LAST_N
  LET peel_hit = GETFLATN_HIT
  CLEAR_ERR
  SYS EQS GETFLATN_PATH "cfg.port"
  LET load_hit = LAST_N
  CLEAR_ERR
  # host is string — GETFLATN skips non-int → fallback
  GETFLATN "host" OR 0
  LET has_n = LAST_N
  CLEAR_ERR
  # miss → OR 8080
  GETFLATN "nope" OR 8080
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETFLATN "hits"
  LET keep_n = LAST_N
  CLEAR_ERR
  # plate unchanged
  GETP "cfg.port"
  SYS EQS LAST "8080"
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slo"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF take_n == 8080 THEN
      IF load_hit == 1 THEN
        IF has_n == 0 THEN
          IF soft_ok == 8080 THEN
            IF keep_n == 3 THEN
              IF miss_n == 1 THEN
                IF gate_ok == 1 THEN
                  LET hit = 1
                  LET note_msg = "getn ok"
                  LET admit_n = 1
                ELSE
                  LET miss = 1
                  LET note_msg = "getn label"
                  FAIL "getn label"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "getn plate"
                FAIL "getn plate"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "getn hits first"
              FAIL "getn hits first"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "getn fallback"
            FAIL "getn fallback"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "getn host skip"
          FAIL "getn host skip"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "getn path"
        FAIL "getn path"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "getn port val"
      FAIL "getn port val"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "getn hit"
    FAIL "getn hit"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "getn:" w_s ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "getn:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit keep_n soft_ok note_msg
  CLEAR_ERR
END

# avg — AVGFLAT mean of scores (20) + empty-needle band
SYS EQS op "avg"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  AVGFLAT "scores"
  LET take_n = LAST_N
  # capture specials immediately (W377 class)
  LET keep_n = AVGFLAT_N
  LET sum_n = AVGFLAT_SUM
  CLEAR_ERR
  # truncation: 1+2 → 1
  SETP "u.x" 1
  CLEAR_ERR
  SETP "u.y" 2
  CLEAR_ERR
  AVGFLAT "u"
  LET peel_hit = LAST_N
  CLEAR_ERR
  AVGFLAT "nope"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "scores.a"
  SYS EQS LAST "10"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "slo"
  LET has_n = LAST_N
  CLEAR_ERR
  IF take_n == 20 THEN
    IF keep_n == 3 THEN
      IF sum_n == 60 THEN
        IF peel_hit == 1 THEN
          IF load_hit == 0 THEN
            IF soft_ok == 1 THEN
              IF has_n == 1 THEN
                LET hit = 1
                LET note_msg = "avg ok"
                LET admit_n = 1
                LET miss_n = 0
              ELSE
                LET miss = 1
                LET note_msg = "avg label"
                FAIL "avg label"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "avg scores.a"
              FAIL "avg scores.a"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "avg nope"
            FAIL "avg nope"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "avg trunc"
          FAIL "avg trunc"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "avg sum"
        FAIL "avg sum"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "avg n"
      FAIL "avg n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "avg mean"
    FAIL "avg mean"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "avg:" w_s ":av"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "avg:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n keep_n sum_n peel_hit note_msg
  CLEAR_ERR
END

# peer — NEEDFLAT + GETFLATN + AVGFLAT FROM PEER
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  NEEDFLAT FROM PEER "role" "lat"
  LET keep_n = NEEDFLAT_N
  CLEAR_ERR
  GETFLATN FROM PEER "hits" OR 0
  LET take_n = LAST_N
  CLEAR_ERR
  AVGFLAT FROM PEER "lat"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # agent plate unchanged
  GETP "agent"
  SYS EQS LAST "svc-needflat"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF keep_n == 2 THEN
    IF take_n == 4 THEN
      IF peel_hit == 150 THEN
        IF soft_ok == 1 THEN
          IF has_n == 1 THEN
            IF load_hit == 1 THEN
              LET hit = 1
              LET note_msg = "peer ok"
              LET admit_n = 1
              LET miss_n = 0
            ELSE
              LET miss = 1
              LET note_msg = "peer agent port"
              FAIL "peer agent port"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer agent"
            FAIL "peer agent"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer tag"
          FAIL "peer tag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer avg lat"
        FAIL "peer avg lat"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer getn hits"
      FAIL "peer getn hits"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer need n"
    FAIL "peer need n"
    CLEAR_ERR
  END
  SYS STR peel_hit
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "peer:" w_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n take_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

# soft — HASFLAT twin for miss (NEEDFLAT would hard-fail); GETFLATN/AVG empty
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # soft twin — do NOT call NEEDFLAT "ghost" (hard fail-fast)
  HASFLAT "ghostpath"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETFLATN "ghostpath" OR 99
  LET take_n = LAST_N
  CLEAR_ERR
  AVGFLAT "ghostpath"
  LET load_hit = LAST_N
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-needflat"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # contract still holds on real needles
  HASFLAT "tls"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 0 THEN
    IF take_n == 99 THEN
      IF load_hit == 0 THEN
        IF miss_n == 0 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              LET hit = 1
              LET note_msg = "soft ok"
              LET admit_n = 1
              LET keep_n = 0
            ELSE
              LET miss = 1
              LET note_msg = "soft tls"
              FAIL "soft tls"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft agent"
            FAIL "soft agent"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft empty bag"
          FAIL "soft empty bag"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft avg"
        FAIL "soft avg"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft getn or"
      FAIL "soft getn or"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft has ghost"
    FAIL "soft has ghost"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit take_n load_hit soft_ok note_msg
  CLEAR_ERR
END

# gate — NEEDFLAT contract + avg score band + port peel
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  NEEDFLAT "tls" "port" "agent_id"
  LET keep_n = NEEDFLAT_N
  CLEAR_ERR
  GETFLATN "port"
  LET take_n = LAST_N
  CLEAR_ERR
  AVGFLAT "scores"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_needflat_slo"
  LET miss_n = LAST_N
  CLEAR_ERR
  # band: mean 20 in [10,50]
  LET load_hit = 0
  IF peel_hit >= 10 THEN
    IF peel_hit <= 50 THEN
      LET load_hit = 1
    END
  END
  CLEAR_ERR
  IF keep_n == 3 THEN
    IF take_n == 8080 THEN
      IF load_hit == 1 THEN
        IF miss_n == 1 THEN
          LET hit = 1
          LET gate_ok = 1
          LET admit_n = 1
          LET note_msg = "gate ok"
          LET soft_ok = 1
          LET has_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "gate schema"
          FAIL "gate schema"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate avg band"
        FAIL "gate avg band"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate port"
      FAIL "gate port"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate need"
    FAIL "gate need"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok take_n peel_hit keep_n note_msg
  CLEAR_ERR
END

# probe — FIRSTFLATN / MEANFLAT aliases + hard NEEDFLAT miss documented via soft only
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "probe.p1" 40
  CLEAR_ERR
  SETP "probe.p2" 80
  CLEAR_ERR
  SETP "probe.name" "run"
  CLEAR_ERR
  FIRSTFLATN "probe"
  LET take_n = LAST_N
  CLEAR_ERR
  MEANFLAT "probe"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # 40+80=120/2=60
  GETP "probe.name"
  SYS EQS LAST "run"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-needflat"
  LET has_n = LAST_N
  CLEAR_ERR
  # empty needle first pure-int on tiny plate reseed path: use hits
  GETFLATN "hits"
  LET keep_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF take_n == 40 THEN
    IF peel_hit == 60 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF keep_n == 3 THEN
            LET hit = 1
            LET note_msg = "probe ok"
            LET admit_n = 1
            LET load_hit = 1
            LET miss_n = 0
          ELSE
            LET miss = 1
            LET note_msg = "probe hits"
            FAIL "probe hits"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe agent"
          FAIL "probe agent"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe name"
        FAIL "probe name"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe mean"
      FAIL "probe mean"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe first"
    FAIL "probe first"
    CLEAR_ERR
  END
  SYS CAT "probe:alias:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit keep_n soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_needflat_slo.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " keep=" keep_n " take=" take_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_needflat_slo_board: end"
