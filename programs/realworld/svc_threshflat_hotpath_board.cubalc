# svc_threshflat_hotpath_board.cubalc — THRESHFLAT/DROPZEROFLAT path denoise + TOPPATHFLAT hot/cold
#
# Real use: mesh metric agents scrub zero counters and noise floors by path
# needle across deep plates, then rank hot/cold leaves for paging without
# GREPFLAT+EACH walks. First realworld of proofs 1222 THRESHFLAT/DROPZEROFLAT
# + 1221 TOPPATHFLAT/BOTPATHFLAT (MEANINGFUL 644–645).
#
#   THRESHFLAT needle min · DROPZEROFLAT needle · KEEPVFLAT alias
#   TOPPATHFLAT|MAXPATHFLAT · BOTPATHFLAT|MINPATHFLAT · … FROM PEER
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sth_$$
#   ./out/cubalc run programs/realworld/svc_threshflat_hotpath_board.cubalc boot
#   ./out/cubalc run ... dropz|thresh|hot|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt STH_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_STH_REQUIRE
#
# Edges:
#   path needle substring false-friend (hits vs meta.hits); soft no-match;
#   pure-int only (strings survive); WRITE NL; NUM softens REQUIRE; EXIT shell (W7)

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_threshflat_hotpath_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_threshflat_hotpath -- boot|dropz|thresh|hot|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeH"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_STH_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "STH_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET keep_n = 0
LET drop_n = 0
LET bot_v = 0
LET top_v = 0
LET path_val = ""

ONEOF ACTION "boot", "dropz", "thresh", "hot", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "dropz" THEN
    LET op = "dropz"
  WHEN "thresh" THEN
    LET op = "thresh"
  WHEN "hot" THEN
    LET op = "hot"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — nested hits/lat with zeros, noise floor, hotspot; peer mesh
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-threshflat\",\"schema\":\"cubalc.svc_threshflat_hotpath.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"hits\":{\"a\":10,\"b\":2,\"c\":5,\"z\":0},\"meta\":{\"hits\":1,\"role\":\"w\"},\"lat\":{\"west\":90,\"east\":40,\"south\":0},\"label\":\"mesh\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_threshflat_hotpath.v1\",\"host\":\"" host_s "\",\"hits\":{\"x\":0,\"y\":8,\"w\":3},\"lat\":{\"north\":70,\"core\":12},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "hits.a"
  SYS EQS LAST "10"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "hits.z"
  SYS EQS LAST "0"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "lat.west"
  SYS EQS LAST "90"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "meta.hits"
  SYS EQS LAST "1"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mesh"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 1 THEN
            LET hit = 1
            LET note_msg = "boot ok"
            LET admit_n = 1
            LET take_n = 1
            LET keep_n = 4
          ELSE
            LET miss = 1
            LET note_msg = "boot label"
            FAIL "boot label"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "boot meta.hits"
          FAIL "boot meta.hits"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot lat.west"
        FAIL "boot lat.west"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot hits.z"
      FAIL "boot hits.z"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot hits.a"
    FAIL "boot hits.a"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok has_n note_msg
  CLEAR_ERR
END

# dropz — DROPZEROFLAT path needle: zeros under hits* and lat*
SYS EQS op "dropz"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  DROPZEROFLAT "hits"
  LET keep_n = DROPZEROFLAT_N
  LET drop_n = DROPZEROFLAT_DROP
  CLEAR_ERR
  DROPZEROFLAT "lat"
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "hits.z"
  SYS EQS LAST ""
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "hits.a"
  SYS EQS LAST "10"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "lat.south"
  SYS EQS LAST ""
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "lat.west"
  SYS EQS LAST "90"
  LET has_n = LAST_N
  CLEAR_ERR
  # meta.hits=1 is non-zero — survives dropzero (false-friend path still present)
  GETP "meta.hits"
  SYS EQS LAST "1"
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mesh"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 1 THEN
            IF gate_ok == 1 THEN
              LET hit = 1
              LET note_msg = "dropz ok"
              LET admit_n = 1
              LET take_n = keep_n
            ELSE
              LET miss = 1
              LET note_msg = "dropz label"
              FAIL "dropz label"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "dropz meta.hits"
            FAIL "dropz meta.hits"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "dropz lat.west"
          FAIL "dropz lat.west"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "dropz lat.south remain"
        FAIL "dropz lat.south remain"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "dropz hits.a"
      FAIL "dropz hits.a"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "dropz hits.z remain"
    FAIL "dropz hits.z remain"
    CLEAR_ERR
  END
  SYS STR drop_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "dropz:" w_s ":dz"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "dropz:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n drop_n peel_hit soft_ok note_msg
  CLEAR_ERR
END

# thresh — THRESHFLAT "hits" 5: keep a=10 c=5; drop b=2 and meta.hits=1 (needle false friend)
SYS EQS op "thresh"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  THRESHFLAT "hits" 5
  LET keep_n = THRESHFLAT_N
  LET drop_n = THRESHFLAT_DROP
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  GETP "hits.a"
  SYS EQS LAST "10"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "hits.c"
  SYS EQS LAST "5"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "hits.b"
  SYS EQS LAST ""
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "meta.hits"
  SYS EQS LAST ""
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "meta.role"
  SYS EQS LAST "w"
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mesh"
  LET gate_ok = LAST_N
  CLEAR_ERR
  # lat untouched by hits needle
  GETP "lat.east"
  SYS EQS LAST "40"
  LET take_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 1 THEN
            IF gate_ok == 1 THEN
              IF take_n == 1 THEN
                LET hit = 1
                LET note_msg = "thresh ok"
                LET admit_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "thresh lat.east"
                FAIL "thresh lat.east"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "thresh label"
              FAIL "thresh label"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "thresh meta.role"
            FAIL "thresh meta.role"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "thresh meta.hits remain"
          FAIL "thresh meta.hits remain"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "thresh hits.b remain"
        FAIL "thresh hits.b remain"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "thresh hits.c"
      FAIL "thresh hits.c"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "thresh hits.a"
    FAIL "thresh hits.a"
    CLEAR_ERR
  END
  SYS STR keep_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "thresh:" w_s ":th"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "thresh:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n keep_n drop_n peel_hit has_n note_msg
  CLEAR_ERR
END

# hot — TOPPATHFLAT / BOTPATHFLAT on lat needle
SYS EQS op "hot"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # LAST=path · LAST_N=extreme value (HELP dual; prefer over *_V specials after other ops)
  TOPPATHFLAT "lat"
  LET path_val = LAST
  LET top_v = LAST_N
  LET keep_n = top_v
  LET take_n = TOPPATHFLAT_N
  CLEAR_ERR
  SYS EQS path_val "lat.west"
  LET peel_hit = LAST_N
  CLEAR_ERR
  BOTPATHFLAT "lat"
  LET body = LAST
  LET bot_v = LAST_N
  LET drop_n = bot_v
  CLEAR_ERR
  SYS EQS body "lat.east"
  LET load_hit = LAST_N
  CLEAR_ERR
  # empty needle still finds global max (west 90)
  TOPPATHFLAT ""
  LET w_s = LAST
  CLEAR_ERR
  SYS EQS w_s "lat.west"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # false friend: substring "lat" does not match "label"
  GETP "label"
  SYS EQS LAST "mesh"
  LET has_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF top_v == 90 THEN
      IF load_hit == 1 THEN
        IF bot_v == 40 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              LET hit = 1
              LET note_msg = "hot ok"
              LET admit_n = 1
              LET miss_n = 0
            ELSE
              LET miss = 1
              LET note_msg = "hot label"
              FAIL "hot label"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "hot empty needle"
            FAIL "hot empty needle"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "hot bot v"
          FAIL "hot bot v"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "hot bot path"
        FAIL "hot bot path"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "hot top v"
      FAIL "hot top v"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "hot top path"
    FAIL "hot top path"
    CLEAR_ERR
  END
  SYS CAT "hot:" path_val ":ht"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val keep_n body drop_n note_msg
  CLEAR_ERR
END

# peer — DROPZEROFLAT + TOPPATHFLAT FROM PEER (read/write peer plate)
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  DROPZEROFLAT FROM PEER "hits"
  LET keep_n = DROPZEROFLAT_N
  LET drop_n = DROPZEROFLAT_DROP
  CLEAR_ERR
  TOPPATHFLAT FROM PEER "lat"
  LET path_val = LAST
  LET top_v = LAST_N
  LET take_n = top_v
  CLEAR_ERR
  SYS EQS path_val "lat.north"
  LET peel_hit = LAST_N
  CLEAR_ERR
  BOTPATHFLAT FROM PEER "lat"
  LET body = LAST
  LET bot_v = LAST_N
  CLEAR_ERR
  SYS EQS body "lat.core"
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "hits.x"
  SYS EQS LAST ""
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP FROM PEER "hits.y"
  SYS EQS LAST "8"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  LET miss_n = LAST_N
  CLEAR_ERR
  # agent plate untouched by FROM PEER
  GETP "agent"
  SYS EQS LAST "svc-threshflat"
  LET gate_ok = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "peer.json"
  LET peer_path = LAST
  CLEAR_ERR
  SAVEP FROM PEER peer_path
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF top_v == 70 THEN
      IF load_hit == 1 THEN
        IF soft_ok == 1 THEN
          IF has_n == 1 THEN
            IF miss_n == 1 THEN
              IF gate_ok == 1 THEN
                LET hit = 1
                LET note_msg = "peer ok"
                LET admit_n = 1
                LET take_n = top_v
              ELSE
                LET miss = 1
                LET note_msg = "peer agent leak"
                FAIL "peer agent leak"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "peer tag"
              FAIL "peer tag"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer hits.y"
            FAIL "peer hits.y"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer hits.x remain"
          FAIL "peer hits.x remain"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer bot"
        FAIL "peer bot"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer top v"
      FAIL "peer top v"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer top path"
    FAIL "peer top path"
    CLEAR_ERR
  END
  SYS STR top_v
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "peer:" w_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val take_n soft_ok has_n note_msg
  CLEAR_ERR
END

# soft — no-match needle + empty bag edges
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  TOPPATHFLAT "ghostpath"
  LET path_val = LAST
  LET take_n = LAST_N
  LET keep_n = TOPPATHFLAT_N
  CLEAR_ERR
  SYS EQS path_val ""
  LET peel_hit = LAST_N
  CLEAR_ERR
  THRESHFLAT "ghostpath" 1
  LET drop_n = THRESHFLAT_DROP
  LET soft_ok = 0
  IF OK == 1 THEN
    LET soft_ok = 1
  END
  CLEAR_ERR
  DROPZEROFLAT "ghostpath"
  CLEAR_ERR
  # empty bag lines
  LET body = ""
  SYS LINES body
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-threshflat"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF keep_n == 0 THEN
      IF take_n == 0 THEN
        IF soft_ok == 1 THEN
          IF miss_n == 0 THEN
            IF load_hit == 1 THEN
              LET hit = 1
              LET note_msg = "soft ok"
              LET admit_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "soft agent"
              FAIL "soft agent"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft empty bag"
            FAIL "soft empty bag"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft thresh ok"
          FAIL "soft thresh ok"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft top v"
        FAIL "soft top v"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft top n"
      FAIL "soft top n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft empty path"
    FAIL "soft empty path"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok" soft_ok ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n soft_ok peel_hit keep_n load_hit note_msg
  CLEAR_ERR
END

# gate — post denoise: hits clean (>=5 or gone), hot path west, schema ok
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "hits.b"
  SYS EQS LAST ""
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP "hits.z"
  SYS EQS LAST ""
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "hits.a"
  SYS EQS LAST "10"
  LET soft_ok = LAST_N
  CLEAR_ERR
  TOPPATHFLAT "lat"
  LET path_val = LAST
  CLEAR_ERR
  SYS EQS path_val "lat.west"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_threshflat_hotpath"
  LET miss_n = LAST_N
  CLEAR_ERR
  # false friend: meta.hits should be gone after thresh
  GETP "meta.hits"
  SYS EQS LAST ""
  LET take_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF miss_n == 1 THEN
            IF take_n == 1 THEN
              LET hit = 1
              LET gate_ok = 1
              LET admit_n = 1
              LET note_msg = "gate ok"
            ELSE
              LET miss = 1
              LET note_msg = "gate meta.hits"
              FAIL "gate meta.hits"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "gate schema"
            FAIL "gate schema"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate top"
          FAIL "gate top"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate hits.a"
        FAIL "gate hits.a"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate hits.z"
      FAIL "gate hits.z"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate hits.b"
    FAIL "gate hits.b"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF gate_ok == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" gate_ok ":gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok path_val peel_hit soft_ok note_msg
  CLEAR_ERR
END

# probe — MAXPATHFLAT/MINPATHFLAT + KEEPVFLAT aliases on scratch nest
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "probe.p1" 40
  CLEAR_ERR
  SETP "probe.p2" 150
  CLEAR_ERR
  SETP "probe.p3" 80
  CLEAR_ERR
  SETP "probe.name" "run"
  CLEAR_ERR
  MAXPATHFLAT "probe"
  LET path_val = LAST
  LET top_v = LAST_N
  LET keep_n = top_v
  CLEAR_ERR
  SYS EQS path_val "probe.p2"
  LET peel_hit = LAST_N
  CLEAR_ERR
  MINPATHFLAT "probe"
  LET body = LAST
  LET bot_v = LAST_N
  LET drop_n = bot_v
  CLEAR_ERR
  SYS EQS body "probe.p1"
  LET load_hit = LAST_N
  CLEAR_ERR
  # KEEPVFLAT is THRESHFLAT alias (keep pure-int leaves value>=min), not exact-eq
  KEEPVFLAT "probe" 80
  CLEAR_ERR
  GETP "probe.p3"
  SYS EQS LAST "80"
  LET soft_ok = LAST_N
  CLEAR_ERR
  GETP "probe.p2"
  SYS EQS LAST "150"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "probe.p1"
  SYS EQS LAST ""
  LET gate_ok = LAST_N
  CLEAR_ERR
  GETP "probe.name"
  SYS EQS LAST "run"
  LET miss_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-threshflat"
  LET take_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF top_v == 150 THEN
      IF load_hit == 1 THEN
        IF bot_v == 40 THEN
          IF soft_ok == 1 THEN
            IF has_n == 1 THEN
              IF gate_ok == 1 THEN
                IF miss_n == 1 THEN
                  IF take_n == 1 THEN
                    LET hit = 1
                    LET note_msg = "probe ok"
                    LET admit_n = 1
                  ELSE
                    LET miss = 1
                    LET note_msg = "probe agent"
                    FAIL "probe agent"
                    CLEAR_ERR
                  END
                ELSE
                  LET miss = 1
                  LET note_msg = "probe name"
                  FAIL "probe name"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "probe keepv p1"
                FAIL "probe keepv p1"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe keepv p2"
              FAIL "probe keepv p2"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe keepv p3"
            FAIL "probe keepv p3"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe min v"
          FAIL "probe min v"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe min path"
        FAIL "probe min path"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe max v"
      FAIL "probe max v"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe max path"
    FAIL "probe max path"
    CLEAR_ERR
  END
  SYS CAT "probe:alias:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n path_val keep_n soft_ok has_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_threshflat_hotpath.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " keep=" keep_n " drop=" drop_n " path=" path_val " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_threshflat_hotpath_board: end"
