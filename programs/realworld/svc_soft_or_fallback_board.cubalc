# svc_soft_or_fallback_board.cubalc — CALL/SEND … OR soft plugin defaults
#
# Real use: ops agents call optional runbook FNs and object methods with
# explicit fallback values when plugins/methods are missing — no IF HASFN
# then CALL else LET glue.
# First realworld of 1441 CALL OR / TRYCALL OR + 1442 SEND OR / TRYSEND OR
# (1.15.897+). Distinct from CALLANY/SENDANY (first-hit among many) — this
# is single-name soft with DEFAULT/FALLBACK value.
#
#   TRYCALL|CALL name [args] OR|DEFAULT|FALLBACK val · CALL_OR · CALLED
#   TRYSEND|SEND obj meth [args] OR|DEFAULT|FALLBACK val · SEND_OR · SEND_N
#   hit: CALL_OR/SEND_OR=0 · miss soft: OR=1 OK=1 · bare TRY miss OK=0
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sof_$$
#   ./out/cubalc run programs/realworld/svc_soft_or_fallback_board.cubalc boot
#   ./out/cubalc run ... pass|soft|call|send|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SOF_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_SOF_REQUIRE
#
# Edges: OR unused on hit; string fallback LET-able (W808); hit RET string
#   may not LET (W798 class); capture LAST_N; CLEAR_ERR; REQUIRE LIB quoted

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

FN greet name
  RET name
END

FN add a b
  RET a + b
END

FN ping
  RET 7
END

CLASS FleetWorker
  FIELD n 0
  METHOD tick
    GETF THIS n
    LET v = LAST_N + 1
    SETF THIS n v
    RET v
  END
  METHOD bump d
    GETF THIS n
    LET v = LAST_N + d
    SETF THIS n v
    RET v
  END
END

NOTE "svc_soft_or_fallback_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_soft_or_fallback -- boot|pass|soft|call|send|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SOF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SOF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET call_or = 0
LET send_or = 0
LET ret_n = 0
LET called = 0

ONEOF ACTION "boot", "pass", "soft", "call", "send", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "call" THEN
    LET op = "call"
  WHEN "send" THEN
    LET op = "send"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-sof\",\"schema\":\"cubalc.svc_soft_or_fallback.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"sof\",\"want_filter\":\"soft_or_fallback\",\"cfg\":{\"surface\":\"TRYCALL OR,CALL OR,TRYSEND OR,SEND OR,CALL_OR,SEND_OR,DEFAULT,FALLBACK\",\"contract\":\"soft plugin/method defaults without HASFN IF glue\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  TRYCALL ping OR 0
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-sof"
  IF LAST_N == 1 THEN
    IF call_or == 0 THEN
      IF ret_n == 7 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot ret"
        FAIL "boot ret"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot or"
      FAIL "boot or"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — hit paths OR unused + miss with numeric/string fallback
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  TRYCALL ping OR 99
  LET ok_v = OK
  LET called = CALLED
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF called == 1 THEN
    LET score = score + 1
  END
  IF call_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 7 THEN
    LET score = score + 1
  END
  CALL add 3 4 OR 99
  LET called = CALLED
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF called == 1 THEN
    LET score = score + 1
  END
  IF call_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 7 THEN
    LET score = score + 1
  END
  NEW FleetWorker w0
  SETF w0 n 0
  CLEAR_ERR
  TRYSEND w0 tick OR 99
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "soft_or_fallback"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" call_or ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score call_or send_or note_msg
  CLEAR_ERR
END

# soft — miss paths with OR + bare TRY without OR
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  TRYCALL ghost_fn "x" OR "default_hi"
  LET ok_v = OK
  LET called = CALLED
  LET call_or = CALL_OR
  LET body = LAST
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF called == 0 THEN
    LET score = score + 1
  END
  IF call_or == 1 THEN
    LET score = score + 1
  END
  # fallback string is LET-assignable (unlike hit RET string — W808)
  SYS EQS body "default_hi"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL nosuch_plugin OR 42
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF call_or == 1 THEN
    LET score = score + 1
  END
  IF ret_n == 42 THEN
    LET score = score + 1
  END
  TRYCALL totally_missing
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW FleetWorker s0
  CLEAR_ERR
  TRYSEND s0 ghost_meth OR "idle"
  LET send_or = SEND_OR
  LET body = LAST
  CLEAR_ERR
  IF send_or == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "idle"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYSEND s0 totally_missing
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# call — DEFAULT/FALLBACK aliases + multi-arg
SYS EQS op "call"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  TRYCALL missing_add 1 2 DEFAULT 0
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF call_or == 1 THEN
    LET score = score + 1
  END
  IF ret_n == 0 THEN
    LET score = score + 1
  END
  TRYCALL ghost2 OR "z"
  LET call_or = CALL_OR
  LET body = LAST
  CLEAR_ERR
  IF call_or == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "z"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYCALL ghost3 FALLBACK 11
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF call_or == 1 THEN
    LET score = score + 1
  END
  IF ret_n == 11 THEN
    LET score = score + 1
  END
  TRYCALL add 10 5 OR 99
  LET called = CALLED
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF called == 1 THEN
    LET score = score + 1
  END
  IF call_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 15 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "soft_or_fallback"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "call ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "call score"
    FAIL "call score"
    CLEAR_ERR
  END
  SYS CAT "call:" call_or ":cl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "call:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score call_or note_msg
  CLEAR_ERR
END

# send — SEND OR object/method miss + DEFAULT + success with args
SYS EQS op "send"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW FleetWorker w1
  SETF w1 n 0
  CLEAR_ERR
  TRYSEND w1 tick OR 99
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  SEND missing_obj tick OR 0
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 1 THEN
    LET score = score + 1
  END
  IF ret_n == 0 THEN
    LET score = score + 1
  END
  TRYSEND w1 no_such DEFAULT 42
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 1 THEN
    LET score = score + 1
  END
  IF ret_n == 42 THEN
    LET score = score + 1
  END
  SETF w1 n 0
  CLEAR_ERR
  SEND w1 bump 3 OR 99
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 3 THEN
    LET score = score + 1
  END
  TRYSEND w1 ghost2 FALLBACK "z"
  LET send_or = SEND_OR
  LET body = LAST
  CLEAR_ERR
  IF send_or == 1 THEN
    LET score = score + 1
  END
  SYS EQS body "z"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "send ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "send score"
    FAIL "send score"
    CLEAR_ERR
  END
  SYS CAT "send:" send_or ":sd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "send:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score send_or note_msg
  CLEAR_ERR
END

# form — HASFORM TRYCALL/TRYSEND
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "TRYCALL"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "TRYSEND"
  LET send_or = LAST_N
  CLEAR_ERR
  HASFORM "CALL"
  LET call_or = LAST_N
  CLEAR_ERR
  HASFORM "SEND"
  LET ret_n = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF send_or == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF call_or == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF ret_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "SYS TRYCALL"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM TRYCALL
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFN ping
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "soft_or_fallback"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "CALL_OR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — hit+fallback pipeline + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  TRYCALL ping OR 0
  LET call_or = CALL_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF call_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 7 THEN
    LET score = score + 1
  END
  TRYCALL missing_gate OR 1
  LET call_or = CALL_OR
  CLEAR_ERR
  IF call_or == 1 THEN
    LET score = score + 1
  END
  NEW FleetWorker g0
  SETF g0 n 0
  CLEAR_ERR
  TRYSEND g0 tick OR 0
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 0 THEN
    LET score = score + 1
  END
  IF ret_n == 1 THEN
    LET score = score + 1
  END
  TRYSEND g0 ghost_g OR 9
  LET send_or = SEND_OR
  LET ret_n = LAST_N
  CLEAR_ERR
  IF send_or == 1 THEN
    LET score = score + 1
  END
  IF ret_n == 9 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-sof"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · CLEAR_ERR LAST · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  TRYCALL ping OR 0
  LET ret_n = LAST_N
  LET call_or = CALL_OR
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ret_n == 7 THEN
    LET score = score + 1
  END
  IF call_or == 0 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "soft_or_fallback"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "sendany_method"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYCALL ghost_probe OR 3
  IF CALL_OR == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = ret_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score call_or note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " call_or=" call_or " send_or=" send_or
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "sof report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
