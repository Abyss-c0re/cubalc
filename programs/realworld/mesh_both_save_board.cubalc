# mesh_both_save_board.cubalc — plate_both_save dual PLATE+PEER persist
#
# Real use: mesh agents end a session with one INCLUDE that writes both
# durable agent PLATE and PEER files (no dual plate_save + plate_peer_save).
# First realworld of proof 1143 plate_both_save.
#
#   INCLUDE plate_peer_session
#   # mutate PLATE / PEER
#   INCLUDE plate_both_save
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_mbs_$$
#   ./out/cubalc run programs/realworld/mesh_both_save_board.cubalc boot
#   ./out/cubalc run ... tick|status|save|reload|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt MBS_REPORT.txt agent.json peer.json
# Env: HOST_S CUBALC_MBS_REQUIRE
#
# Edges:
#   dual disk reload after both_save; SAVEP knobs flaky (prove via LOADP);
#   PEER host mutate independent of PLATE; soft empty bag; WRITE omit NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "mesh_both_save_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "mesh_both_save -- boot|tick|status|save|reload|gate|probe|soft|list -- [--host=H]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeC"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_MBS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "MBS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "tick", "status", "save", "reload", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "tick" THEN
    LET op = "tick"
  WHEN "status" THEN
    LET op = "status"
  WHEN "save" THEN
    LET op = "save"
  WHEN "reload" THEN
    LET op = "reload"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s
  CLEAR_ERR
END

# boot — plate_peer_session dual seed
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "agent" "plate-agent" "n" 1 "schema" "cubalc.mesh_both_save.v1"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS JSONOBJ "agent" "hive-02" "host" "cubeB" "n" 0
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "host"
  SYS EQS LAST "cubeB"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "agent" FROM body
  SYS EQS LAST "plate-agent"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET created = 1
        LET take_n = 1
        SYS CAT "boot:plate-agent:bt"
        LET row = LAST
        CLEAR_ERR
        SYS GREPV "boot:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot disk"
        FAIL "boot disk"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot peer host"
      FAIL "boot peer host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot agent"
    FAIL "boot agent"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# tick — INCP both + plate_both_save
SYS EQS op "tick"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCP "n"
  CLEAR_ERR
  INCP FROM PEER "n"
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "n" FROM body
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  SYS READ peer_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "n" FROM body
  SYS NUM
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF take_n == 2 THEN
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "tick ok"
      LET admit_n = 1
      LET has_n = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "tick peer n"
      FAIL "tick peer n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "tick plate n"
    FAIL "tick plate n"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  SYS STR peel_hit
  LET d_s = LAST
  CLEAR_ERR
  SYS CAT "tick:" w_s ":" d_s ":tk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "tick:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit note_msg
  CLEAR_ERR
END

# status — set PLATE status + PEER host + both_save
SYS EQS op "status"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "status" "ready"
  CLEAR_ERR
  SETP FROM PEER "host" host_s
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "ready"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS READ peer_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "host" FROM body
  SYS EQS LAST host_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "status ok"
      LET admit_n = 1
      LET take_n = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "status peer host"
      FAIL "status peer host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "status plate"
    FAIL "status plate"
    CLEAR_ERR
  END
  SYS CAT "status:" host_s ":st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "status:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit note_msg
  CLEAR_ERR
END

# save — second both_save after dual status mutate
SYS EQS op "save"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SETP "status" "done"
  CLEAR_ERR
  SETP FROM PEER "status" "acked"
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "done"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS READ peer_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "acked"
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "save ok"
      LET admit_n = 1
      LET take_n = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "save peer status"
      FAIL "save peer status"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "save plate status"
    FAIL "save plate status"
    CLEAR_ERR
  END
  SYS CAT "save:done:acked:sv"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "save:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit note_msg
  CLEAR_ERR
END

# reload — fresh session loads durable both
SYS EQS op "reload"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "status"
  SYS EQS LAST "done"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "status"
  SYS EQS LAST "acked"
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "host"
  LET out = LAST
  CLEAR_ERR
  SYS BLANK out
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 0 THEN
        LET hit = 1
        LET note_msg = "reload ok"
        LET admit_n = 1
        LET take_n = 1
      ELSE
        LET miss = 1
        LET note_msg = "reload host blank"
        FAIL "reload host blank"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "reload peer"
      FAIL "reload peer"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "reload plate"
    FAIL "reload plate"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "reload plate"
    END
  END
  SYS CAT "reload:done:acked:rl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "reload:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# gate — disk both_save fields
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "done"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "n" FROM body
  SYS NUM
  LET take_n = LAST_N
  CLEAR_ERR
  SYS READ peer_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "acked"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "n" FROM body
  SYS NUM
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n >= 2 THEN
        IF load_hit >= 1 THEN
          LET hit = 1
          LET note_msg = "gate ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "gate peer n"
          FAIL "gate peer n"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate plate n"
        FAIL "gate plate n"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate peer st"
      FAIL "gate peer st"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate plate st"
    FAIL "gate plate st"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate plate st"
    END
  END
  SYS STR take_n
  LET w_s = LAST
  SYS STR load_hit
  LET d_s = LAST
  CLEAR_ERR
  SYS CAT "gate:" w_s ":" d_s ":ga"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit take_n load_hit note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — NEEDP dual; JSONEQ order-independent after both_save identity
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  NEEDP "agent" "n"
  LET has_n = NEEDP_N
  CLEAR_ERR
  NEEDP FROM PEER "agent" "host"
  LET peel_hit = NEEDP_FROM
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  # order-independent equality self
  SYS JSONEQ body body
  LET take_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "plate-agent"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n == 1 THEN
        IF load_hit == 1 THEN
          LET hit = 1
          LET note_msg = "probe ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "probe agent"
          FAIL "probe agent"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe jsoneq"
        FAIL "probe jsoneq"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe need peer"
      FAIL "probe need peer"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe need plate"
    FAIL "probe need plate"
    CLEAR_ERR
  END
  PRINT_JSON has_n peel_hit take_n load_hit note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
SYS STR admit_n
LET out = LAST
CLEAR_ERR
SYS CAT "schema=cubalc.mesh_both_save.v1 op=" op " hit=" w_s " miss=" d_s " admit=" out " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "mbs op=" op " hit=" w_s " miss=" d_s " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n peel_hit has_n load_hit created note_msg
