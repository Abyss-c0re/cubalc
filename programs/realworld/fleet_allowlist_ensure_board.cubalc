# fleet_allowlist_ensure_board.cubalc — ENSUREBAGLINE + EACH LINE OF + EACH PROP
#
# Real use: fleet agents maintain per-env host allowlists (idempotent ensure
# without HAS+PUSH IF), walk members for prefix digest, and inventory schema
# props — without GETF+EACH LINE glue.
#
# Surfaces forced (1.15.415–417 / proof 965–967):
#   ENSUREBAGLINE / BAGENSURE / ENSUREBAGLINEI · TRYENSUREBAGLINE
#   ENSUREBAGLINE_NEW (1=appended, 0=already) · ENSUREBAGLINE_N size
#   EACH LINE AS x OF obj field · EACH_N / LINE_N / IT
#   EACH PROP OF obj|Class · NFIELDS · ATTR alias
#   LINESF count · dump/aN.bag side files (DUMPOBJ multiline unsafe)
#   soft miss + REQUIRE wall
#
# Distinct from oncall_roster_hygiene (sort/uniq/has/drop), work_queue_bag
# (push/pop/grep), fleet_allowlist_merge (host bag merge): this is
# *idempotent ensure + field walk + prop inventory*.
#
# Slots: a0 a1 a2
#
# Plate under STATE:
#   dump/a0 dump/a1 dump/a2
#   dump/a0.bag dump/a1.bag dump/a2.bag
#   VAL.txt META.txt OBJS.txt PROPS.txt ALLOW_REPORT.txt
#
# Actions:
#   list | open | ensure | size | walk | props | has | gate | probe | dump | clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_fae_$$
#   CUBALC_ARG0=open CUBALC_ARG1=a0
#   CUBALC_FS_HOST=api.prod CUBALC_ARG0=ensure CUBALC_ARG1=a0
#   CUBALC_FS_PFX=api CUBALC_ARG0=walk CUBALC_ARG1=a0
#   CUBALC_FS_MINN=2 CUBALC_ARG0=gate CUBALC_ARG1=a0
#
# Env: CUBALC_FS_REQUIRE NAME HOST PFX MINN ACTION
#
# Edges:
#   ENSUREBAGLINE exact match; case-sensitive vs ENSUREBAGLINEI
#   empty HOST ensure still NEW=1 (adds blank line)
#   ENSUREBAGLINE_NEW not ENSUREBAGLINE_HIT
#   DUMPOBJ multiline unsafe — side bags
#   WRITE NL; NUM softens REQUIRE=abc

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS AllowList
  FIELD id ""
  FIELD allow ""
  FIELD n 0
  FIELD pref 0
  FIELD tag "fleet"
  METHOD init i
    SETF THIS id i
    SETF THIS allow ""
    SETF THIS n 0
    SETF THIS pref 0
    SETF THIS tag "fleet"
  END
  METHOD ensure_host h
    ENSUREBAGLINE THIS allow h
  END
END

REQUIRE CLASS AllowList
REQUIRE METHOD AllowList init

NOTE "fleet_allowlist_ensure_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT NEED_HIT = 0
DEFAULT HOST = "api.prod"
DEFAULT PFX = "api"
DEFAULT MINN = 1
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_FS_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_FS_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
  LET HOST = LAST
ELSE
  SYS ENV "CUBALC_FS_A2" OR ""
  IF LAST_N > 0 THEN
    LET A2 = LAST
    LET HOST = LAST
  END
END
SYS ENV "CUBALC_FS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET NEED_HIT = LAST_N
  END
END
SYS ENV "CUBALC_FS_HOST" OR ""
IF LAST_N > 0 THEN
  LET HOST = LAST
END
SYS ENV "CUBALC_FS_PFX" OR ""
IF LAST_N > 0 THEN
  LET PFX = LAST
END
SYS ENV "CUBALC_FS_MINN" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET MINN = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "dump"
LET dump_dir = LAST
SYS MKDIR dump_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "PROPS.txt"
LET props_path = LAST
SYS JOIN state_dir "ALLOW_REPORT.txt"
LET report_path = LAST
SYS JOIN dump_dir "a0"
LET d_a0 = LAST
SYS JOIN dump_dir "a1"
LET d_a1 = LAST
SYS JOIN dump_dir "a2"
LET d_a2 = LAST
SYS JOIN dump_dir "a0.bag"
LET b_a0 = LAST
SYS JOIN dump_dir "a1.bag"
LET b_a1 = LAST
SYS JOIN dump_dir "a2.bag"
LET b_a2 = LAST

LET slot = -1
SYS EQS NAME "a0"
IF LAST_N == 1 THEN
  LET slot = 0
END
SYS EQS NAME "a1"
IF LAST_N == 1 THEN
  LET slot = 1
END
SYS EQS NAME "a2"
IF LAST_N == 1 THEN
  LET slot = 2
END
LET sn = ""
IF slot == 0 THEN
  LET sn = "a0"
END
IF slot == 1 THEN
  LET sn = "a1"
END
IF slot == 2 THEN
  LET sn = "a2"
END

# rehydrate
SYS READ OR d_a0 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ a0
  IF LAST_N == 1 THEN
    DELETEOBJ a0
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUPN snap "n"
  LET rn = LAST_N
  SYS LOOKUPN snap "pref"
  LET rp = LAST_N
  SYS LOOKUP snap "tag"
  LET rtag = LAST
  CLEAR_ERR
  NEW AllowList a0 rid
  SYS BLANK rid
  IF LAST_N == 0 THEN
    TRYSETF a0 id rid
  END
  TRYSETF a0 n rn
  TRYSETF a0 pref rp
  SYS BLANK rtag
  IF LAST_N == 0 THEN
    TRYSETF a0 tag rtag
  END
  SYS READ OR b_a0 OR ""
  TRYSETF a0 allow LAST
  CLEAR_ERR
END
SYS READ OR d_a1 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ a1
  IF LAST_N == 1 THEN
    DELETEOBJ a1
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUPN snap "n"
  LET rn = LAST_N
  SYS LOOKUPN snap "pref"
  LET rp = LAST_N
  SYS LOOKUP snap "tag"
  LET rtag = LAST
  CLEAR_ERR
  NEW AllowList a1 rid
  SYS BLANK rid
  IF LAST_N == 0 THEN
    TRYSETF a1 id rid
  END
  TRYSETF a1 n rn
  TRYSETF a1 pref rp
  SYS BLANK rtag
  IF LAST_N == 0 THEN
    TRYSETF a1 tag rtag
  END
  SYS READ OR b_a1 OR ""
  TRYSETF a1 allow LAST
  CLEAR_ERR
END
SYS READ OR d_a2 OR ""
LET snap = LAST
CLEAR_ERR
SYS HAS snap "id:"
IF LAST_N == 1 THEN
  HASOBJ a2
  IF LAST_N == 1 THEN
    DELETEOBJ a2
    CLEAR_ERR
  END
  SYS LOOKUP snap "id"
  LET rid = LAST
  SYS LOOKUPN snap "n"
  LET rn = LAST_N
  SYS LOOKUPN snap "pref"
  LET rp = LAST_N
  SYS LOOKUP snap "tag"
  LET rtag = LAST
  CLEAR_ERR
  NEW AllowList a2 rid
  SYS BLANK rid
  IF LAST_N == 0 THEN
    TRYSETF a2 id rid
  END
  TRYSETF a2 n rn
  TRYSETF a2 pref rp
  SYS BLANK rtag
  IF LAST_N == 0 THEN
    TRYSETF a2 tag rtag
  END
  SYS READ OR b_a2 OR ""
  TRYSETF a2 allow LAST
  CLEAR_ERR
END

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET nobjs = 0
LET ret_n = 0
LET changed = 0
LET board_rep = "fleet_allowlist_ensure_board"

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS AllowList
  LET bag = LAST
  LET nobjs = NOBJS
  SYS WRITE objs_path bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON nobjs
  CLEAR_ERR
END

# --- open ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        DELETEOBJ a0
        CLEAR_ERR
      END
      NEW AllowList a0 sn
      DUMPOBJ a0
      SYS WRITE d_a0 LAST
      GETF a0 allow
      SYS WRITE b_a0 LAST
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        DELETEOBJ a1
        CLEAR_ERR
      END
      NEW AllowList a1 sn
      DUMPOBJ a1
      SYS WRITE d_a1 LAST
      GETF a1 allow
      SYS WRITE b_a1 LAST
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        DELETEOBJ a2
        CLEAR_ERR
      END
      NEW AllowList a2 sn
      DUMPOBJ a2
      SYS WRITE d_a2 LAST
      GETF a2 allow
      SYS WRITE b_a2 LAST
      CLEAR_ERR
    END
    LISTOBJS AllowList
    LET nobjs = NOBJS
    SYS WRITE objs_path LAST
    CLEAR_ERR
    LET hit = 1
    LET note_msg = "open ok"
    LET val = sn
    LET val_ch = 1
    LET meta = "open"
    SYS PUSH meta sn
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- ensure ---
SYS EQS ACTION "ensure"
IF LAST_N == 1 THEN
  NOTE "action ensure"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "ensure bad slot"
    FAIL "ensure bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "ensure bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        ENSUREBAGLINE a0 allow HOST
        LET o_ok = OK
        LET changed = ENSUREBAGLINE_NEW
        LET ret_n = ENSUREBAGLINE_N
        LET val = LAST
        SETF a0 n ret_n
        DUMPOBJ a0
        SYS WRITE d_a0 LAST
        GETF a0 allow
        SYS WRITE b_a0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        BAGENSURE a1 allow HOST
        LET o_ok = OK
        LET changed = ENSUREBAGLINE_NEW
        LET ret_n = ENSUREBAGLINE_N
        LET val = LAST
        SETF a1 n ret_n
        DUMPOBJ a1
        SYS WRITE d_a1 LAST
        GETF a1 allow
        SYS WRITE b_a1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        ENSUREBAGLINEI a2 allow HOST
        LET o_ok = OK
        LET changed = ENSUREBAGLINE_NEW
        LET ret_n = ENSUREBAGLINE_N
        LET val = LAST
        SETF a2 n ret_n
        DUMPOBJ a2
        SYS WRITE d_a2 LAST
        GETF a2 allow
        SYS WRITE b_a2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "ensure miss"
      FAIL "ensure miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "ensure miss"
      END
    ELSE
      LET hit = 1
      IF changed == 1 THEN
        LET note_msg = "ensure new"
      ELSE
        LET note_msg = "ensure exists"
      END
      LET val_ch = 1
      LET meta = note_msg
      SYS PUSH meta sn
      LET meta = LAST
      SYS PUSH meta HOST
      LET meta = LAST
      SYS STR changed
      SYS PUSH meta LAST
      LET meta = LAST
      SYS STR ret_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- size ---
SYS EQS ACTION "size"
IF LAST_N == 1 THEN
  NOTE "action size"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "size bad slot"
    FAIL "size bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "size bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        LINESF a0 allow
        LET o_ok = OK
        LET ret_n = LAST_N
        SETF a0 n ret_n
        DUMPOBJ a0
        SYS WRITE d_a0 LAST
        GETF a0 allow
        SYS WRITE b_a0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        LINESF a1 allow
        LET o_ok = OK
        LET ret_n = LAST_N
        SETF a1 n ret_n
        DUMPOBJ a1
        SYS WRITE d_a1 LAST
        GETF a1 allow
        SYS WRITE b_a1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        LINESF a2 allow
        LET o_ok = OK
        LET ret_n = LAST_N
        SETF a2 n ret_n
        DUMPOBJ a2
        SYS WRITE d_a2 LAST
        GETF a2 allow
        SYS WRITE b_a2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "size miss"
      FAIL "size miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "size miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "size ok"
      SYS STR ret_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "size"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR ret_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- walk: EACH LINE OF allow count prefix hits ---
SYS EQS ACTION "walk"
IF LAST_N == 1 THEN
  NOTE "action walk"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "walk bad slot"
    FAIL "walk bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "walk bad slot"
    END
  ELSE
    LET o_ok = 0
    LET c = 0
    LET pref = 0
    LET dig = ""
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        EACH LINE AS host OF a0 allow
          LET c = c + 1
          SYS STARTS host PFX
          IF LAST_N == 1 THEN
            LET pref = pref + 1
            IF dig == "" THEN
              LET dig = host
            ELSE
              SYS CAT dig ","
              LET dig = LAST
              SYS CAT dig host
              LET dig = LAST
            END
          END
        END
        LET o_ok = 1
        LET ret_n = c
        SETF a0 n c
        SETF a0 pref pref
        LET val = dig
        DUMPOBJ a0
        SYS WRITE d_a0 LAST
        GETF a0 allow
        SYS WRITE b_a0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        EACH LINE IN a1 allow
          LET c = c + 1
          SYS STARTS LINE PFX
          IF LAST_N == 1 THEN
            LET pref = pref + 1
            IF dig == "" THEN
              LET dig = LINE
            ELSE
              SYS CAT dig ","
              LET dig = LAST
              SYS CAT dig LINE
              LET dig = LAST
            END
          END
        END
        LET o_ok = 1
        LET ret_n = c
        SETF a1 n c
        SETF a1 pref pref
        LET val = dig
        DUMPOBJ a1
        SYS WRITE d_a1 LAST
        GETF a1 allow
        SYS WRITE b_a1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        EACH LINE FROM a2 allow
          LET c = c + 1
          SYS STARTS LINE PFX
          IF LAST_N == 1 THEN
            LET pref = pref + 1
            IF dig == "" THEN
              LET dig = LINE
            ELSE
              SYS CAT dig ","
              LET dig = LAST
              SYS CAT dig LINE
              LET dig = LAST
            END
          END
        END
        LET o_ok = 1
        LET ret_n = c
        SETF a2 n c
        SETF a2 pref pref
        LET val = dig
        DUMPOBJ a2
        SYS WRITE d_a2 LAST
        GETF a2 allow
        SYS WRITE b_a2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "walk miss"
      FAIL "walk miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "walk miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "walk ok"
      LET val_ch = 1
      LET meta = "walk"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR c
      SYS PUSH meta LAST
      LET meta = LAST
      SYS STR pref
      SYS PUSH meta LAST
      LET meta = LAST
      SYS PUSH meta dig
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- props: EACH PROP OF object / class ---
SYS EQS ACTION "props"
IF LAST_N == 1 THEN
  NOTE "action props"
  LET pbag = ""
  LET pc = 0
  IF slot < 0 THEN
    # class schema walk when no slot
    EACH PROP OF AllowList AS fname
      LET pc = pc + 1
      IF pbag == "" THEN
        LET pbag = fname
      ELSE
        SYS CAT pbag "\n"
        LET pbag = LAST
        SYS CAT pbag fname
        LET pbag = LAST
      END
    END
    LET hit = 1
    LET note_msg = "props class"
    LET ret_n = pc
    LET val = pbag
    LET val_ch = 1
    SYS WRITE props_path pbag
    CLEAR_ERR
    LET meta = "props class"
    SYS STR pc
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        EACH PROP OF a0 AS fname
          LET pc = pc + 1
          IF pbag == "" THEN
            LET pbag = fname
          ELSE
            SYS CAT pbag "\n"
            LET pbag = LAST
            SYS CAT pbag fname
            LET pbag = LAST
          END
        END
        LET o_ok = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        EACH ATTR OF a1 AS fname
          LET pc = pc + 1
          IF pbag == "" THEN
            LET pbag = fname
          ELSE
            SYS CAT pbag "\n"
            LET pbag = LAST
            SYS CAT pbag fname
            LET pbag = LAST
          END
        END
        LET o_ok = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        EACH OBJFIELD OF a2 AS fname
          LET pc = pc + 1
          IF pbag == "" THEN
            LET pbag = fname
          ELSE
            SYS CAT pbag "\n"
            LET pbag = LAST
            SYS CAT pbag fname
            LET pbag = LAST
          END
        END
        LET o_ok = 1
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "props miss"
      FAIL "props miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "props miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "props ok"
      LET ret_n = pc
      LET val = pbag
      LET val_ch = 1
      SYS WRITE props_path pbag
      CLEAR_ERR
      LET meta = "props"
      SYS PUSH meta sn
      LET meta = LAST
      SYS STR pc
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- has: HASBAGLINE exact ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "has bad slot"
    FAIL "has bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "has bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        HASBAGLINE a0 allow HOST
        LET o_ok = OK
        LET ret_n = HASBAGLINE_N
        LET val = LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        HASBAGLINE a1 allow HOST
        LET o_ok = OK
        LET ret_n = HASBAGLINE_N
        LET val = LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        HASBAGLINE a2 allow HOST
        LET o_ok = OK
        LET ret_n = HASBAGLINE_N
        LET val = LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "has miss"
      END
    ELSE
      IF ret_n == 0 THEN
        LET miss = 1
        LET note_msg = "has absent"
        LET val = HOST
        LET val_ch = 1
        LET meta = "has absent"
        SYS PUSH meta sn
        LET meta = LAST
        SYS PUSH meta HOST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "has absent"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "has absent"
        END
      ELSE
        LET hit = 1
        LET note_msg = "has present"
        LET val_ch = 1
        LET meta = "has present"
        SYS PUSH meta sn
        LET meta = LAST
        SYS PUSH meta HOST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- gate ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET o_ok = 0
    LET dnow = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        LINESF a0 allow
        LET dnow = LAST_N
        SETF a0 n dnow
        LET o_ok = 1
        DUMPOBJ a0
        SYS WRITE d_a0 LAST
        GETF a0 allow
        SYS WRITE b_a0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        LINESF a1 allow
        LET dnow = LAST_N
        SETF a1 n dnow
        LET o_ok = 1
        DUMPOBJ a1
        SYS WRITE d_a1 LAST
        GETF a1 allow
        SYS WRITE b_a1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        LINESF a2 allow
        LET dnow = LAST_N
        SETF a2 n dnow
        LET o_ok = 1
        DUMPOBJ a2
        SYS WRITE d_a2 LAST
        GETF a2 allow
        SYS WRITE b_a2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "gate miss"
      FAIL "gate miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "gate miss"
      END
    ELSE
      LET ret_n = dnow
      IF dnow < MINN THEN
        LET miss = 1
        LET note_msg = "gate deny"
        SYS STR dnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate deny"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR dnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINN
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "gate deny"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "gate deny"
        END
      ELSE
        LET hit = 1
        LET note_msg = "gate admit"
        SYS STR dnow
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate admit"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR dnow
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR MINN
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- probe ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET p_ok = 1
  TRYENSUREBAGLINE nosuch allow "x"
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYENSUREBAGLINE should soft-fail"
  END
  CLEAR_ERR
  HASOBJ a0
  IF LAST_N == 1 THEN
    ENSUREBAGLINE SOFT a0 nosuch "x"
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe ENSURE missing field should soft"
    END
    CLEAR_ERR
    # idempotent second ensure
    GETF a0 allow
    LET save_a = LAST
    ENSUREBAGLINE a0 allow "probe-host"
    IF ENSUREBAGLINE_NEW != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe first ensure should NEW=1"
    END
    ENSUREBAGLINE a0 allow "probe-host"
    IF ENSUREBAGLINE_NEW != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe second ensure should NEW=0"
    END
    # empty host adds blank line (document)
    LINESF a0 allow
    LET n_before = LAST_N
    ENSUREBAGLINE a0 allow ""
    IF ENSUREBAGLINE_NEW != 1 THEN
      LET p_ok = 0
      LET note_msg = "probe empty ensure should NEW=1"
    END
    # restore
    SETF a0 allow save_a
    DUMPOBJ a0
    SYS WRITE d_a0 LAST
    GETF a0 allow
    SYS WRITE b_a0 LAST
    CLEAR_ERR
    # EACH empty
    SETF a0 allow ""
    LET zc = 0
    EACH LINE AS z OF a0 allow
      LET zc = zc + 1
    END
    IF zc != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe empty EACH should 0"
    END
    IF EACH_N != 0 THEN
      LET p_ok = 0
      LET note_msg = "probe EACH_N should 0 on empty"
    END
    SETF a0 allow save_a
    CLEAR_ERR
  END
  IF p_ok == 1 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET val = "probe"
    LET val_ch = 1
    LET meta = "probe soft"
    LET meta_ch = 1
  ELSE
    LET miss = 1
    FAIL note_msg
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- dump ---
SYS EQS ACTION "dump"
IF LAST_N == 1 THEN
  NOTE "action dump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "dump bad slot"
    FAIL "dump bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "dump bad slot"
    END
  ELSE
    LET o_ok = 0
    IF slot == 0 THEN
      HASOBJ a0
      IF LAST_N == 1 THEN
        DUMPOBJ a0
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_a0 val
        GETF a0 allow
        SYS WRITE b_a0 LAST
        CLEAR_ERR
      END
    END
    IF slot == 1 THEN
      HASOBJ a1
      IF LAST_N == 1 THEN
        DUMPOBJ a1
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_a1 val
        GETF a1 allow
        SYS WRITE b_a1 LAST
        CLEAR_ERR
      END
    END
    IF slot == 2 THEN
      HASOBJ a2
      IF LAST_N == 1 THEN
        DUMPOBJ a2
        LET val = LAST
        LET o_ok = 1
        SYS WRITE d_a2 val
        GETF a2 allow
        SYS WRITE b_a2 LAST
        CLEAR_ERR
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "dump miss"
      FAIL "dump miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "dump miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "dump ok"
      LET val_ch = 1
      LET meta = "dump"
      SYS PUSH meta sn
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ a0
  IF LAST_N == 1 THEN
    DELETEOBJ a0
    CLEAR_ERR
  END
  HASOBJ a1
  IF LAST_N == 1 THEN
    DELETEOBJ a1
    CLEAR_ERR
  END
  HASOBJ a2
  IF LAST_N == 1 THEN
    DELETEOBJ a2
    CLEAR_ERR
  END
  SYS WRITE d_a0 ""
  SYS WRITE d_a1 ""
  SYS WRITE d_a2 ""
  SYS WRITE b_a0 ""
  SYS WRITE b_a1 ""
  SYS WRITE b_a2 ""
  SYS WRITE objs_path ""
  SYS WRITE props_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

