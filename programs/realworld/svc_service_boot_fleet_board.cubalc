    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score sso note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET NEED_FLAGS = ""
  LET NEED_FLAG_ANY = ""
  LET NEED_REST_N = 0
  LET NEED_ARGS = ""
  LET NEED_ARG_ANY = ""
  LET NEED_ENVS = ""
  LET NEED_ENV_ANY = ""
  LET NEED_TIME = 1
  LET NEED_PATHS = ""
  LET NEED_PATH_ANY = ""
  LET NEED_READ_PATHS = ""
  LET NEED_WRITE_PATHS = ""
  LET NEED_BINS = ""
  LET NEED_BIN_ANY = ""
  LET NEED_LIBS = ""
  LET NEED_LIB_ANY = ""
  LET NEED_CLASSES = ""
  LET NEED_CLASS_ANY = ""
  LET NEED_METHODS = ""
  LET NEED_METHOD_ANY = ""
  LET NEED_FIELDS = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJS = "j0"
  LET NEED_OBJ_ANY = ""
  LET CLI_GUARD_SOFT = 1
  LET ARG_GUARD_SOFT = 1
  LET ENV_GUARD_SOFT = 1
  LET TIME_GUARD_SOFT = 1
  LET PATH_GUARD_SOFT = 1
  LET RW_GUARD_SOFT = 1
  LET BIN_GUARD_SOFT = 1
  LET LIB_GUARD_SOFT = 1
  LET CLASS_GUARD_SOFT = 1
  LET METHOD_GUARD_SOFT = 1
  LET FIELD_GUARD_SOFT = 1
  LET OBJ_GUARD_SOFT = 1
  INCLUDE service_session
  LET sso = SERVICE_SESSION_OK
  LET have_n = OBJHAVE_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sso == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  HASLIB service_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB full_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB live_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ j0
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  SYS HAS LAST "ssv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = sso
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score sso have_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " sso=" sso " fso=" fso " lso=" lso " hso=" hso " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "ssv report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
