  LET NEED_FIELDS = ""
  LET NEED_FIELD_ANY = ""
  LET NEED_OBJS = "j0\nnosuch_svc_obj_ssv"
  LET NEED_OBJ_ANY = ""
  LET CLI_GUARD_SOFT = 0
  LET ARG_GUARD_SOFT = 0
  LET ENV_GUARD_SOFT = 0
  LET TIME_GUARD_SOFT = 0
  LET PATH_GUARD_SOFT = 0
  LET RW_GUARD_SOFT = 0
  LET BIN_GUARD_SOFT = 0
  LET LIB_GUARD_SOFT = 0
  LET CLASS_GUARD_SOFT = 0
  LET METHOD_GUARD_SOFT = 0
  LET FIELD_GUARD_SOFT = 0
  LET OBJ_GUARD_SOFT = 1
  INCLUDE service_session
  LET sso = SERVICE_SESSION_OK
  LET fso = FULL_SESSION_OK
  LET lso = LIVE_SESSION_OK
  LET miss_n = OBJMISS_N
  CLEAR_ERR
  IF sso == 0 THEN
    LET score = score + 1
  END
  IF lso == 0 THEN
    LET score = score + 1
  END
  IF fso == 1 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE OBJMISS "nosuch_svc_obj_ssv"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ j
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB service_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB live_session
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJ j0
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_obj ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_obj score"
    FAIL "soft_obj score"
    CLEAR_ERR
  END
  SYS CAT "soft_obj:" miss_n ":so"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_obj:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score sso lso note_msg
  CLEAR_ERR
END

