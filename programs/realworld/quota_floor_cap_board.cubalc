      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ q0
  IF LAST_N == 1 THEN
    DELETEOBJ q0
    CLEAR_ERR
  END
  HASOBJ q1
  IF LAST_N == 1 THEN
    DELETEOBJ q1
    CLEAR_ERR
  END
  HASOBJ q2
  IF LAST_N == 1 THEN
    DELETEOBJ q2
    CLEAR_ERR
  END
  SYS WRITE d_q0 ""
  SYS WRITE d_q1 ""
  SYS WRITE d_q2 ""
  SYS WRITE objs_path ""
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "clear ok"
  LET val = "cleared"
  LET val_ch = 1
  LET meta = "clear"
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

