# --- gate: remaining >= NEED ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET o_ok = 0
    LET rem_now = 0
    IF slot == 0 THEN
      HASOBJ q0
      IF LAST_N == 1 THEN
        GETF q0 remaining
        LET rem_now = LAST_N
        LET o_ok = 1
      END
    END
    IF slot == 1 THEN
      HASOBJ q1
      IF LAST_N == 1 THEN
        GETF q1 remaining
        LET rem_now = LAST_N
        LET o_ok = 1
      END
    END
    IF slot == 2 THEN
      HASOBJ q2
      IF LAST_N == 1 THEN
        GETF q2 remaining
        LET rem_now = LAST_N
        LET o_ok = 1
      END
    END
    IF o_ok == 0 THEN
      LET miss = 1
      LET note_msg = "gate miss"
      FAIL "gate miss"
      CLEAR_ERR
      IF NEED_HIT > 0 THEN
        EXIT 2 "gate miss"
      END
    ELSE
      IF rem_now < NEED THEN
        LET miss = 1
        LET note_msg = "gate deny"
        LET ret_n = rem_now
        SYS STR rem_now
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate deny"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR rem_now
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR NEED
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        FAIL "gate deny"
        CLEAR_ERR
        IF NEED_HIT > 0 THEN
          EXIT 2 "gate deny"
        END
      ELSE
        LET hit = 1
        LET note_msg = "gate admit"
        LET ret_n = rem_now
        SYS STR rem_now
        LET val = LAST
        LET val_ch = 1
        LET meta = "gate admit"
        SYS PUSH meta sn
        LET meta = LAST
        SYS STR rem_now
        SYS PUSH meta LAST
        LET meta = LAST
        SYS STR NEED
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
      END
    END
  END
  PRINT_JSON ret_n
  CLEAR_ERR
END

# --- probe: soft miss paths ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  LET p_ok = 1
  # soft unknown object
  TRYMAXF nosuch remaining 0
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYMAXF should soft-fail"
  END
  CLEAR_ERR
  TRYMINF nosuch burst 10
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYMINF should soft-fail"
  END
  CLEAR_ERR
  TRYBOUNDF nosuch score 0 100
  IF OK == 1 THEN
    LET p_ok = 0
    LET note_msg = "probe TRYBOUNDF should soft-fail"
  END
  CLEAR_ERR
  # soft string field if q0 exists
  HASOBJ q0
  IF LAST_N == 1 THEN
    TRYMAXF q0 tag 0
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe string MAXF should soft-fail"
    END
    CLEAR_ERR
    MINF SOFT q0 tag 1
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe string MINF should soft-fail"
    END
    CLEAR_ERR
    # floor still works after soft
    MAXF q0 remaining 0
    IF OK == 0 THEN
      LET p_ok = 0
      LET note_msg = "probe MAXF after soft broken"
    END
    LET ret_n = LAST_N
    CLEAR_ERR
  END
  # soft miss field
  HASOBJ q0
  IF LAST_N == 1 THEN
    MAXF SOFT q0 nosuch 0
    IF OK == 1 THEN
      LET p_ok = 0
      LET note_msg = "probe MAXF missing field should soft"
    END
    CLEAR_ERR
  END
  IF p_ok == 1 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET val = "probe"
    LET val_ch = 1
    LET meta = "probe soft"
    LET meta_ch = 1
  ELSE
    LET miss = 1
    FAIL note_msg
    CLEAR_ERR
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

