# dlq_retry_board.cubalc — durable job dead-letter / retry status plate under STATE
#
# Real use: agents track intake/worker jobs as exact bag fields "jobid:status"
# without shell sed. Status vocabulary: pending | retry | dead | ok.
#
# Actions (CUBALC_ARG0 / CUBALC_DLQ_ACTION):
#   list     — depth + status tallies (default)
#   seed     — PUSH job:pending for each name in ARG1 if absent
#   admit    — ensure job:pending (PUSH or SETMATCH from other status)
#   fail     — first hit: pending→retry, retry→dead (escalation ladder)
#   retry    — SETMATCH dead→retry (requeue from DLQ)
#   succeed  — first name:* → name:ok
#   kill     — first name:* → name:dead
#   requeue  — SETMATCH dead→pending (fresh restart)
#   pin      — MOVELINE first dead (else retry) to front for operator attention
#   drop     — REMOVELINE first name:*
#   count    — COUNTLINE exact token (ARG1=job:status or job → pending+retry+dead+ok)
#   has      — HASLINE exact
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rw_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1="job_a job_b job_c" \
#     ./out/cubalc run -q -s programs/realworld/dlq_retry_board.cubalc
#   CUBALC_ARG0=fail CUBALC_ARG1=job_a ./out/cubalc run -q -s ...
#   CUBALC_ARG0=list ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_DLQ_FILE=DLQ.txt
#   CUBALC_DLQ_REQUIRE=1   # EXIT 2 on fail/retry/kill/pin/drop miss
#
# Edges deliberately stressed:
#   SETMATCH first exact only — duplicate job:retry leaves residual
#   COUNTLINE exact-field — cannot tally ":dead" suffix (use GREP+LINES)
#   GREP "job_a:" matches job_a_extra: (substring) — use BEFORE+EQS identity
#   fail is a two-step ladder not atomic multi-status SETMATCH
#   MOVELINE needs FINDLINE index; dest past end clamps; from OOR soft
#   no string concat — tokens via REPLACEALL NAME:VAL template
#   PRINT_JSON bag collapse; WRITE trailing NL plate glue
#   soft READ empty plate; REQUIRE miss soft+EXIT path

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "dlq_retry_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT VAL = "pending"
DEFAULT RFILE = "DLQ.txt"
DEFAULT REPORT = "DLQ_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_DLQ_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_DLQ_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET VAL = LAST
ELSE
  SYS ENV "CUBALC_DLQ_VAL" OR "pending"
  LET VAL = LAST
END
SYS ENV "CUBALC_DLQ_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_DLQ_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET dlq_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR dlq_path OR ""
LET bag = LAST
CLEAR_ERR "soft dlq load"
SYS LINES bag
LET depth0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET n_pending = 0
LET n_retry = 0
LET n_dead = 0
LET n_ok = 0
LET idx = -1
LET old_entry = ""
LET entry = ""
LET note_msg = "ok"
LET name_hit = 0

# token templates (no concat form)
LET entry = "NAME:VAL"
SYS REPLACEALL entry "NAME" NAME
LET entry = LAST
SYS REPLACEALL entry "VAL" VAL
LET entry = LAST
LET e_pending = "NAME:pending"
SYS REPLACEALL e_pending "NAME" NAME
LET e_pending = LAST
LET e_retry = "NAME:retry"
SYS REPLACEALL e_retry "NAME" NAME
LET e_retry = LAST
LET e_dead = "NAME:dead"
SYS REPLACEALL e_dead "NAME" NAME
LET e_dead = LAST
LET e_ok = "NAME:ok"
SYS REPLACEALL e_ok "NAME" NAME
LET e_ok = LAST

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  # suffix tallies: COUNTLINE cannot do ":dead" — GREP+LINES required
  SYS GREP ":pending" bag
  SYS LINES LAST
  LET n_pending = LAST_N
  SYS GREP ":retry" bag
  SYS LINES LAST
  LET n_retry = LAST_N
  SYS GREP ":dead" bag
  SYS LINES LAST
  LET n_dead = LAST_N
  SYS GREP ":ok" bag
  SYS LINES LAST
  LET n_ok = LAST_N
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    SYS COUNTLINE bag e_pending
    LET hit = LAST_N
    SYS COUNTLINE bag e_retry
    LET hit = hit + LAST_N
    SYS COUNTLINE bag e_dead
    LET hit = hit + LAST_N
    SYS COUNTLINE bag e_ok
    LET hit = hit + LAST_N
  END
  STATUS
  PRINT "dlq" depth0 n_pending n_retry n_dead n_ok ACTION
  PRINT_JSON depth0 n_pending n_retry n_dead n_ok ACTION STATUS_OK
  PRINT_JSON bag
  LET note_msg = "list ok"
END

# --- seed: WORDS names → PUSH name:pending if absent ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs job ids (ARG1 space-separated)"
  END
  SYS WORDS NAME
  LET names = LAST
  EACH LINE AS n IN names
    SYS BLANK n
    IF LAST_N == 0 THEN
      LET name_hit = 0
      EACH LINE AS row IN bag
        SYS BEFORE row ":"
        SYS EQS LAST n
        IF LAST_N == 1 THEN
          LET name_hit = 1
        END
      END
      IF name_hit == 0 THEN
        LET e = "NAME:pending"
        SYS REPLACEALL e "NAME" n
        LET e = LAST
        SYS PUSH bag e
        LET bag = LAST
        LET changed = 1
        LET hit = hit + 1
      ELSE
        LET miss = miss + 1
      END
    END
  END
  LET note_msg = "seeded"
END

# --- admit: ensure job:pending ---
SYS EQS ACTION "admit"
IF LAST_N == 1 THEN
  NOTE "action admit"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "admit needs job id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    SYS PUSH bag e_pending
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "admit inserted"
  ELSE
    SYS EQS old_entry e_pending
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "admit already pending"
    ELSE
      SYS SETMATCH bag old_entry e_pending
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "admit setmatch miss"
        FAIL "admit setmatch miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "admit miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "admit reset pending"
      END
    END
  END
END

# --- fail: escalate pending→retry, retry→dead ---
SYS EQS ACTION "fail"
IF LAST_N == 1 THEN
  NOTE "action fail"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "fail needs job id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "fail miss"
    FAIL "fail job not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "fail miss"
    END
  ELSE
    SYS EQS old_entry e_pending
    IF LAST_N == 1 THEN
      LET entry = e_retry
      LET note_msg = "fail to retry"
    ELSE
      SYS EQS old_entry e_retry
      IF LAST_N == 1 THEN
        LET entry = e_dead
        LET note_msg = "fail to dead"
      ELSE
        SYS EQS old_entry e_dead
        IF LAST_N == 1 THEN
          LET entry = e_dead
          LET hit = 1
          LET note_msg = "fail already dead"
        ELSE
          # ok or unknown → dead (hard kill on fail of success path)
          LET entry = e_dead
          LET note_msg = "fail ok/other to dead"
        END
      END
    END
    SYS EQS note_msg "fail already dead"
    IF LAST_N == 0 THEN
      SYS SETMATCH bag old_entry entry
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "fail setmatch miss"
        FAIL "fail setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "fail setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
      END
    END
  END
END

# --- retry: dead → retry ---
SYS EQS ACTION "retry"
IF LAST_N == 1 THEN
  NOTE "action retry"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "retry needs job id"
  END
  SYS COUNTLINE bag e_dead
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "retry miss not dead"
    FAIL "retry need dead"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "retry miss"
    END
  ELSE
    SYS SETMATCH bag e_dead e_retry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "retry setmatch miss"
      FAIL "retry setmatch"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "retry setmatch miss"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "retried from dead"
    END
  END
END

# --- succeed: first name:* → ok ---
SYS EQS ACTION "succeed"
IF LAST_N == 1 THEN
  NOTE "action succeed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "succeed needs job id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "succeed miss"
    FAIL "succeed job not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "succeed miss"
    END
  ELSE
    SYS EQS old_entry e_ok
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "succeed already ok"
    ELSE
      SYS SETMATCH bag old_entry e_ok
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "succeed setmatch miss"
        FAIL "succeed setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "succeed setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "succeeded"
      END
    END
  END
END

# --- kill: first name:* → dead ---
SYS EQS ACTION "kill"
IF LAST_N == 1 THEN
  NOTE "action kill"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "kill needs job id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "kill miss"
    FAIL "kill job not found"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "kill miss"
    END
  ELSE
    SYS EQS old_entry e_dead
    IF LAST_N == 1 THEN
      LET hit = 1
      LET note_msg = "kill already dead"
    ELSE
      SYS SETMATCH bag old_entry e_dead
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "kill setmatch miss"
        FAIL "kill setmatch"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "kill setmatch miss"
        END
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET note_msg = "killed"
      END
    END
  END
END

# --- requeue: dead → pending ---
SYS EQS ACTION "requeue"
IF LAST_N == 1 THEN
  NOTE "action requeue"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "requeue needs job id"
  END
  SYS COUNTLINE bag e_dead
  IF LAST_N == 0 THEN
    LET miss = 1
    LET note_msg = "requeue miss not dead"
    FAIL "requeue need dead"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "requeue miss"
    END
  ELSE
    SYS SETMATCH bag e_dead e_pending
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "requeue setmatch miss"
      FAIL "requeue setmatch"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "requeue setmatch miss"
      END
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "requeued to pending"
    END
  END
END

# --- pin: MOVELINE first dead else first retry to front ---
SYS EQS ACTION "pin"
IF LAST_N == 1 THEN
  NOTE "action pin"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    # pin first dead overall if no name
    SYS GREP ":dead" bag
    LET dead_rows = LAST
    SYS LINES dead_rows
    IF LAST_N > 0 THEN
      SYS HEAD dead_rows
      LET old_entry = LAST
      SYS FINDLINE bag old_entry
      LET idx = LAST_N
      SYS MOVELINE bag idx 0
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "pin moveline miss"
        FAIL "pin moveline"
        CLEAR_ERR
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET idx = 0
        LET note_msg = "pinned first dead"
      END
    ELSE
      SYS GREP ":retry" bag
      LET retry_rows = LAST
      SYS LINES retry_rows
      IF LAST_N > 0 THEN
        SYS HEAD retry_rows
        LET old_entry = LAST
        SYS FINDLINE bag old_entry
        LET idx = LAST_N
        SYS MOVELINE bag idx 0
        IF LAST_N == 0 THEN
          LET miss = 1
          LET note_msg = "pin moveline miss"
          FAIL "pin moveline"
          CLEAR_ERR
        ELSE
          LET bag = LAST
          LET changed = 1
          LET hit = 1
          LET idx = 0
          LET note_msg = "pinned first retry"
        END
      ELSE
        LET miss = 1
        LET note_msg = "pin nothing to pin"
        FAIL "pin empty attention"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "pin miss"
        END
      END
    END
  ELSE
    # pin named job row to front via identity walk
    LET name_hit = 0
    LET old_entry = ""
    EACH LINE AS row IN bag
      SYS BEFORE row ":"
      SYS EQS LAST NAME
      IF LAST_N == 1 THEN
        IF name_hit == 0 THEN
          LET old_entry = row
          LET name_hit = 1
        END
      END
    END
    IF name_hit == 0 THEN
      LET miss = 1
      LET note_msg = "pin name miss"
      FAIL "pin name not found"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "pin miss"
      END
    ELSE
      SYS FINDLINE bag old_entry
      LET idx = LAST_N
      SYS MOVELINE bag idx 0
      IF LAST_N == 0 THEN
        LET miss = 1
        LET note_msg = "pin moveline miss"
        FAIL "pin moveline"
        CLEAR_ERR
      ELSE
        LET bag = LAST
        LET changed = 1
        LET hit = 1
        LET idx = 0
        LET note_msg = "pinned name"
      END
    END
  END
END

# --- drop first name:* ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs job id"
  END
  LET name_hit = 0
  LET old_entry = ""
  EACH LINE AS row IN bag
    SYS BEFORE row ":"
    SYS EQS LAST NAME
    IF LAST_N == 1 THEN
      IF name_hit == 0 THEN
        LET old_entry = row
        LET name_hit = 1
      END
    END
  END
  IF name_hit == 0 THEN
    LET miss = 1
    LET note_msg = "drop miss"
    FAIL "drop miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop miss"
    END
  ELSE
    SYS REMOVELINE bag old_entry
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "removeline miss"
      FAIL "removeline miss"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "dropped"
    END
  END
END

# --- count exact ---
SYS EQS ACTION "count"
IF LAST_N == 1 THEN
  NOTE "action count"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "count needs token or job id"
  END
  SYS HASI NAME ":"
  IF LAST_N == 1 THEN
    SYS COUNTLINE bag NAME
    LET hit = LAST_N
  ELSE
    SYS COUNTLINE bag e_pending
    LET n_pending = LAST_N
    SYS COUNTLINE bag e_retry
    LET n_retry = LAST_N
    SYS COUNTLINE bag e_dead
    LET n_dead = LAST_N
    SYS COUNTLINE bag e_ok
    LET n_ok = LAST_N
    LET hit = n_pending + n_retry + n_dead + n_ok
  END
  LET note_msg = "counted"
END

# --- has exact ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs token or job id"
  END
  SYS HASI NAME ":"
  IF LAST_N == 1 THEN
    SYS HASLINE bag NAME
    LET hit = LAST_N
  ELSE
    SYS HASLINE bag e_pending
    LET n_pending = LAST_N
    SYS HASLINE bag e_retry
    LET n_retry = LAST_N
    SYS HASLINE bag e_dead
    LET n_dead = LAST_N
    SYS HASLINE bag e_ok
    LET n_ok = LAST_N
    LET hit = n_pending + n_retry + n_dead + n_ok
    IF hit > 1 THEN
      LET hit = 1
    END
  END
  LET note_msg = "has"
END

# unknown action?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "admit"
LET k = k + LAST_N
SYS EQS ACTION "fail"
LET k = k + LAST_N
SYS EQS ACTION "retry"
LET k = k + LAST_N
SYS EQS ACTION "succeed"
LET k = k + LAST_N
SYS EQS ACTION "kill"
LET k = k + LAST_N
SYS EQS ACTION "requeue"
LET k = k + LAST_N
SYS EQS ACTION "pin"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
SYS EQS ACTION "count"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

# post-tally
SYS GREP ":pending" bag
SYS LINES LAST
LET n_pending = LAST_N
SYS GREP ":retry" bag
SYS LINES LAST
LET n_retry = LAST_N
SYS GREP ":dead" bag
SYS LINES LAST
LET n_dead = LAST_N
SYS GREP ":ok" bag
SYS LINES LAST
LET n_ok = LAST_N

IF changed > 0 THEN
  SYS WRITE dlq_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "dlq write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.dlq.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "name"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "val"
LET report = LAST
SYS PUSH report VAL
LET report = LAST
SYS PUSH report "entry"
LET report = LAST
SYS PUSH report entry
LET report = LAST
SYS PUSH report "old_entry"
LET report = LAST
SYS PUSH report old_entry
LET report = LAST
SYS PUSH report "idx"
LET report = LAST
SYS STR idx
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_pending"
LET report = LAST
SYS STR n_pending
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_retry"
LET report = LAST
SYS STR n_retry
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_dead"
LET report = LAST
SYS STR n_dead
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "n_ok"
LET report = LAST
SYS STR n_ok
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "changed"
LET report = LAST
SYS STR changed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth0"
LET report = LAST
SYS STR depth0
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "dlq" ACTION hit miss changed n_pending n_retry n_dead n_ok depth0 depth1
PRINT_JSON ACTION hit miss changed n_pending n_retry n_dead n_ok depth0 depth1 idx elapsed STATUS_OK
PASS "dlq tick"
NOTE "dlq_retry_board: done"
CLEAR_ERR
EXIT 0 "dlq ok"
