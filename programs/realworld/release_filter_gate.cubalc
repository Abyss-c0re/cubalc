# release_filter_gate.cubalc — release artifact bag gate via FILTERGLOB + path maps
#
# Real use: release/deploy agent holds a durable PATHS bag (full paths or
# basenames from PATHGLOB/LIST/intake). FILTERGLOB/MATCHBAG re-filters by
# shell pattern without EACH+IF; VFILTERGLOB drops junk (*.tmp, *.log).
# BASENAMEALL/STEMALL/EXTALL map path bags in one shot for identity and
# type rollup (FREQ on EXTALL) — no EACH BASENAME glue.
#
# Distinct from build_pathglob_board (PATHGLOB inventory+SIZE) and
# release_relpath_smoke (STRIPPREFIX sample): this board is bag filter
# gate + map peels for allow/deny artifact policy.
#
# Plate under STATE:
#   PATHS.txt          — working path bag
#   NAMES.txt          — last BASENAMEALL result
#   STEMS.txt          — last STEMALL result
#   EXTS.txt           — last EXTALL raw or FREQ bag
#   FILTER_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_RF_ACTION):
#   list       — depths (default)
#   scan       — PATHGLOB DIR PAT → PATHS
#   loadlines  — ARG1 ||| paths PUSH into PATHS
#   allow      — FILTERGLOB PATHS pattern (ARG1/ENV)
#   deny       — VFILTERGLOB PATHS pattern (drop matches)
#   names      — BASENAMEALL PATHS → NAMES
#   stems      — STEMALL PATHS → STEMS
#   exts       — EXTALL PATHS; optional FREQ → EXTS
#   has        — HASLINE exact on PATHS
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_rf_$$; mkdir -p "$CUBALC_STATE/out"
#   # drop fixtures
#   CUBALC_RF_DIR=$CUBALC_STATE/out CUBALC_ARG0=scan CUBALC_ARG1='*' \
#     ./out/cubalc run -q -s programs/realworld/release_filter_gate.cubalc
#   CUBALC_ARG0=allow CUBALC_ARG1='*.bin' ./out/cubalc run -q -s ...
#   CUBALC_ARG0=deny CUBALC_ARG1='*.tmp' ./out/cubalc run -q -s ...
#   CUBALC_ARG0=names ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_RF_DIR=…     # scan dir (default STATE)
#   CUBALC_RF_PAT=*
#   CUBALC_RF_REQUIRE=1
#   CUBALC_RF_FREQ=1    # exts writes FREQ bag not raw EXTALL
#
# Edges deliberately stressed:
#   FILTERGLOB matches full path basenames (*.plate hits /a/b/c.plate)
#   VFILTERGLOB invert drop
#   empty pattern / empty bag soft
#   EXTALL keeps empty field for no-ext files; FREQ "" vs (none)
#   STEMALL double-ext data.tar.gz → data.tar
#   BASENAMEALL drops directory prefix only
#   WRITE NL; PRINT_JSON collapse; soft READ; REQUIRE miss

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "release_filter_gate: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT PFILE = "PATHS.txt"
DEFAULT NFILE = "NAMES.txt"
DEFAULT SFILE = "STEMS.txt"
DEFAULT EFILE = "EXTS.txt"
DEFAULT REPORT = "FILTER_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT PAT = "*"
DEFAULT DIR = ""
DEFAULT DO_FREQ = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_RF_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_RF_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_RF_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_RF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_RF_PAT" OR ""
IF LAST_N > 0 THEN
  LET PAT = LAST
END
SYS ENV "CUBALC_RF_DIR" OR ""
IF LAST_N > 0 THEN
  LET DIR = LAST
END
SYS ENV "CUBALC_RF_FREQ" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET DO_FREQ = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS BLANK DIR
IF LAST_N == 1 THEN
  LET DIR = state_dir
END
SYS JOIN state_dir PFILE
LET paths_path = LAST
SYS JOIN state_dir NFILE
LET names_path = LAST
SYS JOIN state_dir SFILE
LET stems_path = LAST
SYS JOIN state_dir EFILE
LET exts_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR paths_path OR ""
LET paths = LAST
CLEAR_ERR
SYS READ OR names_path OR ""
LET names = LAST
CLEAR_ERR
SYS READ OR stems_path OR ""
LET stems = LAST
CLEAR_ERR
SYS READ OR exts_path OR ""
LET exts = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET paths_ch = 0
LET names_ch = 0
LET stems_ch = 0
LET exts_ch = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET pglob_n = 0
LET keep_n = 0
LET drop_n = 0
LET map_n = 0

# pattern from ARG1 for scan/allow/deny/has
SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET PAT = NAME
  END
END
SYS EQS ACTION "allow"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "allow needs pattern"
  END
  LET PAT = NAME
END
SYS EQS ACTION "deny"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "deny needs pattern"
  END
  LET PAT = NAME
END
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs field"
  END
END
SYS EQS ACTION "loadlines"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "loadlines needs ||| paths"
  END
END

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS LINES paths
  LET np = LAST_N
  SYS LINES names
  LET nn = LAST_N
  SYS LINES stems
  LET ns = LAST_N
  SYS LINES exts
  LET ne = LAST_N
  CLEAR_ERR
  STATUS
  PRINT "rfilter" np nn ns ne ACTION
  PRINT_JSON np nn ns ne ACTION STATUS_OK
  PRINT_JSON paths
  PRINT_JSON names
  PRINT_JSON stems
  PRINT_JSON exts
  LET note_msg = "list ok"
END

# --- scan: PATHGLOB DIR PAT ---
SYS EQS ACTION "scan"
IF LAST_N == 1 THEN
  NOTE "action scan"
  SYS PATHGLOB DIR PAT
  IF OK == 0 THEN
    LET miss = 1
    LET paths = ""
    LET paths_ch = 1
    LET note_msg = "scan miss"
    FAIL "scan miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "scan miss"
    END
  ELSE
    LET paths = LAST
    LET pglob_n = PATHGLOB_N
    LET paths_ch = 1
    LET hit = pglob_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "scan empty"
      FAIL "scan empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "scan empty"
      END
    ELSE
      LET note_msg = "scan ok"
    END
    PRINT_JSON PAT pglob_n DIR
    PRINT_JSON paths
  END
END

# --- loadlines: ||| delimited paths ---
SYS EQS ACTION "loadlines"
IF LAST_N == 1 THEN
  NOTE "action loadlines"
  SYS SPLIT "|||" NAME
  LET toks = LAST
  EACH LINE AS t IN toks
    SYS BLANK t
    IF LAST_N == 0 THEN
      SYS HASLINE paths t
      IF LAST_N == 0 THEN
        SYS PUSH paths t
        LET paths = LAST
        LET hit = hit + 1
      END
    END
  END
  LET paths_ch = 1
  LET note_msg = "loadlines ok"
  PRINT_JSON paths
END

# --- allow: FILTERGLOB ---
SYS EQS ACTION "allow"
IF LAST_N == 1 THEN
  NOTE "action allow"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "allow empty"
    FAIL "allow empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "allow empty"
    END
  ELSE
    SYS FILTERGLOB paths PAT
    LET paths = LAST
    LET keep_n = FILTERGLOB_N
    LET drop_n = FILTERGLOB_DROP
    LET paths_ch = 1
    LET hit = keep_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "allow none"
      FAIL "allow none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "allow none"
      END
    ELSE
      LET note_msg = "allow ok"
    END
    PRINT_JSON PAT keep_n drop_n
    PRINT_JSON paths
  END
END

# --- deny: VFILTERGLOB (drop matches) ---
SYS EQS ACTION "deny"
IF LAST_N == 1 THEN
  NOTE "action deny"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "deny empty"
    FAIL "deny empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "deny empty"
    END
  ELSE
    SYS VFILTERGLOB paths PAT
    LET paths = LAST
    LET keep_n = VFILTERGLOB_N
    LET drop_n = FILTERGLOB_DROP
    LET paths_ch = 1
    LET hit = keep_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "deny all"
      FAIL "deny all"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "deny all"
      END
    ELSE
      LET note_msg = "deny ok"
    END
    PRINT_JSON PAT keep_n drop_n
    PRINT_JSON paths
  END
END

# --- names: BASENAMEALL ---
SYS EQS ACTION "names"
IF LAST_N == 1 THEN
  NOTE "action names"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "names empty"
    FAIL "names empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "names empty"
    END
  ELSE
    SYS BASENAMEALL paths
    LET names = LAST
    LET map_n = BASENAMEALL_N
    LET hit = map_n
    LET names_ch = 1
    LET note_msg = "names ok"
    PRINT_JSON map_n
    PRINT_JSON names
  END
END

# --- stems: STEMALL ---
SYS EQS ACTION "stems"
IF LAST_N == 1 THEN
  NOTE "action stems"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "stems empty"
    FAIL "stems empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stems empty"
    END
  ELSE
    SYS STEMALL paths
    LET stems = LAST
    LET map_n = STEMALL_N
    LET hit = map_n
    LET stems_ch = 1
    LET note_msg = "stems ok"
    PRINT_JSON map_n
    PRINT_JSON stems
  END
END

# --- exts: EXTALL [+ FREQ] ---
SYS EQS ACTION "exts"
IF LAST_N == 1 THEN
  NOTE "action exts"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "exts empty"
    FAIL "exts empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "exts empty"
    END
  ELSE
    SYS EXTALL paths
    LET raw = LAST
    LET map_n = EXTALL_N
    LET hit = map_n
    IF DO_FREQ > 0 THEN
      SYS FREQ raw
      LET exts = LAST
      LET note_msg = "exts freq ok"
    ELSE
      LET exts = raw
      LET note_msg = "exts ok"
    END
    LET exts_ch = 1
    PRINT_JSON map_n DO_FREQ
    PRINT_JSON exts
  END
END

# --- has: HASLINE exact ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS HASLINE paths NAME
  LET val_n = LAST_N
  LET hit = val_n
  IF val_n == 0 THEN
    LET miss = 1
    LET note_msg = "has miss"
    FAIL "has miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has miss"
    END
  ELSE
    LET note_msg = "has ok"
  END
  PRINT_JSON val_n NAME
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET paths = ""
  LET names = ""
  LET stems = ""
  LET exts = ""
  LET paths_ch = 1
  LET names_ch = 1
  LET stems_ch = 1
  LET exts_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "scan"
LET k = k + LAST_N
SYS EQS ACTION "loadlines"
LET k = k + LAST_N
SYS EQS ACTION "allow"
LET k = k + LAST_N
SYS EQS ACTION "deny"
LET k = k + LAST_N
SYS EQS ACTION "names"
LET k = k + LAST_N
SYS EQS ACTION "stems"
LET k = k + LAST_N
SYS EQS ACTION "exts"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF paths_ch > 0 THEN
  SYS WRITE paths_path paths
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "paths write failed"
  END
  CLEAR_ERR
END
IF names_ch > 0 THEN
  SYS WRITE names_path names
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "names write failed"
  END
  CLEAR_ERR
END
IF stems_ch > 0 THEN
  SYS WRITE stems_path stems
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "stems write failed"
  END
  CLEAR_ERR
END
IF exts_ch > 0 THEN
  SYS WRITE exts_path exts
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "exts write failed"
  END
  CLEAR_ERR
END

SYS LINES paths
LET depth_p = LAST_N
SYS LINES names
LET depth_n = LAST_N
SYS LINES stems
LET depth_s = LAST_N
SYS LINES exts
LET depth_e = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.release_filter.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "pat"
LET report = LAST
SYS PUSH report PAT
LET report = LAST
SYS PUSH report "pglob_n"
LET report = LAST
SYS STR pglob_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "keep_n"
LET report = LAST
SYS STR keep_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "drop_n"
LET report = LAST
SYS STR drop_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "map_n"
LET report = LAST
SYS STR map_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_p"
LET report = LAST
SYS STR depth_p
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_n"
LET report = LAST
SYS STR depth_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_s"
LET report = LAST
SYS STR depth_s
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_e"
LET report = LAST
SYS STR depth_e
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "dir"
LET report = LAST
SYS PUSH report DIR
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "release_filter_gate" ACTION hit miss keep_n drop_n map_n note_msg elapsed
PRINT_JSON ACTION hit miss keep_n drop_n map_n depth_p depth_n depth_s depth_e note_msg STATUS_OK
NOTE "release_filter_gate: done"
