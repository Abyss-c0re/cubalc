# svc_countbyval_presence_board.cubalc — COUNTBYVAL/HASVAL value presence gates
#
# Real use: fleet agents count exact leaf values (how many workers? any
# fail?) without PATHSBYVAL+LINES glue — admit/reject digests.
# First realworld of proof 1246 COUNTBYVAL (MEANINGFUL 705).
#
#   COUNTBYVAL|NBYVAL [FROM plate] value  → LAST count string · LAST_N count
#   HASVAL|HASVALFLAT [FROM plate] value  → LAST_N 0|1 presence
#   Prefer LAST_N near 128-var cap (W408).
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_scv_$$
#   ./out/cubalc run programs/realworld/svc_countbyval_presence_board.cubalc boot
#   ./out/cubalc run ... count|has|peer|soft|gate|cross|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SCV_REPORT.txt agent.json peer.json cnt.txt
# Env: HOST_S ROLE_S CUBALC_SCV_REQUIRE
#
# Edges: soft miss count 0; FROM PEER; PATHSBYVAL cross-check; exact partials;
#   WRITE NL; REQUIRE softens; HASVAL hit vs COUNTBYVAL n

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_countbyval_presence_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_countbyval_presence -- boot|count|has|peer|soft|gate|cross|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeC"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SCV_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "cnt.txt"
LET cnt_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SCV_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET cnt_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "count", "has", "peer", "soft", "gate", "cross", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "count" THEN
    LET op = "count"
  WHEN "has" THEN
    LET op = "has"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "cross" THEN
    LET op = "cross"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — dual worker + leader + peer ok/fail
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-countbyval\",\"schema\":\"cubalc.svc_countbyval_presence.v1\",\"site\":\"" host_s "\",\"agent_job\":\"runner\",\"meta\":{\"role\":\"worker\"},\"cfg\":{\"role\":\"worker\",\"host\":\"h1\"},\"other\":{\"host\":\"h2\",\"role\":\"leader\"},\"label\":\"cnt\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_countbyval_presence.v1\",\"site\":\"" host_s "\",\"a\":{\"status\":\"ok\"},\"b\":{\"status\":\"fail\"},\"c\":{\"status\":\"ok\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.host"
  SYS EQS LAST "h1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:roles:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# count — COUNTBYVAL worker/leader/h1 + miss 0
SYS EQS op "count"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTBYVAL "worker"
  LET cnt_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cnt_path body
  CLEAR_ERR
  IF cnt_n == 2 THEN
    LET score = score + 1
  END
  SYS EQS body "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  COUNTBYVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  COUNTBYVAL "h1"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  COUNTBYVAL "nope"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  NBYVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 2 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "count ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "count score"
    FAIL "count score"
    CLEAR_ERR
  END
  SYS STR cnt_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "count:" body ":ct"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "count:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

# has — HASVAL presence + HASVALFLAT alias
SYS EQS op "has"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASVAL "worker"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == 1 THEN
    LET score = score + 1
  END
  HASVAL "nope"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  HASVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASVALFLAT "h1"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASVALFLAT "ghost"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-countbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "has ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "has score"
    FAIL "has score"
    CLEAR_ERR
  END
  SYS CAT "has:1:hs"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "has:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

# peer — COUNTBYVAL/HASVAL FROM PEER status
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTBYVAL FROM PEER "ok"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == 2 THEN
    LET score = score + 1
  END
  COUNTBYVAL FROM PEER "fail"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASVAL FROM PEER "fail"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASVAL FROM PEER "missing"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-countbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP FROM PEER "tag"
  SYS EQS LAST "t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS STR cnt_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cnt_path body
  CLEAR_ERR
  SYS CAT "peer:" body ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

# soft — miss counts + real worker still 2
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTBYVAL "ghostpath"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == 0 THEN
    LET score = score + 1
  END
  HASVAL "ghostpath"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  COUNTBYVAL "worker"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == 2 THEN
    LET score = score + 1
  END
  HASVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-countbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

# gate — admit when workers >= 2 and leader present
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTBYVAL "worker"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n > 1 THEN
    LET score = score + 1
  END
  HASVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  HASVAL "runner"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_countbyval_presence"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS STR cnt_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cnt_path body
  CLEAR_ERR
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

# cross — COUNTBYVAL == PATHSBYVAL path count
SYS EQS op "cross"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  PATHSBYVAL "worker"
  LET admit_n = LAST_N
  CLEAR_ERR
  COUNTBYVAL "worker"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == admit_n THEN
    LET score = score + 1
  END
  IF cnt_n == 2 THEN
    LET score = score + 1
  END
  PATHSBYVAL "leader"
  LET admit_n = LAST_N
  CLEAR_ERR
  COUNTBYVAL "leader"
  LET body = LAST
  CLEAR_ERR
  # capture count after leader COUNTBYVAL
  COUNTBYVAL "leader"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == 1 THEN
    LET score = score + 1
  END
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-countbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "cross ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "cross score"
    FAIL "cross score"
    CLEAR_ERR
  END
  SYS STR cnt_n
  LET body = LAST
  CLEAR_ERR
  SYS CAT "cross:" body ":xr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "cross:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

# probe — exact value partials miss; HASVAL vs COUNTBYVAL contract
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  COUNTBYVAL "worker"
  LET cnt_n = LAST_N
  CLEAR_ERR
  IF cnt_n == 2 THEN
    LET score = score + 1
  END
  COUNTBYVAL "work"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  HASVAL "work"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  COUNTBYVAL "orker"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "countbyval"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "cnt"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS STR cnt_n
  LET body = LAST
  CLEAR_ERR
  SYS WRITE cnt_path body
  CLEAR_ERR
  SYS CAT "probe:" body ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n cnt_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_countbyval_presence.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " cnt=" cnt_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_countbyval_presence_board: end"
