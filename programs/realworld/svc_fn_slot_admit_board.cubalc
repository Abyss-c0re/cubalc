# svc_fn_slot_admit_board.cubalc — HASFNS/HASFNANY + HASOBJANY runbook admit
#
# Real use: deploy agents gate a runbook FN catalog (all required steps +
# any-of optional hooks) and soft-check that at least one live worker slot
# exists before TRYCALL — without N× HASFN/HASOBJ glue.
# First realworld of free-form 1429 HASFNS + 1432 HASFNANY + 1427 HASOBJANY
# (1.15.886+). Distinct from fn_runbook (LISTFNS/FNINFO/TRYCALL catalog) and
# svc_schema_live_ready (OOP fields/methods/HASOBJS all-of).
#
#   HASFNS|ALLFNS|NEEDFNS|HASFUNCS names… · FNMISS · HASFNS_N
#   HASFNANY|ANYFN|NEEDFNANY names… · FNHAVE · FNMISS
#   HASOBJANY|OBJANY|NEEDOBJANY names… · OBJHAVE · OBJMISS
#   Prefer CSV bags for multi names; soft empty/all-miss
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_fsa_$$
#   ./out/cubalc run programs/realworld/svc_fn_slot_admit_board.cubalc boot
#   ./out/cubalc run ... pass|soft|fns|any|slots|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt FSA_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_FSA_REQUIRE
#
# Edges: partial FNMISS with HASFNS_N live hits; FNHAVE first/any;
#   HASOBJANY multi; CLEAR_ERR LAST; REQUIRE LIB quoted; WRITE NL; PRINT

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# runbook steps (FN catalog under test)
FN score a b
  RET a + b
END

FN notify msg
  RET msg
END

FN rollback
  RET 0
END

FN canary_hook
  RET 1
END

CLASS WorkerSlot
  FIELD role "idle"
  FIELD load 0
END

NOTE "svc_fn_slot_admit_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_fn_slot_admit -- boot|pass|soft|fns|any|slots|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_FSA_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "FSA_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET fn_n = 0
LET any_n = 0
LET obj_n = 0
LET have_s = ""
LET miss_s = ""

ONEOF ACTION "boot", "pass", "soft", "fns", "any", "slots", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "fns" THEN
    LET op = "fns"
  WHEN "any" THEN
    LET op = "any"
  WHEN "slots" THEN
    LET op = "slots"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-fsa\",\"schema\":\"cubalc.svc_fn_slot_admit.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"fsa\",\"want_filter\":\"fn_slot_admit\",\"cfg\":{\"surface\":\"HASFNS,HASFNANY,HASOBJANY,FNMISS,FNHAVE,OBJHAVE\",\"contract\":\"runbook FN catalog + optional live slot any-of admit\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  LET need = "score,notify,rollback"
  HASFNS need
  LET fn_n = HASFNS_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-fsa"
  IF LAST_N == 1 THEN
    IF fn_n == 3 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET score = 1
    ELSE
      LET miss = 1
      LET note_msg = "boot fns"
      FAIL "boot fns"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — required FNs + any optional hook + any live slot
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "score,notify,rollback"
  HASFNS need
  LET ok_v = OK
  LET fn_n = HASFNS_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF fn_n == 3 THEN
    LET score = score + 1
  END
  LET opts = "ghost_hook,canary_hook,nope"
  HASFNANY opts
  LET ok_v = OK
  LET have_s = FNHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "canary_hook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW WorkerSlot w0
  NEW WorkerSlot w1
  CLEAR_ERR
  LET opts = "ghost_slot,w0,w1"
  HASOBJANY opts
  LET ok_v = OK
  LET obj_n = HASOBJANY_N
  LET have_s = OBJHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF obj_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASI have_s "w0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft CALL smoke on known FN
  TRYCALL score 3 4
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "fn_slot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = fn_n
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" fn_n ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fn_n obj_n note_msg
  CLEAR_ERR
END

# soft — all-miss FN/obj + empty
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFNS ghost_a ghost_b
  LET ok_v = OK
  LET fn_n = HASFNS_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF fn_n == 0 THEN
    LET score = score + 1
  END
  IF FNMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFNS
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFNANY ghost_x ghost_y
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFNANY
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJANY ghost_s1 ghost_s2
  LET ok_v = OK
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF OBJMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJANY
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYCALL missing_fn_zz
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# fns — ALLFNS, partial FNMISS, CSV, HASFUNCS
SYS EQS op "fns"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "score,notify"
  HASFNS need
  LET fn_n = HASFNS_N
  CLEAR_ERR
  IF fn_n == 2 THEN
    LET score = score + 1
  END
  ALLFNS score notify
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFNS score ghost_fn notify
  LET ok_v = OK
  LET fn_n = HASFNS_N
  LET miss_s = FNMISS
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF fn_n == 2 THEN
    LET score = score + 1
  END
  SYS HASI miss_s "ghost_fn"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "ghost,score,notify"
  HASFNS need
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASFNS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFUNCS score
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET need = "score,notify,rollback,canary_hook"
  HASFNS need
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "fn_slot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "fns ok"
    LET admit_n = 1
    LET find_n = fn_n
  ELSE
    LET miss = 1
    LET note_msg = "fns score"
    FAIL "fns score"
    CLEAR_ERR
  END
  SYS CAT "fns:" fn_n ":fn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fns:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fn_n note_msg
  CLEAR_ERR
END

# any — HASFNANY / ANYFN multi + bag
SYS EQS op "any"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET opts = "ghost,canary_hook,nope"
  HASFNANY opts
  LET ok_v = OK
  LET have_s = FNHAVE
  LET any_n = HASFNANY_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "canary_hook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  ANYFN ghost_zz score
  LET have_s = FNHAVE
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "score"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFNANY score notify
  LET any_n = FNHAVE_N
  CLEAR_ERR
  IF any_n == 2 THEN
    LET score = score + 1
  END
  LET opts = "ghost_x,ghost_y"
  HASFNANY opts
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF FNMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFNANY canary_hook
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-fsa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "any ok"
    LET admit_n = 1
    LET find_n = any_n
  ELSE
    LET miss = 1
    LET note_msg = "any score"
    FAIL "any score"
    CLEAR_ERR
  END
  SYS CAT "any:" any_n ":an"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score any_n note_msg
  CLEAR_ERR
END

# slots — HASOBJANY / OBJANY / CSV multi live
SYS EQS op "slots"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  NEW WorkerSlot s0
  NEW WorkerSlot s1
  NEW WorkerSlot s2
  CLEAR_ERR
  HASOBJANY s0 ghost_zz
  LET ok_v = OK
  LET have_s = OBJHAVE
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "s0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  OBJANY ghost_zz s1
  LET have_s = OBJHAVE
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS EQS have_s "s1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost,s0,s1,s2"
  HASOBJANY opts
  LET obj_n = OBJHAVE_N
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF obj_n == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJANY s0 s1
  IF OBJHAVE_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJANY ghost_a ghost_b
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF OBJMISS_N == 2 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "fn_slot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "slots ok"
    LET admit_n = 1
    LET find_n = obj_n
  ELSE
    LET miss = 1
    LET note_msg = "slots score"
    FAIL "slots score"
    CLEAR_ERR
  END
  SYS CAT "slots:" obj_n ":sl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "slots:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score obj_n note_msg
  CLEAR_ERR
END

# form — HASFORM catalog lag for new stems
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "HASFNS"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "HASFNANY"
  LET any_n = LAST_N
  CLEAR_ERR
  HASFORM "HASOBJANY"
  LET obj_n = LAST_N
  CLEAR_ERR
  HASFORM "NEEDFNS"
  LET fn_n = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF any_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF obj_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF fn_n == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "ALLFNS"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "ANYFN"
  LET any_n = LAST_N
  CLEAR_ERR
  HASFORM "OBJANY"
  LET obj_n = LAST_N
  CLEAR_ERR
  IF ok_v == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF any_n == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF obj_n == 0 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "SYS HASFNS"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "fn_slot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — required FNs + any hook + any slot + soft recover + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "score,notify,rollback"
  HASFNS need
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET opts = "ghost,canary_hook"
  HASFNANY opts
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEW WorkerSlot g0
  CLEAR_ERR
  HASOBJANY g0 ghost_g
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft miss must not block
  HASFNS ghost_only
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJANY ghost_only
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TRYCALL score 1 2
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-fsa"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · CLEAR_ERR LAST · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET need = "score,notify"
  HASFNS need
  LET fn_n = HASFNS_N
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF fn_n == 2 THEN
    LET score = score + 1
  END
  LET opts = "ghost,canary_hook"
  HASFNANY opts
  LET have_s = FNHAVE
  CLEAR_ERR
  SYS EQS have_s "canary_hook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "fn_slot_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "schema_live_ready"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOBJANY
  IF OK == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = fn_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fn_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " fn_n=" fn_n " any_n=" any_n " obj_n=" obj_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "fsa report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
