IF is_known == 0 THEN
  LET miss = 1
  LET note_msg = "unknown action"
  FAIL "unknown action"
  CLEAR_ERR
END

IF j_changed == 1 THEN
  SYS WRITE journal_path jbag
  CLEAR_ERR
END
IF val_ch == 1 THEN
  SYS WRITE val_path val
  CLEAR_ERR
END
IF meta_ch == 1 THEN
  SYS WRITE meta_path meta
  CLEAR_ERR
END

SYS MS
LET t1ms = MS
LET dt = t1ms - t0ms
SYS PUSH board_rep run_date
LET board_rep = LAST
SYS PUSH board_rep ACTION
LET board_rep = LAST
SYS PUSH board_rep note_msg
LET board_rep = LAST
SYS STR hit
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS STR miss
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS STR dt
SYS PUSH board_rep LAST
LET board_rep = LAST
SYS WRITE report_path board_rep
CLEAR_ERR

NOTE "queue_depth_band_board: done"
# REQUIRE hard exit only when note_msg is an action deny (not unknown after success)
SYS EQS note_msg "unknown action"
IF LAST_N == 0 THEN
  IF miss > 0 THEN
    IF NEED_HIT > 0 THEN
      EXIT 2 note_msg
    END
  END
END
EXIT 0 note_msg
