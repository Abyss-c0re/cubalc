# svc_errrun_topicwalk_board.cubalc — ERRRUN + EACH TOPIC + TOPICHINT
#
# Real use: fleet recovery agents classify sticky incidents and one-shot
# RUNSNIP recovery (ERRRUN/RECOVERSNIP), inventory discovery topics
# (EACH TOPIC), and peel one-line topic docs (TOPICHINT) for runbook cards.
# First realworld of proofs 1337 ERRRUN + 1338 EACH TOPIC + 1339 TOPICHINT.
#
#   ERRRUN|RECOVERSNIP [err] → ERRRUN_TOPIC · ERRRUN_OK · nested RUNSNIP
#   EACH TOPIC [AS t] [MATCH needle] … END · EACHTOPICS_N
#   TOPICHINT|DESCRIBETOPIC name → TOPIC_NAME · one-line docs
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_set_$$
#   ./out/cubalc run programs/realworld/svc_errrun_topicwalk_board.cubalc boot
#   ./out/cubalc run ... recover|walk|hint|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SET_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SET_REQUIRE
#
# Edges: EACH TOPIC needs END; MATCH filter; nested RUNSNIP asserts;
#   soft TOPICHINT miss; FAIL sticky→ERRRUN; WRITE NL; PRINT clobber

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_errrun_topicwalk_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_errrun_topicwalk -- boot|recover|walk|hint|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SET_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SET_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET walk_n = 0
LET run_ok = 0
LET topic_got = ""
LET tips_n = 0

ONEOF ACTION "boot", "recover", "walk", "hint", "soft", "gate", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "recover" THEN
    LET op = "recover"
  WHEN "walk" THEN
    LET op = "walk"
  WHEN "hint" THEN
    LET op = "hint"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-errwalk\",\"schema\":\"cubalc.svc_errrun_topicwalk.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"recover\",\"label\":\"errwalk\",\"cfg\":{\"surface\":\"ERRRUN,EACH TOPIC,TOPICHINT\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"errwalk\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_errrun_topicwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ERRRUN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# recover — ERRRUN classify + RUNSNIP one-shot
SYS EQS op "recover"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # clean
  CLEAR_ERR
  ERRRUN
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  LET tips_n = ERRTIPS_N
  CLEAR_ERR
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  # sticky lib
  FAIL "INCLUDE missing hold_seed"
  ERRRUN
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  LET tips_n = ERRTIPS_N
  CLEAR_ERR
  SYS EQS topic_got "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  IF tips_n >= 1 THEN
    LET score = score + 1
  END
  # arg p2p
  ERRRUN "SMX DIAL timeout"
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  CLEAR_ERR
  SYS EQS topic_got "p2p"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  # RECOVERSNIP fat
  RECOVERSNIP "VARROOM NEEDVARROOM"
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  CLEAR_ERR
  SYS EQS topic_got "fat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST "errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "recover ok"
    LET admit_n = 1
    LET find_n = tips_n
  ELSE
    LET miss = 1
    LET note_msg = "recover score"
    FAIL "recover score"
    CLEAR_ERR
  END
  SYS CAT "recover:" tips_n ":rc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "recover:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n tips_n topic_got run_ok score note_msg
  CLEAR_ERR
END

# walk — EACH TOPIC inventory + MATCH filter
SYS EQS op "walk"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET body = ""
  LET walk_n = 0
  EACH TOPIC AS t
    LET walk_n = walk_n + 1
    SYS PUSH body t
    LET body = LAST
  END
  CLEAR_ERR
  IF walk_n == 8 THEN
    LET score = score + 1
  END
  IF EACHTOPICS_N == 8 THEN
    LET score = score + 1
  END
  SYS HASLINE body "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "protect"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # MATCH filter (topics containing a)
  LET sum_n = 0
  EACH TOPIC MATCH "a"
    LET sum_n = sum_n + 1
  END
  CLEAR_ERR
  IF sum_n >= 3 THEN
    LET score = score + 1
  END
  IF EACHTOPICS_N == sum_n THEN
    LET score = score + 1
  END
  # AS bind + HASTOPIC
  LET find_n = 0
  EACH TOPIC AS t
    HASTOPIC t
    IF LAST_N == 1 THEN
      LET find_n = find_n + 1
    END
    CLEAR_ERR
  END
  CLEAR_ERR
  IF find_n == 8 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "EACH TOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "walk ok"
    LET admit_n = 1
    LET walk_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "walk score"
    FAIL "walk score"
    CLEAR_ERR
  END
  SYS CAT "walk:" walk_n ":wk"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "walk:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n sum_n score note_msg
  CLEAR_ERR
END

# hint — TOPICHINT docs for topics
SYS EQS op "hint"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  TOPICHINT cap
  LET body = LAST
  LET topic_got = TOPIC_NAME
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "HASFORM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  DESCRIBETOPIC plate
  LET body = LAST
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "plate"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "SETP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPICHINT forms
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  TOPICHINT p2p
  LET body = LAST
  CLEAR_ERR
  SYS HASI body "SMX"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # EACH + TOPICHINT
  LET walk_n = 0
  EACH TOPIC AS t
    TOPICHINT t
    IF OK == 1 THEN
      LET walk_n = walk_n + 1
    END
    CLEAR_ERR
  END
  CLEAR_ERR
  IF walk_n == 8 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "TOPICHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hint ok"
    LET admit_n = 1
    LET find_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "hint score"
    FAIL "hint score"
    CLEAR_ERR
  END
  SYS CAT "hint:" walk_n ":hn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hint:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n topic_got score note_msg
  CLEAR_ERR
END

# soft — TOPICHINT miss + bare
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  TOPICHINT zzz_nope
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  TOPICHINT
  LET sum_v = OK
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  # MATCH empty-ish filter still ok loop
  LET sum_n = 0
  EACH TOPIC MATCH "zzz_no_match"
    LET sum_n = sum_n + 1
  END
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ERRRUN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate surface + live recover + walk floor
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  FAIL "ASSERT is false"
  ERRRUN
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  CLEAR_ERR
  SYS EQS topic_got "run"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  LISTTOPICS
  LET walk_n = LISTTOPICS_N
  CLEAR_ERR
  IF walk_n == 8 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "ERRRUN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOPICHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "recover"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "errrun_topicwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n topic_got run_ok score note_msg
  CLEAR_ERR
END

# alias — RECOVERSNIP + DESCRIBETOPIC
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  RECOVERSNIP "unknown form FOOBAR"
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  CLEAR_ERR
  SYS EQS topic_got "cap"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  DESCRIBETOPIC lib
  LET body = LAST
  LET topic_got = TOPIC_NAME
  CLEAR_ERR
  SYS EQS topic_got "lib"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "LISTLIBS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "errwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "EACH TOPIC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n topic_got run_ok score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + nested asserts + MATCH dual
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  TOPICHINT fat
  LET body = LAST
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASI stem_s "VARROOM"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI LAST "VARROOM"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # MATCH p filter
  LET sum_n = 0
  EACH TOPIC MATCH "p"
    LET sum_n = sum_n + 1
  END
  CLEAR_ERR
  # plate, p2p, protect at least
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  ERRRUN "ASSERT is false"
  LET topic_got = ERRRUN_TOPIC
  LET run_ok = ERRRUN_OK
  CLEAR_ERR
  SYS EQS topic_got "run"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF run_ok == 1 THEN
    LET score = score + 1
  END
  # walk floor
  LET walk_n = 0
  EACH TOPIC
    LET walk_n = walk_n + 1
  END
  CLEAR_ERR
  IF walk_n == 8 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "errrun_topicwalk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "TOPICHINT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = walk_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" walk_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n walk_n sum_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_errrun_topicwalk.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " walk_n=" walk_n " run_ok=" run_ok " tips_n=" tips_n " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_errrun_topicwalk_board: done"
PASS
