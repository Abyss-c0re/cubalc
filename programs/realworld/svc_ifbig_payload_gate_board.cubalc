# gate — admit mid payload 8..4096
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR pay_dir
  CLEAR_ERR
  SYS WRITE pay_path "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  CLEAR_ERR
  LET p = pay_path
  LET minb = 8
  LET maxb = 4096
  CALL admit_payload
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL is_big
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL in_size
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  LET nbytes = IFSIZE_BYTES
  IF nbytes == 32 THEN
    LET score = score + 1
  END
  SYS WRITE empty_path ""
  CLEAR_ERR
  LET p = empty_path
  CALL admit_payload
  SYS EQS state "deny-undersize"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit > 0 THEN
    IF score < 4 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ibp"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF IFBIG_N >= 0 THEN
    LET score = score + 1
  END
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = nbytes
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score nbytes note_msg
  CLEAR_ERR
END

# probe
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR pay_dir
  CLEAR_ERR
  SYS WRITE pay_path "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  CLEAR_ERR
  LET p = pay_path
  LET minb = 1
  CALL is_big
  LET saved = IFBIG_N
  LET nbytes = IFSIZE_BYTES
  PRINT "probe-big" saved nbytes
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "ibp host=" host_s " role=" role_s " big=" saved
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "big=1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "IFSMALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF nbytes == 32 THEN
    LET score = score + 1
  END
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = nbytes
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-ibp\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

PASS
