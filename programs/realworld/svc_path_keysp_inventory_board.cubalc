# svc_path_keysp_inventory_board.cubalc — nest path KEYSP/LENP/EMPTYP/VALSP inventory
#
# Real use: ops agents audit nested service config (cfg/flags/meta) — key bags,
# counts, empty nests, value peels — without GETOBJ+KEYSP glue. First realworld
# of proof 1201 path KEYSP/LENP/EMPTYP/VALSP (+ soft miss, FROM PEER).
#
#   KEYSP|LENP|EMPTYP|NONEMPTYP|VALSP [path] · KEYSP_PATH · multi-plate FROM
#   soft miss nest → empty bag / EMPTYP 1 · leaf non-object soft empty
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ski_$$
#   ./out/cubalc run programs/realworld/svc_path_keysp_inventory_board.cubalc boot
#   ./out/cubalc run ... keys|len|empty|vals|peer|soft|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SKI_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SKI_REQUIRE
#
# Edges:
#   soft miss path; leaf LENP 0; false-friend key substrings; WRITE NL;
#   NUM softens REQUIRE; EXIT shell (W7); KEYSP specials vs LAST bag

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_path_keysp_inventory_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_path_keysp_inventory -- boot|keys|len|empty|vals|peer|soft|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeX"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SKI_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SKI_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET path_val = ""

ONEOF ACTION "boot", "keys", "len", "empty", "vals", "peer", "soft", "gate", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "keys" THEN
    LET op = "keys"
  WHEN "len" THEN
    LET op = "len"
  WHEN "empty" THEN
    LET op = "empty"
  WHEN "vals" THEN
    LET op = "vals"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — seed nested cfg/flags/empty for inventory
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-keysp\",\"schema\":\"cubalc.svc_path_keysp_inventory.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"n\":1,\"cfg\":{\"port\":8080,\"tls\":0,\"role\":\"edge\"},\"flags\":{\"debug\":0,\"trace\":1},\"empty\":{},\"meta\":{\"role\":\"" role_s "\",\"zone\":\"east\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"schema\":\"cubalc.svc_path_keysp_inventory.v1\",\"meta\":{\"role\":\"edge\",\"n\":9,\"zone\":\"west\"},\"cfg\":{\"port\":9090},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LENP "cfg"
  LET peel_hit = LAST_N
  CLEAR_ERR
  KEYSP "cfg"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "port"
  LET load_hit = LAST_N
  CLEAR_ERR
  EMPTYP "empty"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF peel_hit == 3 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET take_n = 3
        LET has_n = 3
      ELSE
        LET miss = 1
        LET note_msg = "boot empty nest"
        FAIL "boot empty nest"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot cfg port key"
      FAIL "boot cfg port key"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot cfg len"
    FAIL "boot cfg len"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

# keys — KEYSP nest path inventory + false friend
SYS EQS op "keys"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  KEYSP "cfg"
  LET body = LAST
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HASLINE body "port"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "tls"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "role"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # false friend substring must not match
  SYS HASLINE body "por"
  LET miss_n = LAST_N
  CLEAR_ERR
  KEYSP "flags"
  LET w_s = LAST
  CLEAR_ERR
  SYS HASLINE w_s "debug"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE w_s "trace"
  LET gate_ok = LAST_N
  CLEAR_ERR
  # top-level keys include cfg
  KEYSP
  LET path_val = LAST
  CLEAR_ERR
  SYS HASLINE path_val "cfg"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF miss_n == 0 THEN
          IF has_n == 1 THEN
            IF gate_ok == 1 THEN
              IF admit_n == 1 THEN
                LET hit = 1
                LET note_msg = "keys ok"
                LET admit_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "keys top cfg"
                FAIL "keys top cfg"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "keys flags trace"
              FAIL "keys flags trace"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "keys flags debug"
            FAIL "keys flags debug"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "keys false por"
          FAIL "keys false por"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "keys cfg role"
        FAIL "keys cfg role"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "keys cfg tls"
      FAIL "keys cfg tls"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "keys cfg port"
    FAIL "keys cfg port"
    CLEAR_ERR
  END
  SYS CAT "keys:cfg3:ky"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "keys:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok miss_n note_msg
  CLEAR_ERR
END

# len — LENP nest counts + NKEYSP alias
SYS EQS op "len"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LENP "cfg"
  LET peel_hit = LAST_N
  CLEAR_ERR
  LENP "flags"
  LET load_hit = LAST_N
  CLEAR_ERR
  LENP "empty"
  LET soft_ok = LAST_N
  CLEAR_ERR
  NKEYSP "meta"
  LET has_n = LAST_N
  CLEAR_ERR
  # top-level len
  LENP
  LET take_n = LAST_N
  CLEAR_ERR
  # leaf non-object → 0
  LENP "host"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 3 THEN
    IF load_hit == 2 THEN
      IF soft_ok == 0 THEN
        IF has_n == 2 THEN
          IF take_n >= 6 THEN
            IF miss_n == 0 THEN
              LET hit = 1
              LET note_msg = "len ok"
              LET admit_n = 1
              LET gate_ok = 1
            ELSE
              LET miss = 1
              LET note_msg = "len host leaf"
              FAIL "len host leaf"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "len top"
            FAIL "len top"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "len meta"
          FAIL "len meta"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "len empty nest"
        FAIL "len empty nest"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "len flags"
      FAIL "len flags"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "len cfg"
    FAIL "len cfg"
    CLEAR_ERR
  END
  SYS CAT "len:cfg3:ln"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "len:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit has_n miss_n note_msg
  CLEAR_ERR
END

# empty — EMPTYP/NONEMPTYP path probes
SYS EQS op "empty"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  EMPTYP "empty"
  LET peel_hit = LAST_N
  CLEAR_ERR
  EMPTYP "cfg"
  LET load_hit = LAST_N
  CLEAR_ERR
  NONEMPTYP "cfg"
  LET soft_ok = LAST_N
  CLEAR_ERR
  NONEMPTYP "empty"
  LET has_n = LAST_N
  CLEAR_ERR
  # leaf treated as empty for EMPTYP
  EMPTYP "host"
  LET gate_ok = LAST_N
  CLEAR_ERR
  HASKEYSP "flags"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 0 THEN
      IF soft_ok == 1 THEN
        IF has_n == 0 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "empty ok"
              LET admit_n = 1
              LET take_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "empty haskeysp flags"
              FAIL "empty haskeysp flags"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "empty host leaf"
            FAIL "empty host leaf"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "empty nonempty empty"
          FAIL "empty nonempty empty"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "empty nonempty cfg"
        FAIL "empty nonempty cfg"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "empty cfg not empty"
      FAIL "empty cfg not empty"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "empty nest empty"
    FAIL "empty nest empty"
    CLEAR_ERR
  END
  SYS CAT "empty:ok:em"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "empty:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok gate_ok note_msg
  CLEAR_ERR
END

# vals — VALSP nest value bag
SYS EQS op "vals"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  VALSP "cfg"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "8080"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "0"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "edge"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # false friend value
  SYS HASLINE body "808"
  LET miss_n = LAST_N
  CLEAR_ERR
  VALUEP "flags"
  LET w_s = LAST
  CLEAR_ERR
  SYS HASLINE w_s "1"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE w_s "0"
  LET gate_ok = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF miss_n == 0 THEN
          IF has_n == 1 THEN
            IF gate_ok == 1 THEN
              LET hit = 1
              LET note_msg = "vals ok"
              LET admit_n = 1
              LET take_n = 3
            ELSE
              LET miss = 1
              LET note_msg = "vals flags 0"
              FAIL "vals flags 0"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "vals flags 1"
            FAIL "vals flags 1"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "vals false 808"
          FAIL "vals false 808"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "vals edge"
        FAIL "vals edge"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "vals tls 0"
      FAIL "vals tls 0"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "vals port"
    FAIL "vals port"
    CLEAR_ERR
  END
  SYS CAT "vals:cfg3:vl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "vals:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok miss_n note_msg
  CLEAR_ERR
END

# peer — KEYSP/LENP FROM PEER path
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  KEYSP FROM PEER "meta"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "role"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "n"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "zone"
  LET soft_ok = LAST_N
  CLEAR_ERR
  LENP FROM PEER "meta"
  LET has_n = LAST_N
  CLEAR_ERR
  LENP FROM PEER "cfg"
  LET gate_ok = LAST_N
  CLEAR_ERR
  VALSP FROM PEER "cfg"
  LET w_s = LAST
  CLEAR_ERR
  SYS HASLINE w_s "9090"
  LET admit_n = LAST_N
  CLEAR_ERR
  # local plate role untouched
  GETP "role"
  SYS EQS LAST role_s
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 3 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              IF miss_n == 1 THEN
                LET hit = 1
                LET note_msg = "peer ok"
                LET admit_n = 1
                LET take_n = 3
              ELSE
                LET miss = 1
                LET note_msg = "peer plate role"
                FAIL "peer plate role"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "peer cfg val"
              FAIL "peer cfg val"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer cfg len"
            FAIL "peer cfg len"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer meta len"
          FAIL "peer meta len"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer zone"
        FAIL "peer zone"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer n"
      FAIL "peer n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer role key"
    FAIL "peer role key"
    CLEAR_ERR
  END
  SYS CAT "peer:meta3:pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit has_n admit_n note_msg
  CLEAR_ERR
END

# soft — miss path empty + leaf soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  KEYSP "missing.nest"
  LET body = LAST
  CLEAR_ERR
  SYS LINES body
  LET peel_hit = LAST_N
  CLEAR_ERR
  LENP "missing.nest"
  LET load_hit = LAST_N
  CLEAR_ERR
  EMPTYP "missing.nest"
  LET soft_ok = LAST_N
  CLEAR_ERR
  LENP "host"
  LET has_n = LAST_N
  CLEAR_ERR
  EMPTYP "host"
  LET gate_ok = LAST_N
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET miss_n = LAST_N
  CLEAR_ERR
  # false friend path
  HASP "cfg.por"
  LET path_val = LAST_N
  CLEAR_ERR
  IF peel_hit == 0 THEN
    IF load_hit == 0 THEN
      IF soft_ok == 1 THEN
        IF has_n == 0 THEN
          IF gate_ok == 1 THEN
            IF miss_n == 0 THEN
              IF path_val == 0 THEN
                LET hit = 1
                LET note_msg = "soft ok"
                LET admit_n = 1
                LET take_n = 0
              ELSE
                LET miss = 1
                LET note_msg = "soft false por"
                FAIL "soft false por"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "soft empty bag"
              FAIL "soft empty bag"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft host empty"
            FAIL "soft host empty"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft host len"
          FAIL "soft host len"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft miss emptyp"
        FAIL "soft miss emptyp"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft miss len"
      FAIL "soft miss len"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft miss keys"
    FAIL "soft miss keys"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:miss0:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok gate_ok note_msg
  CLEAR_ERR
END

# gate — inventory contract after probes
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LENP "cfg"
  LET peel_hit = LAST_N
  CLEAR_ERR
  NONEMPTYP "cfg"
  LET load_hit = LAST_N
  CLEAR_ERR
  EMPTYP "empty"
  LET soft_ok = LAST_N
  CLEAR_ERR
  KEYSP "cfg"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "port"
  LET has_n = LAST_N
  CLEAR_ERR
  NEEDP "host" "schema" "role"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET admit_n = 0
  END
  CLEAR_ERR
  HASP "cfg.port"
  LET gate_ok = LAST_N
  CLEAR_ERR
  HASP "cfg.por"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 3 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF admit_n == 1 THEN
            IF gate_ok == 1 THEN
              IF miss_n == 0 THEN
                LET hit = 1
                LET note_msg = "gate ok"
                LET admit_n = 1
                LET take_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "gate false por"
                FAIL "gate false por"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "gate has port"
              FAIL "gate has port"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "gate needp"
            FAIL "gate needp"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "gate keysp port"
          FAIL "gate keysp port"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate empty"
        FAIL "gate empty"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate nonempty cfg"
      FAIL "gate nonempty cfg"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate cfg len"
    FAIL "gate cfg len"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:1:gn"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok admit_n note_msg
  CLEAR_ERR
END

# probe — slash path, DEFAULTP fill, aliases
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET load_hit = LAST_N
  CLEAR_ERR
  KEYSP "flags"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "debug"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # slash path alias if supported
  LENP "cfg"
  LET soft_ok = LAST_N
  CLEAR_ERR
  DEFAULTP "cfg.extra" 9
  CLEAR_ERR
  LENP "cfg"
  LET has_n = LAST_N
  CLEAR_ERR
  KEYSP "cfg"
  LET w_s = LAST
  CLEAR_ERR
  SYS HASLINE w_s "extra"
  LET gate_ok = LAST_N
  CLEAR_ERR
  GETP "cfg.extra"
  SYS EQS LAST "9"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "agent"
  SYS HAS LAST "svc-keysp"
  LET miss_n = LAST_N
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF load_hit == 0 THEN
    IF peel_hit == 1 THEN
      IF soft_ok == 3 THEN
        IF has_n == 4 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              IF miss_n == 1 THEN
                LET hit = 1
                LET note_msg = "probe ok"
                LET admit_n = 1
                LET take_n = 1
              ELSE
                LET miss = 1
                LET note_msg = "probe agent"
                FAIL "probe agent"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "probe extra val"
              FAIL "probe extra val"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe extra key"
            FAIL "probe extra key"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe cfg len after default"
          FAIL "probe cfg len after default"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe cfg len pre"
        FAIL "probe cfg len pre"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe flags debug"
      FAIL "probe flags debug"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe empty bag"
    FAIL "probe empty bag"
    CLEAR_ERR
  END
  SYS CAT "probe:keysp:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit has_n gate_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_path_keysp_inventory.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_path_keysp_inventory_board: end"
