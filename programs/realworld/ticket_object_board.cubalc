# ticket_object_board.cubalc — OOP Ticket pool t0..t5 + HASOBJ/LIST*/DELETEOBJ
#
# Real use: agents keep a fixed-slot work-ticket pool as CLASS objects,
# introspect with LISTOBJS/HASMETHOD, free with DELETEOBJ, snapshot plates:
#   CLASS / FIELD / METHOD / NEW / SEND / GETF / SETF
#   LISTOBJS / LISTCLASSES / LISTMETHODS / LISTFIELDS
#   HASOBJ / HASFIELD / HASMETHOD / DELETEOBJ
# Distinct from job_ticket (string plates) and work_claim (bags): this board
# is *OOP pool + introspection + soft destroy*.
#
# WHY fixed slots: NEW Ticket NAME uses the *ident* NAME, not string value
# of variable NAME — dynamic object names from ARG are not supported.
# WHY rehydrate: objects are process-local; multi-run ARG dispatch restores
# from STATE/pool/*.txt then re-NEW slots each process.
#
# Plate under STATE:
#   pool/t0.txt .. t5.txt — "status|prio|id" lines
#   OBJS.txt METHODS.txt FIELDS.txt VAL.txt META.txt TICKET_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_TO_ACTION):
#   list | open | close | bump | status | prio | has | methods | fields
#   classes | delete | gate | clear
# Slot ARG1: 0..5 or t0..t5. ARG2: prio for open.
#
# Env: CUBALC_TO_REQUIRE=1  CUBALC_TO_NAME=t1  CUBALC_TO_PRIO=2
#
# Edges:
#   NEW object name is *ident token*, not string value of var (NAME→object "NAME")
#   METHOD/NEW string args become strlen when SETF into fields (ctor gap)
#   SETF field strvar stores strlen not text — only string *literals* work
#   Objects memory-only; plate rehydrate + literal SETF required for multi-run
#   DELETEOBJ unknown soft OK=0 sticky last_err
#   HASMETHOD soft; SEND unknown method hard fail
#   WRITE may omit NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

CLASS Ticket
  FIELD id "none"
  FIELD status "open"
  FIELD prio 0
  METHOD init p
    # NOTE: string ctor args arrive as length (lang gap) — prio only
    SETF THIS prio p
    SETF THIS status "open"
    SETF THIS id "none"
  END
  METHOD close
    SETF THIS status "closed"
    RET 1
  END
  METHOD reopen
    SETF THIS status "open"
    RET 1
  END
  METHOD bump
    GETF THIS prio
    LET p = LAST_N + 1
    SETF THIS prio p
    RET p
  END
END

NOTE "ticket_object_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT REQUIRE_HIT = 0
DEFAULT DEF_PRIO = 1
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0ms = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_TO_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_TO_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_TO_PRIO" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_TO_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir "pool"
LET pool_dir = LAST
SYS MKDIR pool_dir
CLEAR_ERR
SYS JOIN state_dir "OBJS.txt"
LET objs_path = LAST
SYS JOIN state_dir "METHODS.txt"
LET methods_path = LAST
SYS JOIN state_dir "FIELDS.txt"
LET fields_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "TICKET_REPORT.txt"
LET report_path = LAST

# --- resolve slot 0..5 from NAME ---
LET slot = -1
SYS BLANK NAME
IF LAST_N == 0 THEN
  SYS EQS NAME "t0"
  IF LAST_N == 1 THEN
    LET slot = 0
  END
  SYS EQS NAME "t1"
  IF LAST_N == 1 THEN
    LET slot = 1
  END
  SYS EQS NAME "t2"
  IF LAST_N == 1 THEN
    LET slot = 2
  END
  SYS EQS NAME "t3"
  IF LAST_N == 1 THEN
    LET slot = 3
  END
  SYS EQS NAME "t4"
  IF LAST_N == 1 THEN
    LET slot = 4
  END
  SYS EQS NAME "t5"
  IF LAST_N == 1 THEN
    LET slot = 5
  END
  IF slot < 0 THEN
    SYS NUM NAME
    IF OK == 1 THEN
      LET ntmp = LAST_N
      SYS STR ntmp
      SYS EQS LAST NAME
      IF LAST_N == 1 THEN
        IF ntmp >= 0 THEN
          IF ntmp <= 5 THEN
            LET slot = ntmp
          END
        END
      END
    END
    CLEAR_ERR
  END
END
# slot name string sn
LET sn = ""
IF slot == 0 THEN
  LET sn = "t0"
END
IF slot == 1 THEN
  LET sn = "t1"
END
IF slot == 2 THEN
  LET sn = "t2"
END
IF slot == 3 THEN
  LET sn = "t3"
END
IF slot == 4 THEN
  LET sn = "t4"
END
IF slot == 5 THEN
  LET sn = "t5"
END

LET prio_in = DEF_PRIO
SYS BLANK A2
IF LAST_N == 0 THEN
  SYS NUM A2
  IF OK == 1 THEN
    LET ntmp = LAST_N
    SYS STR ntmp
    SYS EQS LAST A2
    IF LAST_N == 1 THEN
      LET prio_in = ntmp
    END
  END
  CLEAR_ERR
END

# --- rehydrate pool from plates into fixed idents ---
SYS JOIN pool_dir "t0.txt"
LET p0 = LAST
SYS JOIN pool_dir "t1.txt"
LET p1 = LAST
SYS JOIN pool_dir "t2.txt"
LET p2 = LAST
SYS JOIN pool_dir "t3.txt"
LET p3 = LAST
SYS JOIN pool_dir "t4.txt"
LET p4 = LAST
SYS JOIN pool_dir "t5.txt"
LET p5 = LAST

# load one plate: returns via side effects on object
# pattern: READ OR path OR ""; if nonblank NEW + SETF
SYS READ OR p0 OR ""
LET raw = LAST
CLEAR_ERR
# Rehydrate: SETF string fields need *literals* (var SETF stores strlen — lang gap)
SYS BLANK raw
IF LAST_N == 0 THEN
  NEW Ticket t0 0
  SETF t0 id "t0"
  SYS NTH 0 raw
  SYS EQS LAST "closed"
  IF LAST_N == 1 THEN
    SETF t0 status "closed"
  ELSE
    SETF t0 status "open"
  END
  SYS NTH 1 raw
  SYS NUM LAST
  IF OK == 1 THEN
    SETF t0 prio LAST_N
  END
  CLEAR_ERR
END
SYS READ OR p1 OR ""
LET raw = LAST
CLEAR_ERR
SYS BLANK raw
IF LAST_N == 0 THEN
  NEW Ticket t1 0
  SETF t1 id "t1"
  SYS NTH 0 raw
  SYS EQS LAST "closed"
  IF LAST_N == 1 THEN
    SETF t1 status "closed"
  ELSE
    SETF t1 status "open"
  END
  SYS NTH 1 raw
  SYS NUM LAST
  IF OK == 1 THEN
    SETF t1 prio LAST_N
  END
  CLEAR_ERR
END
SYS READ OR p2 OR ""
LET raw = LAST
CLEAR_ERR
SYS BLANK raw
IF LAST_N == 0 THEN
  NEW Ticket t2 0
  SETF t2 id "t2"
  SYS NTH 0 raw
  SYS EQS LAST "closed"
  IF LAST_N == 1 THEN
    SETF t2 status "closed"
  ELSE
    SETF t2 status "open"
  END
  SYS NTH 1 raw
  SYS NUM LAST
  IF OK == 1 THEN
    SETF t2 prio LAST_N
  END
  CLEAR_ERR
END
SYS READ OR p3 OR ""
LET raw = LAST
CLEAR_ERR
SYS BLANK raw
IF LAST_N == 0 THEN
  NEW Ticket t3 0
  SETF t3 id "t3"
  SYS NTH 0 raw
  SYS EQS LAST "closed"
  IF LAST_N == 1 THEN
    SETF t3 status "closed"
  ELSE
    SETF t3 status "open"
  END
  SYS NTH 1 raw
  SYS NUM LAST
  IF OK == 1 THEN
    SETF t3 prio LAST_N
  END
  CLEAR_ERR
END
SYS READ OR p4 OR ""
LET raw = LAST
CLEAR_ERR
SYS BLANK raw
IF LAST_N == 0 THEN
  NEW Ticket t4 0
  SETF t4 id "t4"
  SYS NTH 0 raw
  SYS EQS LAST "closed"
  IF LAST_N == 1 THEN
    SETF t4 status "closed"
  ELSE
    SETF t4 status "open"
  END
  SYS NTH 1 raw
  SYS NUM LAST
  IF OK == 1 THEN
    SETF t4 prio LAST_N
  END
  CLEAR_ERR
END
SYS READ OR p5 OR ""
LET raw = LAST
CLEAR_ERR
SYS BLANK raw
IF LAST_N == 0 THEN
  NEW Ticket t5 0
  SETF t5 id "t5"
  SYS NTH 0 raw
  SYS EQS LAST "closed"
  IF LAST_N == 1 THEN
    SETF t5 status "closed"
  ELSE
    SETF t5 status "open"
  END
  SYS NTH 1 raw
  SYS NUM LAST
  IF OK == 1 THEN
    SETF t5 prio LAST_N
  END
  CLEAR_ERR
END

LET hit = 0
LET miss = 0
LET val = ""
LET meta = ""
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET gate_n = 0
LET has_n = 0
LET prio_n = 0
LET nobjs = 0
LET persist = 0

# --- snapshot slot to plate ---
# called after mutations; uses sn + GETF

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LISTOBJS Ticket
  LET objs_bag = LAST
  LET nobjs = NOBJS
  LISTMETHODS Ticket
  LET methods_bag = LAST
  LISTFIELDS Ticket
  LET fields_bag = LAST
  SYS WRITE objs_path objs_bag
  SYS WRITE methods_path methods_bag
  SYS WRITE fields_path fields_bag
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "list ok"
  LET val = objs_bag
  LET val_ch = 1
  LET meta = "list"
  SYS STR nobjs
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  STATUS
  PRINT "ticket" ACTION nobjs
  PRINT_JSON ACTION nobjs
  CLEAR_ERR
END

# --- open ---
SYS EQS ACTION "open"
IF LAST_N == 1 THEN
  NOTE "action open"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "open bad slot"
    FAIL "open bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "open bad slot"
    END
  ELSE
    IF slot == 0 THEN
      HASOBJ t0
      IF LAST_N == 1 THEN
        DELETEOBJ t0
        CLEAR_ERR
      END
      NEW Ticket t0 prio_in
      SETF t0 status "open"
      SETF t0 prio prio_in
      SETF t0 id "t0"
    END
    IF slot == 1 THEN
      HASOBJ t1
      IF LAST_N == 1 THEN
        DELETEOBJ t1
        CLEAR_ERR
      END
      NEW Ticket t1 prio_in
      SETF t1 status "open"
      SETF t1 prio prio_in
      SETF t1 id "t1"
    END
    IF slot == 2 THEN
      HASOBJ t2
      IF LAST_N == 1 THEN
        DELETEOBJ t2
        CLEAR_ERR
      END
      NEW Ticket t2 prio_in
      SETF t2 status "open"
      SETF t2 prio prio_in
      SETF t2 id "t2"
    END
    IF slot == 3 THEN
      HASOBJ t3
      IF LAST_N == 1 THEN
        DELETEOBJ t3
        CLEAR_ERR
      END
      NEW Ticket t3 prio_in
      SETF t3 status "open"
      SETF t3 prio prio_in
      SETF t3 id "t3"
    END
    IF slot == 4 THEN
      HASOBJ t4
      IF LAST_N == 1 THEN
        DELETEOBJ t4
        CLEAR_ERR
      END
      NEW Ticket t4 prio_in
      SETF t4 status "open"
      SETF t4 prio prio_in
      SETF t4 id "t4"
    END
    IF slot == 5 THEN
      HASOBJ t5
      IF LAST_N == 1 THEN
        DELETEOBJ t5
        CLEAR_ERR
      END
      NEW Ticket t5 prio_in
      SETF t5 status "open"
      SETF t5 prio prio_in
      SETF t5 id "t5"
    END
    LET persist = 1
    LET hit = 1
    LET note_msg = "open ok"
    LET val = "open"
    LET val_ch = 1
    LET meta = "open"
    SYS PUSH meta sn
    LET meta = LAST
    SYS STR prio_in
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON slot prio_in
  PRINT_JSON val
  CLEAR_ERR
END

# --- close ---
SYS EQS ACTION "close"
IF LAST_N == 1 THEN
  NOTE "action close"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "close bad slot"
    FAIL "close bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "close bad slot"
    END
  ELSE
    LET alive = 0
    IF slot == 0 THEN
      HASOBJ t0
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t0 close
      END
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t1 close
      END
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t2 close
      END
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t3 close
      END
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t4 close
      END
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t5 close
      END
    END
    IF alive == 0 THEN
      LET miss = 1
      LET note_msg = "close missing"
      FAIL "close missing"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "close missing"
      END
    ELSE
      LET persist = 1
      LET hit = 1
      LET note_msg = "close ok"
      LET val = "closed"
      LET val_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- bump ---
SYS EQS ACTION "bump"
IF LAST_N == 1 THEN
  NOTE "action bump"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "bump bad slot"
    FAIL "bump bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "bump bad slot"
    END
  ELSE
    LET alive = 0
    IF slot == 0 THEN
      HASOBJ t0
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t0 bump
        LET prio_n = LAST_N
      END
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t1 bump
        LET prio_n = LAST_N
      END
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t2 bump
        LET prio_n = LAST_N
      END
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t3 bump
        LET prio_n = LAST_N
      END
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t4 bump
        LET prio_n = LAST_N
      END
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET alive = LAST_N
      IF alive == 1 THEN
        SEND t5 bump
        LET prio_n = LAST_N
      END
    END
    IF alive == 0 THEN
      LET miss = 1
      LET note_msg = "bump missing"
      FAIL "bump missing"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "bump missing"
      END
    ELSE
      LET persist = 1
      LET hit = 1
      LET note_msg = "bump ok"
      SYS STR prio_n
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON prio_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- status ---
SYS EQS ACTION "status"
IF LAST_N == 1 THEN
  NOTE "action status"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "status bad slot"
    FAIL "status bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "status bad slot"
    END
  ELSE
    LET alive = 0
    LET st = ""
    IF slot == 0 THEN
      HASOBJ t0
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t0 status
        LET st = LAST
      END
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t1 status
        LET st = LAST
      END
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t2 status
        LET st = LAST
      END
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t3 status
        LET st = LAST
      END
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t4 status
        LET st = LAST
      END
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t5 status
        LET st = LAST
      END
    END
    IF alive == 0 THEN
      LET miss = 1
      LET note_msg = "status missing"
      FAIL "status missing"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "status missing"
      END
    ELSE
      LET hit = 1
      LET note_msg = "status ok"
      LET val = st
      LET val_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- prio ---
SYS EQS ACTION "prio"
IF LAST_N == 1 THEN
  NOTE "action prio"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "prio bad slot"
    FAIL "prio bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "prio bad slot"
    END
  ELSE
    LET alive = 0
    IF slot == 0 THEN
      HASOBJ t0
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t0 prio
        LET prio_n = LAST_N
      END
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t1 prio
        LET prio_n = LAST_N
      END
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t2 prio
        LET prio_n = LAST_N
      END
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t3 prio
        LET prio_n = LAST_N
      END
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t4 prio
        LET prio_n = LAST_N
      END
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t5 prio
        LET prio_n = LAST_N
      END
    END
    IF alive == 0 THEN
      LET miss = 1
      LET note_msg = "prio missing"
      FAIL "prio missing"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "prio missing"
      END
    ELSE
      LET hit = 1
      LET note_msg = "prio ok"
      SYS STR prio_n
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON prio_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "has bad slot"
    FAIL "has bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has bad slot"
    END
  ELSE
    LET has_n = 0
    IF slot == 0 THEN
      HASOBJ t0
      LET has_n = LAST_N
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET has_n = LAST_N
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET has_n = LAST_N
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET has_n = LAST_N
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET has_n = LAST_N
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET has_n = LAST_N
    END
    SYS STR has_n
    LET val = LAST
    LET val_ch = 1
    IF has_n == 1 THEN
      LET hit = 1
      LET note_msg = "has hit"
    ELSE
      LET miss = 1
      LET note_msg = "has miss"
      FAIL "has miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "has miss"
      END
    END
  END
  PRINT_JSON has_n
  CLEAR_ERR
END

# --- methods ---
SYS EQS ACTION "methods"
IF LAST_N == 1 THEN
  NOTE "action methods"
  LISTMETHODS Ticket
  LET methods_bag = LAST
  SYS WRITE methods_path methods_bag
  CLEAR_ERR
  HASMETHOD Ticket close
  LET has_n = LAST_N
  HASMETHOD Ticket bump
  LET prio_n = LAST_N
  LET hit = 1
  LET note_msg = "methods ok"
  LET val = methods_bag
  LET val_ch = 1
  LET meta = "methods"
  SYS STR NMETHODS
  SYS PUSH meta LAST
  LET meta = LAST
  SYS STR has_n
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON NMETHODS has_n prio_n
  CLEAR_ERR
END

# --- fields ---
SYS EQS ACTION "fields"
IF LAST_N == 1 THEN
  NOTE "action fields"
  LISTFIELDS Ticket
  LET fields_bag = LAST
  SYS WRITE fields_path fields_bag
  CLEAR_ERR
  HASFIELD Ticket status
  LET has_n = LAST_N
  LET hit = 1
  LET note_msg = "fields ok"
  LET val = fields_bag
  LET val_ch = 1
  LET meta = "fields"
  SYS STR NFIELDS
  SYS PUSH meta LAST
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON NFIELDS has_n
  CLEAR_ERR
END

# --- classes ---
SYS EQS ACTION "classes"
IF LAST_N == 1 THEN
  NOTE "action classes"
  LISTCLASSES
  LET val = LAST
  LET val_ch = 1
  SYS HASLINE val "Ticket"
  LET has_n = LAST_N
  IF has_n == 1 THEN
    LET hit = 1
    LET note_msg = "classes ok"
  ELSE
    LET miss = 1
    LET note_msg = "classes no Ticket"
    FAIL "classes no Ticket"
    CLEAR_ERR
  END
  PRINT_JSON NCLASSES has_n
  CLEAR_ERR
END

# --- delete ---
SYS EQS ACTION "delete"
IF LAST_N == 1 THEN
  NOTE "action delete"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "delete bad slot"
    FAIL "delete bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "delete bad slot"
    END
  ELSE
    LET alive = 0
    IF slot == 0 THEN
      HASOBJ t0
      LET alive = LAST_N
      IF alive == 1 THEN
        DELETEOBJ t0
      END
      SYS RM p0
      CLEAR_ERR
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET alive = LAST_N
      IF alive == 1 THEN
        DELETEOBJ t1
      END
      SYS RM p1
      CLEAR_ERR
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET alive = LAST_N
      IF alive == 1 THEN
        DELETEOBJ t2
      END
      SYS RM p2
      CLEAR_ERR
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET alive = LAST_N
      IF alive == 1 THEN
        DELETEOBJ t3
      END
      SYS RM p3
      CLEAR_ERR
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET alive = LAST_N
      IF alive == 1 THEN
        DELETEOBJ t4
      END
      SYS RM p4
      CLEAR_ERR
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET alive = LAST_N
      IF alive == 1 THEN
        DELETEOBJ t5
      END
      SYS RM p5
      CLEAR_ERR
    END
    IF alive == 0 THEN
      LET miss = 1
      LET note_msg = "delete miss"
      FAIL "delete miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "delete miss"
      END
    ELSE
      LET hit = 1
      LET note_msg = "delete ok"
      LET val = "deleted"
      LET val_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- gate ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  IF slot < 0 THEN
    LET miss = 1
    LET note_msg = "gate bad slot"
    FAIL "gate bad slot"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate bad slot"
    END
  ELSE
    LET alive = 0
    LET st = ""
    IF slot == 0 THEN
      HASOBJ t0
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t0 status
        LET st = LAST
      END
    END
    IF slot == 1 THEN
      HASOBJ t1
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t1 status
        LET st = LAST
      END
    END
    IF slot == 2 THEN
      HASOBJ t2
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t2 status
        LET st = LAST
      END
    END
    IF slot == 3 THEN
      HASOBJ t3
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t3 status
        LET st = LAST
      END
    END
    IF slot == 4 THEN
      HASOBJ t4
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t4 status
        LET st = LAST
      END
    END
    IF slot == 5 THEN
      HASOBJ t5
      LET alive = LAST_N
      IF alive == 1 THEN
        GETF t5 status
        LET st = LAST
      END
    END
    IF alive == 0 THEN
      LET gate_n = 0
      LET miss = 1
      LET note_msg = "gate missing"
      LET val = "deny"
      LET val_ch = 1
      FAIL "gate missing"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "gate missing"
      END
    ELSE
      SYS EQS st "open"
      IF LAST_N == 1 THEN
        LET gate_n = 1
        LET hit = 1
        LET note_msg = "gate admit"
        LET val = "admit"
        LET val_ch = 1
      ELSE
        LET gate_n = 0
        LET miss = 1
        LET note_msg = "gate closed"
        LET val = "deny"
        LET val_ch = 1
        FAIL "gate closed"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "gate closed"
        END
      END
    END
  END
  PRINT_JSON gate_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  HASOBJ t0
  IF LAST_N == 1 THEN
    DELETEOBJ t0
  END
  CLEAR_ERR
  HASOBJ t1
  IF LAST_N == 1 THEN
    DELETEOBJ t1
  END
  CLEAR_ERR
  HASOBJ t2
  IF LAST_N == 1 THEN
    DELETEOBJ t2
  END
  CLEAR_ERR
  HASOBJ t3
  IF LAST_N == 1 THEN
    DELETEOBJ t3
  END
  CLEAR_ERR
  HASOBJ t4
  IF LAST_N == 1 THEN
    DELETEOBJ t4
  END
  CLEAR_ERR
  HASOBJ t5
  IF LAST_N == 1 THEN
    DELETEOBJ t5
  END
  CLEAR_ERR
  SYS RM p0
  SYS RM p1
  SYS RM p2
  SYS RM p3
  SYS RM p4
  SYS RM p5
  CLEAR_ERR
  LET hit = 1
  LET note_msg = "cleared"
  LET val = ""
  LET val_ch = 1
  LET meta = ""
  LET meta_ch = 1
END

# unknown action check
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "open"
LET k = k + LAST_N
SYS EQS ACTION "close"
LET k = k + LAST_N
SYS EQS ACTION "bump"
LET k = k + LAST_N
SYS EQS ACTION "status"
LET k = k + LAST_N
SYS EQS ACTION "prio"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "methods"
LET k = k + LAST_N
SYS EQS ACTION "fields"
LET k = k + LAST_N
SYS EQS ACTION "classes"
LET k = k + LAST_N
SYS EQS ACTION "delete"
LET k = k + LAST_N
SYS EQS ACTION "gate"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

# --- persist slot plate if mutated ---
IF persist == 1 THEN
  IF slot == 0 THEN
    HASOBJ t0
    IF LAST_N == 1 THEN
      GETF t0 status
      LET bag = LAST
      GETF t0 prio
      SYS STR LAST_N
      SYS PUSH bag LAST
      LET bag = LAST
      GETF t0 id
      SYS PUSH bag LAST
      LET bag = LAST
      SYS WRITE p0 bag
      CLEAR_ERR
    END
  END
  IF slot == 1 THEN
    HASOBJ t1
    IF LAST_N == 1 THEN
      GETF t1 status
      LET bag = LAST
      GETF t1 prio
      SYS STR LAST_N
      SYS PUSH bag LAST
      LET bag = LAST
      GETF t1 id
      SYS PUSH bag LAST
      LET bag = LAST
      SYS WRITE p1 bag
      CLEAR_ERR
    END
  END
  IF slot == 2 THEN
    HASOBJ t2
    IF LAST_N == 1 THEN
      GETF t2 status
      LET bag = LAST
      GETF t2 prio
      SYS STR LAST_N
      SYS PUSH bag LAST
      LET bag = LAST
      GETF t2 id
      SYS PUSH bag LAST
      LET bag = LAST
      SYS WRITE p2 bag
      CLEAR_ERR
    END
  END
  IF slot == 3 THEN
    HASOBJ t3
    IF LAST_N == 1 THEN
      GETF t3 status
      LET bag = LAST
      GETF t3 prio
      SYS STR LAST_N
      SYS PUSH bag LAST
      LET bag = LAST
      GETF t3 id
      SYS PUSH bag LAST
      LET bag = LAST
      SYS WRITE p3 bag
      CLEAR_ERR
    END
  END
  IF slot == 4 THEN
    HASOBJ t4
    IF LAST_N == 1 THEN
      GETF t4 status
      LET bag = LAST
      GETF t4 prio
      SYS STR LAST_N
      SYS PUSH bag LAST
      LET bag = LAST
      GETF t4 id
      SYS PUSH bag LAST
      LET bag = LAST
      SYS WRITE p4 bag
      CLEAR_ERR
    END
  END
  IF slot == 5 THEN
    HASOBJ t5
    IF LAST_N == 1 THEN
      GETF t5 status
      LET bag = LAST
      GETF t5 prio
      SYS STR LAST_N
      SYS PUSH bag LAST
      LET bag = LAST
      GETF t5 id
      SYS PUSH bag LAST
      LET bag = LAST
      SYS WRITE p5 bag
      CLEAR_ERR
    END
  END
  LISTOBJS Ticket
  SYS WRITE objs_path LAST
  CLEAR_ERR
END

IF val_ch > 0 THEN
  SYS WRITE val_path val
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  CLEAR_ERR
END

SYS MS
LET elapsed = MS - t0ms
LISTOBJS Ticket
LET nobjs = NOBJS

LET report = "schema=cubalc.ticket_object_board.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
