# svc_hasargany_contract_board.cubalc — HASARGANY/NEEDARGANY fleet any-of arg contract
#
# Real use: fleet intake agents admit when ANY of ARG0/ARG1/… or named ENV
# (CUBALC_CONFIG) is set — multi-source hop without N× HASARG OR chains.
# First realworld of 1380 HASARGANY (1.15.832) · HASARGALL twin for any-of.
#
#   HASARGANY names… · NEEDARGANY names… → any-present gate
#   ARGHAVE / ARGMISS bags · HASARGANY_N · index + named env
#   CSV/bag forms · soft miss sticky ERR · hard miss exit_code 0
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_hay_$$
#   ./out/cubalc run programs/realworld/svc_hasargany_contract_board.cubalc boot
#   ./out/cubalc run ... any|miss|hard|bag|env|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt HAY_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_HAY_REQUIRE
#
# Edges: CUBALC_ARG* via SYS ENV SET only (W1); NEEDARGANY miss exit 0;
#   PRINT clobber ARGHAVE; ALL vs ANY twin; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_hasargany_contract_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_hasargany_contract -- boot|any|miss|hard|bag|env|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_HAY_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "HAY_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET flag_n = 0
LET miss_n = 0
LET have_n = 0

ONEOF ACTION "boot", "any", "miss", "hard", "bag", "env", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "any" THEN
    LET op = "any"
  WHEN "miss" THEN
    LET op = "miss"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "bag" THEN
    LET op = "bag"
  WHEN "env" THEN
    LET op = "env"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-hay\",\"schema\":\"cubalc.svc_hasargany_contract.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"arg_any\",\"label\":\"hay\",\"cfg\":{\"surface\":\"HASARGANY,NEEDARGANY,ARGHAVE,ARGMISS,HASARGALL\",\"contract\":\"ARG0|ARG1|CUBALC_CONFIG any-of intake\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"arg_any\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-hay"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_hasargany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hay"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# any — partial index hit
SYS EQS op "any"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "a.txt"
  SYS ENV SET CUBALC_ARGC "1"
  HASARGANY 0 1 2
  LET sum_v = LAST_N
  LET have_n = HASARGANY_N
  LET miss_n = ARGMISS_N
  LET body = ARGHAVE
  LET stem_s = ARGMISS
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF have_n == 1 THEN
    LET score = score + 1
  END
  IF miss_n == 2 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # all present
  SYS ENV SET CUBALC_ARG0 "a.txt"
  SYS ENV SET CUBALC_ARG1 "b.txt"
  SYS ENV SET CUBALC_ARG2 "c.txt"
  SYS ENV SET CUBALC_ARGC "3"
  HASARGANY 0 1 2
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  IF HASARGANY_N == 3 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ARGMISS_N == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.contract"
  SYS HAS LAST "ARG0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "any ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "any score"
    FAIL "any score"
    CLEAR_ERR
  END
  SYS CAT "any:" have_n ":an"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n have_n score note_msg
  CLEAR_ERR
END

# miss — none present soft
SYS EQS op "miss"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV UNSET CUBALC_ARG1
  HASARGANY
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASARGANY_N == 0 THEN
    LET score = score + 1
  END
  HASARGANY 0 1 2
  LET sum_v = LAST_N
  LET miss_n = ARGMISS_N
  LET stem_s = ARGMISS
  CLEAR_ERR
  IF sum_v == 0 THEN
    LET score = score + 1
  END
  IF miss_n == 3 THEN
    LET score = score + 1
  END
  IF OK == 0 THEN
    LET score = score + 1
  END
  SYS HASLINE stem_s "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI "HASARGANY miss"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # index 1 only — 0 still miss for other gate
  SYS ENV SET CUBALC_ARG1 "only"
  SYS ENV SET CUBALC_ARGC "2"
  HASARGANY 0 2
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ARGMISS_N == 2 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "ARGMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hay"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "miss ok"
    LET admit_n = 1
    LET find_n = miss_n
  ELSE
    LET miss = 1
    LET note_msg = "miss score"
    FAIL "miss score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE miss denied"
    END
  END
  SYS CAT "miss:" miss_n ":ms"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "miss:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n miss_n score note_msg
  CLEAR_ERR
END

# hard — NEEDARGANY pass when any present + ALL contrast
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "x"
  SYS ENV SET CUBALC_ARGC "1"
  NEEDARGANY 0 1
  LET sum_v = LAST_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF HASARGANY_N == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE ARGHAVE "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASARGANY 0 1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # ALL needs both
  HASARGALL 0 1
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "intake"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:1:hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# bag — CSV / newline forms
SYS EQS op "bag"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "a"
  SYS ENV SET CUBALC_ARG1 "b"
  SYS ENV SET CUBALC_ARG2 "c"
  SYS ENV SET CUBALC_ARGC "3"
  HASARGANY "0,1,2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASARGANY_N == 3 THEN
    LET score = score + 1
  END
  HASARGANY "0
1
2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASARGANY "0,9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF HASARGANY_N == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE ARGMISS "9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "any-of"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hay"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasargany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "bag ok"
    LET admit_n = 1
    LET find_n = 3
  ELSE
    LET miss = 1
    LET note_msg = "bag score"
    FAIL "bag score"
    CLEAR_ERR
  END
  SYS CAT "bag:3:bg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "bag:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# env — named env CUBALC_CONFIG as any-of source (non-ARG index)
SYS EQS op "env"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARGC "0"
  SYS ENV UNSET CUBALC_ARG0
  SYS ENV SET CUBALC_CONFIG "cfg.json"
  HASARGANY 9 CUBALC_CONFIG
  LET sum_v = LAST_N
  LET body = ARGHAVE
  LET stem_s = ARGMISS
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF HASARGANY_N == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "CUBALC_CONFIG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE stem_s "9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # missing named env
  SYS ENV UNSET CUBALC_CONFIG
  HASARGANY CUBALC_CONFIG MISSING_ENV_XYZ
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF ARGMISS_N == 2 THEN
    LET score = score + 1
  END
  # ARG0 or CONFIG
  SYS ENV SET CUBALC_ARG0 "file.bin"
  SYS ENV SET CUBALC_ARGC "1"
  HASARGANY 0 CUBALC_CONFIG
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "CUBALC_CONFIG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "env ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "env score"
    FAIL "env score"
    CLEAR_ERR
  END
  SYS CAT "env:1:ev"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "env:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM + twin discovery
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  HASFORM "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEEDARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM HASARGANY
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "HASARGALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "intake"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasargany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "hay"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + live multi-source
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "shard.bin"
  SYS ENV SET CUBALC_ARGC "1"
  HASARGANY 0 1 CUBALC_CONFIG
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  NEEDARGANY 0 1
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "ARG0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasargany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "ARGMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · ALL vs ANY
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  SYS ENV SET CUBALC_ARG0 "only.bin"
  SYS ENV SET CUBALC_ARGC "1"
  HASARGANY 0 1 2
  LET body = ARGHAVE
  LET stem_s = ARGMISS
  LET have_n = HASARGANY_N
  LET sum_v = LAST_N
  CLEAR_ERR
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASLINE LAST "0"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "0"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF have_n == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE stem_s "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASARGALL 0 1
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "hasargany_contract"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASARGANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "any-of"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "arg_any"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" have_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " have=" have_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "hay report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
