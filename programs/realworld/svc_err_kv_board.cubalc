# svc_err_kv_board.cubalc — durable service/severity error counters via KV bag
#
# Real use: ops agent tallies per-service or per-severity error counts as
# key:val plate fields under STATE. KVINC bumps without LOOKUP+arith+KVSET
# glue; LOOKUP peels; KVSET resets; optional FREQ fold of raw event bags.
#
# Distinct from rate_budget_ledger (debit/credit budgets via SETMATCH rebuild):
# this board is pure counter plate surface (LOOKUP/KVSET/KVINC).
#
# Plate under STATE:
#   ERRKV.txt      — key:count bag (default sep :)
#   ERRKV_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_SE_ACTION):
#   list     — depth + bag dump (default)
#   seed     — WORDS of key:n tokens → bag (skip if key exists via LOOKUP)
#   loadlines— PUSH ||| raw event names then FREQ → counters (merge via KVINC)
#   bump     — KVINC NAME [delta ARG2, default 1]; insert if missing
#   set      — KVSET NAME VAL (ARG2)
#   get      — LOOKUP NAME → hit=value (NUM if possible)
#   geti     — LOOKUPI case-insensitive
#   has      — LOOKUP hit 1/0 (no value require)
#   drop     — REMOVELINE exact key:val via LOOKUP_LINE
#   clear    — empty plate
#   pin      — MOVELINE LOOKUP_I key to front
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_se_$$; mkdir -p "$CUBALC_STATE"
#   CUBALC_ARG0=seed CUBALC_ARG1='api:3 db:1 mesh:0' \
#     ./out/cubalc run -q -s programs/realworld/svc_err_kv_board.cubalc
#   CUBALC_ARG0=bump CUBALC_ARG1=api CUBALC_ARG2=2 ./out/cubalc run -q -s ...
#   CUBALC_ARG0=get CUBALC_ARG1=api ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_SE_FILE=ERRKV.txt
#   CUBALC_SE_REQUIRE=1
#   CUBALC_SE_SEP=:     (or =)
#   CUBALC_SE_DELTA=1
#
# Edges deliberately stressed:
#   LOOKUP/KVSET/KVINC sep arg must be string literal ":"|"=" — NOT a var
#     (bare IDENT SEP → unknown form; only TK_STR accepted for KVINC/KVSET;
#      LOOKUP allows bare sep only if strlen<=2)
#   LOOKUP first key wins on duplicate keys; KVINC only bumps first
#   non-numeric value → KVINC strtol → 0 then +delta (silent coerce)
#   empty key can append ":n" / "a:1:1" field
#   sep mismatch soft miss (plate : vs ENV =)
#   LOOKUP exact key — substring "err" does not hit "error"
#   LOOKUPI case fold; seed skip on existing key
#   negative delta allowed (no clamp/floor)
#   PRINT_JSON collapses bag newlines; WRITE trailing NL; soft READ
#   REQUIRE miss on get/drop/has-zero

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_err_kv_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT RFILE = "ERRKV.txt"
DEFAULT REPORT = "ERRKV_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT SEP = ":"
DEFAULT DELTA = 1
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_SE_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_SE_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_SE_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_SE_FILE" OR ""
IF LAST_N > 0 THEN
  LET RFILE = LAST
END
SYS ENV "CUBALC_SE_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_SE_SEP" OR ""
IF LAST_N > 0 THEN
  LET SEP = LAST
END
SYS ENV "CUBALC_SE_DELTA" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET DELTA = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir RFILE
LET bag_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR bag_path OR ""
LET bag = LAST
CLEAR_ERR "soft kv load"
SYS LINES bag
LET depth0 = LAST_N

LET hit = 0
LET miss = 0
LET changed = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET kv_hit = 0
LET kv_i = -1
LET kv_v = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "errkv" depth0 ACTION
  PRINT_JSON depth0 ACTION STATUS_OK
  PRINT_JSON bag
  LET note_msg = "list ok"
END

# --- seed WORDS key:n ---
SYS EQS ACTION "seed"
IF LAST_N == 1 THEN
  NOTE "action seed"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "seed needs key:n tokens"
  END
  SYS WORDS NAME
  LET toks = LAST
  EACH LINE AS t IN toks
    SYS BLANK t
    IF LAST_N == 0 THEN
      SYS BEFORE t SEP
      LET k = LAST
      SYS AFTER t SEP
      LET v = LAST
      SYS BLANK k
      IF LAST_N == 0 THEN
        SYS EQS SEP "="
        IF LAST_N == 1 THEN
          SYS LOOKUP bag k "="
        ELSE
          SYS LOOKUP bag k ":"
        END
        IF OK == 0 THEN
          SYS EQS SEP "="
          IF LAST_N == 1 THEN
            SYS KVSET bag k v "="
          ELSE
            SYS KVSET bag k v ":"
          END
          LET bag = LAST
          LET changed = 1
          LET hit = hit + 1
        ELSE
          LET miss = miss + 1
        END
        CLEAR_ERR
      END
    END
  END
  LET note_msg = "seeded"
END

# --- loadlines: raw events ||| → FREQ then merge KVINC ---
SYS EQS ACTION "loadlines"
IF LAST_N == 1 THEN
  NOTE "action loadlines"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "loadlines needs ||| events"
  END
  SYS SPLIT "|||" NAME
  LET evs = LAST
  SYS FREQ evs
  LET freq = LAST
  # merge each freq key into bag via KVINC by delta=count
  EACH LINE AS fl IN freq
    SYS BLANK fl
    IF LAST_N == 0 THEN
      SYS BEFORE fl ":"
      LET k = LAST
      SYS AFTER fl ":"
      LET vs = LAST
      SYS PREPEND "" vs
      SYS HEAD LAST
      SYS NUM
      IF OK == 1 THEN
        LET d = LAST_N
        SYS EQS SEP "="
        IF LAST_N == 1 THEN
          SYS KVINC bag k d "="
        ELSE
          SYS KVINC bag k d ":"
        END
        LET bag = LAST
        LET changed = 1
        LET hit = hit + 1
      END
      CLEAR_ERR
    END
  END
  LET note_msg = "freq merged"
END

# --- bump KVINC ---
SYS EQS ACTION "bump"
IF LAST_N == 1 THEN
  NOTE "action bump"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "bump needs key"
  END
  SYS BLANK A2
  IF LAST_N == 0 THEN
    SYS PREPEND "" A2
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET DELTA = LAST_N
    END
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS KVINC bag NAME DELTA "="
  ELSE
    SYS KVINC bag NAME DELTA ":"
  END
  LET bag = LAST
  LET kv_hit = KVINC_HIT
  LET kv_i = KVINC_I
  LET kv_v = KVINC_V
  LET val_n = kv_v
  SYS STR kv_v
  LET val_s = LAST
  LET changed = 1
  LET hit = 1
  IF kv_hit == 0 THEN
    LET note_msg = "bumped insert"
  ELSE
    LET note_msg = "bumped"
  END
  PRINT_JSON NAME val_s kv_hit kv_v
END

# --- set KVSET ---
SYS EQS ACTION "set"
IF LAST_N == 1 THEN
  NOTE "action set"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "set needs key"
  END
  SYS BLANK A2
  IF LAST_N == 1 THEN
    EXIT 2 "set needs value"
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS KVSET bag NAME A2 "="
  ELSE
    SYS KVSET bag NAME A2 ":"
  END
  LET bag = LAST
  LET kv_hit = KVSET_HIT
  LET kv_i = KVSET_I
  LET val_s = A2
  SYS PREPEND "" A2
  SYS HEAD LAST
  SYS NUM
  IF OK == 1 THEN
    LET val_n = LAST_N
  END
  CLEAR_ERR
  LET changed = 1
  LET hit = 1
  IF kv_hit == 0 THEN
    LET note_msg = "set insert"
  ELSE
    LET note_msg = "set ok"
  END
  PRINT_JSON NAME val_s kv_hit
END

# --- get LOOKUP ---
SYS EQS ACTION "get"
IF LAST_N == 1 THEN
  NOTE "action get"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "get needs key"
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS LOOKUP bag NAME "="
  ELSE
    SYS LOOKUP bag NAME ":"
  END
  IF OK == 0 THEN
    LET miss = 1
    LET hit = 0
    LET note_msg = "get miss"
    FAIL "get miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "get miss"
    END
  ELSE
    LET val_s = LAST
    LET kv_i = LOOKUP_I
    LET kv_hit = LOOKUP_N
    SYS PREPEND "" val_s
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET val_n = LAST_N
      LET hit = val_n
    ELSE
      LET hit = 1
    END
    CLEAR_ERR
    LET note_msg = "get ok"
    PRINT_JSON NAME val_s val_n
  END
END

# --- geti LOOKUPI ---
SYS EQS ACTION "geti"
IF LAST_N == 1 THEN
  NOTE "action geti"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "geti needs key"
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS LOOKUPI bag NAME "="
  ELSE
    SYS LOOKUPI bag NAME ":"
  END
  IF OK == 0 THEN
    LET miss = 1
    LET hit = 0
    LET note_msg = "geti miss"
    FAIL "geti miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "geti miss"
    END
  ELSE
    LET val_s = LAST
    LET kv_i = LOOKUP_I
    SYS PREPEND "" val_s
    SYS HEAD LAST
    SYS NUM
    IF OK == 1 THEN
      LET val_n = LAST_N
      LET hit = val_n
    ELSE
      LET hit = 1
    END
    CLEAR_ERR
    LET note_msg = "geti ok"
    PRINT_JSON NAME val_s
  END
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs key"
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS LOOKUP bag NAME "="
  ELSE
    SYS LOOKUP bag NAME ":"
  END
  IF OK == 0 THEN
    LET hit = 0
    LET miss = 1
    LET note_msg = "has no"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has miss"
    END
  ELSE
    LET hit = 1
    LET val_s = LAST
    LET note_msg = "has yes"
    CLEAR_ERR
  END
END

# --- drop via LOOKUP_LINE + REMOVELINE ---
SYS EQS ACTION "drop"
IF LAST_N == 1 THEN
  NOTE "action drop"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "drop needs key"
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS LOOKUP bag NAME "="
  ELSE
    SYS LOOKUP bag NAME ":"
  END
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "drop miss"
    FAIL "drop miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "drop miss"
    END
  ELSE
    LET line = LOOKUP_LINE
    SYS REMOVELINE bag line
    LET bag = LAST
    LET changed = 1
    LET hit = 1
    LET note_msg = "dropped"
    CLEAR_ERR
  END
END

# --- pin MOVELINE LOOKUP_I to 0 ---
SYS EQS ACTION "pin"
IF LAST_N == 1 THEN
  NOTE "action pin"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "pin needs key"
  END
  SYS EQS SEP "="
  IF LAST_N == 1 THEN
    SYS LOOKUP bag NAME "="
  ELSE
    SYS LOOKUP bag NAME ":"
  END
  IF OK == 0 THEN
    LET miss = 1
    LET note_msg = "pin miss"
    FAIL "pin miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "pin miss"
    END
  ELSE
    LET kv_i = LOOKUP_I
    CLEAR_ERR
    SYS MOVELINE bag kv_i 0
    IF LAST_N == 0 THEN
      LET miss = 1
      LET note_msg = "pin moveline miss"
      FAIL "pin moveline"
      CLEAR_ERR
    ELSE
      LET bag = LAST
      LET changed = 1
      LET hit = 1
      LET note_msg = "pinned"
    END
  END
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET bag = ""
  LET changed = 1
  LET hit = 1
  LET note_msg = "cleared"
END

# unknown?
SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "seed"
LET k = k + LAST_N
SYS EQS ACTION "loadlines"
LET k = k + LAST_N
SYS EQS ACTION "bump"
LET k = k + LAST_N
SYS EQS ACTION "set"
LET k = k + LAST_N
SYS EQS ACTION "get"
LET k = k + LAST_N
SYS EQS ACTION "geti"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "drop"
LET k = k + LAST_N
SYS EQS ACTION "pin"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF changed > 0 THEN
  SYS WRITE bag_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "kv write failed"
  END
  CLEAR_ERR
END

SYS LINES bag
LET depth1 = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.errkv.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "val"
LET report = LAST
SYS PUSH report val_s
LET report = LAST
SYS PUSH report "val_n"
LET report = LAST
SYS STR val_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "kv_hit"
LET report = LAST
SYS STR kv_hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "kv_i"
LET report = LAST
SYS STR kv_i
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "kv_v"
LET report = LAST
SYS STR kv_v
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth1"
LET report = LAST
SYS STR depth1
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS WRITE report_path report

STATUS
PRINT "errkv" ACTION hit miss depth1
PRINT_JSON ACTION hit miss depth1 elapsed STATUS_OK
PASS "errkv tick"
NOTE "svc_err_kv_board: done"
CLEAR_ERR
EXIT 0 "errkv ok"
