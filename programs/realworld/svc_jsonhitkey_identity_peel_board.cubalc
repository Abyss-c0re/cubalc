# svc_jsonhitkey_identity_peel_board.cubalc — JSONHITKEY/JSONFIRST identity peel
#
# Real use: multi-vendor agent intake plates use alternate identity/status
# keys (id|uuid|agent_id|name · status|state|legacy_status|phase). Agents
# need *which* candidate key hit — not only any-of presence (JSONHASANY).
# First realworld of SYS JSONHITKEY/JSONFIRST (1.15.959 · MI 959). Soft
# dual of JSONHASANY that names the hit; pairs with REQUIRE JSONHASANY
# (MI 958) for hard any-of gate.
#
#   JSONHITKEY · JSONFIRST · JHITKEY · JSONHITKEY_N · JSONHITKEY_HIT
#   OF bag · null/false still present · EQS-branch peel (var key miss)
#   JSONHASANY · HASPANY · NEEDPANY soft duals
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_jhk_$$
#   ./out/cubalc run programs/realworld/svc_jsonhitkey_identity_peel_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt JHK_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_JHK_REQUIRE
#
# Edges: candidate order (not plate key order); all-miss soft; empty
#   candidates; OF bag; null/false present; var-key peel fail (W904)

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# first present identity key among id|uuid|agent_id|name
FN resolve_id_key
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JSONHITKEY plate "id" "uuid" "agent_id" "name"
  IF LAST_N == 1 THEN
    LET hit_key = LAST
    LET hit_idx = JSONHITKEY_N
    LET ok_v = 1
  ELSE
    LET hit_key = ""
    LET hit_idx = 0
    LET ok_v = 0
  END
END

# first present status key among status|state|legacy_status|phase
FN resolve_status_key
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JSONHITKEY plate "status" "state" "legacy_status" "phase"
  IF LAST_N == 1 THEN
    LET hit_key = LAST
    LET hit_idx = JSONHITKEY_N
    LET ok_v = 1
  ELSE
    LET hit_key = ""
    LET hit_idx = 0
    LET ok_v = 0
  END
END

# JSONFIRST alias path
FN resolve_status_first
  LET hit_key = ""
  LET ok_v = 0
  SYS JSONFIRST plate "status" "state" "legacy_status" "phase"
  IF LAST_N == 1 THEN
    LET hit_key = LAST
    LET ok_v = 1
  END
END

# OF-bag candidate list for status keys
FN resolve_status_ofbag
  LET hit_key = ""
  LET hit_idx = 0
  LET ok_v = 0
  SYS JOIN "" "phase\nstate\nlegacy_status\nstatus"
  LET kbag = LAST
  SYS JSONHITKEY plate OF kbag
  IF LAST_N == 1 THEN
    LET hit_key = LAST
    LET hit_idx = JSONHITKEY_N
    LET ok_v = 1
  END
END

# peel status value — literal keys only (var-key SYS JSON fails W904)
FN peel_status_val
  LET val = ""
  LET ok_v = 0
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    SYS JSON "status" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS hit_key "state"
  IF LAST_N == 1 THEN
    SYS JSON "state" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    SYS JSON "legacy_status" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS hit_key "phase"
  IF LAST_N == 1 THEN
    SYS JSON "phase" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
END

# peel identity value via EQS branch
FN peel_id_val
  LET val = ""
  LET ok_v = 0
  SYS EQS hit_key "id"
  IF LAST_N == 1 THEN
    SYS JSON "id" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS hit_key "uuid"
  IF LAST_N == 1 THEN
    SYS JSON "uuid" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS hit_key "agent_id"
  IF LAST_N == 1 THEN
    SYS JSON "agent_id" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
  SYS EQS hit_key "name"
  IF LAST_N == 1 THEN
    SYS JSON "name" FROM plate
    LET val = LAST
    LET ok_v = 1
  END
  CLEAR_ERR
END

# admit only when identity key present
FN admit_identity
  LET state = "deny-no-id"
  LET ok_v = 0
  CALL resolve_id_key
  IF ok_v == 1 THEN
    LET state = "admit"
    LET ok_v = 1
  END
END

# soft any-of presence twin (no which-key)
FN soft_any_status
  LET ok_v = 0
  SYS JSONHASANY plate "status" "state" "legacy_status" "phase"
  IF LAST_N == 1 THEN
    LET ok_v = 1
  END
END

NOTE "svc_jsonhitkey_identity_peel_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_jsonhitkey_identity_peel -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_JHK_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "JHK_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "plates"
LET plate_dir = LAST
SYS JOIN plate_dir "intake.json"
LET intake_path = LAST
SYS JOIN plate_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET plate = ""
LET hit_key = ""
LET hit_idx = 0
LET val = ""
LET state = ""
LET saved = 0
LET kbag = ""

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-jhk\",\"schema\":\"cubalc.svc_jsonhitkey_identity_peel.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"jhk\",\"want_filter\":\"jsonhitkey_identity_peel\",\"cfg\":{\"surface\":\"JSONHITKEY,JSONFIRST,JHITKEY,JSONHITKEY_N,JSONHITKEY_HIT,JSONHASANY\",\"contract\":\"first-present identity/status key peel for multi-vendor intake\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  SYS MKDIR plate_dir
  CLEAR_ERR
  # vendor plate: only legacy_status + agent_id (no status/id)
  SYS WRITE intake_path "{\"agent_id\":\"w-9\",\"legacy_status\":\"ok\",\"code\":0}"
  SYS WRITE peer_path "{\"uuid\":\"u-1\",\"state\":\"ready\",\"n\":1}"
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL resolve_id_key
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jhk"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      SYS EQS hit_key "agent_id"
      IF LAST_N == 1 THEN
        IF hit_idx == 3 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET score = 1
          LET find_n = hit_idx
        ELSE
          LET miss = 1
          LET note_msg = "boot idx"
          FAIL "boot idx"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot key"
        FAIL "boot key"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot id"
      FAIL "boot id"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — core 10/10 identity + status hitkey semantics
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # 1-2: agent_id wins over missing id/uuid
  LET plate = "{\"agent_id\":\"w-9\",\"legacy_status\":\"ok\",\"code\":0}"
  CALL resolve_id_key
  SYS EQS hit_key "agent_id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  # 3: status key falls to legacy_status
  CALL resolve_status_key
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  # 5: candidate order prefers status over legacy when both present
  LET plate = "{\"legacy_status\":\"ok\",\"status\":\"ready\"}"
  CALL resolve_status_key
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 1 THEN
    LET score = score + 1
  END
  # 7: JSONFIRST alias
  CALL resolve_status_first
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 8: all-miss soft
  LET plate = "{\"n\":1}"
  CALL resolve_id_key
  IF ok_v == 0 THEN
    LET score = score + 1
  END
  IF JSONHITKEY_HIT == 0 THEN
    LET score = score + 1
  END
  # 10: uuid path
  LET plate = "{\"uuid\":\"u-1\",\"name\":\"peer\"}"
  CALL resolve_id_key
  SYS EQS hit_key "uuid"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — miss · admit · any dual · OF bag · null present
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  # 1 deny no id
  LET plate = "{\"n\":0}"
  CALL admit_identity
  SYS EQS state "deny-no-id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 2 admit with name only
  LET plate = "{\"name\":\"solo\"}"
  CALL admit_identity
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "name"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 4 JSONHASANY soft twin without which-key
  LET plate = "{\"legacy_status\":\"ok\"}"
  CALL soft_any_status
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  CALL resolve_status_key
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 6 OF bag prefers phase when listed first and present
  LET plate = "{\"phase\":\"beta\",\"status\":\"ok\"}"
  CALL resolve_status_ofbag
  SYS EQS hit_key "phase"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 1 THEN
    LET score = score + 1
  END
  # 8 null key still present
  LET plate = "{\"gone\":null,\"flag\":false}"
  SYS JSONHITKEY plate "nope" "gone" "flag"
  SYS EQS LAST "gone"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 9 false still present
  SYS JSONHITKEY plate "flag"
  SYS EQS LAST "flag"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # 10 empty candidate list → miss
  SYS JSONHITKEY plate
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# peel — disk plates + value peel after hitkey
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE intake_path "{\"agent_id\":\"w-9\",\"legacy_status\":\"ok\",\"code\":0}"
  SYS WRITE peer_path "{\"uuid\":\"u-1\",\"state\":\"ready\",\"n\":1}"
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL resolve_id_key
  SYS EQS hit_key "agent_id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_id_val
  SYS EQS val "w-9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resolve_status_key
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # peer plate
  SYS READ peer_path
  LET plate = LAST
  CLEAR_ERR
  CALL resolve_id_key
  SYS EQS hit_key "uuid"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_id_val
  SYS EQS val "u-1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resolve_status_key
  SYS EQS hit_key "state"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # W904: var-key peel fails — document by soft probe
  LET hit_key = "legacy_status"
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  SYS JSON hit_key FROM plate
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # literal peel still works
  SYS JSON "legacy_status" FROM plate
  SYS EQS LAST "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# scale — admit ladder + HASPANY dual + multi vendor
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"id\":\"i-1\",\"status\":\"up\"}"
  CALL admit_identity
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS hit_key "id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 1 THEN
    LET score = score + 1
  END
  LET plate = "{}"
  CALL admit_identity
  SYS EQS state "deny-no-id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"agent_id\":\"fleet-2\",\"phase\":\"gamma\"}"
  CALL resolve_status_key
  SYS EQS hit_key "phase"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "gamma"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # HASPANY soft plate any-of
  HASPANY "status" "legacy_status" "phase" FROM plate
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # NEEDPANY hard-soft when present
  NEEDPANY "status" "phase" FROM plate
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "JSONHITKEY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — capability surface
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "JSONHITKEY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONFIRST"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JHITKEY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHASANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "HASPANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "NEEDPANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "JSONHITKEY_N"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  HASFORM "JSONWHICH"
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "jsonhitkey_identity_peel"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "JSONHITKEY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit identity + optional REQUIRE JSONHASANY
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET plate = "{\"uuid\":\"gate-1\",\"status\":\"live\"}"
  CALL admit_identity
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resolve_status_key
  SYS EQS hit_key "status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "live"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET plate = "{\"n\":9}"
  CALL admit_identity
  SYS EQS state "deny-no-id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # soft JSONHASANY miss
  SYS JSONHASANY plate "id" "uuid" "agent_id" "name"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # hard REQUIRE succeeds when any present
  LET plate = "{\"agent_id\":\"g2\"}"
  REQUIRE JSONHASANY plate "id" "uuid" "agent_id" "name"
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL admit_identity
  SYS EQS state "admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF require_hit >= 0 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "first-present"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score state note_msg
  CLEAR_ERR
END

# probe — disk · WRITE NL · NUM shuttle · STRTO
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  SYS MKDIR plate_dir
  CLEAR_ERR
  SYS WRITE intake_path "{\"agent_id\":\"probe-1\",\"legacy_status\":\"ok\"}"
  CLEAR_ERR
  SYS READ intake_path
  LET plate = LAST
  CLEAR_ERR
  CALL resolve_id_key
  SYS EQS hit_key "agent_id"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF hit_idx == 3 THEN
    LET score = score + 1
  END
  LET saved = hit_idx
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  SYS NUM
  IF OK == 1 THEN
    IF LAST_N == 3 THEN
      LET score = score + 1
    END
  END
  CLEAR_ERR
  SYS CAT "hitkey=" hit_key " idx=" hit_idx
  LET body = LAST
  CLEAR_ERR
  SYS WRITE report_path body
  CLEAR_ERR
  SYS READ report_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "hitkey="
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "jhk_probe"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "jhk_probe"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE meta_path "no_nl_end"
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "no_nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL resolve_status_key
  SYS EQS hit_key "legacy_status"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL peel_status_val
  SYS EQS val "ok"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET saved = 1
  PRINT_JSON saved score
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-jhk"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = saved
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score saved note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-jhk\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit ",\"hit_key\":\"" hit_key "\",\"hit_idx\":" hit_idx "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " score=" score " note=" note_msg " admit=" admit_n " key=" hit_key
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

STATUS
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_jsonhitkey_identity_peel_board: done"
PASS
