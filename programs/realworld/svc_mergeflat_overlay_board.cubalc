# svc_mergeflat_overlay_board.cubalc — MERGEFLAT deep leaf nest overlay
#
# Real use: peer config deep-sync without FLATKV+UNFLAT or shallow MERGEP
# that replaces whole cfg objects. First realworld of proof 1216 MERGEFLAT.
#
#   MERGEFLAT|OVERLAYFLAT [FROM base] overlay
#   LAST_N = MERGEFLAT_N leaves written · MERGEFLAT_SRC/FROM
#   keeps unmentioned base leaves; nested leaf overlay not object replace
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_smf_$$
#   ./out/cubalc run programs/realworld/svc_mergeflat_overlay_board.cubalc boot
#   ./out/cubalc run ... merge|session|empty|shallow|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SMF_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SMF_REQUIRE
#
# Edges: PEER overlay; FROM SESSION PATCH; empty no-op; shallow leaf keep;
#   OVERLAYFLAT alias; soft; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_mergeflat_overlay_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_mergeflat_overlay -- boot|merge|session|empty|shallow|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeM"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SMF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SMF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "merge", "session", "empty", "shallow", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "merge" THEN
    LET op = "merge"
  WHEN "session" THEN
    LET op = "session"
  WHEN "empty" THEN
    LET op = "empty"
  WHEN "shallow" THEN
    LET op = "shallow"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-mergeflat\",\"schema\":\"cubalc.svc_mergeflat_overlay.v1\",\"site\":\"" host_s "\",\"cfg\":{\"meta\":{\"role\":\"worker\",\"x\":1},\"port\":8080},\"n\":3,\"label\":\"mergeflat\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  # PEER must NOT carry agent/schema identity keys — MERGEFLAT overlays all leaves
  SYS CAT "{\"cfg\":{\"meta\":{\"role\":\"leader\",\"zone\":\"A\"},\"port\":9090},\"ok\":true,\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "cfg.meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# merge — overlay PEER onto agent PLATE
SYS EQS op "merge"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # reseed base values for idempotent run
  SETP "cfg.meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.port" "8080"
  CLEAR_ERR
  SETP "n" "3"
  CLEAR_ERR
  SETP "cfg.meta.x" "1"
  CLEAR_ERR
  MERGEFLAT PEER
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n >= 4 THEN
    LET score = score + 1
  END
  IF MERGEFLAT_N == find_n THEN
    LET score = score + 1
  END
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "n"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "9090"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.zone"
  SYS EQS LAST "A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.x"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "ok"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # identity must survive overlay (peer has no agent key)
  GETP "agent"
  SYS EQS LAST "svc-mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "merge ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "merge score"
    FAIL "merge score"
    CLEAR_ERR
  END
  SYS CAT "merge:" find_n ":mg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "merge:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# session — MERGEFLAT FROM base patch
SYS EQS op "session"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET SESSION = "{\"a\":{\"b\":1},\"keep\":9}"
  LET PATCH = "{\"a\":{\"b\":2,\"c\":3}}"
  MERGEFLAT FROM SESSION PATCH
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF MERGEFLAT_FROM == 1 THEN
    LET score = score + 1
  END
  SYS EQS MERGEFLAT_SRC "SESSION"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET PLATE = SESSION
  GETP "a.b"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "a.c"
  SYS EQS LAST "3"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "keep"
  SYS EQS LAST "9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore agent
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "session ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "session score"
    FAIL "session score"
    CLEAR_ERR
  END
  SYS CAT "session:" find_n ":ss"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "session:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# empty — no-op overlay
SYS EQS op "empty"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GETP "label"
  LET body = LAST
  CLEAR_ERR
  MERGEFLAT "{}"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF MERGEFLAT_N == 0 THEN
    LET score = score + 1
  END
  GETP "label"
  SYS EQS LAST body
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "empty ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "empty score"
    FAIL "empty score"
    CLEAR_ERR
  END
  SYS CAT "empty:0:em"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "empty:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# shallow — leaf merge keeps sibling cfg.a when overlay only cfg.b
SYS EQS op "shallow"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET PLATE = "{\"cfg\":{\"a\":1,\"b\":2},\"label\":\"sh\"}"
  LET O = "{\"cfg\":{\"b\":9}}"
  MERGEFLAT O
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.a"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.b"
  SYS EQS LAST "9"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sh"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # restore
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "shallow ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "shallow score"
    FAIL "shallow score"
    CLEAR_ERR
  END
  SYS CAT "shallow:" find_n ":sw"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "shallow:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — missing overlay plate name soft?
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # empty bag already tested; ghost plate var
  LET GHOST = ""
  MERGEFLAT GHOST
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  MERGEFLAT "{}"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "n"
  # n may have been changed by prior merge action — just presence
  IF LAST_N >= 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — admit when role is leader after merge
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  MERGEFLAT PEER
  CLEAR_ERR
  GETP "cfg.meta.role"
  SYS EQS LAST "leader"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "9090"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_mergeflat_overlay"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "site"
  SYS EQS LAST host_s
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — OVERLAYFLAT
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET PLATE = "{\"k\":0,\"label\":\"ov\"}"
  OVERLAYFLAT "{\"k\":1,\"m\":2}"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF OVERLAYFLAT_N == 2 THEN
    LET score = score + 1
  END
  GETP "k"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "m"
  SYS EQS LAST "2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "ov"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" find_n ":as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — edges
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  # reseed worker then partial overlay
  SETP "cfg.meta.role" "worker"
  CLEAR_ERR
  SETP "cfg.port" "8080"
  CLEAR_ERR
  SETP "cfg.meta.x" "1"
  CLEAR_ERR
  LET PATCH = "{\"cfg\":{\"meta\":{\"role\":\"canary\"}}}"
  MERGEFLAT PATCH
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n >= 1 THEN
    LET score = score + 1
  END
  GETP "cfg.meta.role"
  SYS EQS LAST "canary"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.x"
  SYS EQS LAST "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.port"
  SYS EQS LAST "8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # overlay only new top-level
  MERGEFLAT "{\"extra\":7}"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  GETP "extra"
  SYS EQS LAST "7"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "mergeflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_mergeflat_overlay.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_mergeflat_overlay_board: end"
