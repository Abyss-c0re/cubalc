# mesh_sumnp_score_board.cubalc — SUMNP/TOPKEYP mesh load/score plate aggregates
#
# Real use: mesh ops roll up numeric load/score fields on agent PLATE and peer
# error counters without SYS JSONSUMN/JSONTOPKEY or VALS+SUM glue. TOPKEYP
# names the hottest metric; AVGNP mean; empty soft. First realworld of proof
# 1159 SUMNP/MAXNP/MINNP/AVGNP/TOPKEYP/BOTKEYP (MEANINGFUL 618).
#
#   SUMNP / SUMNP FROM PEER
#   TOPKEYP / BOTKEYP FROM PEER
#   AVGNP · MAXNP · MINNP · TOTALP/MAXKEYP aliases
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_mss_$$
#   ./out/cubalc run programs/realworld/mesh_sumnp_score_board.cubalc boot
#   ./out/cubalc run ... sum|top|avg|peer|empty|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt MSS_REPORT.txt agent.json peer.json
# Env: HOST_S BUDGET_N CUBALC_MSS_REQUIRE
#
# Edges:
#   non-numeric keys skipped; empty soft 0; LAST_N not knobs;
#   WRITE omit NL; soft empty bag; NUM shuttle; budget gate

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "mesh_sumnp_score_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "mesh_sumnp_score -- boot|sum|top|avg|peer|empty|gate|probe|soft|list -- [--host=H] [--budget=N]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT BUDGET_N = "50"
GETFLAG budget|b OR ENV BUDGET_N OR BUDGET_N
SYS NUM
LET budget_n = LAST_N
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_MSS_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "MSS_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET top_key = ""

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "sum", "top", "avg", "peer", "empty", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "sum" THEN
    LET op = "sum"
  WHEN "top" THEN
    LET op = "top"
  WHEN "avg" THEN
    LET op = "avg"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "empty" THEN
    LET op = "empty"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s budget_n
  CLEAR_ERR
END

# boot — load scores on plate + peer error counters
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "agent" "score-ctl" "cpu" 10 "mem" 2 "io" 8 "label" "mesh" "schema" "cubalc.mesh_sumnp.v1"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS JSONOBJ "agent" "hive-peer" "host" host_s "warn" 3 "error" 9 "info" 1 "schema" "cubalc.mesh_sumnp.v1"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  SUMNP
  LET take_n = LAST_N
  CLEAR_ERR
  TOPKEYP
  LET top_key = LAST
  CLEAR_ERR
  SYS EQS top_key "cpu"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SUMNP FROM PEER
  LET has_n = LAST_N
  CLEAR_ERR
  IF take_n == 20 THEN
    IF peel_hit == 1 THEN
      IF has_n == 13 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET created = 1
        LET load_hit = 1
        SYS CAT "boot:" host_s ":bt"
        LET row = LAST
        CLEAR_ERR
        SYS GREPV "boot:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot peer sum"
        FAIL "boot peer sum"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot topkey"
      FAIL "boot topkey"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot sum"
    FAIL "boot sum"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit note_msg
  CLEAR_ERR
END

# sum — SUMNP plate total load
SYS EQS op "sum"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SUMNP
  LET take_n = LAST_N
  CLEAR_ERR
  IF take_n == 20 THEN
    LET hit = 1
    LET note_msg = "sum ok"
    LET admit_n = 1
    LET has_n = 1
    LET peel_hit = 1
    LET load_hit = 1
  ELSE
    LET miss = 1
    LET note_msg = "sum bad"
    FAIL "sum bad"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "sum:" w_s ":sm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "sum:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n note_msg
  CLEAR_ERR
END

# top — TOPKEYP hottest metric
SYS EQS op "top"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  TOPKEYP
  LET top_key = LAST
  CLEAR_ERR
  SYS EQS top_key "cpu"
  LET has_n = LAST_N
  CLEAR_ERR
  BOTKEYP
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "mem"
  LET peel_hit = LAST_N
  CLEAR_ERR
  MAXNP
  LET take_n = LAST_N
  CLEAR_ERR
  MINNP
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF take_n == 10 THEN
        IF load_hit == 2 THEN
          LET hit = 1
          LET note_msg = "top ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "top min"
          FAIL "top min"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "top max"
        FAIL "top max"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "top bot"
      FAIL "top bot"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "top key"
    FAIL "top key"
    CLEAR_ERR
  END
  SYS CAT "top:" top_key ":tp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "top:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit take_n load_hit note_msg
  CLEAR_ERR
END

# avg — AVGNP mean of numeric fields
SYS EQS op "avg"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  AVGNP
  LET take_n = LAST_N
  CLEAR_ERR
  IF take_n == 6 THEN
    LET hit = 1
    LET note_msg = "avg ok"
    LET admit_n = 1
    LET has_n = 1
    LET peel_hit = 1
    LET load_hit = 1
  ELSE
    LET miss = 1
    LET note_msg = "avg bad"
    FAIL "avg bad"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "avg:" w_s ":av"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "avg:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n note_msg
  CLEAR_ERR
END

# peer — peer error rollup
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SUMNP FROM PEER
  LET take_n = LAST_N
  CLEAR_ERR
  TOPKEYP FROM PEER
  LET top_key = LAST
  CLEAR_ERR
  SYS EQS top_key "error"
  LET has_n = LAST_N
  CLEAR_ERR
  BOTKEYP FROM PEER
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "info"
  LET peel_hit = LAST_N
  CLEAR_ERR
  AVGNP FROM PEER
  LET load_hit = LAST_N
  CLEAR_ERR
  IF take_n == 13 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 4 THEN
          LET hit = 1
          LET note_msg = "peer ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "peer avg"
          FAIL "peer avg"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer bot"
        FAIL "peer bot"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer top"
      FAIL "peer top"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer sum"
    FAIL "peer sum"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "peer:" top_key ":" w_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# empty — soft empty plate sum
SYS EQS op "empty"
IF LAST_N == 1 THEN
  LET known = 1
  LET empty_obj = "{}"
  SUMNP FROM empty_obj
  LET take_n = LAST_N
  CLEAR_ERR
  TOPKEYP FROM empty_obj
  LET body = LAST
  CLEAR_ERR
  SYS EMPTY body
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF take_n == 0 THEN
    IF peel_hit == 1 THEN
      LET hit = 1
      LET note_msg = "empty ok"
      LET admit_n = 0
      LET has_n = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "empty top not empty"
      FAIL "empty top not empty"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "empty sum nonzero"
    FAIL "empty sum nonzero"
    CLEAR_ERR
  END
  SYS CAT "empty:0:em"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "empty:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit note_msg
  CLEAR_ERR
END

# gate — total load under budget
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  SUMNP
  LET take_n = LAST_N
  CLEAR_ERR
  SUMNP FROM PEER
  LET has_n = LAST_N
  CLEAR_ERR
  # combined load check: plate sum under budget
  IF take_n <= budget_n THEN
    IF take_n >= 1 THEN
      LET hit = 1
      LET note_msg = "gate ok"
      LET admit_n = 1
      LET peel_hit = 1
      LET load_hit = 1
    ELSE
      LET miss = 1
      LET note_msg = "gate zero"
      FAIL "gate zero"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate over budget"
    FAIL "gate over budget"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate over budget"
    END
  END
  SYS STR take_n
  LET w_s = LAST
  SYS STR budget_n
  LET d_s = LAST
  CLEAR_ERR
  SYS CAT "gate:" w_s ":" d_s ":ga"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n budget_n has_n note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — aliases TOTALP/MAXKEYP; strings skipped; lit plate
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  TOTALP FROM PEER
  LET take_n = LAST_N
  CLEAR_ERR
  MAXKEYP FROM PEER
  LET top_key = LAST
  CLEAR_ERR
  SYS EQS top_key "error"
  LET has_n = LAST_N
  CLEAR_ERR
  MINKEYP FROM PEER
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "info"
  LET peel_hit = LAST_N
  CLEAR_ERR
  MEANP
  LET load_hit = LAST_N
  CLEAR_ERR
  # label string must not affect sum (still 20)
  SUMNP
  LET miss_n = LAST_N
  CLEAR_ERR
  IF take_n == 13 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 6 THEN
          IF miss_n == 20 THEN
            LET hit = 1
            LET note_msg = "probe ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "probe sum skip"
            FAIL "probe sum skip"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe mean"
          FAIL "probe mean"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe minkey"
        FAIL "probe minkey"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe maxkey"
      FAIL "probe maxkey"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe total"
    FAIL "probe total"
    CLEAR_ERR
  END
  PRINT_JSON take_n has_n peel_hit load_hit miss_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
SYS STR admit_n
LET out = LAST
CLEAR_ERR
SYS CAT "schema=cubalc.mesh_sumnp.v1 op=" op " hit=" w_s " miss=" d_s " admit=" out " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "mss op=" op " hit=" w_s " miss=" d_s " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n peel_hit has_n load_hit miss_n created budget_n note_msg
