# svc_grepflat_scrub_board.cubalc — GREPFLAT nest path:value leaf filter scrub
#
# Real use: before mesh share, inventory secret/token leaves and emit a scrubbed
# path:value bag (invert) without FLATKV+SYS GREP glue. Proof 1214 GREPFLAT.
#
#   GREPFLAT|GREPVFLAT|GREPFLATI|KEEPFLAT [FROM plate] needle
#   LAST = path:value bag · LAST_N = GREPFLAT_N count
#   GREPFLAT_NEEDLE · GREPFLAT_INVERT · GREPFLAT_ICASE · GREPFLAT_SRC/FROM
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sgf_$$
#   ./out/cubalc run programs/realworld/svc_grepflat_scrub_board.cubalc boot
#   ./out/cubalc run ... secrets|scrub|keep|peer|soft|gate|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SGF_REPORT.txt LEAVES.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SGF_REQUIRE
#
# Edges: secret keep; invert scrub; KEEPFLAT alias; FROM PEER; soft ghost;
#   GREPFLATI case; substring tok; empty needle all; WRITE NL; REQUIRE softens

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_grepflat_scrub_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_grepflat_scrub -- boot|secrets|scrub|keep|peer|soft|gate|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeG"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SGF_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "LEAVES.txt"
LET leaves_file = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SGF_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""

ONEOF ACTION "boot", "secrets", "scrub", "keep", "peer", "soft", "gate", "alias", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "secrets" THEN
    LET op = "secrets"
  WHEN "scrub" THEN
    LET op = "scrub"
  WHEN "keep" THEN
    LET op = "keep"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-grepflat\",\"schema\":\"cubalc.svc_grepflat_scrub.v1\",\"site\":\"" host_s "\",\"host\":\"h1\",\"cfg\":{\"meta\":{\"role\":\"worker\",\"zone\":\"A\"},\"port\":\"8080\",\"secret\":\"s3cr3t\"},\"other\":{\"host\":\"h2\",\"token\":\"tok1\"},\"label\":\"grepflat\"}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"schema\":\"cubalc.svc_grepflat_scrub.v1\",\"a\":{\"status\":\"ok\",\"secret\":\"p1\"},\"b\":{\"status\":\"ok\"},\"c\":{\"secret\":\"p2\",\"status\":\"fail\"},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "cfg.secret"
  SYS EQS LAST "s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "other.token"
  SYS EQS LAST "tok1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.meta.role"
  SYS EQS LAST "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# secrets — GREPFLAT keep secret leaves
SYS EQS op "secrets"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPFLAT "secret"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  IF GREPFLAT_N == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "cfg.secret:s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS GREPFLAT_NEEDLE "secret"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # token is not secret needle
  SYS HASLINE body "other.token:tok1"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "secrets ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "secrets score"
    FAIL "secrets score"
    CLEAR_ERR
  END
  SYS CAT "secrets:" find_n ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "secrets:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# scrub — GREPVFLAT drop secret leaves (share-safe bag)
SYS EQS op "scrub"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPVFLAT "secret"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF GREPFLAT_INVERT == 1 THEN
    LET score = score + 1
  END
  IF find_n > 5 THEN
    LET score = score + 1
  END
  SYS HASLINE body "cfg.port:8080"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "other.token:tok1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "cfg.secret:s3cr3t"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # site is stable; top-level host may be rewritten by plate_session (W*)
  SYS HASLINE body "site:cubeG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "cfg.meta.zone:A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # plate still holds secret (filter is pure; no DEL)
  GETP "cfg.secret"
  SYS EQS LAST "s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "scrub ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "scrub score"
    FAIL "scrub score"
    CLEAR_ERR
  END
  SYS CAT "scrub:" find_n ":sb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scrub:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# keep — KEEPFLAT token path filter
SYS EQS op "keep"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  KEEPFLAT "token"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  IF KEEPFLAT_N == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "other.token:tok1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "cfg.secret:s3cr3t"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring tok also hits token
  GREPFLAT "tok"
  LET admit_n = LAST_N
  LET row = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE row "other.token:tok1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "keep ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "keep score"
    FAIL "keep score"
    CLEAR_ERR
  END
  SYS CAT "keep:" find_n ":kp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "keep:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# peer — multi-plate secret inventory
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPFLAT FROM PEER "secret"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  IF GREPFLAT_FROM == 1 THEN
    LET score = score + 1
  END
  SYS EQS GREPFLAT_SRC "PEER"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "a.secret:p1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE body "c.secret:p2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # b has no secret
  SYS HASLINE body "b.status:ok"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # PLATE unchanged
  GETP "agent"
  SYS EQS LAST "svc-grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "peer ok"
    LET admit_n = find_n
  ELSE
    LET miss = 1
    LET note_msg = "peer score"
    FAIL "peer score"
    CLEAR_ERR
  END
  SYS CAT "peer:" find_n ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# soft — ghost miss + single non-matching
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPFLAT "ghostpath"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 0 THEN
    LET score = score + 1
  END
  IF GREPFLAT_N == 0 THEN
    LET score = score + 1
  END
  SYS EQS body ""
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GREPFLAT "zzzz_nope"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# gate — admit when scrub bag has no secret lines (share gate)
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPVFLAT "secret"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "cfg.secret:s3cr3t"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # gate fails if secrets still listed by keep
  GREPFLAT "secret"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  # admit when invert clean AND we still know secrets exist (inventory dual)
  IF find_n > 0 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "svc_grepflat_scrub"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET admit_n = 1
    LET note_msg = "gate ok"
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# alias — GREPFLATI case-insensitive
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPFLATI "SECRET"
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  IF GREPFLAT_ICASE == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE body "cfg.secret:s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # case-sensitive miss on uppercase path needle vs lower path
  GREPFLAT "SECRET"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "agent"
  SYS EQS LAST "svc-grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 6 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:" find_n ":al"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

# probe — empty needle + substring + false friends
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  GREPFLAT ""
  LET find_n = LAST_N
  LET body = LAST
  CLEAR_ERR
  IF find_n > 5 THEN
    LET score = score + 1
  END
  SYS HASLINE body "cfg.secret:s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GREPFLAT "nope"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  # path substring: "sec" matches secret
  GREPFLAT "sec"
  LET admit_n = LAST_N
  LET row = LAST
  CLEAR_ERR
  IF admit_n == 1 THEN
    LET score = score + 1
  END
  SYS HASLINE row "cfg.secret:s3cr3t"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # value-side false friend: needle does not match values, only paths
  GREPFLAT "s3cr3t"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF admit_n == 0 THEN
    LET score = score + 1
  END
  GETP "schema"
  SYS HAS LAST "grepflat"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE leaves_file body
  CLEAR_ERR
  IF score == 7 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" find_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n find_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_grepflat_scrub.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_grepflat_scrub_board: end"
