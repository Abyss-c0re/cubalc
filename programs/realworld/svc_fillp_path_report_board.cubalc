# svc_fillp_path_report_board.cubalc — FILLP path nest report + TYPEP kind gate
#
# Real use: on-call agents expand nest plate fields into status digests and
# report files via {{freq.error}} path slots without GETP+CAT glue; FILLPKEYS
# discovers template contracts; TYPEP admits field kinds; FILLPFILE materializes.
# First realworld of proof 1196 fillp_path (+ TYPEP path kind).
#
#   FILLP|NEEDFILLP path {{a.b}} · FILLPKEYS · FILLP_MISS / FILLP_MISS_KEYS
#   FILLP FROM PEER · slash {{freq/error}} · FILLPFILE
#   TYPEP path → num|str|missing|…
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sfp_$$
#   ./out/cubalc run programs/realworld/svc_fillp_path_report_board.cubalc boot
#   ./out/cubalc run ... fill|keys|soft|strict|peer|type|report|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SFP_REPORT.txt agent.json peer.json out_report.txt
# Env: HOST_S ROLE_S CUBALC_SFP_REQUIRE
#
# Edges:
#   soft miss empty slot; STRICT miss; false-friend path keys; WRITE NL;
#   NUM softens REQUIRE; EXIT shell (W7); FILLP specials vs LAST_N

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_fillp_path_report_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_fillp_path_report -- boot|fill|keys|soft|strict|peer|type|report|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeX"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SFP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SFP_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "out_report.txt"
LET out_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR
LET bag_n = 0

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET body = ""
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET soft_ok = 0
LET gate_ok = 0
LET path_val = ""
LET dig_host = ""
LET dig_err = ""
LET dig_p99 = ""
LET tmpl = ""

ONEOF ACTION "boot", "fill", "keys", "soft", "strict", "peer", "type", "report", "list", "ls", "probe", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "fill" THEN
    LET op = "fill"
  WHEN "keys" THEN
    LET op = "keys"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "strict" THEN
    LET op = "strict"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "type" THEN
    LET op = "type"
  WHEN "report" THEN
    LET op = "report"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — seed nested health + peer plates
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-fillp\",\"schema\":\"cubalc.svc_fillp_path_report.v1\",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"n\":1,\"freq\":{\"error\":3,\"warn\":7,\"info\":12},\"lat\":{\"p50\":40,\"p99\":180},\"flags\":{\"live\":1,\"debug\":0},\"meta\":{\"role\":\"" role_s "\",\"zone\":\"east\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"agent\":\"hive-peer\",\"host\":\"" host_s "\",\"schema\":\"cubalc.svc_fillp_path_report.v1\",\"meta\":{\"role\":\"edge\",\"n\":9},\"freq\":{\"error\":1,\"warn\":2},\"tag\":\"t\"}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS JOIN state_dir "agent.json"
  LET agent_path = LAST
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  FILLP "host={{host}} err={{freq.error}} p99={{lat.p99}}"
  LET body = LAST
  LET take_n = LAST_N
  CLEAR_ERR
  SYS HAS body "err=3"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "p99=180"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS body host_s
  LET has_n = LAST_N
  CLEAR_ERR
  TYPEP "freq.error"
  SYS EQS LAST "num"
  LET soft_ok = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF has_n == 1 THEN
        IF soft_ok == 1 THEN
          LET hit = 1
          LET note_msg = "boot ok"
          LET admit_n = 1
          LET miss_n = 0
        ELSE
          LET miss = 1
          LET note_msg = "boot type num"
          FAIL "boot type num"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "boot host slot"
        FAIL "boot host slot"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot p99 slot"
      FAIL "boot p99 slot"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot err slot"
    FAIL "boot err slot"
    CLEAR_ERR
  END
  SYS CAT "boot:" host_s ":bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok note_msg
  CLEAR_ERR
END

# fill — multi path template expand + slash alias
SYS EQS op "fill"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FILLP "host={{host}} err={{freq.error}} warn={{freq.warn}} p99={{lat.p99}} role={{role}}"
  LET body = LAST
  CLEAR_ERR
  SYS EQS body body
  LET take_n = 1
  CLEAR_ERR
  SYS HAS body "err=3"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "warn=7"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "p99=180"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS HAS body "role="
  LET has_n = LAST_N
  CLEAR_ERR
  # slash path alias
  FILLP "e={{freq/error}} p={{lat/p50}}"
  LET dig_err = LAST
  CLEAR_ERR
  SYS HAS dig_err "e=3"
  LET gate_ok = LAST_N
  CLEAR_ERR
  SYS HAS dig_err "p=40"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "host"
  LET dig_host = LAST
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "fill ok"
              LET admit_n = 1
              LET path_val = body
            ELSE
              LET miss = 1
              LET note_msg = "fill slash p50"
              FAIL "fill slash p50"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "fill slash error"
            FAIL "fill slash error"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "fill role"
          FAIL "fill role"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "fill p99"
        FAIL "fill p99"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "fill warn"
      FAIL "fill warn"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "fill err"
    FAIL "fill err"
    CLEAR_ERR
  END
  SYS CAT "fill:" dig_host ":fl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "fill:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n dig_host peel_hit soft_ok gate_ok note_msg
  CLEAR_ERR
END

# keys — FILLPKEYS discovers path slots (contract inventory)
SYS EQS op "keys"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FILLPKEYS "a={{host}} b={{freq.error}} c={{lat.p99}} d={{meta.zone}}"
  LET body = LAST
  CLEAR_ERR
  SYS HASLINE body "host"
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HASLINE body "freq.error"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "lat.p99"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HASLINE body "meta.zone"
  LET soft_ok = LAST_N
  CLEAR_ERR
  # false friend: substring must not invent slot
  SYS HASLINE body "freq.err"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF soft_ok == 1 THEN
          IF miss_n == 0 THEN
            LET hit = 1
            LET note_msg = "keys ok"
            LET admit_n = 1
            LET take_n = 4
          ELSE
            LET miss = 1
            LET note_msg = "keys false err"
            FAIL "keys false err"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "keys zone"
          FAIL "keys zone"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "keys p99"
        FAIL "keys p99"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "keys freq.error"
      FAIL "keys freq.error"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "keys host"
    FAIL "keys host"
    CLEAR_ERR
  END
  SYS CAT "keys:4:ky"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "keys:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit soft_ok miss_n note_msg
  CLEAR_ERR
END

# soft — miss path soft empty + MISS_KEYS bag
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FILLP "x={{freq.crit}} y={{host}} z={{ghost.x}}"
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "y="
  LET has_n = LAST_N
  CLEAR_ERR
  SYS HAS body host_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  # empty miss slots: x= and z= with nothing between (avoid HASLINE bag-name W341)
  SYS HAS body "x= "
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "z="
  LET soft_ok = LAST_N
  CLEAR_ERR
  # y=host present between empty miss slots (body like "x= y=cubeX z=")
  SYS STARTS body "x= "
  LET gate_ok = LAST_N
  CLEAR_ERR
  SYS CAT "y=" host_s
  LET dig_host = LAST
  CLEAR_ERR
  SYS HAS body dig_host
  LET admit_n = LAST_N
  CLEAR_ERR
  # false friend path presence
  HASP "freq.err"
  LET path_val = LAST_N
  CLEAR_ERR
  # z= present (ghost.x empty slot)
  SYS HAS body "z="
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF soft_ok == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              IF path_val == 0 THEN
                IF miss_n == 1 THEN
                  LET hit = 1
                  LET note_msg = "soft ok"
                  LET admit_n = 1
                  LET take_n = 2
                ELSE
                  LET miss = 1
                  LET note_msg = "soft z miss"
                  FAIL "soft z miss"
                  CLEAR_ERR
                END
              ELSE
                LET miss = 1
                LET note_msg = "soft false err"
                FAIL "soft false err"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "soft y host"
              FAIL "soft y host"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "soft starts empty x"
            FAIL "soft starts empty x"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "soft z slot"
          FAIL "soft z slot"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "soft x empty"
        FAIL "soft x empty"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "soft host val"
      FAIL "soft host val"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "soft y"
    FAIL "soft y"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:miss2:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n gate_ok admit_n peel_hit path_val note_msg
  CLEAR_ERR
END

# strict — NEEDFILLP / FILLP STRICT pass; soft miss path without STRICT
SYS EQS op "strict"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FILLP STRICT "err={{freq.error}} host={{host}} p99={{lat.p99}}"
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "err=3"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "p99=180"
  LET load_hit = LAST_N
  CLEAR_ERR
  # soft twin: miss stays OK without STRICT
  FILLP "x={{freq.crit}} h={{host}}"
  LET dig_err = LAST
  CLEAR_ERR
  SYS HAS dig_err host_s
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS HAS dig_err "x= "
  LET has_n = LAST_N
  CLEAR_ERR
  # NEEDFILLP alias
  NEEDFILLP "n={{n}} role={{role}}"
  LET gate_ok = LAST_N
  CLEAR_ERR
  SYS EQS LAST LAST
  LET admit_n = 1
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF OK == 1 THEN
            LET hit = 1
            LET note_msg = "strict ok"
            LET admit_n = 1
            LET take_n = 3
          ELSE
            LET miss = 1
            LET note_msg = "strict needfill ok"
            FAIL "strict needfill ok"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "strict soft empty"
          FAIL "strict soft empty"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "strict soft host"
        FAIL "strict soft host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "strict p99"
      FAIL "strict p99"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "strict err"
    FAIL "strict err"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE strict denied"
    END
  END
  SYS CAT "strict:ok:st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "strict:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit soft_ok has_n note_msg
  CLEAR_ERR
END

# peer — FILLP FROM PEER path nest
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  FILLP FROM PEER "role={{meta.role}} n={{meta.n}} err={{freq.error}} host={{host}}"
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "role=edge"
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "n=9"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS body "err=1"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS HAS body host_s
  LET has_n = LAST_N
  CLEAR_ERR
  # plate local FILLP still sees worker role
  FILLP "role={{role}}"
  LET dig_err = LAST
  CLEAR_ERR
  SYS HAS dig_err role_s
  LET gate_ok = LAST_N
  CLEAR_ERR
  NEEDP FROM PEER "meta.role" "freq.error"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET admit_n = 0
  END
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "peer ok"
              LET admit_n = 1
              LET take_n = 4
            ELSE
              LET miss = 1
              LET note_msg = "peer needp"
              FAIL "peer needp"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "peer plate role"
            FAIL "peer plate role"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "peer host"
          FAIL "peer host"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer err"
        FAIL "peer err"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer n"
      FAIL "peer n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer role"
    FAIL "peer role"
    CLEAR_ERR
  END
  SYS CAT "peer:edge:pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit soft_ok gate_ok note_msg
  CLEAR_ERR
END

# type — TYPEP path kinds admit report fields
SYS EQS op "type"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  TYPEP "freq.error"
  SYS EQS LAST "num"
  LET peel_hit = LAST_N
  CLEAR_ERR
  TYPEP "host"
  SYS EQS LAST "str"
  LET load_hit = LAST_N
  CLEAR_ERR
  TYPEP "flags.live"
  SYS EQS LAST "num"
  LET soft_ok = LAST_N
  CLEAR_ERR
  TYPEP "freq"
  SYS EQS LAST "obj"
  LET has_n = LAST_N
  CLEAR_ERR
  TYPEP "freq.crit"
  SYS EQS LAST "missing"
  LET gate_ok = LAST_N
  CLEAR_ERR
  TYPEP "lat/p99"
  SYS EQS LAST "num"
  LET admit_n = LAST_N
  CLEAR_ERR
  # false friend type on non-path
  TYPEP "freq.err"
  SYS EQS LAST "missing"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              IF miss_n == 1 THEN
                LET hit = 1
                LET note_msg = "type ok"
                LET admit_n = 1
                LET take_n = 6
              ELSE
                LET miss = 1
                LET note_msg = "type false err"
                FAIL "type false err"
                CLEAR_ERR
              END
            ELSE
              LET miss = 1
              LET note_msg = "type slash p99"
              FAIL "type slash p99"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "type crit missing"
            FAIL "type crit missing"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "type freq obj"
          FAIL "type freq obj"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "type flags.live"
        FAIL "type flags.live"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "type host str"
      FAIL "type host str"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "type error num"
    FAIL "type error num"
    CLEAR_ERR
  END
  SYS CAT "type:kinds:tp"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "type:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit load_hit gate_ok miss_n note_msg
  CLEAR_ERR
END

# report — FILLPFILE materialize + STATUS digest row
SYS EQS op "report"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  NEEDP "host" "freq.error" "lat.p99"
  LET peel_hit = LAST_N
  CLEAR_ERR
  IF OK == 0 THEN
    LET peel_hit = 0
  END
  CLEAR_ERR
  # write template file then FILLPFILE
  SYS JOIN state_dir "tmpl_report.txt"
  LET tmpl = LAST
  CLEAR_ERR
  SYS CAT "REPORT host={{host}} err={{freq.error}} p99={{lat.p99}} role={{role}} zone={{meta.zone}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE tmpl body
  CLEAR_ERR
  FILLPFILE tmpl out_path
  CLEAR_ERR
  SYS READ OR out_path OR ""
  LET dig_err = LAST
  CLEAR_ERR
  SYS HAS dig_err "err=3"
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS HAS dig_err "p99=180"
  LET soft_ok = LAST_N
  CLEAR_ERR
  SYS HAS dig_err "zone=east"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "host"
  LET dig_host = LAST
  CLEAR_ERR
  # peer one-liner side channel
  FILLP FROM PEER "peer_err={{freq.error}} peer_role={{meta.role}}"
  LET path_val = LAST
  CLEAR_ERR
  SYS HAS path_val "peer_err=1"
  LET gate_ok = LAST_N
  CLEAR_ERR
  SYS HAS path_val "peer_role=edge"
  LET admit_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF load_hit == 1 THEN
      IF soft_ok == 1 THEN
        IF has_n == 1 THEN
          IF gate_ok == 1 THEN
            IF admit_n == 1 THEN
              LET hit = 1
              LET note_msg = "report ok"
              LET admit_n = 1
              LET take_n = 1
              SYS CAT "report:" dig_host ":err=3:p99=180:rp"
              LET row = LAST
              CLEAR_ERR
            ELSE
              LET miss = 1
              LET note_msg = "report peer role"
              FAIL "report peer role"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "report peer err"
            FAIL "report peer err"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "report zone"
          FAIL "report zone"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "report p99"
        FAIL "report p99"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "report err"
      FAIL "report err"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "report need"
    FAIL "report need"
    CLEAR_ERR
  END
  IF hit == 1 THEN
    SYS GREPV "report:" bag
    LET bag = LAST
    CLEAR_ERR
    SYS PUSH bag row
    LET bag = LAST
    LET bag_ch = 1
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n dig_host load_hit soft_ok has_n note_msg
  CLEAR_ERR
END

# probe — empty bag, SRC defaults, incomplete brace, specials smoke
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET body = ""
  SYS LINES body
  LET load_hit = LAST_N
  CLEAR_ERR
  FILLP "n={{n}}"
  LET dig_err = LAST
  CLEAR_ERR
  SYS EQS dig_err "n=1"
  LET peel_hit = LAST_N
  CLEAR_ERR
  # incomplete brace stays literal-ish soft
  FILLP "raw={{host"
  LET soft_ok = LAST_N
  CLEAR_ERR
  FILLP "ok={{host}}"
  SYS HAS LAST host_s
  LET has_n = LAST_N
  CLEAR_ERR
  TYPEP "agent"
  SYS EQS LAST "str"
  LET gate_ok = LAST_N
  CLEAR_ERR
  FILLPKEYS "{{freq.error}}"
  LET w_s = LAST
  CLEAR_ERR
  SYS HASLINE w_s "freq.error"
  LET admit_n = LAST_N
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "fillp_path"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF load_hit == 0 THEN
    IF peel_hit == 1 THEN
      IF has_n == 1 THEN
        IF gate_ok == 1 THEN
          IF admit_n == 1 THEN
            IF miss_n == 1 THEN
              LET hit = 1
              LET note_msg = "probe ok"
              LET admit_n = 1
              LET take_n = 1
            ELSE
              LET miss = 1
              LET note_msg = "probe schema"
              FAIL "probe schema"
              CLEAR_ERR
            END
          ELSE
            LET miss = 1
            LET note_msg = "probe keys path"
            FAIL "probe keys path"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe type agent"
          FAIL "probe type agent"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe host fill"
        FAIL "probe host fill"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe n"
      FAIL "probe n"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe empty bag"
    FAIL "probe empty bag"
    CLEAR_ERR
  END
  SYS CAT "probe:fillp:pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit has_n gate_ok soft_ok note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
CLEAR_ERR
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "hit=" w_s " miss=" d_s " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_fillp_path_report.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " has=" has_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

PRINT_JSON op hit miss admit_n bag_n note_msg
NOTE "svc_fillp_path_report_board: end"
