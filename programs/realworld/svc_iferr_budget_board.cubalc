# svc_iferr_budget_board.cubalc — IFERR/IFOK error budget + INC/DEC/SWAP counters
#
# Real use: fleet agents tally soft probe FAILs vs PASS into an error budget
# without LET n = n + 1 glue, then swap primary/standby labels on budget trip.
# First realworld of 1451 IFERR/IFOK/HASERR/HASOK/WHENERR (1.15.906+ · MI 913)
# + 1452 INC/DEC/SWAP/BUMP/XCHG (MI 914). Distinct from retry_budget_* (plate
# math) and svc_try_catch_recover (CATCH arm) — this board is *status-branch
# counters + dual-buffer swap* for admit gates.
#
#   FAIL/PASS then IFERR|WHENERR / IFOK [ELSE] … END
#   HASERR / HASOK probes · CATCH-free recovery via CLEAR_ERR in IFERR
#   INC|BUMP var [BY n] · DEC var [n] · SWAP|XCHG a [WITH] b
#   INC_N · DEC_N · SWAP_N
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_ieb_$$
#   ./out/cubalc run programs/realworld/svc_iferr_budget_board.cubalc boot
#   ./out/cubalc run ... pass|soft|ok|swap|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt IEB_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_IEB_REQUIRE
#
# Edges: IFERR nested in IF steals END (W821 class) — FN wrap + CALL;
#   INC creates missing var; DEC below 0?; SWAP strings/mixed; PRINT clobber;
#   TOGGLE/CLAMP var forms not in 1.15.907 yet (1453 proof ahead of binary)

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

# --- helpers (IFERR/IFOK must not sit inside IF — W821 framing) ---

FN budget_fail
  FAIL "probe down"
  IFERR
    INC errs
    CLEAR_ERR
    PASS
  END
  RET errs
END

FN budget_ok
  PASS
  IFOK
    INC oks
    BUMP hits
  END
  RET oks
END

FN budget_else
  FAIL "branch"
  IFOK
    LET path = "ok"
  ELSE
    LET path = "err"
    INC errs
    CLEAR_ERR
    PASS
  END
  RET 1
END

FN whenerr_inc
  FAIL "z"
  WHENERR
    INC errs BY 2
    CLEAR_ERR
    PASS
  END
  RET errs
END

FN iferr_skip_on_ok
  PASS
  LET recovered = 0
  IFERR
    LET recovered = 1
  END
  RET recovered
END

FN ifok_skip_on_err
  FAIL "soft"
  LET good = 0
  IFOK
    LET good = 1
  END
  CLEAR_ERR
  PASS
  RET good
END

FN dec_errs n
  DEC errs n
  RET errs
END

FN swap_roles
  SWAP primary WITH standby
  RET SWAP_N
END

FN xchg_buf
  XCHG buf_a buf_b
  RET SWAP_N
END

FN has_status_probes
  PASS
  HASOK
  LET ho = LAST_N
  HASERR
  LET he = LAST_N
  RET ho
END

NOTE "svc_iferr_budget_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_iferr_budget -- boot|pass|soft|ok|swap|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_IEB_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "IEB_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET errs = 0
LET oks = 0
LET hits = 0
LET path = ""
LET primary = "A"
LET standby = "B"
LET buf_a = 1
LET buf_b = 2
LET recovered = 0
LET good = 0

ONEOF ACTION "boot", "pass", "soft", "ok", "swap", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "ok" THEN
    LET op = "ok"
  WHEN "swap" THEN
    LET op = "swap"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-ieb\",\"schema\":\"cubalc.svc_iferr_budget.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"ieb\",\"want_filter\":\"iferr_budget\",\"cfg\":{\"surface\":\"IFERR,IFOK,WHENERR,HASERR,HASOK,INC,DEC,BUMP,SWAP,XCHG,INC_N,SWAP_N\",\"contract\":\"soft-status error budget counters + role swap without LET glue\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  LET errs = 0
  LET oks = 0
  CALL budget_ok
  LET ok_v = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ieb"
  IF LAST_N == 1 THEN
    IF ok_v == 1 THEN
      IF oks == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET score = 1
        LET find_n = oks
      ELSE
        LET miss = 1
        LET note_msg = "boot oks"
        FAIL "boot oks"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot ret"
      FAIL "boot ret"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oks errs note_msg
  CLEAR_ERR
END

# pass — IFOK path · INC/BUMP · IFERR skip · HASOK
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET errs = 0
  LET oks = 0
  LET hits = 0
  CALL budget_ok
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF oks == 1 THEN
    LET score = score + 1
  END
  IF hits == 1 THEN
    LET score = score + 1
  END
  CALL budget_ok
  CLEAR_ERR
  IF oks == 2 THEN
    LET score = score + 1
  END
  IF hits == 2 THEN
    LET score = score + 1
  END
  CALL iferr_skip_on_ok
  LET recovered = LAST_N
  CLEAR_ERR
  IF recovered == 0 THEN
    LET score = score + 1
  END
  CALL has_status_probes
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  INC oks BY 3
  CLEAR_ERR
  IF oks == 5 THEN
    LET score = score + 1
  END
  DEC oks 2
  CLEAR_ERR
  IF oks == 3 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iferr_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = oks
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score oks hits note_msg
  CLEAR_ERR
END

# soft — IFERR/WHENERR tally · IFOK ELSE · DEC
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET errs = 0
  LET oks = 0
  CALL budget_fail
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  IF errs == 1 THEN
    LET score = score + 1
  END
  CALL budget_fail
  CLEAR_ERR
  IF errs == 2 THEN
    LET score = score + 1
  END
  CALL whenerr_inc
  CLEAR_ERR
  IF errs == 4 THEN
    LET score = score + 1
  END
  CALL budget_else
  CLEAR_ERR
  SYS EQS path "err"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF errs == 5 THEN
    LET score = score + 1
  END
  CALL ifok_skip_on_err
  LET good = LAST_N
  CLEAR_ERR
  IF good == 0 THEN
    LET score = score + 1
  END
  CALL dec_errs 2
  CLEAR_ERR
  IF errs == 3 THEN
    LET score = score + 1
  END
  DEC errs
  CLEAR_ERR
  IF errs == 2 THEN
    LET score = score + 1
  END
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = errs
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score errs path note_msg
  CLEAR_ERR
END

# ok — IFOK multi · HASERR/HASOK · INC create
SYS EQS op "ok"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET oks = 0
  LET hits = 0
  CALL budget_ok
  CLEAR_ERR
  IF oks == 1 THEN
    LET score = score + 1
  END
  IF hits == 1 THEN
    LET score = score + 1
  END
  PASS
  HASOK
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASERR
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  FAIL "temp"
  HASERR
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASOK
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  PASS
  CLEAR_ERR
  # INC creates fresh var
  INC fresh_cnt
  CLEAR_ERR
  IF fresh_cnt == 1 THEN
    LET score = score + 1
  END
  INC fresh_cnt BY 4
  CLEAR_ERR
  IF fresh_cnt == 5 THEN
    LET score = score + 1
  END
  BUMP fresh_cnt
  CLEAR_ERR
  IF fresh_cnt == 6 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "HASOK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "ok ok"
    LET admit_n = 1
    LET find_n = fresh_cnt
  ELSE
    LET miss = 1
    LET note_msg = "ok score"
    FAIL "ok score"
    CLEAR_ERR
  END
  SYS CAT "ok:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "ok:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fresh_cnt note_msg
  CLEAR_ERR
END

# swap — SWAP/XCHG dual buffers · string roles
SYS EQS op "swap"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET primary = "A"
  LET standby = "B"
  LET buf_a = 10
  LET buf_b = 20
  CALL swap_roles
  LET ok_v = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  END
  SYS EQS primary "B"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS standby "A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL swap_roles
  CLEAR_ERR
  SYS EQS primary "A"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL xchg_buf
  CLEAR_ERR
  IF buf_a == 20 THEN
    LET score = score + 1
  END
  IF buf_b == 10 THEN
    LET score = score + 1
  END
  LET n = 7
  LET m = "hi"
  SWAP n m
  CLEAR_ERR
  SYS EQS n "hi"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF m == 7 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "SWAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "XCHG"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "swap ok"
    LET admit_n = 1
    LET find_n = buf_a
  ELSE
    LET miss = 1
    LET note_msg = "swap score"
    FAIL "swap score"
    CLEAR_ERR
  END
  SYS CAT "swap:" score ":sw"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "swap:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score primary standby note_msg
  CLEAR_ERR
END

# form — HASFORM surface
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "IFERR"
  LET ok_v = LAST_N
  CLEAR_ERR
  HASFORM "IFOK"
  LET errs = LAST_N
  CLEAR_ERR
  HASFORM "HASERR"
  LET oks = LAST_N
  CLEAR_ERR
  HASFORM "HASOK"
  LET hits = LAST_N
  CLEAR_ERR
  IF ok_v == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF errs == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF oks == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  IF hits == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  HASFORM "INC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "DEC"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SWAP"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "WHENERR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  ELSE
    LET score = score + 1
  END
  CLEAR_ERR
  # TOGGLE not in runtime yet (1453 ahead)
  HASFORM "TOGGLE"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iferr_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — budget pipeline + REQUIRE
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET errs = 0
  LET oks = 0
  LET hits = 0
  CALL budget_fail
  CLEAR_ERR
  IF errs == 1 THEN
    LET score = score + 1
  END
  CALL budget_ok
  CLEAR_ERR
  IF oks == 1 THEN
    LET score = score + 1
  END
  CALL budget_else
  CLEAR_ERR
  SYS EQS path "err"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL swap_roles
  CLEAR_ERR
  SYS EQS primary "B"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL has_status_probes
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-ieb"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "iferr_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = errs
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score errs oks note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · WRITE NL
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET errs = 0
  CALL budget_ok
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF oks >= 1 THEN
    LET score = score + 1
  END
  LET body = "keep-me"
  CLEAR_ERR
  SYS EQS LAST "cleared"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "iferr_budget"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HAS body "try_catch_recover"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS WRITE val_path "probe-nl"
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "probe-nl"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  CALL budget_fail
  IF errs == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  INC fresh2
  IF fresh2 == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 8 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = errs
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " errs=" errs " oks=" oks " hits=" hits " primary=" primary
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "ieb report op=" op " hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

