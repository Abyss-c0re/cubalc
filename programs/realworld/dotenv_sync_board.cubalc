# dotenv_sync_board.cubalc — durable .env plate load + FSYNC flush
#
# Real use: agents materialize KEY=VAL config plates, fsync for multi-agent
# durability, then DOTENV into process env (no shell source/sync):
#   WRITEATOMIC / WRITE  — plate body
#   FSYNC / SYNCFILE     — durable flush after write
#   DOTENV / LOADENV     — load KEY=VAL into process env
#   ENV / UNSETENV       — probe / cleanup keys
#   MODE / CHMOD         — optional private plate lockdown
# Distinct from env_template_board (SUBSTENV templates) and kv_config_loader
# (in-plate KV only): this board is *durable envfile write + load + key gate*.
#
# Plate under STATE:
#   ACTIVE.txt     — path of .env plate
#   VAL.txt        — last loaded count / env value
#   META.txt       — key:val sample bag
#   DOTENV_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_DE_ACTION):
#   list      — plate (default)
#   pick      — ACTIVE = ARG1 path
#   put       — WRITEATOMIC ACTIVE ARG1 body + FSYNC
#   load      — DOTENV ACTIVE → VAL = n keys
#   get       — ENV ARG1 → VAL (same-process only after load)
#   need      — ENV ARG1; soft miss empty; REQUIRE→2
#   gate      — DOTENV then need ARG1 in one process (durable config ready)
#   lock      — CHMOD ACTIVE 0600
#   probe     — STAT ACTIVE
#   fsync     — FSYNC ACTIVE only
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_de_$$
#   CUBALC_ARG0=pick CUBALC_ARG1=$CUBALC_STATE/app.env ...
#   CUBALC_ARG0=put CUBALC_ARG1=$'ROLE=worker\nPORT=7700\n' ...
#   CUBALC_ARG0=load ...
#   CUBALC_ARG0=get CUBALC_ARG1=ROLE ...
#   CUBALC_ARG0=need CUBALC_ARG1=PORT ...
#
# Env: CUBALC_DE_REQUIRE=1
#
# Edges:
#   DOTENV skip comments/bad lines; FSYNC miss path; ENV empty soft
#   export/quote forms; WRITE NL; REQUIRE; NUM; CHMOD string var

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "dotenv_sync_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT AFILE = "ACTIVE.txt"
DEFAULT VFILE = "VAL.txt"
DEFAULT MFILE = "META.txt"
DEFAULT REPORT = "DOTENV_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_DE_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_DE_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_DE_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_DE_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir AFILE
LET active_meta = LAST
SYS JOIN state_dir VFILE
LET val_path = LAST
SYS JOIN state_dir MFILE
LET meta_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR active_meta OR ""
LET active = LAST
CLEAR_ERR
SYS READ OR val_path OR ""
LET val = LAST
CLEAR_ERR
SYS READ OR meta_path OR ""
LET meta = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET active_ch = 0
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET load_n = 0
LET skip_n = 0
LET fsync_n = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "dotenv" ACTION
  PRINT_JSON ACTION STATUS_OK
  PRINT_JSON active
  PRINT_JSON val
  PRINT_JSON meta
  LET note_msg = "list ok"
END

# --- pick ---
SYS EQS ACTION "pick"
IF LAST_N == 1 THEN
  NOTE "action pick"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "pick needs path"
  END
  LET active = NAME
  LET active_ch = 1
  LET hit = 1
  LET note_msg = "pick ok"
  PRINT_JSON active
END

# --- put WRITEATOMIC + FSYNC ---
SYS EQS ACTION "put"
IF LAST_N == 1 THEN
  NOTE "action put"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "put no active"
    FAIL "put no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "put no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      EXIT 2 "put needs body"
    END
    SYS WRITEATOMIC active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "put write fail"
      FAIL "put write fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "put write fail"
      END
    ELSE
      SYS FSYNC active
      IF OK == 0 THEN
        LET miss = 1
        LET fsync_n = FSYNC_N
        LET note_msg = "put fsync fail"
        FAIL "put fsync fail"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "put fsync fail"
        END
      ELSE
        LET fsync_n = FSYNC_N
        LET val = NAME
        LET val_ch = 1
        LET hit = 1
        SYS STR fsync_n
        SYS CAT "fsync:" LAST
        LET meta = LAST
        SYS CAT "path:" active
        SYS PUSH meta LAST
        LET meta = LAST
        LET meta_ch = 1
        LET note_msg = "put ok"
      END
    END
  END
  PRINT_JSON fsync_n
  CLEAR_ERR
END

# --- load DOTENV ---
SYS EQS ACTION "load"
IF LAST_N == 1 THEN
  NOTE "action load"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "load no active"
    FAIL "load no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "load no active"
    END
  ELSE
    SYS DOTENV active
    IF OK == 0 THEN
      LET miss = 1
      LET load_n = 0
      LET skip_n = 0
      LET note_msg = "load fail"
      FAIL "load fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "load fail"
      END
    ELSE
      LET load_n = DOTENV_N
      LET skip_n = DOTENV_SKIP
      SYS STR load_n
      LET val = LAST
      LET val_ch = 1
      LET hit = 1
      SYS STR load_n
      SYS CAT "n:" LAST
      LET meta = LAST
      SYS STR skip_n
      SYS CAT "skip:" LAST
      SYS PUSH meta LAST
      LET meta = LAST
      SYS CAT "path:" active
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
      LET note_msg = "load ok"
    END
  END
  PRINT_JSON load_n skip_n
  CLEAR_ERR
END

# --- get ENV ---
SYS EQS ACTION "get"
IF LAST_N == 1 THEN
  NOTE "action get"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "get needs key"
  END
  SYS ENV NAME OR ""
  LET val = LAST
  LET val_ch = 1
  SYS BLANK val
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "get empty"
    FAIL "get empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "get empty"
    END
  ELSE
    LET hit = 1
    LET note_msg = "get ok"
  END
  SYS CAT "key:" NAME
  LET meta = LAST
  SYS PUSH meta "val"
  LET meta = LAST
  SYS PUSH meta val
  LET meta = LAST
  LET meta_ch = 1
  PRINT_JSON val
  CLEAR_ERR
END

# --- need ENV hard-ish ---
SYS EQS ACTION "need"
IF LAST_N == 1 THEN
  NOTE "action need"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "need needs key"
  END
  SYS ENV NAME OR ""
  LET val = LAST
  LET val_ch = 1
  SYS BLANK val
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "need miss"
    FAIL "need miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "need miss"
    END
  ELSE
    LET hit = 1
    LET note_msg = "need ok"
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- gate: load + need key same process ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "gate no active"
    FAIL "gate no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      EXIT 2 "gate needs key"
    END
    SYS DOTENV active
    IF OK == 0 THEN
      LET miss = 1
      LET load_n = 0
      LET note_msg = "gate load fail"
      FAIL "gate load fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "gate load fail"
      END
    ELSE
      LET load_n = DOTENV_N
      LET skip_n = DOTENV_SKIP
      SYS ENV NAME OR ""
      LET val = LAST
      LET val_ch = 1
      SYS BLANK val
      IF LAST_N == 1 THEN
        LET miss = 1
        LET note_msg = "gate key miss"
        FAIL "gate key miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "gate key miss"
        END
      ELSE
        LET hit = 1
        LET note_msg = "gate ok"
      END
      SYS STR load_n
      SYS CAT "n:" LAST
      LET meta = LAST
      SYS STR skip_n
      SYS CAT "skip:" LAST
      SYS PUSH meta LAST
      LET meta = LAST
      SYS CAT "key:" NAME
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON load_n skip_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- lock CHMOD 0600 ---
SYS EQS ACTION "lock"
IF LAST_N == 1 THEN
  NOTE "action lock"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "lock no active"
    FAIL "lock no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "lock no active"
    END
  ELSE
    LET mode_s = "0600"
    SYS CHMOD active mode_s
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "lock fail"
      FAIL "lock fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "lock fail"
      END
    ELSE
      SYS MODE active
      LET val = LAST
      LET val_ch = 1
      LET hit = 1
      LET note_msg = "lock ok"
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- probe STAT ---
SYS EQS ACTION "probe"
IF LAST_N == 1 THEN
  NOTE "action probe"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "probe no active"
    FAIL "probe no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "probe no active"
    END
  ELSE
    SYS STAT active
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "probe fail"
      FAIL "probe fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "probe fail"
      END
    ELSE
      IF STAT_EXIST == 0 THEN
        LET miss = 1
        LET note_msg = "probe missing"
        FAIL "probe missing"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "probe missing"
        END
      ELSE
        LET hit = 1
        LET note_msg = "probe ok"
      END
      SYS STR STAT_SIZE
      SYS CAT "size:" LAST
      LET meta = LAST
      SYS STR STAT_EXIST
      SYS CAT "exist:" LAST
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
      SYS STR STAT_SIZE
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- fsync only ---
SYS EQS ACTION "fsync"
IF LAST_N == 1 THEN
  NOTE "action fsync"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "fsync no active"
    FAIL "fsync no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "fsync no active"
    END
  ELSE
    SYS FSYNC active
    IF OK == 0 THEN
      LET miss = 1
      LET fsync_n = 0
      LET note_msg = "fsync miss"
      FAIL "fsync miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "fsync miss"
      END
    ELSE
      LET fsync_n = FSYNC_N
      LET hit = 1
      LET note_msg = "fsync ok"
      SYS STR fsync_n
      LET val = LAST
      LET val_ch = 1
    END
  END
  PRINT_JSON fsync_n
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET active = ""
  LET val = ""
  LET meta = ""
  LET active_ch = 1
  LET val_ch = 1
  LET meta_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "pick"
LET k = k + LAST_N
SYS EQS ACTION "put"
LET k = k + LAST_N
SYS EQS ACTION "load"
LET k = k + LAST_N
SYS EQS ACTION "get"
LET k = k + LAST_N
SYS EQS ACTION "need"
LET k = k + LAST_N
SYS EQS ACTION "gate"
LET k = k + LAST_N
SYS EQS ACTION "lock"
LET k = k + LAST_N
SYS EQS ACTION "probe"
LET k = k + LAST_N
SYS EQS ACTION "fsync"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF active_ch > 0 THEN
  SYS WRITE active_meta active
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "active write failed"
  END
  CLEAR_ERR
END
IF val_ch > 0 THEN
  SYS WRITE val_path val
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "val write failed"
  END
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "meta write failed"
  END
  CLEAR_ERR
END

SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.dotenv_sync_board.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "load_n"
LET report = LAST
SYS STR load_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "skip_n"
LET report = LAST
SYS STR skip_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "fsync_n"
LET report = LAST
SYS STR fsync_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "active"
LET report = LAST
SYS PUSH report active
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "dotenv_sync_board" ACTION hit miss load_n note_msg elapsed
