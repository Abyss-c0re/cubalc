# plate_acl_board.cubalc — access admit + owner/group labels
#
# Real use: before agents read/write shared plates or invoke runbooks they
# need a pre-flight ACL probe without shell access(2)/stat -c %U glue:
#   CANREAD / CANWRITE / CANEXEC / CANACCESS — access(2) admit bits
#   OWNERNAME / GROUPNAME                    — human login/group labels
#   MODE                                     — octal perm stamp
#   USER                                     — process identity for "mine?"
# Distinct from plate_lockdown (CHMOD budget) and plate_identity (OWNEDBY/
# SAMEINODE/TEE): this board is *R/W/X admit + human owner stamp + gate*.
#
# Plate under STATE:
#   ACTIVE.txt     — target path
#   VAL.txt        — last label / mode / admit bag
#   META.txt       — key:val probe bag
#   ACL_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_PA_ACTION):
#   list      — plate (default)
#   pick      — ACTIVE = ARG1
#   put       — WRITE ACTIVE ARG1 body (seed probe file)
#   canr      — CANREAD ACTIVE → VAL 0|1
#   canw      — CANWRITE ACTIVE
#   canx      — CANEXEC ACTIVE
#   access    — CANACCESS ACTIVE (F_OK)
#   owner     — OWNERNAME ACTIVE → VAL
#   group     — GROUPNAME ACTIVE → VAL
#   mode      — MODE ACTIVE → VAL
#   stamp     — owner:group:mode + r/w/x composite → VAL/META
#   gate      — admit if CANREAD+CANWRITE (or ARG1 = r|w|x|rw|rx|wx|rwx)
#   mine      — OWNERNAME vs USER (is plate owned by me by name)
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_pa_$$
#   CUBALC_ARG0=pick CUBALC_ARG1=$CUBALC_STATE/secret.env ...
#   CUBALC_ARG0=put CUBALC_ARG1='token=s3cr3t' ...
#   CUBALC_ARG0=canr ...
#   CUBALC_ARG0=owner ...
#   CUBALC_ARG0=stamp ...
#   CUBALC_ARG0=gate CUBALC_ARG1=rw ...
#
# Env: CUBALC_PA_REQUIRE=1  CUBALC_PA_PATH=…  CUBALC_PA_GATE=rw
#
# Edges:
#   CAN* missing path → OK=1 LAST_N=0 (probe, not soft fail)
#   OWNERNAME missing path → OK=0 sticky ERR
#   empty path CAN* → OK=0; OWNERNAME empty → OK=0
#   CANEXEC on data plate usually 0; gate require rwx fails
#   OWNERNAME substring HAS false friends; WRITE NL; REQUIRE; NUM

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "plate_acl_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT AFILE = "ACTIVE.txt"
DEFAULT VFILE = "VAL.txt"
DEFAULT MFILE = "META.txt"
DEFAULT REPORT = "ACL_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT GATE_SPEC = "rw"
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS
SYS USER
LET me_user = LAST
CLEAR_ERR

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_PA_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_PA_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_PA_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_PA_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_PA_PATH" OR ""
IF LAST_N > 0 THEN
  LET ENV_PATH = LAST
ELSE
  LET ENV_PATH = ""
END
SYS ENV "CUBALC_PA_GATE" OR ""
IF LAST_N > 0 THEN
  LET ENV_GATE = LAST
ELSE
  LET ENV_GATE = ""
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS JOIN state_dir AFILE
LET active_meta = LAST
SYS JOIN state_dir VFILE
LET val_path = LAST
SYS JOIN state_dir MFILE
LET meta_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR active_meta OR ""
LET active = LAST
CLEAR_ERR
SYS READ OR val_path OR ""
LET val = LAST
CLEAR_ERR
SYS READ OR meta_path OR ""
LET meta = LAST
CLEAR_ERR

SYS BLANK ENV_PATH
IF LAST_N == 0 THEN
  SYS EQS ACTION "pick"
  IF LAST_N == 1 THEN
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = ENV_PATH
    END
  END
END
SYS BLANK ENV_GATE
IF LAST_N == 0 THEN
  SYS EQS ACTION "gate"
  IF LAST_N == 1 THEN
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = ENV_GATE
    END
  END
END

LET hit = 0
LET miss = 0
LET active_ch = 0
LET val_ch = 0
LET meta_ch = 0
LET note_msg = "ok"
LET canr_n = 0
LET canw_n = 0
LET canx_n = 0
LET cana_n = 0
LET mode_n = 0
LET uid_n = 0
LET gid_n = 0
LET mine_n = 0
LET gate_n = 0

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  STATUS
  PRINT "pacl" ACTION
  PRINT_JSON ACTION STATUS_OK
  PRINT_JSON active
  PRINT_JSON val
  PRINT_JSON meta
  LET note_msg = "list ok"
END

# --- pick ACTIVE ---
SYS EQS ACTION "pick"
IF LAST_N == 1 THEN
  NOTE "action pick"
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "pick needs path"
  END
  LET active = NAME
  LET active_ch = 1
  LET hit = 1
  LET note_msg = "pick ok"
  PRINT_JSON active
END

# --- put seed body ---
SYS EQS ACTION "put"
IF LAST_N == 1 THEN
  NOTE "action put"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "put no active"
    FAIL "put no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "put no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      EXIT 2 "put needs body"
    END
    SYS WRITE active NAME
    IF OK == 0 THEN
      LET miss = 1
      LET note_msg = "put write fail"
      FAIL "put write fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "put write fail"
      END
    ELSE
      LET val = NAME
      LET val_ch = 1
      LET hit = 1
      LET note_msg = "put ok"
    END
  END
  PRINT_JSON val
  CLEAR_ERR
END

# --- canr CANREAD ---
SYS EQS ACTION "canr"
IF LAST_N == 1 THEN
  NOTE "action canr"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "canr no active"
    FAIL "canr no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "canr no active"
    END
  ELSE
    SYS CANREAD active
    IF OK == 0 THEN
      LET miss = 1
      LET canr_n = 0
      LET note_msg = "canr empty/fail"
      FAIL "canr empty/fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "canr empty/fail"
      END
    ELSE
      LET canr_n = LAST_N
      IF canr_n == 0 THEN
        LET miss = 1
        LET note_msg = "canr denied"
        FAIL "canr denied"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "canr denied"
        END
      ELSE
        LET hit = 1
        LET note_msg = "canr ok"
      END
      SYS STR canr_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "canr"
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON canr_n
  CLEAR_ERR
END

