SYS EQS ACTION "canw"
IF LAST_N == 1 THEN
  NOTE "action canw"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "canw no active"
    FAIL "canw no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "canw no active"
    END
