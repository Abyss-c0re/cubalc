      LET note_msg = "canw empty/fail"
      FAIL "canw empty/fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "canw empty/fail"
      END
    ELSE
      LET canw_n = LAST_N
      IF canw_n == 0 THEN
        LET miss = 1
        LET note_msg = "canw denied"
        FAIL "canw denied"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "canw denied"
        END
      ELSE
        LET hit = 1
        LET note_msg = "canw ok"
      END
      SYS STR canw_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "canw"
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON canw_n
  CLEAR_ERR
END

# --- canx CANEXEC ---
SYS EQS ACTION "canx"
IF LAST_N == 1 THEN
  NOTE "action canx"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "canx no active"
    FAIL "canx no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "canx no active"
    END
  ELSE
    SYS CANEXEC active
    IF OK == 0 THEN
      LET miss = 1
      LET canx_n = 0
      LET note_msg = "canx empty/fail"
      FAIL "canx empty/fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "canx empty/fail"
      END
    ELSE
      LET canx_n = LAST_N
      # data plates usually not executable — soft deny is expected
      IF canx_n == 0 THEN
        LET miss = 1
        LET note_msg = "canx denied"
        FAIL "canx denied"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "canx denied"
        END
      ELSE
        LET hit = 1
        LET note_msg = "canx ok"
      END
      SYS STR canx_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "canx"
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON canx_n
  CLEAR_ERR
END

# --- access CANACCESS (F_OK) ---
SYS EQS ACTION "access"
IF LAST_N == 1 THEN
  NOTE "action access"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "access no active"
    FAIL "access no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "access no active"
    END
  ELSE
    SYS CANACCESS active
    IF OK == 0 THEN
      LET miss = 1
      LET cana_n = 0
      LET note_msg = "access empty/fail"
      FAIL "access empty/fail"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "access empty/fail"
      END
    ELSE
      LET cana_n = LAST_N
      IF cana_n == 0 THEN
        LET miss = 1
        LET note_msg = "access missing"
        FAIL "access missing"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "access missing"
        END
      ELSE
        LET hit = 1
        LET note_msg = "access ok"
      END
      SYS STR cana_n
      LET val = LAST
      LET val_ch = 1
      LET meta = "access"
      SYS PUSH meta val
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON cana_n
  CLEAR_ERR
END

# --- owner OWNERNAME ---
SYS EQS ACTION "owner"
IF LAST_N == 1 THEN
  NOTE "action owner"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "owner no active"
    FAIL "owner no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "owner no active"
    END
  ELSE
    SYS OWNERNAME active
    IF OK == 0 THEN
      LET miss = 1
      LET val = ""
      LET val_ch = 1
      LET note_msg = "owner miss"
      FAIL "owner miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "owner miss"
      END
    ELSE
      LET val = LAST
      LET uid_n = LAST_N
      LET val_ch = 1
      LET hit = 1
      LET note_msg = "owner ok"
      LET meta = "owner"
      SYS PUSH meta val
      LET meta = LAST
      SYS PUSH meta "uid"
      LET meta = LAST
      SYS STR uid_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON uid_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- group GROUPNAME ---
SYS EQS ACTION "group"
IF LAST_N == 1 THEN
  NOTE "action group"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "group no active"
    FAIL "group no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "group no active"
    END
  ELSE
    SYS GROUPNAME active
    IF OK == 0 THEN
      LET miss = 1
      LET val = ""
      LET val_ch = 1
      LET note_msg = "group miss"
      FAIL "group miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "group miss"
      END
    ELSE
      LET val = LAST
      LET gid_n = LAST_N
      LET val_ch = 1
      LET hit = 1
      LET note_msg = "group ok"
      LET meta = "group"
      SYS PUSH meta val
      LET meta = LAST
      SYS PUSH meta "gid"
      LET meta = LAST
      SYS STR gid_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON gid_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- mode MODE ---
SYS EQS ACTION "mode"
IF LAST_N == 1 THEN
  NOTE "action mode"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "mode no active"
    FAIL "mode no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "mode no active"
    END
  ELSE
    SYS MODE active
    IF OK == 0 THEN
      LET miss = 1
      LET val = ""
      LET val_ch = 1
      LET note_msg = "mode miss"
      FAIL "mode miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "mode miss"
      END
    ELSE
      LET val = LAST
      LET mode_n = MODE_N
      LET val_ch = 1
      LET hit = 1
      LET note_msg = "mode ok"
      LET meta = "mode"
      SYS PUSH meta val
      LET meta = LAST
      SYS PUSH meta "n"
      LET meta = LAST
      SYS STR mode_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON mode_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- stamp composite owner:group:mode + r/w/x ---
SYS EQS ACTION "stamp"
IF LAST_N == 1 THEN
  NOTE "action stamp"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "stamp no active"
    FAIL "stamp no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stamp no active"
    END
  ELSE
    SYS CANACCESS active
    IF OK == 0 THEN
      LET cana_n = 0
    ELSE
      LET cana_n = LAST_N
    END
    CLEAR_ERR
    IF cana_n == 0 THEN
      LET miss = 1
      LET note_msg = "stamp missing"
      FAIL "stamp missing"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "stamp missing"
      END
    ELSE
      SYS OWNERNAME active
      IF OK == 0 THEN
        LET miss = 1
        LET note_msg = "stamp owner miss"
        FAIL "stamp owner miss"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "stamp owner miss"
        END
      ELSE
        LET oname = LAST
        LET uid_n = LAST_N
        SYS GROUPNAME active
        IF OK == 0 THEN
          LET miss = 1
          LET note_msg = "stamp group miss"
          FAIL "stamp group miss"
          CLEAR_ERR
          IF REQUIRE_HIT > 0 THEN
            EXIT 2 "stamp group miss"
          END
        ELSE
          LET gname = LAST
          LET gid_n = LAST_N
          SYS MODE active
          IF OK == 0 THEN
            LET miss = 1
            LET note_msg = "stamp mode miss"
            FAIL "stamp mode miss"
            CLEAR_ERR
            IF REQUIRE_HIT > 0 THEN
              EXIT 2 "stamp mode miss"
            END
          ELSE
            LET mstr = LAST
            LET mode_n = MODE_N
            SYS CANREAD active
            LET canr_n = LAST_N
            SYS CANWRITE active
            LET canw_n = LAST_N
            SYS CANEXEC active
            LET canx_n = LAST_N
            CLEAR_ERR
            # build "owner:group:mode rwx=rrr"
            SYS CAT oname ":"
            LET val = LAST
            SYS CAT val gname
            LET val = LAST
            SYS CAT val ":"
            LET val = LAST
            SYS CAT val mstr
            LET val = LAST
            SYS CAT val " r="
            LET val = LAST
            SYS STR canr_n
            SYS CAT val LAST
            LET val = LAST
            SYS CAT val " w="
            LET val = LAST
            SYS STR canw_n
            SYS CAT val LAST
            LET val = LAST
            SYS CAT val " x="
            LET val = LAST
            SYS STR canx_n
            SYS CAT val LAST
            LET val = LAST
            LET val_ch = 1
            LET meta = "owner"
            SYS PUSH meta oname
            LET meta = LAST
            SYS PUSH meta "group"
            LET meta = LAST
            SYS PUSH meta gname
            LET meta = LAST
            SYS PUSH meta "mode"
            LET meta = LAST
            SYS PUSH meta mstr
            LET meta = LAST
            SYS PUSH meta "canr"
            LET meta = LAST
            SYS STR canr_n
            SYS PUSH meta LAST
            LET meta = LAST
            SYS PUSH meta "canw"
            LET meta = LAST
            SYS STR canw_n
            SYS PUSH meta LAST
            LET meta = LAST
            SYS PUSH meta "canx"
            LET meta = LAST
            SYS STR canx_n
            SYS PUSH meta LAST
            LET meta = LAST
            SYS PUSH meta "user"
            LET meta = LAST
            SYS PUSH meta me_user
            LET meta = LAST
            LET meta_ch = 1
            LET hit = 1
            LET note_msg = "stamp ok"
          END
        END
      END
    END
  END
  PRINT_JSON canr_n canw_n canx_n mode_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- gate admit r/w/x combo ---
SYS EQS ACTION "gate"
IF LAST_N == 1 THEN
  NOTE "action gate"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "gate no active"
    FAIL "gate no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "gate no active"
    END
  ELSE
    SYS BLANK NAME
    IF LAST_N == 1 THEN
      LET NAME = GATE_SPEC
    END
    LET want = NAME
    # lowercase-ish: accept r,w,x,rw,rx,wx,rwx
    SYS LOWER want
    LET want = LAST
    SYS CANREAD active
    LET canr_n = LAST_N
    SYS CANWRITE active
    LET canw_n = LAST_N
    SYS CANEXEC active
    LET canx_n = LAST_N
    CLEAR_ERR
    LET need_r = 0
    LET need_w = 0
    LET need_x = 0
    SYS HAS want "r"
    LET need_r = LAST_N
    SYS HAS want "w"
    LET need_w = LAST_N
    SYS HAS want "x"
    LET need_x = LAST_N
    # empty/unknown default to rw
    IF need_r == 0 THEN
      IF need_w == 0 THEN
        IF need_x == 0 THEN
          LET need_r = 1
          LET need_w = 1
        END
      END
    END
    LET gate_n = 1
    IF need_r == 1 THEN
      IF canr_n == 0 THEN
        LET gate_n = 0
      END
    END
    IF need_w == 1 THEN
      IF canw_n == 0 THEN
        LET gate_n = 0
      END
    END
    IF need_x == 1 THEN
      IF canx_n == 0 THEN
        LET gate_n = 0
      END
    END
    IF gate_n == 0 THEN
      LET miss = 1
      LET note_msg = "gate deny"
      FAIL "gate deny"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "gate deny"
      END
    ELSE
      LET hit = 1
      LET note_msg = "gate ok"
    END
    SYS STR gate_n
    LET val = LAST
    LET val_ch = 1
    LET meta = "gate"
    SYS PUSH meta want
    LET meta = LAST
    SYS PUSH meta "ok"
    LET meta = LAST
    SYS STR gate_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta "r"
    LET meta = LAST
    SYS STR canr_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta "w"
    LET meta = LAST
    SYS STR canw_n
    SYS PUSH meta LAST
    LET meta = LAST
    SYS PUSH meta "x"
    LET meta = LAST
    SYS STR canx_n
    SYS PUSH meta LAST
    LET meta = LAST
    LET meta_ch = 1
  END
  PRINT_JSON gate_n canr_n canw_n canx_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- mine: OWNERNAME EQS USER ---
SYS EQS ACTION "mine"
IF LAST_N == 1 THEN
  NOTE "action mine"
  SYS BLANK active
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "mine no active"
    FAIL "mine no active"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "mine no active"
    END
  ELSE
    SYS OWNERNAME active
    IF OK == 0 THEN
      LET miss = 1
      LET mine_n = 0
      LET note_msg = "mine owner miss"
      FAIL "mine owner miss"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "mine owner miss"
      END
    ELSE
      LET oname = LAST
      LET uid_n = LAST_N
      SYS EQS oname me_user
      LET mine_n = LAST_N
      # also OWNEDBY numeric dual-check (euid)
      SYS OWNEDBY active
      LET own_n = LAST_N
      CLEAR_ERR
      IF mine_n == 0 THEN
        LET miss = 1
        LET note_msg = "mine no"
        FAIL "mine no"
        CLEAR_ERR
        IF REQUIRE_HIT > 0 THEN
          EXIT 2 "mine no"
        END
      ELSE
        LET hit = 1
        LET note_msg = "mine ok"
      END
      # false-friend: HAS me_user on oname (substring)
      SYS HAS oname me_user
      LET has_n = LAST_N
      LET val = oname
      LET val_ch = 1
      LET meta = "owner"
      SYS PUSH meta oname
      LET meta = LAST
      SYS PUSH meta "user"
      LET meta = LAST
      SYS PUSH meta me_user
      LET meta = LAST
      SYS PUSH meta "mine"
      LET meta = LAST
      SYS STR mine_n
      SYS PUSH meta LAST
      LET meta = LAST
      SYS PUSH meta "ownedby"
      LET meta = LAST
      SYS STR own_n
      SYS PUSH meta LAST
      LET meta = LAST
      SYS PUSH meta "has_sub"
      LET meta = LAST
      SYS STR has_n
      SYS PUSH meta LAST
      LET meta = LAST
      LET meta_ch = 1
    END
  END
  PRINT_JSON mine_n uid_n
  PRINT_JSON val
  CLEAR_ERR
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET active = ""
  LET val = ""
  LET meta = ""
  LET active_ch = 1
  LET val_ch = 1
  LET meta_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "pick"
LET k = k + LAST_N
SYS EQS ACTION "put"
LET k = k + LAST_N
SYS EQS ACTION "canr"
LET k = k + LAST_N
SYS EQS ACTION "canw"
LET k = k + LAST_N
SYS EQS ACTION "canx"
LET k = k + LAST_N
SYS EQS ACTION "access"
LET k = k + LAST_N
SYS EQS ACTION "owner"
LET k = k + LAST_N
SYS EQS ACTION "group"
LET k = k + LAST_N
SYS EQS ACTION "mode"
LET k = k + LAST_N
SYS EQS ACTION "stamp"
LET k = k + LAST_N
SYS EQS ACTION "gate"
LET k = k + LAST_N
SYS EQS ACTION "mine"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF active_ch > 0 THEN
  SYS WRITE active_meta active
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "active write failed"
  END
  CLEAR_ERR
END
IF val_ch > 0 THEN
  SYS WRITE val_path val
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "val write failed"
  END
  CLEAR_ERR
END
IF meta_ch > 0 THEN
  SYS WRITE meta_path meta
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "meta write failed"
  END
  CLEAR_ERR
END

SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.plate_acl_board.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "canr"
LET report = LAST
SYS STR canr_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "canw"
LET report = LAST
SYS STR canw_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "canx"
LET report = LAST
SYS STR canx_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "gate"
LET report = LAST
SYS STR gate_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "mine"
LET report = LAST
SYS STR mine_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "active"
LET report = LAST
SYS PUSH report active
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "user"
LET report = LAST
SYS PUSH report me_user
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "plate_acl_board" ACTION hit miss canr_n canw_n canx_n gate_n note_msg elapsed
