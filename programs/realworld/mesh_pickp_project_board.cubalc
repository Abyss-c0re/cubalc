# mesh_pickp_project_board.cubalc — PICKP/OMITP mesh export projection hygiene
#
# Real use: mesh controllers slim agent/peer plates for log export and strip
# secret/debug noise before share, without SYS JSONPICK/JSONDROP rebuild glue.
# Project peer identity fields into local plate via PICKP + MERGEP.
# First realworld of proof 1151 PICKP/KEEPP/OMITP/DROPKEYSP (MEANINGFUL pickp).
#
#   PICKP "role" "host" "n"           # keep listed keys → LAST / PICKP
#   PICKP FROM PEER "host" "agent"
#   OMITP "secret" "debug" "tmp"      # strip noise → LAST / OMITP
#   MERGEP FROM PLATE LAST            # apply projected peer fields
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_mpp_$$
#   ./out/cubalc run programs/realworld/mesh_pickp_project_board.cubalc boot
#   ./out/cubalc run ... slim|strip|peer|merge|export|gate|probe|soft|list
#
# Plate: STATUS.txt VAL.txt META.txt MPP_REPORT.txt agent.json peer.json export.json
# Env: HOST_S ROLE_S CUBALC_MPP_REQUIRE
#
# Edges:
#   miss keys soft-skip (PICKP_N < asked); source plate untouched by PICK/OMIT;
#   WRITE omit NL; soft empty bag; NUM shuttle; knob LET flaky → JSONLEN

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "mesh_pickp_project_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "mesh_pickp_project -- boot|slim|strip|peer|merge|export|gate|probe|soft|list -- [--host=H]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeP"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_MPP_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "MPP_REPORT.txt"
LET report_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "export.json"
LET export_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET known = 0
LET note_msg = "ok"
LET bag_n = 0
LET admit_n = 0
LET has_n = 0
LET op = "unknown"
LET take_n = 0
LET peel_hit = 0
LET row = ""
LET out = ""
LET body = ""
LET created = 0
LET load_hit = 0
LET miss_n = 0
LET w_s = ""
LET d_s = ""
LET proj = "{}"

SYS LINES bag
LET bag_n = LAST_N

ONEOF ACTION "boot", "slim", "strip", "peer", "merge", "export", "gate", "list", "ls", "soft", "clear", "probe"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "slim" THEN
    LET op = "slim"
  WHEN "strip" THEN
    LET op = "strip"
  WHEN "peer" THEN
    LET op = "peer"
  WHEN "merge" THEN
    LET op = "merge"
  WHEN "export" THEN
    LET op = "export"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "clear" THEN
    LET op = "clear"
  WHEN "probe" THEN
    LET op = "probe"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

# boot — agent with noise/secret + peer with noise
SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS JSONOBJ "agent" "proj-ctl" "n" 1 "host" "cubeL" "role" role_s "schema" "cubalc.mesh_pickp.v1" "tmp" "seed" "secret" "redact-me" "debug" 1
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS JSONOBJ "agent" "hive-peer" "n" 7 "host" host_s "role" role_s "noise" "drop-me" "schema" "cubalc.mesh_pickp.v1"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETP "secret"
  SYS EQS LAST "redact-me"
  LET has_n = LAST_N
  CLEAR_ERR
  GETP FROM PEER "noise"
  SYS EQS LAST "drop-me"
  LET peel_hit = LAST_N
  CLEAR_ERR
  NEEDP "role" "host" "n" "secret"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF has_n == 1 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        LET hit = 1
        LET note_msg = "boot ok"
        LET admit_n = 1
        LET created = 1
        LET take_n = 1
        SYS CAT "boot:" host_s ":bt"
        LET row = LAST
        CLEAR_ERR
        SYS GREPV "boot:" bag
        LET bag = LAST
        CLEAR_ERR
        SYS PUSH bag row
        LET bag = LAST
        LET bag_ch = 1
      ELSE
        LET miss = 1
        LET note_msg = "boot needp"
        FAIL "boot needp"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "boot peer noise"
      FAIL "boot peer noise"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot secret"
    FAIL "boot secret"
    CLEAR_ERR
  END
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# slim — PICKP keep public fields only from PLATE → export.json
SYS EQS op "slim"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PICKP "role" "host" "n" "schema" "agent"
  LET proj = LAST
  SYS JSONLEN proj
  LET take_n = LAST_N
  CLEAR_ERR
  SYS WRITE export_path proj
  CLEAR_ERR
  # secret must be absent from projection
  SYS JSON "secret" FROM proj
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "role" FROM proj
  SYS EQS LAST role_s
  LET has_n = LAST_N
  CLEAR_ERR
  # source plate still has secret
  GETP "secret"
  SYS EQS LAST "redact-me"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF take_n >= 4 THEN
    IF peel_hit == 1 THEN
      IF has_n == 1 THEN
        IF load_hit == 1 THEN
          LET hit = 1
          LET note_msg = "slim ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "slim source wiped"
          FAIL "slim source wiped"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "slim role"
        FAIL "slim role"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "slim leaked secret"
      FAIL "slim leaked secret"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "slim thin"
    FAIL "slim thin"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "slim:" w_s ":sl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "slim:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit has_n load_hit note_msg
  CLEAR_ERR
END

# strip — OMITP secret/debug/tmp from PLATE view → export
SYS EQS op "strip"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  OMITP "secret" "debug" "tmp"
  LET proj = LAST
  SYS JSONLEN proj
  LET take_n = LAST_N
  CLEAR_ERR
  SYS WRITE export_path proj
  CLEAR_ERR
  SYS JSON "secret" FROM proj
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "debug" FROM proj
  SYS EMPTY LAST
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "role" FROM proj
  SYS EQS LAST role_s
  LET load_hit = LAST_N
  CLEAR_ERR
  GETP "secret"
  SYS EQS LAST "redact-me"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF load_hit == 1 THEN
        IF miss_n == 1 THEN
          LET hit = 1
          LET note_msg = "strip ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "strip source secret"
          FAIL "strip source secret"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "strip role"
        FAIL "strip role"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "strip debug present"
      FAIL "strip debug present"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "strip secret present"
    FAIL "strip secret present"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "strip:" w_s ":st"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "strip:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit has_n load_hit note_msg
  CLEAR_ERR
END

# peer — PICKP FROM PEER identity fields
SYS EQS op "peer"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PICKP FROM PEER "host" "agent" "n" "schema"
  LET proj = LAST
  SYS JSONLEN proj
  LET take_n = LAST_N
  CLEAR_ERR
  SYS WRITE export_path proj
  CLEAR_ERR
  SYS JSON "host" FROM proj
  SYS EQS LAST host_s
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "noise" FROM proj
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  GETP FROM PEER "noise"
  SYS EQS LAST "drop-me"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF take_n >= 3 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          LET hit = 1
          LET note_msg = "peer ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "peer source noise"
          FAIL "peer source noise"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "peer noise leak"
        FAIL "peer noise leak"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "peer host"
      FAIL "peer host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "peer thin"
    FAIL "peer thin"
    CLEAR_ERR
  END
  SYS STR take_n
  LET w_s = LAST
  CLEAR_ERR
  SYS CAT "peer:" w_s ":pr"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peer:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# merge — project peer host/n into local plate + both_save
SYS EQS op "merge"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  PICKP FROM PEER "host" "n"
  LET proj = LAST
  SYS JSONLEN proj
  LET take_n = LAST_N
  CLEAR_ERR
  MERGEP FROM PLATE proj
  CLEAR_ERR
  SETP "status" "projected"
  CLEAR_ERR
  INCLUDE plate_both_save
  CLEAR_ERR
  GETP "host"
  SYS EQS LAST host_s
  LET has_n = LAST_N
  CLEAR_ERR
  GETP "role"
  SYS EQS LAST role_s
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "status" FROM body
  SYS EQS LAST "projected"
  LET load_hit = LAST_N
  CLEAR_ERR
  IF take_n >= 2 THEN
    IF has_n == 1 THEN
      IF peel_hit == 1 THEN
        IF load_hit == 1 THEN
          LET hit = 1
          LET note_msg = "merge ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "merge disk"
          FAIL "merge disk"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "merge role lost"
        FAIL "merge role lost"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "merge host"
      FAIL "merge host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "merge pick thin"
    FAIL "merge pick thin"
    CLEAR_ERR
  END
  SYS CAT "merge:" host_s ":mg"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "merge:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n has_n peel_hit load_hit note_msg
  CLEAR_ERR
END

# export — OMITP then write shareable export (final hygiene pass)
SYS EQS op "export"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  OMITP "secret" "debug" "tmp"
  LET proj = LAST
  CLEAR_ERR
  SYS WRITE export_path proj
  CLEAR_ERR
  SYS READ export_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "secret" FROM body
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "host" FROM body
  LET w_s = LAST
  CLEAR_ERR
  SYS EQS w_s host_s
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSONLEN body
  LET take_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF take_n >= 3 THEN
        LET hit = 1
        LET note_msg = "export ok"
        LET admit_n = 1
        LET load_hit = 1
      ELSE
        LET miss = 1
        LET note_msg = "export thin"
        FAIL "export thin"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "export host"
      FAIL "export host"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "export secret"
    FAIL "export secret"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "export secret"
    END
  END
  SYS CAT "export:" note_msg ":ex"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "export:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n take_n peel_hit has_n note_msg
  CLEAR_ERR
END

# gate — disk export no secret; agent projected host
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  SYS READ export_path
  LET body = LAST
  CLEAR_ERR
  SYS JSON "secret" FROM body
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  SYS JSON "debug" FROM body
  SYS EMPTY LAST
  LET has_n = LAST_N
  CLEAR_ERR
  SYS READ agent_path
  LET out = LAST
  CLEAR_ERR
  SYS JSON "host" FROM out
  SYS EQS LAST host_s
  LET load_hit = LAST_N
  CLEAR_ERR
  SYS JSON "status" FROM out
  SYS EQS LAST "projected"
  LET take_n = LAST_N
  CLEAR_ERR
  IF peel_hit == 1 THEN
    IF has_n == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          LET hit = 1
          LET note_msg = "gate ok"
          LET admit_n = 1
        ELSE
          LET miss = 1
          LET note_msg = "gate status"
          FAIL "gate status"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "gate host"
        FAIL "gate host"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "gate debug leak"
      FAIL "gate debug leak"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "gate secret leak"
    FAIL "gate secret leak"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "gate secret leak"
    END
  END
  SYS CAT "gate:" host_s ":ga"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n peel_hit has_n load_hit take_n note_msg
  CLEAR_ERR
END

# soft
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  SYS LINES bag
  LET bag_n = LAST_N
  IF bag_n < 1 THEN
    LET miss = 1
    LET note_msg = "soft empty ok"
    FAIL "soft empty"
    CLEAR_ERR
    IF require_hit > 0 THEN
      EXIT 2 "soft empty require"
    END
  ELSE
    LET hit = 1
    LET note_msg = "soft has rows"
  END
  PRINT_JSON bag_n miss hit
  CLEAR_ERR
END

# probe — miss keys soft-skip; KEEPP/DROPKEYSP aliases; lit forms
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  # miss keys soft-skip → only existing keys
  PICKP "role" "missing_key" "n"
  LET proj = LAST
  SYS JSONLEN proj
  LET has_n = LAST_N
  CLEAR_ERR
  SYS JSON "missing_key" FROM proj
  SYS EMPTY LAST
  LET peel_hit = LAST_N
  CLEAR_ERR
  # alias KEEPP
  KEEPP FROM PEER "agent"
  LET body = LAST
  SYS JSON "agent" FROM body
  SYS EQS LAST "hive-peer"
  LET load_hit = LAST_N
  CLEAR_ERR
  # alias DROPKEYSP
  DROPKEYSP "noise" FROM PEER
  LET body = LAST
  SYS JSON "noise" FROM body
  SYS EMPTY LAST
  LET take_n = LAST_N
  CLEAR_ERR
  # peer source still has noise
  GETP FROM PEER "noise"
  SYS EQS LAST "drop-me"
  LET miss_n = LAST_N
  CLEAR_ERR
  IF has_n == 2 THEN
    IF peel_hit == 1 THEN
      IF load_hit == 1 THEN
        IF take_n == 1 THEN
          IF miss_n == 1 THEN
            LET hit = 1
            LET note_msg = "probe ok"
            LET admit_n = 1
          ELSE
            LET miss = 1
            LET note_msg = "probe peer noise"
            FAIL "probe peer noise"
            CLEAR_ERR
          END
        ELSE
          LET miss = 1
          LET note_msg = "probe dropkeys"
          FAIL "probe dropkeys"
          CLEAR_ERR
        END
      ELSE
        LET miss = 1
        LET note_msg = "probe keepp"
        FAIL "probe keepp"
        CLEAR_ERR
      END
    ELSE
      LET miss = 1
      LET note_msg = "probe miss key present"
      FAIL "probe miss key present"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "probe pick n"
    FAIL "probe pick n"
    CLEAR_ERR
  END
  PRINT_JSON has_n peel_hit load_hit take_n miss_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "cleared"
END

IF known == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF bag_ch > 0 THEN
  SYS WRITE plate_path bag
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "plate write failed"
  END
  CLEAR_ERR
  SYS WRITE val_path bag
  CLEAR_ERR
END

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
SYS STR admit_n
LET out = LAST
CLEAR_ERR
SYS CAT "schema=cubalc.mesh_pickp.v1 op=" op " hit=" w_s " miss=" d_s " admit=" out " note=" note_msg " date=" run_date
LET row = LAST
SYS WRITE meta_path row
CLEAR_ERR

SYS STR hit
LET w_s = LAST
SYS STR miss
LET d_s = LAST
CLEAR_ERR
SYS CAT "mpp op=" op " hit=" w_s " miss=" d_s " note=" note_msg
LET body = LAST
SYS WRITE report_path body
CLEAR_ERR

PRINT_JSON op hit miss admit_n bag_n take_n peel_hit has_n load_hit miss_n created note_msg
