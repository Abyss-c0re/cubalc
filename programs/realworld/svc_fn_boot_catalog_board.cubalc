# svc_fn_boot_catalog_board.cubalc — fn_boot/fn_guard fleet FN catalog contract
#
# Real use: fleet agents gate required runbook FN names (ALL + optional ANY)
# via INCLUDE fn_boot before dispatch, instead of N× HASFN / REQUIRE FN glue.
# First realworld of 1400 fn_guard + fn_boot (1.15.853+ · MEANINGFUL_ITER 861
# · init --fn). Distinct from fn_runbook_board (LISTFNS/TRYCALL pipeline).
#
#   DEFAULT NEED_FNALL · NEED_FNANY · FN_GUARD_SOFT
#   INCLUDE fn_boot|fn_guard → FN_GUARD_OK / ALL_OK / ANY_OK
#   FNHAVE / FNMISS bags · FNHAVE_N / FNMISS_N
#   HASFN exact · soft miss · hard HASFN+FAIL path
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_sfc_$$
#   ./out/cubalc run programs/realworld/svc_fn_boot_catalog_board.cubalc boot
#   ./out/cubalc run ... pass|soft_all|soft_any|hard|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt SFC_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_SFC_REQUIRE
#
# Edges: LET knobs before each re-INCLUDE; hard miss exit_code 0;
#   HASFN exact not substring; REQUIRE FN avoided inside INCLUDE (IF/END);
#   double agent_boot via fn_boot; FNHAVE multiline PRINT; WRITE NL;
#   auto-seed plate (ENSUREPLATE no reseed); empty NEED_* skips

INCLUDE agent_boot
REQUIRE LIB hold_seed

# fleet runbook FN catalog (defined before gates so HASFN can see them)
FN rb_ping
  RET 1
END

FN rb_admit slot
  RET slot
END

FN rb_release slot
  RET 0
END

NOTE "svc_fn_boot_catalog_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_fn_boot_catalog -- boot|pass|soft_all|soft_any|hard|form|gate|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeF"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_SFC_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "SFC_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET fgo = 0
LET allo = 0
LET anyo = 0
LET have_n = 0
LET miss_n = 0
LET have_s = ""
LET miss_s = ""

ONEOF ACTION "boot", "pass", "soft_all", "soft_any", "hard", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft_all" THEN
    LET op = "soft_all"
  WHEN "soft_any" THEN
    LET op = "soft_any"
  WHEN "hard" THEN
    LET op = "hard"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

# auto-seed agent plate for plate-using ops (ENSUREPLATE will not reseed {})
SYS EQS op "list"
IF LAST_N == 0 THEN
  SYS EQS op "clear"
  IF LAST_N == 0 THEN
    LET need_seed = 1
    SYS EXIST agent_path
    IF LAST_N == 1 THEN
      SYS READ OR agent_path OR ""
      SYS HAS LAST "svc-sfc"
      IF LAST_N == 1 THEN
        LET need_seed = 0
      END
      CLEAR_ERR
    END
    CLEAR_ERR
    IF need_seed == 1 THEN
      SYS TRIM host_s
      LET host_s = LAST
      SYS TRIM role_s
      LET role_s = LAST
      CLEAR_ERR
      LET PLATE_PATH = agent_path
      LET PEER_PATH = peer_path
      SYS CAT "{\"agent\":\"svc-sfc\",\"schema\":\"cubalc.svc_fn_boot_catalog.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"fn_catalog\",\"label\":\"sfc\",\"cfg\":{\"surface\":\"fn_boot,fn_guard,NEED_FNALL,NEED_FNANY,FN_GUARD_SOFT,FN_GUARD_OK,FNHAVE,FNMISS,HASFN\",\"contract\":\"FN catalog gate · init --fn\"}}"
      LET PLATE_SEED = LAST
      CLEAR_ERR
      SYS CAT "{\"peer\":\"fn_catalog\",\"n\":1}"
      LET PEER_SEED = LAST
      CLEAR_ERR
      SYS RM agent_path
      CLEAR_ERR
      SYS RM peer_path
      CLEAR_ERR
      INCLUDE plate_peer_session
      CLEAR_ERR
      SYS SAVEPLATE agent_path PLATE
      CLEAR_ERR
    END
  END
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-sfc\",\"schema\":\"cubalc.svc_fn_boot_catalog.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"fn_catalog\",\"label\":\"sfc\",\"cfg\":{\"surface\":\"fn_boot,fn_guard,NEED_FNALL,NEED_FNANY,FN_GUARD_SOFT,FN_GUARD_OK,FNHAVE,FNMISS,HASFN\",\"contract\":\"FN catalog gate · init --fn\"}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"fn_catalog\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  SYS RM agent_path
  CLEAR_ERR
  SYS RM peer_path
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_fn_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fn_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "fn_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# pass — required FNs present (ALL + ANY)
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = "rb_ping\nrb_admit"
  LET NEED_FNANY = "rb_release\nnosuch_fn_pass_any"
  LET FN_GUARD_SOFT = 0
  INCLUDE fn_boot
  LET fgo = FN_GUARD_OK
  LET allo = FN_GUARD_ALL_OK
  LET anyo = FN_GUARD_ANY_OK
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  HASFN rb_ping
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFN rb_admit
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FNALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "fn_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FN_GUARD_OK"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fn_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" fgo ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fgo allo anyo note_msg
  CLEAR_ERR
END

# soft_all — missing FN under soft · FNMISS bag · substring false friend
SYS EQS op "soft_all"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = "rb_ping\nnosuch_cubalc_fn_sfc_all"
  LET NEED_FNANY = ""
  LET FN_GUARD_SOFT = 1
  INCLUDE fn_guard
  LET fgo = FN_GUARD_OK
  LET allo = FN_GUARD_ALL_OK
  LET miss_n = FNMISS_N
  LET have_n = FNHAVE_N
  LET miss_s = FNMISS
  LET have_s = FNHAVE
  CLEAR_ERR
  IF fgo == 0 THEN
    LET score = score + 1
  END
  IF allo == 0 THEN
    LET score = score + 1
  END
  IF miss_n >= 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  SYS HASLINE miss_s "nosuch_cubalc_fn_sfc_all"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASLINE have_s "rb_ping"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring false friend
  HASFN rb
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "FNMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FN_GUARD_SOFT"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LET NEED_FNALL = ""
  LET NEED_FNANY = ""
  LET FN_GUARD_SOFT = 0
  INCLUDE fn_guard
  LET fgo = FN_GUARD_OK
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_all ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_all score"
    FAIL "soft_all score"
    CLEAR_ERR
  END
  SYS CAT "soft_all:" miss_n ":sa"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_all:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score miss_n have_n note_msg
  CLEAR_ERR
END

