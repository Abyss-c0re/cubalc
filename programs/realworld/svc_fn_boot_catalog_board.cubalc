IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = ""
  LET NEED_FNANY = "nosuch_fn_a_sfc\nnosuch_fn_b_sfc"
  LET FN_GUARD_SOFT = 1
  INCLUDE fn_guard
  LET fgo = FN_GUARD_OK
  LET anyo = FN_GUARD_ANY_OK
  CLEAR_ERR
  IF fgo == 0 THEN
    LET score = score + 1
  END
  IF anyo == 0 THEN
    LET score = score + 1
  END
  LET NEED_FNANY = "nosuch_fn_a_sfc\nrb_ping"
  LET FN_GUARD_SOFT = 1
  INCLUDE fn_guard
  LET fgo = FN_GUARD_OK
  LET anyo = FN_GUARD_ANY_OK
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FNANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FNHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fn_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "fn_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft_any ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft_any score"
    FAIL "soft_any score"
    CLEAR_ERR
  END
  SYS CAT "soft_any:" anyo ":sy"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft_any:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fgo anyo note_msg
  CLEAR_ERR
END

# hard — present FNs under hard guard
SYS EQS op "hard"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = "rb_ping\nrb_admit\nrb_release"
  LET NEED_FNANY = ""
  LET FN_GUARD_SOFT = 0
  INCLUDE fn_boot
  LET fgo = FN_GUARD_OK
  LET allo = FN_GUARD_ALL_OK
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  LET NEED_FNALL = ""
  LET NEED_FNANY = "nosuch_fn_hard_z\nrb_ping"
  LET FN_GUARD_SOFT = 0
  INCLUDE fn_guard
  LET anyo = FN_GUARD_ANY_OK
  LET fgo = FN_GUARD_OK
  CLEAR_ERR
  IF anyo == 1 THEN
    LET score = score + 1
  END
  IF fgo == 1 THEN
    LET score = score + 1
  END
  HASFN rb_release
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFN rb_admit
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "HASFN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "fn_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fn_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "hard ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "hard score"
    FAIL "hard score"
    CLEAR_ERR
  END
  SYS CAT "hard:" fgo ":hd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "hard:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fgo note_msg
  CLEAR_ERR
END

# form — HASLIB / HASINCLUDE · HASFORM knobs miss
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = ""
  LET NEED_FNANY = ""
  LET FN_GUARD_SOFT = 0
  INCLUDE fn_boot
  CLEAR_ERR
  HASLIB fn_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASLIB fn_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE fn_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE fn_guard
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINCLUDE agent_boot
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "HASFN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "FN_GUARD_OK"
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n == 0 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "fn_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FNANY"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:1:fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — plate + soft combined ALL+ANY
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = "rb_ping\nrb_admit"
  LET NEED_FNANY = "rb_release\nnosuch_gate_x"
  LET FN_GUARD_SOFT = 1
  INCLUDE fn_boot
  LET fgo = FN_GUARD_OK
  LET allo = FN_GUARD_ALL_OK
  LET anyo = FN_GUARD_ANY_OK
  LET have_n = FNHAVE_N
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF allo == 1 THEN
    LET score = score + 1
  END
  IF anyo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 1 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEED_FNALL"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FNHAVE"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.contract"
  SYS HAS LAST "FN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fn_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fgo note_msg
  CLEAR_ERR
END

# probe — PRINT clobber · multiline FNHAVE
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  LET NEED_FNALL = "rb_ping\nrb_admit"
  LET NEED_FNANY = ""
  LET FN_GUARD_SOFT = 1
  INCLUDE fn_guard
  LET fgo = FN_GUARD_OK
  LET have_n = FNHAVE_N
  LET have_s = FNHAVE
  CLEAR_ERR
  LET body = "probe-mark"
  PRINT body
  CLEAR_ERR
  SYS EQS LAST "probe-mark"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF fgo == 1 THEN
    LET score = score + 1
  END
  IF have_n >= 2 THEN
    LET score = score + 1
  END
  SYS LINES have_s
  LET sum_n = LAST_N
  CLEAR_ERR
  IF sum_n >= 2 THEN
    LET score = score + 1
  END
  SYS HASLINE have_s "rb_admit"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "fn_boot_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "fn_guard"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "FNMISS"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "fn_catalog"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "sfc"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = have_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score fgo have_n note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS LINES bag
LET bag_n = LAST_N
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " bag_n=" bag_n " find=" find_n " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "host=" host_s " role=" role_s " require=" require_hit " fgo=" fgo " allo=" allo " anyo=" anyo " have_n=" have_n " miss_n=" miss_n
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "sfc report op=" op " score_hit=" hit " bag_n=" bag_n " note=" note_msg " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF known == 0 THEN
  FAIL "unknown path"
  CLEAR_ERR
  EXIT 2 "unknown path"
END

IF hit == 0 THEN
  IF miss == 1 THEN
    EXIT 1 note_msg
  END
END

PASS
