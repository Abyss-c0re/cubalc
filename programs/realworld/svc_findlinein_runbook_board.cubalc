# svc_findlinein_runbook_board.cubalc — FINDLINEIN/SETLINEIN/INSERTLINEIN runbook queue
#
# Real use: ops agents keep an in-memory step bag (todo/doing/done) and
# promote/ack/insert/drop by exact line index without rebuilding the bag
# via SYS GREP/PUSH glue. First realworld of 1468 FINDLINEIN/SETLINEIN/
# DROPNTHIN (1.15.923+ · MI ~930) + 1469 INSERTLINEIN/INSLINEIN.
# Distinct from file_line_surgery (file MOVELINE) and ordered_runbook
# (scripted steps) — this board is *named-var bag index line ops*.
#
#   FINDLINEIN · SETLINEIN · DROPNTHIN|DROPATIN · INSERTLINEIN|INSLINEIN
#   + ENSUREIN/DROPLINEIN exact ack · LINESIN · HASINBAG
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_flr_$$
#   ./out/cubalc run programs/realworld/svc_findlinein_runbook_board.cubalc boot
#   ./out/cubalc run ... pass|soft|peel|scale|form|gate|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt FLR_REPORT.txt agent.json
# Env: HOST_S ROLE_S CUBALC_FLR_REQUIRE
#
# Edges: FINDLINEIN miss=-1; SETLINEIN past-end pads blanks; DROP OOR HIT=0;
#   exact find not substring; INSERT past-end appends; SETLINEIN -1 odd;
#   capture LAST_N before PRINT/CLEAR_ERR; WRITE NL; REQUIRE soft

INCLUDE agent_boot
# bare REQUIRE LIB hold_seed broken (W773) — quoted stem required
REQUIRE LIB "hold_seed"

NOTE "svc_findlinein_runbook_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_findlinein_runbook -- boot|pass|soft|peel|scale|form|gate|probe|list|clear"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeR"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_FLR_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "FLR_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET ok_v = 0
LET path = ""
LET msg = ""
LET peeld = ""
LET work = ""
LET idx = 0
LET depth = 0
LET weight = 0

ONEOF ACTION "boot", "pass", "soft", "peel", "scale", "form", "gate", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "pass" THEN
    LET op = "pass"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "peel" THEN
    LET op = "peel"
  WHEN "scale" THEN
    LET op = "scale"
  WHEN "form" THEN
    LET op = "form"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS CAT "{\"agent\":\"svc-flr\",\"schema\":\"cubalc.svc_findlinein_runbook.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"label\":\"flr\",\"want_filter\":\"findlinein_runbook\",\"cfg\":{\"surface\":\"FINDLINEIN,SETLINEIN,DROPNTHIN,DROPATIN,INSERTLINEIN,INSLINEIN,ENSUREIN,DROPLINEIN\",\"contract\":\"named-var runbook step bag index ops: find/set/insert/drop exact lines\"}}"
  LET body = LAST
  CLEAR_ERR
  SYS WRITE agent_path body
  CLEAR_ERR
  # seed queue + promote one step
  CLEARSTR work
  PUSHTO work "todo:boot"
  PUSHTO work "todo:deploy"
  PUSHTO work "todo:smoke"
  FINDLINEIN work "todo:deploy"
  LET idx = LAST_N
  CLEAR_ERR
  SETLINEIN work idx "doing:deploy"
  CLEAR_ERR
  IF SETLINEIN_HIT == 1 THEN
    IF idx == 1 THEN
      LET hit = 1
      LET note_msg = "boot ok"
      LET admit_n = 1
      LET score = 1
      LET find_n = idx
    ELSE
      LET miss = 1
      LET note_msg = "boot idx"
      FAIL "boot idx"
      CLEAR_ERR
    END
  ELSE
    LET miss = 1
    LET note_msg = "boot set"
    FAIL "boot set"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n note_msg
  CLEAR_ERR
END

# pass — FINDLINEIN/SETLINEIN/DROPNTHIN/INSERTLINEIN core 10/10
SYS EQS op "pass"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "a"
  PUSHTO work "b"
  PUSHTO work "c"
  CLEAR_ERR
  FINDLINEIN work "b"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 1 THEN
    LET score = score + 1
  END
  SETLINEIN work idx "B"
  CLEAR_ERR
  IF SETLINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  FINDLINEIN work "B"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  SYS EQS work "a
B
c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  DROPNTHIN work 1
  CLEAR_ERR
  IF DROPNTHIN_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS work "a
c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  INSERTLINEIN work 1 "b"
  CLEAR_ERR
  IF INSERTLINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  SYS EQS work "a
b
c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  INSERTLINEIN work 0 "head"
  CLEAR_ERR
  SYS EQS work "head
a
b
c"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  INSLINEIN work 99 "tail"
  CLEAR_ERR
  SYS EQS work "head
a
b
c
tail"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "pass ok"
    LET admit_n = 1
    LET find_n = 10
  ELSE
    LET miss = 1
    LET note_msg = "pass score"
    FAIL "pass score"
    CLEAR_ERR
  END
  SYS CAT "pass:" score ":ok"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "pass:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# soft — miss paths · OOR · substring false friends · empty · pad
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "error:timeout"
  PUSHTO work "ok"
  PUSHTO work "error"
  CLEAR_ERR
  # miss find
  FINDLINEIN work "missing"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == -1 THEN
    LET score = score + 1
  END
  # exact not substring: "error" ≠ "error:timeout"
  FINDLINEIN work "error"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 2 THEN
    LET score = score + 1
  END
  FINDLINEIN work "error:timeout"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 0 THEN
    LET score = score + 1
  END
  # DROPLINEIN exact ack only
  DROPLINEIN work "error"
  CLEAR_ERR
  IF DROPLINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  HASINBAG work "error:timeout"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # DROP OOR
  DROPNTHIN work 99
  CLEAR_ERR
  IF DROPNTHIN_HIT == 0 THEN
    LET score = score + 1
  END
  # empty bag SETLINEIN
  CLEARSTR empty
  SETLINEIN empty 0 "first"
  CLEAR_ERR
  SYS EQS empty "first"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # SETLINEIN past end pads
  LET short = "x"
  SETLINEIN short 2 "z"
  CLEAR_ERR
  LINESIN short
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  IF SETLINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  # host default
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
    LET find_n = 0
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  SYS CAT "soft:" score ":sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# peel — real runbook promote/ack/insert-blocker flow
SYS EQS op "peel"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  ENSUREIN work "todo:preflight"
  ENSUREIN work "todo:deploy"
  ENSUREIN work "todo:smoke"
  ENSUREIN work "todo:deploy"
  CLEAR_ERR
  # ENSUREIN de-dup
  LINESIN work
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  IF ENSUREIN_HIT == 0 THEN
    LET score = score + 1
  END
  # promote deploy
  FINDLINEIN work "todo:deploy"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 1 THEN
    LET score = score + 1
  END
  SETLINEIN work idx "doing:deploy"
  CLEAR_ERR
  FINDLINEIN work "doing:deploy"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  # insert freeze blocker at head
  INSERTLINEIN work 0 "blocker:freeze"
  CLEAR_ERR
  FINDLINEIN work "blocker:freeze"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 0 THEN
    LET score = score + 1
  END
  # complete smoke → drop exact
  FINDLINEIN work "todo:smoke"
  LET idx = LAST_N
  CLEAR_ERR
  SETLINEIN work idx "done:smoke"
  CLEAR_ERR
  FINDLINEIN work "done:smoke"
  IF LAST_N >= 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # ack drop blocker by exact DROPLINEIN
  DROPLINEIN work "blocker:freeze"
  CLEAR_ERR
  IF DROPLINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  FINDLINEIN work "blocker:freeze"
  IF LAST_N == -1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LINESIN work
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "findlinein_runbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "peel ok"
    LET admit_n = 1
    LET find_n = depth
  ELSE
    LET miss = 1
    LET note_msg = "peel score"
    FAIL "peel score"
    CLEAR_ERR
  END
  SYS CAT "peel:" score ":pl"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "peel:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score depth note_msg
  CLEAR_ERR
END

# scale — priority insert + DROPATIN + multi promote
SYS EQS op "scale"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  LET work = "low
med
high"
  CLEAR_ERR
  FINDLINEIN work "high"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 2 THEN
    LET score = score + 1
  END
  INSERTLINEIN work 0 "urgent"
  CLEAR_ERR
  FINDLINEIN work "urgent"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # re-find high after insert shifted
  FINDLINEIN work "high"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx == 3 THEN
    LET score = score + 1
  END
  SETLINEIN work 1 "low2"
  CLEAR_ERR
  FINDLINEIN work "low2"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # DROPATIN head
  DROPATIN work 0
  CLEAR_ERR
  FINDLINEIN work "urgent"
  IF LAST_N == -1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # promote med → doing
  FINDLINEIN work "med"
  LET idx = LAST_N
  CLEAR_ERR
  SETLINEIN work idx "doing:med"
  CLEAR_ERR
  HASINBAG work "doing:med"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LINESIN work
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  # INSERT empty bag
  CLEARSTR empty
  INSERTLINEIN empty 0 "first"
  CLEAR_ERR
  SYS EQS empty "first"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "INSERTLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "scale ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "scale score"
    FAIL "scale score"
    CLEAR_ERR
  END
  SYS CAT "scale:" score ":sc"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "scale:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# form — HASFORM surface
SYS EQS op "form"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  HASFORM "FINDLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "SETLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "DROPNTHIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "DROPATIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "INSERTLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "INSLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "ENSUREIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "DROPLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASFORM "LINESIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "findlinein_runbook"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "form ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "form score"
    FAIL "form score"
    CLEAR_ERR
  END
  SYS CAT "form:" score ":fm"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "form:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# gate — admit when doing step present and no blockers
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "todo:preflight"
  PUSHTO work "doing:deploy"
  PUSHTO work "todo:smoke"
  CLEAR_ERR
  FINDLINEIN work "doing:deploy"
  LET idx = LAST_N
  CLEAR_ERR
  IF idx >= 0 THEN
    LET score = score + 1
  END
  FINDLINEIN work "blocker:"
  # exact only — should miss prefix-ish
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == -1 THEN
    LET score = score + 1
  END
  # substring false friend: no exact "deploy" line
  FINDLINEIN work "deploy"
  IF LAST_N == -1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  HASINBAG work "doing:deploy"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  LINESIN work
  LET depth = LAST_N
  CLEAR_ERR
  IF depth == 3 THEN
    LET score = score + 1
  END
  # REQUIRE soft optional wall
  IF require_hit > 0 THEN
    IF depth < 1 THEN
      LET miss = 1
      LET note_msg = "gate require"
      FAIL "gate require"
      CLEAR_ERR
    END
  END
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "svc-flr"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS host_s "cubeR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS EQS role_s "worker"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # promote smoke then re-check
  FINDLINEIN work "todo:smoke"
  LET idx = LAST_N
  CLEAR_ERR
  SETLINEIN work idx "doing:smoke"
  CLEAR_ERR
  FINDLINEIN work "doing:smoke"
  IF LAST_N >= 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  SYS CAT "gate:" score ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + WRITE NL + SETLINEIN -1 edge note
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET score = 0
  CLEARSTR work
  PUSHTO work "step-a"
  PUSHTO work "step-b"
  CLEAR_ERR
  FINDLINEIN work "step-b"
  LET idx = LAST_N
  CLEAR_ERR
  # capture before PRINT (W4)
  LET saved = idx
  PRINT "probe-idx" saved
  CLEAR_ERR
  IF saved == 1 THEN
    LET score = score + 1
  END
  SETLINEIN work saved "step-B"
  CLEAR_ERR
  FINDLINEIN work "step-B"
  LET find_n = LAST_N
  CLEAR_ERR
  IF find_n == 1 THEN
    LET score = score + 1
  END
  # negative index oddity: SETLINEIN -1 may hit index 0
  LET negq = "a
b"
  SETLINEIN negq -1 "X"
  CLEAR_ERR
  FINDLINEIN negq "X"
  LET weight = LAST_N
  CLEAR_ERR
  # document whatever happened — score if HIT was set
  IF SETLINEIN_HIT == 1 THEN
    LET score = score + 1
  END
  STRTO saved
  SYS WRITE val_path saved
  CLEAR_ERR
  SYS READ val_path
  LET body = LAST
  CLEAR_ERR
  SYS EQS body "1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS CAT "flr host=" host_s " role=" role_s " idx=" saved
  LET row = LAST
  CLEAR_ERR
  SYS WRITE meta_path row
  CLEAR_ERR
  SYS READ meta_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "idx=1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS READ agent_path
  LET body = LAST
  CLEAR_ERR
  SYS HAS body "FINDLINEIN"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score >= 5 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" score ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score find_n weight note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET bag_n = 0
  LET hit = 1
  LET note_msg = "clear ok"
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS CAT "{\"ok\":true,\"agent\":\"svc-flr\",\"op\":\"" op "\",\"hit\":" hit ",\"miss\":" miss ",\"score\":" score ",\"admit_n\":" admit_n ",\"bag_n\":" bag_n ",\"host\":\"" host_s "\",\"role\":\"" role_s "\",\"note\":\"" note_msg "\",\"require_hit\":" require_hit "}"
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

IF miss == 1 THEN
  IF hit == 0 THEN
    EXIT 1 note_msg
  END
END

PASS
