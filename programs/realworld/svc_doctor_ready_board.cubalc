# svc_doctor_ready_board.cubalc — DOCTOR fleet install readiness gate
#
# Real use: fleet agents gate cold-start on install readiness (DOCTOR /
# INSTALL_HEALTH), fail-fast with NEEDDOCTOR/REQUIRE DOCTOR, then chain
# open_boot playbook when green. First realworld of proof 1356 DOCTOR.
#
#   DOCTOR|INSTALL_HEALTH → DOCTOR_OK · DOCTOR_LIBS_N · DOCTOR_* flags
#     cubalc.doctor.v1 plate
#   NEEDDOCTOR|REQUIRE DOCTOR fail-fast when not ready
#   chain INCLUDE open_boot after readiness
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_drd_$$
#   ./out/cubalc run programs/realworld/svc_doctor_ready_board.cubalc boot
#   ./out/cubalc run ... ready|gate|chain|soft|alias|probe|list
#
# Plate: STATUS.txt VAL.txt META.txt DRD_REPORT.txt agent.json peer.json
# Env: HOST_S ROLE_S CUBALC_DRD_REQUIRE
#
# Edges: PRINT clobbers doctor JSON; capture body before PRINT; DOCTOR_N
#   unset (use DOCTOR_LIBS_N); SMX key flag false without env; WRITE NL

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "svc_doctor_ready_board: start"
DEFAULT ACTION = "list"
DEFAULT USAGE_LINE = "svc_doctor_ready -- boot|ready|gate|chain|soft|alias|probe|list -- [--host=H] [--role=R]"
IDENTITY
SYS DATE
LET run_date = DATE

USAGE USAGE_LINE
CLEAR_ERR

SUBCMD OR "list"
LET ACTION = LAST
CLEAR_ERR

SYS STATE
LET state_dir = LAST
CLEAR_ERR

DEFAULT HOST_S = "cubeT"
GETFLAG host|h OR ENV HOST_S OR HOST_S
LET host_s = LAST
CLEAR_ERR

DEFAULT ROLE_S = "worker"
GETFLAG role|r OR ENV ROLE_S OR ROLE_S
LET role_s = LAST
CLEAR_ERR

LET require_hit = 0
SYS ENV "CUBALC_DRD_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET require_hit = LAST_N
  END
END
CLEAR_ERR

SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR

SYS JOIN state_dir "STATUS.txt"
LET plate_path = LAST
SYS JOIN state_dir "agent.json"
LET agent_path = LAST
SYS JOIN state_dir "peer.json"
LET peer_path = LAST
SYS JOIN state_dir "VAL.txt"
LET val_path = LAST
SYS JOIN state_dir "META.txt"
LET meta_path = LAST
SYS JOIN state_dir "DRD_REPORT.txt"
LET report_path = LAST

SYS READ OR plate_path OR ""
LET bag = LAST
CLEAR_ERR

LET hit = 0
LET miss = 0
LET bag_ch = 0
LET bag_n = 0
LET known = 0
LET note_msg = "ok"
LET admit_n = 0
LET op = "unknown"
LET find_n = 0
LET score = 0
LET row = ""
LET body = ""
LET sum_v = 0
LET sum_n = 0
LET stem_s = ""
LET libs_n = 0
LET topic_got = ""

ONEOF ACTION "boot", "ready", "gate", "chain", "soft", "alias", "probe", "list", "ls", "clear"
CLEAR_ERR

CASEI ACTION
  WHEN "list", "ls" THEN
    LET op = "list"
  WHEN "boot" THEN
    LET op = "boot"
  WHEN "ready" THEN
    LET op = "ready"
  WHEN "gate" THEN
    LET op = "gate"
  WHEN "chain" THEN
    LET op = "chain"
  WHEN "soft" THEN
    LET op = "soft"
  WHEN "alias" THEN
    LET op = "alias"
  WHEN "probe" THEN
    LET op = "probe"
  WHEN "clear" THEN
    LET op = "clear"
  DEFAULT
    LET op = "unknown"
END

SYS EQS op "unknown"
IF LAST_N == 1 THEN
  LET miss = 1
  LET note_msg = "unknown subcmd"
  FAIL "unknown subcmd"
  CLEAR_ERR
  EXIT 2 "unknown subcmd"
END

SYS EQS op "list"
IF LAST_N == 1 THEN
  LET known = 1
  LET hit = 1
  LET note_msg = "list ok"
  PRINT_JSON bag_n host_s role_s
  CLEAR_ERR
END

SYS EQS op "boot"
IF LAST_N == 1 THEN
  LET known = 1
  SYS TRIM host_s
  LET host_s = LAST
  SYS TRIM role_s
  LET role_s = LAST
  CLEAR_ERR
  LET PLATE_PATH = agent_path
  SYS CAT "{\"agent\":\"svc-drd\",\"schema\":\"cubalc.svc_doctor_ready.v1\",\"site\":\"" host_s "\",\"role\":\"" role_s "\",\"want_filter\":\"doctor_ready\",\"label\":\"drd\",\"cfg\":{\"surface\":\"DOCTOR,INSTALL_HEALTH,NEEDDOCTOR,REQUIRE DOCTOR\",\"min_libs\":20}}"
  LET PLATE_SEED = LAST
  CLEAR_ERR
  LET PEER_PATH = peer_path
  SYS CAT "{\"peer\":\"doctor_ready\",\"n\":1}"
  LET PEER_SEED = LAST
  CLEAR_ERR
  INCLUDE plate_peer_session
  CLEAR_ERR
  SYS SAVEPLATE agent_path PLATE
  CLEAR_ERR
  LET score = 0
  GETP "agent"
  SYS EQS LAST "svc-drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "svc_doctor_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "doctor_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "DOCTOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 5 THEN
    LET hit = 1
    LET note_msg = "boot ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "boot score"
    FAIL "boot score"
    CLEAR_ERR
  END
  SYS CAT "boot:seed:bt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "boot:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# ready — DOCTOR plate inventory
SYS EQS op "ready"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  DOCTOR
  LET body = LAST
  LET sum_v = DOCTOR_OK
  LET libs_n = DOCTOR_LIBS_N
  LET sum_n = OK
  CLEAR_ERR
  IF sum_n == 1 THEN
    LET score = score + 1
  END
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF libs_n >= 20 THEN
    LET score = score + 1
  END
  IF DOCTOR_AGENT_BOOT == 1 THEN
    LET score = score + 1
  END
  IF DOCTOR_MODULAR == 1 THEN
    LET score = score + 1
  END
  IF DOCTOR_HOLD == 1 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.doctor.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "lib_agent_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "lib_open_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "lib_hold_seed"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "DOCTOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 12 THEN
    LET hit = 1
    LET note_msg = "ready ok"
    LET admit_n = 1
    LET find_n = libs_n
  ELSE
    # allow 11 if smx-related HAS soft
    IF score >= 10 THEN
      LET hit = 1
      LET note_msg = "ready ok"
      LET admit_n = 1
      LET find_n = libs_n
    ELSE
      LET miss = 1
      LET note_msg = "ready score"
      FAIL "ready score"
      CLEAR_ERR
    END
  END
  SYS CAT "ready:" libs_n ":rd"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "ready:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n libs_n sum_v score note_msg
  CLEAR_ERR
END

# gate — NEEDDOCTOR + plate surface
SYS EQS op "gate"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  NEEDDOCTOR
  LET sum_v = OK
  LET libs_n = DOCTOR_LIBS_N
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF DOCTOR_OK == 1 THEN
    LET score = score + 1
  END
  IF libs_n >= 20 THEN
    LET score = score + 1
  END
  GETP "cfg.surface"
  SYS HAS LAST "NEEDDOCTOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "REQUIRE DOCTOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "doctor_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "doctor_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.min_libs"
  SYS NUM
  IF LAST_N == 20 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "gate ok"
    LET admit_n = 1
    LET find_n = libs_n
  ELSE
    LET miss = 1
    LET note_msg = "gate score"
    FAIL "gate score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE gate denied"
    END
  END
  SYS CAT "gate:" hit ":gt"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "gate:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n libs_n score note_msg
  CLEAR_ERR
END

# chain — DOCTOR then open_boot playbook
SYS EQS op "chain"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  DOCTOR
  LET body = LAST
  LET libs_n = DOCTOR_LIBS_N
  CLEAR_ERR
  IF DOCTOR_OK == 1 THEN
    LET score = score + 1
  END
  SYS HASI body "cubalc.doctor.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  INCLUDE open_boot
  LET topic_got = OPEN_FIRST
  LET sum_n = OPEN_N
  CLEAR_ERR
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF sum_n >= 1 THEN
    LET score = score + 1
  END
  SYS EQS topic_got "general"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF GUIDE_RELATED_N >= 3 THEN
    LET score = score + 1
  END
  RUNSNIP OPEN_FIRST
  IF RUNSNIP_OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "want_filter"
  SYS EQS LAST "doctor_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "INSTALL_HEALTH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "chain ok"
    LET admit_n = 1
    LET find_n = libs_n
  ELSE
    LET miss = 1
    LET note_msg = "chain score"
    FAIL "chain score"
    CLEAR_ERR
  END
  SYS CAT "chain:" topic_got ":ch"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "chain:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n libs_n topic_got score note_msg
  CLEAR_ERR
END

# soft — aliases + SMX flag observation (not hard miss on healthy host)
SYS EQS op "soft"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  INSTALL_HEALTH
  LET body = LAST
  LET libs_n = DOCTOR_LIBS_N
  CLEAR_ERR
  IF DOCTOR_OK == 1 THEN
    LET score = score + 1
  END
  IF OK == 1 THEN
    LET score = score + 1
  END
  IF libs_n >= 20 THEN
    LET score = score + 1
  END
  # in-lang DOCTOR plate is slim vs CLI (no http_required — W*)
  SYS HASI body "smx_key_configured"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "modular_lang"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI body "lib_open_boot"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # NEEDDOCTOR when healthy (REQUIRE DOCTOR two-word loses to REQUIRE parser)
  NEEDDOCTOR
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "agent"
  SYS EQS LAST "svc-drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "INSTALL_HEALTH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 10 THEN
    LET hit = 1
    LET note_msg = "soft ok"
    LET admit_n = 1
  ELSE
    LET miss = 1
    LET note_msg = "soft score"
    FAIL "soft score"
    CLEAR_ERR
  END
  IF require_hit > 0 THEN
    IF hit == 0 THEN
      EXIT 2 "REQUIRE soft denied"
    END
  END
  SYS CAT "soft:ok1:sf"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "soft:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n score note_msg
  CLEAR_ERR
END

# alias — INSTALL_HEALTH + REQUIRE DOCTOR wording
SYS EQS op "alias"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  INSTALL_HEALTH
  LET libs_n = DOCTOR_LIBS_N
  CLEAR_ERR
  IF DOCTOR_OK == 1 THEN
    LET score = score + 1
  END
  IF libs_n >= 20 THEN
    LET score = score + 1
  END
  IF DOCTOR_AGENT_BOOT == 1 THEN
    LET score = score + 1
  END
  IF DOCTOR_MODULAR == 1 THEN
    LET score = score + 1
  END
  NEEDDOCTOR
  IF OK == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "INSTALL_HEALTH"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "NEEDDOCTOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "label"
  SYS EQS LAST "drd"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 8 THEN
    LET hit = 1
    LET note_msg = "alias ok"
    LET admit_n = 1
    LET find_n = libs_n
  ELSE
    LET miss = 1
    LET note_msg = "alias score"
    FAIL "alias score"
    CLEAR_ERR
  END
  SYS CAT "alias:1:as"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "alias:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n libs_n score note_msg
  CLEAR_ERR
END

# probe — PRINT clobber + wrong knobs + substring false friends
SYS EQS op "probe"
IF LAST_N == 1 THEN
  LET known = 1
  LET PLATE_PATH = agent_path
  LET PEER_PATH = peer_path
  INCLUDE plate_peer_session
  CLEAR_ERR
  LET score = 0
  DOCTOR
  LET body = LAST
  LET libs_n = DOCTOR_LIBS_N
  LET sum_v = DOCTOR_OK
  CLEAR_ERR
  LET stem_s = body
  PRINT "probe-mark"
  CLEAR_ERR
  SYS HASI stem_s "cubalc.doctor.v1"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  SYS HASI LAST "cubalc.doctor.v1"
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF sum_v == 1 THEN
    LET score = score + 1
  END
  IF libs_n >= 20 THEN
    LET score = score + 1
  END
  # DOCTOR_N is wrong knob — DISCOVER-style false friend
  DEFINED DOCTOR_N
  IF LAST_N == 0 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  DEFINED DOCTOR_LIBS_N
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  # substring HAS vs schema
  SYS HAS stem_s "doctor"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "schema"
  SYS HAS LAST "doctor_ready"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  GETP "cfg.surface"
  SYS HAS LAST "DOCTOR"
  IF LAST_N == 1 THEN
    LET score = score + 1
  END
  CLEAR_ERR
  IF score == 9 THEN
    LET hit = 1
    LET note_msg = "probe ok"
    LET admit_n = 1
    LET find_n = libs_n
  ELSE
    LET miss = 1
    LET note_msg = "probe score"
    FAIL "probe score"
    CLEAR_ERR
  END
  SYS CAT "probe:" libs_n ":pb"
  LET row = LAST
  CLEAR_ERR
  SYS GREPV "probe:" bag
  LET bag = LAST
  CLEAR_ERR
  SYS PUSH bag row
  LET bag = LAST
  LET bag_ch = 1
  SYS LINES bag
  LET bag_n = LAST_N
  PRINT_JSON bag_n libs_n score note_msg
  CLEAR_ERR
END

SYS EQS op "clear"
IF LAST_N == 1 THEN
  LET known = 1
  LET bag = ""
  LET bag_ch = 1
  LET hit = 1
  LET note_msg = "clear ok"
  LET bag_n = 0
  PRINT_JSON bag_n note_msg
  CLEAR_ERR
END

IF bag_ch == 1 THEN
  SYS WRITE plate_path bag
  CLEAR_ERR
END

SYS STR hit
LET body = LAST
CLEAR_ERR
SYS STR miss
LET row = LAST
CLEAR_ERR
SYS CAT "hit=" body " miss=" row " op=" op " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE val_path body
CLEAR_ERR

SYS CAT "schema=cubalc.svc_doctor_ready.v1 host=" host_s " role=" role_s " req=" require_hit " date=" run_date
LET body = LAST
CLEAR_ERR
SYS WRITE meta_path body
CLEAR_ERR

SYS CAT "op=" op " hit=" hit " miss=" miss " admit=" admit_n " find_n=" find_n " libs_n=" libs_n " topic=" topic_got " score=" score " note=" note_msg
LET body = LAST
CLEAR_ERR
SYS WRITE report_path body
CLEAR_ERR

IF require_hit > 0 THEN
  IF miss == 1 THEN
    EXIT 2 "REQUIRE miss"
  END
  IF hit == 0 THEN
    IF known == 1 THEN
      EXIT 2 "REQUIRE no hit"
    END
  END
END

IF hit == 0 THEN
  IF known == 1 THEN
    EXIT 1 note_msg
  END
END

NOTE "svc_doctor_ready_board: done"
PASS
