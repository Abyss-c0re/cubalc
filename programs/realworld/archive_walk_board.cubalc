# archive_walk_board.cubalc — recursive archive via WALK + MOVEALL + EQFILE
#
# Real use: ops agent walks a deep drop tree (beyond non-recursive PATHGLOB),
# filters files, bulk-moves reclaim candidates into an archive dir (MOVEALL),
# and verifies staged copies with EQFILE/SAMEFILE without shell find/cmp.
# Distinct from release_stage_board (flat PATHGLOB+COPYALL) and
# cache_reclaim_board (size RMALL): this board is recursive discovery +
# relocate + content identity probe.
#
# Plate under STATE:
#   PATHS.txt          — walked/filtered full paths
#   MOVED.txt          — last MOVEALL dest paths
#   DEST.txt           — archive/stage dest dir
#   ARCHIVE_REPORT.txt
#
# Actions (CUBALC_ARG0 / CUBALC_AW_ACTION):
#   list      — depths (default)
#   walk      — WALK ROOT PAT → PATHS (ROOT default DIR/STATE)
#   files     — KEEPFILES PATHS
#   dest      — set DEST (ARG1) persist DEST.txt
#   archive   — MOVEALL PATHS DEST → MOVED
#   stage     — COPYALL PATHS DEST → MOVED (copy not move)
#   eq        — EQFILE ARG1 ARG2 content identity
#   has       — HASLINE exact on PATHS
#   clear
#
# Host:
#   export CUBALC_STATE=/tmp/cubalc_aw_$$
#   mkdir -p "$CUBALC_STATE/drop/sub/deep"
#   # fixtures at multiple depths
#   CUBALC_AW_ROOT=$CUBALC_STATE/drop CUBALC_ARG0=walk CUBALC_ARG1='*.plate' \
#     ./out/cubalc run -q -s programs/realworld/archive_walk_board.cubalc
#   CUBALC_ARG0=files ./out/cubalc run -q -s ...
#   CUBALC_ARG0=dest CUBALC_ARG1=$CUBALC_STATE/archive ./out/cubalc run -q -s ...
#   CUBALC_ARG0=archive ./out/cubalc run -q -s ...
#
# Env:
#   CUBALC_AW_ROOT=…  CUBALC_AW_DIR=…  CUBALC_AW_PAT=*
#   CUBALC_AW_DEST=…  CUBALC_AW_REQUIRE=1
#
# Edges deliberately stressed:
#   WALK includes dirs; pattern basename-only at any depth
#   WALK file root soft miss OK=0
#   MOVEALL/COPYALL basename flatten collisions
#   EQFILE equal/differ/miss/dir soft
#   FIND string vs FINDALL walk naming trap
#   WRITE NL; PRINT_JSON; soft READ; REQUIRE

INCLUDE agent_boot
REQUIRE LIB hold_seed

NOTE "archive_walk_board: start"
DEFAULT ACTION = "list"
DEFAULT NAME = ""
DEFAULT A2 = ""
DEFAULT PFILE = "PATHS.txt"
DEFAULT MFILE = "MOVED.txt"
DEFAULT DESTFILE = "DEST.txt"
DEFAULT REPORT = "ARCHIVE_REPORT.txt"
DEFAULT REQUIRE_HIT = 0
DEFAULT PAT = "*"
DEFAULT DIR = ""
DEFAULT ROOT = ""
DEFAULT DEST = ""
IDENTITY
SYS DATE
LET run_date = DATE
SYS MS
LET t0 = MS

SYS ARG 0 OR ""
IF LAST_N > 0 THEN
  LET ACTION = LAST
ELSE
  SYS ENV "CUBALC_AW_ACTION" OR "list"
  LET ACTION = LAST
END
SYS ARG 1 OR ""
IF LAST_N > 0 THEN
  LET NAME = LAST
ELSE
  SYS ENV "CUBALC_AW_NAME" OR ""
  LET NAME = LAST
END
SYS ARG 2 OR ""
IF LAST_N > 0 THEN
  LET A2 = LAST
ELSE
  SYS ENV "CUBALC_AW_A2" OR ""
  LET A2 = LAST
END
SYS ENV "CUBALC_AW_REQUIRE" OR ""
IF LAST_N > 0 THEN
  SYS NUM
  IF OK == 1 THEN
    LET REQUIRE_HIT = LAST_N
  END
END
SYS ENV "CUBALC_AW_PAT" OR ""
IF LAST_N > 0 THEN
  LET PAT = LAST
END
SYS ENV "CUBALC_AW_DIR" OR ""
IF LAST_N > 0 THEN
  LET DIR = LAST
END
SYS ENV "CUBALC_AW_ROOT" OR ""
IF LAST_N > 0 THEN
  LET ROOT = LAST
END
SYS ENV "CUBALC_AW_DEST" OR ""
IF LAST_N > 0 THEN
  LET DEST = LAST
END

SYS STATE
LET state_dir = LAST
SYS MKDIR state_dir
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "mkdir STATE failed"
END
CLEAR_ERR
SYS BLANK DIR
IF LAST_N == 1 THEN
  LET DIR = state_dir
END
SYS JOIN state_dir PFILE
LET paths_path = LAST
SYS JOIN state_dir MFILE
LET moved_path = LAST
SYS JOIN state_dir DESTFILE
LET dest_path = LAST
SYS JOIN state_dir REPORT
LET report_path = LAST

SYS READ OR paths_path OR ""
LET paths = LAST
CLEAR_ERR
SYS READ OR moved_path OR ""
LET moved = LAST
CLEAR_ERR
SYS READ OR dest_path OR ""
LET dest_stored = LAST
CLEAR_ERR
SYS BLANK DEST
IF LAST_N == 1 THEN
  SYS BLANK dest_stored
  IF LAST_N == 0 THEN
    LET DEST = dest_stored
  ELSE
    SYS JOIN state_dir "archive"
    LET DEST = LAST
  END
END
SYS BLANK ROOT
IF LAST_N == 1 THEN
  LET ROOT = DIR
END

LET hit = 0
LET miss = 0
LET paths_ch = 0
LET moved_ch = 0
LET dest_ch = 0
LET note_msg = "ok"
LET val_s = ""
LET val_n = 0
LET walk_n = 0
LET walk_files = 0
LET walk_dirs = 0
LET keep_n = 0
LET drop_n = 0
LET move_n = 0
LET move_miss = 0
LET move_fail = 0
LET eq_n = 0
LET eq_bytes = 0

SYS EQS ACTION "walk"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET PAT = NAME
  END
END
SYS EQS ACTION "dest"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 0 THEN
    LET DEST = NAME
  END
END
SYS EQS ACTION "eq"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "eq needs path_a path_b"
  END
  SYS BLANK A2
  IF LAST_N == 1 THEN
    EXIT 2 "eq needs path_b"
  END
END
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  SYS BLANK NAME
  IF LAST_N == 1 THEN
    EXIT 2 "has needs path"
  END
END

# --- list ---
SYS EQS ACTION "list"
IF LAST_N == 1 THEN
  NOTE "action list"
  LET hit = 1
  SYS LINES paths
  LET np = LAST_N
  SYS LINES moved
  LET nm = LAST_N
  CLEAR_ERR
  STATUS
  PRINT "awalk" np nm ROOT DEST ACTION
  PRINT_JSON np nm ROOT DEST ACTION STATUS_OK
  PRINT_JSON paths
  PRINT_JSON moved
  LET note_msg = "list ok"
END

# --- walk ---
SYS EQS ACTION "walk"
IF LAST_N == 1 THEN
  NOTE "action walk"
  SYS WALK ROOT PAT
  IF OK == 0 THEN
    LET miss = 1
    LET paths = ""
    LET paths_ch = 1
    LET note_msg = "walk miss"
    FAIL "walk miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "walk miss"
    END
  ELSE
    LET paths = LAST
    LET walk_n = WALK_N
    LET walk_files = WALK_FILES
    LET walk_dirs = WALK_DIRS
    LET paths_ch = 1
    LET hit = walk_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "walk empty"
      FAIL "walk empty"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "walk empty"
      END
    ELSE
      LET note_msg = "walk ok"
    END
    PRINT_JSON PAT walk_n walk_files walk_dirs ROOT
    PRINT_JSON paths
  END
END

# --- files ---
SYS EQS ACTION "files"
IF LAST_N == 1 THEN
  NOTE "action files"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "files empty"
    FAIL "files empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "files empty"
    END
  ELSE
    SYS KEEPFILES paths
    LET paths = LAST
    LET keep_n = KEEPFILES_N
    LET drop_n = KEEPFILES_DROP
    LET paths_ch = 1
    LET hit = keep_n
    SYS BLANK paths
    IF LAST_N == 1 THEN
      LET miss = 1
      LET note_msg = "files none"
      FAIL "files none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "files none"
      END
    ELSE
      LET note_msg = "files ok"
    END
    PRINT_JSON keep_n drop_n
    PRINT_JSON paths
  END
END

# --- dest ---
SYS EQS ACTION "dest"
IF LAST_N == 1 THEN
  NOTE "action dest"
  SYS BLANK DEST
  IF LAST_N == 1 THEN
    EXIT 2 "dest needs path"
  END
  LET dest_stored = DEST
  LET dest_ch = 1
  LET hit = 1
  LET val_s = DEST
  LET note_msg = "dest ok"
  PRINT_JSON DEST
END

# --- archive MOVEALL ---
SYS EQS ACTION "archive"
IF LAST_N == 1 THEN
  NOTE "action archive"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "archive empty"
    FAIL "archive empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "archive empty"
    END
  ELSE
    SYS BLANK DEST
    IF LAST_N == 1 THEN
      EXIT 2 "archive needs dest"
    END
    SYS MKDIR DEST
    CLEAR_ERR
    SYS MOVEALL paths DEST
    LET moved = LAST
    LET move_n = MOVEALL_N
    LET move_miss = MOVEALL_MISS
    LET move_fail = MOVEALL_FAIL
    LET hit = move_n
    LET moved_ch = 1
    IF move_n == 0 THEN
      LET miss = 1
      LET note_msg = "archive none"
      FAIL "archive none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "archive none"
      END
    ELSE
      LET note_msg = "archive ok"
      # sources gone — clear paths to moved
      LET paths = ""
      LET paths_ch = 1
    END
    PRINT_JSON move_n move_miss move_fail DEST
    PRINT_JSON moved
    CLEAR_ERR
  END
END

# --- stage COPYALL ---
SYS EQS ACTION "stage"
IF LAST_N == 1 THEN
  NOTE "action stage"
  SYS BLANK paths
  IF LAST_N == 1 THEN
    LET miss = 1
    LET note_msg = "stage empty"
    FAIL "stage empty"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "stage empty"
    END
  ELSE
    SYS BLANK DEST
    IF LAST_N == 1 THEN
      EXIT 2 "stage needs dest"
    END
    SYS MKDIR DEST
    CLEAR_ERR
    SYS COPYALL paths DEST
    LET moved = LAST
    LET move_n = COPYALL_N
    LET move_miss = COPYALL_MISS
    LET move_fail = COPYALL_FAIL
    LET hit = move_n
    LET moved_ch = 1
    IF move_n == 0 THEN
      LET miss = 1
      LET note_msg = "stage none"
      FAIL "stage none"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "stage none"
      END
    ELSE
      LET note_msg = "stage ok"
    END
    PRINT_JSON move_n move_miss move_fail COPYALL_BYTES DEST
    PRINT_JSON moved
    CLEAR_ERR
  END
END

# --- eq EQFILE ---
SYS EQS ACTION "eq"
IF LAST_N == 1 THEN
  NOTE "action eq"
  SYS EQFILE NAME A2
  IF OK == 0 THEN
    LET miss = 1
    LET eq_n = 0
    LET val_n = 0
    LET note_msg = "eq soft miss"
    FAIL "eq soft miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "eq soft miss"
    END
  ELSE
    LET eq_n = EQFILE
    LET val_n = EQFILE
    LET eq_bytes = EQFILE_BYTES
    LET hit = eq_n
    IF eq_n == 0 THEN
      LET miss = 1
      LET note_msg = "eq differ"
      FAIL "eq differ"
      CLEAR_ERR
      IF REQUIRE_HIT > 0 THEN
        EXIT 2 "eq differ"
      END
    ELSE
      LET note_msg = "eq ok"
    END
  END
  PRINT_JSON eq_n eq_bytes NAME A2
END

# --- has ---
SYS EQS ACTION "has"
IF LAST_N == 1 THEN
  NOTE "action has"
  SYS HASLINE paths NAME
  LET val_n = LAST_N
  LET hit = val_n
  IF val_n == 0 THEN
    LET miss = 1
    LET note_msg = "has miss"
    FAIL "has miss"
    CLEAR_ERR
    IF REQUIRE_HIT > 0 THEN
      EXIT 2 "has miss"
    END
  ELSE
    LET note_msg = "has ok"
  END
  PRINT_JSON val_n NAME
END

# --- clear ---
SYS EQS ACTION "clear"
IF LAST_N == 1 THEN
  NOTE "action clear"
  LET paths = ""
  LET moved = ""
  LET paths_ch = 1
  LET moved_ch = 1
  LET hit = 1
  LET note_msg = "cleared"
END

SYS EQS ACTION "list"
LET k = LAST_N
SYS EQS ACTION "walk"
LET k = k + LAST_N
SYS EQS ACTION "files"
LET k = k + LAST_N
SYS EQS ACTION "dest"
LET k = k + LAST_N
SYS EQS ACTION "archive"
LET k = k + LAST_N
SYS EQS ACTION "stage"
LET k = k + LAST_N
SYS EQS ACTION "eq"
LET k = k + LAST_N
SYS EQS ACTION "has"
LET k = k + LAST_N
SYS EQS ACTION "clear"
LET k = k + LAST_N
IF k == 0 THEN
  FAIL "unknown action"
  CLEAR_ERR
  EXIT 2 "unknown action"
END

IF paths_ch > 0 THEN
  SYS WRITE paths_path paths
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "paths write failed"
  END
  CLEAR_ERR
END
IF moved_ch > 0 THEN
  SYS WRITE moved_path moved
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "moved write failed"
  END
  CLEAR_ERR
END
IF dest_ch > 0 THEN
  SYS WRITE dest_path dest_stored
  EXPECT OK == 1
  IF OK == 0 THEN
    EXIT 2 "dest write failed"
  END
  CLEAR_ERR
END

SYS LINES paths
LET depth_p = LAST_N
SYS LINES moved
LET depth_m = LAST_N
SYS MS
LET t1 = MS
LET elapsed = t1 - t0

LET report = "schema=cubalc.archive_walk.v1"
SYS PUSH report "date"
LET report = LAST
SYS PUSH report run_date
LET report = LAST
SYS PUSH report "action"
LET report = LAST
SYS PUSH report ACTION
LET report = LAST
SYS PUSH report "hit"
LET report = LAST
SYS STR hit
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "miss"
LET report = LAST
SYS STR miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "key"
LET report = LAST
SYS PUSH report NAME
LET report = LAST
SYS PUSH report "a2"
LET report = LAST
SYS PUSH report A2
LET report = LAST
SYS PUSH report "root"
LET report = LAST
SYS PUSH report ROOT
LET report = LAST
SYS PUSH report "dest"
LET report = LAST
SYS PUSH report DEST
LET report = LAST
SYS PUSH report "pat"
LET report = LAST
SYS PUSH report PAT
LET report = LAST
SYS PUSH report "walk_n"
LET report = LAST
SYS STR walk_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "walk_files"
LET report = LAST
SYS STR walk_files
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "walk_dirs"
LET report = LAST
SYS STR walk_dirs
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "keep_n"
LET report = LAST
SYS STR keep_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "move_n"
LET report = LAST
SYS STR move_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "move_miss"
LET report = LAST
SYS STR move_miss
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "move_fail"
LET report = LAST
SYS STR move_fail
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "eq_n"
LET report = LAST
SYS STR eq_n
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "eq_bytes"
LET report = LAST
SYS STR eq_bytes
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_p"
LET report = LAST
SYS STR depth_p
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "depth_m"
LET report = LAST
SYS STR depth_m
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "note"
LET report = LAST
SYS PUSH report note_msg
LET report = LAST
SYS PUSH report "elapsed_ms"
LET report = LAST
SYS STR elapsed
SYS PUSH report LAST
LET report = LAST
SYS PUSH report "identity"
LET report = LAST
SYS PUSH report IDENTITY
LET report = LAST

SYS WRITE report_path report
EXPECT OK == 1
IF OK == 0 THEN
  EXIT 2 "report write failed"
END
CLEAR_ERR

STATUS
PRINT "archive_walk_board" ACTION hit miss walk_n move_n eq_n note_msg elapsed
PRINT_JSON ACTION hit miss walk_n walk_files walk_dirs move_n move_miss move_fail eq_n eq_bytes depth_p depth_m note_msg STATUS_OK
NOTE "archive_walk_board: done"
