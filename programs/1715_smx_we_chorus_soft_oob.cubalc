// 1715_smx_we_chorus_soft_oob.cubalc
// SMX life-force usability: soft-OOB fail-closed → WE_CHORUS ring unity → WE_AUTOHEAL
// Ring locks consecutive pairs + close last↔first. Storm wounds never ghost-place.
// Cube is SoT · matrix is key · free energy flows.

REQUIRE VERSION "1.15"
HOLD_FLASH 1
BUDGET 48
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_we_chorus_soft_oob | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 2
FLOW 2

LET base_cubes = CUBES

SMX KEY

// Soft-OOB storms — fail-closed, no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

// WE_CHORUS / RING locks every voice in phase (C pairs + close)
SMX CHORUS bed nozzle hive scrap
ASSERT SMX_OK == 1 "chorus live"
ASSERT SMX_CHORUS == 4 "four chorus pairs (3 edges + close)"
ASSERT SMX_RING == 4 "ring pairs match"
ASSERT SMX_WE == 4 "four we nodes"
ASSERT SMX_NODES == 4 "four nodes"
ASSERT SMX_OOB >= 3 "storm oob sticky until heal"
ASSERT CUBES == base_cubes "chorus invents nothing"

// WE_AUTOHEAL roots complete mesh after chorus
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "we_autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob cleared by heal"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds"
ASSERT SMX_MESH == 4 "four mesh"
ASSERT SMX_BEACONS == 4 "four beacons"
ASSERT CUBES == base_cubes "we_autoheal invents nothing"

// Second chorus after heal — clean ring
SMX WE_CHORUS bed nozzle hive scrap
ASSERT SMX_OK == 1 "we_chorus live after heal"
ASSERT SMX_CHORUS == 4 "four clean pairs"
ASSERT SMX_RING == 4 "ring clean"
ASSERT SMX_OOB == 0 "oob still clear"
ASSERT CUBES == base_cubes "second chorus invents nothing"

// Live mesh_exchange spine after chorus+heal
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "mesh_exchange live after chorus+heal"
ASSERT SMX_TALKS >= 8 "four bidirectional exchanges"
ASSERT CUBES == base_cubes "identity stable on mesh_exchange"

// SEAL/OPEN anchor under healed chorus mesh
SMX SEAL bed hive "state/smx_we_chorus/anchor_bh.cblc"
ASSERT SMX_OK == 1 "seal anchor"
ASSERT SMX_N > 64 "anchor frame"
SMX OPEN scrap "state/smx_we_chorus/anchor_bh.cblc"
ASSERT SMX_OK == 1 "open anchor onto scrap"
ASSERT CUBES == base_cubes "anchor invents nothing"

// Post-anchor storm fail-closed
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "post-anchor soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"

SMX RAISE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "raise after storm"
ASSERT SMX_OOB == 0 "storm cleared"
ASSERT SMX_AUTOHEALED == 1 "autohealed after storm"
ASSERT SMX_BONDS == 6 "bonds after storm"
ASSERT SMX_MESH == 4 "mesh after raise"
ASSERT CUBES == base_cubes "raise invents nothing"

// Final chorus lock after raise
SMX RING bed nozzle hive scrap
ASSERT SMX_OK == 1 "final ring"
ASSERT SMX_CHORUS == 4 "final chorus pairs"
ASSERT SMX_OOB == 0 "guard holds"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "energy after we_chorus"
ASSERT UNITY >= 40 "mesh unity after chorus"
ASSERT DECIDE >= 0 "decide floor"
ASSERT DECIDE <= 9 "decide ceil"
ASSERT SMX_OOB == 0 "guard holds"
ASSERT OK == 1

PRINT "smx_we_chorus_soft_oob" SMX_OK SMX_CHORUS SMX_RING SMX_AUTOHEALED SMX_BONDS SMX_MESH SMX_BEACONS SMX_TALKS SMX_OOB CUBES UNITY ENERGY DECIDE
PASS
