
HOLD_FLASH 1
BUDGET 40
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=braincube | type=prophecy | hold_flash=1 | role=decide |"

CUBE titan   ROLE host      PROTON 1
CUBE clanker ROLE body      PROTON 1
CUBE nanobot ROLE atom      PROTON 1
CUBE algo    ROLE algocube  PROTON 1
CUBE brain   ROLE braincube PROTON 1

PLUG titan nanobot
PLUG clanker nanobot
PLUG nanobot algo
PLUG algo brain

SETBIT titan 0 1
SETBIT titan 1 1
SETBIT titan 3 1
SETBIT titan 7 1
SETBIT clanker 2 1
SETBIT clanker 5 1
SETBIT brain 0 1
SETBIT brain 4 1
SETBIT brain 8 1
SETBIT brain 11 1

IMPULSE nanobot 1
FLOW 4

IF ENERGY(nanobot) == 0 THEN
  DECONSTRUCT nanobot
  RECONSTRUCT nanobot
  PLUG titan nanobot
  PLUG clanker nanobot
  IMPULSE nanobot 1
  FLOW 4
END

IMPULSE algo 1
IMPULSE brain 1
DECIDE brain

PRINT "decide" DECIDE DIGIT(brain) SET(brain) ENERGY(nanobot) UNITY CUBES
ASSERT CUBES >= 5
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9
ASSERT SET(brain) >= 1
