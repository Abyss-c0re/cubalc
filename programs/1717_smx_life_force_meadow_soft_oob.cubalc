// 1717_smx_mesh_meadow_soft_oob.cubalc
// SMX life-force usability: soft-OOB fail-closed → MEADOW full-mesh + pollen ring
// + nectar hub → WE_AUTOHEAL roots C(4,2) bonds/beacons → live mesh_exchange → SEAL/OPEN → RAISE.
// Storm wounds never ghost-place. Cube is SoT · matrix is key · free energy flows.

REQUIRE VERSION "1.15"
HOLD_FLASH 1
BUDGET 48
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_meadow_soft_oob | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 2
FLOW 2

LET base_cubes = CUBES

SMX KEY

// Soft-OOB storms — fail-closed, no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

// MEADOW clears thrash and flowers complete-mesh + pollen ring + nectar hub
SMX MEADOW bed nozzle hive scrap
ASSERT SMX_OK == 1 "meadow live"
ASSERT SMX_MEADOWED == 1 "meadowed latch"
ASSERT SMX_OOB == 0 "oob cleared by meadow"
ASSERT SMX_BONDS == 6 "C(4,2)=6 complete-mesh bonds"
ASSERT SMX_POLLEN == 4 "four pollen ring bonds"
ASSERT SMX_NECTARS == 4 "four nectar dew pulses"
ASSERT SMX_MEADOW == 14 "bonds+pollen+nectars"
ASSERT SMX_PASTURE == 1 "pasture sticky"
ASSERT SMX_BLOOMFIELD == 1 "bloomfield sticky"
ASSERT SMX_POLLINATE == 4 "pollinate latch"
ASSERT SMX_MESH == 4 "four mesh under meadow"
ASSERT SMX_LIVE == 4 "four live"
ASSERT SMX_BREATH == 4 "four breath"
ASSERT SMX_PULSE == 14 "pulse bonds+pollen+nectars"
ASSERT SMX_TONE == 4 "four tones"
ASSERT CUBES == base_cubes "meadow invents nothing"

// WE_AUTOHEAL roots complete mesh after meadow
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "we_autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob still clear"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds"
ASSERT SMX_MESH == 4 "four mesh"
ASSERT SMX_BEACONS == 4 "four beacons"
ASSERT CUBES == base_cubes "we_autoheal invents nothing"

// Live mesh_exchange spine after meadow+heal
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "mesh_exchange live after meadow+heal"
ASSERT SMX_TALKS >= 8 "four bidirectional exchanges"
ASSERT CUBES == base_cubes "identity stable on mesh_exchange"

// SEAL/OPEN anchor under meadowed mesh
SMX SEAL bed hive "state/smx_mesh_meadow/anchor_bh.cblc"
ASSERT SMX_OK == 1 "seal anchor"
ASSERT SMX_N > 64 "anchor frame"
SMX OPEN scrap "state/smx_mesh_meadow/anchor_bh.cblc"
ASSERT SMX_OK == 1 "open anchor onto scrap"
ASSERT CUBES == base_cubes "anchor invents nothing"

// Second storm fail-closed after anchor
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "post-anchor soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"

SMX RAISE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "raise after storm"
ASSERT SMX_OOB == 0 "storm cleared"
ASSERT SMX_AUTOHEALED == 1 "autohealed after storm"
ASSERT SMX_BONDS == 6 "bonds after storm"
ASSERT SMX_MESH == 4 "mesh after raise"
ASSERT CUBES == base_cubes "raise invents nothing"

// Re-meadow after raise — sticky life-force pasture
SMX MEADOW bed nozzle hive scrap
ASSERT SMX_OK == 1 "re-meadow live"
ASSERT SMX_MEADOWED == 1 "meadowed sticky or re-latched"
ASSERT SMX_OOB == 0 "oob clear after re-meadow"
ASSERT SMX_BONDS == 6 "bonds after re-meadow"
ASSERT SMX_POLLEN == 4 "pollen after re-meadow"
ASSERT SMX_NECTARS == 4 "nectars after re-meadow"
ASSERT SMX_PASTURE == 1 "pasture sticky after re-meadow"
ASSERT CUBES == base_cubes "re-meadow invents nothing"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "energy after mesh meadow"
ASSERT UNITY >= 40 "mesh unity after meadow"
ASSERT DECIDE >= 0 "decide floor"
ASSERT DECIDE <= 9 "decide ceil"
ASSERT SMX_OOB == 0 "guard holds"
ASSERT SMX_MEADOWED == 1 "meadowed sticky or re-latched"
ASSERT OK == 1

PRINT "smx_mesh_meadow_soft_oob" SMX_OK SMX_MEADOWED SMX_AUTOHEALED SMX_BONDS SMX_MESH SMX_POLLEN SMX_NECTARS SMX_MEADOW SMX_TALKS SMX_OOB CUBES UNITY ENERGY DECIDE
PASS
