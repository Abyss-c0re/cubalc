# INCLUDE fn_guard - fail-fast FN catalog contract (ALL + optional ANY)
# Usability: agent language-plane gate via native HASFNS/NEEDFNS (no N× HASFN soup).
#
#   DEFAULT NEED_FNALL = "add\nping"
#   DEFAULT NEED_FNANY = "greet\nhello"
#   DEFAULT FN_GUARD_SOFT = 0
#   INCLUDE fn_guard
#
# Spec: each entry is a FN name. Soft dual leaves FNMISS / FNHAVE bags.
# Twin of obj_guard / class_guard for the FN plane.
# Hard ALL path: NEEDFNS (native multi). Hard ANY: HASFN+HARDFAIL (no HASFNANY yet).
# Multi duals: HASFNS / NEEDFNS / ALLFNS / REQUIREFNS still available.

DEFAULT NEED_FNALL = ""
DEFAULT NEED_FNANY = ""
DEFAULT FN_GUARD_SOFT = 0

SYS EMPTY NEED_FNALL
IF LAST_N == 1
  LET FN_GUARD_ALL_OK = 1
  LET FNMISS = ""
  LET FNHAVE = ""
  LET FNMISS_N = 0
  LET FNHAVE_N = 0
ELSE
  IF FN_GUARD_SOFT
    HASFNS NEED_FNALL
    LET FN_GUARD_ALL_OK = LAST_N
    LET FNHAVE_N = HASFNS_N
    IF FNMISS_N == 0
      LET FNHAVE = NEED_FNALL
    END
  ELSE
    NEEDFNS NEED_FNALL
    LET FN_GUARD_ALL_OK = 1
    LET FNMISS = ""
    LET FNMISS_N = 0
    LET FNHAVE = NEED_FNALL
    LET FNHAVE_N = NEEDFNS_N
  END
END

SYS EMPTY NEED_FNANY
IF LAST_N == 1
  LET FN_GUARD_ANY_OK = 1
ELSE
  LET FNANY_HIT = 0
  LET FNANY_HAVE = ""
  LET FNANY_MISS = ""
  EACH LINE b IN NEED_FNANY
    HASFN b
    IF LAST_N == 1
      LET FNANY_HIT = 1
      IF FNANY_HAVE == ""
        LET FNANY_HAVE = b
      ELSE
        LET FNANY_HAVE = FNANY_HAVE + "\n" + b
      END
    ELSE
      IF FNANY_MISS == ""
        LET FNANY_MISS = b
      ELSE
        LET FNANY_MISS = FNANY_MISS + "\n" + b
      END
    END
  END
  IF FNANY_HIT == 1
    LET FN_GUARD_ANY_OK = 1
    IF FNHAVE == ""
      LET FNHAVE = FNANY_HAVE
    END
  ELSE
    LET FN_GUARD_ANY_OK = 0
    LET OK = 0
    LET LAST_ERR = "FN_GUARD ANY miss - need one of: " + NEED_FNANY
    LET ERR = LAST_ERR
    LET FNMISS = FNANY_MISS
    IF FN_GUARD_SOFT == 0
      HARDFAIL "FN_GUARD hard miss — see ERR/FNMISS"
    END
  END
END

IF FN_GUARD_ALL_OK
  IF FN_GUARD_ANY_OK
    LET FN_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET FN_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET FN_GUARD_OK = 0
  LET OK = 0
END
