# INCLUDE fn_guard - fail-fast FN catalog contract (ALL + optional ANY)
# Usability: agent language-plane gate via native multi FN forms (no N× HASFN soup).
#
#   DEFAULT NEED_FNALL = "add\nping"
#   DEFAULT NEED_FNANY = "greet\nhello"
#   DEFAULT FN_GUARD_SOFT = 0
#   INCLUDE fn_guard
#
# Spec: each entry is a FN name. Soft dual leaves FNMISS / FNHAVE bags.
# Twin of obj_guard / class_guard for the FN plane.
# Hard ALL: NEEDFNS · Hard ANY: NEEDFNANY · Soft: HASFNS / HASFNANY.
# Multi duals: HASFNS / NEEDFNS / HASFNANY / NEEDFNANY still available directly.

DEFAULT NEED_FNALL = ""
DEFAULT NEED_FNANY = ""
DEFAULT FN_GUARD_SOFT = 0

SYS EMPTY NEED_FNALL
IF LAST_N == 1
  LET FN_GUARD_ALL_OK = 1
  LET FNMISS = ""
  LET FNHAVE = ""
  LET FNMISS_N = 0
  LET FNHAVE_N = 0
ELSE
  IF FN_GUARD_SOFT
    HASFNS NEED_FNALL
    LET FN_GUARD_ALL_OK = LAST_N
    LET FNHAVE_N = HASFNS_N
    IF FNMISS_N == 0
      LET FNHAVE = NEED_FNALL
    END
  ELSE
    NEEDFNS NEED_FNALL
    LET FN_GUARD_ALL_OK = 1
    LET FNMISS = ""
    LET FNMISS_N = 0
    LET FNHAVE = NEED_FNALL
    LET FNHAVE_N = NEEDFNS_N
  END
END

SYS EMPTY NEED_FNANY
IF LAST_N == 1
  LET FN_GUARD_ANY_OK = 1
ELSE
  IF FN_GUARD_SOFT
    HASFNANY NEED_FNANY
    LET FN_GUARD_ANY_OK = LAST_N
    # FNHAVE / FNMISS / FNHAVE_N / FNMISS_N from HASFNANY
  ELSE
    NEEDFNANY NEED_FNANY
    LET FN_GUARD_ANY_OK = 1
    LET FNHAVE_N = NEEDFNANY_N
  END
END

IF FN_GUARD_ALL_OK
  IF FN_GUARD_ANY_OK
    LET FN_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET FN_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET FN_GUARD_OK = 0
  LET OK = 0
END
