  # Cyp7a1 (rate-limiting BA synthesis enzyme) - Shp is the NR0B2 repressor
  # that converts post-KLB portal signal into CYP7A1 transcriptional brake.
  # Without Shp after Klb, ternary FGF19/FGFR4/KLB never authorizes BA-synthesis
  # repression; life_cell gut-liver free-energy loop stalls at co-receptor
  # without nuclear repressor output.
  # Domain: post-KLB hepatic SHP/NR0B2 repressor / CYP7A1 brake gate
  #   -> SHP free-energy (ATP stand-in for repressor induction)
  # (not Klb, not Fgfr4, not Fgf19, not Fxr, not Fabp6, not Cyp7a1).
  # Continuum: ...->asbt->fabp6->fxr->fgf19->fgfr4->klb->shp
  #   (KLB co-receptor -> SHP/NR0B2 repressor gut-liver close).
  # Gift: post-KLB SHP so ternary FGF19/FGFR4/KLB free-energy complex can
  #   induce NR0B2 and authorize CYP7A1 repression under ASSERT.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - shp life-force.
  # Usability: AGI models post-KLB hepatic SHP/NR0B2 under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD shp n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # Cyp7a1: cholesterol 7α-hydroxylase after SHP/NR0B2 repressor docks.
  # CYP7A1 is the rate-limiting hepatic enzyme of classical bile-acid synthesis;
  # after Shp (NR0B2) is induced by the FGF19/FGFR4/KLB ternary holocomplex,
  # SHP partners FXR and transcriptionally represses CYP7A1 so BA production
  # drops and free-energy budgets stop over-committing sterol to BA under ASSERT.
  # After Shp supplies the nuclear repressor, Cyp7a1 is the repressed effector
  # limb so mitosis energy budgets gain a BA-synthesis brake plate instead of a
  # repressor that never touches the sterol-to-BA flux gene.
  # Distinct from Shp (NR0B2 repressor), Klb (beta-Klotho), Fgfr4 (FGF RTK),
  # Fgf19 (ileal enterokine), Fxr (NR1H4), Fabp6 (IBABP) - Cyp7a1 is the
  # rate-limiting BA-synthesis enzyme whose repression closes gut-liver feedback.
  # Without Cyp7a1 after Shp, NR0B2 never authorizes BA-synthesis brake output;
  # life_cell gut-liver free-energy loop stalls at repressor without enzyme gate.
  # Domain: post-SHP hepatic CYP7A1 BA-synthesis enzyme / repression effector gate
  #   -> CYP7A1 free-energy (ATP stand-in for repressed synthesis flux)
  # (not Shp, not Klb, not Fgfr4, not Fgf19, not Fxr, not Fabp6).
  # Continuum: ...->fabp6->fxr->fgf19->fgfr4->klb->shp->cyp7a1
  #   (SHP/NR0B2 repressor -> CYP7A1 BA-synthesis enzyme gut-liver close).
  # Gift: post-SHP CYP7A1 so NR0B2 free-energy brake can authorize BA-synthesis
  #   repression under ASSERT and keep sterol flux accountable.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - cyp7a1 life-force.
  # Usability: AGI models post-SHP hepatic CYP7A1 under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
END
