# life_cell_x05.cubalc — EXTEND Cell pack 5

EXTEND CLASS Cell
  METHOD pepd n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # PepN: cytoplasmic aminopeptidase N after PepD dipeptidase.
  # PepN (aminopeptidase N / PepN metallopeptidase) clears residual oligopeptides
  # and N-terminal residues after PepD frees L-Ala + L-Glu from YcjG-epimerized
  # dipeptides, returning bulk amino-acid free-energy into central catabolism and
  # re-entry pools under murein-turnover stress. Distinct from PepD (L-Ala-L-Glu
  # dipeptidase), YcjG (L-Ala-D/L-Glu epimerase), MpaA (gamma-D-Glu-mDAP amidase),
  # LdcA, Mpl, AmpD, AmiA/B/C - PepN is the broad-specificity cytoplasmic
  # aminopeptidase gate downstream of PepD dipeptide hydrolysis.
  # Without PepN after PepD, residual oligopeptide stems stall and the recycling
  # continuum loses its terminal aminopeptidase free-energy release branch.
  # Domain: post-PepD PepN cytoplasmic aminopeptidase N / oligopeptide hydrolase
  # (not PepD, not YcjG, not MpaA, not LdcA, not Mpl, not AmpD, not Ami family).
  # Continuum: ...->ldca->mpaa->ycjg->pepd->pepn
  #   (PepD L-Ala-L-Glu dipeptidase -> PepN aminopeptidase N).
  # Pay take=min(n,atp,energy) - ATP stand-in for PepN catalytic cycle.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - pepn life-force.
  # Usability: AGI models post-PepD PepN aminopeptidase recycling gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD pepn n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # PepQ: Xaa-Pro dipeptidase (prolidase) after PepN aminopeptidase N.
  # PepQ (Xaa-Pro dipeptidase / prolidase) cleaves Xaa-Pro dipeptides that
  # PepN cannot finish — proline's secondary amine stalls broad aminopeptidases.
  # After PepN clears residual oligopeptide N-termini, imino-dipeptides remain;
  # PepQ opens the Xaa-Pro bond so free Pro and partner amino acids re-enter
  # central catabolism and murein / collagen-like recycling under turnover stress.
  # Distinct from PepN (broad aminopeptidase N), PepD (L-Ala-L-Glu dipeptidase),
  # YcjG, MpaA, LdcA, Mpl, AmpD — PepQ is the proline-specialist cytoplasmic
  # dipeptidase gate downstream of PepN.
  # Without PepQ after PepN, Xaa-Pro stems stall and the recycling continuum
  # loses its prolidase free-energy release branch.
  # Domain: post-PepN PepQ Xaa-Pro dipeptidase / prolidase
  # (not PepN, not PepD, not YcjG, not MpaA, not LdcA, not Mpl, not AmpD).
  # Continuum: ...->ldca->mpaa->ycjg->pepd->pepn->pepq
  #   (PepN aminopeptidase N -> PepQ Xaa-Pro dipeptidase / prolidase).
  # Pay take=min(n,atp,energy) - ATP stand-in for PepQ catalytic cycle.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - pepq life-force.
  # Usability: AGI models post-PepN PepQ prolidase recycling gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD pepq n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # PepP: Xaa-Pro aminopeptidase P after PepQ prolidase.
  # PepP (aminopeptidase P / Xaa-Pro aminopeptidase) cleaves the N-terminal
  # Xaa from longer Xaa-Pro-Yaa... peptides that PepQ cannot touch — PepQ is
  # dipeptide-only prolidase; PepP processively frees the Xaa when Pro sits
  # at P1' on tri- and oligopeptides from murein / collagen-like turnover.
  # After PepQ opens residual Xaa-Pro dipeptides, uncleaved Xaa-Pro stems on
  # longer fragments still stall broad aminopeptidases; PepP releases free AA
  # so Pro-containing oligopeptide recycling completes under turnover stress.
  # Distinct from PepQ (Xaa-Pro dipeptidase / prolidase), PepN (broad
  # aminopeptidase N), PepD (L-Ala-L-Glu dipeptidase), YcjG, MpaA, LdcA, Mpl —
  # PepP is the Xaa-Pro aminopeptidase gate downstream of PepQ.
  # Without PepP after PepQ, Xaa-Pro-Yaa oligopeptides stall and the recycling
  # continuum loses its aminopeptidase-P free-energy release branch.
  # Domain: post-PepQ PepP Xaa-Pro aminopeptidase P / oligopeptide hydrolase
  # (not PepQ, not PepN, not PepD, not YcjG, not MpaA, not LdcA, not Mpl).
  # Continuum: ...->ldca->mpaa->ycjg->pepd->pepn->pepq->pepp->pepa
  #   (PepQ Xaa-Pro dipeptidase / prolidase -> PepP Xaa-Pro aminopeptidase P).
  # Pay take=min(n,atp,energy) - ATP stand-in for PepP catalytic cycle.
