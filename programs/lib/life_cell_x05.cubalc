  # Usability: AGI models post-PepQ PepP Xaa-Pro aminopeptidase gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD pepp n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
