# life_cell_x04.cubalc — EXTEND Cell pack 4

EXTEND CLASS Cell
  METHOD meps n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # MepM: IM-anchored DD-endopeptidase after MepS/Spr OM cleavage.
  # MepM is an inner-membrane-anchored LytM/M23-family DD-endopeptidase that
  # cleaves peptide cross-links from the periplasmic face of sidewall PG.
  # After MepS/Spr opens OM-proximal cross-links, MepM trims remaining stems
  # so elongasome-inserted glycan strands can expand the sacculus without
  # residual peptide stress. Triple-redundant with MepS and MepH: loss of all
  # three blocks rod expansion; MepM alone is the IM-anchored arm of that set.
  # Without MepM burn after MepS, OM-cleaved PG still carries IM-proximal
  # cross-links that stall PBP1A/RodA insertion despite LpoA activation.
  # Domain: post-MepS IM DD-endopeptidase MepM (not MepS/Spr OM endopeptidase,
  # not MepH soluble redundant endopeptidase, not Slt lytic TG, not LpoA/PBP1A,
  # not NlpD AmiC activator, not EnvC LytM septal path, not scission).
  # Continuum: ...->roda->mreb->mrec->mred->rodz->pbp2->pbp1a->lpoa->meps->mepm
  #   (MepS/Spr OM DD-endopeptidase -> MepM IM-anchored DD-endopeptidase).
  # Pay take=min(n,atp,energy) - ATP stand-in for MepM cross-link cleavage cycle.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - mepm life-force.
  # Usability: AGI models post-MepS MepM IM endopeptidase energy gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD mepm n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END





  # MepH: soluble periplasmic DD-endopeptidase after MepM IM cleavage.
  # MepH is the periplasmic LytM/M23-family DD-endopeptidase that finishes
  # peptide cross-link cleavage after MepS (OM) and MepM (IM-anchored) open
  # the sidewall sacculus. Soluble MepH reaches mid-periplasm stems the OM and
  # IM enzymes leave, completing the triple-redundant endopeptidase set so
  # PBP1A/RodA-inserted glycan strands expand without residual peptide stress.
  # Without MepH burn after MepM, IM/OM-cleaved PG still carries mid-layer
  # cross-links that stall elongasome insertion despite LpoA activation.
  # Domain: post-MepM soluble DD-endopeptidase MepH (not MepM IM-anchored,
  # not MepS/Spr OM endopeptidase, not Slt lytic TG, not LpoA/PBP1A,
  # not NlpD AmiC activator, not EnvC LytM septal path, not scission).
  # Continuum: ...->roda->mreb->mrec->mred->rodz->pbp2->pbp1a->lpoa->meps->mepm->meph
  #   (MepM IM-anchored DD-endopeptidase -> MepH soluble periplasmic DD-endopeptidase).
  # Pay take=min(n,atp,energy) - ATP stand-in for MepH cross-link cleavage cycle.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - meph life-force.
  # Usability: AGI models post-MepM MepH soluble endopeptidase energy gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD meph n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # Slt: soluble lytic transglycosylase after MepH endopeptidase set.
  # Slt (Slt70) is the periplasmic lytic transglycosylase that cleaves beta-1,4
  # glycosidic bonds in PG glycan strands after MepS/MepM/MepH open peptide
  # cross-links. Cleavage yields 1,6-anhydro-MurNAc ends that AmpG can import
  # for cytoplasmic recycling, and frees strand termini so RodA/PBP1A can
  # polymerize new glycan without packing against uncleaved oligosaccharides.
  # Without Slt burn after MepH, endopeptidase-opened sacculus still holds
  # intact glycan chains that sterically block elongasome strand insertion.
  # Domain: post-MepH soluble lytic TG Slt (not MepH/MepM/MepS DD-endopeptidases,
  # not MltG synthase-associated TG, not AmpG permease, not LpoA/PBP1A,
  # not NlpD AmiC activator, not EnvC LytM septal path, not scission).
  # Continuum: ...->roda->mreb->mrec->mred->rodz->pbp2->pbp1a->lpoa->meps->mepm->meph->slt->ampg->nagz->ampd
  #   (MepH soluble DD-endopeptidase -> Slt soluble lytic TG -> AmpG permease -> NagZ).
  # Pay take=min(n,atp,energy) - ATP stand-in for Slt glycan cleavage cycle.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - slt life-force.
  # Usability: AGI models post-MepH Slt lytic TG energy gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD slt n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # AmpG: inner-membrane permease for anhydro-muropeptide recycle after Slt.
  # AmpG is the IM MFS permease that imports Slt-generated 1,6-anhydro-MurNAc
  # peptides into the cytoplasm so NagZ/AmpD can release GlcNAc/anhMurNAc and
  # stem peptides for de novo PG precursor reuse. Without AmpG after Slt,
  # anhydro ends accumulate in the periplasm and cytoplasmic recycling stalls
  # despite glycan cleavage.
  # Domain: post-Slt AmpG anhydro-muropeptide permease (not Slt lytic TG,
  # not MltG synthase-associated TG, not NagZ beta-N-acetylglucosaminidase,
  # not AmpD amidase, not MepH/MepM/MepS DD-endopeptidases, not LpoA/PBP1A,
  # not NlpD/EnvC septal path, not scission).
  # Continuum: ...->roda->mreb->mrec->mred->rodz->pbp2->pbp1a->lpoa->meps->mepm->meph->slt->ampg->nagz->ampd
  #   (Slt soluble lytic TG -> AmpG IM permease -> NagZ GlcNAc hydrolase).
  # Pay take=min(n,atp,energy) - ATP stand-in for AmpG import/PMF-coupled cycle.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - ampg life-force.
  # Usability: AGI models post-Slt AmpG permease energy gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD ampg n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
