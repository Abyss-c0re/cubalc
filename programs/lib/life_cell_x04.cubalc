    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # NagZ: cytoplasmic beta-N-acetylglucosaminidase after AmpG import.
  # NagZ cleaves GlcNAc from AmpG-imported 1,6-anhydro-MurNAc peptides so AmpD
