# INCLUDE service_boot — agent preamble + product+host+live OOP one-shot
# Usability: full product+host readiness + live OOP catalog/instances without multi INCLUDE.
# full_session already pulls agent_boot via tool_session/cli_boot.
#
#   DEFAULT NEED_FLAGS = ""
#   DEFAULT NEED_ENVS = ""
#   DEFAULT NEED_TIME = 1
#   DEFAULT NEED_PATHS = ""
#   DEFAULT NEED_BINS = ""
#   DEFAULT NEED_LIBS = ""
#   DEFAULT NEED_CLASSES = ""
#   DEFAULT NEED_METHODS = ""
#   DEFAULT NEED_FIELDS = ""
#   DEFAULT NEED_OBJS = ""
#   INCLUDE service_boot
# Soft miss: set *_GUARD_SOFT = 1 before INCLUDE
#
# Scaffold: cubalc init demo --service
# Twin of full_boot (product+host) / live_boot (OOP only) for fleet services with NEW/SEND.
# HOLD_FLASH not required (runtime default 1 · same as agent_boot).

DEFAULT NEED_FLAGS = ""
DEFAULT NEED_FLAG_ANY = ""
DEFAULT NEED_REST_N = 0
DEFAULT NEED_ARGS = ""
DEFAULT NEED_ARG_ANY = ""
DEFAULT NEED_ENVS = ""
DEFAULT NEED_ENV_ANY = ""
DEFAULT NEED_TIME = 1
DEFAULT CLI_GUARD_SOFT = 0
DEFAULT ARG_GUARD_SOFT = 0
DEFAULT ENV_GUARD_SOFT = 0
DEFAULT TIME_GUARD_SOFT = 0
DEFAULT NEED_PATHS = ""
DEFAULT NEED_PATH_ANY = ""
DEFAULT PATH_GUARD_SOFT = 0
DEFAULT NEED_READ_PATHS = ""
DEFAULT NEED_WRITE_PATHS = ""
DEFAULT RW_GUARD_SOFT = 0
DEFAULT NEED_BINS = ""
DEFAULT NEED_BIN_ANY = ""
DEFAULT BIN_GUARD_SOFT = 0
DEFAULT NEED_LIBS = ""
DEFAULT NEED_LIB_ANY = ""
DEFAULT LIB_GUARD_SOFT = 0
DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
DEFAULT NEED_FIELDS = ""
DEFAULT NEED_FIELD_ANY = ""
DEFAULT FIELD_GUARD_SOFT = 0
DEFAULT NEED_OBJS = ""
DEFAULT NEED_OBJ_ANY = ""
DEFAULT OBJ_GUARD_SOFT = 0
INCLUDE service_session
