# INCLUDE field_guard - fail-fast Class.field catalog contract (ALL + optional ANY)
# Usability: agent OOP field gate via native multi forms (no N× HASFIELD soup).
#
#   DEFAULT NEED_FIELDS = "Ticket.id\nTicket.kind"
#   DEFAULT NEED_FIELD_ANY = "Order.n\nTicket.n"
#   DEFAULT FIELD_GUARD_SOFT = 0
#   INCLUDE field_guard
#
# Spec: each entry is Class.field (dot). Soft dual leaves FLDMISS / FLDHAVE bags.
# Twin of method_guard multi path for the field plane.
# Hard ALL: NEEDFIELDS · Hard ANY: NEEDFIELDANY · Soft: HASFIELDS / HASFIELDANY
# (dotted multi-class bag form). REQUIRE FIELD avoided — IF/END nesting.

DEFAULT NEED_FIELDS = ""
DEFAULT NEED_FIELD_ANY = ""
DEFAULT FIELD_GUARD_SOFT = 0

SYS EMPTY NEED_FIELDS
IF LAST_N == 1
  LET FIELD_GUARD_ALL_OK = 1
  LET FLDMISS = ""
  LET FLDHAVE = ""
  LET FLDMISS_N = 0
  LET FLDHAVE_N = 0
ELSE
  IF FIELD_GUARD_SOFT
    HASFIELDS NEED_FIELDS
    LET FIELD_GUARD_ALL_OK = LAST_N
    LET FLDHAVE_N = HASFIELDS_N
    IF FLDMISS_N == 0
      LET FLDHAVE = NEED_FIELDS
    END
  ELSE
    NEEDFIELDS NEED_FIELDS
    LET FIELD_GUARD_ALL_OK = 1
    LET FLDMISS = ""
    LET FLDMISS_N = 0
    LET FLDHAVE = NEED_FIELDS
    LET FLDHAVE_N = NEEDFIELDS_N
  END
END

SYS EMPTY NEED_FIELD_ANY
IF LAST_N == 1
  LET FIELD_GUARD_ANY_OK = 1
ELSE
  IF FIELD_GUARD_SOFT
    HASFIELDANY NEED_FIELD_ANY
    LET FIELD_GUARD_ANY_OK = LAST_N
    # FLDHAVE / FLDMISS from HASFIELDANY
  ELSE
    NEEDFIELDANY NEED_FIELD_ANY
    LET FIELD_GUARD_ANY_OK = 1
    LET FLDHAVE_N = NEEDFIELDANY_N
  END
END

IF FIELD_GUARD_ALL_OK
  IF FIELD_GUARD_ANY_OK
    LET FIELD_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET FIELD_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET FIELD_GUARD_OK = 0
  LET OK = 0
END
