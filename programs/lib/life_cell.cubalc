    IF take > maxburn THEN
      LET take = maxburn
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    LET rd = 0
    GETF THIS threshold
    LET thr = LAST_N
    GETF THIS quiescent
    LET q = LAST_N
