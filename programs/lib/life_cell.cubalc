    LET take = n
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Mitophagy: selective mitochondrial autophagy — QC of worn mito biomass + gradient debris.
