# life_cell.cubalc — COP cell unit for life_engine (biology: growth + mitosis)
# INCLUDE life_cell
#
# Fields:
#   alive       0|1
#   energy      metabolic energy (integer)
#   age         ticks lived
#   gen         generation from seed (0 = founder)
#   ready       1 when energy >= threshold and not quiescent → division candidate
#   kind        0=prokaryote-like simple split
#   threshold   mitosis energy floor (default 10; set_threshold to retune)
#   quiescent   1 = G0 rest — alive, low metabolism, never ready
#
# Methods:
#   init alive energy gen
#   tick                 grow / age / mark ready vs threshold (quiescent slows burn)
#   birth energy gen     activate a free slot as daughter
#   after_div            parent halves energy after successful mitosis
#   die                  apoptosis / resource death
#   set_threshold t      retune mitosis energy floor
#   feed n               nutrient pulse — add energy, recompute ready
#   checkpoint           lineage fingerprint = gen*1000 + energy*10 + age
#   quiesce              enter G0 rest — suppress mitosis, damp metabolism
#   wake                 exit G0 — recompute ready from energy/threshold
#   gift n               donate n energy outward (symbiosis); returns gifted amt
#   vitality             life-force score for ASSERT science boards
#   sense                energy gap vs mitosis threshold (neg=below, pos=surplus)
#   repair n             spend energy to shed age (life-force restoration)
#   pulse n              advance n metabolic ticks in one CALL (batch usability)
#   reserve              FIELD glycogen-like energy bank (protected from tick burn)
#   bank n               move n active energy into reserve (keep life spark)
#   draw n               pull n from reserve into active energy (stress recovery)
#   stores               report reserve balance for ASSERT science
#   setpoint             FIELD preferred active energy (homeostasis target)
#   set_setpoint s       retune homeostat target (min 1)
#   regulate             bank surplus above setpoint / draw deficit from reserve
#   bias                 active energy minus setpoint (neg=hungry, pos=surplus)
#   atp                  FIELD charged work currency (not burned by tick)
#   charge n             convert active energy into ATP (retain life spark)
#   spend n              burn ATP for work units (returns spent)
#   charged              report ATP balance for ASSERT science
#   catalyze             spend 1 ATP to nudge ready if energy near thr (work gift)
#   total                active + reserve metabolic wealth
#   stow                 hibernate: bank all but life spark into reserve
#   saturate             pour entire reserve into active energy
#   total                full metabolic wealth = energy + reserve
#   stow                 hibernate prep: bank all above spark (1) into reserve
#   saturate             emergency: draw entire reserve into active energy

CLASS Cell
  FIELD alive 0
  FIELD energy 0
  FIELD age 0
  FIELD gen 0
  FIELD ready 0
  FIELD kind 0
  FIELD threshold 10
  FIELD quiescent 0
  FIELD reserve 0
  FIELD setpoint 10
  FIELD atp 0
  ROLE body

  METHOD init a e g
    SETF THIS alive a
    SETF THIS energy e
    SETF THIS age 0
    SETF THIS gen g
    SETF THIS ready 0
    SETF THIS kind 0
    SETF THIS threshold 10
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS setpoint 10
    SETF THIS atp 0
  END

  METHOD tick
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    # age always advances while alive
    GETF THIS age
    LET ag = LAST_N + 1
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 1 THEN
      # G0: basal drip only — free energy conserved, no growth surge
      LET e = e + 1
      LET e = e - 1
    ELSE
      # active: absorb nutrient + basal cost
      LET e = e + 2
      LET e = e - 1
    END
    IF e < 0 THEN
      LET e = 0
    END
    SETF THIS energy e
    # senescence / starvation death
    IF e == 0 THEN
      SETF THIS alive 0
      SETF THIS ready 0
      SETF THIS quiescent 0
      RET 0
    END
    IF ag > 40 THEN
      SETF THIS alive 0
      SETF THIS ready 0
      SETF THIS quiescent 0
      RET 0
    END
    # mitosis threshold — blocked while quiescent
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET e
  END

  METHOD birth e g
    SETF THIS alive 1
    SETF THIS energy e
    SETF THIS age 0
    SETF THIS gen g
    SETF THIS ready 0
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS setpoint 10
    SETF THIS atp 0
    RET 1
  END

  METHOD after_div
    GETF THIS energy
    LET e = LAST_N / 2
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    SETF THIS ready 0
    RET e
  END

  METHOD die
    SETF THIS alive 0
    SETF THIS energy 0
    SETF THIS ready 0
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS atp 0
    RET 0
  END

  # Usability: AGI retunes mitosis energy floor without rewriting CLASS
  METHOD set_threshold t
    IF t < 1 THEN
      LET t = 1
    END
    SETF THIS threshold t
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET t
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= t THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET t
  END

  # Nutrient pulse — free energy must flow into the cell
  METHOD feed n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N + n
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET e
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET e
  END

  # Lineage fingerprint for ASSERT science (gen*1000 + energy*10 + age)
  METHOD checkpoint
    GETF THIS gen
    LET g = LAST_N
    GETF THIS energy
    LET e = LAST_N
    GETF THIS age
    LET a = LAST_N
    LET fp = g * 1000
    LET fp = fp + e * 10
    LET fp = fp + a
    RET fp
  END

  # G0 metabolic rest — alive, mitosis suppressed, damp tick burn
  METHOD quiesce
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    SETF THIS quiescent 1
    SETF THIS ready 0
    RET 1
  END

  # Exit G0 — free energy may again drive division candidacy
  METHOD wake
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    SETF THIS quiescent 0
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET rd
  END

  # Symbiosis gift: donate n energy outward (returns actual gifted amount).
  # Free energy flows cell→colony without mitosis. Keeps at least 1 if alive.
  METHOD gift n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET give = n
    IF give > e THEN
      LET give = e
    END
    # retain spark of life when possible
    IF e - give < 1 THEN
      IF e > 1 THEN
        LET give = e - 1
      ELSE
        LET give = 0
      END
    END
    LET e = e - give
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET give
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET give
  END

  # Life-force vitality score for science ASSERT:
  # alive*1000 + energy*10 + gen*100 - age + (active?50:0)
  METHOD vitality
    GETF THIS alive
    LET al = LAST_N
    IF al == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS gen
    LET g = LAST_N
    GETF THIS age
    LET a = LAST_N
    GETF THIS quiescent
    LET q = LAST_N
    LET v = 1000
    LET v = v + e * 10
    LET v = v + g * 100
    LET v = v - a
    IF q == 0 THEN
      LET v = v + 50
    END
    IF v < 0 THEN
      LET v = 0
    END
    RET v
  END

  # Sense mitosis pressure: energy - threshold (0 if dead).
  # Negative ⇒ need nutrients; zero/positive ⇒ at/above floor (still may be G0).
  METHOD sense
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET gap = e - th
    RET gap
  END

  # Repair: convert free energy into youth (reduce age). Retains life spark.
  # Costs min(n, energy-1) energy; sheds the same amount of age (floor 0).
  METHOD repair n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET spend = n
    IF spend > e THEN
      LET spend = e
    END
    # retain spark of life when possible
    IF e - spend < 1 THEN
      IF e > 1 THEN
        LET spend = e - 1
      ELSE
        LET spend = 0
      END
    END
    LET e = e - spend
    SETF THIS energy e
    GETF THIS age
    LET a = LAST_N
    IF a < spend THEN
      LET a = 0
    ELSE
      LET a = a - spend
    END
    SETF THIS age a
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET spend
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET spend
  END

  # Pulse: batch metabolic ticks (usability — AGI advances n ages in one SEND).
  # Returns final energy (0 if died mid-pulse). Caps n to 32 per call.
  METHOD pulse n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    IF n > 32 THEN
      LET n = 32
    END
    LET i = 0
    LET last_e = 0
    GETF THIS energy
    LET last_e = LAST_N
    WHILE i < n
      GETF THIS alive
      IF LAST_N == 0 THEN
        RET 0
      END
      # --- inlined tick body (SEND self not available mid-method) ---
      GETF THIS age
      LET ag = LAST_N + 1
      SETF THIS age ag
      GETF THIS energy
      LET e = LAST_N
      GETF THIS quiescent
      LET q = LAST_N
      IF q == 1 THEN
        LET e = e + 1
        LET e = e - 1
      ELSE
        LET e = e + 2
        LET e = e - 1
      END
      IF e < 0 THEN
        LET e = 0
      END
      SETF THIS energy e
      IF e == 0 THEN
        SETF THIS alive 0
        SETF THIS ready 0
        SETF THIS quiescent 0
        RET 0
      END
      IF ag > 40 THEN
        SETF THIS alive 0
        SETF THIS ready 0
        SETF THIS quiescent 0
        RET 0
      END
      LET rd = 0
      IF q == 0 THEN
        GETF THIS threshold
        LET th = LAST_N
        IF th < 1 THEN
          LET th = 10
        END
        IF e >= th THEN
          LET rd = 1
        END
      END
      SETF THIS ready rd
      LET last_e = e
      LET i = i + 1
    END
    RET last_e
  END

  # Glycogen-like reserve: bank free energy away from tick metabolism.
  # Keeps at least 1 active energy if alive (life spark). Returns banked amt.
  METHOD bank n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET move = n
    IF move > e THEN
      LET move = e
    END
    # retain spark of life when possible
    IF e - move < 1 THEN
      IF e > 1 THEN
        LET move = e - 1
      ELSE
        LET move = 0
      END
    END
    LET e = e - move
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + move
    SETF THIS reserve r
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET move
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET move
  END

  # Draw stored reserve back into active energy (stress recovery / feast).
  # Returns amount actually drawn.
  METHOD draw n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    LET r = r - take
    SETF THIS reserve r
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # Report reserve balance (glycogen stores) for science ASSERT boards.
  METHOD stores
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS reserve
    RET LAST_N
  END

  # Retune homeostasis target energy (preferred active pool).
  METHOD set_setpoint s
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF s < 1 THEN
      LET s = 1
    END
    SETF THIS setpoint s
    RET s
  END

  # Homeostat: bank surplus above setpoint into reserve; draw deficit from reserve.
  # Keeps life spark. Returns active energy after regulation.
  # Free energy seeks the preferred living level — AGI wonder under feast/famine.
  METHOD regulate
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 1 THEN
      LET sp = 10
      SETF THIS setpoint sp
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    IF e > sp THEN
      LET move = e - sp
      # retain spark if setpoint somehow under 1 (defensive)
      IF sp < 1 THEN
        IF e > 1 THEN
          LET move = e - 1
        ELSE
          LET move = 0
        END
      END
      LET e = e - move
      LET r = r + move
      SETF THIS energy e
      SETF THIS reserve r
    END
    IF e < sp THEN
      LET need = sp - e
      LET take = need
      IF take > r THEN
        LET take = r
      END
      LET r = r - take
      LET e = e + take
      SETF THIS energy e
      SETF THIS reserve r
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET e
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET e
  END

  # Bias vs homeostat setpoint: positive = surplus, negative = hungry.
  METHOD bias
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 1 THEN
      LET sp = 10
    END
    LET b = e - sp
    RET b
  END

  # Full metabolic wealth (active + glycogen stores) for science ASSERT.
  METHOD total
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    LET s = e + r
    RET s
  END

  # Hibernate prep: move all active energy above life-spark (1) into reserve.
  # Returns amount stowed. Ready clears unless spark alone meets threshold.
  METHOD stow
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET move = 0
    IF e > 1 THEN
      LET move = e - 1
      LET e = 1
    END
    GETF THIS reserve
    LET r = LAST_N + move
    SETF THIS energy e
    SETF THIS reserve r
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET move
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET move
  END

  # Emergency saturate: pour entire reserve into active energy. Arms mitosis if able.
  # Returns amount drawn. Free energy floods the living pool.
  METHOD saturate
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS reserve
    LET take = LAST_N
    SETF THIS reserve 0
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END
  # Convert active free energy into ATP work currency; retain life spark.
  # Returns amount charged. Dead/spark-only cells charge 0.
  METHOD charge n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET take = n
    # must retain life spark of 1
    IF e <= 1 THEN
      RET 0
    END
    IF take > e - 1 THEN
      LET take = e - 1
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    # recompute ready
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # Burn ATP for work units. Returns amount spent.
  METHOD spend n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET sp = n
    IF sp > a THEN
      LET sp = a
    END
    LET a = a - sp
    SETF THIS atp a
    RET sp
  END

  # Report ATP balance for science ASSERT boards.
  METHOD charged
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS atp
    RET LAST_N
  END

  # Spend 1 ATP to arm ready when energy is within 2 of threshold (work gift).
  # Returns 1 if armed (or already ready), 0 otherwise.
  METHOD catalyze
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS ready
    IF LAST_N == 1 THEN
      RET 1
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    GETF THIS energy
    LET e = LAST_N
    # near threshold: energy + 2 >= th
    LET need = th - 2
    IF need < 1 THEN
      LET need = 1
    END
    IF e < need THEN
      RET 0
    END
    LET a = a - 1
    SETF THIS atp a
    SETF THIS ready 1
    RET 1
  END

END
