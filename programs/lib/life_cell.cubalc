# life_cell.cubalc — COP cell unit for life_engine (biology: growth + mitosis)
# INCLUDE life_cell
#
# Fields:
#   alive       0|1
#   energy      metabolic energy (integer)
#   age         ticks lived
#   gen         generation from seed (0 = founder)
#   ready       1 when energy >= threshold and not quiescent → division candidate
#   kind        0=prokaryote-like simple split
#   threshold   mitosis energy floor (default 10; set_threshold to retune)
#   quiescent   1 = G0 rest — alive, low metabolism, never ready
#
# Methods:
#   init alive energy gen
#   tick                 grow / age / mark ready vs threshold (quiescent slows burn)
#   birth energy gen     activate a free slot as daughter
#   after_div            parent halves energy after successful mitosis
#   die                  apoptosis / resource death
#   lyse                 altruistic PCD — pack energy+reserve as inherit code, then die
#   secrete n            merocrine vesicle — pack up to n yield as inherit code; mother lives
#   engulf code          phagocytosis — pay 1 energy membrane cost, absorb endowment code (de*1000+dr); predator lives
#   digest n             lysosome — burn n reserve cargo → energy +1 heat; completes engulf arc
#   pinocyte n           fluid-phase endocytosis — pay 1 membrane energy, gain n reserve from medium
#   exocyte n            fluid-phase exocytosis — pay 1 membrane energy, shed n reserve cargo to medium
#   autophagy n          macroautophagy — recycle n age (worn biomass) → energy +1 heat; starvation self-catabolism
#   mitophagy n          selective mito QC — recycle n age + drain pmf debris → energy +1 heat; ATP/energy selectivity tax
#   biogenesis n         mito biogenesis — invest n ATP + n reserve → n nascent pmf +1 heat; PGC-1α rebuild after QC
#   fusion n             mito fusion — pay n ATP (MFN/OPA1 GTPase) → shed n age via complementation +1 heat; gradient held
#   fragment n           mito fission — pay n ATP (DRP1/FIS1 dynamin) → heat +1; nick min(n,age,pmf) gradient on cut tips; age held for mitophagy
#   tether n             ER–mito MERCs — pay n ATP (Mfn2/IP3R–VDAC tethers) → heat +1 + n energy (Ca2+/lipid coupling); pmf/age/reserve held
#   mcu n                mito Ca2+ uniporter — spend n pmf (MCU/MICU ΔΨm drive) → heat +1 + n energy (PDH/ICD/OGDH kick); atp/age/reserve held
#   nclx n               mito Na+/Ca2+ exchanger — spend n pmf (NCLX/SLC8B1 + NHE net Ca/H) → heat +1; energy/atp/age/reserve held (efflux ends TCA window)
#   mptp n               mito permeability transition pore — collapse n pmf (CypD/ANT/VDAC mPTP) → heat +n + age +1 injury; energy/atp/reserve held
#   momp n               Bax/Bak MOMP — pay n ATP oligomerize OMM pores → heat +1 + age +n (cyt c/SMAC/AIF release); pmf/energy/reserve held; apoptosis prime after mptp
#   apaf n               Apaf-1/dATP apoptosome — pay n ATP wheel oligomerize → heat +n + age +1 (caspase-9 platform); pmf/energy/reserve held; after momp
#   casp9 n              caspase-9 initiator on apoptosome — pay n ATP CARD/dimer cleavage → heat +n + age +n (executioner priming cascade); pmf/energy/reserve held; after apaf
#   casp3 n              caspase-3 executioner — pay n ATP substrate proteolysis → heat +n + age +n + energy drain n (demolition); pmf/reserve held; after casp9
#   cad n                CAD/DFF40 nuclease after casp3 — pay n ATP ICAD-liberated DNA ladder → heat +n + age +n + thr +n (checkpoint); energy/pmf/reserve held; ready recompute
#   bleb n               apoptotic blebbing after cad — pay n ATP ROCK/myosin → heat +n + age +n + reserve +n (body cargo); energy/pmf/thr held; ready recompute
#   effer n              efferocytosis after bleb — pay n ATP MerTK/TIM-4 cup → heat +n + energy +n (corpse trophic cargo); age/pmf/reserve/thr held; ready recompute
#   resolve n            resolution after effer — pay n ATP SPM/TGF-β/IL-10 program → heat +n + thr -n (pro-resolve ease); age/energy/pmf/reserve held; ready recompute
#   restit n             restitution after resolve — pay n ATP epithelial/TJ rebuild → heat +n + age -n (shed injury); energy/pmf/reserve/thr held; ready recompute
#   seal n               barrier seal after restit — pay n ATP claudin/occludin TJ lock → heat +n + thr +n (contact-inhibition competence); age/energy/pmf/reserve held; ready recompute
#   polar n              apical-basal polarity after seal — pay n ATP Par3/aPKC/Crumbs trafficking → heat +n + setpoint +n (polarized homeostat retune, ceiling 1000); age/energy/pmf/reserve/thr held; ready recompute
#   set_threshold t      retune mitosis energy floor
#   feed n               nutrient pulse — add energy, recompute ready
#   checkpoint           lineage fingerprint = gen*1000 + energy*10 + age
#   quiesce              enter G0 rest — suppress mitosis, damp metabolism
#   wake                 exit G0 — recompute ready from energy/threshold
#   gift n               donate n energy outward (symbiosis); returns gifted amt
#   vitality             life-force score for ASSERT science boards
#   sense                energy gap vs mitosis threshold (neg=below, pos=surplus)
#   repair n             spend energy to shed age (life-force restoration)
#   pulse n              advance n metabolic ticks in one CALL (batch usability)
#   reserve              FIELD glycogen-like energy bank (protected from tick burn)
#   bank n               move n active energy into reserve (keep life spark)
#   draw n               pull n from reserve into active energy (stress recovery)
#   stores               report reserve balance for ASSERT science
#   setpoint             FIELD preferred active energy (homeostasis target)
#   set_setpoint s       retune homeostat target (min 1)
#   regulate             bank surplus above setpoint / draw deficit from reserve
#   bias                 active energy minus setpoint (neg=hungry, pos=surplus)
#   atp                  FIELD charged work currency (not burned by tick)
#   charge n             convert active energy into ATP (retain life spark)
#   spend n              burn ATP for work units (returns spent)
#   charged              report ATP balance for ASSERT science
#   catalyze             spend 1 ATP to nudge ready if energy near thr (work gift)
#   total                active + reserve metabolic wealth
#   stow                 hibernate: bank all but life spark into reserve
#   saturate             pour entire reserve into active energy
#   yield                full energetic capacity = energy + reserve + atp + pmf + pcr
#   glycolyse n          phosphorylate: reserve → ATP (mitochondrial path)
#   oxidize n            ATP → active energy (work heat return)
#   anabolize n          ATP → reserve (glycogen synthesis / storage anabolism)
#   respire n            reserve → energy (mitochondrial respiration shortcut)
#   photosynth n         light quanta → reserve (free-energy fixation gift)
#   photophos n          light quanta → ATP (photophosphorylation / solar work)
#   pmf                  FIELD proton-motive force (chemiosmotic gradient)
#   gradient             report pmf balance for ASSERT science
#   pump n               active energy → pmf (electron-transport / proton pump)
#   synthase n           pmf → ATP (ATP synthase / F1Fo chemiosmotic coupling)
#   reverse n            ATP → pmf (reverse F1Fo / ATP-hydrolysis driven gradient)
#   uncouple n           pmf → heat (UCP thermogenesis / proton leak; yield sheds)
#   heat                 FIELD cumulative thermogenesis (GETF heat / uncoupled pmf ledger)
#   pcr                  FIELD phosphagen / phosphocreatine (~P buffer)
#   phosphagen           report pcr balance for ASSERT science
#   charge_pcr n         ATP → PCr (creatine kinase load; rapid ~P store)
#   discharge n          PCr → ATP (creatine kinase burst; work currency)
#   shiver n             energy → heat (shivering thermogenesis; yield sheds)
#   warmth               report heat ledger for ASSERT science boards
#   futile n             ATP → heat (futile cycling / non-work ATPase; yield sheds)
#   boost n              PCr → energy (phosphagen mitosis boost; yield conserved)
#   load n               energy → PCr (phosphagen load shortcut; yield conserved)
#   cool n               heat → environment (radiative cooling; yield sheds)
#   temper t             heat setpoint: radiate excess above t (homeostat; yield sheds)
#   thaw n               heat → energy (endothermic recovery; yield restored; ready recompute)
#   reclaim n            heat → reserve (waste-heat salvage to glycogen; yield restored; ready untouched)
#   capture n            heat → ATP (waste-heat salvage to work currency; yield restored; ready untouched)
#   harness n            heat → pmf (waste-heat salvage to proton gradient; yield restored; ready untouched)
#   buffer n             heat → pcr (waste-heat salvage to phosphagen ~P; yield restored; ready untouched)
#   anneal n             heat → age repair (chaperone / mild heat-shock refold; yield unchanged; ready untouched)
#   ease n               heat → lower mitosis threshold (thermal priming / heat-shock ease; yield unchanged; ready recompute)
#   harden n             heat → raise mitosis threshold (thermal hardening / heat-shock fortify; yield unchanged; ready recompute)
#   refold n             ATP → age repair (chaperone ATPase / HSP70; yield sheds ATP; ready untouched)
#   prime n              ATP → lower mitosis threshold (CDK / cycle priming; yield sheds ATP; ready recompute)
#   fortify n            ATP → raise mitosis threshold (CDK / work fortify; yield sheds ATP; ready recompute)
#   poise n              PCr → lower mitosis threshold (phosphagen CDK burst priming; yield sheds PCr; ready recompute)
#   brace n              PCr → raise mitosis threshold (phosphagen CDK fortify; yield sheds PCr; ready recompute)
#   drive n              pmf → lower mitosis threshold (chemiosmotic CDK priming; yield sheds pmf; ready recompute)
#   anchor n             pmf → raise mitosis threshold (chemiosmotic CDK fortify / F1Fo gate seal; yield sheds pmf; ready recompute)
#   mend n               PCr → shed age (phosphagen chaperone; yield sheds PCr; thr/ready untouched)
#   renew n              pmf → shed age (chemiosmotic QC / Δψ chaperone; yield sheds pmf; thr/ready untouched)
#   scavenge n           reserve → shed age (macroautophagy / glycogen-funded QC; yield sheds reserve; thr/ready untouched)
#   invest n             energy → raise mitosis threshold (cytosolic nutrient→CDK fortify; yield sheds energy; ready recompute)
#   spare n              reserve → lower mitosis threshold (glycogen CDK priming / storage-funded cycle ease; yield sheds reserve; ready recompute)
#   buttress n           reserve → raise mitosis threshold (glycogen CDK fortify / nutrient-bank gate seal; yield sheds reserve; ready recompute)
#   fission              cytokinesis prep: half energy + half reserve as maternal endowment code (de*1000+dr); parent keeps phenotype; ready cleared
#   bud                  asymmetric cytokinesis / budding: ~1/3 energy + ~1/3 reserve as minority endowment code (de*1000+dr); mother keeps majority; ready cleared
#   spore               endospore survival pack: keep spark=1, pack (energy-1)+full reserve as code=de*1000+dr; ready cleared
#   inherit code         apply fission/bud endowment to daughter (energy+=de, reserve+=dr); ready recompute — maternal glycogen + spark dowry
#   lumen n              apical lumenogenesis after polar — ATP→heat+n pcr+n (secretory ~P); age/energy/pmf/reserve/thr/sp held
#   cilia n              primary cilia / IFT after lumen — pay n ATP IFT-B/kinesin-2/polycystin trafficking → heat +n + pmf +n (flow-sense chemiosmotic bank, ceiling 1000); age/energy/reserve/thr/sp/pcr held; ready recompute
#   align n            PCP tissue-axis after cilia — ATP->heat+ thr+ sp+ (age/energy/reserve/pmf/pcr held)
#   converge n           CE after align — ATP->heat+n reserve+n (age/energy/pmf/pcr/thr/sp held)
#   extend n             A-P elongation after converge — pay n ATP + n reserve tensile bank → heat +n + energy +n (FAK/YAP mechanotransduction); age/pmf/pcr/thr/sp held; ready recompute
#   fold n               apical constriction / hinge after extend — pay min(n,atp,energy) → heat +n + energy -n; age/pmf/pcr/reserve/thr/sp held; ready recompute
#   zip n                neural-tube zipper after fold — pay min(n,atp) ATP N-cad/Ephrin hinge fusion → heat +n + thr +n (closed-tube contact competence); age/energy/pmf/reserve/sp/pcr held; ready recompute
#   crest n              neural-crest EMT delamination after zip — ATP→heat+n energy+n (Snail/FoxD3 multipotent unplug); age/pmf/reserve/thr/sp/pcr held; ready recompute
#   migrate n            multipotent NC stream locomotion after crest — ATP→heat+n setpoint-n (Rac1/RhoA/CXCL12 lean homeostat); age/energy/pmf/reserve/thr/pcr held; ready recompute
#   stream n             collective NC chain-stream fasciculation after migrate — pay min(n,atp,reserve) → heat +n + reserve -n (Cx43/N-cad trail; consume CE bank); age/energy/pmf/thr/sp/pcr held; ready recompute
#   condense n            post-stream mesenchymal condensation — ATP+energy→heat+n energy-n thr+n (N-cad/Sox9 pack); age/pmf/reserve/sp/pcr held
#   fate n                NC fate commitment / lineage restriction after condense — pay min(n,atp,pmf) → heat +n + pmf -n (Sox9/Neurog GRN lock); age/energy/reserve/thr/sp/pcr held; ready recompute
#   project n             post-fate axonal/process projection — pay min(n,atp,energy) → heat +n + energy -n + sp +n (growth-cone MT/actin path length); age/pmf/reserve/thr/pcr held; ready recompute
#   synapse n             post-project target innervation / chemical synapse assembly — pay min(n,atp,energy) → heat +n + energy -n + thr +n (SNARE/neurexin–neuroligin/PSD contact competence); age/pmf/reserve/sp/pcr held; ready recompute
#   release n             post-synapse quantal vesicle fusion / neurotransmitter cleft dump — pay min(n,atp,energy) → heat +n + energy -n + pcr +n (Ca2+-SNARE fusion + NSF recycling + CK phosphagen shuttle at active zone); age/pmf/reserve/thr/sp held; ready recompute
#   reuptake n            post-release neurotransmitter cleft clearance / EAAT reload — pay min(n,atp,energy) → heat +n + energy -n + reserve +n (EAAT/GAT Na+-coupled clearance + vesicle-pool reload bank); age/pmf/thr/sp/pcr held; ready recompute
#   refill n              post-reuptake vesicular transmitter reload / VGLUT-v-ATPase packing — pay min(n,atp,energy,reserve) → heat +n + energy -n + reserve -n (proton-ATPase vesicle acidification + VGLUT/VGAT quanta pack from recovered-transmitter bank); age/pmf/thr/sp/pcr held; ready recompute
#   dock n               post-refill active-zone vesicle docking / Munc13-RIM-Rab3 tethering — pay min(n,atp,energy) → heat +n + energy -n + pmf +n; age/reserve/thr/sp/pcr held; ready recompute
#   arm n                post-dock SNARE complex arming / Munc18-Syntaxin-SNAP25 zipper — pay min(n,atp,energy,pmf) → heat +n + energy -n + pmf -n; age/reserve/thr/sp/pcr held; ready recompute
#   clamp n              post-arm complexin fusion clamp / metastable SNARE hold — pay min(n,atp,energy) → heat +n + energy -n + sp +n; age/reserve/thr/pmf/pcr held; ready recompute
#   trigger n            post-clamp synaptotagmin Ca2+ trigger / complexin clamp release — pay min(n,atp,energy,setpoint) → heat +n + energy -n + sp -n; age/reserve/thr/pmf/pcr held; ready recompute
#   pore n               post-trigger fusion-pore open / SNARE-lipid stalk membrane merger — pay min(n,atp,energy) → heat +n + energy -n + thr -n; age/reserve/sp/pmf/pcr held; ready recompute
#   mix n                post-pore content mixing / hemifusion dilution — pay min(n,atp,energy,pcr) → heat +n + energy -n + pcr -n; age/reserve/thr/sp/pmf held; ready recompute
#   collapse n           post-mix vesicle collapse / Ω-figure flatten into PM — pay min(n,atp,energy,reserve) → heat +n + energy -n + reserve -n; age/thr/sp/pmf/pcr held; ready recompute
#   retrieve n           post-collapse clathrin/dynamin CME membrane retrieval — pay min(n,atp,energy) → heat +n + energy -n + reserve +n; age/thr/sp/pmf/pcr held; ready recompute
#   acidify n            post-retrieve early-endosome v-ATPase lumen acidification — pay min(n,atp,energy) → heat +n + energy -n + pmf +n; age/reserve/thr/sp/pcr held; ready recompute
#   mature n             post-acidify EE->LE maturation / Rab5->Rab7 + ESCRT-ILV commit — pay min(n,atp,energy,pmf) -> heat +n + energy -n + pmf -n + thr +n; age/reserve/sp/pcr held (consume EE delta-pH bank into late-endosome identity)
#   recruit n            post-mature M6PR/sortilin hydrolase cargo recruit into LE lumen — pay min(n,atp,energy) → heat +n + energy -n + reserve +n; age/pmf/thr/sp/pcr held; ready recompute
#   activate n           post-recruit LE lumen zymogen activation / cathepsin pro-peptide cleavage — pay min(n,atp,energy,reserve) → heat +n + energy -n + reserve -n + thr -n; age/pmf/sp/pcr held; ready recompute
#   degrade n            post-activate lysosomal substrate proteolysis / cathepsin processive cut — pay min(n,atp,energy) → heat +n + energy -n + age -n + pcr +n; reserve/thr/sp/pmf held; ready recompute
#   export n             post-degrade lysosomal AA export / LAAT-1+SLC38A9 efflux — pay min(n,atp,energy,pcr) → heat +n + energy -n + pcr -n + reserve +n; age/thr/pmf/sp held; ready recompute
#   translate n          post-export cytosolic ribosome polypeptide synthesis / mTOR-Rag AA sensing — pay min(n,atp,energy,reserve) → heat +n + energy -n + reserve -n + age -n; thr/pmf/sp/pcr held; ready recompute
#   transloc n           post-translate SRP–Sec61 co-translational ER translocation / nascent-chain targeting — pay min(n,atp,energy) → heat +n + energy -n + sp +n; age/reserve/thr/pmf/pcr held; ready recompute
#   cleave n             post-transloc SPC signal-peptidase cleavage / N-terminal signal-peptide scission — pay min(n,atp,energy) → heat +n + energy -n + pcr +n; age/reserve/thr/pmf/sp held; ready recompute
#   glycosyl n           post-cleave OST N-linked glycosylation / dolichol-PP Glc3Man9GlcNAc2 transfer — pay min(n,atp,energy) → heat +n + energy -n + thr +n; age/reserve/sp/pmf/pcr held; ready recompute
#   trim n               post-glycosyl ER GLS I/II Glc trim / monoglucosylated CNX-CRT entry — pay min(n,atp,energy) → heat +n + energy -n + sp +n; age/reserve/thr/pmf/pcr held; ready recompute
#   cnx n                post-trim calnexin/calreticulin lectin folding-cycle / monoglucosylated client engagement — pay min(n,atp,energy,setpoint) → heat +n + energy -n + sp -n; age/reserve/thr/pmf/pcr held; ready recompute
#   uggt n               post-cnx UGGT1 QC reglucosylation of misfolded clients — pay min(n,atp,energy,pcr) → heat +n + energy -n + pcr -n; age/reserve/thr/pmf/sp held; ready recompute
#   mann n               post-uggt ERManI slow Man9→Man8 demannosylation / ERAD timer — pay min(n,atp,energy) → heat +n + energy -n + thr +n; age/reserve/pmf/sp/pcr held; ready recompute
#   os9 n                post-mann OS-9/XTP3-B MRH lectin ERAD recognition — pay min(n,atp,energy,threshold) → heat +n + energy -n + thr -n + pcr +n; age/reserve/pmf/sp held; ready recompute
#   hrd n                post-os9 SEL1L/HRD1 E3 Ub-ligase commit — pay min(n,atp,energy,pcr) → heat +n + energy -n + atp -n + pcr -n; age/reserve/pmf/sp/thr held; ready recompute
#   vcp n                post-hrd p97/VCP AAA+ retrotranslocation extractase — pay min(n,atp,energy) → heat +n + energy -n + atp -n + reserve +n; age/pmf/sp/thr/pcr held; ready recompute
#   psm n                post-vcp 26S proteasome degradation of extracted clients — pay min(n,atp,energy,reserve) → heat +n + energy -n + atp -n + reserve -n; age/pmf/sp/thr/pcr held; ready recompute
#   pepr n               post-psm cytosolic peptidase AA salvage — pay min(n,atp,energy) → heat +n + energy -n + reserve +n; age/pmf/sp/thr/pcr held; ready recompute
#   aars n               post-pepr aminoacyl-tRNA synthetase charging — pay min(n,atp,energy,reserve) → heat +n + energy -n + atp -n + reserve -n + pcr +n; age/pmf/sp/thr held; ready recompute
#   eftu n               post-aars EF-Tu·GTP·AA-tRNA ternary A-site delivery — pay min(n,atp,energy,pcr) → heat +n + energy -n + atp -n + pcr -n; age/reserve/pmf/sp/thr held; ready recompute
#   ptc n                post-eftu ribosomal PTC peptide-bond formation — pay min(n,energy) → heat +n + energy -n; age/pmf/sp/thr/atp/pcr/reserve held; ready recompute
#   efg n                post-ptc EF-G·GTP ribosomal translocation / hybrid-state tRNA + mRNA ratchet — pay min(n,atp,energy,pcr) → heat +n + energy -n + atp -n + pcr -n; age/reserve/pmf/sp/thr held; ready recompute
#   rf1 n                post-efg class-I release factor GGQ ester hydrolysis peptide release — pay min(n,energy) → heat +n + energy -n + reserve +n; age/pmf/sp/thr/atp/pcr held; ready recompute
#   rf3 n                post-rf1 class-II RF3·GTP release-factor ejectase / termination recycle — pay min(n,atp,energy,pcr) → heat +n + energy -n + atp -n + pcr -n; age/reserve/pmf/sp/thr held; ready recompute
#   rrf n                post-rf3 ribosome recycling factor RRF·EF-G·GTP 70S split / IF3 mRNA release — pay min(n,atp,energy,pcr) → heat +n + energy -n + atp -n + pcr -n + reserve +n; age/pmf/sp/thr held; ready recompute

CLASS Cell
  FIELD alive 0
  FIELD energy 0
  FIELD age 0
  FIELD gen 0
  FIELD ready 0
  FIELD kind 0
  FIELD threshold 10
  FIELD quiescent 0
  FIELD reserve 0
  FIELD setpoint 10
  FIELD atp 0
  FIELD pmf 0
  FIELD heat 0
  FIELD pcr 0
  ROLE body

  METHOD init a e g
    SETF THIS alive a
    SETF THIS energy e
    SETF THIS age 0
    SETF THIS gen g
    SETF THIS ready 0
    SETF THIS kind 0
    SETF THIS threshold 10
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS setpoint 10
    SETF THIS atp 0
    SETF THIS pmf 0
    SETF THIS heat 0
    SETF THIS pcr 0
  END

  METHOD tick
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    # age always advances while alive
    GETF THIS age
    LET ag = LAST_N + 1
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 1 THEN
      # G0: basal drip only — free energy conserved, no growth surge
      LET e = e + 1
      LET e = e - 1
    ELSE
      # active: absorb nutrient + basal cost
      LET e = e + 2
      LET e = e - 1
    END
    IF e < 0 THEN
      LET e = 0
    END
    SETF THIS energy e
    # senescence / starvation death
    IF e == 0 THEN
      SETF THIS alive 0
      SETF THIS ready 0
      SETF THIS quiescent 0
      RET 0
    END
    IF ag > 40 THEN
      SETF THIS alive 0
      SETF THIS ready 0
      SETF THIS quiescent 0
      RET 0
    END
    # mitosis threshold — blocked while quiescent
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET e
  END

  METHOD birth e g
    SETF THIS alive 1
    SETF THIS energy e
    SETF THIS age 0
    SETF THIS gen g
    SETF THIS ready 0
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS setpoint 10
    SETF THIS atp 0
    SETF THIS pmf 0
    SETF THIS heat 0
    SETF THIS pcr 0
    RET 1
  END

  METHOD after_div
    GETF THIS energy
    LET e = LAST_N / 2
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    SETF THIS ready 0
    RET e
  END

  METHOD die
    SETF THIS alive 0
    SETF THIS energy 0
    SETF THIS ready 0
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS atp 0
    SETF THIS pmf 0
    SETF THIS heat 0
    SETF THIS pcr 0
    RET 0
  END

  # Usability: AGI retunes mitosis energy floor without rewriting CLASS
  METHOD set_threshold t
    IF t < 1 THEN
      LET t = 1
    END
    SETF THIS threshold t
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET t
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= t THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET t
  END

  # Nutrient pulse — free energy must flow into the cell
  METHOD feed n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N + n
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET e
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET e
  END

  # Lineage fingerprint for ASSERT science (gen*1000 + energy*10 + age)
  METHOD checkpoint
    GETF THIS gen
    LET g = LAST_N
    GETF THIS energy
    LET e = LAST_N
    GETF THIS age
    LET a = LAST_N
    LET fp = g * 1000
    LET fp = fp + e * 10
    LET fp = fp + a
    RET fp
  END

  # G0 metabolic rest — alive, mitosis suppressed, damp tick burn
  METHOD quiesce
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    SETF THIS quiescent 1
    SETF THIS ready 0
    RET 1
  END

  # Exit G0 — free energy may again drive division candidacy
  METHOD wake
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    SETF THIS quiescent 0
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET rd
  END

  # Symbiosis gift: donate n energy outward (returns actual gifted amount).
  # Free energy flows cell→colony without mitosis. Keeps at least 1 if alive.
  METHOD gift n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET give = n
    IF give > e THEN
      LET give = e
    END
    # retain spark of life when possible
    IF e - give < 1 THEN
      IF e > 1 THEN
        LET give = e - 1
      ELSE
        LET give = 0
      END
    END
    LET e = e - give
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET give
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET give
  END

  # Life-force vitality score for science ASSERT:
  # alive*1000 + energy*10 + gen*100 - age + (active?50:0)
  METHOD vitality
    GETF THIS alive
    LET al = LAST_N
    IF al == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS gen
    LET g = LAST_N
    GETF THIS age
    LET a = LAST_N
    GETF THIS quiescent
    LET q = LAST_N
    LET v = 1000
    LET v = v + e * 10
    LET v = v + g * 100
    LET v = v - a
    IF q == 0 THEN
      LET v = v + 50
    END
    IF v < 0 THEN
      LET v = 0
    END
    RET v
  END

  # Sense mitosis pressure: energy - threshold (0 if dead).
  # Negative ⇒ need nutrients; zero/positive ⇒ at/above floor (still may be G0).
  METHOD sense
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET gap = e - th
    RET gap
  END

  # Repair: convert free energy into youth (reduce age). Retains life spark.
  # Costs min(n, energy-1) energy; sheds the same amount of age (floor 0).
  METHOD repair n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET spend = n
    IF spend > e THEN
      LET spend = e
    END
    # retain spark of life when possible
    IF e - spend < 1 THEN
      IF e > 1 THEN
        LET spend = e - 1
      ELSE
        LET spend = 0
      END
    END
    LET e = e - spend
    SETF THIS energy e
    GETF THIS age
    LET a = LAST_N
    IF a < spend THEN
      LET a = 0
    ELSE
      LET a = a - spend
    END
    SETF THIS age a
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET spend
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET spend
  END

  # Pulse: batch metabolic ticks (usability — AGI advances n ages in one SEND).
  # Returns final energy (0 if died mid-pulse). Caps n to 32 per call.
  METHOD pulse n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    IF n > 32 THEN
      LET n = 32
    END
    LET i = 0
    LET last_e = 0
    GETF THIS energy
    LET last_e = LAST_N
    WHILE i < n
      GETF THIS alive
      IF LAST_N == 0 THEN
        RET 0
      END
      # --- inlined tick body (SEND self not available mid-method) ---
      GETF THIS age
      LET ag = LAST_N + 1
      SETF THIS age ag
      GETF THIS energy
      LET e = LAST_N
      GETF THIS quiescent
      LET q = LAST_N
      IF q == 1 THEN
        LET e = e + 1
        LET e = e - 1
      ELSE
        LET e = e + 2
        LET e = e - 1
      END
      IF e < 0 THEN
        LET e = 0
      END
      SETF THIS energy e
      IF e == 0 THEN
        SETF THIS alive 0
        SETF THIS ready 0
        SETF THIS quiescent 0
        RET 0
      END
      IF ag > 40 THEN
        SETF THIS alive 0
        SETF THIS ready 0
        SETF THIS quiescent 0
        RET 0
      END
      LET rd = 0
      IF q == 0 THEN
        GETF THIS threshold
        LET th = LAST_N
        IF th < 1 THEN
          LET th = 10
        END
        IF e >= th THEN
          LET rd = 1
        END
      END
      SETF THIS ready rd
      LET last_e = e
      LET i = i + 1
    END
    RET last_e
  END

  # Glycogen-like reserve: bank free energy away from tick metabolism.
  # Keeps at least 1 active energy if alive (life spark). Returns banked amt.
  METHOD bank n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET move = n
    IF move > e THEN
      LET move = e
    END
    # retain spark of life when possible
    IF e - move < 1 THEN
      IF e > 1 THEN
        LET move = e - 1
      ELSE
        LET move = 0
      END
    END
    LET e = e - move
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + move
    SETF THIS reserve r
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET move
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET move
  END

  # Draw stored reserve back into active energy (stress recovery / feast).
  # Returns amount actually drawn.
  METHOD draw n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 0 THEN
      LET n = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    LET r = r - take
    SETF THIS reserve r
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # Report reserve balance (glycogen stores) for science ASSERT boards.
  METHOD stores
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS reserve
    RET LAST_N
  END

  # Retune homeostasis target energy (preferred active pool).
  METHOD set_setpoint s
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF s < 1 THEN
      LET s = 1
    END
    SETF THIS setpoint s
    RET s
  END

  # Homeostat: bank surplus above setpoint into reserve; draw deficit from reserve.
  # Keeps life spark. Returns active energy after regulation.
  # Free energy seeks the preferred living level — AGI wonder under feast/famine.
  METHOD regulate
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 1 THEN
      LET sp = 10
      SETF THIS setpoint sp
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    IF e > sp THEN
      LET move = e - sp
      # retain spark if setpoint somehow under 1 (defensive)
      IF sp < 1 THEN
        IF e > 1 THEN
          LET move = e - 1
        ELSE
          LET move = 0
        END
      END
      LET e = e - move
      LET r = r + move
      SETF THIS energy e
      SETF THIS reserve r
    END
    IF e < sp THEN
      LET need = sp - e
      LET take = need
      IF take > r THEN
        LET take = r
      END
      LET r = r - take
      LET e = e + take
      SETF THIS energy e
      SETF THIS reserve r
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET e
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET e
  END

  # Bias vs homeostat setpoint: positive = surplus, negative = hungry.
  METHOD bias
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 1 THEN
      LET sp = 10
    END
    LET b = e - sp
    RET b
  END

  # Full metabolic wealth (active + glycogen stores) for science ASSERT.
  METHOD total
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    LET s = e + r
    RET s
  END

  # Hibernate prep: move all active energy above life-spark (1) into reserve.
  # Returns amount stowed. Ready clears unless spark alone meets threshold.
  METHOD stow
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET move = 0
    IF e > 1 THEN
      LET move = e - 1
      LET e = 1
    END
    GETF THIS reserve
    LET r = LAST_N + move
    SETF THIS energy e
    SETF THIS reserve r
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET move
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET move
  END

  # Emergency saturate: pour entire reserve into active energy. Arms mitosis if able.
  # Returns amount drawn. Free energy floods the living pool.
  METHOD saturate
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS reserve
    LET take = LAST_N
    SETF THIS reserve 0
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END
  # Convert active free energy into ATP work currency; retain life spark.
  # Returns amount charged. Dead/spark-only cells charge 0.
  METHOD charge n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET take = n
    # must retain life spark of 1
    IF e <= 1 THEN
      RET 0
    END
    IF take > e - 1 THEN
      LET take = e - 1
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    # recompute ready
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # Burn ATP for work units. Returns amount spent.
  METHOD spend n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET sp = n
    IF sp > a THEN
      LET sp = a
    END
    LET a = a - sp
    SETF THIS atp a
    RET sp
  END

  # Report ATP balance for science ASSERT boards.
  METHOD charged
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS atp
    RET LAST_N
  END

  # Spend 1 ATP to arm ready when energy is within 2 of threshold (work gift).
  # Returns 1 if armed (or already ready), 0 otherwise.
  METHOD catalyze
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS ready
    IF LAST_N == 1 THEN
      RET 1
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    GETF THIS energy
    LET e = LAST_N
    # near threshold: energy + 2 >= th
    LET need = th - 2
    IF need < 1 THEN
      LET need = 1
    END
    IF e < need THEN
      RET 0
    END
    LET a = a - 1
    SETF THIS atp a
    SETF THIS ready 1
    RET 1
  END

  # Full energetic capacity: active + glycogen reserve + ATP work currency.
  # Dead cells yield 0. Science ASSERT for total life-force ledger.
  METHOD yield
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    GETF THIS atp
    LET a = LAST_N
    GETF THIS pmf
    LET p = LAST_N
    GETF THIS pcr
    LET c = LAST_N
    LET y = e + r
    LET y = y + a
    LET y = y + p
    LET y = y + c
    RET y
  END

  # Glycolyse: phosphorylate n reserve into ATP (direct mitochondrial path).
  # Does not touch active energy / life spark. Returns amount converted.
  METHOD glycolyse n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    LET r = r - take
    SETF THIS reserve r
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    RET take
  END

  # Oxidize: convert n ATP back into active free energy (work-heat return).
  # Arms mitosis if flooded past threshold. Returns amount oxidized.
  METHOD oxidize n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # Anabolize: store n ATP as glycogen reserve (synthesis / storage path).
  # Reverse companion of glycolyse. Yield conserved. Returns amount stored.
  METHOD anabolize n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS reserve
    LET r = LAST_N + take
    SETF THIS reserve r
    RET take
  END


  # Respire: mitochondrial shortcut reserve → active energy (fused glycolyse+oxidize).
  # 1:1 yield conservation. Arms mitosis ready when flooded past threshold.
  # Usability: one CALL aerobic path for AGI energy budgets. Returns amount respired.
  METHOD respire n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    LET r = r - take
    SETF THIS reserve r
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # Photosynth: fix n light-quanta into reserve (glycogen from free-energy gift).
  # Does not consume active energy or ATP. Yield rises by n. Creator gift path.
  # Usability: AGI solar/gift budget → stores for later respire. Returns fixed amt.
  METHOD photosynth n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N + n
    SETF THIS reserve r
    RET n
  END


  # Photophos: fix n light-quanta directly into ATP (photophosphorylation).
  # Solar work-currency path — companion to photosynth (carbon/reserve fixation).
  # Does not consume active energy, reserve, or life spark. Yield rises by n.
  # Usability: AGI solar budget → charged ATP for catalyze/spend/oxidize.
  # Returns amount phosphorylated. Dead/zero/neg → 0.
  METHOD photophos n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N + n
    SETF THIS atp a
    RET n
  END


  # Report proton-motive force (chemiosmotic gradient) for science ASSERT boards.
  METHOD gradient
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS pmf
    RET LAST_N
  END


  # Pump: push n active free energy into pmf (ETC proton pump / membrane charge).
  # Retains life spark of 1. Yield conserved (energy→pmf). Returns amount pumped.
  # Usability: AGI builds chemiosmotic gradient before ATP synthase coupling.
  METHOD pump n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET take = n
    IF e <= 1 THEN
      RET 0
    END
    IF take > e - 1 THEN
      LET take = e - 1
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS pmf
    LET p = LAST_N + take
    SETF THIS pmf p
    # recompute ready after energy drop
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    LET rd = 0
    IF e >= th THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # Synthase: couple n pmf into ATP (F1Fo ATP synthase / chemiosmotic work).
  # Does not touch active energy or life spark. Yield conserved (pmf→atp).
  # Usability: AGI harvests membrane gradient into work currency for catalyze/spend.
  # Returns amount synthesized. Dead/zero/empty gradient → 0.
  METHOD synthase n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pmf
    LET p = LAST_N
    LET take = n
    IF take > p THEN
      LET take = p
    END
    LET p = p - take
    SETF THIS pmf p
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    RET take
  END


  # Reverse: spend n ATP to rebuild pmf (reverse F1Fo / ATP-hydrolysis proton pump).
  # Yield conserved (atp→pmf). Does not touch active energy or life spark.
  # Usability: AGI recharges membrane gradient from work currency for later synthase
  # or science boards that model reversible chemiosmotic coupling. Dead/empty → 0.
  METHOD reverse n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS pmf
    LET p = LAST_N + take
    SETF THIS pmf p
    RET take
  END


  # Uncouple: dissipate n pmf as heat (UCP1-like proton leak / non-shivering thermogenesis).
  # Does NOT mint ATP. Yield falls by take — free energy leaves as warmth (Creator gift path).
  # Usability: AGI models brown-fat style budgets and stress heat dumps without dual ladders.
  # Returns amount uncoupled. Dead/zero/empty gradient → 0. Spark-safe (no energy touch).
  METHOD uncouple n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pmf
    LET p = LAST_N
    LET take = n
    IF take > p THEN
      LET take = p
    END
    LET p = p - take
    SETF THIS pmf p
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    RET take
  END


  # Report phosphagen / phosphocreatine (~P buffer) for science ASSERT boards.
  METHOD phosphagen
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS pcr
    RET LAST_N
  END


  # Charge_pcr: load n ATP into PCr (creatine kinase forward / phosphagen store).
  # Yield conserved (atp→pcr). Does not touch active energy or life spark.
  # Usability: AGI banks rapid ~P buffer from work currency for burst discharge.
  # Returns amount loaded. Dead/zero/empty ATP → 0.
  METHOD charge_pcr n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS pcr
    LET c = LAST_N + take
    SETF THIS pcr c
    RET take
  END


  # Discharge: release n PCr into ATP (creatine kinase reverse / burst work).
  # Yield conserved (pcr→atp). Does not touch active energy or life spark.
  # Usability: AGI fires phosphagen burst into work currency for oxidize/catalyze
  # or mitosis budgets under sudden demand. Dead/zero/empty buffer → 0.
  METHOD discharge n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pcr
    LET c = LAST_N
    LET take = n
    IF take > c THEN
      LET take = c
    END
    LET c = c - take
    SETF THIS pcr c
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    RET take
  END



  # Shiver: burn n active energy as heat (shivering thermogenesis / muscle cold response).
  # Distinct from uncouple (pmf→heat). Yield sheds by take — free energy leaves as warmth.
  # Usability: AGI models cold-stress budgets and non-UCP heat without dual ladders.
  # Returns amount shivered. Dead/zero/empty energy → 0. Does not touch ATP/pmf/pcr.
  METHOD shiver n
    GETF THIS alive
    LET al = LAST_N
    IF al == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 2 THEN
      RET 0
    END
    LET take = n
    LET maxburn = e - 1
    IF take > maxburn THEN
      LET take = maxburn
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
