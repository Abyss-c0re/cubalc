    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS pcr
    LET pc = LAST_N
    IF pc < 0 THEN
      LET pc = 0
    END
    LET pc = pc + take
    IF pc > 1000 THEN
