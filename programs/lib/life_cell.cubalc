  METHOD autophagy n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
