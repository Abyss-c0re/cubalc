  # Usability: AGI models stress-induced mito fragmentation / DRP1 under ASSERT boards.
  # Returns take fragmented; dead/n<1/empty atp → 0.
  METHOD fragment n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    # damaged-tip gradient nick (age held for downstream mitophagy)
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET nick = take
    IF nick > ag THEN
      LET nick = ag
    END
    IF nick > p THEN
      LET nick = p
    END
    IF nick > 0 THEN
      LET p = p - nick
      SETF THIS pmf p
    END
    RET take
  END



  # Tether: ER–mitochondria contact sites (MERCs / Mfn2–IP3R–VDAC–GRP75).
