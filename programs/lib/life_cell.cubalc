    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET r = r - take
    SETF THIS reserve r
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # DOCK: post-refill active-zone vesicle docking / Munc13-RIM-Rab3 tethering.
  # Spend take=min(n,atp,energy) — ATP + bulk metabolic fuel fund Munc13/RIM/Rab3-GTP
  # active-zone docking of VGLUT-filled quanta once v-ATPase packing has charged the
  # vesicle lumen (post-refill dock; not multipotent stream, not GRN fate lock, not
  # growth-cone path sp+, not synaptogenesis thr+ contact, not release pcr+ dump,
  # not EAAT reserve+ clearance, not VGLUT reserve- pack).
  # HEAT += take (each tethering / Rab cycle / Munc13 open-syntaxin step dissipates).
  # ENERGY -= take (docking burns active metabolic pool into AZ scaffold work;
  #   inverse of crest EMT energy+ spark; kin to refill energy- but pmf+ bouton
  #   microdomain poise instead of reserve- packing).
  # PMF rises: pmf = min(1000, pmf + take) — docked AZ couples to local bouton
  # mito ΔΨm / Ca2+ microdomain fusion-competence bank (distinct from cilia
  # ATP-only pmf+ flow-sense, fate pmf- commitment, and mcu/nclx mito Ca shuttle).
  # AGE/reserve/threshold/setpoint/pcr HELD — dock is AZ positioning after refill,
  # not injury age+, not CE bank, not contact thr, not path-length sp, not
  # phosphagen pcr. Ready recomputed from energy vs thr.
  # Fail-closed before mutation if atp or energy cannot fund take>=1.
  # Continuum: ...->project->synapse->release->reuptake->refill->dock.
  # Signature: heat+n energy-n pmf+n; age+reserve+thr+sp+pcr held — dock life-force.
  # Usability: AGI models post-refill active-zone docking under ASSERT.
  # Returns take docked; dead/n<1/empty atp|energy -> 0.
  METHOD dock n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET p = p + take
    IF p > 1000 THEN
      LET p = 1000
    END
    SETF THIS pmf p
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


END
