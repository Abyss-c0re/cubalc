    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    # selectivity tax: ATP preferred, else active energy (keep spark)
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET paid_atp = 0
    IF a >= 1 THEN
      LET a = a - 1
      SETF THIS atp a
      LET paid_atp = 1
    END
    IF paid_atp == 0 THEN
      GETF THIS energy
      LET e0 = LAST_N
      IF e0 < 2 THEN
        RET 0
      END
      LET e0 = e0 - 1
      SETF THIS energy e0
    END
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
