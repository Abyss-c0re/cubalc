      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 1 THEN
      LET sp = 1
    END
    LET sp = sp + take
    IF sp > 1000 THEN
      LET sp = 1000
    END
    SETF THIS setpoint sp
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
