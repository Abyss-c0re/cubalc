  # bank/draw/stow/saturate/respire, set_threshold, drive/prime/poise/ease (lower thr).
  # reserve pays; thr ceiling 1000. Yield sheds by take (reserve in yield).
  # energy/atp/heat/pmf/pcr/age untouched. Recomputes ready.
  # Usability: AGI spends protected glycogen bank to seal mitosis gate without burning ATP, PCr, pmf, heat, or life spark.
  # Returns amount buttressed (threshold rise). Dead/zero/empty reserve/thr already 1000 → 0.
  METHOD buttress n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 1
    END
    LET room = 1000 - th
    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET r = r - take
    SETF THIS reserve r
    LET th = th + take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      GETF THIS energy
      LET e = LAST_N
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END

  # Fission: cytokinesis prep — parent yields half active energy + half reserve as maternal endowment.
  # Endowment code = de*1000 + dr (de = energy/2, dr = reserve/2). Parent keeps remainder + full
  # threshold/setpoint/gen phenotype (epigenetic continuity). Ready cleared after cut.
  # Requires alive, not quiescent, energy >= threshold, and energy >= 2 so both keep a spark path.
  # Distinct from after_div (energy-only half, no return, no reserve split), gift (voluntary energy),
  # birth (slot activate), bank/draw/stow/saturate, spare/buttress/invest (threshold ops), scavenge.
  # Yield conserved across parent remainder + code unpack. Free energy flows to daughter lineage.
  # Returns endowment code; dead/G0/below-threshold/spark-only → 0.
  METHOD fission
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    IF e < th THEN
      RET 0
    END
    IF e < 2 THEN
      RET 0
    END
    LET de = e / 2
    IF de < 1 THEN
      RET 0
    END
    LET e = e - de
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    LET dr = r / 2
    LET r = r - dr
    SETF THIS reserve r
    SETF THIS ready 0
    LET code = de * 1000
    LET code = code + dr
    RET code
  END

  # Inherit: apply maternal fission endowment code to a living daughter cell.
  # de = code/1000 → energy; dr = code - de*1000 → reserve. Recomputes ready vs threshold.
  # Does not alter gen/threshold/setpoint/age (lineage identity stays daughter's).
  # Distinct from feed (nutrient pulse), birth (activate slot), bank/draw, gift, saturate,
  # after_div, fission (parent side). Usability: AGI unpacks one RET from parent fission into child.
  # Returns de+dr absorbed. Dead/zero code → 0.
  METHOD inherit code
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF code < 1 THEN
      RET 0
    END
    LET de = code / 1000
    LET dr = code - de * 1000
    IF de < 0 THEN
      LET de = 0
    END
    IF dr < 0 THEN
      LET dr = 0
    END
    LET got = de + dr
    IF got < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N + de
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + dr
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET got
  END

  # Bud: asymmetric cytokinesis / budding-yeast style minority endowment.
  # Packs ~1/3 active energy + ~1/3 reserve as code=de*1000+dr; mother keeps ~2/3.
  # Gates: alive, not G0, energy >= threshold, energy >= 3 so mother keeps spark
  # and bud carries at least 1 unit. Parent phenotype (thr/setpoint/gen/age) held;
  # ready cleared. Yield conserved mother remainder + code unpack.
  # Distinct from fission (equal half split), after_div (energy-only no code/reserve),
  # gift, birth, bank/draw, spare/buttress/invest, scavenge, inherit (daughter side).
  # Usability: AGI models polar growth / stem self-renewal without equal bipartition.
  # Returns endowment code; dead/G0/sub-threshold/too-lean → 0.
  METHOD bud
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    IF e < th THEN
      RET 0
    END
    IF e < 3 THEN
      RET 0
    END
    LET de = e / 3
    IF de < 1 THEN
      RET 0
    END
    LET e = e - de
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    LET dr = r / 3
    LET r = r - dr
    SETF THIS reserve r
    SETF THIS ready 0
    LET code = de * 1000
    LET code = code + dr
    RET code
  END

  # Spore: bacterial endospore-style survival packing.
  # Parent keeps life spark energy=1, yields de=(energy-1) + full reserve dr as
  # code=de*1000+dr. Reserve cleared on parent; ready cleared. Phenotype thr/gen held.
  # Gates: alive, not G0, energy >= 2 so a transferable de >= 1 exists.
  # Does NOT require mitosis threshold (stress path ≠ division path).
  # Distinct from fission (half/half, needs ready/threshold), bud (~1/3 minority),
  # after_div (energy-only half), die (zeros all), gift, bank/draw, scavenge,
  # inherit (daughter absorb). Free energy conserved in durable spore code.
  # Returns endowment code; dead/G0/spark-only → 0.
  METHOD spore
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 2 THEN
      RET 0
    END
    LET de = e - 1
    IF de < 1 THEN
      RET 0
    END
    SETF THIS energy 1
    GETF THIS reserve
    LET r = LAST_N
    LET dr = r
    SETF THIS reserve 0
    SETF THIS ready 0
    LET code = de * 1000
    LET code = code + dr
    RET code
  END


  # Lyse: altruistic apoptosis / holocrine trophic bequeath to the commons.
  # Packs full active energy + reserve as code=e*1000+r then clears life (die path).
  # No thr/G0 gate — stressed or resting cells may still feed colony cascade.
  # Yield conserved when receiver inherit(code). ATP/pmf/pcr/heat shed (not in code;
  # same packing surface as fission/bud/spore). Distinct from die (discards wealth),
  # gift (keeps alive, energy-only, retains spark), spore/bud/fission (mother lives),
  # after_div, scavenge, spare/invest. Usability: AGI models PCD nutrient recycling.
  # Returns endowment code; dead → 0; empty wealth still dies cleanly → 0.

  # Secrete: merocrine/apocrine trophic vesicle — partial bequeath while living.
  # Packs up to n yield units as code=de*1000+dr. Drain order: active energy down to
  # life spark 1, then reserve. Mother stays alive; ready recomputed vs threshold.
  # No thr/G0 gate (stressed/resting cells may still nourish colony without PCD).
  # Yield conserved when receiver inherit(code). ATP/pmf/pcr/heat untouched.
  # Distinct from gift (energy-only, returns amt not code, no reserve path),
  # lyse (full pack + die), spore (forced spark=1 full pack, stress survival),
  # fission/bud (division ratios, thr gate), die (discards), bank/draw/scavenge.
  # Usability: AGI meters colony trophic flow without killing the donor cell.
  # Returns endowment code; dead/n<1/nothing transferable (e<=1 and r<=0) → 0.
  METHOD secrete n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    IF r < 0 THEN
      LET r = 0
    END
    LET need = n
    LET de = 0
    LET dr = 0
    # energy-first, keep spark >= 1 when e >= 1
    LET can_e = 0
    IF e > 1 THEN
      LET can_e = e - 1
    END
    IF can_e > need THEN
      LET can_e = need
    END
    IF can_e < 0 THEN
      LET can_e = 0
    END
    LET de = can_e
    LET e = e - de
    LET need = need - de
    IF need > 0 THEN
      LET dr = need
      IF dr > r THEN
        LET dr = r
      END
      IF dr < 0 THEN
        LET dr = 0
      END
      LET r = r - dr
      LET need = need - dr
    END
    LET got = de + dr
    IF got < 1 THEN
      RET 0
    END
    SETF THIS energy e
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    LET code = de * 1000
    LET code = code + dr
    RET code
  END

  # Engulf: phagocytosis / endocytic trophic capture of an endowment vesicle or prey pack.
  # Pays 1 active-energy membrane-remodel cost (keep spark: need energy >= 2), then absorbs
  # code=de*1000+dr exactly like inherit (energy+=de, reserve+=dr; ready recompute).
  # No thr/G0 gate on the absorb path after cost — stressed cells may still feed if they can pay.
  # ATP/pmf/pcr/heat untouched. Distinct from inherit (zero-cost maternal dowry),
  # feed (raw nutrient, no code), secrete/gift/lyse/spore (outbound), bank/draw/scavenge.
  # Usability: AGI models predator–prey and vesicle uptake with explicit membrane work.
  # Returns got=de+dr; dead/cost-fail/code<1/empty payload → 0 (no partial cost on fail).
  METHOD engulf code
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF code < 1 THEN
      RET 0
    END
    LET de = code / 1000
    LET dr = code - de * 1000
    IF de < 0 THEN
      LET de = 0
    END
    IF dr < 0 THEN
      LET dr = 0
    END
    LET got = de + dr
    IF got < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    # membrane cost 1; retain life spark
    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    LET e = e + de
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + dr
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET got
  END

  # Digest: lysosomal processing of phagosome/cargo reserve into usable energy.
  # Burns n reserve (cargo) through acid hydrolase path: +n energy, +1 heat byproduct.
  # Pays no extra membrane energy beyond metabolic heat ledger (ATP/pmf/pcr untouched).
  # Requires alive and n>=1 and reserve>=1. Ready recomputed vs threshold (G0 stays unready).
  # Distinct from draw (1:1 reserve→energy, no heat), reclaim (heat→reserve reverse),
  # scavenge (reserve→age discard), engulf (inbound code+membrane cost), feed (raw nutrient),
  # bank (energy→reserve), secrete/lyse/gift (outbound). Completes phagocytosis trophic arc.
  # Usability: AGI models endosome→lysosome yield after engulf without dual IF*P forms.
  # Returns digested amount; dead/n<1/empty reserve → 0.
  METHOD digest n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET r = r - take
    SETF THIS reserve r
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END

  METHOD lyse
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    IF r < 0 THEN
      LET r = 0
    END
    LET code = e * 1000
    LET code = code + r
    LET got = e + r
    SETF THIS alive 0
    SETF THIS energy 0
    SETF THIS ready 0
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS atp 0
    SETF THIS pmf 0
    SETF THIS heat 0
    SETF THIS pcr 0
    IF got < 1 THEN
      RET 0
    END
    RET code
  END


  # Pinocyte: fluid-phase endocytosis — membrane-paid uptake of ambient nutrient as cargo.
  # Pays 1 active-energy membrane-remodel cost (keep spark: need energy >= 2), then
  # deposits n into reserve (glycogen/cargo bank). Ready recomputed vs threshold.
  # No thr/G0 gate after cost — stressed cells may still drink if they can pay membrane.
  # ATP/pmf/pcr/heat untouched. Distinct from feed (direct energy, zero membrane cost),
  # engulf (coded vesicle/prey pack), photosynth/photophos (light to energy/atp),
  # bank (energy to reserve internal), digest (reserve to energy+heat), draw, scavenge.
  # Usability: AGI models macropinocytosis / nutrient sipping before lysosomal digest.
  # Returns n absorbed; dead/n<1/cost-fail -> 0 (no partial cost on fail).
  METHOD pinocyte n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + n
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET n
  END


  # Exocyte: fluid-phase exocytosis — membrane-paid export of reserve cargo to medium.
  # Pays 1 active-energy membrane-remodel cost (keep spark: need energy >= 2), then
  # sheds take=min(n,reserve) from reserve. Ready recomputed vs threshold.
  # No thr/G0 gate after cost — stressed cells may still export if they can pay membrane.
  # ATP/pmf/pcr/heat untouched. Distinct from pinocyte (inbound medium→reserve),
  # secrete (energy-first coded vesicle pack, no separate membrane fee), gift (active
  # energy only), digest (reserve→energy+heat), scavenge (reserve→age), bank/draw,
  # lyse (death pack). Completes pinocyte↔exocyte free-energy cargo loop.
  # Usability: AGI models vesicular export / cargo dumping without dual IF*P forms.
  # Returns take exported; dead/n<1/empty reserve/cost-fail → 0 (no partial cost on fail).
  METHOD exocyte n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    IF r < 1 THEN
      RET 0
    END
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    # membrane cost 1; retain life spark
    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    LET r = r - take
    SETF THIS energy e
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END



  # Autophagy: macroautophagy / self-catabolism — recycle worn biomass (age) into metabolic fuel.
  # Burns take=min(n,age) age units → energy += take, heat += 1 (lysosomal self-digest tax).
  # Internal double-membrane path: no active-energy membrane toll. reserve/atp/pmf/pcr untouched.
  # Ready recomputed vs threshold (quiescent stays unready). Yield conserved into energy+heat.
  # Distinct from repair (energy→shed age), scavenge (reserve→shed age), digest (reserve→energy+heat),
  # respire (reserve→energy no heat), thaw (heat→energy), reclaim, cool, die/lyse.
  # Usability: AGI models starvation survival — cell eats damaged organelles to keep the spark.
  # Returns take recycled; dead/n<1/age<1 → 0.
  METHOD autophagy n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET take = n
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Mitophagy: selective mitochondrial autophagy — QC of worn mito biomass + gradient debris.
  # Burns take=min(n,age) age → energy += take, heat += 1 (lysosomal self-digest tax).
  # Also clears broken proton-gradient debris: pmf -= min(take, pmf) (no heat double-count).
  # Selectivity tax: prefer 1 ATP if atp>=1; else pay 1 active energy (keep spark: need e>=2 before pay).
  # Tax is paid only when take>=1; fail-closed before mutation if tax cannot be paid.
  # reserve/pcr untouched. Ready recomputed vs threshold (quiescent stays unready).
  # Distinct from autophagy (bulk, no tax, no pmf drain), repair (energy→shed age), scavenge
  # (reserve→age), uncouple (pmf→heat only), digest (reserve→energy), respire.
  # Usability: AGI models PINK1/Parkin-style mito QC — clear damaged powerhouses under stress.
  # Returns take recycled; dead/n<1/age<1/tax-fail → 0.
  METHOD mitophagy n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET take = n
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    # selectivity tax: ATP preferred, else active energy (keep spark)
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET paid_atp = 0
    IF a >= 1 THEN
      LET a = a - 1
      SETF THIS atp a
      LET paid_atp = 1
    END
    IF paid_atp == 0 THEN
      GETF THIS energy
      LET e0 = LAST_N
      IF e0 < 2 THEN
        RET 0
      END
      LET e0 = e0 - 1
      SETF THIS energy e0
    END
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET drain = take
    IF drain > p THEN
      LET drain = p
    END
    LET p = p - drain
    SETF THIS pmf p
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END




  # Biogenesis: mitochondrial biogenesis (PGC-1α / NRF1-style OXPHOS rebuild).
  # Invest take=min(n,atp,reserve) ATP + equal reserve (membrane/protein mass)
  # → mint take nascent pmf (fresh cristae seeds) + heat += 1 (biosynthetic tax).
  # Fail-closed before mutation if ATP or reserve cannot fund take>=1.
  # energy/age/pcr untouched. Ready unchanged (pmf is not mitosis currency directly).
  # Distinct from reverse (ATP→pmf, no reserve/heat), pump (energy→pmf), synthase (pmf→ATP),
  # anabolize (ATP→reserve), mitophagy (age→energy + drain pmf), photosynth, uncouple.
  # Completes mitophagy↔biogenesis free-energy QC loop — clear debris, then rebuild fleet.
  # Usability: AGI models exercise/cold-induced mito expansion under ASSERT science boards.
  # Returns take built; dead/n<1/empty atp or reserve → 0.
  METHOD biogenesis n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    LET r = r - take
    SETF THIS atp a
    SETF THIS reserve r
    GETF THIS pmf
    LET p = LAST_N + take
    SETF THIS pmf p
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    RET take
  END



  # Fusion: mitochondrial fusion (MFN1/2 + OPA1 GTPase networking).
  # Pay take=min(n,atp,age) ATP → shed take age (matrix complementation QC) + heat += 1.
  # pmf/reserve/energy/pcr untouched — content mixing holds the gradient, repairs phenotype.
  # Fail-closed before mutation if ATP cannot fund take>=1 or age<1.
  # Distinct from mitophagy (drains pmf + age→energy), biogenesis (ATP+reserve→pmf),
  # repair (energy→age), renew (pmf→age), autophagy (bulk age→energy, no ATP tax), scavenge.
  # Completes QC triad: mitophagy clear → biogenesis rebuild → fusion network complement.
  # Usability: AGI models stress-induced mito networking / complementation under ASSERT boards.
  # Returns take fused; dead/n<1/empty atp or age → 0.
  METHOD fusion n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    RET take
  END

  # Fragment: mitochondrial fission (DRP1/FIS1 dynamin-related GTPase).
