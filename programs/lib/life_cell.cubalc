  # Spend 1 ATP to arm ready when energy is within 2 of threshold (work gift).
  # Returns 1 if armed (or already ready), 0 otherwise.
  METHOD catalyze
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS ready
    IF LAST_N == 1 THEN
      RET 1
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    GETF THIS energy
    LET e = LAST_N
    # near threshold: energy + 2 >= th
    LET need = th - 2
    IF need < 1 THEN
      LET need = 1
    END
    IF e < need THEN
      RET 0
    END
    LET a = a - 1
    SETF THIS atp a
    SETF THIS ready 1
    RET 1
  END

