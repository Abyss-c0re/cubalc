  # Pay take=min(n,energy) — pure binding/steric work; ATP/PCR/RESERVE HELD.
  # AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n energy-n; age+atp+pcr+reserve+pmf+sp+thr held — if1 life-force.
  # Usability: AGI models post-if2 IF1 A-site gate under ASSERT boards. Cube is SoT.
  # Free energy must flow. Returns take; else 0.
  METHOD if1 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
