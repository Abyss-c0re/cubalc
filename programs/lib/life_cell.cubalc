      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 1
    END
    LET thr = thr - take
    IF thr < 1 THEN
      LET thr = 1
    END
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END




  # RESTIT: epithelial / barrier restitution after RESOLVE (SPM quiet).
