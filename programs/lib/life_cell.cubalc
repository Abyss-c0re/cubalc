    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET n
  END


  # Exocyte: fluid-phase exocytosis — membrane-paid export of reserve cargo to medium.
