    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + n
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
