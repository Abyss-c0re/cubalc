  # HEAT += take (each cytoskeletal / trafficking cycle dissipates as heat).
  # AGE sheds: age = max(0, age - take) — work-coupled debridement of residual
  # injury age as tissue returns toward integrity (inverse of bleb age+ injury load).
  # ENERGY/pmf/reserve/threshold/pcr HELD — restitution rebuilds barrier without
  # burning life spark, dumping Δψ, drawing glycogen, or re-raising mitotic bar
  # (resolve already eased thr; restit keeps that quiet set-point).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from resolve (ATP→heat+n thr-n, age HELD pro-resolve ease),
  # effer (ATP→heat+n energy+n thr held trophic cup), bleb (age+n reserve+n),
  # cad (thr+n DNA ladder), refold (ATP→age- no heat), anneal (heat→age-),
  # repair (energy→age-), mend (PCr→age-), renew (pmf→age-), scavenge (reserve→age-),
  # prime (ATP thr- no heat), ease (heat thr-). Continuum: ...→cad→bleb→effer→resolve→restit.
  # Signature: heat+n age-n; energy+reserve+pmf+thr held — barrier rebuild, not injury/trophic/ease.
  # Usability: AGI models post-resolution epithelial restitution under ASSERT boards.
  # Returns take restituted; dead/n<1/empty atp → 0.
  METHOD restit n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET shed = take
    IF shed > ag THEN
      LET shed = ag
    END
    LET ag = ag - shed
    SETF THIS age ag
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END




  # SEAL: tight-junction / barrier competence lock after RESTIT (epithelial rebuild).
  # Spend take=min(n,atp) ATP (claudin/occludin/ZO trafficking, strand polymerization,
  # tricellular junction sealing, contact-inhibition kinase work).
  # HEAT += take (each trafficking / kinase cycle dissipates as heat).
  # THRESHOLD rises: thr = min(1000, thr + take) — sealed barrier restores contact
  # inhibition / mitotic competence bar (inverse of resolve thr- pro-resolve ease;
  # restit held thr quiet set-point; seal re-arms gate without injury age).
  # AGE/energy/pmf/reserve/pcr HELD — seal is junction lock, not injury (bleb age+),
  # not demolition (casp3 energy drain), not cargo bank (bleb reserve+), not thr-ease
  # (resolve), not age-shed rebuild (restit).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from restit (ATP→heat+n age-n thr held barrier rebuild),
  # resolve (ATP→heat+n thr-n age held), fortify (ATP→thr+ no heat),
  # cad (ATP→heat+n age+n thr+n DNA checkpoint), harden (heat→thr+),
  # brace/invest/buttress (other currencies→thr+). Continuum:
  # ...→cad→bleb→effer→resolve→restit→seal.
  # Signature: heat+n thr+n; age+energy+reserve+pmf held — TJ seal competence.
  # Usability: AGI models post-restitution barrier seal / contact inhibition under ASSERT boards.
  # Returns take sealed; dead/n<1/empty atp → 0.
  METHOD seal n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 1
    END
    LET thr = thr + take
    IF thr > 1000 THEN
      LET thr = 1000
    END
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # POLAR: apical-basal polarity competence after SEAL (TJ lock).
