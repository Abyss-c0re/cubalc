  # Boost: dump n PCr straight into active energy (phosphagen mitosis shortcut).
  # Bypasses ATP intermediate — creatine kinase + rapid energy arm for division.
  # Yield conserved (pcr→energy). Does not touch ATP/pmf/heat. Arms ready if past thr.
  # Usability: AGI fires stored ~P buffer into mitosis budget under sudden demand.
  # Returns amount boosted. Dead/zero/empty buffer → 0. Keeps life spark rules via ready.
  METHOD boost n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pcr
    LET c = LAST_N
    LET take = n
