    SETF THIS age ag
    GETF THIS pcr
    LET pc = LAST_N
    IF pc < 0 THEN
      LET pc = 0
    END
    LET pc = pc + take
    IF pc > 1000 THEN
      LET pc = 1000
    END
    SETF THIS pcr pc
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # EXPORT: post-degrade lysosomal amino-acid export / LAAT-1+SLC38A9 efflux to cytosol.
  # Spend take=min(n,atp,energy,pcr) — ATP + metabolic fuel + phosphagen/AA salvage
  # bank fund lumen→cytosol export of oligopeptide/amino-acid products once DEGRADE
  # has cleaved lumenal substrate under armed cathepsins (post-degrade export; not
  # multipotent stream, not GRN fate lock, not growth-cone path sp+, not
  # synaptogenesis thr+ contact, not release pcr+ dump, not EAAT reserve+ clearance,
  # not VGLUT reserve- pack, not dock pmf+ AZ tethering, not arm pmf- zipper, not
  # clamp sp+ hold, not trigger sp- unclamp, not pore thr- barrier drop, not mix
  # pcr- dilution, not collapse reserve- flatten, not retrieve reserve+ CME bank,
  # not acidify pmf+ EE lumen pump, not mature pmf- thr+ Rab5->Rab7 conversion,
  # not recruit reserve+ M6PR cargo fill, not activate reserve- thr- zymogen arming,
  # not degrade age- pcr+ processive cut, not autophagy age- energy+ self-catabolism,
  # not digest reserve- energy+ phagosome burn, not discharge pcr- bare phosphagen
  # spend without reserve+ cytosolic AA bank).
  # HEAT += take (each LAAT-1/PQLC2 antiport / SLC38A9 AA-sensing efflux / membrane
  #   translocation step dissipates as export work).
  # ENERGY -= take (export burns active metabolic pool into transporter-cycle work;
  #   kin to degrade energy- but pcr- reserve+ cytosolic delivery instead of age-
  #   pcr+ lumenal cleavage).
  # ATP -= take (ATP-binding cassette adjuncts / proton-coupled secondary active
  #   driving of lysosomal AA exporters).
  # PCR falls: pcr = max(0, pcr - take) — lysosomal/cytosolic phosphagen-linked AA
  #   salvage pool raised by degrade is exported out of the lumenal holding state
  #   (inverse of degrade pcr+; kin to mix/discharge pcr- but reserve+ anabolic
  #   bank credit instead of content dilution or bare phosphagen spend).
  # RESERVE rises: reserve = min(1000, reserve + take) — exported amino acids join
  #   the cytosolic cargo/anabolic bank for later anabolize/respire (inverse of
  #   activate/collapse reserve-; kin to retrieve/recruit reserve+ but pcr- source
  #   from proteolysis products instead of membrane CME or M6PR zymogen fill).
  # AGE/THRESHOLD/PMF/SETPOINT HELD — export is AA efflux after degrade, not injury
  #   age+, not hydrolase-latency thr, not EE proton bank, not clamp-tension sp.
  # Ready recomputed from post-burn energy vs threshold.
  # Continuum: ...->mature->recruit->activate->degrade->export->translate.
  # Signature: heat+n energy-n pcr-n reserve+n; age+thr+pmf+sp held — export life-force.
  # Usability: AGI models post-degrade lysosomal AA export under ASSERT.
  # Returns take exported; dead/n<1/empty atp|energy|pcr -> 0.
  METHOD export n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS pcr
    LET pc = LAST_N
    IF pc < 0 THEN
      LET pc = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > pc THEN
      LET take = pc
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET pc = pc - take
    IF pc < 0 THEN
      LET pc = 0
    END
    SETF THIS pcr pc
    GETF THIS reserve
    LET rv = LAST_N
    IF rv < 0 THEN
      LET rv = 0
    END
    LET rv = rv + take
    IF rv > 1000 THEN
      LET rv = 1000
    END
    SETF THIS reserve rv
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # TRANSLATE: post-export cytosolic ribosome polypeptide synthesis / mTOR-Rag AA sensing.
  # Spend take=min(n,atp,energy,reserve) — ATP + metabolic fuel + exported cytosolic AA
  # bank fund elongation (eEF1A/eEF2 GTPases, aminoacyl-tRNA charging) once EXPORT has
  # raised reserve anabolic bank from lysosomal LAAT-1+SLC38A9 efflux (post-export
  # translate; not multipotent stream, not GRN fate lock, not growth-cone path sp+, not
  # synaptogenesis thr+ contact, not release quantal thr-, not reuptake clearance
  # energy+, not refill VGLUT pack, not dock HOPS tethering, not arm NSF priming, not
  # clamp complexin clamp, not trigger Ca fusion, not pore SNARE zipper, not mix content
  # dump, not collapse coat uncoat, not retrieve CME membrane bank, not acidify EE
  # proton pump, not mature Rab5->Rab7 identity, not recruit M6PR hydrolase cargo, not
  # activate cathepsin arming thr-, not degrade substrate cut age- pcr+, not export
  # lumen->cytosol pcr- reserve+).
  # HEAT += take (each peptide-bond formation / translocation / proofreading step
  #   dissipates as ribosomal elongation work).
  # ENERGY -= take (translate burns active metabolic pool into polypeptide chain growth;
  #   kin to export energy- but spends reserve AA bank into age- biomass instead of
  #   raising reserve from pcr salvage).
  # ATP -= take (aminoacyl-tRNA synthetases / eEF2 translocation / initiation eIF2).
  # RESERVE falls: reserve = max(0, reserve - take) — cytosolic free AA / oligopeptide
  #   bank spent into nascent polypeptide (distinct from export reserve+ anabolic fill,
  #   recruit reserve+ hydrolase zymogen, degrade pcr+ AA-salvage, and photosynth
  #   light->reserve).
  # AGE falls: age = max(0, age - take) — successful translation rebuilds worn proteome
  #   / replaces damaged biomass (anabolic rejuvenation; distinct from degrade age-
  #   substrate cut that feeds pcr, autophagy age- self-catabolism, and mitophagy QC).
  # PCR/THRESHOLD/PMF/SETPOINT HELD — translate is post-export ribosome work after AA
  #   export filled cytosol, not phosphagen pcr bank, not hydrolase-latency thr, not EE
  #   proton bank, not clamp-tension sp.
  # Ready recomputed from post-burn energy vs held threshold.
  # Continuum: ...->recruit->activate->degrade->export->translate.
  # Signature: heat+n energy-n reserve-n age-n; thr+pmf+sp+pcr held — translate life-force.
  # Usability: AGI models post-export cytosolic ribosome polypeptide synthesis under ASSERT.
  # Returns take translated; dead/n<1/empty atp|energy|reserve -> 0.
  METHOD translate n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS reserve
    LET rv = LAST_N
    IF rv < 0 THEN
      LET rv = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > rv THEN
      LET take = rv
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET rv = rv - take
    IF rv < 0 THEN
      LET rv = 0
    END
    SETF THIS reserve rv
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET ag = ag - take
    IF ag < 0 THEN
      LET ag = 0
    END
    SETF THIS age ag
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # TRANSLOC: post-translate SRP–Sec61 co-translational ER translocation / nascent-chain targeting.
  # Spend take=min(n,atp,energy) — ATP/GTP + metabolic fuel fund SRP GTPase cycle + Sec61
  # channel gating once TRANSLATE has elongated the nascent polypeptide (post-translate
  # transloc; not multipotent stream, not GRN fate lock, not growth-cone path sp+, not
