  #   proteome rebuild, export reserve+ AA bank, and dock pmf+ AZ tether).
  # AGE/RESERVE/THRESHOLD/PMF/PCR HELD — transloc is post-translate channel work after
  #   ribosome filled nascent chain, not anabolic age repair, not free-AA reserve spend,
  #   not hydrolase-latency thr, not EE proton bank, not phosphagen pcr bank.
  # Ready recomputed from energy vs threshold after energy spend (quiescent forces 0).
  # Returns take. Dead/zero/empty ATP|energy → 0.
  METHOD transloc n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 0 THEN
      LET sp = 0
    END
    LET sp = sp + take
    IF sp > 1000 THEN
      LET sp = 1000
    END
    SETF THIS setpoint sp
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # CLEAVE: post-transloc signal peptidase (SPC) cleavage / N-terminal signal-peptide scission.
