  # Signature: heat+n thr+n; age+energy+reserve+pmf held — TJ seal competence.
  # Usability: AGI models post-restitution barrier seal / contact inhibition under ASSERT boards.
  # Returns take sealed; dead/n<1/empty atp → 0.
  METHOD seal n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 1
    END
    LET thr = thr + take
    IF thr > 1000 THEN
      LET thr = 1000
    END
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



END
