    LET a = a - take
    SETF THIS atp a
    GETF THIS pcr
    LET c = LAST_N + take
    SETF THIS pcr c
    RET take
  END


  # Discharge: release n PCr into ATP (creatine kinase reverse / burst work).
  # Yield conserved (pcr→atp). Does not touch active energy or life spark.
  # Usability: AGI fires phosphagen burst into work currency for oxidize/catalyze
  # or mitosis budgets under sudden demand. Dead/zero/empty buffer → 0.
  METHOD discharge n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pcr
    LET c = LAST_N
    LET take = n
    IF take > c THEN
      LET take = c
    END
    LET c = c - take
    SETF THIS pcr c
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    RET take
  END



  # Shiver: burn n active energy as heat (shivering thermogenesis / muscle cold response).
  # Distinct from uncouple (pmf→heat). Yield sheds by take — free energy leaves as warmth.
  # Usability: AGI models cold-stress budgets and non-UCP heat without dual ladders.
  # Returns amount shivered. Dead/zero/empty energy → 0. Does not touch ATP/pmf/pcr.
  METHOD shiver n
    GETF THIS alive
    LET al = LAST_N
    IF al == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 2 THEN
      RET 0
    END
    LET take = n
    LET maxburn = e - 1
    IF take > maxburn THEN
      LET take = maxburn
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    LET rd = 0
    GETF THIS threshold
    LET thr = LAST_N
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      IF e >= thr THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Report cumulative thermogenesis heat ledger for science ASSERT boards.
  METHOD warmth
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS heat
    RET LAST_N
  END


  # Futile: burn n ATP as heat (futile cycling / non-work ATPase thermogenesis).
