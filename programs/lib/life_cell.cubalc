# life_cell.cubalc — COP cell unit for life_engine (biology: growth + mitosis)
# INCLUDE life_cell
#
# Fields:
#   alive  0|1
#   energy metabolic energy (integer)
#   age    ticks lived
#   gen    generation from seed (0 = founder)
#   ready  1 when energy >= threshold → candidate for division
#   kind   0=prokaryote-like simple split
#
# Methods:
#   init alive energy gen
#   tick           grow / age / mark ready
#   birth energy gen   activate a free slot as daughter
#   after_div      parent halves energy after successful mitosis
#   die            apoptosis / resource death

CLASS Cell
  FIELD alive 0
  FIELD energy 0
  FIELD age 0
  FIELD gen 0
  FIELD ready 0
  FIELD kind 0
  ROLE body

  METHOD init a e g
    SETF THIS alive a
    SETF THIS energy e
    SETF THIS age 0
    SETF THIS gen g
    SETF THIS ready 0
    SETF THIS kind 0
  END

  METHOD tick
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    # age
    GETF THIS age
    LET ag = LAST_N + 1
    SETF THIS age ag
    # absorb nutrient + metabolism cost
    GETF THIS energy
    LET e = LAST_N + 2
    # basal cost
    LET e = e - 1
    IF e < 0 THEN
      LET e = 0
    END
    SETF THIS energy e
    # senescence / starvation death
    IF e == 0 THEN
      SETF THIS alive 0
      SETF THIS ready 0
      RET 0
    END
    IF ag > 40 THEN
      SETF THIS alive 0
      SETF THIS ready 0
      RET 0
    END
    # mitosis threshold
    LET rd = 0
    IF e >= 10 THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET e
  END

  METHOD birth e g
    SETF THIS alive 1
    SETF THIS energy e
    SETF THIS age 0
    SETF THIS gen g
    SETF THIS ready 0
    RET 1
  END

  METHOD after_div
    GETF THIS energy
    LET e = LAST_N / 2
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    SETF THIS ready 0
    RET e
  END

  METHOD die
    SETF THIS alive 0
    SETF THIS energy 0
    SETF THIS ready 0
    RET 0
  END
END
