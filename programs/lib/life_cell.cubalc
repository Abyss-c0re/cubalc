    LET a = a - take
    SETF THIS atp a
    LET r = r - take
    SETF THIS reserve r
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
