    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    RET take
  END

  # Temper: homeostatic heat setpoint — radiate excess warmth above target t.
  # If heat > t, cool (heat - t); if heat <= t, no-op (never creates heat).
  # Yield sheds only when excess cleared. Does not touch energy/atp/pmf/pcr/ready.
  # Usability: AGI holds thermal ceiling after shiver/futile/uncouple budgets.
  # Returns final heat. Dead → 0. t < 0 treated as 0.
  METHOD temper t
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    LET tgt = t
    IF tgt < 0 THEN
      LET tgt = 0
    END
    GETF THIS heat
    LET h = LAST_N
    IF h <= tgt THEN
      RET h
    END
    LET take = h - tgt
    LET h = h - take
    SETF THIS heat h
    RET h
  END




  # Thaw: recycle n heat back into active energy (endothermic / waste-heat recovery).
  # Inverse of shiver (energy→heat). Distinct from cool (heat leaves) and temper (setpoint shed).
  # Yield excludes heat; thaw restores yield (heat→energy). Does not touch atp/pmf/pcr. Recomputes ready vs threshold.
  # Usability: AGI recovers thermogenesis ledger into mitosis budget after cold-stress.
  # Returns amount thawed. Dead/zero/empty heat → 0.
  METHOD thaw n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    LET rd = 0
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 10
    END
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      IF e >= thr THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Reclaim: salvage n heat into glycogen reserve (waste-heat → stores).
  # Distinct from thaw (heat→energy, arms ready) and cool (heat leaves system).
  # Yield restored into protected bank. Does not touch energy/atp/pmf/pcr/ready.
  # Usability: AGI banks thermogenesis ledger as reserve without flooding mitosis.
  # Returns amount reclaimed. Dead/zero/empty heat → 0.
  METHOD reclaim n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
