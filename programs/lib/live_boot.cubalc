# INCLUDE live_boot — agent preamble + full OOP catalog + live instances one-shot
# Usability: agent_boot + live_session without two INCLUDEs or double agent_boot.
#
#   DEFAULT NEED_CLASSES = ""
#   DEFAULT NEED_METHODS = ""
#   DEFAULT NEED_FIELDS = ""
#   DEFAULT NEED_OBJS = ""
#   INCLUDE live_boot
# Soft miss: set CLASS/METHOD/FIELD/OBJ_GUARD_SOFT = 1 before INCLUDE
#
# Scaffold: cubalc init demo --live
# Twin of oop_boot / obj_boot / host_boot for combined live OOP plane.
# HOLD_FLASH not required (runtime default 1 · same as agent_boot).

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
DEFAULT NEED_FIELDS = ""
DEFAULT NEED_FIELD_ANY = ""
DEFAULT FIELD_GUARD_SOFT = 0
DEFAULT NEED_OBJS = ""
DEFAULT NEED_OBJ_ANY = ""
DEFAULT OBJ_GUARD_SOFT = 0
INCLUDE agent_boot
INCLUDE live_session
