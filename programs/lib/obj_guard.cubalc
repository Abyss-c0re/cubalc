# INCLUDE obj_guard - fail-fast live OOP instance catalog (ALL + optional ANY)
# Usability: agent live-object gate via native multi forms (no N× HASOBJ soup).
#
#   DEFAULT NEED_OBJS = "t1\norder1"
#   DEFAULT NEED_OBJ_ANY = "slot_a\nslot_b"
#   DEFAULT OBJ_GUARD_SOFT = 0
#   INCLUDE obj_guard
#
# Spec: each entry is a live instance name (NEW Class name). Soft dual leaves
# OBJMISS / OBJHAVE bags. Twin of fn_guard for the live object plane.
# Hard ALL: NEEDOBJS · Hard ANY: NEEDOBJANY · Soft: HASOBJS / HASOBJANY.
# Multi duals still available directly. (REQUIRE OBJ avoided — IF/END nesting.)

DEFAULT NEED_OBJS = ""
DEFAULT NEED_OBJ_ANY = ""
DEFAULT OBJ_GUARD_SOFT = 0

SYS EMPTY NEED_OBJS
IF LAST_N == 1
  LET OBJ_GUARD_ALL_OK = 1
  LET OBJMISS = ""
  LET OBJHAVE = ""
  LET OBJMISS_N = 0
  LET OBJHAVE_N = 0
ELSE
  IF OBJ_GUARD_SOFT
    HASOBJS NEED_OBJS
    LET OBJ_GUARD_ALL_OK = LAST_N
    LET OBJHAVE_N = HASOBJS_N
    IF OBJMISS_N == 0
      LET OBJHAVE = NEED_OBJS
    END
  ELSE
    NEEDOBJS NEED_OBJS
    LET OBJ_GUARD_ALL_OK = 1
    LET OBJMISS = ""
    LET OBJMISS_N = 0
    LET OBJHAVE = NEED_OBJS
    LET OBJHAVE_N = NEEDOBJS_N
  END
END

SYS EMPTY NEED_OBJ_ANY
IF LAST_N == 1
  LET OBJ_GUARD_ANY_OK = 1
ELSE
  IF OBJ_GUARD_SOFT
    HASOBJANY NEED_OBJ_ANY
    LET OBJ_GUARD_ANY_OK = LAST_N
    # OBJHAVE / OBJMISS / OBJHAVE_N / OBJMISS_N from HASOBJANY
  ELSE
    NEEDOBJANY NEED_OBJ_ANY
    LET OBJ_GUARD_ANY_OK = 1
    LET OBJHAVE_N = NEEDOBJANY_N
  END
END

IF OBJ_GUARD_ALL_OK
  IF OBJ_GUARD_ANY_OK
    LET OBJ_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET OBJ_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET OBJ_GUARD_OK = 0
  LET OK = 0
END
