# INCLUDE tool_session — full CLI product tool one-shot
# Usability: cli_boot + cli_guard + arg_guard without triple INCLUDE / double agent_boot.
#
#   DEFAULT USAGE = "mytool --out PATH [--json|--yaml] files…"
#   DEFAULT PROG_VERSION = "1.0.0"
#   DEFAULT NEED_FLAGS = "out"
#   DEFAULT NEED_FLAG_ANY = "json\nyaml"
#   DEFAULT NEED_REST_N = 1
#   DEFAULT NEED_ARGS = ""              # optional raw CUBALC_ARGn all-of
#   DEFAULT NEED_ARG_ANY = ""           # optional any-of indices/env names
#   DEFAULT CLI_GUARD_SOFT = 0
#   DEFAULT ARG_GUARD_SOFT = 0
#   INCLUDE tool_session
#   # HELPFLAG/VERSIONFLAG auto · CLIINFO · flag+arg contracts applied
#
# Soft: set CLI_GUARD_SOFT / ARG_GUARD_SOFT = 1 before INCLUDE.
# Scaffold: cubalc init demo --full-cli
# Completes cli_session (flags only) with positionals via arg_guard.
# HOLD_FLASH not required (runtime default 1).

INCLUDE cli_boot
INCLUDE cli_guard
INCLUDE arg_guard

# combined soft status (hard paths already failed fatally)
IF CLI_GUARD_OK
  IF ARG_GUARD_OK
    LET TOOL_SESSION_OK = 1
    LET OK = 1
  ELSE
    LET TOOL_SESSION_OK = 0
    LET OK = 0
  END
ELSE
  LET TOOL_SESSION_OK = 0
  LET OK = 0
END
