// INCLUDE "lib/hold_seed.cubalc"  (from a programs/* path) or absolute path
//
// HOLD_FLASH is a **device/firmware + mesh-join** safeguard only.
// Ordinary agent programs should NOT require this INCLUDE.
// Language PLUG (virtual cubes) never needs HOLD_FLASH.
//
// Use this seed only when initiating a *new device* or mesh plug-in
// on a host that can change firmware / physical connections.
//
//   HOLD_FLASH 1  — sticky device/mesh hold ack (runtime default is already 1)
//   BUDGET / SHARE — optional mesh session knobs

HOLD_FLASH 1
BUDGET 40
SHARE state_matrix_only
