# INCLUDE service_session — product+host + live OOP one-shot
# Usability: full_session (product CLI+host) + live_session (oop+obj)
# without multi INCLUDE for real fleet services that also NEW/SEND/GETF.
#
#   DEFAULT USAGE = "mysvc --out PATH files…"
#   DEFAULT PROG_VERSION = "1.0.0"
#   DEFAULT NEED_FLAGS = "out"
#   DEFAULT NEED_FLAG_ANY = ""
#   DEFAULT NEED_REST_N = 0
#   DEFAULT NEED_ARGS = ""
#   DEFAULT NEED_ARG_ANY = ""
#   DEFAULT NEED_ENVS = "HOME"
#   DEFAULT NEED_ENV_ANY = ""
#   DEFAULT NEED_TIME = 200
#   DEFAULT NEED_PATHS = ""
#   DEFAULT NEED_PATH_ANY = ""
#   DEFAULT NEED_READ_PATHS = ""
#   DEFAULT NEED_WRITE_PATHS = ""
#   DEFAULT NEED_BINS = ""
#   DEFAULT NEED_BIN_ANY = ""
#   DEFAULT NEED_LIBS = ""
#   DEFAULT NEED_LIB_ANY = ""
#   DEFAULT NEED_CLASSES = ""
#   DEFAULT NEED_CLASS_ANY = ""
#   DEFAULT NEED_METHODS = ""
#   DEFAULT NEED_METHOD_ANY = ""
#   DEFAULT NEED_FIELDS = ""
#   DEFAULT NEED_FIELD_ANY = ""
#   DEFAULT NEED_OBJS = ""
#   DEFAULT NEED_OBJ_ANY = ""
#   DEFAULT CLI_GUARD_SOFT = 0
#   DEFAULT ARG_GUARD_SOFT = 0
#   DEFAULT ENV_GUARD_SOFT = 0
#   DEFAULT TIME_GUARD_SOFT = 0
#   DEFAULT PATH_GUARD_SOFT = 0
#   DEFAULT RW_GUARD_SOFT = 0
#   DEFAULT BIN_GUARD_SOFT = 0
#   DEFAULT LIB_GUARD_SOFT = 0
#   DEFAULT CLASS_GUARD_SOFT = 0
#   DEFAULT METHOD_GUARD_SOFT = 0
#   DEFAULT FIELD_GUARD_SOFT = 0
#   DEFAULT OBJ_GUARD_SOFT = 0
#   INCLUDE service_session
#   # SERVICE_SESSION_OK combines FULL_SESSION_OK + LIVE_SESSION_OK
#
# Soft: set *_GUARD_SOFT = 1 before INCLUDE.
# Scaffold: cubalc init demo --service
# Twin of full_session (product+host only) / live_session (OOP only).
# HOLD_FLASH not required (runtime default 1).
# Note: does not INCLUDE agent_boot — use service_boot for preamble + contract.

INCLUDE full_session
INCLUDE live_session

# combined soft status (hard paths already HARDFAIL hard path; soft *_GUARD_SOFT=1)
IF FULL_SESSION_OK
  IF LIVE_SESSION_OK
    LET SERVICE_SESSION_OK = 1
    LET OK = 1
  ELSE
    LET SERVICE_SESSION_OK = 0
    LET OK = 0
  END
ELSE
  LET SERVICE_SESSION_OK = 0
  LET OK = 0
END
