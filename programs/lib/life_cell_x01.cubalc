# life_cell_x01.cubalc — EXTEND Cell pack 1

EXTEND CLASS Cell
  METHOD futile n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    RET take
  END



  # Boost: dump n PCr straight into active energy (phosphagen mitosis shortcut).
  # Bypasses ATP intermediate — creatine kinase + rapid energy arm for division.
  # Yield conserved (pcr→energy). Does not touch ATP/pmf/heat. Arms ready if past thr.
  # Usability: AGI fires stored ~P buffer into mitosis budget under sudden demand.
  # Returns amount boosted. Dead/zero/empty buffer → 0. Keeps life spark rules via ready.
  METHOD boost n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pcr
    LET c = LAST_N
    LET take = n
    IF take > c THEN
      LET take = c
    END
    IF take < 1 THEN
      RET 0
    END
    LET c = c - take
    SETF THIS pcr c
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    LET rd = 0
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 10
    END
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      IF e >= thr THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Load: dump n active energy straight into PCr (phosphagen load shortcut).
  # Bypasses ATP intermediate — inverse of boost; creatine kinase reverse arm.
  # Yield conserved (energy→pcr). Does not touch ATP/pmf/heat. Disarms ready if below thr.
  # Usability: AGI banks surplus mitosis budget into ~P buffer without dual ladders.
  # Returns amount loaded. Dead/zero/empty energy→0. Keeps life spark (never drains last 1).
  METHOD load n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    # keep life spark — never bank the last unit of active energy
    LET max_take = e - 1
    IF max_take < 1 THEN
      RET 0
    END
    LET take = n
    IF take > max_take THEN
      LET take = max_take
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS pcr
    LET c = LAST_N + take
    SETF THIS pcr c
    LET rd = 0
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 10
    END
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      IF e >= thr THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Cool: radiate n heat to environment (radiative / evaporative cooling clearance).
  # Inverse of shiver/futile/uncouple heat creation — clears thermogenesis ledger.
  # Yield sheds by take (heat leaves system). Does not touch energy/atp/pmf/pcr/ready.
  # Usability: AGI sheds surplus warmth after cold-stress budgets without dual ladders.
  # Returns amount cooled. Dead/zero/empty heat → 0.
  METHOD cool n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    RET take
  END

  # Temper: homeostatic heat setpoint — radiate excess warmth above target t.
  # If heat > t, cool (heat - t); if heat <= t, no-op (never creates heat).
  # Yield sheds only when excess cleared. Does not touch energy/atp/pmf/pcr/ready.
  # Usability: AGI holds thermal ceiling after shiver/futile/uncouple budgets.
  # Returns final heat. Dead → 0. t < 0 treated as 0.
  METHOD temper t
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    LET tgt = t
    IF tgt < 0 THEN
      LET tgt = 0
    END
    GETF THIS heat
    LET h = LAST_N
    IF h <= tgt THEN
      RET h
    END
    LET take = h - tgt
    LET h = h - take
    SETF THIS heat h
    RET h
  END




  # Thaw: recycle n heat back into active energy (endothermic / waste-heat recovery).
  # Inverse of shiver (energy→heat). Distinct from cool (heat leaves) and temper (setpoint shed).
  # Yield excludes heat; thaw restores yield (heat→energy). Does not touch atp/pmf/pcr. Recomputes ready vs threshold.
  # Usability: AGI recovers thermogenesis ledger into mitosis budget after cold-stress.
  # Returns amount thawed. Dead/zero/empty heat → 0.
  METHOD thaw n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    LET rd = 0
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 10
    END
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      IF e >= thr THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Reclaim: salvage n heat into glycogen reserve (waste-heat → stores).
  # Distinct from thaw (heat→energy, arms ready) and cool (heat leaves system).
  # Yield restored into protected bank. Does not touch energy/atp/pmf/pcr/ready.
  # Usability: AGI banks thermogenesis ledger as reserve without flooding mitosis.
  # Returns amount reclaimed. Dead/zero/empty heat → 0.
  METHOD reclaim n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    GETF THIS reserve
    LET r = LAST_N + take
    SETF THIS reserve r
    RET take
  END

  # Capture: salvage n heat into ATP work currency (waste-heat → charged work).
  # Distinct from thaw (heat→energy, arms ready), reclaim (heat→reserve), cool (heat leaves).
  # Yield restored into ATP bank. Does not touch energy/reserve/pmf/pcr/ready.
  # Usability: AGI banks thermogenesis ledger as work currency without flooding mitosis.
  # Returns amount captured. Dead/zero/empty heat → 0.
  METHOD capture n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    GETF THIS atp
    LET a = LAST_N + take
    SETF THIS atp a
    RET take
  END


  # Harness: salvage n heat into pmf proton-motive force (waste-heat → chemiosmotic gradient).
  # Distinct from thaw (heat→energy), reclaim (heat→reserve), capture (heat→ATP), cool (heat leaves).
  # Yield restored into pmf bank. Does not touch energy/reserve/atp/pcr/ready.
  # Usability: AGI banks thermogenesis ledger as proton gradient without flooding mitosis.
  # Returns amount harnessed. Dead/zero/empty heat → 0.
  METHOD harness n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    GETF THIS pmf
    LET p = LAST_N + take
    SETF THIS pmf p
    RET take
  END



  # Buffer: salvage n heat into pcr phosphagen (~P buffer / waste-heat → rapid store).
  # Distinct from thaw (heat→energy), reclaim (heat→reserve), capture (heat→ATP),
  # harness (heat→pmf), cool (heat leaves). Yield restored into pcr bank.
  # Does not touch energy/reserve/atp/pmf/ready.
  # Usability: AGI banks thermogenesis ledger as phosphagen without flooding mitosis.
  # Returns amount buffered. Dead/zero/empty heat → 0.
  METHOD buffer n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    GETF THIS pcr
    LET c = LAST_N + take
    SETF THIS pcr c
    RET take
  END


  # Anneal: spend n heat to shed age (chaperone / mild heat-shock protein refold).
  # Distinct from repair (energy→age), cool (heat leaves), thaw/reclaim/capture/harness/buffer
  # (heat→currency banks). Heat ledger pays; age floors at 0. Yield unchanged (heat not in yield).
  # Does not touch energy/reserve/atp/pmf/pcr/ready.
  # Usability: AGI spends thermogenesis ledger to rejuvenate without burning life spark.
  # Returns amount annealed. Dead/zero/empty heat → 0.
  METHOD anneal n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS age
    LET a = LAST_N
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    LET a = a - take
    SETF THIS age a
    RET take
  END


  # Ease: spend n heat to lower mitosis threshold (thermal priming / heat-shock ease).
  # Distinct from set_threshold (direct retune), anneal (heat→age), temper (radiate excess),
  # thaw/reclaim/capture/harness/buffer (heat→currency banks). Heat pays; thr floors at 1.
  # Yield unchanged (heat not in yield). energy/reserve/atp/pmf/pcr untouched. Recomputes ready.
  # Usability: AGI spends thermogenesis to ease mitosis bar without flooding energy banks.
  # Returns amount eased (threshold drop). Dead/zero/empty heat/thr already 1 → 0.
  METHOD ease n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS heat
    LET h = LAST_N
    LET take = n
    IF take > h THEN
      LET take = h
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 1
    END
    LET room = th - 1
    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET h = h - take
    SETF THIS heat h
    LET th = th - take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      GETF THIS energy
      LET e = LAST_N
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END




  # Refold: spend n ATP to shed age (chaperone ATPase / HSP70 ATP-dependent refold).
  # Distinct from repair (energy→age), anneal (heat→age), spend (ATP→work), futile (ATP→heat).
  # ATP pays; age floors at 0. Yield sheds by take (ATP is in yield). ready untouched.
  # Does not touch energy/reserve/heat/pmf/pcr/ready.
  # Usability: AGI spends work currency to rejuvenate without burning life spark or heat ledger.
  # Returns amount refolded. Dead/zero/empty ATP → 0.
  METHOD refold n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET ag = ag - take
    SETF THIS age ag
    RET take
  END


  # Prime: spend n ATP to lower mitosis threshold (CDK / ATP-dependent cycle priming).
  # Distinct from ease (heat→thr), catalyze (1 ATP arms ready near thr), set_threshold (direct),
  # refold (ATP→age), spend (ATP→work), futile (ATP→heat).
  # ATP pays; thr floors at 1. Yield sheds by take (ATP in yield). energy/reserve/heat/pmf/pcr untouched.
  # Recomputes ready so AGI can spend work currency to open mitosis gate without flooding energy.
  # Returns amount primed (threshold drop). Dead/zero/empty ATP/thr already 1 → 0.
  METHOD prime n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 1
    END
    LET room = th - 1
    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET th = th - take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      GETF THIS energy
      LET e = LAST_N
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END

  # Poise: spend n PCr to lower mitosis threshold (phosphagen CDK burst priming).
  # Distinct from prime (ATP→thr), ease (heat→thr), boost (PCr→energy), load (energy→PCr),
  # discharge (PCr→ATP), set_threshold (direct), catalyze (1 ATP arms ready near thr).
  # PCr pays; thr floors at 1. Yield sheds by take (PCr in yield). energy/reserve/atp/heat/pmf untouched.
  # Recomputes ready so AGI can spend rapid ~P buffer to open mitosis gate without burning ATP or heat.
  # Returns amount poised (threshold drop). Dead/zero/empty PCr/thr already 1 → 0.
  METHOD poise n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pcr
    LET c = LAST_N
    LET take = n
    IF take > c THEN
      LET take = c
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
