    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET th = th + take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
