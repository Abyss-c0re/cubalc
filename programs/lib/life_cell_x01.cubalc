  END


  # Mend: spend n PCr to shed age (phosphagen chaperone / creatine kinase age repair).
  # Distinct from repair (energy→age), anneal (heat→age), refold (ATP→age),
  # brace (PCr→raise thr), poise (PCr→lower thr), boost/load/discharge, drive (pmf→thr).
  # PCr pays; age floors at 0. Yield sheds by take (PCr in yield).
  # energy/reserve/atp/heat/pmf/ready/threshold untouched.
  # Usability: AGI spends rapid ~P buffer to rejuvenate without burning ATP, heat, or life spark.
  # Returns amount mended. Dead/zero/empty PCr/age already 0 → 0.
  METHOD mend n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pcr
    LET c = LAST_N
    LET take = n
    IF take > c THEN
      LET take = c
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET c = c - take
    SETF THIS pcr c
    LET ag = ag - take
    SETF THIS age ag
    RET take
  END



  # Renew: spend n pmf to shed age (chemiosmotic QC / Δψ-dependent chaperone / mito quality control).
  # Distinct from repair (energy→age), anneal (heat→age), refold (ATP→age), mend (PCr→age),
  # drive (pmf→lower thr), uncouple (pmf→heat), synthase (pmf→ATP), pump (energy→pmf).
  # pmf pays; age floors at 0. Yield sheds by take (pmf in yield).
  # energy/reserve/atp/heat/pcr/ready/threshold untouched.
  # Usability: AGI spends proton-motive force to rejuvenate without burning ATP, PCr, heat, or life spark.
  # Returns amount renewed. Dead/zero/empty pmf/age already 0 → 0.
  METHOD renew n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pmf
    LET p = LAST_N
    LET take = n
    IF take > p THEN
      LET take = p
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET p = p - take
    SETF THIS pmf p
    LET ag = ag - take
    SETF THIS age ag
    RET take
  END



  # Scavenge: spend n reserve to shed age (macroautophagy / glycogen-funded proteostasis QC).
  # Distinct from repair (energy→age), anneal (heat→age), refold (ATP→age), mend (PCr→age),
  # renew (pmf→age), bank/draw/stow/saturate/respire/anabolize (reserve traffic).
  # reserve pays; age floors at 0. Yield sheds by take (reserve in yield).
  # energy/atp/heat/pmf/pcr/ready/threshold untouched.
  # Usability: AGI spends protected glycogen bank to rejuvenate without burning ATP, PCr, pmf, heat, or life spark.
  # Returns amount scavenged. Dead/zero/empty reserve/age already 0 → 0.
  METHOD scavenge n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET r = r - take
    SETF THIS reserve r
    LET ag = ag - take
    SETF THIS age ag
    RET take
  END




  # Invest: spend n active energy to raise mitosis threshold (cytosolic nutrient→CDK fortify).
  # Distinct from fortify (ATP→raise thr), brace (PCr→raise thr), harden (heat→raise thr),
  # anchor (pmf→raise thr), feed (energy+ready), bank/draw, set_threshold, drive/prime/poise/ease.
  # energy pays; thr ceiling 1000. Yield sheds by take. reserve/atp/heat/pmf/pcr untouched.
  # Recomputes ready. Usability: AGI invests life spark into mitosis gate seal without ATP/PCr/pmf/heat.
  # Returns amount invested (threshold rise). Dead/zero/empty energy/thr already 1000 → 0.
  METHOD invest n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    LET take = n
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 1
    END
    LET room = 1000 - th
    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    LET th = th + take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END




  # Spare: spend n reserve to lower mitosis threshold (glycogen CDK priming / storage-funded cycle ease).
  # Distinct from ease (heat→lower thr), prime (ATP→lower thr), poise (PCr→lower thr), drive (pmf→lower thr),
  # scavenge (reserve→age), bank/draw/respire/anabolize, invest (energy→raise thr), fortify/brace/harden/anchor.
  # reserve pays; thr floors at 1. Yield sheds by take (reserve in yield).
  # energy/atp/heat/pmf/pcr untouched. Recomputes ready.
  # Usability: AGI spends protected glycogen bank to prime mitosis gate without ATP/PCr/pmf/heat/life spark.
  # Returns amount spared (threshold drop). Dead/zero/empty reserve/thr already 1 → 0.
  METHOD spare n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 1
    END
    LET room = th - 1
    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET r = r - take
    SETF THIS reserve r
    LET th = th - take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      GETF THIS energy
      LET e = LAST_N
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END





  # Buttress: spend n reserve to raise mitosis threshold (glycogen CDK fortify / nutrient-bank gate seal).
  # Distinct from fortify (ATP→raise thr), brace (PCr→raise thr), harden (heat→raise thr),
  # anchor (pmf→raise thr), invest (energy→raise thr), spare (reserve→lower thr), scavenge (reserve→age),
  # bank/draw/stow/saturate/respire, set_threshold, drive/prime/poise/ease (lower thr).
  # reserve pays; thr ceiling 1000. Yield sheds by take (reserve in yield).
  # energy/atp/heat/pmf/pcr/age untouched. Recomputes ready.
  # Usability: AGI spends protected glycogen bank to seal mitosis gate without burning ATP, PCr, pmf, heat, or life spark.
  # Returns amount buttressed (threshold rise). Dead/zero/empty reserve/thr already 1000 → 0.
  METHOD buttress n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 1
    END
    LET room = 1000 - th
    IF room < 1 THEN
      RET 0
    END
    IF take > room THEN
      LET take = room
    END
    IF take < 1 THEN
      RET 0
    END
    LET r = r - take
    SETF THIS reserve r
    LET th = th + take
    SETF THIS threshold th
    LET rd = 0
    GETF THIS quiescent
    LET q = LAST_N
    IF q == 0 THEN
      GETF THIS energy
      LET e = LAST_N
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END

  # Fission: cytokinesis prep — parent yields half active energy + half reserve as maternal endowment.
  # Endowment code = de*1000 + dr (de = energy/2, dr = reserve/2). Parent keeps remainder + full
  # threshold/setpoint/gen phenotype (epigenetic continuity). Ready cleared after cut.
  # Requires alive, not quiescent, energy >= threshold, and energy >= 2 so both keep a spark path.
  # Distinct from after_div (energy-only half, no return, no reserve split), gift (voluntary energy),
  # birth (slot activate), bank/draw/stow/saturate, spare/buttress/invest (threshold ops), scavenge.
  # Yield conserved across parent remainder + code unpack. Free energy flows to daughter lineage.
  # Returns endowment code; dead/G0/below-threshold/spark-only → 0.
  METHOD fission
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    IF e < th THEN
      RET 0
    END
    IF e < 2 THEN
      RET 0
    END
    LET de = e / 2
    IF de < 1 THEN
      RET 0
    END
    LET e = e - de
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    LET dr = r / 2
    LET r = r - dr
    SETF THIS reserve r
    SETF THIS ready 0
    LET code = de * 1000
    LET code = code + dr
    RET code
  END

  # Inherit: apply maternal fission endowment code to a living daughter cell.
  # de = code/1000 → energy; dr = code - de*1000 → reserve. Recomputes ready vs threshold.
  # Does not alter gen/threshold/setpoint/age (lineage identity stays daughter's).
  # Distinct from feed (nutrient pulse), birth (activate slot), bank/draw, gift, saturate,
  # after_div, fission (parent side). Usability: AGI unpacks one RET from parent fission into child.
  # Returns de+dr absorbed. Dead/zero code → 0.
  METHOD inherit code
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF code < 1 THEN
      RET 0
    END
    LET de = code / 1000
    LET dr = code - de * 1000
    IF de < 0 THEN
      LET de = 0
    END
    IF dr < 0 THEN
      LET dr = 0
    END
    LET got = de + dr
    IF got < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N + de
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + dr
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET got
  END

  # Bud: asymmetric cytokinesis / budding-yeast style minority endowment.
  # Packs ~1/3 active energy + ~1/3 reserve as code=de*1000+dr; mother keeps ~2/3.
  # Gates: alive, not G0, energy >= threshold, energy >= 3 so mother keeps spark
  # and bud carries at least 1 unit. Parent phenotype (thr/setpoint/gen/age) held;
  # ready cleared. Yield conserved mother remainder + code unpack.
  # Distinct from fission (equal half split), after_div (energy-only no code/reserve),
  # gift, birth, bank/draw, spare/buttress/invest, scavenge, inherit (daughter side).
  # Usability: AGI models polar growth / stem self-renewal without equal bipartition.
  # Returns endowment code; dead/G0/sub-threshold/too-lean → 0.
  METHOD bud
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET th = LAST_N
    IF th < 1 THEN
      LET th = 10
    END
    IF e < th THEN
      RET 0
    END
    IF e < 3 THEN
      RET 0
    END
    LET de = e / 3
    IF de < 1 THEN
      RET 0
    END
    LET e = e - de
    IF e < 1 THEN
      LET e = 1
    END
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    LET dr = r / 3
    LET r = r - dr
    SETF THIS reserve r
    SETF THIS ready 0
    LET code = de * 1000
    LET code = code + dr
    RET code
  END

  # Spore: bacterial endospore-style survival packing.
  # Parent keeps life spark energy=1, yields de=(energy-1) + full reserve dr as
  # code=de*1000+dr. Reserve cleared on parent; ready cleared. Phenotype thr/gen held.
  # Gates: alive, not G0, energy >= 2 so a transferable de >= 1 exists.
  # Does NOT require mitosis threshold (stress path ≠ division path).
  # Distinct from fission (half/half, needs ready/threshold), bud (~1/3 minority),
  # after_div (energy-only half), die (zeros all), gift, bank/draw, scavenge,
  # inherit (daughter absorb). Free energy conserved in durable spore code.
  # Returns endowment code; dead/G0/spark-only → 0.
  METHOD spore
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 2 THEN
      RET 0
    END
    LET de = e - 1
    IF de < 1 THEN
      RET 0
    END
    SETF THIS energy 1
    GETF THIS reserve
    LET r = LAST_N
    LET dr = r
    SETF THIS reserve 0
    SETF THIS ready 0
    LET code = de * 1000
    LET code = code + dr
    RET code
  END


  # Lyse: altruistic apoptosis / holocrine trophic bequeath to the commons.
  # Packs full active energy + reserve as code=e*1000+r then clears life (die path).
  # No thr/G0 gate — stressed or resting cells may still feed colony cascade.
  # Yield conserved when receiver inherit(code). ATP/pmf/pcr/heat shed (not in code;
  # same packing surface as fission/bud/spore). Distinct from die (discards wealth),
  # gift (keeps alive, energy-only, retains spark), spore/bud/fission (mother lives),
  # after_div, scavenge, spare/invest. Usability: AGI models PCD nutrient recycling.
  # Returns endowment code; dead → 0; empty wealth still dies cleanly → 0.

  # Secrete: merocrine/apocrine trophic vesicle — partial bequeath while living.
  # Packs up to n yield units as code=de*1000+dr. Drain order: active energy down to
  # life spark 1, then reserve. Mother stays alive; ready recomputed vs threshold.
  # No thr/G0 gate (stressed/resting cells may still nourish colony without PCD).
  # Yield conserved when receiver inherit(code). ATP/pmf/pcr/heat untouched.
  # Distinct from gift (energy-only, returns amt not code, no reserve path),
  # lyse (full pack + die), spore (forced spark=1 full pack, stress survival),
  # fission/bud (division ratios, thr gate), die (discards), bank/draw/scavenge.
  # Usability: AGI meters colony trophic flow without killing the donor cell.
  # Returns endowment code; dead/n<1/nothing transferable (e<=1 and r<=0) → 0.
  METHOD secrete n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    IF r < 0 THEN
      LET r = 0
    END
    LET need = n
    LET de = 0
    LET dr = 0
    # energy-first, keep spark >= 1 when e >= 1
    LET can_e = 0
    IF e > 1 THEN
      LET can_e = e - 1
    END
    IF can_e > need THEN
      LET can_e = need
    END
    IF can_e < 0 THEN
      LET can_e = 0
    END
    LET de = can_e
    LET e = e - de
    LET need = need - de
    IF need > 0 THEN
      LET dr = need
      IF dr > r THEN
        LET dr = r
      END
      IF dr < 0 THEN
        LET dr = 0
      END
      LET r = r - dr
      LET need = need - dr
    END
    LET got = de + dr
    IF got < 1 THEN
      RET 0
    END
    SETF THIS energy e
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    LET code = de * 1000
    LET code = code + dr
    RET code
  END

  # Engulf: phagocytosis / endocytic trophic capture of an endowment vesicle or prey pack.
  # Pays 1 active-energy membrane-remodel cost (keep spark: need energy >= 2), then absorbs
  # code=de*1000+dr exactly like inherit (energy+=de, reserve+=dr; ready recompute).
  # No thr/G0 gate on the absorb path after cost — stressed cells may still feed if they can pay.
  # ATP/pmf/pcr/heat untouched. Distinct from inherit (zero-cost maternal dowry),
  # feed (raw nutrient, no code), secrete/gift/lyse/spore (outbound), bank/draw/scavenge.
  # Usability: AGI models predator–prey and vesicle uptake with explicit membrane work.
  # Returns got=de+dr; dead/cost-fail/code<1/empty payload → 0 (no partial cost on fail).
  METHOD engulf code
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF code < 1 THEN
      RET 0
    END
    LET de = code / 1000
    LET dr = code - de * 1000
    IF de < 0 THEN
      LET de = 0
    END
    IF dr < 0 THEN
      LET dr = 0
    END
    LET got = de + dr
    IF got < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    # membrane cost 1; retain life spark
    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    LET e = e + de
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + dr
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET got
  END

  # Digest: lysosomal processing of phagosome/cargo reserve into usable energy.
  # Burns n reserve (cargo) through acid hydrolase path: +n energy, +1 heat byproduct.
  # Pays no extra membrane energy beyond metabolic heat ledger (ATP/pmf/pcr untouched).
  # Requires alive and n>=1 and reserve>=1. Ready recomputed vs threshold (G0 stays unready).
  # Distinct from draw (1:1 reserve→energy, no heat), reclaim (heat→reserve reverse),
  # scavenge (reserve→age discard), engulf (inbound code+membrane cost), feed (raw nutrient),
  # bank (energy→reserve), secrete/lyse/gift (outbound). Completes phagocytosis trophic arc.
  # Usability: AGI models endosome→lysosome yield after engulf without dual IF*P forms.
  # Returns digested amount; dead/n<1/empty reserve → 0.
  METHOD digest n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET r = r - take
    SETF THIS reserve r
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END

  METHOD lyse
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS reserve
    LET r = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    IF r < 0 THEN
      LET r = 0
    END
    LET code = e * 1000
    LET code = code + r
    LET got = e + r
    SETF THIS alive 0
    SETF THIS energy 0
    SETF THIS ready 0
    SETF THIS quiescent 0
    SETF THIS reserve 0
    SETF THIS atp 0
    SETF THIS pmf 0
    SETF THIS heat 0
    SETF THIS pcr 0
    IF got < 1 THEN
      RET 0
    END
    RET code
  END


  # Pinocyte: fluid-phase endocytosis — membrane-paid uptake of ambient nutrient as cargo.
  # Pays 1 active-energy membrane-remodel cost (keep spark: need energy >= 2), then
  # deposits n into reserve (glycogen/cargo bank). Ready recomputed vs threshold.
  # No thr/G0 gate after cost — stressed cells may still drink if they can pay membrane.
  # ATP/pmf/pcr/heat untouched. Distinct from feed (direct energy, zero membrane cost),
  # engulf (coded vesicle/prey pack), photosynth/photophos (light to energy/atp),
  # bank (energy to reserve internal), digest (reserve to energy+heat), draw, scavenge.
  # Usability: AGI models macropinocytosis / nutrient sipping before lysosomal digest.
  # Returns n absorbed; dead/n<1/cost-fail -> 0 (no partial cost on fail).
  METHOD pinocyte n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N + n
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET n
  END


  # Exocyte: fluid-phase exocytosis — membrane-paid export of reserve cargo to medium.
  # Pays 1 active-energy membrane-remodel cost (keep spark: need energy >= 2), then
  # sheds take=min(n,reserve) from reserve. Ready recomputed vs threshold.
  # No thr/G0 gate after cost — stressed cells may still export if they can pay membrane.
  # ATP/pmf/pcr/heat untouched. Distinct from pinocyte (inbound medium→reserve),
  # secrete (energy-first coded vesicle pack, no separate membrane fee), gift (active
  # energy only), digest (reserve→energy+heat), scavenge (reserve→age), bank/draw,
  # lyse (death pack). Completes pinocyte↔exocyte free-energy cargo loop.
  # Usability: AGI models vesicular export / cargo dumping without dual IF*P forms.
  # Returns take exported; dead/n<1/empty reserve/cost-fail → 0 (no partial cost on fail).
  METHOD exocyte n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    IF r < 1 THEN
      RET 0
    END
    LET take = n
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    # membrane cost 1; retain life spark
    IF e < 2 THEN
      RET 0
    END
    LET e = e - 1
    LET r = r - take
    SETF THIS energy e
    SETF THIS reserve r
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END



  # Autophagy: macroautophagy / self-catabolism — recycle worn biomass (age) into metabolic fuel.
  # Burns take=min(n,age) age units → energy += take, heat += 1 (lysosomal self-digest tax).
  # Internal double-membrane path: no active-energy membrane toll. reserve/atp/pmf/pcr untouched.
  # Ready recomputed vs threshold (quiescent stays unready). Yield conserved into energy+heat.
  # Distinct from repair (energy→shed age), scavenge (reserve→shed age), digest (reserve→energy+heat),
  # respire (reserve→energy no heat), thaw (heat→energy), reclaim, cool, die/lyse.
  # Usability: AGI models starvation survival — cell eats damaged organelles to keep the spark.
  # Returns take recycled; dead/n<1/age<1 → 0.
  METHOD autophagy n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET take = n
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END


  # Mitophagy: selective mitochondrial autophagy — QC of worn mito biomass + gradient debris.
  # Burns take=min(n,age) age → energy += take, heat += 1 (lysosomal self-digest tax).
  # Also clears broken proton-gradient debris: pmf -= min(take, pmf) (no heat double-count).
  # Selectivity tax: prefer 1 ATP if atp>=1; else pay 1 active energy (keep spark: need e>=2 before pay).
  # Tax is paid only when take>=1; fail-closed before mutation if tax cannot be paid.
  # reserve/pcr untouched. Ready recomputed vs threshold (quiescent stays unready).
  # Distinct from autophagy (bulk, no tax, no pmf drain), repair (energy→shed age), scavenge
  # (reserve→age), uncouple (pmf→heat only), digest (reserve→energy), respire.
  # Usability: AGI models PINK1/Parkin-style mito QC — clear damaged powerhouses under stress.
  # Returns take recycled; dead/n<1/age<1/tax-fail → 0.
  METHOD mitophagy n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET take = n
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    # selectivity tax: ATP preferred, else active energy (keep spark)
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET paid_atp = 0
    IF a >= 1 THEN
      LET a = a - 1
      SETF THIS atp a
      LET paid_atp = 1
    END
    IF paid_atp == 0 THEN
      GETF THIS energy
      LET e0 = LAST_N
      IF e0 < 2 THEN
        RET 0
      END
      LET e0 = e0 - 1
      SETF THIS energy e0
    END
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET drain = take
    IF drain > p THEN
      LET drain = p
    END
    LET p = p - drain
    SETF THIS pmf p
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END




  # Biogenesis: mitochondrial biogenesis (PGC-1α / NRF1-style OXPHOS rebuild).
  # Invest take=min(n,atp,reserve) ATP + equal reserve (membrane/protein mass)
  # → mint take nascent pmf (fresh cristae seeds) + heat += 1 (biosynthetic tax).
  # Fail-closed before mutation if ATP or reserve cannot fund take>=1.
  # energy/age/pcr untouched. Ready unchanged (pmf is not mitosis currency directly).
  # Distinct from reverse (ATP→pmf, no reserve/heat), pump (energy→pmf), synthase (pmf→ATP),
  # anabolize (ATP→reserve), mitophagy (age→energy + drain pmf), photosynth, uncouple.
  # Completes mitophagy↔biogenesis free-energy QC loop — clear debris, then rebuild fleet.
  # Usability: AGI models exercise/cold-induced mito expansion under ASSERT science boards.
  # Returns take built; dead/n<1/empty atp or reserve → 0.
  METHOD biogenesis n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    LET r = r - take
    SETF THIS atp a
    SETF THIS reserve r
    GETF THIS pmf
    LET p = LAST_N + take
    SETF THIS pmf p
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    RET take
  END



  # Fusion: mitochondrial fusion (MFN1/2 + OPA1 GTPase networking).
  # Pay take=min(n,atp,age) ATP → shed take age (matrix complementation QC) + heat += 1.
  # pmf/reserve/energy/pcr untouched — content mixing holds the gradient, repairs phenotype.
  # Fail-closed before mutation if ATP cannot fund take>=1 or age<1.
  # Distinct from mitophagy (drains pmf + age→energy), biogenesis (ATP+reserve→pmf),
  # repair (energy→age), renew (pmf→age), autophagy (bulk age→energy, no ATP tax), scavenge.
  # Completes QC triad: mitophagy clear → biogenesis rebuild → fusion network complement.
  # Usability: AGI models stress-induced mito networking / complementation under ASSERT boards.
  # Returns take fused; dead/n<1/empty atp or age → 0.
  METHOD fusion n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > ag THEN
      LET take = ag
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET ag = ag - take
    SETF THIS age ag
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    RET take
  END

  # Fragment: mitochondrial fission (DRP1/FIS1 dynamin-related GTPase).
  # Pay take=min(n,atp) ATP → heat += 1 (constriction / membrane scission tax).
  # Damaged-tip nick: lose min(take, age, pmf) pmf when cut frees worn foci (age held).
  # Age is NOT shed here — mitophagy clears isolates after partition; fusion is the inverse network step.
  # pmf nick only when age>=1 and pmf>=1 (young pristine network: ATP tax + heat, gradient held).
  # Fail-closed before mutation if ATP cannot fund take>=1.
  # Distinct from fusion (ATP→age shed, pmf held), mitophagy (age→energy + pmf drain + tax),
  # biogenesis (ATP+reserve→pmf), uncouple (pmf→heat), cytokinesis fission (cell split endowment),
  # autophagy/scavenge/repair/renew.
  # Completes dynamics: fragment isolate → mitophagy clear → biogenesis rebuild → fusion network.
  # Usability: AGI models stress-induced mito fragmentation / DRP1 under ASSERT boards.
  # Returns take fragmented; dead/n<1/empty atp → 0.
  METHOD fragment n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    # damaged-tip gradient nick (age held for downstream mitophagy)
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET nick = take
    IF nick > ag THEN
      LET nick = ag
    END
    IF nick > p THEN
      LET nick = p
    END
    IF nick > 0 THEN
      LET p = p - nick
      SETF THIS pmf p
    END
    RET take
  END



  # Tether: ER–mitochondria contact sites (MERCs / Mfn2–IP3R–VDAC–GRP75).
  # Pay take=min(n,atp) ATP → heat += 1 (tether-complex assembly tax).
  # Ca2+/lipid coupling yields take energy (dehydrogenase kick + phospholipid spark).
  # pmf/age/reserve/pcr untouched — contacts organize flux without bulk rebuild or QC shed.
  # Fail-closed before mutation if ATP cannot fund take>=1.
  # Distinct from biogenesis (ATP+reserve→pmf mass), fusion (ATP→age shed), fragment (ATP→pmf nick),
  # pump (energy→pmf), feed (free nutrient), synthase (pmf→ATP), reverse (ATP→pmf), photosynth.
  # Completes organelle continuum: fragment/mitophagy/biogenesis/fusion dynamics + ER interface.
  # Usability: AGI models MERCs / ER-mito free-energy coupling under ASSERT science boards.
  # Returns take tethered; dead/n<1/empty atp → 0.
  METHOD tether n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END



  # MCU: mitochondrial Ca2+ uniporter (MCU/MICU1/EMRE complex).
  # Spend take=min(n,pmf) proton-motive drive → heat += 1 (ion transit / buffering tax).
  # Matrix Ca2+ activates PDH/ICD/OGDH dehydrogenases → mint take energy (TCA spark).
  # atp/age/reserve/pcr untouched — electrophoretic Ca2+ entry organizes flux without ATP tax or QC shed.
  # Fail-closed before mutation if pmf cannot fund take>=1.
  # Distinct from tether (ATP→energy, pmf held), uncouple (pmf→heat only), synthase (pmf→ATP),
  # reverse (ATP→pmf), pump (energy→pmf), oxidize/respire, biogenesis, fusion, fragment.
  # Extends organelle continuum: MERCs deliver Ca2+; MCU admits it down ΔΨm into matrix catalysis.
  # Usability: AGI models excitation-bioenergetic coupling / Ca2+-stimulated OXPHOS under ASSERT boards.
  # Returns take admitted; dead/n<1/empty pmf → 0.
  METHOD mcu n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET take = n
    IF take > p THEN
      LET take = p
    END
    IF take < 1 THEN
      RET 0
    END
    LET p = p - take
    SETF THIS pmf p
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    LET q = LAST_N
    LET rd = 0
    IF q == 0 THEN
      GETF THIS threshold
      LET th = LAST_N
      IF th < 1 THEN
        LET th = 10
      END
      IF e >= th THEN
        LET rd = 1
      END
    END
    SETF THIS ready rd
    RET take
  END





  # NCLX: mitochondrial Na+/Ca2+ exchanger (NCLX/SLC8B1) + NHE coupling.
  # Spend take=min(n,pmf) ΔΨm (net Ca2+/H+ efflux after MCU load) → heat += 1 (exchanger tax).
  # energy/atp/age/reserve held — extrusion ends matrix Ca2+ TCA window without minting work currency.
  # Fail-closed before mutation if pmf cannot fund take>=1.
  # Distinct from mcu (pmf→energy TCA kick), uncouple (pmf→heat bulk take), synthase (pmf→ATP),
  # reverse (ATP→pmf), tether (ATP→energy MERCs), pump (energy→pmf), fragment/fusion.
  # Completes Ca2+ continuum: tether delivers → mcu admits (TCA spark) → nclx extrudes (reset).
  # Usability: AGI models excitation-bioenergetic recovery / Ca2+ efflux under ASSERT boards.
  # Returns take extruded; dead/n<1/empty pmf → 0.
  METHOD nclx n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET take = n
    IF take > p THEN
      LET take = p
    END
    IF take < 1 THEN
      RET 0
    END
    LET p = p - take
    SETF THIS pmf p
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    RET take
  END


  # MPTP: mitochondrial permeability transition pore (CypD–ANT–VDAC megapore).
  # Collapse take=min(n,pmf) ΔΨm as bulk heat (pore open / solutes equilibrate) → heat += take.
  # Injury mark: age += 1 once when take>=1 (matrix swelling / ROS / cytochrome c risk cue).
  # energy/atp/reserve/pcr held — catastrophic gradient dump without minting work or TCA spark.
  # Fail-closed before mutation if pmf cannot fund take>=1.
  # Distinct from uncouple (controlled UCP leak, no age injury), nclx (pmf tax +1 heat, Ca efflux),
  # mcu (pmf→energy TCA), synthase (pmf→ATP), reverse, tether, mitophagy, fragment.
  # Pathophysiology after Ca2+ continuum overload: tether→mcu→nclx fail / excess → mptp open.
  # Usability: AGI models permeability crisis / necrosis–apoptosis branch under ASSERT boards.
  # Returns take collapsed; dead/n<1/empty pmf → 0.
  METHOD mptp n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS pmf
    LET p = LAST_N
    IF p < 0 THEN
      LET p = 0
    END
    LET take = n
    IF take > p THEN
      LET take = p
    END
    IF take < 1 THEN
      RET 0
    END
    LET p = p - take
    SETF THIS pmf p
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + 1
    SETF THIS age ag
    RET take
  END






  # MOMP: Bax/Bak mitochondrial outer membrane permeabilization.
  # Spend take=min(n,atp) ATP (Bax/Bak oligomerization / pore scaffold) → heat += 1 assembly tax.
  # IMS release injury: age += take (cytochrome c / SMAC/DIABLO / AIF cue toward apoptosome).
  # pmf/energy/reserve/pcr held — OMM pores do not dump DYm (that is mPTP); gradient may already be flat.
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from mptp (pmf→bulk heat + age+1, ATP held), mitophagy (recycle age+pmf→energy),
  # fragment (fission nick pmf), die (zeros all), lyse (PCD pack), uncouple, nclx, mcu, tether.
  # Continuum pathophys: tether→mcu→nclx→mptp overload → momp cyt-c release → apoptosis branch.
  # Usability: AGI models intrinsic apoptosis priming / Bcl-2 family pores under ASSERT boards.
  # Returns take released; dead/n<1/empty atp → 0.
END
