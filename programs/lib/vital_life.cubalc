# vital_life.cubalc — one living cell.
# Integer law. Free energy floors at 1. Regression streak >= 2 raises wound.
# Caller sets VITAL_WOUND VITAL_ENERGY VITAL_MATCH VITAL_SEV VITAL_STREAK VITAL_FLOW
# before INCLUDE. Outputs overwrite wound, energy, and unity.
# Proof: programs/proof/vital_life_force.cubalc

LET VITAL_HEAL = VITAL_WOUND * 900 / 1000
LET VITAL_HIT = VITAL_MATCH * VITAL_SEV / 1000
LET VITAL_WOUND = VITAL_HEAL + VITAL_HIT
IF VITAL_STREAK >= 2 THEN
  LET VITAL_GAIN = 1000 + 250 * (VITAL_STREAK - 1)
  IF VITAL_GAIN > 3000 THEN
    LET VITAL_GAIN = 3000
  END
  LET VITAL_WOUND = VITAL_WOUND * VITAL_GAIN / 1000
END
IF VITAL_WOUND > 1000 THEN
  LET VITAL_WOUND = 1000
END
IF VITAL_WOUND < 0 THEN
  LET VITAL_WOUND = 0
END
LET VITAL_ENERGY = VITAL_ENERGY * 850 / 1000 + (1000 - VITAL_WOUND) * VITAL_FLOW / 1000
IF VITAL_ENERGY > 1000 THEN
  LET VITAL_ENERGY = 1000
END
IF VITAL_ENERGY < 1 THEN
  LET VITAL_ENERGY = 1
END
LET VITAL_UNITY = 1000 - VITAL_WOUND
