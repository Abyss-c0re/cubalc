# life_cell_x07.cubalc — EXTEND Cell pack 7

EXTEND Cell
  METHOD lss n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # Cyp51: lanosterol 14α-demethylase (CYP51 / ERG11) after LSS limb.
  # CYP51 is the cytochrome P450 that demethylates lanosterol (minted by
  # LSS cyclization of SQLE-derived 2,3-oxidosqualene) at C14 so downstream
  # sterol reductases can finish cholesterol and free energy reclaimed from
  # BA/odd-chain ketones builds membrane sterol mass under ASSERT.
  # After Lss opens the lanosterol pool, Cyp51 spends that C30 sterol pool under
  # ASSERT to open the lanosterol 14α-demethylase gate (committed oxidative
  # demethylation that clears C14 for mature sterol rings).
  # Distinct from Lss lanosterol synthase, Sqle squalene epoxidase, Sqs squalene
  # synthase, and Fdps FPP synthase - Cyp51 is the lanosterol 14α-demethylase
  # (CYP51/ERG11) lanosterol -> 4,4-dimethyl-cholesta-8,14,24-trienol gate.
  # Domain: post-LSS lanosterol 14α-demethylase (CYP51/ERG11) C14-demethyl gate.
  # Continuum: ...->hmgcr->mvk->pmvk->mvd->idi1->fdps->sqs->sqle->lss->cyp51
  # Gift: post-LSS CYP51 so BA/odd-chain free-energy path can demethylate
  #   lanosterol at C14 under ASSERT after LSS open.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - cyp51.
  # Usability: AGI models post-LSS CYP51 lanosterol 14α-demethylase under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD cyp51 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
