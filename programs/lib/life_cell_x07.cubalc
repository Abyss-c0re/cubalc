    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END





  # Sgpl1: SGPL1 / sphingosine-1-phosphate lyase (EC 4.1.2.27) after SPHK1 on the sphingolipid continuum.
  # SGPL1 irreversibly cleaves S1P produced by SPHK1 into trans-2-hexadecenal and
  # phosphoethanolamine, exiting the S1P rheostat under ASSERT so post-kinase S1P does not
  # stall as hollow locked second-messenger overflow before PE salvage / hexadecenal limbs.
  # Domain: post-SPHK1 ER-lumenal S1P lyase SGPL1 ward (pyridoxal-phosphate-dependent irreversible S1P cleavage limb toward hexadecenal+ethanolamine-P).
  # Not a rename of ASAH1, GBA, HEXB, HEXA, GLB1, NEU3, ST6GALNAC6, ST6GALNAC5, ST8SIA5,
  #   ST3GAL2, B3GALT4, B4GALNT1, ST8SIA1, ST3GAL5, B4GALT, UGCG/GCS, SMS1, CERT, SAC1,
  #   OSBP, STARD3, ACER alkaline ceramidases, CERK ceramide kinase, SPHK1, SPHK2, or S1PR1-5.
  # Continuum: ...->neu3->glb1->hexa->hexb->gba->asah1->sphk1->sgpl1
  # Gift: SGPL1 irreversibly cleaves post-SPHK1 S1P into hexadecenal and phosphoethanolamine under ASSERT so free
  #   energy exits the S1P rheostat into PE/sphingoid exit pools after SPHK1 phosphorylation —
  #   opposing hollow S1P lock/overflow at the SGPL1 limb (S1P-lyase-deficit ward).
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - sgpl1.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
END
