# INCLUDE class_guard - fail-fast CLASS catalog contract (ALL + optional ANY)
# Usability: agent OOP class gate via native multi forms (no N× HASCLASS soup).
#
#   DEFAULT NEED_CLASSES = "Ticket\nOrder"
#   DEFAULT NEED_CLASS_ANY = "Cell\nAgent"
#   DEFAULT CLASS_GUARD_SOFT = 0
#   INCLUDE class_guard
#
# Spec: each entry is a CLASS name. Soft dual leaves CLASSMISS / CLASSHAVE bags.
# Twin of fn_guard / obj_guard for the CLASS plane.
# Hard ALL: NEEDCLASSES · Hard ANY: NEEDCLASSANY · Soft: HASCLASSES / HASCLASSANY.
# Multi duals still available directly. (REQUIRE CLASS avoided — IF/END nesting.)

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0

SYS EMPTY NEED_CLASSES
IF LAST_N == 1
  LET CLASS_GUARD_ALL_OK = 1
  LET CLASSMISS = ""
  LET CLASSHAVE = ""
  LET CLASSMISS_N = 0
  LET CLASSHAVE_N = 0
ELSE
  IF CLASS_GUARD_SOFT
    HASCLASSES NEED_CLASSES
    LET CLASS_GUARD_ALL_OK = LAST_N
    LET CLASSHAVE_N = HASCLASSES_N
    IF CLASSMISS_N == 0
      LET CLASSHAVE = NEED_CLASSES
    END
  ELSE
    NEEDCLASSES NEED_CLASSES
    LET CLASS_GUARD_ALL_OK = 1
    LET CLASSMISS = ""
    LET CLASSMISS_N = 0
    LET CLASSHAVE = NEED_CLASSES
    LET CLASSHAVE_N = NEEDCLASSES_N
  END
END

SYS EMPTY NEED_CLASS_ANY
IF LAST_N == 1
  LET CLASS_GUARD_ANY_OK = 1
ELSE
  IF CLASS_GUARD_SOFT
    HASCLASSANY NEED_CLASS_ANY
    LET CLASS_GUARD_ANY_OK = LAST_N
    # CLASSHAVE / CLASSMISS / CLASSHAVE_N / CLASSMISS_N from HASCLASSANY
  ELSE
    NEEDCLASSANY NEED_CLASS_ANY
    LET CLASS_GUARD_ANY_OK = 1
    LET CLASSHAVE_N = NEEDCLASSANY_N
  END
END

IF CLASS_GUARD_ALL_OK
  IF CLASS_GUARD_ANY_OK
    LET CLASS_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET CLASS_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET CLASS_GUARD_OK = 0
  LET OK = 0
END
