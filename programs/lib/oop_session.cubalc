# INCLUDE oop_session — full OOP catalog contract one-shot
# Usability: class_guard + method_guard + field_guard without multi INCLUDE
# for agents that need CLASS / Class.method / Class.field readiness before NEW/SEND.
#
#   DEFAULT NEED_CLASSES = "Ticket\nOrder"
#   DEFAULT NEED_CLASS_ANY = ""
#   DEFAULT NEED_METHODS = "Ticket.init\nTicket.bump"
#   DEFAULT NEED_METHOD_ANY = ""
#   DEFAULT NEED_FIELDS = "Ticket.id\nOrder.n"
#   DEFAULT NEED_FIELD_ANY = ""
#   DEFAULT CLASS_GUARD_SOFT = 0
#   DEFAULT METHOD_GUARD_SOFT = 0
#   DEFAULT FIELD_GUARD_SOFT = 0
#   INCLUDE oop_session
#   # OOP_SESSION_OK combines class+method+field soft status
#
# Soft: set *_GUARD_SOFT = 1 before INCLUDE.
# Scaffold: cubalc init demo --oop
# Twin of host_session (path+rw+bin+lib) for OOP plane catalogs.
# HOLD_FLASH not required (runtime default 1).
# Note: does not INCLUDE agent_boot — use oop_boot for preamble + contract.

INCLUDE class_guard
INCLUDE method_guard
INCLUDE field_guard

# combined soft status (hard paths already FAIL-sticky; run -s for exit)
IF CLASS_GUARD_OK
  IF METHOD_GUARD_OK
    IF FIELD_GUARD_OK
      LET OOP_SESSION_OK = 1
      LET OK = 1
    ELSE
      LET OOP_SESSION_OK = 0
      LET OK = 0
    END
  ELSE
    LET OOP_SESSION_OK = 0
    LET OK = 0
  END
ELSE
  LET OOP_SESSION_OK = 0
  LET OK = 0
END
