# life_cell_x08.cubalc — EXTEND Cell pack 8

EXTEND Cell
  METHOD sgpl1 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # Aldh3a2: ALDH3A2 / fatty aldehyde dehydrogenase (FALDH, EC 1.2.1.48) after SGPL1 on the sphingolipid continuum.
  # ALDH3A2 NAD+-dependent oxidation of trans-2-hexadecenal (SGPL1 lyase product) to trans-2-hexadecenoic acid
  # under ASSERT so post-lyase aldehyde does not stall as hollow toxic aldehyde lock before PE / fatty-acid
  # salvage and beta-oxidation re-entry limbs (Sjogren-Larsson / FALDH-deficit ward).
  # Domain: post-SGPL1 ER/peroxisome-proximal fatty aldehyde dehydrogenase ALDH3A2 ward (NAD-dependent
  #   hexadecenal to hexadecenoate limb toward acyl-CoA / PE continuum exit).
