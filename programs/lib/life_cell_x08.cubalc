  #   energy exits the S1P-lyase aldehyde pool into fatty-acid / PE salvage after irreversible S1P cleavage —
  #   opposing hollow toxic aldehyde lock at the ALDH3A2 limb (Sjogren-Larsson ward).
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - aldh3a2.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD aldh3a2 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
