  #   OSBP, STARD3, ACER, CERK, SPHK2, S1PR1-5, or PCYT2/ETNK1 PE branch enzymes.
  # Continuum: ...->neu3->glb1->hexa->hexb->gba->asah1->sphk1->sgpl1->aldh3a2
