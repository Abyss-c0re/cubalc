  # reserve-), not hinge-only energy- (fold thr held), not polar sp+, not
  # lumen pcr+, not cilia pmf+.
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp or energy cannot fund take>=1.
  # Continuum: ...->align->converge->extend->fold->zip->crest->migrate->stream->condense->fate.
  # Signature: heat+n energy-n thr+n; age+pmf+reserve+sp+pcr held — condense life-force.
  # Usability: AGI models NC stream terminal mesenchymal condensation under ASSERT.
  # Returns take condensed; dead/n<1/empty atp|energy -> 0.
  METHOD condense n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N + take
    IF thr > 1000 THEN
      LET thr = 1000
    END
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

