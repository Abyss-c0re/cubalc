  # Continuum: ...->collapse->retrieve->acidify->mature->recruit->activate->degrade->export->translate.
  # Signature: heat+n energy-n reserve+n; age+pmf+thr+sp+pcr held — recruit life-force.
  # Usability: AGI models post-mature hydrolase cargo recruit under ASSERT.
  # Returns take recruited; dead/n<1/empty atp|energy -> 0.
  METHOD recruit n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS reserve
    LET rv = LAST_N
    IF rv < 0 THEN
      LET rv = 0
    END
    LET rv = rv + take
    IF rv > 1000 THEN
      LET rv = 1000
    END
    SETF THIS reserve rv
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END





  # ACTIVATE: post-recruit LE lumen zymogen activation / cathepsin pro-peptide cut.
  # Spend take=min(n,atp,energy,reserve) — ATP + metabolic fuel + hydrolase zymogen
