  # Signature: heat+n energy-n reserve-n thr-n; age+pmf+sp+pcr held — activate life-force.
  # Usability: AGI models post-recruit LE zymogen activation under ASSERT.
  # Returns take activated; dead/n<1/empty atp|energy|reserve -> 0.
  METHOD activate n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS reserve
    LET rv = LAST_N
    IF rv < 0 THEN
      LET rv = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > rv THEN
      LET take = rv
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET rv = rv - take
    IF rv < 0 THEN
      LET rv = 0
    END
    SETF THIS reserve rv
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 1
    END
    LET thr = thr - take
    IF thr < 1 THEN
      LET thr = 1
    END
    SETF THIS threshold thr
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # DEGRADE: post-activate lysosomal substrate proteolysis / cathepsin processive cut.
