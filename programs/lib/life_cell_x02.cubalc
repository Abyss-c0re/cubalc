# life_cell_x02.cubalc — EXTEND Cell pack 2

EXTEND Cell
  METHOD momp n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + 1
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + take
    SETF THIS age ag
    RET take
  END


  # APAF: Apaf-1 / dATP apoptosome assembly (wheel of death) after MOMP cyt-c cue.
  # Spend take=min(n,atp) ATP/dATP (nucleotide binding for heptameric apoptosome) → heat += take
  # (each dATP hydrolysis in CARD oligomerization contributes assembly heat).
  # Platform injury: age += 1 once (caspase-9 docking / apoptosome forms as single holoenzyme cue).
  # pmf/energy/reserve/pcr held — cytosolic apoptosome does not dump DYm or burn glycogen spark.
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from momp (ATP→heat+1 fixed + age+n pore release), mptp (pmf→bulk heat + age+1, ATP held),
  # mitophagy, die, lyse, uncouple, nclx, mcu, tether, fragment.
  # Continuum pathophys: tether→mcu→nclx→mptp overload → momp cyt-c → apaf apoptosome → caspase branch.
  # Signature invert vs momp: heat scales with n, age is unit platform (not pore-count injury).
  # Usability: AGI models intrinsic apoptosis apoptosome priming under ASSERT boards.
  # Returns take assembled; dead/n<1/empty atp → 0.
  METHOD apaf n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + 1
    SETF THIS age ag
    RET take
  END




  # CASP9: caspase-9 initiator activation on Apaf-1 apoptosome (CARD-CARD dimer / auto-cleavage).
  # Spend take=min(n,atp) ATP (holoenzyme catalytic cycles / executioner procaspase-3 processing work)
  # → heat += take (each proteolytic cycle dissipates bond energy as heat).
  # Cascade injury: age += take (executioner caspase-3/7 priming load scales with initiator dose).
  # pmf/energy/reserve/pcr held — cytosolic caspase cascade does not dump DYm or burn glycogen spark.
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from apaf (ATP→heat+n age+1 platform unit), momp (ATP→heat+1 age+n pore release),
  # mptp (pmf→bulk heat age+1, ATP held), mitophagy, die, lyse, uncouple, nclx, mcu, tether, fragment.
  # Continuum pathophys: tether→mcu→nclx→mptp→momp→apaf→casp9 initiator → executioner branch.
  # Signature: BOTH heat and age scale with n (catalytic amplification) — not unit platform, not fixed tax.
  # Usability: AGI models intrinsic apoptosis caspase-9 ignition under ASSERT boards.
  # Returns take cleaved; dead/n<1/empty atp → 0.
  METHOD casp9 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + take
    SETF THIS age ag
    RET take
  END


  # CASP3: caspase-3/7 executioner proteolysis after caspase-9 initiator priming.
  # Spend take=min(n,atp) ATP (cleavage of ICAD, PARP, lamin, cytoskeletal substrates) → heat += take
  # (each peptide-bond scission dissipates as heat). Cascade injury: age += take (demolition load).
  # ENERGY DRAIN: energy = max(0, energy - take) — executioner catabolism dismantles metabolic stores
  # (glycogen/metabolite pools) as cells dismantle from within; distinct from initiator casp9 which holds energy.
  # pmf/reserve/pcr held — DYm not dumped by cytosolic CAD/PARP cut; banked reserve not auto-drawn.
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from casp9 (ATP→heat+n age+n, energy HELD initiator priming), apaf (heat+n age+1 platform),
  # momp (heat+1 age+n pores), mptp, mitophagy, die, lyse, uncouple, spend, nclx, mcu.
  # Continuum pathophys: tether→mcu→nclx→mptp→momp→apaf→casp9→casp3 executioner demolition.
  # Signature: heat+age scale with n AND energy drains by take — not pure initiator, not die.
  # Usability: AGI models intrinsic apoptosis execution phase under ASSERT boards.
  # Returns take cleaved; dead/n<1/empty atp → 0.
  METHOD casp3 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + take
    SETF THIS age ag
    GETF THIS energy
    LET en = LAST_N
    IF en < 0 THEN
      LET en = 0
    END
    LET drain = take
    IF drain > en THEN
      LET drain = en
    END
    LET en = en - drain
    SETF THIS energy en
    RET take
  END

  # CAD: caspase-activated DNase (DFF40) / ICAD liberation after caspase-3 executioner.
  # Spend take=min(n,atp) ATP (nuclease catalytic cycles / chromatin access work) → heat += take
  # (each phosphodiester scission dissipates as heat). Genome injury: age += take (oligonucleosomal
  # ladder load scales with dose). CHECKPOINT: threshold += take (DNA-damage G2/M barrier rises —
  # fragmented genome blocks mitosis); ready recomputed vs energy. ENERGY/pmf/reserve/pcr HELD —
  # nuclear CAD does not drain cytosolic metabolite stores (casp3 already did demolition) nor dump DYm.
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from casp3 (ATP→heat+n age+n + energy drain; thr held), casp9 (energy+thr held initiator),
  # apaf (age+1 platform), momp (heat+1 pores), die (zero all), fortify/prime (thr only, no age/heat pair).
  # Continuum pathophys: tether→mcu→nclx→mptp→momp→apaf→casp9→casp3→cad DNA ladder terminal.
  # Signature: heat+age+threshold all scale with n; energy held — not executioner drain, not pure CDK thr tune.
  # Usability: AGI models intrinsic apoptosis DNA fragmentation / ladder under ASSERT boards.
  # Returns take cleaved; dead/n<1/empty atp → 0.
  METHOD cad n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + take
    SETF THIS age ag
    GETF THIS threshold
    LET thr = LAST_N + take
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END





  # BLEB: apoptotic membrane blebbing (ROCK–actomyosin) after CAD/DFF40 DNA ladder.
  # Spend take=min(n,atp) ATP (myosin-II ATPase cycles driving bleb extrusion / apoptotic bodies)
  # → heat += take (each cross-bridge cycle dissipates as heat). Morphological injury: age += take
  # (plasma-membrane remodeling and cortex demolition scale with dose).
  # CARGO PACK: reserve += take — cytosolic fragments packaged into apoptotic bodies as transferable
  # free-energy cargo for efferocytosis (conserved, not burned). ENERGY/pmf/threshold/pcr HELD —
  # blebbing is mechanical packaging after CAD checkpoint; does not raise DNA thr further nor drain
  # metabolite pools (casp3 already did) nor dump DYm.
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from cad (ATP→heat+n age+n thr+n, reserve HELD DNA checkpoint), casp3 (energy drain,
  # thr+reserve held), secrete (deliberate energy/reserve→inherit code, mother chooses yield),
  # fortify (thr only), die (zero all).
  # Continuum pathophys: tether→mcu→nclx→mptp→momp→apaf→casp9→casp3→cad→bleb bodies → clearance.
  # Signature: heat+age+reserve all scale with n; energy+thr held — not DNA checkpoint, not executioner drain.
  # Usability: AGI models intrinsic apoptosis morphological packaging under ASSERT boards.
  # Returns take blebs formed; dead/n<1/empty atp → 0.
  METHOD bleb n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N + take
    SETF THIS age ag
    GETF THIS reserve
    LET rv = LAST_N + take
    SETF THIS reserve rv
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # EFFER: efferocytosis — phagocytic clearance of apoptotic bodies after BLEB cargo pack.
  # Spend take=min(n,atp) ATP (MerTK/TIM-4/BAI1 receptor work + Rac1 actin phagocytic cup /
  # microtubule traffic of corpse cargo). HEAT += take (each cross-bridge / traffic cycle
  # dissipates as heat). TROPHIC CARGO: energy += take — lipids/proteins/nucleotides from the
  # apoptotic body are metabolized into active free-energy spark (efferocytosis is known to
  # rewire phagocyte immunometabolism; free energy must flow from corpse to clearer).
  # AGE/pmf/reserve/threshold/pcr HELD — clearance is anti-inflammatory resolve (TGF-β/IL-10
  # quiet), not self-injury (unlike bleb age+ on the dying cell) and not glycogen bank pack
  # (bleb already staged reserve on the corpse; clearer burns work ATP and gains spark energy).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from bleb (ATP→heat+n age+n reserve+n on dying cell; energy/thr held),
  # engulf (pay 1 energy + decode de*1000+dr code; no ATP heat pair), digest (reserve→energy+heat),
  # pinocyte (pay 1 energy, reserve+n), secrete (outbound code), casp3 (energy drain demolition),
  # cad (thr+ DNA checkpoint), mcu (pmf→energy). Continuum: …→cad→bleb bodies → effer clearance.
  # Signature: heat+energy scale with n; age+reserve+thr+pmf held — trophic resolve, not injury.
  # Usability: AGI models corpse clearance / non-inflammatory phagocytosis under ASSERT boards.
  # Returns take cleared; dead/n<1/empty atp → 0.
  METHOD effer n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS energy
    LET e = LAST_N + take
    SETF THIS energy e
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # RESOLVE: specialized pro-resolving mediators (SPM/resolvin/protectin/maresin) + TGF-β/IL-10
  # after EFFER corpse clearance. Spend take=min(n,atp) ATP (lipid-mediator synthesis /
  # vesicular release / transcriptional reprogramming to pro-resolve phenotype).
  # HEAT += take (each biosynthetic / secretory cycle dissipates as heat).
  # THRESHOLD eases: thr = max(1, thr - take) — resolution lowers inflammatory / mitotic barrier
  # so tissue can re-enter repair-competent cycle (inverse of CAD DNA-checkpoint thr rise).
  # AGE/energy/pmf/reserve/pcr HELD — resolve is anti-inflammatory quiet after trophic effer,
  # not self-injury (bleb age+), not corpse cargo bank (bleb reserve+), not demolition (casp3
  # energy drain), not pure CDK prime (prime lowers thr without heat pair).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from effer (ATP->heat+n energy+n; thr held trophic cup), bleb (age+n reserve+n),
  # cad (thr+n DNA ladder), prime (ATP->thr- only, no heat), ease (heat->thr-, no ATP),
  # fortify (ATP->thr+), cool (heat leaves system). Continuum: ...->cad->bleb->effer->resolve.
  # Signature: heat+n thr-n; age+energy+reserve+pmf held — pro-resolve ease, not injury/trophic.
  # Usability: AGI models post-efferocytosis resolution / SPM program under ASSERT boards.
  # Returns take resolved; dead/n<1/empty atp -> 0.
  METHOD resolve n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 1
    END
    LET thr = thr - take
    IF thr < 1 THEN
      LET thr = 1
    END
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END




  # RESTIT: epithelial / barrier restitution after RESOLVE (SPM quiet).
  # Spend take=min(n,atp) ATP (actin purse-string / tight-junction trafficking /
  # sheet migration / basement-membrane contact restoration).
  # HEAT += take (each cytoskeletal / trafficking cycle dissipates as heat).
  # AGE sheds: age = max(0, age - take) — work-coupled debridement of residual
  # injury age as tissue returns toward integrity (inverse of bleb age+ injury load).
  # ENERGY/pmf/reserve/threshold/pcr HELD — restitution rebuilds barrier without
  # burning life spark, dumping Δψ, drawing glycogen, or re-raising mitotic bar
  # (resolve already eased thr; restit keeps that quiet set-point).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from resolve (ATP→heat+n thr-n, age HELD pro-resolve ease),
  # effer (ATP→heat+n energy+n thr held trophic cup), bleb (age+n reserve+n),
  # cad (thr+n DNA ladder), refold (ATP→age- no heat), anneal (heat→age-),
  # repair (energy→age-), mend (PCr→age-), renew (pmf→age-), scavenge (reserve→age-),
  # prime (ATP thr- no heat), ease (heat thr-). Continuum: ...→cad→bleb→effer→resolve→restit.
  # Signature: heat+n age-n; energy+reserve+pmf+thr held — barrier rebuild, not injury/trophic/ease.
  # Usability: AGI models post-resolution epithelial restitution under ASSERT boards.
  # Returns take restituted; dead/n<1/empty atp → 0.
  METHOD restit n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS age
    LET ag = LAST_N
    IF ag < 0 THEN
      LET ag = 0
    END
    LET shed = take
    IF shed > ag THEN
      LET shed = ag
    END
    LET ag = ag - shed
    SETF THIS age ag
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END




  # SEAL: tight-junction / barrier competence lock after RESTIT (epithelial rebuild).
  # Spend take=min(n,atp) ATP (claudin/occludin/ZO trafficking, strand polymerization,
  # tricellular junction sealing, contact-inhibition kinase work).
  # HEAT += take (each trafficking / kinase cycle dissipates as heat).
  # THRESHOLD rises: thr = min(1000, thr + take) — sealed barrier restores contact
  # inhibition / mitotic competence bar (inverse of resolve thr- pro-resolve ease;
  # restit held thr quiet set-point; seal re-arms gate without injury age).
  # AGE/energy/pmf/reserve/pcr HELD — seal is junction lock, not injury (bleb age+),
  # not demolition (casp3 energy drain), not cargo bank (bleb reserve+), not thr-ease
  # (resolve), not age-shed rebuild (restit).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from restit (ATP→heat+n age-n thr held barrier rebuild),
  # resolve (ATP→heat+n thr-n age held), fortify (ATP→thr+ no heat),
  # cad (ATP→heat+n age+n thr+n DNA checkpoint), harden (heat→thr+),
  # brace/invest/buttress (other currencies→thr+). Continuum:
  # ...→cad→bleb→effer→resolve→restit→seal.
  # Signature: heat+n thr+n; age+energy+reserve+pmf held — TJ seal competence.
  # Usability: AGI models post-restitution barrier seal / contact inhibition under ASSERT boards.
  # Returns take sealed; dead/n<1/empty atp → 0.
  METHOD seal n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 1 THEN
      LET thr = 1
    END
    LET thr = thr + take
    IF thr > 1000 THEN
      LET thr = 1000
    END
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # POLAR: apical-basal polarity competence after SEAL (TJ lock).
  # Spend take=min(n,atp) ATP (Par3/Par6/aPKC apical complex assembly,
  # Crumbs/Pals1 apical identity, Scribble/Dlg/Lgl basolateral fence,
  # oriented vesicle trafficking, lumen-facing microvilli priming).
  # HEAT += take (each GTPase / kinase polarity cycle dissipates as heat).
  # SETPOINT rises: sp = min(1000, sp + take) — polarized epithelium raises
  # preferred active-energy homeostat (pump/gradient maintenance demand;
  # inverse of thr-only seal contact-inhibition; thr held quiet set-point).
  # AGE/energy/pmf/reserve/pcr/threshold HELD — polar is identity axis lock,
  # not injury (bleb age+), not demolition (casp3 energy drain), not cargo
  # bank (bleb reserve+), not thr-ease (resolve), not age-shed rebuild (restit),
  # not thr+ contact bar (seal), not fortify (thr+ no heat).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from seal (ATP→heat+n thr+n sp held TJ competence),
  # restit (ATP→heat+n age-n thr held), resolve (ATP→heat+n thr-n),
  # fortify (ATP→thr+ no heat), set_setpoint (direct sp write no ATP/heat),
  # regulate (bank/draw no heat). Continuum:
  # ...→cad→bleb→effer→resolve→restit→seal→polar.
  # Signature: heat+n setpoint+n; age+energy+reserve+pmf+thr held — polarity axis.
  # Usability: AGI models post-seal epithelial polarity / lumen readiness under ASSERT.
  # Returns take polarized; dead/n<1/empty atp → 0.
  METHOD polar n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 1 THEN
      LET sp = 1
    END
    LET sp = sp + take
    IF sp > 1000 THEN
      LET sp = 1000
    END
    SETF THIS setpoint sp
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS energy
    LET e = LAST_N
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # LUMEN: apical lumenogenesis competence after POLAR (axis lock).
  # Spend take=min(n,atp) ATP (Rab11a/Myo5b apical trafficking, ezrin-actin
  # scaffolding, CFTR/NKCC/AQP delivery, secretory vesicle fusion for lumen open).
  # HEAT += take (each trafficking / fusion / ion-pump priming cycle dissipates).
  # PCR rises: pcr = min(1000, pcr + take) — apical phosphagen CK shuttle charged
  # for secretory bursts (distinct from charge_pcr ATP→pcr yield-conserved no heat;
  # polar raised setpoint homeostat; seal raised thr contact bar; lumen banks ~P
  # at the apical pole for lumen fluid work without touching thr/sp).
  # AGE/energy/pmf/reserve/threshold/setpoint HELD — lumen is secretory competence,
  # not injury (bleb age+), not thr+ (seal), not sp+ (polar), not age- rebuild (restit),
  # not thr- ease (resolve), not cargo injury bank (bleb reserve+age+).
  # ready recomputed vs energy/threshold (G0 still forces ready 0).
  # Fail-closed before mutation if atp cannot fund take>=1.
  # Distinct from polar (ATP→heat+n sp+n pcr held), seal (ATP→heat+n thr+n),
  # charge_pcr (ATP→pcr no heat), bleb (heat+age+reserve+), photosynth (light→reserve).
  # Continuum: ...→cad→bleb→effer→resolve→restit→seal→polar→lumen.
  # Signature: heat+n pcr+n; age+energy+reserve+pmf+thr+sp held — lumen competence.
  # Usability: AGI models post-polar epithelial lumenogenesis under ASSERT boards.
  # Returns take lumenized; dead/n<1/empty atp → 0.
  METHOD lumen n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    LET take = n
