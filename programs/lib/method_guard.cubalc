# INCLUDE method_guard - fail-fast Class.method catalog contract (ALL + optional ANY)
# Usability: agent OOP method gate via native multi forms (no N× HASMETHOD soup).
#
#   DEFAULT NEED_METHODS = "Ticket.init\nTicket.bump"
#   DEFAULT NEED_METHOD_ANY = "Order.pay\nTicket.pay"
#   DEFAULT METHOD_GUARD_SOFT = 0
#   INCLUDE method_guard
#
# Spec: each entry is Class.method (dot). Soft dual leaves METHMISS / METHHAVE bags.
# Twin of class_guard / obj_guard / fn_guard multi path.
# Hard ALL: NEEDMETHODS · Hard ANY: NEEDMETHODANY · Soft: HASMETHODS / HASMETHODANY
# (dotted multi-class bag form). REQUIRE METHOD avoided — IF/END nesting.

DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0

SYS EMPTY NEED_METHODS
IF LAST_N == 1
  LET METHOD_GUARD_ALL_OK = 1
  LET METHMISS = ""
  LET METHHAVE = ""
  LET METHMISS_N = 0
  LET METHHAVE_N = 0
ELSE
  IF METHOD_GUARD_SOFT
    HASMETHODS NEED_METHODS
    LET METHOD_GUARD_ALL_OK = LAST_N
    LET METHHAVE_N = HASMETHODS_N
    IF METHMISS_N == 0
      LET METHHAVE = NEED_METHODS
    END
  ELSE
    NEEDMETHODS NEED_METHODS
    LET METHOD_GUARD_ALL_OK = 1
    LET METHMISS = ""
    LET METHMISS_N = 0
    LET METHHAVE = NEED_METHODS
    LET METHHAVE_N = NEEDMETHODS_N
  END
END

SYS EMPTY NEED_METHOD_ANY
IF LAST_N == 1
  LET METHOD_GUARD_ANY_OK = 1
ELSE
  IF METHOD_GUARD_SOFT
    HASMETHODANY NEED_METHOD_ANY
    LET METHOD_GUARD_ANY_OK = LAST_N
    # METHHAVE / METHMISS from HASMETHODANY
  ELSE
    NEEDMETHODANY NEED_METHOD_ANY
    LET METHOD_GUARD_ANY_OK = 1
    LET METHHAVE_N = NEEDMETHODANY_N
  END
END

IF METHOD_GUARD_ALL_OK
  IF METHOD_GUARD_ANY_OK
    LET METHOD_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET METHOD_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET METHOD_GUARD_OK = 0
  LET OK = 0
END
