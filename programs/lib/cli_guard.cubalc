# INCLUDE cli_guard — fail-fast CLI surface contract (flags + restargs)
# Usability: agent CLI tools gate required --flags / min positionals without
# N× HASFLAG/NEEDFLAGS + HASRESTARGS glue.
#
#   DEFAULT NEED_FLAGS = "out\nverbose"   # bag / CSV / idents for HASFLAGALL
#   DEFAULT NEED_REST_N = 1               # min non-flag positionals
#   DEFAULT CLI_GUARD_SOFT = 0            # 1 → soft HAS* (OK=0, no fatal)
#   INCLUDE cli_boot                      # optional preamble
#   INCLUDE cli_guard
#
# Empty NEED_FLAGS skips flag gate. NEED_REST_N 0 skips rest gate.
# Soft dual leaves FLAGMISS / RESTARGS_N for agents (CLEAR_ERR after).
# Scaffold: cubalc init --cli then DEFAULT NEED_FLAGS before INCLUDE cli_guard
# HOLD_FLASH not required (same policy as form_guard / var_guard).

DEFAULT NEED_FLAGS = ""
DEFAULT NEED_REST_N = 0
DEFAULT CLI_GUARD_SOFT = 0

# --- flags: multi named --flag presence ---
SYS EMPTY NEED_FLAGS
IF LAST_N == 1
  # no flag contract
  LET CLI_GUARD_FLAGS_OK = 1
ELSE
  IF CLI_GUARD_SOFT
    HASFLAGALL NEED_FLAGS
    LET CLI_GUARD_FLAGS_OK = LAST_N
  ELSE
    NEEDFLAGS NEED_FLAGS
    LET CLI_GUARD_FLAGS_OK = 1
  END
END

# --- restargs: min non-flag count ---
IF NEED_REST_N
  IF CLI_GUARD_SOFT
    HASRESTARGS NEED_REST_N
    LET CLI_GUARD_REST_OK = LAST_N
  ELSE
    REQUIRE RESTARGS NEED_REST_N
    LET CLI_GUARD_REST_OK = 1
  END
ELSE
  LET CLI_GUARD_REST_OK = 1
END

# overall soft status (hard paths already failed fatally if miss)
IF CLI_GUARD_FLAGS_OK
  IF CLI_GUARD_REST_OK
    LET CLI_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET CLI_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET CLI_GUARD_OK = 0
  LET OK = 0
END
