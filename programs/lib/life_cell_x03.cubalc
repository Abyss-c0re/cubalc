# life_cell_x03.cubalc — EXTEND Cell pack 3

EXTEND Cell
  METHOD glycosyl n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET thr = thr + take
    IF thr > 1000 THEN
      LET thr = 1000
    END
    SETF THIS threshold thr
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # TRIM: post-glycosyl ER glucosidase I/II (GCS1 / GANAB) sequential outer-Glc
  # trimming of Glc3Man9GlcNAc2 → Glc1Man9GlcNAc2 monoglucosylated glycan that
  # opens calnexin/calreticulin (CNX/CRT) lectin entry (post-glycosyl trim; not
  # multipotent stream, not GRN fate lock, not growth-cone path sp+ alone, not
  # synaptogenesis thr+ contact, not release quantal thr-, not reuptake clearance
  # energy+, not refill VGLUT pack, not dock HOPS tethering, not arm NSF priming,
  # not clamp complexin clamp, not trigger Ca fusion, not pore SNARE zipper, not
  # mix content dump, not collapse coat uncoat, not retrieve CME membrane bank,
  # not acidify EE proton pump, not mature Rab5->Rab7 identity, not recruit M6PR
  # hydrolase cargo, not activate cathepsin arming thr-, not degrade substrate cut
  # age- pcr+, not export lumen->cytosol pcr- reserve+, not translate reserve- age-
  # ribosome rebuild, not transloc sp+ Sec61 channel gating, not cleave pcr+ SPC
  # signal-peptide scission, not glycosyl thr+ OST en-bloc N-glycan transfer).
  # HEAT += take (each GLS I terminal-Glc cut / GLS II middle-Glc cut / CNX handoff
  #   step dissipates as glucosidase work).
  # ENERGY -= take (trim burns active metabolic pool into glucose scission; kin to
  #   glycosyl energy- but raises CNX-client setpoint bank instead of thr QC mark).
  # ATP -= take (GLS I/II catalytic cycle / glucosidase–CNX handoff nucleotide cost).
  # SETPOINT rises: sp = min(1000, sp + take) — monoglucosylated CNX/CRT client
  #   occupancy / folding-cycle load bank (distinct from transloc sp+ Sec61 nascent-
  #   chain entry before cleave/glycosyl, and from clamp sp+ SNARE hold).
  # AGE/RESERVE/THRESHOLD/PMF/PCR HELD — trim is post-glycosyl Glc trim after OST
  #   sealed the N-glycan, not anabolic age repair, not free-AA reserve spend, not
  #   thr QC mark (glycosyl), not EE proton bank, not phosphagen pcr (cleave).
  # Ready recomputed from energy vs threshold after energy spend (quiescent forces 0).
  # Continuum: ...->export->translate->transloc->cleave->glycosyl->trim->cnx.
  # Signature: heat+n energy-n atp-n sp+n; age+reserve+thr+pmf+pcr held — trim life-force.
  # Usability: AGI models post-glycosyl GLS I/II trim / CNX entry under ASSERT.
  # Returns take trimmed; dead/n<1/empty atp|energy -> 0.
  METHOD trim n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 0 THEN
      LET sp = 0
    END
    LET sp = sp + take
    IF sp > 1000 THEN
      LET sp = 1000
    END
    SETF THIS setpoint sp
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # CNX: post-trim calnexin/calreticulin lectin folding-cycle / monoglucosylated client engagement.
  # Spend take=min(n,atp,energy,setpoint) — ATP + metabolic fuel + CNX-client occupancy
  # fund calnexin/calreticulin lectin binding + ERp57 PDI oxidoreductase folding after
  # TRIM has produced the monoglucosylated Glc1Man9GlcNAc2 CNX entry glycoform
  # (post-trim cnx; not multipotent stream, not GRN fate lock, not growth-cone path
  # sp+, not synaptogenesis thr+ contact, not release quantal thr-, not reuptake
  # clearance energy+, not refill VGLUT pack, not dock HOPS tethering, not arm NSF
  # priming, not clamp complexin clamp, not trigger Ca fusion, not pore SNARE zipper,
  # not mix content dump, not collapse coat uncoat, not retrieve CME membrane bank,
  # not acidify EE proton pump, not mature Rab5->Rab7 identity, not recruit M6PR
  # hydrolase cargo, not activate cathepsin arming thr-, not degrade substrate cut
  # age- pcr+, not export lumen->cytosol pcr- reserve+, not translate reserve- age-
  # ribosome rebuild, not transloc sp+ Sec61 channel gating, not cleave pcr+ SPC
  # signal-peptide scission, not glycosyl thr+ OST N-glycan mark, not trim sp+ GLS
  # I/II CNX-entry load raise — cnx discharges that client bank into folding work).
  # HEAT += take (each CNX/CRT lectin on-rate / ERp57 reshuffle / BiP ATPase dwell
  #   dissipates as folding-cycle work).
  # ENERGY -= take (cnx burns active metabolic pool into lectin-chaperone folding;
  #   kin to trim energy- but discharges sp client bank instead of raising it).
  # ATP -= take (BiP/GRP78 ATPase cycle co-chaperoning the CNX-bound client).
  # SETPOINT falls: sp = sp - take — monoglucosylated CNX-client occupancy bank
  #   is consumed as lectin engages and folds the cargo (distinct from trim sp+
  #   GLS entry load, trigger sp- synaptotagmin unclamp, and clamp sp+ SNARE hold).
  # AGE/RESERVE/THRESHOLD/PMF/PCR HELD — cnx is post-trim lectin folding after GLS
  #   sealed monoglucosylated entry, not anabolic age repair, not free-AA reserve
  #   spend, not thr QC mark (glycosyl), not EE proton bank, not phosphagen pcr.
  # Ready recomputed from energy vs threshold after energy spend (quiescent forces 0).
  # Continuum: ...->export->translate->transloc->cleave->glycosyl->trim->cnx.
  # Continuum: ...->export->translate->transloc->cleave->glycosyl->trim->cnx.
  # Signature: heat+n energy-n atp-n sp-n; age+reserve+thr+pmf+pcr held — cnx life-force.
  # Usability: AGI models post-trim CNX/CRT folding-cycle engagement under ASSERT.
  # Returns take engaged; dead/n<1/empty atp|energy|setpoint -> 0.
  METHOD cnx n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS setpoint
    LET sp = LAST_N
    IF sp < 0 THEN
      LET sp = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > sp THEN
      LET take = sp
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET sp = sp - take
    SETF THIS setpoint sp
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # UGGT: post-cnx UGGT1 (UGGT / UGCGL1) quality-control reglucosylation of misfolded
  # glycoprotein clients — re-attaches a single glucose to Man9GlcNAc2 so the client
  # re-enters the CNX/CRT lectin folding cycle (post-cnx uggt; not multipotent stream,
  # not GRN fate lock, not growth-cone path sp+, not synaptogenesis thr+ contact, not
  # release quantal thr-, not reuptake clearance energy+, not refill VGLUT pack, not
  # dock HOPS tethering, not arm NSF priming, not clamp complexin clamp, not trigger
  # Ca fusion, not pore SNARE zipper, not mix content dump, not collapse coat uncoat,
  # not retrieve CME membrane bank, not acidify EE proton pump, not mature Rab5->Rab7
  # identity, not recruit M6PR hydrolase cargo, not activate cathepsin arming thr-,
  # not degrade substrate cut age- pcr+, not export lumen->cytosol pcr- reserve+, not
  # translate reserve- age- ribosome rebuild, not transloc sp+ Sec61 channel gating,
  # not cleave pcr+ SPC signal-peptide scission, not glycosyl thr+ OST N-glycan mark,
  # not trim sp+ GLS monoglucosylation open, not cnx sp- lectin client discharge).
  # Spend take=min(n,atp,energy,pcr) — ATP + metabolic fuel + local ~P/phosphagen bank
  # fund UGGT1 catalytic reglucosylation after CNX has released a still-misfolded
  # client (post-cnx uggt; UDP-Glc donor coupled to ER redox / energy charge).
  # HEAT += take (each UGGT1 glucose-transfer / QC sensing step dissipates as
  #   glycosyltransferase work).
  # ENERGY -= take (uggt burns active metabolic pool into reglucosylation work; kin to
  #   cnx energy- but holds setpoint and spends phosphagen pcr bank instead of CNX
  #   client occupancy sp bank).
  # ATP -= take (UGGT1 / ER QC ATP-coupled catalytic cycle).
  # PCR falls: pcr = pcr - take — UDP-Glc / ~P donor drawn from local phosphagen bank
  #   (distinct from cleave pcr+ signal-peptide credit, degrade pcr+ hydrolase salvage,
  #   export pcr- cytosol dump, mix pcr- content dilution, charge_pcr direct fill).
  # AGE/RESERVE/THRESHOLD/PMF/SETPOINT HELD — uggt is post-cnx QC reglucosylation that
  #   re-opens the CNX cycle without raising secretory sp, thr latency, or age repair.
  # Ready recomputed from energy vs threshold after energy spend (quiescent forces 0).
  # Fail-closed before mutation if atp/energy/pcr cannot fund take>=1.
  # Continuum: ...->export->translate->transloc->cleave->glycosyl->trim->cnx->uggt->mann.
  # Signature: heat+n energy-n atp-n pcr-n; age+reserve+thr+pmf+sp held — uggt life-force.
  # Usability: AGI models ER glycoprotein QC reglucosylation under ASSERT boards.
  # Returns take reglucosylated; dead/n<1/empty atp|energy|pcr → 0.
  METHOD uggt n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS pcr
    LET pc = LAST_N
    IF pc < 0 THEN
      LET pc = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > pc THEN
      LET take = pc
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET pc = pc - take
    SETF THIS pcr pc
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # MANN: post-uggt ER α-mannosidase I (ERManI / MAN1B1) slow Man9→Man8 demannosylation
  # that times out persistent CNX/UGGT cycles and primes OS-9/XTP3-B ERAD recognition
  # (post-uggt mann; not multipotent stream, not GRN fate lock, not growth-cone path
  # sp+, not synaptogenesis thr+ contact, not release quantal thr-, not reuptake
  # clearance energy+, not refill VGLUT pack, not dock HOPS tethering, not arm NSF
  # priming, not clamp complexin clamp, not trigger Ca fusion, not pore SNARE zipper,
  # not mix content dump, not collapse coat uncoat, not retrieve CME membrane bank,
  # not acidify EE proton pump, not mature Rab5->Rab7 identity, not recruit M6PR
  # hydrolase cargo, not activate cathepsin arming thr-, not degrade substrate cut
  # age- pcr+, not export lumen->cytosol pcr- reserve+, not translate reserve- age-
  # ribosome rebuild, not transloc sp+ Sec61 channel gating, not cleave pcr+ SPC
  # signal-peptide scission, not glycosyl thr+ OST N-glycan mark, not trim sp+ GLS
  # monoglucosylation open, not cnx sp- lectin client discharge, not uggt pcr-
  # UGGT1 reglucosylation).
  # Spend take=min(n,atp,energy) — ATP + metabolic fuel fund ERManI catalytic
  # demannosylation after UGGT has looped a still-misfolded client (post-uggt mann;
  # slow timer distinct from GLS glucose trim).
  # HEAT += take (each ERManI mannose-hydrolysis / timer tick dissipates as
  #   glycoside-hydrolase work).
  # ENERGY -= take (mann burns active metabolic pool into demannosylation work; kin to
  #   glycosyl/trim energy- but raises thr ERAD-susceptibility timer instead of thr
  #   OST mark or sp CNX-entry bank).
  # ATP -= take (ERManI / ER QC ATP-coupled catalytic dwell).
  # THRESHOLD rises: thr = thr + take — mannose-trimmed glycan raises ERAD
  #   susceptibility / OS-9 recognition timer (distinct from glycosyl thr+ OST mark,
  #   activate thr- cathepsin arming, synapse thr+ contact, release thr- quantal dump).
  # AGE/RESERVE/PMF/SETPOINT/PCR HELD — mann is post-uggt slow demannosylation that
  #   advances the ERAD timer without spending CNX-client sp or phosphagen pcr banks,
  #   and without anabolic age rebuild or reserve draw.
  # Continuum: ...->glycosyl->trim->cnx->uggt->mann.
  # Signature: heat+n energy-n atp-n thr+n; age+reserve+pmf+sp+pcr held — mann life-force.
  METHOD mann n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS threshold
    LET thr = LAST_N + take
    SETF THIS threshold thr
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END





  # OS9: post-mann OS-9 / XTP3-B (ERLEC1) MRH-domain lectin recognition of Man8-trimmed
  # glycoprotein clients for ERAD handoff — binds demannosylated N-glycans after ERManI
  # has raised the thr ERAD-susceptibility timer and commits the client toward
  # SEL1L/HRD1 ubiquitination (post-mann os9; not multipotent stream, not GRN fate lock,
  # not growth-cone path sp+, not synaptogenesis thr+ contact, not release quantal thr-,
  # not reuptake clearance energy+, not refill VGLUT pack, not dock HOPS tethering, not
  # arm NSF priming, not clamp complexin clamp, not trigger Ca fusion, not pore SNARE
  # zipper, not mix content dump, not collapse coat uncoat, not retrieve CME membrane
  # bank, not acidify EE proton pump, not mature Rab5->Rab7 identity, not recruit M6PR
  # hydrolase cargo, not activate cathepsin arming thr-, not degrade substrate cut
  # age- pcr+, not export lumen->cytosol pcr- reserve+, not translate reserve- age-
  # ribosome rebuild, not transloc sp+ Sec61 channel gating, not cleave pcr+ SPC
  # signal-peptide scission, not glycosyl thr+ OST N-glycan mark, not trim sp+ GLS
  # monoglucosylation open, not cnx sp- lectin client discharge, not uggt pcr-
  # UGGT1 reglucosylation, not mann thr+ ERManI demannosylation timer).
  # Spend take=min(n,atp,energy,threshold) — ATP + metabolic fuel + mann-raised thr
  # ERAD-susceptibility bank fund OS-9/XTP3-B MRH lectin engagement after MANN has
  # produced the Man8GlcNAc2 glycoform (post-mann os9; recognition commits the timer
  # into bound ERAD-client state and charges local phosphagen for downstream HRD1).
  # HEAT += take (each OS-9/XTP3-B lectin-binding / ERAD-commit step dissipates as
  #   quality-control recognition work).
  # ENERGY -= take (os9 burns active metabolic pool into lectin recognition work; kin
  #   to mann energy- but consumes thr ERAD timer instead of raising it).
  # ATP -= take (OS-9 / ERQC ATP-coupled lectin dwell and SEL1L scaffold contact).
  # THRESHOLD falls: thr = thr - take — mannose-timer bank is spent into committed
  #   OS-9-bound ERAD recognition (distinct from mann thr+ timer raise, glycosyl thr+
  #   OST mark, activate thr- cathepsin arming, synapse thr+ contact).
  # PCR rises: pcr = pcr + take — recognition charges local ~P / Ub-prep phosphagen
  #   bank for downstream HRD1 E3 work (distinct from uggt pcr- spend, cleave pcr+,
  #   degrade age- pcr+, export pcr-).
  # AGE/RESERVE/PMF/SETPOINT HELD — os9 is post-mann ERAD lectin commit that spends
  #   thr timer and charges pcr without anabolic age rebuild, reserve draw, pmf drain,
  #   or CNX-client sp bank motion.
  # Continuum: ...->glycosyl->trim->cnx->uggt->mann->os9.
  # Signature: heat+n energy-n atp-n thr-n pcr+n; age+reserve+pmf+sp held — os9 life-force.
  # Usability: AGI models post-mann OS-9/XTP3-B ERAD lectin recognition under ASSERT.
  # Returns take recognized; dead/n<1/empty atp|energy|thr -> 0.
  METHOD os9 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > thr THEN
      LET take = thr
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET thr = thr - take
    SETF THIS threshold thr
    GETF THIS pcr
    LET pc = LAST_N
    IF pc < 0 THEN
      LET pc = 0
    END
    LET pc = pc + take
    IF pc > 1000 THEN
      LET pc = 1000
    END
    SETF THIS pcr pc
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # HRD: post-os9 SEL1L/HRD1 (SYVN1) ERAD E3 ubiquitin-ligase commit — scaffold+RING
  # transfer of Ub onto OS-9/XTP3-B-bound Man8 clients after lectin recognition has
  # charged the local pcr Ub-prep phosphagen bank (post-os9 hrd; not multipotent stream,
  # not GRN fate lock, not growth-cone path sp+, not synaptogenesis thr+ contact, not
  # release quantal thr-, not reuptake clearance energy+, not refill VGLUT pack, not
  # dock HOPS tethering, not arm NSF priming, not clamp complexin clamp, not trigger Ca
  # fusion, not pore SNARE zipper, not mix content dump, not collapse coat uncoat, not
  # retrieve CME membrane bank, not acidify EE proton pump, not mature Rab5->Rab7
  # identity, not recruit M6PR hydrolase cargo, not activate cathepsin arming thr-, not
  # degrade substrate cut age- pcr+, not export lumen->cytosol pcr- reserve+, not
  # translate reserve- age- ribosome rebuild, not transloc sp+ Sec61 channel gating, not
  # cleave pcr+ SPC signal-peptide scission, not glycosyl thr+ OST N-glycan mark, not
  # trim sp+ GLS monoglucosylation open, not cnx sp- lectin client discharge, not uggt
  # pcr- UGGT1 reglucosylation, not mann thr+ ERManI demannosylation timer, not os9 thr-
  # pcr+ OS-9/XTP3-B lectin commit).
  # Spend take=min(n,atp,energy,pcr) — ATP + metabolic fuel + os9-charged pcr Ub-prep
  # bank fund SEL1L scaffold / HRD1 RING Ub transfer after OS9 has bound the Man8
  # client (post-os9 hrd; E3 commit spends the phosphagen prep into conjugated Ub mark).
  # HEAT += take (each HRD1 Ub-transfer / E2~E3 catalytic dwell dissipates as ERAD
  #   ubiquitination work).
  # ENERGY -= take (hrd burns active metabolic pool into E3 ligase work; kin to os9
  #   energy- but consumes pcr Ub-prep instead of thr ERAD timer).
  # ATP -= take (HRD1 / SEL1L ATP-coupled ubiquitination and retrotranslocon priming).
  # PCR falls: pcr = pcr - take — os9-charged Ub-prep phosphagen is spent into actual
  #   poly-Ub conjugation on the ERAD client (distinct from os9 pcr+ charge, uggt pcr-
  #   UGGT spend, cleave pcr+ SPC, degrade age- pcr+, export pcr-).
  # AGE/RESERVE/PMF/SETPOINT/THRESHOLD HELD — hrd is post-os9 E3 commit that spends
  #   pcr without anabolic age rebuild, reserve draw, pmf drain, CNX-client sp motion,
  #   or thr timer rewrite (timer already committed by os9).
  # Continuum: ...->glycosyl->trim->cnx->uggt->mann->os9->hrd.
  # Signature: heat+n energy-n atp-n pcr-n; age+reserve+pmf+sp+thr held — hrd life-force.
  # Usability: AGI models post-os9 SEL1L/HRD1 ERAD ubiquitination under ASSERT.
  # Returns take ubiquitinated; dead/n<1/empty atp|energy|pcr -> 0.
  METHOD hrd n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS pcr
    LET pc = LAST_N
    IF pc < 0 THEN
      LET pc = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > pc THEN
      LET take = pc
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET pc = pc - take
    SETF THIS pcr pc
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # VCP: post-hrd p97/VCP (valosin-containing protein / Cdc48) AAA+ ATPase
  # retrotranslocation extractase — hexameric unfoldase pulls HRD1-ubiquitinated
  # Man8 clients from the ER membrane into the cytosol with Ufd1-Npl4 cofactors
  # after SEL1L/HRD1 has conjugated the Ub mark (post-hrd vcp; not multipotent
  # stream, not GRN fate lock, not growth-cone path sp+, not synaptogenesis thr+
  # contact, not release quantal thr-, not reuptake clearance energy+, not refill
  # VGLUT pack, not dock HOPS tethering, not arm NSF priming, not clamp complexin
  # clamp, not trigger Ca fusion, not pore SNARE zipper, not mix content dump, not
  # collapse coat uncoat, not retrieve CME membrane bank, not acidify EE proton
  # pump, not mature Rab5->Rab7 identity, not recruit M6PR hydrolase cargo, not
  # activate cathepsin arming thr-, not degrade substrate cut age- pcr+, not export
  # lumen->cytosol pcr- reserve+, not translate reserve- age- ribosome rebuild, not
  # transloc sp+ Sec61 channel gating, not cleave pcr+ SPC signal-peptide scission,
  # not glycosyl thr+ OST N-glycan mark, not trim sp+ GLS monoglucosylation open,
  # not cnx sp- lectin client discharge, not uggt pcr- UGGT1 reglucosylation, not
  # mann thr+ ERManI demannosylation timer, not os9 thr- pcr+ OS-9/XTP3-B lectin
  # commit, not hrd pcr- SEL1L/HRD1 E3 Ub transfer).
  # Spend take=min(n,atp,energy) — ATP + metabolic fuel fund p97 AAA+ unfoldase
  # cycles after HRD has Ub-marked the OS-9-bound client (post-hrd vcp; extraction
  # returns the polypeptide as cytosolic cargo bank for proteasome handoff).
  # HEAT += take (each p97 ATP-hydrolysis / unfoldase dwell dissipates as
  #   retrotranslocation mechanical work).
  # ENERGY -= take (vcp burns active metabolic pool into AAA+ extraction work;
  #   kin to hrd energy- but does not spend the pcr Ub-prep bank).
  # ATP -= take (p97 hexamer is a dedicated AAA+ ATPase; ~6 ATP per extraction
  #   stroke under physiological load).
  # RESERVE rises: reserve = min(1000, reserve + take) — extracted polypeptide
  #   joins the cytosolic substrate bank (distinct from export pcr- reserve+ AA
  #   efflux, retrieve membrane bank, recruit hydrolase cargo, reuptake transmitter).
  # AGE/PMF/SETPOINT/THRESHOLD/PCR HELD — vcp is post-hrd mechanical extraction
  #   that neither ages the cell nor retunes ERAD timers / phosphagen prep.
  # Continuum: ...->trim->cnx->uggt->mann->os9->hrd->vcp.
  # Signature: heat+n energy-n atp-n reserve+n; age+pmf+sp+thr+pcr held — vcp life-force.
  METHOD vcp n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET r = r + take
    IF r > 1000 THEN
      LET r = 1000
    END
    SETF THIS reserve r
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # PSM: post-vcp 26S proteasome (AAA+ 19S RP + 20S CP) degradation of
  # VCP-extracted Ub-marked clients — unfolds and cleaves the cytosolic
  # substrate bank that p97 deposited after HRD1 ERAD (post-vcp psm; not
  # multipotent stream, not GRN fate lock, not growth-cone path sp+, not
  # synaptogenesis thr+ contact, not release quantal thr-, not reuptake
  # clearance energy+, not refill VGLUT pack, not dock HOPS tethering, not
  # arm NSF priming, not clamp complexin clamp, not trigger Ca fusion, not
  # pore SNARE zipper, not mix content dump, not collapse coat uncoat, not
  # retrieve CME membrane bank, not acidify EE proton pump, not mature
  # Rab5->Rab7 identity, not recruit M6PR hydrolase cargo, not activate
  # cathepsin arming thr-, not degrade lysosomal substrate cut age- pcr+,
  # not export lumen->cytosol pcr- reserve+, not translate reserve- age-
  # ribosome rebuild, not transloc sp+ Sec61 channel gating, not cleave
  # pcr+ SPC signal-peptide scission, not glycosyl thr+ OST N-glycan mark,
  # not trim sp+ GLS monoglucosylation open, not cnx sp- lectin client
  # discharge, not uggt pcr- UGGT1 reglucosylation, not mann thr+ ERManI
  # demannosylation timer, not os9 thr- MRH lectin commit, not hrd pcr-
  # SEL1L/HRD1 Ub mark, not vcp reserve+ AAA+ retrotranslocation extract).
  # Spend take=min(n,atp,energy,reserve) — ATP + metabolic fuel + VCP-
  # deposited cytosolic substrate bank fund 26S proteasome processive
  # degradation after VCP has extracted the HRD1-Ub client (post-vcp psm;
  # proteolytic commit clears the reserve bank into peptide products).
  # HEAT += take (each 19S unfoldase / 20S proteolytic dwell dissipates as
  #   proteasomal degradation work).
  # ENERGY -= take (psm burns active metabolic pool into AAA+ unfoldase +
#   pepr n              post-psm cytosolic peptidase AA salvage — pay min(n,atp,energy) → heat+n energy-n atp-n reserve+n; age/pmf/sp/thr/pcr held; free-AA recovery after 26S oligopeptides
  #   CP gate work; kin to vcp energy- but consumes the reserve substrate
  #   bank instead of raising it).
  # ATP -= take (26S is ATP-dependent; 19S RPT1-6 hexamer hydrolyzes ATP
  #   per translocation stroke under physiological load).
  # RESERVE falls: reserve = reserve - take — extracted polypeptide
  #   substrate is consumed by the proteasome (distinct from vcp reserve+
  #   extract deposit, export pcr- reserve+ AA efflux, retrieve membrane
  #   bank, recruit hydrolase cargo, reuptake transmitter).
  # AGE/PMF/SETPOINT/THRESHOLD/PCR HELD — psm is post-vcp proteolytic
  #   clearance that neither ages the cell nor retunes ERAD timers /
  #   phosphagen prep (distinct from degrade age- pcr+ lysosomal cut).
  # Continuum: ...->trim->cnx->uggt->mann->os9->hrd->vcp->psm->pepr->aars->eftu->ptc.
  # Signature: heat+n energy-n atp-n reserve-n; age+pmf+sp+thr+pcr held — psm life-force.
  METHOD psm n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET r = r - take
    SETF THIS reserve r
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # PEPR: post-psm cytosolic peptidase / oligopeptide hydrolase salvage —
  # thimet oligopeptidase (THOP1), TPPII, and puromycin-sensitive aminopeptidase
  # cleave 26S-released oligopeptides to free amino acids that re-enter the
  # reserve anabolic bank after PSM has consumed the Ub-client substrate.
  # Continuum: ...->trim->cnx->uggt->mann->os9->hrd->vcp->psm->pepr->aars->eftu->ptc.
  # Pay take=min(n,atp,energy) — ATP fuels AAA-adjacent peptidase processivity
  # and metabolic energy pays hydrolysis work; reserve RISES by take as free AA
  # salvage (distinct from psm reserve- substrate burn, export pcr- reserve+
  # lysosomal efflux, reclaim heat- reserve+, scavenge reserve- energy+,
  # translate reserve- ribosome rebuild).
  # AGE/PMF/SETPOINT/THRESHOLD/PCR HELD — pepr is post-proteasomal AA recovery
  # that neither ages the cell nor retunes ERAD timers / phosphagen prep.
  # Signature: heat+n energy-n atp-n reserve+n; age+pmf+sp+thr+pcr held — pepr life-force.
  METHOD pepr n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET r = r + take
    IF r > 1000 THEN
      LET r = 1000
    END
    SETF THIS reserve r
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # AARS: post-pepr aminoacyl-tRNA synthetase (aaRS) charging —
  # class I/II synthetases condense free AA (salvaged by PEPR after 26S
  # oligopeptide hydrolysis) onto cognate tRNA: AA + tRNA + ATP ->
  # AA-tRNA + AMP + PPi. Restores ternary-complex substrate for ribosomes
  # after ERAD/proteasome/peptidase salvage continuum.
  # Continuum: ...->trim->cnx->uggt->mann->os9->hrd->vcp->psm->pepr->aars->eftu->ptc.
  # Pay take=min(n,atp,energy,reserve) — ATP drives aminoacyl-adenylate
  # formation; metabolic energy pays editing-domain proofreading; reserve
  # FALLS as free AA are esterified onto tRNA (inverse of pepr reserve+
  # salvage; distinct from psm reserve- substrate burn without tRNA, from
  # translate reserve- ribosome rebuild age-, from export pcr- reserve+).
  # PCR rises: pcr = min(1000, pcr + take) — AMP/PPi phosphagen-adjacent
  # echo of aaRS adenylate chemistry (distinct from cleave pcr+ SPC scission,
  # degrade age- pcr+, uggt pcr- UDP-Glc draw).
  # AGE/PMF/SETPOINT/THRESHOLD HELD — aars charges tRNA without aging the
  # cell or retuning ERAD timers / division threshold.
  # Signature: heat+n energy-n atp-n reserve-n pcr+n; age+pmf+sp+thr held — aars life-force.
  # Usability: AGI models post-pepr aaRS tRNA charging under ASSERT boards.
  METHOD aars n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > r THEN
      LET take = r
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET r = r - take
    SETF THIS reserve r
    GETF THIS pcr
    LET c = LAST_N
    IF c < 0 THEN
      LET c = 0
    END
    LET c = c + take
    IF c > 1000 THEN
      LET c = 1000
    END
    SETF THIS pcr c
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # EFTU: post-aars EF-Tu·GTP·AA-tRNA ternary-complex A-site delivery —
  # elongation factor EF-Tu (EF1A) escorts aars-charged aminoacyl-tRNA into the
  # ribosomal A site; codon–anticodon match triggers GTP hydrolysis and EF-Tu
  # release so peptidyl transfer can proceed. Closes the salvage→recharge→deliver
  # loop after ERAD/proteasome/peptidase/aaRS continuum.
  # Continuum: ...->os9->hrd->vcp->psm->pepr->aars->eftu->ptc->efg->rf1->rf3.
  # Pay take=min(n,atp,energy,pcr) — ATP/GTP-adjacent phosphagen (pcr) fuels the
  # EF-Tu GTPase proofreading cycle; metabolic energy pays accommodation work;
  # reserve HELD (AA already esterified on tRNA by aars; distinct from aars
  # reserve- charge, pepr reserve+ salvage, translate reserve- age- rebuild,
  # psm reserve- substrate burn, export pcr- reserve+).
  # PCR falls: pcr = pcr - take — GTP→GDP+Pi echo of EF-Tu hydrolysis (inverse
  # of aars pcr+ adenylate; distinct from uggt pcr- UDP-Glc, cleave pcr+ SPC).
  # AGE/PMF/SETPOINT/THRESHOLD/RESERVE HELD — eftu delivers ternary complex
  # without aging the cell or retuning ERAD timers / division threshold / AA bank.
  # Signature: heat+n energy-n atp-n pcr-n; age+pmf+sp+thr+reserve held — eftu life-force.
  # Usability: AGI models post-aars EF-Tu delivery under ASSERT boards.
  METHOD eftu n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS pcr
    LET c = LAST_N
    IF c < 0 THEN
      LET c = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > c THEN
      LET take = c
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET c = c - take
    SETF THIS pcr c
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END




  # PTC: post-eftu peptidyl-transferase center peptide-bond formation —
  # ribosomal 23S/28S PTC catalyzes nucleophilic attack of A-site AA-tRNA
  # alpha-amine on P-site peptidyl-tRNA carbonyl, forging the peptide bond and
  # transferring the chain to the A-site tRNA (no NTP hydrolysis at the PTC
  # itself; GTPases already paid at eftu delivery). Extends nascent chain after
  # salvage->charge->deliver continuum.
  # Continuum: ...->psm->pepr->aars->eftu->ptc->efg->rf1->rf3->rrf.
  # Pay take=min(n,energy) — only metabolic reorganization / desolvation work
  # at the PTC active site; ATP HELD (no aaRS adenylate); PCR HELD (EF-Tu GTP
  # already burned at eftu); RESERVE HELD (AA still esterified on tRNA until
  # bond forms; chain stays ribosome-tethered — distinct from aars reserve-
  # charge, pepr reserve+ salvage, eftu pcr- delivery, translate reserve- age-
  # rebuild, psm reserve- substrate burn).
  # HEAT += take (each aminolysis / peptide-bond condensation dissipates).
  # AGE/PMF/SETPOINT/THRESHOLD/ATP/PCR/RESERVE HELD — ptc forges bonds without
  # aging the cell, retuning ERAD timers / division threshold, or spending
  # NTP / AA bank beyond prior eftu delivery.
  # Signature: heat+n energy-n; age+pmf+sp+thr+atp+pcr+reserve held — ptc life-force.
  # Usability: AGI models post-eftu PTC peptide-bond formation under ASSERT boards.
  METHOD ptc n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END



  # EFG: post-ptc EF-G·GTP ribosomal translocation / mRNA–tRNA ratchet —
  # elongation factor EF-G (EF2) binds the post-peptidyl-transfer ribosome and
  # hydrolyzes GTP to drive hybrid-state tRNA resolution: deacylated tRNA from
  # P→E, peptidyl-tRNA from A→P, and mRNA advance by one codon. Unlocks the next
  # A-site for eftu delivery after ptc peptide-bond formation.
  # Continuum: ...->psm->pepr->aars->eftu->ptc->efg->rf1->rf3.
  # Pay take=min(n,atp,energy,pcr) — ATP/GTP-adjacent phosphagen (pcr) fuels the
  # EF-G GTPase power stroke; metabolic energy pays ratchet/unlocked-domain work;
  # reserve HELD (nascent chain already elongated at ptc; AA bank untouched —
  # distinct from aars reserve- charge, pepr reserve+ salvage, ptc energy-only
  # bond forge, eftu pcr- delivery, translate reserve- age- rebuild).
  # PCR falls: pcr = pcr - take — GTP→GDP+Pi echo of EF-G hydrolysis (same class
  # as eftu pcr-; inverse of aars pcr+ adenylate; distinct from uggt pcr- UDP-Glc).
  # AGE/PMF/SETPOINT/THRESHOLD/RESERVE HELD — efg ratchets the ribosome without
  # aging the cell or retuning ERAD timers / division threshold / AA bank.
  # Signature: heat+n energy-n atp-n pcr-n; age+pmf+sp+thr+reserve held — efg life-force.
  # Usability: AGI models post-ptc EF-G translocation under ASSERT boards.
  METHOD efg n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS pcr
    LET c = LAST_N
    IF c < 0 THEN
      LET c = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > c THEN
      LET take = c
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    LET c = c - take
    SETF THIS pcr c
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END




  # RF1: post-efg class-I release factor (RF1/RF2/eRF1) peptide-chain release —
  # stop codon in the A site (placed by efg mRNA ratchet) is decoded by RF1/RF2
  # (or eRF1). The universally conserved GGQ motif inserts into the PTC and
  # catalyzes hydrolytic cleavage of the ester bond linking the completed
  # nascent chain to P-site tRNA — releasing free polypeptide. No GTP is burned
  # by RF1 itself (RF3 GTPase ejects RF1 afterward; modeled separately).
  # Continuum: ...->psm->pepr->aars->eftu->ptc->efg->rf1->rf3.
  # Pay take=min(n,energy) — metabolic energy pays RF domain docking / GGQ
  # insertion conformational work; ATP/PCR HELD (not aaRS adenylate, not EF-G
  # or EF-Tu GTPase power stroke). RESERVE rises: reserve = min(1000, reserve+take)
  # — released completed chain banks into the product/AA-adjacent pool (inverse
  # of aars reserve- charge and translate reserve- rebuild; same class as pepr
  # reserve+ salvage but WITHOUT atp- — pure catalytic ester hydrolysis).
  # AGE/PMF/SETPOINT/THRESHOLD/ATP/PCR HELD — rf1 releases chain without aging
  # the cell, retuning division threshold, or drawing phosphagen.
  # Signature: heat+n energy-n reserve+n; atp+pcr+age+pmf+sp+thr held — rf1 life-force.
  # Usability: AGI models post-efg stop-codon peptide release under ASSERT boards.
  METHOD rf1 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET e = e - take
    SETF THIS energy e
    GETF THIS reserve
    LET r = LAST_N
    IF r < 0 THEN
      LET r = 0
    END
    LET r = r + take
    IF r > 1000 THEN
      LET r = 1000
    END
    SETF THIS reserve r
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # RF3: post-rf1 class-II release factor RF3·GTP (eRF3) ejectase —
  # after RF1/RF2 GGQ ester hydrolysis releases the completed chain, RF3·GTP
  # binds the RF1·ribosome complex; GTP hydrolysis drives conformational
  # rearrangement that ejects class-I RF from the A site and primes the
  # post-termination complex for ribosome recycling (RRF/EF-G next).
  # No peptide bond / no chain bank here — pure GTPase power stroke like efg/eftu.
  # Continuum: ...->psm->pepr->aars->eftu->ptc->efg->rf1->rf3.
  # Pay take=min(n,atp,energy,pcr) — ATP stands in for GTP·RF3 hydrolysis;
  # PCR drawn as phosphagen/GTP-pool couple (same class as efg/eftu GTPase).
  # RESERVE HELD (chain already banked by rf1). AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n energy-n atp-n pcr-n; age+reserve+pmf+sp+thr held — rf3 life-force.
  # Usability: AGI models post-rf1 RF3 ejectase under ASSERT boards.
  METHOD rf3 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    GETF THIS pcr
    LET c = LAST_N
    IF c < 0 THEN
      LET c = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take > c THEN
      LET take = c
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
