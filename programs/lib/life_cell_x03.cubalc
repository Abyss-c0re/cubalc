  # MreB: actin-like elongasome cytoskeletal scaffold after RodA SEDS.
  # MreB forms membrane-associated filaments that organize the RodA/PBP2
  # elongasome along the sidewall so glycan polymerization is circumferential
  # and length-wise, not septal. Without MreB scaffold burn, RodA polymerase
  # still lacks spatial routing and rods lose shape homeostasis after FisPay.
  # Domain: post-RodA MreB cytoskeletal scaffold (not RodA SEDS polymerase
  # itself, not PBP2 TP partner, not fispay endowment, not scission PG cut,
  # not NlpD LytM, not RlpA lytic TG, not FtsZ ring, not FtsI septal PBP3,
  # not DamX SPOR, not DedD sensor, not AmiC, not EnvC, not LpoB).
  # Continuum: ...->damx->rlpa->nlpd->scission->fispay->roda->mreb->mrec
  #   (RodA sidewall PG polymerize -> MreB scaffold -> MreC periplasmic partner).
  # Pay take=min(n,atp,energy) - ATP stand-in for MreB filament treadmilling.
  # PCR/RESERVE HELD. AGE/PMF/SETPOINT/THRESHOLD HELD.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - mreb life-force.
  # Usability: AGI models post-RodA MreB scaffold energy gate under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD mreb n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


