# INCLUDE form_guard — fail-fast form capability contract (ALL + optional ANY)
# Usability: agent capability gate without N× HASFORM / NEEDFORM glue.
#
#   DEFAULT NEED_FORMS = "HASFORM\nNEEDFORM\nHASFORMS"  # all-of (HASFORMS / NEEDFORMS)
#   DEFAULT NEED_FORM_ANY = "SORTLIBS\nWALK"            # any-of (HASFORMANY / NEEDFORMANY)
#   DEFAULT FORM_GUARD_SOFT = 0                        # 1 → soft HAS* (OK=0, no fatal)
#   INCLUDE form_guard
#
# Empty NEED_FORMS skips ALL gate. Empty NEED_FORM_ANY skips ANY gate.
# Soft dual leaves FORMMISS / FORMHAVE bags for agents (CLEAR_ERR after).
# Twin of env_guard / cli_guard for HELP-catalog forms · pairs HASFORMS/HASFORMANY.
# HOLD_FLASH not required (same policy as agent_boot / var_guard / time_guard).

DEFAULT NEED_FORMS = "HASFORM\nNEEDFORM\nHASFORMS"
DEFAULT NEED_FORM_ANY = ""
DEFAULT FORM_GUARD_SOFT = 0

# --- ALL-of: multi form names must all be in HELP catalog ---
SYS EMPTY NEED_FORMS
IF LAST_N == 1
  LET FORM_GUARD_ALL_OK = 1
ELSE
  IF FORM_GUARD_SOFT
    HASFORMS NEED_FORMS
    LET FORM_GUARD_ALL_OK = LAST_N
  ELSE
    NEEDFORMS NEED_FORMS
    LET FORM_GUARD_ALL_OK = 1
  END
END

# --- ANY-of: at least one of the named forms present ---
SYS EMPTY NEED_FORM_ANY
IF LAST_N == 1
  LET FORM_GUARD_ANY_OK = 1
ELSE
  IF FORM_GUARD_SOFT
    HASFORMANY NEED_FORM_ANY
    LET FORM_GUARD_ANY_OK = LAST_N
  ELSE
    NEEDFORMANY NEED_FORM_ANY
    LET FORM_GUARD_ANY_OK = 1
  END
END

# overall soft status (hard paths already failed fatally if miss)
IF FORM_GUARD_ALL_OK
  IF FORM_GUARD_ANY_OK
    LET FORM_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET FORM_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET FORM_GUARD_OK = 0
  LET OK = 0
END
