# INCLUDE oop_boot — agent preamble + full OOP catalog contract one-shot
# Usability: agent_boot + oop_session without two INCLUDEs or double agent_boot.
#
#   DEFAULT NEED_CLASSES = ""
#   DEFAULT NEED_METHODS = ""
#   DEFAULT NEED_FIELDS = ""
#   INCLUDE oop_boot
# Soft miss: set CLASS/METHOD/FIELD_GUARD_SOFT = 1 before INCLUDE
#
# Scaffold: cubalc init demo --oop
# Twin of host_boot / field_boot / method_boot / class_boot for combined OOP plane.
# HOLD_FLASH not required (runtime default 1 · same as agent_boot).

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
DEFAULT NEED_FIELDS = ""
DEFAULT NEED_FIELD_ANY = ""
DEFAULT FIELD_GUARD_SOFT = 0
INCLUDE agent_boot
INCLUDE oop_session
