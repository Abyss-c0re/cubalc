# INCLUDE plate_guard — fail-fast PLATE key contract (ALL + optional ANY)
# Usability: agent plate schema gate without N× HASP / NEEDP soup.
#
#   DEFAULT NEED_KEYS = "n\nok\nrole"           # all-of (HASPALL / NEEDP)
#   DEFAULT NEED_KEY_ANY = "status\nready"      # any-of (HASPANY / NEEDPANY)
#   DEFAULT PLATE_GUARD_SOFT = 0                # 1 → soft (OK=0, no fatal)
#   INCLUDE plate_guard
#   # PLATE_GUARD_OK · KEYMISS / KEYHAVE bags (soft)
#
# Empty NEED_KEYS skips ALL gate. Empty NEED_KEY_ANY skips ANY gate.
# Soft dual leaves KEYMISS / KEYHAVE bags for agents (CLEAR_ERR after).
# Operates on PLATE var (set via plate_boot / plate_session / LET PLATE).
# Twin of form_guard / obj_guard / path_guard for plates.
# Hard ALL: NEEDP · Hard ANY: NEEDPANY · Soft: HASPALL / HASPANY.
# HOLD_FLASH not required (same policy as path_guard / form_guard).

DEFAULT NEED_KEYS = ""
DEFAULT NEED_KEY_ANY = ""
DEFAULT PLATE_GUARD_SOFT = 0

# --- ALL-of: every key must be present on PLATE ---
SYS EMPTY NEED_KEYS
IF LAST_N == 1
  LET PLATE_GUARD_ALL_OK = 1
  LET KEYMISS = ""
  LET KEYHAVE = ""
  LET KEYMISS_N = 0
  LET KEYHAVE_N = 0
ELSE
  IF PLATE_GUARD_SOFT
    HASPALL NEED_KEYS
    LET PLATE_GUARD_ALL_OK = LAST_N
    IF LAST_N == 1
      LET KEYHAVE = NEED_KEYS
      LET KEYMISS = ""
      LET KEYMISS_N = 0
      LET KEYHAVE_N = HASPALL_HIT
    ELSE
      # HASPALL_MISS bag when miss
      LET KEYMISS = HASPALL_MISS
      LET KEYMISS_N = HASPALL_MISS_N
      LET KEYHAVE = ""
      LET KEYHAVE_N = 0
      LET OK = 0
      LET LAST_ERR = "PLATE_GUARD ALL miss — missing: " + KEYMISS
      LET ERR = LAST_ERR
    END
  ELSE
    NEEDP NEED_KEYS
    LET PLATE_GUARD_ALL_OK = 1
    LET KEYMISS = ""
    LET KEYMISS_N = 0
    LET KEYHAVE = NEED_KEYS
  END
END

# --- ANY-of: at least one key must be present ---
SYS EMPTY NEED_KEY_ANY
IF LAST_N == 1
  LET PLATE_GUARD_ANY_OK = 1
ELSE
  IF PLATE_GUARD_SOFT
    HASPANY NEED_KEY_ANY
    LET PLATE_GUARD_ANY_OK = LAST_N
    # KEYHAVE / KEYMISS / KEYHAVE_N / KEYMISS_N from HASPANY
  ELSE
    NEEDPANY NEED_KEY_ANY
    LET PLATE_GUARD_ANY_OK = 1
  END
END

# overall soft status (hard paths already failed fatally if miss)
IF PLATE_GUARD_ALL_OK
  IF PLATE_GUARD_ANY_OK
    LET PLATE_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET PLATE_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET PLATE_GUARD_OK = 0
  LET OK = 0
END
