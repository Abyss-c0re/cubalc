# INCLUDE plate_guard — fail-fast PLATE key contract (ALL + optional ANY)
# Usability: agent plate schema gate without N× HASP / NEEDP / REQUIRE JSONHASALL glue.
#
#   DEFAULT NEED_KEYS = "n\nok\nrole"           # all-of (HASPALL / NEEDP)
#   DEFAULT NEED_KEY_ANY = "status\nready"      # any-of
#   DEFAULT PLATE_GUARD_SOFT = 0                # 1 → soft (OK=0, no fatal)
#   INCLUDE plate_guard
#   # PLATE_GUARD_OK · KEYMISS / KEYHAVE bags (soft)
#
# Empty NEED_KEYS skips ALL gate. Empty NEED_KEY_ANY skips ANY gate.
# Soft dual leaves KEYMISS / KEYHAVE bags for agents (CLEAR_ERR after).
# Operates on PLATE var (set via plate_boot / plate_session / LET PLATE).
# Twin of path_guard (fs) / bin_guard (PATH tools) / lib_guard (modules) for plates.
# HOLD_FLASH not required (same policy as path_guard / form_guard).

DEFAULT NEED_KEYS = ""
DEFAULT NEED_KEY_ANY = ""
DEFAULT PLATE_GUARD_SOFT = 0

# --- ALL-of: every key must be present on PLATE ---
SYS EMPTY NEED_KEYS
IF LAST_N == 1
  LET PLATE_GUARD_ALL_OK = 1
  LET KEYMISS = ""
  LET KEYHAVE = ""
  LET KEYMISS_N = 0
  LET KEYHAVE_N = 0
ELSE
  LET KEYMISS = ""
  LET KEYHAVE = ""
  LET KEYMISS_N = 0
  LET KEYHAVE_N = 0
  IF PLATE_GUARD_SOFT
    EACH LINE k IN NEED_KEYS
      HASP k
      IF LAST_N == 1
        LET KEYHAVE_N = KEYHAVE_N + 1
        IF KEYHAVE == ""
          LET KEYHAVE = k
        ELSE
          LET KEYHAVE = KEYHAVE + "\n" + k
        END
      ELSE
        LET KEYMISS_N = KEYMISS_N + 1
        IF KEYMISS == ""
          LET KEYMISS = k
        ELSE
          LET KEYMISS = KEYMISS + "\n" + k
        END
      END
    END
    IF KEYMISS_N == 0
      LET PLATE_GUARD_ALL_OK = 1
      LET OK = 1
    ELSE
      LET PLATE_GUARD_ALL_OK = 0
      LET OK = 0
      LET LAST_ERR = "PLATE_GUARD ALL miss — missing: " + KEYMISS
      LET ERR = LAST_ERR
    END
  ELSE
    EACH LINE k IN NEED_KEYS
      NEEDP k
    END
    LET PLATE_GUARD_ALL_OK = 1
  END
END

# --- ANY-of: at least one key must be present ---
SYS EMPTY NEED_KEY_ANY
IF LAST_N == 1
  LET PLATE_GUARD_ANY_OK = 1
ELSE
  LET KEY_ANY_HIT = 0
  LET KEY_ANY_HAVE = ""
  LET KEY_ANY_MISS = ""
  EACH LINE k IN NEED_KEY_ANY
    HASP k
    IF LAST_N == 1
      LET KEY_ANY_HIT = 1
      IF KEY_ANY_HAVE == ""
        LET KEY_ANY_HAVE = k
      ELSE
        LET KEY_ANY_HAVE = KEY_ANY_HAVE + "\n" + k
      END
    ELSE
      IF KEY_ANY_MISS == ""
        LET KEY_ANY_MISS = k
      ELSE
        LET KEY_ANY_MISS = KEY_ANY_MISS + "\n" + k
      END
    END
  END
  IF KEY_ANY_HIT == 1
    LET PLATE_GUARD_ANY_OK = 1
    IF KEYHAVE == ""
      LET KEYHAVE = KEY_ANY_HAVE
    END
  ELSE
    LET PLATE_GUARD_ANY_OK = 0
    IF PLATE_GUARD_SOFT
      LET OK = 0
      IF KEYMISS == ""
        LET KEYMISS = KEY_ANY_MISS
      END
      LET LAST_ERR = "PLATE_GUARD ANY miss — need one of: " + NEED_KEY_ANY
      LET ERR = LAST_ERR
    ELSE
      FAIL "PLATE_GUARD ANY miss — need one of: " + NEED_KEY_ANY
    END
  END
END

# overall soft status (hard paths already failed fatally if miss)
IF PLATE_GUARD_ALL_OK
  IF PLATE_GUARD_ANY_OK
    LET PLATE_GUARD_OK = 1
    LET OK = 1
  ELSE
    LET PLATE_GUARD_OK = 0
    LET OK = 0
  END
ELSE
  LET PLATE_GUARD_OK = 0
  LET OK = 0
END
