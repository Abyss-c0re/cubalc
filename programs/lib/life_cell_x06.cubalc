# life_cell_x06.cubalc — EXTEND Cell pack 6

EXTEND CLASS Cell
  METHOD cyp7a1 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END

  # Cyp8b1: sterol 12-alpha-hydroxylase CA-branch enzyme after CYP7A1.
  # CYP8B1 is the hepatic cytochrome P450 that 12-alpha-hydroxylates the
  # classic bile-acid intermediate after CYP7A1 opens the free-energy gate -
  # it sets the cholic-acid versus chenodeoxycholic-acid ratio under ASSERT.
  # After Cyp7a1 supplies the rate-limiting 7-alpha-hydroxylase, Cyp8b1 is
  # the branch plate so mitosis energy budgets gain an explicit CA-route
  # monooxygenase instead of a silent CYP7A1 product with no 12-alpha limb.
  # Distinct from Cyp7a1 (7-alpha hydroxylase), Shp (NR0B2 repressor), Klb,
  # Fgfr4, Fgf19, Fxr, Fabp6, Bsep - Cyp8b1 is the sterol 12-alpha-hydroxylase
  # of classic CA synthesis.
  # Without Cyp8b1 after Cyp7a1, classic BA free-energy flow stalls at 7-alpha
  # product without CA-branch catalytic close; life_cell gut-liver loop loses
  # the CA/CDCA ratio decision plate.
  # Domain: post-CYP7A1 hepatic CYP8B1 sterol 12-alpha-hydroxylase / CA-branch gate
  #   -> CYP8B1 free-energy (ATP stand-in for monooxygenase turnover)
  # (not Cyp7a1, not Shp, not Klb, not Fgfr4, not Fgf19, not Fxr, not Bsep).
  # Continuum: ...->fgfr4->klb->shp->cyp7a1->cyp8b1
  #   (CYP7A1 7-alpha hydroxylase -> CYP8B1 12-alpha CA-branch gut-liver close).
  # Gift: post-CYP7A1 CYP8B1 so classic BA free-energy path can choose the
  #   cholic-acid branch under ASSERT.
  # Signature: heat+n atp-n energy-n; age+pcr+reserve+pmf+sp+thr held - cyp8b1 life-force.
  # Usability: AGI models post-CYP7A1 hepatic CYP8B1 under ASSERT.
  # Cube is SoT. Free energy must flow. Returns take; else 0.
  METHOD cyp8b1 n
    GETF THIS alive
    IF LAST_N == 0 THEN
      RET 0
    END
    IF n < 1 THEN
      RET 0
    END
    GETF THIS atp
    LET a = LAST_N
    IF a < 0 THEN
      LET a = 0
    END
    GETF THIS energy
    LET e = LAST_N
    IF e < 0 THEN
      LET e = 0
    END
    LET take = n
    IF take > a THEN
      LET take = a
    END
    IF take > e THEN
      LET take = e
    END
    IF take < 1 THEN
      RET 0
    END
    LET a = a - take
    SETF THIS atp a
    LET e = e - take
    SETF THIS energy e
    GETF THIS heat
    LET h = LAST_N + take
    SETF THIS heat h
    GETF THIS quiescent
    IF LAST_N == 1 THEN
      SETF THIS ready 0
      RET take
    END
    GETF THIS threshold
    LET thr = LAST_N
    IF thr < 0 THEN
      LET thr = 0
    END
    LET rd = 0
    IF e >= thr THEN
      LET rd = 1
    END
    SETF THIS ready rd
    RET take
  END


  # Hsd3b7: 3beta-hydroxy-Delta5-C27-steroid dehydrogenase after CYP8B1 CA-branch gate.
