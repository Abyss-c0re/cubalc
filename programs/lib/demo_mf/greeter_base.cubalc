# multi-file unit 1/3 — base Greeter CLASS
CLASS Greeter
  FIELD name "world"
  FIELD hits 0
  FIELD tag "ok"
  METHOD init n
    SETF THIS name n
    SETF THIS hits 0
  END
  METHOD hi
    GETF THIS name
    RET LAST
  END
  METHOD bump
    GETF THIS hits
    LET c = LAST_N + 1
    SETF THIS hits c
    RET c
  END
END
