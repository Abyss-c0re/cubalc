# Foundations 00 — Logic, measurement, pure science plane
# Original CubalC school content (public-domain science)
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=science | domain=foundations | hold_flash=1 |"

# Measurement scales exist (integer CubalC)
ASSERT PI100 == 314
ASSERT G_EARTH == 98
ASSERT WATER_K == 273
ASSERT H2O_BP == 100
ASSERT CELSIUS_K(0) == 273
ASSERT KELVIN_C(373) == 100

# Logic: identity, non-contradiction via ASSERT
LET true = 1
LET false = 0
ASSERT true == 1
ASSERT false == 0
ASSERT true != false
ASSERT ABS(-7) == 7
ASSERT MIN(3,9) == 3
ASSERT MAX(3,9) == 9

# Cubechain is the universe of discourse
CUBE lab ROLE school PROTON 1
CUBE meter ROLE measure PROTON 1
PLUG lab meter
IMPULSE lab 1
FLOW 2
ASSERT CUBES == 2
ASSERT FLOWED(lab) == 1

PRINT "foundations00" PI100 G_EARTH CUBES
