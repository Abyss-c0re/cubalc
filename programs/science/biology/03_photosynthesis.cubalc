# Biology 03 — Photosynthesis balance 6CO2 + 6H2O → C6H12O6 + 6O2
HOLD_FLASH 1
SCIENCE LOAD

LET CO2 = 6
LET H2O = 6
LET sugar_C = 6
LET sugar_H = 12
LET sugar_O = 6
LET O2 = 6
# atom balance C
ASSERT CO2 == sugar_C
# H
ASSERT H2O * 2 == sugar_H
# O: 6*2 + 6 = 18 ; sugar 6 + O2*2 = 6+12 = 18
ASSERT CO2 * 2 + H2O == sugar_O + O2 * 2

CUBE leaf ROLE organ PROTON 1
CUBE sun ROLE energy PROTON 1
PLUG sun leaf
FLOW 2

PRINT "bio03_photo" CO2 O2
