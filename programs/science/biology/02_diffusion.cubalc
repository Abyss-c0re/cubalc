# Biology 02 — Diffusion / osmosis as FLOW along plugs
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=science | domain=diffuse |"

CUBE high ROLE conc PROTON 1
CUBE low ROLE conc PROTON 0
FOLDBITS high "1111111111111111000000000000000011111111111111110000000000000000"
FOLDBITS low  "1111111111111111000000000000000011111111111111110000000000000000"
PLUG high low
IMPULSE high 1
FLOW 6
ASSERT FLOWED(low) == 1
# net energy moves toward equilibrium metaphor
ASSERT ENERGY(low) >= 0

PRINT "bio02_diffusion" ENERGY(high) ENERGY(low)
