// atomic_printer_life_prime.cubalc
// Science board: atomic printer + life_cell prime ATP lowers mitosis thr (CDK priming).
// Distinct from ease refold catalyze set_threshold. Yield sheds ATP. ready recomputes.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_prime | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 10 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"

GETF seed energy
ASSERT LAST_N == 10 "seed e 10"
GETF seed threshold
ASSERT LAST_N == 10 "thr 10"
// init may leave ready 0 until tick/feed; force gate state via charge
SEND seed charge 5
ASSERT LAST_N == 5 "charge 5"
GETF seed energy
ASSERT LAST_N == 5 "e 5"
GETF seed ready
ASSERT LAST_N == 0 "not ready e5 < thr10"
SEND seed charged
ASSERT LAST_N == 5 "atp 5"
SEND seed yield
LET y0 = LAST_N
SEND seed prime 5
ASSERT LAST_N == 5 "prime 5"
SEND seed charged
ASSERT LAST_N == 0 "atp 0"
GETF seed threshold
ASSERT LAST_N == 5 "thr 5"
GETF seed ready
ASSERT LAST_N == 1 "ready e5 >= thr5"
SEND seed yield
ASSERT LAST_N == y0 - 5 "yield sheds ATP"
GETF seed energy
ASSERT LAST_N == 5 "energy untouched"
SEND seed warmth
ASSERT LAST_N == 0 "heat empty not ease"
GETF seed age
ASSERT LAST_N == 0 "age empty not refold"
SEND seed stores
ASSERT LAST_N == 0 "stores empty"
SEND seed gradient
ASSERT LAST_N == 0 "pmf empty"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr empty"

SEND seed feed 8
SEND seed charge 8
ASSERT LAST_N == 8 "charge 8"
GETF seed threshold
ASSERT LAST_N == 5 "thr still 5"
SEND seed prime 100
ASSERT LAST_N == 4 "prime capped by thr room"
GETF seed threshold
ASSERT LAST_N == 1 "thr floor 1"
SEND seed charged
ASSERT LAST_N == 4 "atp leftover 4"
GETF seed ready
ASSERT LAST_N == 1 "ready held"

PRINT "2063_atomic_printer_life_prime PASS"
