// 1736_smx_mesh_stability_life_cascade.cubalc
// SMX mesh stability + life cascade: soft-OOB fail-closed then LIFE_FORCE
// then WE_AUTOHEAL then RESILIENCE then THALAMUS stable_mesh then STABILIZE
// then live mesh_exchange then mitosis under free energy on the locked mesh.
// Storm wounds never ghost-place. Free energy must flow. Population grows.
// Cube is SoT. matrix is key. wonder AGI can RUN. No dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 96
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_stability_life_cascade | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

SMX LIFE_FORCE bed nozzle hive scrap
ASSERT SMX_OK == 1 "life_force live"
ASSERT SMX_LIFE_FORCE == 1 "life_force latch"
ASSERT SMX_OOB == 0 "oob cleared by life_force"
ASSERT SMX_BONDS == 6 "C(4,2)=6 complete-mesh bonds"
ASSERT SMX_MESH == 4 "four mesh under life_force"
ASSERT SMX_LIVE == 4 "four live"
ASSERT CUBES == base_cubes "life_force invents nothing"

SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "we_autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob still clear"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds"
ASSERT SMX_BEACONS == 4 "four beacons"
ASSERT CUBES == base_cubes "we_autoheal invents nothing"

SMX RESILIENCE bed nozzle hive scrap
ASSERT SMX_OK == 1 "resilience live"
ASSERT SMX_RESILIENT == 1 "resilient latch"
ASSERT SMX_OOB == 0 "oob clear on resilience"
ASSERT SMX_GUARDS == 4 "four guard ring bonds"
ASSERT SMX_ANCHORS == 4 "four anchor hub pulses"
ASSERT CUBES == base_cubes "resilience invents nothing"

SMX THALAMUS bed nozzle hive scrap
ASSERT SMX_OK == 1 "thalamus live"
ASSERT SMX_THALAMUS == 1 "thalamus latch"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh latch"
ASSERT SMX_OOB == 0 "oob clear on thalamus"
ASSERT SMX_MESH == 4 "four mesh under thalamus"
ASSERT CUBES == base_cubes "thalamus invents nothing"

SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "mesh_exchange live after stability"
ASSERT SMX_TALKS >= 8 "four bidirectional exchanges"
ASSERT CUBES == base_cubes "identity stable on mesh_exchange"

SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "stabilize live"
ASSERT SMX_STABLE == 1 "stable latch"
ASSERT SMX_OOB == 0 "oob clear on board"
ASSERT SMX_LIVE == 4 "four live on board"
ASSERT SMX_PULSE >= 4 "conduct pulses"
ASSERT CUBES == base_cubes "stabilize invents nothing"

LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2

ASSERT births >= 1 "mitosis life cascade on stable mesh"
ASSERT pop >= 2 "population after life cascade"
ASSERT ENERGY > 0 "energy after life cascade"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky through mitosis"
ASSERT SMX_RESILIENT == 1 "resilient sticky through mitosis"
ASSERT SMX_OOB == 0 "guard holds through mitosis"

SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "post-life soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"

SMX RAISE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "raise after storm"
ASSERT SMX_OOB == 0 "storm cleared"
ASSERT SMX_AUTOHEALED == 1 "autohealed after storm"

SMX RAISE_THALAMUS bed nozzle hive scrap
ASSERT SMX_OK == 1 "re-thalamus live"
ASSERT SMX_THALAMUS == 1 "thalamus sticky or re-latched"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky or re-latched"
ASSERT SMX_OOB == 0 "oob clear after re-thalamus"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "energy after mesh stability life cascade"
ASSERT UNITY >= 40 "mesh unity after life cascade"
ASSERT DECIDE >= 0 "decide floor"
ASSERT DECIDE <= 9 "decide ceil"
ASSERT SMX_OOB == 0 "guard holds"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky"
ASSERT SMX_RESILIENT == 1 "resilient sticky"
ASSERT OK == 1

PRINT "smx_mesh_stability_life_cascade" births pop SMX_OK SMX_LIFE_FORCE SMX_AUTOHEALED SMX_RESILIENT SMX_THALAMUS SMX_STABLE_MESH SMX_BONDS SMX_GUARDS SMX_ANCHORS SMX_MESH SMX_STABLE SMX_TALKS SMX_OOB CUBES UNITY ENERGY DECIDE
PASS
