// atomic_printer_life_capture.cubalc
// Science board: atomic printer + life_cell capture (heat→ATP salvage).
// Distinct from thaw (→energy) and reclaim (→reserve). Yield restored to ATP.
// energy/reserve/pmf/pcr/ready untouched. Cube is SoT.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_capture | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 10 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"

// life_cell capture science: shiver → capture banks free energy as ATP
GETF seed energy
ASSERT LAST_N == 10 "seed e 10"
SEND seed shiver 5
ASSERT LAST_N == 5 "shiver 5"
SEND seed warmth
ASSERT LAST_N == 5 "warmth 5"
SEND seed yield
ASSERT LAST_N == 5 "yield shed"
SEND seed capture 5
ASSERT LAST_N == 5 "capture 5"
SEND seed warmth
ASSERT LAST_N == 0 "warmth 0"
GETF seed energy
ASSERT LAST_N == 5 "e held 5 (not thaw)"
SEND seed charged
ASSERT LAST_N == 5 "atp 5"
SEND seed stores
ASSERT LAST_N == 0 "stores empty (not reclaim)"
SEND seed yield
ASSERT LAST_N == 10 "yield conserved via atp"

// partial capture then cool rest (spark-safe: e=5 ⇒ max shiver 4)
SEND seed shiver 6
ASSERT LAST_N == 4 "shiver 4 (spark-safe)"
SEND seed capture 2
ASSERT LAST_N == 2 "capture 2"
SEND seed charged
ASSERT LAST_N == 7 "atp 7"
SEND seed warmth
ASSERT LAST_N == 2 "warmth 2"
SEND seed cool 2
ASSERT LAST_N == 2 "cool rest (lost)"
SEND seed warmth
ASSERT LAST_N == 0 "warmth empty"

// uncouple → capture recovers to ATP not pmf
// e=1 atp=7; feed then pump
SEND seed feed 9
ASSERT LAST_N == 10 "fed 10"
SEND seed pump 3
ASSERT LAST_N == 3 "pump 3"
// e=7 pmf=3 atp=7
SEND seed uncouple 2
ASSERT LAST_N == 2 "uncouple 2"
SEND seed capture 2
ASSERT LAST_N == 2 "capture uncouple"
SEND seed gradient
ASSERT LAST_N == 1 "pmf held"
SEND seed charged
ASSERT LAST_N == 9 "atp 9"
SEND seed warmth
ASSERT LAST_N == 0 "warmth 0"

// dead isolation
SEND d1 capture 4
ASSERT LAST_N == 0 "dead 0"

// spend captured work currency
SEND seed spend 3
ASSERT LAST_N == 3 "spend 3"
SEND seed charged
ASSERT LAST_N == 6 "atp 6 after spend"

// printer mesh still live
IMPULSE hive 1
ASSERT 1 == 1 "atomic_printer_life_capture PASS"
