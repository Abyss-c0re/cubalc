// atomic_printer_life_reclaim.cubalc
// Science board: atomic printer + life_cell reclaim (heat→reserve salvage).
// Distinct from thaw (→energy) and cool (leaves). Yield restored to stores.
// energy/atp/pmf/pcr/ready untouched. Cube is SoT.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_reclaim | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 10 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"

// life_cell reclaim science: shiver → reclaim banks free energy as reserve
GETF seed energy
ASSERT LAST_N == 10 "seed e 10"
SEND seed shiver 5
ASSERT LAST_N == 5 "shiver 5"
SEND seed warmth
ASSERT LAST_N == 5 "warmth 5"
SEND seed yield
ASSERT LAST_N == 5 "yield shed"
SEND seed reclaim 5
ASSERT LAST_N == 5 "reclaim 5"
SEND seed warmth
ASSERT LAST_N == 0 "warmth 0"
GETF seed energy
ASSERT LAST_N == 5 "e held 5 (not thaw)"
SEND seed stores
ASSERT LAST_N == 5 "stores 5"
SEND seed yield
ASSERT LAST_N == 10 "yield conserved via reserve"

// partial reclaim then cool rest (spark-safe: e=5 ⇒ max shiver 4)
SEND seed shiver 6
ASSERT LAST_N == 4 "shiver 4 (spark-safe)"
SEND seed reclaim 2
ASSERT LAST_N == 2 "reclaim 2"
SEND seed stores
ASSERT LAST_N == 7 "stores 7"
SEND seed warmth
ASSERT LAST_N == 2 "warmth 2"
SEND seed cool 2
ASSERT LAST_N == 2 "cool rest (lost)"
SEND seed warmth
ASSERT LAST_N == 0 "warmth empty"

// futile → reclaim recovers to reserve not ATP
// e=1 stores=7; feed then charge
SEND seed feed 9
ASSERT LAST_N == 10 "fed 10"
SEND seed charge 3
ASSERT LAST_N == 3 "charge 3"
// e=7 atp=3 stores=7
SEND seed futile 2
ASSERT LAST_N == 2 "futile 2"
SEND seed reclaim 2
ASSERT LAST_N == 2 "reclaim futile"
SEND seed charged
ASSERT LAST_N == 1 "atp held"
SEND seed stores
ASSERT LAST_N == 9 "stores 9"
SEND seed warmth
ASSERT LAST_N == 0 "warmth 0"

// dead isolation
SEND d1 reclaim 4
ASSERT LAST_N == 0 "dead 0"

// printer mesh still live
IMPULSE hive 1
ASSERT 1 == 1 "atomic_printer_life_reclaim PASS"
