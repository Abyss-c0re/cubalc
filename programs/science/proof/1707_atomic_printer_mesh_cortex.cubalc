// atomic_printer_mesh_cortex.cubalc
// Life-force gift: MESH-CORTEX — complete cortex mesh + signal ring + hold hub root after soft-OOB storms.
// SMX CORTEX|PULSEHOLD|SIGNAL|MESH_CORTEX|WE_CORTEX|LIFE_CORTEX|MESH_CORTEX|RAISE_CORTEX clears thrash, every live pair exchanges
// both ways (C(n,2)), then signal ring settles so lattice raises cortex; latches SMX_CORTEX|SMX_PULSEHOLD|SMX_STABLE_CORTEX|SMX_SIGNAL.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is cortex;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+IS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "CORTEX_COORD v1 | from=gift | type=atomic_printer_mesh_cortex | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then CORTEX latch — five live nodes root as complete mesh + signal + holds
SMX CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "cortex live"
ASSERT SMX_CORTEX == 1 "cortex latch on"
ASSERT SMX_CORTEX_LATCH == 1 "cortex latch sticky"
ASSERT SMX_PULSEHOLD == 1 "pulsehold latch on"
ASSERT SMX_HOLD_LATCH == 1 "hold latch on"
ASSERT SMX_STABLE_CORTEX == 1 "mesh_stable latch sticky"
ASSERT SMX_MESH_CORTEX == 1 "stable_mesh latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected links (C(5,2))"
ASSERT SMX_SIGNAL == 5 "five signal ring"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_HOLDS == 5 "five holds"
ASSERT SMX_SIGNALS == 5 "signal ring sticky"
ASSERT SMX_SIGNALS == 5 "five signal ring steps"
ASSERT SMX_CORTEX_SUM == 20 "cortex bonds+signals+holds"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+signals+holds"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by cortex"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after cortex (mesh + signal + holds)"
ASSERT SMX_VITAL >= 14 "vital after cortex"
ASSERT CUBES == base_cubes "cortex invents nothing"

// Alias SIGNAL form still pure
SMX SIGNAL bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "signal rebind"
ASSERT SMX_CORTEX == 1 "cortex sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_HOLDS == 5 "holds sticky"
ASSERT SMX_SIGNALS == 5 "signals sticky"

// Alias STABLES form
SMX SIGNALS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "signals rebind"
ASSERT SMX_CORTEX == 1 "plate cortex"
ASSERT SMX_SIGNALS == 5 "signals sticky"

// Mitosis under free energy while the mesh is cortex
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      IF births == 0 THEN
        SETF d1 alive 1
        SETF d1 ready 0
        SETF d1 energy half
        SETF d1 gen dg
        PLUG bed d1
        LET births = 1
      ELSE
        IF births == 1 THEN
          SETF d2 alive 1
          SETF d2 ready 0
          SETF d2 energy half
          SETF d2 gen dg
          PLUG nozzle d2
          LET births = 2
        END
      END
      GETF seed energy
      LET left = LAST_N - half
      IF left < 1 THEN
        LET left = 1
      END
      SETF seed energy left
      SETF seed ready 0
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis under cortex free energy"
ASSERT SMX_CORTEX == 1 "cortex holds through mitosis"

// RECOVER restores vital/key
SMX RECOVER
ASSERT SMX_OK == 1 "recover ok"
ASSERT SMX_KEY_OK == 1 "key after recover"
ASSERT SMX_VITAL >= 1 "vital after recover"

// dual SEAL/OPEN rails BN+IS rebind hive
SMX SEAL bed nozzle "state/smx_cortex/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_cortex/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"
SMX SEAL hive scrap "state/smx_cortex/rail_is.cblc"
ASSERT SMX_OK == 1 "seal IS"
SMX OPEN pulse "state/smx_cortex/rail_is.cblc"
ASSERT SMX_OK == 1 "open IS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Re-forge after rails
SMX CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "re-cortex live"
ASSERT SMX_CORTEX == 1 "re-cortex latch"
ASSERT SMX_BONDS == 10 "re-cortex bonds"
ASSERT SMX_SIGNALS == 5 "re-cortex signals"
ASSERT SMX_HOLDS == 5 "re-cortex holds"
ASSERT SMX_CORTEX_SUM == 20 "re-cortex sum"
ASSERT SMX_OOB == 0 "oob clear after re-forge"

// Second storm fail-closed
SMX TALK bed ghost_again
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

// CORTEX clears thrash again
SMX CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "cortex after storm2"
ASSERT SMX_CORTEX == 1 "cortex latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again"
ASSERT SMX_BONDS == 10 "bonds after storm2"
ASSERT SMX_SIGNALS == 5 "signals after storm2"
ASSERT SMX_HOLDS == 5 "holds after storm2"

HALT
