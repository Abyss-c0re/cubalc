// atomic_printer_life_phosphagen.cubalc
// Science board: atomic printer + life_cell phosphagen (ATP <-> PCr creatine kinase).
// Rapid ~P buffer loads from ATP and discharges for burst work / mitosis budgets.
// Gift: CubalC life-force substrate. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_phosphagen | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 4 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"
ASSERT ENERGY > 0 "energy flows"

// Feed -> charge -> charge_pcr -> discharge burst -> oxidize -> mitosis
GETF seed energy
ASSERT LAST_N == 4 "life spark 4"
SEND seed feed 8
ASSERT LAST_N == 12 "fed to 12"
SEND seed charge 6
ASSERT LAST_N == 6 "charge 6"
SEND seed charged
ASSERT LAST_N == 6 "atp 6"
GETF seed energy
ASSERT LAST_N == 6 "active 6"
SEND seed yield
ASSERT LAST_N == 12 "yield conserved"

SEND seed charge_pcr 4
ASSERT LAST_N == 4 "charge_pcr 4"
SEND seed phosphagen
ASSERT LAST_N == 4 "pcr 4"
SEND seed charged
ASSERT LAST_N == 2 "atp 2"
SEND seed yield
ASSERT LAST_N == 12 "yield with pcr"

// Burst discharge then oxidize toward threshold
SEND seed discharge 4
ASSERT LAST_N == 4 "discharge 4"
SEND seed charged
ASSERT LAST_N == 6 "atp 6"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr empty"
SEND seed oxidize 4
ASSERT LAST_N == 4 "oxidize 4"
GETF seed energy
ASSERT LAST_N == 10 "active 10"
GETF seed ready
ASSERT LAST_N == 1 "ready at thr"
SEND seed yield
ASSERT LAST_N == 12 "yield 10e+2atp"

// Mitosis on printer bed
GETF seed energy
LET half = LAST_N / 2
IF half < 1 THEN
  LET half = 1
END
SEND seed after_div
ASSERT LAST_N >= 1 "parent halved"
SEND d1 birth half 1
ASSERT LAST_N == 1 "daughter birth"
GETF d1 alive
ASSERT LAST_N == 1 "daughter alive"
GETF d1 gen
ASSERT LAST_N == 1 "daughter gen 1"
GETF seed alive
ASSERT LAST_N == 1 "parent lives"

// Daughter loads phosphagen from solar ATP and bursts back
SEND d1 phosphagen
ASSERT LAST_N == 0 "daughter pcr 0"
SEND d1 charged
ASSERT LAST_N == 0 "daughter atp 0"
SEND d1 photophos 5
ASSERT LAST_N == 5 "daughter solar"
SEND d1 charge_pcr 4
ASSERT LAST_N == 4 "daughter charge_pcr"
SEND d1 phosphagen
ASSERT LAST_N == 4 "daughter pcr 4"
SEND d1 discharge 3
ASSERT LAST_N == 3 "daughter discharge"
SEND d1 charged
ASSERT LAST_N == 4 "daughter atp 5-4+3"
SEND d1 phosphagen
ASSERT LAST_N == 1 "daughter pcr 1"
SEND d1 yield
ASSERT LAST_N == half + 5 "daughter yield + solar"

ASSERT 1 == 1 "atomic_printer_life_phosphagen PASS"
