// 1788_smx_common_bile_duct_soft_oob_smoke.cubalc
// COMMON_BILE_DUCT / CHOLEDOCHUS soft-OOB fail-closed smoke + mesh latch.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD
HOLD_FLASH 1
BUDGET 32
SHARE state_matrix_only
GENESIS "NEXUS_COORD v1 | from=gift | type=smx_common_bile_duct_soft_oob_smoke | hold_flash=1 | creed=life_force |"
CUBE a ROLE host PROTON 1
CUBE b ROLE construct PROTON 1
CUBE c ROLE nanobot PROTON 1
CUBE d ROLE recycle PROTON 1
PLUG a b
PLUG b c
PLUG c d
PLUG d a
IMPULSE a 1
ENERGYFLOW 2
FLOW 1
LET base_cubes = CUBES
SMX KEY
SMX EXCHANGE a ghost_x
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob counted"
ASSERT CUBES == base_cubes "no ghost"
SMX COMMON_BILE_DUCT a b c d
ASSERT SMX_OK == 1 "cbd live"
ASSERT SMX_COMMON_BILE_DUCT == 1 "cbd latch"
ASSERT SMX_CHOLEDOCHUS == 1 "choledochus"
ASSERT SMX_CBD == 1 "cbd"
ASSERT SMX_MESH_COMMON_BILE_DUCT == 1 "mesh"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh"
ASSERT SMX_COMMON_BILE_DUCT_SUM == 14 "sum"
ASSERT SMX_BONDS == 6 "bonds"
ASSERT SMX_WRAPS == 4 "wraps"
ASSERT SMX_SHEATHS == 4 "sheaths"
ASSERT SMX_OOB == 0 "oob clear"
ASSERT CUBES == base_cubes "identity"
SMX CHOLEDOCHUS a b c d
ASSERT SMX_CHOLEDOCHUS == 1 "alias choledochus"
SMX CBD a b c d
ASSERT SMX_CBD == 1 "alias cbd"
ASSERT OK == 1
PRINT "smx_common_bile_duct_soft_oob_smoke" SMX_COMMON_BILE_DUCT SMX_CHOLEDOCHUS SMX_CBD SMX_OOB SMX_BONDS
PASS
