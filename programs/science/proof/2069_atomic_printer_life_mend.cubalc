// atomic_printer_life_mend.cubalc
// Science board: atomic printer + life_cell mend PCr sheds age (phosphagen chaperone).
// Distinct from repair anneal refold brace poise fortify. Yield sheds PCr. thr untouched.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_mend | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 16 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"

GETF seed energy
ASSERT LAST_N == 16 "seed e 16"
GETF seed age
ASSERT LAST_N == 0 "age 0"
SEND seed pulse 7
GETF seed age
ASSERT LAST_N == 7 "aged 7"
SEND seed load 6
ASSERT LAST_N == 6 "load 6"
GETF seed energy
LET e_mid = LAST_N
SEND seed phosphagen
ASSERT LAST_N == 6 "pcr 6"
GETF seed threshold
LET thr0 = LAST_N
SEND seed yield
LET y0 = LAST_N
SEND seed mend 5
ASSERT LAST_N == 5 "mend 5"
SEND seed phosphagen
ASSERT LAST_N == 1 "pcr 1"
GETF seed age
ASSERT LAST_N == 2 "age 2"
GETF seed threshold
ASSERT LAST_N == thr0 "thr untouched"
SEND seed yield
ASSERT LAST_N == y0 - 5 "yield sheds PCr"
GETF seed energy
ASSERT LAST_N == e_mid "energy untouched"
SEND seed charged
ASSERT LAST_N == 0 "atp empty not refold"
SEND seed warmth
ASSERT LAST_N == 0 "heat empty not anneal"
SEND seed stores
ASSERT LAST_N == 0 "stores empty"
SEND seed gradient
ASSERT LAST_N == 0 "pmf empty"

SEND seed feed 20
SEND seed load 4
ASSERT LAST_N == 4 "load 4"
SEND seed pulse 10
GETF seed age
LET amax = LAST_N
ASSERT amax >= 10 "aged more"
SEND seed phosphagen
LET p_before = LAST_N
SEND seed mend 100
ASSERT LAST_N == p_before "mend capped by pcr when pcr < age"
GETF seed age
ASSERT LAST_N == amax - p_before "age reduced by available pcr"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr drained when pcr < age"

SEND d1 mend 3
ASSERT LAST_N == 0 "dead mend 0"

SEND seed vitality
ASSERT LAST_N >= 1 "alive vitality"
SEND seed yield
ASSERT LAST_N >= 1 "yield holds"

PRINT "2069_atomic_printer_life_mend PASS"
