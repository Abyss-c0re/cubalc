// 2038_atomic_printer_life_respire.cubalc — science proof shim
REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY s OF Cell 1 8 0
SEND s bank 5
ASSERT LAST_N == 5 "bank"
SEND s respire 3
ASSERT LAST_N == 3 "respire"
GETF s energy
ASSERT LAST_N == 6 "energy"
SEND s stores
ASSERT LAST_N == 2 "reserve"
SEND s yield
ASSERT LAST_N == 8 "yield"
ASSERT 1 == 1 "science proof respire PASS"
