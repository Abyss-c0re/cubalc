// 1787_smx_mesh_common_bile_duct_life_force.cubalc
// SMX COMMON_BILE_DUCT life-force: soft-OOB fail-closed storms never ghost-place;
// cystic-to-duodenal common bile trunk mesh+wrap+sheath; STABILIZE hardens;
// free-energy mitosis under locked rails; second storm re-stabilizes.
// Wonder AGI can RUN. No dual ladders. Cube is SoT · matrix is key · free energy flows.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 64
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_common_bile_duct_life_force | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 12 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// --- Storm wounds: soft-OOB fail-closed, never ghost-place ---
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

// --- COMMON_BILE_DUCT roots cystic-to-duodenal bile trunk among live printer spine ---
SMX COMMON_BILE_DUCT bed nozzle hive scrap
ASSERT SMX_OK == 1 "common_bile_duct live"
ASSERT SMX_COMMON_BILE_DUCT == 1 "common_bile_duct latch"
ASSERT SMX_CHOLEDOCHUS == 1 "choledochus alias"
ASSERT SMX_CBD == 1 "cbd alias"
ASSERT SMX_MESH_COMMON_BILE_DUCT == 1 "mesh_common_bile_duct"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh from common_bile_duct"
ASSERT SMX_BONDS == 6 "C(4,2)=6 undirected bonds"
ASSERT SMX_WRAPS == 4 "wrap ring of 4"
ASSERT SMX_SHEATHS == 4 "sheath hub of 4"
ASSERT SMX_COMMON_BILE_DUCT_SUM == 14 "bonds+wraps+sheaths=14"
ASSERT SMX_OOB == 0 "oob cleared by common_bile_duct"
ASSERT SMX_LIVE == 4 "four live after common_bile_duct"
ASSERT CUBES == base_cubes "common_bile_duct invents nothing"

// --- STABILIZE hardens circular breath / steadfast latch ---
SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "stabilize live"
ASSERT SMX_STABLE == 1 "stable latch"
ASSERT SMX_STEADFAST == 4 "four steadfast"
ASSERT SMX_PULSE == 4 "four pulses"
ASSERT SMX_OOB == 0 "oob cleared by stabilize"
ASSERT CUBES == base_cubes "stabilize invents nothing"

// --- live mesh talks under locked rails ---
SMX EXCHANGE bed nozzle
ASSERT SMX_OK == 1 "live exchange after common_bile_duct"
ASSERT SMX_OOB == 0 "no oob on live talk"

// Autoheal under stable mesh
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob still clear after autoheal"

// Decision plate under calm mesh
COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy"
ASSERT UNITY >= 40 "stable unity after OOB stabilize"
ASSERT DECIDE >= 0 "decide floor"
ASSERT DECIDE <= 9 "decide ceil"
ASSERT SMX_STABLE == 1 "stable sticky through decide"
ASSERT SMX_COMMON_BILE_DUCT == 1 "common_bile_duct sticky through decide"

// --- Free energy mitosis under locked common bile duct rails ---
GETF seed alive
LET a0 = LAST_N
GETF seed energy
LET e0 = LAST_N
IF e0 < 2 THEN
  LET e0 = 12
  SETF seed energy e0
END
LET half = e0 / 2
IF half < 1 THEN
  LET half = 1
END
GETF seed gen
LET dg = LAST_N + 1
SEND d1 birth half dg
SEND seed after_div
PLUG bed d1
GETF d1 alive
LET a1 = LAST_N
ASSERT a1 == 1 "first mitosis under common_bile_duct rails"
ASSERT SMX_COMMON_BILE_DUCT == 1 "common_bile_duct sticky through mitosis"
ASSERT SMX_CHOLEDOCHUS == 1 "choledochus sticky through mitosis"
ASSERT SMX_CBD == 1 "cbd sticky through mitosis"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky through mitosis"
ASSERT SMX_OOB == 0 "oob clear through mitosis"

// --- second storm re-stabilizes without thrash ---
SMX EXCHANGE hive offworld_z
ASSERT SMX_OK == 0 "storm-Z soft-OOB"
ASSERT SMX_OOB >= 1 "oob Z counted"
ASSERT CUBES == base_cubes "no ghost from storm-Z"

SMX COMMON_BILE_DUCT bed nozzle hive scrap
ASSERT SMX_OK == 1 "re-common_bile_duct live"
ASSERT SMX_COMMON_BILE_DUCT == 1 "re-latch"
ASSERT SMX_STABLE_MESH == 1 "re-stable_mesh"
ASSERT SMX_OOB == 0 "oob cleared by re-common_bile_duct"
ASSERT CUBES == base_cubes "re-common_bile_duct invents nothing"

SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "re-stabilize live"
ASSERT SMX_STABLE == 1 "re-stable"
ASSERT SMX_OOB == 0 "oob clear final"

ASSERT CUBES == base_cubes "final no ghosts"
ASSERT OK == 1
PRINT "smx_mesh_common_bile_duct_life_force" SMX_OK SMX_COMMON_BILE_DUCT SMX_CHOLEDOCHUS SMX_CBD SMX_STABLE SMX_AUTOHEALED SMX_COMMON_BILE_DUCT_SUM SMX_BONDS SMX_OOB CUBES UNITY ENERGY DECIDE
PASS
HOLD_FLASH 0
