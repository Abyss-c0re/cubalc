// atomic_printer_life_ease.cubalc
// Science board: atomic printer + life_cell ease heat→threshold thermal priming.
// Distinct from set_threshold anneal cool thaw reclaim capture harness buffer.
// Yield unchanged. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_ease | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 10 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"

GETF seed energy
ASSERT LAST_N == 10 "seed e 10"
GETF seed threshold
ASSERT LAST_N == 10 "thr 10"
GETF seed ready
ASSERT LAST_N == 0 "not ready yet (init ready 0 until tick/feed/ease)"
SEND seed shiver 5
ASSERT LAST_N == 5 "shiver 5"
GETF seed energy
ASSERT LAST_N == 5 "e 5"
SEND seed warmth
ASSERT LAST_N == 5 "warmth 5"
SEND seed yield
LET y0 = LAST_N
SEND seed ease 5
ASSERT LAST_N == 5 "ease 5"
SEND seed warmth
ASSERT LAST_N == 0 "warmth 0"
GETF seed threshold
ASSERT LAST_N == 5 "thr 5"
GETF seed energy
ASSERT LAST_N == 5 "energy held"
GETF seed ready
ASSERT LAST_N == 1 "ready e5 >= thr5"
SEND seed yield
ASSERT LAST_N == y0 "yield unchanged (heat not in yield)"

SEND seed charged
ASSERT LAST_N == 0 "atp untouched"
SEND seed stores
ASSERT LAST_N == 0 "reserve untouched"
SEND seed gradient
ASSERT LAST_N == 0 "pmf untouched"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr untouched"

// floor path
SEND seed shiver 8
SEND seed ease 100
GETF seed threshold
ASSERT LAST_N == 1 "thr floor 1"
GETF seed ready
ASSERT LAST_N == 1 "ready at floor"

SEND d1 ease 3
ASSERT LAST_N == 0 "dead ease 0"

SEND seed vitality
ASSERT LAST_N >= 1 "alive vitality"
SEND seed yield
ASSERT LAST_N >= 1 "yield holds"
