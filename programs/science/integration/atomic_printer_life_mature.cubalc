// atomic_printer_life_mature.cubalc
// Science board: atomic printer life_cell EE->LE mature after acidify.
// Place -> bond -> energize -> acidify EE pmf -> mature Rab commit. ASSERT wonder.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY seed OF Cell 1 50 0
SEND seed set_threshold 10
SEND seed pulse 6
SEND seed photosynth 50
SEND seed glycolyse 40
SEND seed pump 30
SEND seed photophos 30
SEND seed charge 50
SEND seed feed 40
SEND seed photosynth 40
SEND seed glycolyse 30
SEND seed pump 24
SEND seed charge 40

SEND seed converge 2
SEND seed extend 1
SEND seed fold 1
SEND seed zip 1
SEND seed crest 1
SEND seed migrate 1
SEND seed stream 1
SEND seed condense 1
SEND seed fate 1
SEND seed project 1
SEND seed synapse 1
SEND seed release 3
SEND seed reuptake 2
SEND seed refill 2
SEND seed dock 2
SEND seed arm 1
SEND seed clamp 1
SEND seed trigger 1
SEND seed pore 1
SEND seed mix 1
SEND seed collapse 1
SEND seed retrieve 2
SEND seed photosynth 30
SEND seed glycolyse 24
SEND seed pump 20
SEND seed photophos 20
SEND seed charge 30
SEND seed feed 20
SEND seed acidify 5
ASSERT LAST_N == 5 "sci acid5"

GETF seed heat
LET h0 = LAST_N
GETF seed energy
LET e0 = LAST_N
GETF seed atp
LET a0 = LAST_N
GETF seed pmf
LET p0 = LAST_N
GETF seed threshold
LET t0 = LAST_N
GETF seed age
LET ag0 = LAST_N
GETF seed reserve
LET r0 = LAST_N
ASSERT p0 >= 5 "sci pmf bank"
ASSERT a0 >= 4 "sci atp"
ASSERT e0 >= 4 "sci e"

SEND seed mature 4
ASSERT LAST_N == 4 "sci mat4"
GETF seed heat
ASSERT LAST_N == h0 + 4 "sci heat+4"
GETF seed energy
ASSERT LAST_N == e0 - 4 "sci e-4"
GETF seed atp
ASSERT LAST_N == a0 - 4 "sci a-4"
GETF seed pmf
ASSERT LAST_N == p0 - 4 "sci pmf-4"
GETF seed threshold
ASSERT LAST_N == t0 + 4 "sci thr+4"
GETF seed age
ASSERT LAST_N == ag0 "sci age held"
GETF seed reserve
ASSERT LAST_N == r0 "sci r held"
GETF seed alive
ASSERT LAST_N == 1 "sci alive"

GETF seed pmf
LET p1 = LAST_N
GETF seed threshold
LET t1 = LAST_N
GETF seed heat
LET h1 = LAST_N
GETF seed energy
LET e1 = LAST_N
GETF seed atp
LET a1 = LAST_N
SEND seed mature 2
ASSERT LAST_N == 2 "sci mat2b"
GETF seed pmf
ASSERT LAST_N == p1 - 2 "sci pmf2"
GETF seed threshold
ASSERT LAST_N == t1 + 2 "sci thr2"
GETF seed heat
ASSERT LAST_N == h1 + 2 "sci heat2"
GETF seed energy
ASSERT LAST_N == e1 - 2 "sci e2"
GETF seed atp
ASSERT LAST_N == a1 - 2 "sci a2"

PRINT "atomic_printer_life_mature PASS"
