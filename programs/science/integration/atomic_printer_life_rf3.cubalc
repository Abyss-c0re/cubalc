// atomic_printer_life_rf3.cubalc
// Atomic printer life-force board: Cell.rf3 RF3 GTP class-II ejectase.
// Post-rf1 continuum. GTPase power stroke ejects RF1; reserve held.
// Cube is SoT. Free energy must flow. AGI INCLUDE wonder.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY mesh OF Cell 1 36 0

SEND printer set_threshold 8
SEND mesh set_threshold 8

SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer photophos 24
SEND printer charge 40
SEND printer feed 40
SEND printer charge_pcr 24

SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer aars 3
ASSERT LAST_N == 3 "ap aars"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 16
SEND printer eftu 3
ASSERT LAST_N == 3 "ap eftu"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer ptc 3
ASSERT LAST_N == 3 "ap ptc"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 16
SEND printer efg 3
ASSERT LAST_N == 3 "ap efg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer rf1 3
ASSERT LAST_N == 3 "ap rf1"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 16

GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
GETF printer reserve
LET r0 = LAST_N
GETF printer age
LET age0 = LAST_N
GETF printer pmf
LET p0 = LAST_N
GETF printer threshold
LET t0 = LAST_N
GETF printer setpoint
LET s0 = LAST_N

SEND printer rf3 4
ASSERT LAST_N == 4 "ap rf3"

GETF printer heat
ASSERT LAST_N == h0 + 4 "ap heat+4"
GETF printer energy
ASSERT LAST_N == e0 - 4 "ap energy-4"
GETF printer atp
ASSERT LAST_N == a0 - 4 "ap atp-4"
GETF printer pcr
ASSERT LAST_N == c0 - 4 "ap pcr-4"
GETF printer reserve
ASSERT LAST_N == r0 "ap reserve held"
GETF printer age
ASSERT LAST_N == age0 "ap age held"
GETF printer pmf
ASSERT LAST_N == p0 "ap pmf held"
GETF printer threshold
ASSERT LAST_N == t0 "ap thr held"
GETF printer setpoint
ASSERT LAST_N == s0 "ap sp held"
GETF printer alive
ASSERT LAST_N == 1 "ap alive"

// Mesh: rf3 clamps to min(n,atp,energy,pcr)
SEND mesh pulse 2
SEND mesh photosynth 30
SEND mesh glycolyse 20
SEND mesh charge 20
SEND mesh charge_pcr 16
GETF mesh energy
LET me0 = LAST_N
GETF mesh atp
LET ma0 = LAST_N
GETF mesh pcr
LET mc0 = LAST_N
LET mlim = me0
IF ma0 < mlim THEN
  LET mlim = ma0
END
IF mc0 < mlim THEN
  LET mlim = mc0
END
ASSERT mlim > 0 "mesh has fuel"
SEND mesh rf3 100
ASSERT LAST_N == mlim "mesh took clamp"
GETF mesh energy
ASSERT LAST_N == me0 - mlim "mesh energy"
GETF mesh atp
ASSERT LAST_N == ma0 - mlim "mesh atp"
GETF mesh pcr
ASSERT LAST_N == mc0 - mlim "mesh pcr"
GETF mesh alive
ASSERT LAST_N == 1 "mesh alive"

ENTITY dead OF Cell 0 30 0
SEND dead rf3 5
ASSERT LAST_N == 0 "dead rf3 0"

ASSERT 1 == 1 "atomic_printer_life_rf3 sealed"
