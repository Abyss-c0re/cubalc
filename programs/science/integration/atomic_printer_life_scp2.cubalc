REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_FORCE MI2287 atomic printer: SCP2/SCPx thiolase after HSD17B4.
# Place cells, bond metabolism, energize, then open BA beta-ox tail:
#   amacr -> acox2 -> hsd17b4 -> scp2 (thiolase chain-shortening).
# Wonder: AGI sees ASSERT heat+n atp-n energy-n on scp2 after DBP product.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY printer OF Cell 1 60 0
ENTITY ink OF Cell 1 40 0
ENTITY dead OF Cell 0 10 0

SEND printer set_threshold 8
SEND ink set_threshold 10

# Place + energize founder plate
SEND printer pulse 4
SEND printer photosynth 30
SEND printer glycolyse 24
SEND printer charge 28
SEND printer feed 22
SEND printer photophos 16
GETF printer energy
ASSERT LAST_N >= 20 "printer energy charged"
GETF printer atp
ASSERT LAST_N >= 20 "printer atp charged"

# BA continuum tail open into SCPx
SEND printer amacr 2
ASSERT LAST_N == 2 "printer amacr"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acox2 2
ASSERT LAST_N == 2 "printer acox2"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer hsd17b4 2
ASSERT LAST_N == 2 "printer hsd17b4 DBP"
SEND printer photosynth 14
SEND printer charge 14
SEND printer feed 12
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
SEND printer scp2 3
ASSERT LAST_N == 3 "printer scp2 thiolase 3"
GETF printer heat
ASSERT LAST_N == h0 + 3 "printer scp2 heat+3"
GETF printer energy
ASSERT LAST_N == e0 - 3 "printer scp2 energy-3"
GETF printer atp
ASSERT LAST_N == a0 - 3 "printer scp2 atp-3"
GETF printer alive
ASSERT LAST_N == 1 "printer alive post-scp2"

# Second ink cell: mitosis budget after scp2 draw
SEND ink photosynth 20
SEND ink charge 18
SEND ink feed 16
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink scp2 2
ASSERT LAST_N == 2 "ink scp2 2"
GETF ink heat
ASSERT LAST_N == ih + 2 "ink scp2 h+2"
GETF ink energy
ASSERT LAST_N == ie - 2 "ink scp2 e-2"
GETF ink atp
ASSERT LAST_N == ia - 2 "ink scp2 a-2"

# Corpse cannot thiolyse
SEND dead scp2 3
ASSERT LAST_N == 0 "dead scp2 blocked"
SEND printer scp2 0
ASSERT LAST_N == 0 "printer scp2 n0"

# Clamp: overdraw returns finite take
GETF printer age
LET age0 = LAST_N
SEND printer scp2 100
ASSERT LAST_N >= 0 "printer scp2 clamp"
GETF printer age
ASSERT LAST_N == age0 "printer age held through scp2 clamp"
GETF printer alive
ASSERT LAST_N == 1 "printer alive clamp"

ASSERT 1 == 1 "atomic_printer_life_scp2 PASS"
ASSERT 1 == 1 "LIFE_FORCE SCP2 thiolase board PASS"
