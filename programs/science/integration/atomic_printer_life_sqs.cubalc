REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_FORCE MI2319 atomic printer: SQS after SQS on BA/odd-chain ketogenic limb.
# Place cells, bond metabolism, energize, then open BA beta-ox + propionyl gate:
#   amacr -> acox2 -> hsd17b4 -> scp2 -> acot8 -> pcca -> mcee -> mut -> suclg1 -> sdha -> fh -> mdh -> cs -> aco2 -> idh2 -> ogdh -> scs -> dld -> dlst -> oxct1 -> acat1 -> hmgcs2 -> hmgcl -> bdh1 -> slc16a1 -> slc16a7 -> emb -> aacs -> hmgcs1 -> hmgcr -> mvk -> pmvk -> mvd -> idi1 -> fdps -> sqs -> sqs.
# Wonder: AGI sees ASSERT heat+n atp-n energy-n on sqs after SQS open.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY printer OF Cell 1 60 0
ENTITY ink OF Cell 1 40 0
ENTITY dead OF Cell 0 10 0

SEND printer set_threshold 8
SEND ink set_threshold 10

SEND printer pulse 4
SEND printer photosynth 30
SEND printer glycolyse 24
SEND printer charge 28
SEND printer feed 22
SEND printer photophos 16
GETF printer energy
ASSERT LAST_N >= 20 "printer energy charged"
GETF printer atp
ASSERT LAST_N >= 20 "printer atp charged"

SEND printer amacr 2
ASSERT LAST_N == 2 "printer amacr"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acox2 2
ASSERT LAST_N == 2 "printer acox2"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer hsd17b4 2
ASSERT LAST_N == 2 "printer hsd17b4 DBP"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer scp2 2
ASSERT LAST_N == 2 "printer scp2 synthase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acot8 2
ASSERT LAST_N == 2 "printer acot8 thioesterase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer pcca 2
ASSERT LAST_N == 2 "printer pcca carboxylase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer mcee 2
ASSERT LAST_N == 2 "printer mcee epimerase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer mut 2
ASSERT LAST_N == 2 "printer mut mutase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer suclg1 2
ASSERT LAST_N == 2 "printer suclg1 ligase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer sdha 2
ASSERT LAST_N == 2 "printer sdha Complex-II"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer fh 2
ASSERT LAST_N == 2 "printer fh fumarase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer mdh 2
ASSERT LAST_N == 2 "printer mdh to OAA"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer cs 2
ASSERT LAST_N == 2 "printer cs citrate synthase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer aco2 1
ASSERT LAST_N == 1 "printer aco2 open"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10

SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer ogdh 1
ASSERT LAST_N == 1 "printer ogdh open"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer scs 1
ASSERT LAST_N == 1 "printer scs prior"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer dld 1
ASSERT LAST_N == 1 "printer dld open before sqs"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer dlst 1
ASSERT LAST_N == 1 "printer dlst open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer oxct1 1
ASSERT LAST_N == 1 "printer oxct1 open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer acat1 1
ASSERT LAST_N == 1 "printer acat1 open before sqs"
SEND printer hmgcs2 1
ASSERT LAST_N == 1 "printer hmgcs2 open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer hmgcl 1
ASSERT LAST_N == 1 "printer hmgcl open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer bdh1 1
ASSERT LAST_N == 1 "printer bdh1 open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer slc16a1 1
ASSERT LAST_N == 1 "printer slc16a1 open before sqs"
SEND printer slc16a7 1
ASSERT LAST_N == 1 "printer slc16a7 open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
SEND printer emb 1
ASSERT LAST_N == 1 "printer emb open before sqs"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer aacs 1
ASSERT LAST_N == 1 "printer aacs open before sqs"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer hmgcs1 1
ASSERT LAST_N == 1 "printer hmgcs1 open before sqs"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer hmgcr 1
ASSERT LAST_N == 1 "printer hmgcr open before sqs"
SEND printer photosynth 8
SEND printer charge 8
SEND printer feed 6
SEND printer mvk 1
ASSERT LAST_N == 1 "printer mvk open before sqs"
SEND printer pmvk 1
ASSERT LAST_N == 1 "printer pmvk open before sqs"
SEND printer mvd 1
ASSERT LAST_N == 1 "printer mvd open before sqs"
SEND printer idi1 1
ASSERT LAST_N == 1 "printer idi1 open before sqs"
SEND printer fdps 1
ASSERT LAST_N == 1 "printer fdps open before sqs"
SEND printer photosynth 10
SEND printer charge 10
SEND printer feed 8
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
SEND printer sqs 3
ASSERT LAST_N == 3 "printer sqs import 3"
GETF printer heat
ASSERT LAST_N == h0 + 3 "printer sqs heat+3"
GETF printer energy
ASSERT LAST_N == e0 - 3 "printer sqs energy-3"
GETF printer atp
ASSERT LAST_N == a0 - 3 "printer sqs atp-3"
GETF printer alive
ASSERT LAST_N == 1 "printer alive post-sqs"

SEND ink photosynth 20
SEND ink charge 18
SEND ink feed 16
SEND ink mdh 1
ASSERT LAST_N == 1 "ink mdh open"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink cs 1
ASSERT LAST_N == 1 "ink cs open"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink aco2 1
ASSERT LAST_N == 1 "ink aco2 open"
SEND ink photosynth 12
SEND ink charge 12
SEND ink feed 10
SEND ink idh2 2
ASSERT LAST_N == 2 "ink idh2 isocitrate to aKG"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink ogdh 1
ASSERT LAST_N == 1 "ink ogdh open"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink scs 1
ASSERT LAST_N == 1 "ink scs prior"
