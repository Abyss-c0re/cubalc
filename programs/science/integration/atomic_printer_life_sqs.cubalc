SEND ink charge 10
SEND ink feed 8
SEND ink oxct1 1
ASSERT LAST_N == 1 "ink oxct1 open before sqs"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
SEND ink acat1 1
ASSERT LAST_N == 1 "ink acat1 open before sqs"
SEND ink hmgcs2 1
ASSERT LAST_N == 1 "ink hmgcs2 open before sqs"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
SEND ink hmgcl 1
ASSERT LAST_N == 1 "ink hmgcl open before sqs"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
SEND ink bdh1 1
ASSERT LAST_N == 1 "ink bdh1 open before sqs"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
SEND ink slc16a1 1
ASSERT LAST_N == 1 "ink slc16a1 open before sqs"
SEND ink slc16a7 1
ASSERT LAST_N == 1 "ink slc16a7 open before sqs"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
SEND ink emb 1
ASSERT LAST_N == 1 "ink emb open before sqs"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink aacs 1
ASSERT LAST_N == 1 "ink aacs open before sqs"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink hmgcs1 1
ASSERT LAST_N == 1 "ink hmgcs1 open before sqs"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink hmgcr 1
ASSERT LAST_N == 1 "ink hmgcr open before sqs"
SEND ink photosynth 8
SEND ink charge 8
SEND ink feed 6
SEND ink mvk 1
ASSERT LAST_N == 1 "ink mvk open before sqs"
SEND ink pmvk 1
ASSERT LAST_N == 1 "ink pmvk open before sqs"
SEND ink mvd 1
ASSERT LAST_N == 1 "ink mvd open before sqs"
SEND ink idi1 1
ASSERT LAST_N == 1 "ink idi1 open before sqs"
SEND ink fdps 1
ASSERT LAST_N == 1 "ink fdps open before sqs"
SEND ink photosynth 10
SEND ink charge 10
SEND ink feed 8
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink sqs 2
ASSERT LAST_N == 2 "ink sqs 2"
GETF ink heat
ASSERT LAST_N == ih + 2 "ink sqs heat+2"
GETF ink energy
ASSERT LAST_N == ie - 2 "ink sqs energy-2"
GETF ink atp
ASSERT LAST_N == ia - 2 "ink sqs atp-2"
GETF ink alive
ASSERT LAST_N == 1 "ink alive post-sqs"

SEND dead sqs 3
ASSERT LAST_N == 0 "dead sqs refused"
GETF dead alive
ASSERT LAST_N == 0 "dead stays dead"

ASSERT 1 == 1 "atomic_printer_life_sqs PASS"
