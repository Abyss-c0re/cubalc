// atomic_printer_mesh_stabilize.cubalc
// Life-force gift: MESH-STABILIZE — calm latch after soft-OOB storms.
// SMX STABILIZE|STEADFAST clears thrash, circular breath among live, latches SMX_STABLE. Soft-OOB ghosts stay fail-closed.
// Mitosis under free energy while the mesh holds; RECOVER restores vital/key;
// dual SEAL/OPEN rails rebind hive mind; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_stabilize | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then STABILIZE latch — five live nodes hold as one
SMX STABILIZE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "stabilize live"
ASSERT SMX_STABLE == 1 "stable latch on"
ASSERT SMX_STEADFAST == 5 "five steadfast"
ASSERT SMX_HOLD_MESH == 1 "hold mesh"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_PULSE == 5 "pulse count"
ASSERT SMX_OOB == 0 "oob cleared by stabilize"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 5 "talks after stabilize"
ASSERT SMX_VITAL >= 7 "vital after stabilize"
ASSERT CUBES == base_cubes "stabilize invents nothing"

// Alias STEADFAST form still pure
SMX STEADFAST bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "steadfast rebind"
ASSERT SMX_STABLE == 1 "stable sticky"
ASSERT SMX_BREATH == 5 "steadfast sticky"

// Mitosis under free energy while the mesh holds
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          LET births = births + 1
        END
      END
    END
  END
  SEND seed tick
  SEND d1 tick
  SEND d2 tick
  LET step = step + 1
END

GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = 1
IF a1 == 1 THEN
  LET pop = pop + 1
END
IF a2 == 1 THEN
  LET pop = pop + 1
END
ASSERT births >= 1 "mitosis under stabilize"
ASSERT pop >= 2 "population after stable life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Soft-OOB ghost in stabilize — fail-closed, no thrash place
SMX STABILIZE bed nozzle ghost_stab hive scrap
ASSERT SMX_OOB >= 1 "stab soft-OOB"
ASSERT SMX_BREATH == 4 "four live of five named"
ASSERT SMX_PULSE == 4 "four pulses among live"
ASSERT SMX_STABLE == 1 "partial still stable"
ASSERT CUBES == base_cubes "no ghost from stab"

SMX RECOVER
ASSERT SMX_OK == 1 "recover after stab oob"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital after recover"

// Pure mesh hold after recover
SMX MESH_HOLD bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_hold pure"
ASSERT SMX_STABLE == 1 "stable after recover"
ASSERT SMX_PULSE == 5 "pulses after recover"
ASSERT SMX_BREATH == 5 "breath after recover"
ASSERT CUBES == base_cubes "hold invents nothing"

// Dual SEAL/OPEN rails under stable spine
SMX SEAL bed nozzle "state/smx_stab/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_stab/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_stab/rail_hs.cblc"
ASSERT SMX_OK == 1 "seal rail HS"
SMX OPEN pulse "state/smx_stab/rail_hs.cblc"
ASSERT SMX_OK == 1 "open HS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Final stabilize lock + vitals
SMX STABILIZE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "final stabilize lock"
ASSERT SMX_STABLE == 1 "final stable"
ASSERT SMX_PULSE == 5 "final pulses"
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after stabilize"
ASSERT SMX_KEY_OK == 1 "key after stabilize"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after stabilize"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

// Second storm fail-closed
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"
SMX STABILIZE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "stabilize after storm"
ASSERT SMX_OOB == 0 "storm cleared by stabilize"
ASSERT SMX_BREATH == 5 "stable holds after storm"
ASSERT SMX_STABLE == 1 "stable after storm"
ASSERT SMX_PULSE == 5 "pulses after storm"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after stabilize"
ASSERT UNITY >= 40 "mesh unity after stabilize"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh stabilize"
ASSERT pop >= 2 "population after stable life"
ASSERT SMX_STABLE == 1 "stable latch holds"
ASSERT SMX_BREATH == 5 "five-node steadfast"
ASSERT SMX_OOB == 0 "guard holds through stabilize"
ASSERT OK == 1

PRINT "mesh_stabilize" births pop SMX_STABLE SMX_STEADFAST SMX_PULSE SMX_BREATH SMX_NODES SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES

PASS
