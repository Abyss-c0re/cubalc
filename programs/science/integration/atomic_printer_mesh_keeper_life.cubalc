// atomic_printer_mesh_keeper_life.cubalc
// Life-force gift: MESH-KEEPER-LIFE — complete keeper mesh + watch ring + bastion hub root after soft-OOB storms.
// SMX KEEPER|WARDEN|WATCH|SENTINEL|WE_KEEPER|LIFE_KEEPER|MESH_KEEPER|RAISE_KEEPER clears thrash, every live pair exchanges
// both ways (C(n,2)), then watch ring settles so lattice raises keeper; latches SMX_KEEPER|SMX_WARDEN|SMX_BASTION_LATCH|SMX_WATCH.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is keeper;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+IS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "BASTION_COORD v1 | from=gift | type=atomic_printer_mesh_keeper_life | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then KEEPER latch — five live nodes root as complete mesh + watch + bastions
SMX KEEPER bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "keeper live"
ASSERT SMX_KEEPER == 1 "keeper latch on"
ASSERT SMX_KEEPER_LATCH == 1 "keeper latch sticky"
ASSERT SMX_WARDEN == 1 "warden latch on"
ASSERT SMX_BASTION == 1 "bastion latch on"
ASSERT SMX_BASTION_LATCH == 1 "bastion latch sticky"
ASSERT SMX_SENTINEL == 1 "sentinel latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected links (C(5,2))"
ASSERT SMX_WATCH == 5 "five watch ring"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_BASTIONS == 5 "five bastions"
ASSERT SMX_WATCHES == 5 "watch ring sticky"
ASSERT SMX_WATCHES == 5 "five watch ring steps"
ASSERT SMX_KEEP_SUM == 20 "keeper bonds+watches+bastions"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+watches+bastions"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by keeper"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after keeper (mesh + watch + bastions)"
ASSERT SMX_VITAL >= 14 "vital after keeper"
ASSERT CUBES == base_cubes "keeper invents nothing"

// Alias WATCH form still pure
SMX WATCH bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "temper rebind"
ASSERT SMX_KEEPER == 1 "keeper sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_BASTIONS == 5 "bastions sticky"
ASSERT SMX_WATCHES == 5 "watches sticky"

// Alias WATCHES form
SMX WATCHES bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "watches rebind"
ASSERT SMX_KEEPER == 1 "plate keeper"
ASSERT SMX_WATCHES == 5 "watches sticky"

// Mitosis under free energy while the mesh is keeper
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      IF births == 0 THEN
        SETF d1 alive 1
        SETF d1 ready 0
        SETF d1 energy half
        SETF d1 gen dg
        PLUG bed d1
        LET births = 1
      ELSE
        IF births == 1 THEN
          SETF d2 alive 1
          SETF d2 ready 0
          SETF d2 energy half
          SETF d2 gen dg
          PLUG nozzle d2
          LET births = 2
        END
      END
      GETF seed energy
      LET left = LAST_N - half
      IF left < 1 THEN
        LET left = 1
      END
      SETF seed energy left
      SETF seed ready 0
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis under keeper free energy"
ASSERT SMX_KEEPER == 1 "keeper holds through mitosis"

// RECOVER restores vital/key
SMX RECOVER
ASSERT SMX_OK == 1 "recover ok"
ASSERT SMX_KEY_OK == 1 "key after recover"
ASSERT SMX_VITAL >= 1 "vital after recover"

// dual SEAL/OPEN rails BN+IS rebind hive
SMX SEAL bed nozzle "state/smx_keeper/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_keeper/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"
SMX SEAL hive scrap "state/smx_keeper/rail_is.cblc"
ASSERT SMX_OK == 1 "seal IS"
SMX OPEN pulse "state/smx_keeper/rail_is.cblc"
ASSERT SMX_OK == 1 "open IS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Re-forge after rails
SMX KEEPER bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "re-keeper live"
ASSERT SMX_KEEPER == 1 "re-keeper latch"
ASSERT SMX_BONDS == 10 "re-keeper bonds"
ASSERT SMX_WATCHES == 5 "re-keeper watches"
ASSERT SMX_BASTIONS == 5 "re-keeper bastions"
ASSERT SMX_KEEP_SUM == 20 "re-keeper sum"
ASSERT SMX_OOB == 0 "oob clear after re-forge"

// Second storm fail-closed
SMX TALK bed ghost_again
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

// KEEPER clears thrash again
SMX KEEPER bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "keeper after storm2"
ASSERT SMX_KEEPER == 1 "keeper latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again"
ASSERT SMX_BONDS == 10 "bonds after storm2"
ASSERT SMX_WATCHES == 5 "watches after storm2"
ASSERT SMX_BASTIONS == 5 "bastions after storm2"

HALT
