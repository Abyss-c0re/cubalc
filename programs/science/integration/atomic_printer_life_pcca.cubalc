REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_FORCE MI2289 atomic printer: PCCA after ACOT8 on BA/odd-chain limb.
# Place cells, bond metabolism, energize, then open BA beta-ox + propionyl gate:
#   amacr -> acox2 -> hsd17b4 -> scp2 -> acot8 -> pcca (biotin carboxylase).
# Wonder: AGI sees ASSERT heat+n atp-n energy-n on pcca after thioesterase.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY printer OF Cell 1 60 0
ENTITY ink OF Cell 1 40 0
ENTITY dead OF Cell 0 10 0

SEND printer set_threshold 8
SEND ink set_threshold 10

SEND printer pulse 4
SEND printer photosynth 30
SEND printer glycolyse 24
SEND printer charge 28
SEND printer feed 22
SEND printer photophos 16
GETF printer energy
ASSERT LAST_N >= 20 "printer energy charged"
GETF printer atp
ASSERT LAST_N >= 20 "printer atp charged"

SEND printer amacr 2
ASSERT LAST_N == 2 "printer amacr"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acox2 2
ASSERT LAST_N == 2 "printer acox2"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer hsd17b4 2
ASSERT LAST_N == 2 "printer hsd17b4 DBP"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer scp2 2
ASSERT LAST_N == 2 "printer scp2 thiolase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acot8 2
ASSERT LAST_N == 2 "printer acot8 thioesterase"
SEND printer photosynth 14
SEND printer charge 14
SEND printer feed 12
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
SEND printer pcca 3
ASSERT LAST_N == 3 "printer pcca carboxylase 3"
GETF printer heat
ASSERT LAST_N == h0 + 3 "printer pcca heat+3"
GETF printer energy
ASSERT LAST_N == e0 - 3 "printer pcca energy-3"
GETF printer atp
ASSERT LAST_N == a0 - 3 "printer pcca atp-3"
GETF printer alive
ASSERT LAST_N == 1 "printer alive post-pcca"

SEND ink photosynth 20
SEND ink charge 18
SEND ink feed 16
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink pcca 2
ASSERT LAST_N == 2 "ink pcca 2"
GETF ink heat
ASSERT LAST_N == ih + 2 "ink pcca h+2"
GETF ink energy
ASSERT LAST_N == ie - 2 "ink pcca e-2"
GETF ink atp
ASSERT LAST_N == ia - 2 "ink pcca a-2"
GETF ink alive
ASSERT LAST_N == 1 "ink alive post-pcca"

SEND dead pcca 3
ASSERT LAST_N == 0 "dead pcca 0"
GETF dead alive
ASSERT LAST_N == 0 "dead stays dead"

SEND printer pcca 0
ASSERT LAST_N == 0 "printer pcca n0"

ASSERT 1 == 1 "atomic_printer_life_pcca PASS"
