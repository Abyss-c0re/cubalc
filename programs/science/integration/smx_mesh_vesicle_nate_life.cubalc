REQUIRE VERSION "1.15"
INCLUDE life_cell

# SMX mesh vesicle — NatE/Naa50 life-force seal on Met-hydrophobic stems
# Vesicle-bound NatE after NatC keeps N-end free-energy coherent under mesh exchange.
# Cube is SoT. Free energy must flow.

ENTITY vesicle OF Cell 1 50 0
SEND vesicle set_threshold 9
SEND vesicle pulse 3
SEND vesicle photosynth 36
SEND vesicle glycolyse 30
SEND vesicle charge 34
SEND vesicle feed 28
SEND vesicle pump 20

SEND vesicle pepf 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle pdf 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle map 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 14
SEND vesicle nata 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 14
SEND vesicle natb 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 14
SEND vesicle natc 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 14

GETF vesicle heat
LET h0 = LAST_N
GETF vesicle energy
LET e0 = LAST_N
GETF vesicle atp
LET a0 = LAST_N
GETF vesicle pmf
LET p0 = LAST_N

SEND vesicle nate 3
ASSERT LAST_N == 3 "ves nate3"
GETF vesicle heat
ASSERT LAST_N == h0 + 3 "ves heat+3"
GETF vesicle energy
ASSERT LAST_N == e0 - 3 "ves energy-3"
GETF vesicle atp
ASSERT LAST_N == a0 - 3 "ves atp-3"
GETF vesicle pmf
ASSERT LAST_N == p0 "ves pmf held"
GETF vesicle alive
ASSERT LAST_N == 1 "ves alive"

ASSERT 1 == 1 "smx_mesh_vesicle_nate_life PASS"
