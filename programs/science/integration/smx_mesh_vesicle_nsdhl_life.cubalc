SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle sc4mol 1
ASSERT LAST_N == 1 "vesicle sc4mol open before nsdhl"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
SEND vesicle nsdhl 3
ASSERT LAST_N == 3 "vesicle nsdhl 3"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "vesicle nsdhl heat+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "vesicle nsdhl energy-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "vesicle nsdhl atp-3"
GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive post-nsdhl"

SEND cargo photosynth 18
