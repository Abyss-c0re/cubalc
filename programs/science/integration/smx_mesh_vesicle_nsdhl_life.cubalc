SEND cargo nsdhl 2
ASSERT LAST_N == 2 "cargo nsdhl 2"
GETF cargo heat
ASSERT LAST_N == ch + 2 "cargo nsdhl heat+2"
GETF cargo energy
ASSERT LAST_N == ce - 2 "cargo nsdhl energy-2"
GETF cargo atp
ASSERT LAST_N == ca - 2 "cargo nsdhl atp-2"
