ASSERT LAST_N == 1 "cargo alive post-nsdhl"

SEND lysed nsdhl 3
ASSERT LAST_N == 0 "lysed nsdhl refused"
GETF lysed alive
ASSERT LAST_N == 0 "lysed stays dead"

ASSERT 1 == 1 "smx_mesh_vesicle_nsdhl_life PASS"
