// atomic_printer_mesh_heal.cubalc
// Life-force gift: printer spine survives soft-OOB, RECOVER heals matrix,
// then mitosis prints daughter voxels. Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_heal | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG scrap hive
PLUG bed scrap

ENTITY seed OF Cell 1 10 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY
// Wound: talk to absent peer — fail-closed, no ghost thrash
SMX EXCHANGE hive offworld
ASSERT SMX_OK == 0 "soft-OOB clears ok"
ASSERT SMX_OOB >= 1 "oob counted"
ASSERT CUBES == base_cubes "no ghost from soft-OOB"

// Heal the mind plane
SMX RECOVER
ASSERT SMX_OK == 1 "recovered"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key remains"
ASSERT SMX_VITAL >= 6 "vital restored"

// Live spine after heal
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
ASSERT SMX_OK == 1 "spine mesh live after heal"
ASSERT SMX_TALKS >= 6 "three EXCHANGE rounds"
ASSERT CUBES == base_cubes "identity stable after spine talk"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy"
ASSERT UNITY >= 50 "stable unity after mesh heal"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Mitosis on healed printer bed
LET births = 0
LET step = 0
WHILE step < 8
  TICK 1
  FLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
LET pop = a0 + a1
ASSERT births >= 1 "mitosis after mesh heal"
ASSERT pop >= 2 "population after heal-life"
ASSERT CUBES >= base_cubes "frame + cells"
ASSERT SMX_OOB == 0 "heal sticky through life"
ASSERT OK == 1

PRINT "atomic_printer_mesh_heal" births pop DECIDE HARMONY ENERGY UNITY SMX_OK SMX_TALKS SMX_VITAL base_cubes CUBES
