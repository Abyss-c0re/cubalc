// atomic_printer_life_polar.cubalc
// Science board: apical-basal polarity after barrier seal on atomic printer life path.
// AGI INCLUDE life_cell — continuum cad->bleb->effer->resolve->restit->seal->polar.
// Free energy must flow. Cube is SoT.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY cell OF Cell 1 16 0
ENTITY tissue OF Cell 1 14 0

SEND cell set_threshold 10
SEND tissue set_threshold 10
SEND cell set_setpoint 10
SEND tissue set_setpoint 10

SEND cell pulse 6
SEND cell photosynth 8
SEND cell glycolyse 6
SEND cell pump 5
SEND cell photophos 4
GETF cell atp
ASSERT LAST_N >= 8 "sci atp"
GETF cell age
LET a0 = LAST_N
GETF cell heat
LET h0 = LAST_N
GETF cell energy
LET e0 = LAST_N
GETF cell reserve
LET r0 = LAST_N
GETF cell threshold
LET t0 = LAST_N
GETF cell pmf
LET p0 = LAST_N
GETF cell setpoint
LET s0 = LAST_N
ASSERT s0 == 10 "sci sp10"

SEND cell cad 1
ASSERT LAST_N == 1 "sci cad"
SEND cell bleb 1
ASSERT LAST_N == 1 "sci bleb"
SEND cell effer 1
ASSERT LAST_N == 1 "sci effer"
SEND cell resolve 1
ASSERT LAST_N == 1 "sci resolve"
SEND cell restit 1
ASSERT LAST_N == 1 "sci restit"
SEND cell seal 1
ASSERT LAST_N == 1 "sci seal"
GETF cell threshold
LET t1 = LAST_N
ASSERT t1 == t0 + 1 "sci thr +1 after seal net"
GETF cell setpoint
LET s1 = LAST_N
ASSERT s1 == s0 "sci sp held through seal"
GETF cell age
LET a1 = LAST_N
GETF cell heat
LET h1 = LAST_N
GETF cell energy
LET e1 = LAST_N
GETF cell reserve
LET r1 = LAST_N
GETF cell pmf
LET p1 = LAST_N
GETF cell atp
LET at1 = LAST_N
ASSERT at1 >= 2 "sci atp pre-polar"

SEND cell polar 2
ASSERT LAST_N == 2 "sci polar2"
GETF cell atp
ASSERT LAST_N == at1 - 2 "sci atp-2"
GETF cell heat
ASSERT LAST_N == h1 + 2 "sci heat+2"
GETF cell setpoint
ASSERT LAST_N == s1 + 2 "sci sp+2"
GETF cell threshold
ASSERT LAST_N == t1 "sci thr held"
GETF cell age
ASSERT LAST_N == a1 "sci age held"
GETF cell energy
ASSERT LAST_N == e1 "sci e held"
GETF cell reserve
ASSERT LAST_N == r1 "sci r held"
GETF cell pmf
ASSERT LAST_N == p1 "sci pmf held"
GETF cell alive
ASSERT LAST_N == 1 "sci lives"
SEND cell vitality
ASSERT LAST_N >= 1 "sci vitality"

// Tissue sibling: seal then polar homeostat retune under feast
SEND tissue pulse 4
SEND tissue photosynth 5
SEND tissue glycolyse 4
SEND tissue pump 3
SEND tissue photophos 4
SEND tissue seal 1
SEND tissue polar 3
GETF tissue setpoint
ASSERT LAST_N == 13 "sci tissue sp13"
GETF tissue alive
ASSERT LAST_N == 1 "sci tissue lives"
SEND tissue regulate
GETF tissue energy
LET te = LAST_N
GETF tissue setpoint
LET ts = LAST_N
ASSERT te >= 1 "sci tissue spark"
ASSERT ts == 13 "sci tissue sp stable"
