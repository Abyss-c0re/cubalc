REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_FORCE MI2293 SMX mesh vesicle: SDHA after SUCLG1 on sealed BA limb.
# Vesicle cells exchange free energy under SMX-stable metabolism path:
#   pcca -> mcee -> suclg1 -> sdha opens fumarate ETC entry on the vesicle wall.
# Wonder: ASSERT heat+n atp-n energy-n dehydrogenase after ligase; dead refused.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY vesicle OF Cell 1 55 0
ENTITY cargo OF Cell 1 36 0
ENTITY lysed OF Cell 0 12 0

SEND vesicle set_threshold 9
SEND cargo set_threshold 11

SEND vesicle pulse 3
SEND vesicle photosynth 28
SEND vesicle glycolyse 20
SEND vesicle charge 26
SEND vesicle feed 20
GETF vesicle energy
ASSERT LAST_N >= 16 "vesicle energy"
GETF vesicle atp
ASSERT LAST_N >= 16 "vesicle atp"

SEND vesicle pcca 2
ASSERT LAST_N == 2 "vesicle pcca"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mcee 2
ASSERT LAST_N == 2 "vesicle mcee"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mut 2
ASSERT LAST_N == 2 "vesicle mut"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle suclg1 2
ASSERT LAST_N == 2 "vesicle suclg1"
SEND vesicle photosynth 14
SEND vesicle charge 14
SEND vesicle feed 12
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
SEND vesicle sdha 3
ASSERT LAST_N == 3 "vesicle sdha 3"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "vesicle sdha heat+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "vesicle sdha energy-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "vesicle sdha atp-3"
GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive post-sdha"

SEND cargo photosynth 18
SEND cargo charge 16
SEND cargo feed 14
GETF cargo heat
LET ch = LAST_N
GETF cargo energy
LET ce = LAST_N
GETF cargo atp
LET ca = LAST_N
SEND cargo sdha 2
ASSERT LAST_N == 2 "cargo sdha 2"
GETF cargo heat
ASSERT LAST_N == ch + 2 "cargo sdha heat+2"
GETF cargo energy
ASSERT LAST_N == ce - 2 "cargo sdha energy-2"
GETF cargo atp
ASSERT LAST_N == ca - 2 "cargo sdha atp-2"
GETF cargo alive
ASSERT LAST_N == 1 "cargo alive post-sdha"

SEND lysed sdha 4
ASSERT LAST_N == 0 "lysed sdha refused"
GETF lysed alive
ASSERT LAST_N == 0 "lysed stays dead"

ASSERT 1 == 1 "smx_mesh_vesicle_sdha_life PASS"
