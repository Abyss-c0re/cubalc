// atomic_printer_life_mptp.cubalc
// Science board: mito permeability transition pore (mPTP) on the atomic printer life cell.
// CypD/ANT/VDAC megapore collapses DYm as bulk heat; age +1 injury; energy/atp/reserve held.
// Pathophysiology after Ca2+ continuum: tether -> mcu -> nclx -> overload mptp open.
// Distinct from uncouple (no age) and nclx (+1 heat tax only).
// Cube is SoT. Free energy must flow. AGI INCLUDE life_cell wonder.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 14 0
SEND printer set_threshold 10

SEND printer pulse 6
SEND printer photosynth 7
SEND printer glycolyse 4
SEND printer feed 4
SEND printer pump 6

GETF printer alive
ASSERT LAST_N == 1 "printer lives"
GETF printer age
ASSERT LAST_N == 6 "printer aged"
GETF printer atp
ASSERT LAST_N >= 4 "printer charged"
GETF printer pmf
ASSERT LAST_N == 6 "printer gradient"

GETF printer energy
LET e0 = LAST_N
GETF printer age
LET a0 = LAST_N
GETF printer pmf
LET p0 = LAST_N
GETF printer reserve
LET r0 = LAST_N
GETF printer atp
LET at0 = LAST_N
GETF printer heat
LET h0 = LAST_N

SEND printer tether 2
ASSERT LAST_N == 2 "tether take"
GETF printer energy
ASSERT LAST_N == e0 + 2 "MERCs yield"
GETF printer energy
LET e1 = LAST_N
GETF printer pmf
LET p1 = LAST_N
GETF printer atp
LET at1 = LAST_N

SEND printer mcu 2
ASSERT LAST_N == 2 "mcu take"
GETF printer energy
ASSERT LAST_N == e1 + 2 "TCA spark"
GETF printer pmf
ASSERT LAST_N == p1 - 2 "mcu spends pmf"
GETF printer heat
LET h2 = LAST_N
GETF printer age
LET a2 = LAST_N
GETF printer pmf
LET p2 = LAST_N
GETF printer energy
LET e2 = LAST_N

SEND printer nclx 1
ASSERT LAST_N == 1 "nclx take"
GETF printer heat
ASSERT LAST_N == h2 + 1 "exchanger tax"
GETF printer age
ASSERT LAST_N == a2 "nclx age held"
GETF printer pmf
LET p3 = LAST_N
GETF printer heat
LET h3 = LAST_N

// Overload / failed reset opens mPTP — bulk collapse + injury
SEND printer mptp 3
ASSERT LAST_N == 3 "mptp take"
GETF printer pmf
ASSERT LAST_N == p3 - 3 "mptp collapses pmf"
GETF printer heat
ASSERT LAST_N == h3 + 3 "pore bulk heat"
GETF printer age
ASSERT LAST_N == a2 + 1 "injury mark"
GETF printer energy
ASSERT LAST_N == e2 "energy held through crisis"
GETF printer atp
ASSERT LAST_N == at1 "atp held through crisis"
GETF printer reserve
ASSERT LAST_N == r0 "cargo held"
GETF printer alive
ASSERT LAST_N == 1 "colony lives after mPTP"

PRINT "atomic_printer_life_mptp PASS"
