# Demo integration — Chemistry integration
HOLD_FLASH 1
SCIENCE LOAD
LET H_in = 4
LET H_out = 4
ASSERT H_in == H_out
ASSERT CELSIUS_K(0) == 273
ASSERT H2O_BP == 100
CUBE H ROLE el PROTON 1
CUBE O ROLE el PROTON 1
SETDIGIT H 1
SETDIGIT O 8
ASSERT DIGIT(H) == 1
ASSERT DIGIT(O) == 8
PRINT "exam_chem" DIGIT(O)
