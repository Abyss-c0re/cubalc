// smx_mesh_vesicle_export_life.cubalc
// SMX mesh vesicle board: life_cell export under sealed exchange.
REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY v OF Cell 1 36 0
SEND v set_threshold 10
SEND v pulse 3
SEND v photosynth 28
SEND v glycolyse 24
SEND v pump 16
SEND v charge 24
SEND v feed 24
SEND v release 2
SEND v reuptake 2
SEND v refill 2
SEND v dock 2
SEND v arm 2
SEND v clamp 2
SEND v trigger 2
SEND v pore 2
SEND v mix 2
SEND v collapse 2
SEND v retrieve 2
SEND v acidify 2
SEND v mature 2
SEND v recruit 2
SEND v activate 2
SEND v photosynth 8
SEND v glycolyse 8
SEND v charge 8
SEND v feed 8
SEND v degrade 2
SEND v photosynth 6
SEND v glycolyse 6
SEND v charge 6
SEND v feed 6

GETF v heat
LET h0 = LAST_N
GETF v energy
LET e0 = LAST_N
GETF v pcr
LET c0 = LAST_N
GETF v reserve
LET r0 = LAST_N

SEND v export 2
LET took = LAST_N
ASSERT took >= 1 "smx exp took"
GETF v heat
ASSERT LAST_N == h0 + took "smx exp heat"
GETF v energy
ASSERT LAST_N == e0 - took "smx exp e"
GETF v pcr
ASSERT LAST_N == c0 - took "smx exp pcr"
GETF v reserve
ASSERT LAST_N == r0 + took "smx exp r"

PRINT "smx_mesh_vesicle_export_life PASS"
