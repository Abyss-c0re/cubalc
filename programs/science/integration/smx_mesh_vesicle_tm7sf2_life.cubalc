REQUIRE VERSION "1.15"
INCLUDE life_cell

# SMX mesh vesicle LIFE_FORCE MI2323: TM7SF2 after CYP51 on BA/mevalonate limb.
# Continuum ...->dld->dlst->oxct1->acat1->hmgcs2->hmgcl->bdh1->slc16a1->slc16a7->emb->aacs->hmgcs1->hmgcr->mvk->pmvk->mvd->idi1->fdps->sqs->sqle->lss->cyp51->tm7sf2
# Gift: TM7SF2 opens 4,4-dimethyl-cholesta-8,14,24-trienol -> 4,4-dimethyl-cholesta-8,24-dienol Δ14-reductase gate under ASSERT after CYP51 open.
# Domain: post-CYP51 sterol Δ14-reductase (TM7SF2/DHCR14/ERG24) C14-C15 saturation gate.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY vesicle OF Cell 1 55 0
ENTITY cargo OF Cell 1 36 0
ENTITY lysed OF Cell 0 12 0

SEND vesicle set_threshold 9
SEND cargo set_threshold 11

SEND vesicle pulse 3
SEND vesicle photosynth 28
SEND vesicle glycolyse 20
SEND vesicle charge 26
SEND vesicle feed 20
GETF vesicle energy
ASSERT LAST_N >= 16 "vesicle energy"
GETF vesicle atp
ASSERT LAST_N >= 16 "vesicle atp"

SEND vesicle pcca 2
ASSERT LAST_N == 2 "vesicle pcca"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mcee 2
ASSERT LAST_N == 2 "vesicle mcee"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mut 2
ASSERT LAST_N == 2 "vesicle mut"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle suclg1 2
ASSERT LAST_N == 2 "vesicle suclg1"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle sdha 2
ASSERT LAST_N == 2 "vesicle sdha"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle fh 2
ASSERT LAST_N == 2 "vesicle fh"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mdh 2
ASSERT LAST_N == 2 "vesicle mdh"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle cs 2
ASSERT LAST_N == 2 "vesicle cs"
SEND vesicle photosynth 14
SEND vesicle charge 14
SEND vesicle feed 12
SEND vesicle aco2 1
ASSERT LAST_N == 1 "vesicle aco2 open"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle idh2 2
ASSERT LAST_N == 2 "vesicle idh2 isocitrate to aKG"
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle ogdh 1
ASSERT LAST_N == 1 "vesicle ogdh open"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle scs 1
ASSERT LAST_N == 1 "vesicle scs prior"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle dld 1
ASSERT LAST_N == 1 "vesicle dld open before tm7sf2"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle dlst 1
ASSERT LAST_N == 1 "vesicle dlst open before tm7sf2"
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle oxct1 1
ASSERT LAST_N == 1 "vesicle oxct1 open before tm7sf2"
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle acat1 1
ASSERT LAST_N == 1 "vesicle acat1 open before tm7sf2"
SEND vesicle hmgcs2 1
ASSERT LAST_N == 1 "vesicle hmgcs2 open before tm7sf2"
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle hmgcl 1
ASSERT LAST_N == 1 "vesicle hmgcl open before tm7sf2"
