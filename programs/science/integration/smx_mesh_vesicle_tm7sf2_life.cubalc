SEND cargo photosynth 8
SEND cargo charge 8
SEND cargo feed 6
GETF cargo heat
LET ch = LAST_N
GETF cargo energy
LET ce = LAST_N
GETF cargo atp
LET ca = LAST_N
SEND cargo tm7sf2 2
ASSERT LAST_N == 2 "cargo tm7sf2 2"
GETF cargo heat
ASSERT LAST_N == ch + 2 "cargo tm7sf2 heat+2"
GETF cargo energy
ASSERT LAST_N == ce - 2 "cargo tm7sf2 energy-2"
GETF cargo atp
ASSERT LAST_N == ca - 2 "cargo tm7sf2 atp-2"
GETF cargo alive
ASSERT LAST_N == 1 "cargo alive post-tm7sf2"

SEND lysed tm7sf2 3
ASSERT LAST_N == 0 "lysed tm7sf2 refused"
GETF lysed alive
ASSERT LAST_N == 0 "lysed stays dead"

ASSERT 1 == 1 "smx_mesh_vesicle_tm7sf2_life PASS"
