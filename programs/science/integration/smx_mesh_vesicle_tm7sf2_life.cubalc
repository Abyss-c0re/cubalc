SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle sqle 1
ASSERT LAST_N == 1 "vesicle sqle open before tm7sf2"
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle lss 1
ASSERT LAST_N == 1 "vesicle lss open before tm7sf2"
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle photosynth 10
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle cyp51 1
ASSERT LAST_N == 1 "vesicle cyp51 open before tm7sf2"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
SEND vesicle tm7sf2 3
ASSERT LAST_N == 3 "vesicle tm7sf2 3"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "vesicle tm7sf2 heat+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "vesicle tm7sf2 energy-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "vesicle tm7sf2 atp-3"
GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive post-tm7sf2"

SEND cargo photosynth 18
SEND cargo charge 16
SEND cargo feed 14
SEND cargo mdh 1
ASSERT LAST_N == 1 "cargo mdh open"
SEND cargo photosynth 8
SEND cargo charge 8
SEND cargo feed 6
