SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle mvk 1
ASSERT LAST_N == 1 "vesicle mvk open before tm7sf2"
SEND vesicle pmvk 1
ASSERT LAST_N == 1 "vesicle pmvk open before tm7sf2"
