SEND cargo feed 8
SEND cargo slc16a1 1
ASSERT LAST_N == 1 "cargo slc16a1 open before tm7sf2"
SEND cargo slc16a7 1
ASSERT LAST_N == 1 "cargo slc16a7 open before tm7sf2"
SEND cargo photosynth 10
SEND cargo charge 10
SEND cargo feed 8
SEND cargo emb 1
ASSERT LAST_N == 1 "cargo emb open before tm7sf2"
SEND cargo photosynth 8
