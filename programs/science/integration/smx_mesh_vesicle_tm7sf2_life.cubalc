SEND vesicle feed 6
SEND vesicle aacs 1
ASSERT LAST_N == 1 "vesicle aacs open before tm7sf2"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle idi1 1
ASSERT LAST_N == 1 "vesicle hmgcs1 open before tm7sf2"
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle photosynth 8
SEND vesicle charge 8
SEND vesicle feed 6
SEND vesicle hmgcr 1
ASSERT LAST_N == 1 "vesicle hmgcr open before tm7sf2"
