// atomic_printer_life_if1.cubalc
// Atomic printer board: Cell.if1 IF1 A-site block on 30S PIC after IF2 gate.
// Place/bond/energize life-force; IF1 occludes 30S A-site on PIC after IF2.
// Cube is SoT. Free energy must flow.


REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY bud OF Cell 1 36 0

SEND printer set_threshold 10
SEND bud set_threshold 10

SEND printer pulse 6
SEND printer photosynth 44
SEND printer glycolyse 36
SEND printer charge 40
SEND printer feed 36
SEND printer charge_pcr 22

SEND printer aars 3
ASSERT LAST_N == 3 "ap aars"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14
SEND printer eftu 3
ASSERT LAST_N == 3 "ap eftu"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer ptc 3
ASSERT LAST_N == 3 "ap ptc"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14
SEND printer efg 3
ASSERT LAST_N == 3 "ap efg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer rf1 3
ASSERT LAST_N == 3 "ap rf1"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14
SEND printer rf3 3
ASSERT LAST_N == 3 "ap rf3"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 16
SEND printer rrf 3
ASSERT LAST_N == 3 "ap rrf"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20

SEND printer if3 3
ASSERT LAST_N == 3 "ap if3"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20

SEND printer if2 3
ASSERT LAST_N == 3 "printer pre if2"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
GETF printer heat
LET ph = LAST_N
GETF printer energy
LET pe = LAST_N
GETF printer atp
LET pa = LAST_N
GETF printer pcr
LET pc = LAST_N
GETF printer reserve
LET pr = LAST_N
GETF printer age
LET page = LAST_N

SEND printer if1 4
ASSERT LAST_N == 4 "ap if1"

GETF printer heat
ASSERT LAST_N == ph + 4 "ap h+4"
GETF printer energy
ASSERT LAST_N == pe - 4 "ap e-4"
GETF printer atp
ASSERT LAST_N == pa "ap a held"
GETF printer pcr
ASSERT LAST_N == pc "ap c held"
GETF printer reserve
ASSERT LAST_N == pr "ap r held"
GETF printer age
ASSERT LAST_N == page "ap age held"
GETF printer alive
ASSERT LAST_N == 1 "ap alive"

SEND bud pulse 4
SEND bud photosynth 32
SEND bud glycolyse 24
SEND bud charge 28
SEND bud feed 20
SEND bud charge_pcr 14
SEND bud aars 2
SEND bud eftu 2
SEND bud ptc 2
SEND bud efg 2
SEND bud rf1 2
SEND bud rf3 2
SEND bud rrf 2
SEND bud photosynth 20
SEND bud glycolyse 16
SEND bud charge 24
SEND bud feed 16
SEND bud if3 2
ASSERT LAST_N == 2 "bud if3"
SEND bud photosynth 20
SEND bud glycolyse 16
SEND bud charge 24
SEND bud feed 16
SEND bud if2 2
ASSERT LAST_N == 2 "bud pre if2"
SEND bud photosynth 20
SEND bud glycolyse 16
SEND bud charge 24
SEND bud feed 16
SEND bud if1 2
ASSERT LAST_N == 2 "bud if1"
GETF bud alive
ASSERT LAST_N == 1 "bud alive"

ASSERT 1 == 1 "atomic_printer_life_if1 sealed"
PRINT "atomic_printer_life_if1 PASS"
