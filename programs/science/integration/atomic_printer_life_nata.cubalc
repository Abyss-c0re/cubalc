// atomic_printer_life_nata.cubalc
// Atomic printer: NatA seals N-termini after MAP on the print bed.
// Continuum ...->pepf->pdf->map->nata
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 50 0
ENTITY ink OF Cell 1 34 0
ENTITY scrap OF Cell 0 12 0

SEND printer set_threshold 8
SEND ink set_threshold 9

SEND printer pulse 5
SEND printer photosynth 40
SEND printer glycolyse 32
SEND printer pump 22
SEND printer charge 36
SEND printer feed 32

SEND printer pepf 2
ASSERT LAST_N == 2 "ap pepf"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer pdf 2
ASSERT LAST_N == 2 "ap pdf"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer map 2
ASSERT LAST_N == 2 "ap map"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20

GETF printer atp
ASSERT LAST_N >= 8 "ap atp primed"
GETF printer energy
ASSERT LAST_N >= 8 "ap energy primed"
GETF printer atp
LET paq = LAST_N
GETF printer energy
LET peq = LAST_N
SEND printer nata 4
ASSERT LAST_N == 4 "ap nata4"
GETF printer atp
ASSERT LAST_N == paq - 4 "ap a-4"
GETF printer energy
ASSERT LAST_N == peq - 4 "ap e-4"

SEND ink pulse 4
SEND ink photosynth 36
SEND ink glycolyse 28
SEND ink charge 30
SEND ink feed 28
SEND ink map 3
ASSERT LAST_N == 3 "ink map"
SEND ink photosynth 22
SEND ink glycolyse 18
SEND ink charge 24
SEND ink feed 18
GETF ink atp
LET iaq = LAST_N
GETF ink energy
LET ieq = LAST_N
SEND ink nata 3
ASSERT LAST_N == 3 "ink nata3"
GETF ink atp
ASSERT LAST_N == iaq - 3 "ink a-3"
GETF ink energy
ASSERT LAST_N == ieq - 3 "ink e-3"
GETF ink energy
LET ie2 = LAST_N
GETF ink threshold
LET ith = LAST_N
GETF ink ready
LET ird = LAST_N
IF ie2 >= ith THEN
  ASSERT ird == 1 "ink ready"
END
IF ie2 < ith THEN
  ASSERT ird == 0 "ink unready"
END

SEND scrap nata 2
ASSERT LAST_N == 0 "scrap nata0"

GETF printer alive
ASSERT LAST_N == 1 "printer alive"
GETF ink alive
ASSERT LAST_N == 1 "ink alive"
