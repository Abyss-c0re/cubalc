// atomic_printer_life_gshb.cubalc
// Atomic printer: GshB glutathione synthetase after GshA.
// Cube is SoT. Free energy must flow.
// Continuum ...->map->rimi->metk->sped->mtnn->luxs->mete->metf->ahcy->cbs->cgl->gsha->gshb

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

