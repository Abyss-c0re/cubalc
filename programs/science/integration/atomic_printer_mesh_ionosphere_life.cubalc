// atomic_printer_mesh_ionosphere_life.cubalc
// Sibling of flagship: ionosphered mesh + mitosis cascade under free energy.
// Soft-OOB fail-closed. LIFE_FORCE. WE_AUTOHEAL. THALAMUS. IONOSPHERE. STABILIZE. Cell divide.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_ionosphere_life | creed=life_force |"
CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed
ENTITY seed OF Cell 1 12 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed
IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3
LET base_cubes = CUBES
SMX KEY
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT CUBES == base_cubes "no ghost"
SMX LIFE_FORCE bed nozzle hive scrap
ASSERT SMX_OK == 1 "life_force"
ASSERT SMX_OOB == 0 "cleared"
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_AUTOHEALED == 1 "autoheal"
SMX RESILIENCE bed nozzle hive scrap
ASSERT SMX_RESILIENT == 1 "resilient"
SMX THALAMUS bed nozzle hive scrap
ASSERT SMX_STABLE_MESH == 1 "stable_mesh"
SMX IONOSPHERE bed nozzle hive scrap
ASSERT SMX_IONOSPHERED == 1 "ionosphered"
ASSERT SMX_IONO == 1 "iono"
SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_STABLE == 1 "stable"
LET births = 0
LET step = 0
WHILE step < 8
  TICK 1
  FLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END
GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
LET pop = a0 + a1
ASSERT births >= 1 "mitosis on ionosphered mesh"
ASSERT pop >= 2 "population"
ASSERT ENERGY > 0 "energy flows"
ASSERT SMX_STABLE_MESH == 1 "mesh holds"
ASSERT SMX_IONOSPHERED == 1 "ionosphere holds"
ASSERT OK == 1
PRINT "atomic_printer_mesh_ionosphere_life" births pop SMX_STABLE_MESH SMX_IONOSPHERED SMX_LIFE_FORCE ENERGY UNITY DECIDE
PASS
