// smx_mesh_vesicle_ahcy_life.cubalc
// SMX vesicle: Ahcy SAH hydrolase after MetF.
// Cube is SoT. Free energy must flow.
// Continuum ...->map->rimi->metk->sped->mtnn->luxs->mete->metf->ahcy

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 44 0
ENTITY dock OF Cell 1 28 0
ENTITY void OF Cell 0 12 0

