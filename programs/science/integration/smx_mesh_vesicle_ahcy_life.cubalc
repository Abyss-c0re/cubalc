REQUIRE VERSION "1.15"
INCLUDE life_cell

# SMX mesh vesicle life — AhcY SAH hydrolase after MetK
# Extends vesicle continuum after MetE: pepf->pdf->map->nata->natb->natc->nate->mete->metk->ahcy
# Gift: AhcY clears SAH into Ado+Hcy after MetK on the SMX vesicle board.
# Cube is SoT. Free energy must flow.

ENTITY vesicle OF Cell 1 55 0
SEND vesicle set_threshold 9
SEND vesicle pulse 3
SEND vesicle photosynth 40
SEND vesicle glycolyse 32
SEND vesicle pump 24
SEND vesicle photophos 22
SEND vesicle charge 36
SEND vesicle feed 34

SEND vesicle pepf 2
ASSERT LAST_N == 2 "smx pepf"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 12
SEND vesicle pdf 2
ASSERT LAST_N == 2 "smx pdf"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 12
SEND vesicle map 2
ASSERT LAST_N == 2 "smx map"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14
SEND vesicle nata 2
ASSERT LAST_N == 2 "smx nata"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14
SEND vesicle natb 2
ASSERT LAST_N == 2 "smx natb"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14
SEND vesicle natc 2
ASSERT LAST_N == 2 "smx natc"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14
SEND vesicle nate 2
ASSERT LAST_N == 2 "smx nate"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14
SEND vesicle mete 2
ASSERT LAST_N == 2 "smx mete"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14
SEND vesicle metk 2
ASSERT LAST_N == 2 "smx metk"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 20
SEND vesicle feed 14

GETF vesicle heat
LET h0 = LAST_N
GETF vesicle energy
LET e0 = LAST_N
GETF vesicle atp
LET a0 = LAST_N
GETF vesicle pmf
LET pmf0 = LAST_N

SEND vesicle ahcy 3
ASSERT LAST_N == 3 "smx ahcy3"
GETF vesicle heat
ASSERT LAST_N == h0 + 3 "smx ahcy heat"
GETF vesicle energy
ASSERT LAST_N == e0 - 3 "smx ahcy energy"
GETF vesicle atp
ASSERT LAST_N == a0 - 3 "smx ahcy atp"
GETF vesicle pmf
ASSERT LAST_N == pmf0 "smx ahcy pmf held"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive"

ASSERT 1 == 1 "smx_mesh_vesicle_ahcy_life PASS"
