ASSERT LAST_N == vhq + 3 "ahcy vesicle h"
GETF vesicle energy
ASSERT LAST_N == veq - 3 "ahcy vesicle e"
GETF vesicle atp
ASSERT LAST_N == vaq - 3 "ahcy vesicle a"


