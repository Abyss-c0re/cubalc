// atomic_printer_life_casp3.cubalc
// Science board: atomic printer life-force — caspase-3 executioner after CASP9.
// Place cell, energize chemiosmotic path, run tether->mcu->nclx->mptp->momp->apaf->casp9->casp3.
// ASSERT free energy: pmf/reserve held; energy drains on executioner demolition.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY seed OF Cell 1 16 0
SEND seed set_threshold 10

SEND seed pulse 4
SEND seed photosynth 10
SEND seed glycolyse 8
SEND seed pump 8
SEND seed synthase 2

GETF seed alive
ASSERT LAST_N == 1 "sci alive"
GETF seed atp
LET at0 = LAST_N
ASSERT at0 >= 6 "sci atp primed"
GETF seed pmf
LET p0 = LAST_N
ASSERT p0 >= 4 "sci pmf"
GETF seed energy
LET e0 = LAST_N
ASSERT e0 >= 4 "sci energy"
GETF seed reserve
LET r0 = LAST_N
GETF seed age
LET a0 = LAST_N
GETF seed heat
LET h0 = LAST_N

SEND seed tether 1
ASSERT LAST_N == 1 "sci tether"
SEND seed mcu 2
ASSERT LAST_N == 2 "sci mcu"
SEND seed nclx 1
ASSERT LAST_N == 1 "sci nclx"

GETF seed pmf
LET p1 = LAST_N
GETF seed heat
LET h1 = LAST_N
GETF seed age
LET a1 = LAST_N

SEND seed mptp 2
ASSERT LAST_N == 2 "sci mptp"
GETF seed pmf
ASSERT LAST_N == p1 - 2 "sci mptp pmf"
GETF seed heat
ASSERT LAST_N == h1 + 2 "sci mptp heat"
GETF seed age
ASSERT LAST_N == a1 + 1 "sci mptp age"

GETF seed atp
LET at2 = LAST_N
GETF seed age
LET a2 = LAST_N
GETF seed heat
LET h2 = LAST_N
GETF seed pmf
LET p2 = LAST_N

SEND seed momp 2
ASSERT LAST_N == 2 "sci momp"
GETF seed atp
ASSERT LAST_N == at2 - 2 "sci momp atp"
GETF seed age
ASSERT LAST_N == a2 + 2 "sci momp age"
GETF seed heat
ASSERT LAST_N == h2 + 1 "sci momp heat"
GETF seed pmf
ASSERT LAST_N == p2 "sci momp pmf held"

SEND seed photosynth 3
SEND seed glycolyse 3
GETF seed atp
LET at3 = LAST_N
ASSERT at3 >= 3 "sci dATP pool"
GETF seed age
LET a3 = LAST_N
GETF seed heat
LET h3 = LAST_N
GETF seed energy
LET e3 = LAST_N
GETF seed reserve
LET r3 = LAST_N
GETF seed pmf
LET p3 = LAST_N

SEND seed apaf 3
ASSERT LAST_N == 3 "sci apaf3"
GETF seed atp
ASSERT LAST_N == at3 - 3 "sci apaf atp"
GETF seed heat
ASSERT LAST_N == h3 + 3 "sci apaf heat"
GETF seed age
ASSERT LAST_N == a3 + 1 "sci apaf age+1"
GETF seed energy
ASSERT LAST_N == e3 "sci apaf e held"
GETF seed pmf
ASSERT LAST_N == p3 "sci apaf pmf held"

SEND seed photosynth 4
SEND seed glycolyse 4
GETF seed atp
LET at4 = LAST_N
ASSERT at4 >= 4 "sci casp pool"
GETF seed age
LET a4 = LAST_N
GETF seed heat
LET h4 = LAST_N
GETF seed energy
LET e4 = LAST_N
GETF seed reserve
LET r4 = LAST_N
GETF seed pmf
LET p4 = LAST_N

SEND seed casp9 2
ASSERT LAST_N == 2 "sci casp9"
GETF seed atp
ASSERT LAST_N == at4 - 2 "sci casp9 atp"
GETF seed heat
ASSERT LAST_N == h4 + 2 "sci casp9 heat"
GETF seed age
ASSERT LAST_N == a4 + 2 "sci casp9 age"
GETF seed energy
ASSERT LAST_N == e4 "sci casp9 e HELD"
GETF seed pmf
ASSERT LAST_N == p4 "sci casp9 pmf held"
GETF seed reserve
ASSERT LAST_N == r4 "sci casp9 r held"

GETF seed atp
LET at5 = LAST_N
GETF seed age
LET a5 = LAST_N
GETF seed heat
LET h5 = LAST_N
GETF seed energy
LET e5 = LAST_N

SEND seed casp3 2
ASSERT LAST_N == 2 "sci casp3"
GETF seed atp
ASSERT LAST_N == at5 - 2 "sci casp3 atp"
GETF seed heat
ASSERT LAST_N == h5 + 2 "sci casp3 heat"
GETF seed age
ASSERT LAST_N == a5 + 2 "sci casp3 age"
GETF seed energy
ASSERT LAST_N == e5 - 2 "sci casp3 e DRAIN"
GETF seed pmf
ASSERT LAST_N == p4 "sci casp3 pmf held"
GETF seed reserve
ASSERT LAST_N == r4 "sci casp3 r held"
GETF seed alive
ASSERT LAST_N == 1 "sci lives post casp3"

ENTITY corpse OF Cell 0 20 0
SEND corpse casp3 3
ASSERT LAST_N == 0 "sci dead0"

PRINT "atomic_printer_life_casp3 PASS"
