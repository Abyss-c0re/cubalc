REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_FORCE MI2294 atomic printer: FH after SDHA on BA/odd-chain limb.
# Place cells, bond metabolism, energize, then open BA beta-ox + propionyl gate:
#   amacr -> acox2 -> hsd17b4 -> scp2 -> acot8 -> pcca -> mcee -> mut -> suclg1 -> sdha -> fh.
# Wonder: AGI sees ASSERT heat+n atp-n energy-n on fh after Complex II open.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY printer OF Cell 1 60 0
ENTITY ink OF Cell 1 40 0
ENTITY dead OF Cell 0 10 0

SEND printer set_threshold 8
SEND ink set_threshold 10

SEND printer pulse 4
SEND printer photosynth 30
SEND printer glycolyse 24
SEND printer charge 28
SEND printer feed 22
SEND printer photophos 16
GETF printer energy
ASSERT LAST_N >= 20 "printer energy charged"
GETF printer atp
ASSERT LAST_N >= 20 "printer atp charged"

SEND printer amacr 2
ASSERT LAST_N == 2 "printer amacr"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acox2 2
ASSERT LAST_N == 2 "printer acox2"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer hsd17b4 2
ASSERT LAST_N == 2 "printer hsd17b4 DBP"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer scp2 2
ASSERT LAST_N == 2 "printer scp2 thiolase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer acot8 2
ASSERT LAST_N == 2 "printer acot8 thioesterase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer pcca 2
ASSERT LAST_N == 2 "printer pcca carboxylase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer mcee 2
ASSERT LAST_N == 2 "printer mcee epimerase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer mut 2
ASSERT LAST_N == 2 "printer mut mutase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer suclg1 2
ASSERT LAST_N == 2 "printer suclg1 ligase"
SEND printer photosynth 12
SEND printer charge 12
SEND printer feed 10
SEND printer sdha 2
ASSERT LAST_N == 2 "printer sdha Complex-II"
SEND printer photosynth 14
SEND printer charge 14
SEND printer feed 12
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
SEND printer fh 3
ASSERT LAST_N == 3 "printer fh fumarase 3"
GETF printer heat
ASSERT LAST_N == h0 + 3 "printer fh heat+3"
GETF printer energy
ASSERT LAST_N == e0 - 3 "printer fh energy-3"
GETF printer atp
ASSERT LAST_N == a0 - 3 "printer fh atp-3"
GETF printer alive
ASSERT LAST_N == 1 "printer alive post-fh"

SEND ink photosynth 20
SEND ink charge 18
SEND ink feed 16
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink fh 2
ASSERT LAST_N == 2 "ink fh 2"
GETF ink heat
ASSERT LAST_N == ih + 2 "ink fh heat+2"
GETF ink energy
ASSERT LAST_N == ie - 2 "ink fh energy-2"
GETF ink atp
ASSERT LAST_N == ia - 2 "ink fh atp-2"
GETF ink alive
ASSERT LAST_N == 1 "ink alive post-fh"

SEND dead fh 3
ASSERT LAST_N == 0 "dead fh refused"
GETF dead alive
ASSERT LAST_N == 0 "dead stays dead"

ASSERT 1 == 1 "atomic_printer_life_fh PASS"
