// smx_mesh_vesicle_murg_life.cubalc
// SMX vesicle: MurG UDP-GlcNAc:lipid-I N-acetylglucosaminyltransferase (lipid-II) after MraY.
// Cube is SoT. Free energy must flow.
// Continuum ...->mura->murb->murc->murd->mure->murf->mray->murg

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 44 0
ENTITY dock OF Cell 1 28 0
ENTITY void OF Cell 0 12 0

SEND vesicle set_threshold 8
SEND dock set_threshold 8
SEND vesicle pulse 3
SEND vesicle photosynth 36
SEND vesicle glycolyse 32
SEND vesicle pump 20
SEND vesicle charge 36
SEND vesicle feed 32

SEND vesicle ampg 3
ASSERT LAST_N == 3 "ves ampg"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle nagz 3
ASSERT LAST_N == 3 "ves nagz"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle ampd 3
ASSERT LAST_N == 3 "ves ampd"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle anmk 3
ASSERT LAST_N == 3 "ves anmk"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle murq 3
ASSERT LAST_N == 3 "ves murq"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle naga 3
ASSERT LAST_N == 3 "ves naga"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle nagb 3
ASSERT LAST_N == 3 "ves nagb"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle pfka 3
ASSERT LAST_N == 3 "ves pfka"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle mura 3
ASSERT LAST_N == 3 "ves mura"
SEND vesicle photosynth 24
SEND vesicle glycolyse 18
SEND vesicle charge 20
SEND vesicle feed 16
SEND vesicle murb 3
ASSERT LAST_N == 3 "pre murb"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle murc 3
ASSERT LAST_N == 3 "ves murc"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle murd 3
ASSERT LAST_N == 3 "ves murd"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle mure 3
ASSERT LAST_N == 3 "ves mure"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle murf 3
ASSERT LAST_N == 3 "ves murf"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle mray 3
ASSERT LAST_N == 3 "ves mray"
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
GETF vesicle pcr
LET vc = LAST_N
SEND vesicle murg 3
ASSERT LAST_N == 3 "ves murg"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "ves murg h+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "ves murg e-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "ves murg atp-3"
GETF vesicle pcr
ASSERT LAST_N == vc "ves murg pcr held"

SEND dock photosynth 24
SEND dock glycolyse 18
SEND dock charge 20
SEND dock feed 16
SEND dock murc 2
ASSERT LAST_N == 2 "dock murc"
SEND dock photosynth 16
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock murd 2
ASSERT LAST_N == 2 "dock murd"
SEND dock photosynth 16
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock mure 2
ASSERT LAST_N == 2 "dock mure"
SEND dock photosynth 16
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock murf 2
ASSERT LAST_N == 2 "dock murf"
SEND dock photosynth 16
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock mray 2
ASSERT LAST_N == 2 "dock mray"
GETF dock heat
LET dh = LAST_N
SEND dock murg 2
ASSERT LAST_N == 2 "dock murg"
GETF dock heat
ASSERT LAST_N == dh + 2 "dock murg h+2"

SEND void murg 3
ASSERT LAST_N == 0 "void murg 0"
GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive"

