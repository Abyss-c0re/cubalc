// smx_mesh_fusion_pore_life.cubalc
// SMX mesh: fusion-pore life-force — post-trigger lipid-stalk aqueous pore on life_cell continuum.
// Matrix is key. Cube is SoT. Free energy must flow. No IF*P duals.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY mesh OF Cell 1 44 0
SEND mesh set_threshold 11
SEND mesh pulse 5
SEND mesh photosynth 24
SEND mesh glycolyse 18
SEND mesh pump 14
SEND mesh photophos 14
SEND mesh converge 1
SEND mesh extend 1
SEND mesh fold 1
SEND mesh zip 1
SEND mesh crest 1
SEND mesh migrate 1
SEND mesh stream 1
SEND mesh condense 1
SEND mesh fate 1
SEND mesh project 1
SEND mesh synapse 1
SEND mesh release 1
SEND mesh reuptake 2
SEND mesh refill 2
SEND mesh dock 2
SEND mesh arm 2
SEND mesh clamp 2
SEND mesh trigger 2

GETF mesh heat
LET h0 = LAST_N
GETF mesh energy
LET e0 = LAST_N
GETF mesh atp
LET a0 = LAST_N
GETF mesh threshold
LET t0 = LAST_N
GETF mesh pmf
LET p0 = LAST_N
GETF mesh setpoint
LET s0 = LAST_N
ASSERT e0 >= 2 "smx e"
ASSERT a0 >= 2 "smx a"
ASSERT t0 >= 2 "smx thr"

SEND mesh pore 2
ASSERT LAST_N == 2 "smx pore2"
GETF mesh heat
ASSERT LAST_N == h0 + 2 "smx h+2"
GETF mesh energy
ASSERT LAST_N == e0 - 2 "smx e-2"
GETF mesh atp
ASSERT LAST_N == a0 - 2 "smx a-2"
GETF mesh threshold
ASSERT LAST_N == t0 - 2 "smx thr-2"
GETF mesh pmf
ASSERT LAST_N == p0 "smx pmf held"
GETF mesh setpoint
ASSERT LAST_N == s0 "smx sp held"

ASSERT 1 == 1 "smx fusion pore life complete"
