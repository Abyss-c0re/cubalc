// atomic_printer_life_migrate.cubalc
// Science integration: multipotent neural-crest stream after crest EMT.
// Atomic printer continuum: converge -> extend -> fold -> zip -> crest -> migrate.
// CXCL12-steered locomotion burns ATP into heat and eases setpoint (lean stream).
// Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY plate OF Cell 1 28 0
ENTITY hinge OF Cell 1 22 0
ENTITY stream OF Cell 1 18 0

SEND plate set_threshold 10
SEND hinge set_threshold 10
SEND stream set_threshold 10

SEND plate pulse 4
SEND plate photosynth 14
SEND plate glycolyse 12
SEND plate pump 10
SEND plate photophos 10
GETF plate atp
ASSERT LAST_N >= 20 "sci atp"
GETF plate energy
LET e0 = LAST_N
GETF plate heat
LET h0 = LAST_N
GETF plate reserve
LET r0 = LAST_N
GETF plate threshold
ASSERT LAST_N == 10 "sci thr0"
GETF plate pmf
LET p0 = LAST_N
GETF plate setpoint
LET s0 = LAST_N
GETF plate pcr
LET c0 = LAST_N
GETF plate age
LET a0 = LAST_N

SEND plate converge 4
ASSERT LAST_N == 4 "sci ce4"
GETF plate reserve
ASSERT LAST_N == r0 + 4 "sci r+4"

SEND plate extend 3
ASSERT LAST_N == 3 "sci ext3"
GETF plate energy
LET e1 = LAST_N
ASSERT e1 == e0 + 3 "sci e+3"
GETF plate reserve
LET r1 = LAST_N
ASSERT r1 == r0 + 1 "sci r after ext"

SEND plate fold 3
ASSERT LAST_N == 3 "sci fold3"
GETF plate energy
LET e2 = LAST_N
ASSERT e2 == e1 - 3 "sci e after fold"
GETF plate heat
LET h2 = LAST_N
GETF plate atp
LET a2 = LAST_N
GETF plate threshold
LET t2 = LAST_N
ASSERT t2 == 10 "sci thr pre-zip"
GETF plate reserve
LET r2 = LAST_N
GETF plate pmf
LET p2 = LAST_N
GETF plate setpoint
LET s2 = LAST_N
GETF plate pcr
LET c2 = LAST_N
GETF plate age
LET age2 = LAST_N

SEND plate zip 2
ASSERT LAST_N == 2 "sci zip2"
GETF plate threshold
LET t3 = LAST_N
ASSERT t3 == 12 "sci thr after zip"
GETF plate energy
LET e3 = LAST_N
ASSERT e3 == e2 "sci e zip held"
GETF plate heat
LET h3 = LAST_N
GETF plate atp
LET a3 = LAST_N
GETF plate reserve
LET r3 = LAST_N
GETF plate pmf
LET p3 = LAST_N
GETF plate setpoint
LET s3 = LAST_N
GETF plate pcr
LET c3 = LAST_N
GETF plate age
LET age3 = LAST_N

SEND plate crest 3
ASSERT LAST_N == 3 "sci crest3"
GETF plate energy
LET e4 = LAST_N
ASSERT e4 == e3 + 3 "sci e crest+"
GETF plate heat
LET h4 = LAST_N
ASSERT h4 == h3 + 3 "sci h crest+"
GETF plate atp
LET a4 = LAST_N
ASSERT a4 == a3 - 3 "sci atp crest-"
GETF plate setpoint
LET s4 = LAST_N
ASSERT s4 == s3 "sci sp crest held"
GETF plate threshold
LET t4 = LAST_N
ASSERT t4 == t3 "sci thr crest held"

SEND plate migrate 4
ASSERT LAST_N == 4 "sci mig4"
GETF plate heat
ASSERT LAST_N == h4 + 4 "sci h+4"
GETF plate setpoint
ASSERT LAST_N == s4 - 4 "sci sp-4"
GETF plate energy
ASSERT LAST_N == e4 "sci e held"
GETF plate atp
ASSERT LAST_N == a4 - 4 "sci atp-4"
GETF plate threshold
ASSERT LAST_N == t4 "sci thr held"
GETF plate reserve
ASSERT LAST_N == r3 "sci r held"
GETF plate pmf
ASSERT LAST_N == p3 "sci pmf held"
GETF plate pcr
ASSERT LAST_N == c3 "sci pcr held"
GETF plate age
ASSERT LAST_N == age3 "sci age held"

SEND hinge pulse 5
SEND hinge photosynth 10
SEND hinge glycolyse 8
SEND hinge pump 6
SEND hinge photophos 6
SEND hinge converge 2
SEND hinge extend 2
SEND hinge fold 2
SEND hinge zip 1
SEND hinge crest 1
GETF hinge energy
LET he = LAST_N
GETF hinge heat
LET hh = LAST_N
GETF hinge setpoint
LET hs = LAST_N
SEND hinge migrate 2
ASSERT LAST_N == 2 "hinge mig2"
GETF hinge energy
ASSERT LAST_N == he "hinge e held"
GETF hinge heat
ASSERT LAST_N == hh + 2 "hinge h+2"
GETF hinge setpoint
ASSERT LAST_N == hs - 2 "hinge sp-2"

SEND stream pulse 2
GETF stream atp
ASSERT LAST_N == 0 "stream atp0"
GETF stream energy
LET se = LAST_N
GETF stream heat
LET sh = LAST_N
GETF stream setpoint
LET ss = LAST_N
SEND stream migrate 3
ASSERT LAST_N == 0 "stream mig0"
GETF stream energy
ASSERT LAST_N == se "stream e held"
GETF stream heat
ASSERT LAST_N == sh "stream h held"
GETF stream setpoint
ASSERT LAST_N == ss "stream sp held"

ASSERT 1 == 1 "migrate science sealed"
