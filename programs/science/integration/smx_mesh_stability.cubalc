// smx_mesh_stability.cubalc — AGI science board
// Soft-OOB SMX + STABILIZE latch on atomic printer spine.
// Wonder: missing peers do not invent ghosts; live matrix still unifies.
// Sibling of atomic_printer_life_force — mind-plane stability.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_stability | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG scrap hive
PLUG bed scrap

ENTITY seed OF Cell 1 8 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
ENERGYFLOW 3
FLOW 2

SMX KEY

// Probe absent mesh neighbor — soft-OOB, no thrash
SMX EXCHANGE hive offworld
ASSERT SMX_OK == 0 "offworld soft-OOB"
ASSERT SMX_OOB >= 1 "oob counted"
ASSERT CUBES == 5 "frame+seed only — no ghost offworld cube"

// Stabilize latch: clear thrash + circular breath along printer spine
SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "spine stabilize live"
ASSERT SMX_STABLE == 1 "stable latch"
ASSERT SMX_STEADFAST == 4 "four steadfast"
ASSERT SMX_PULSE == 4 "four pulses"
ASSERT SMX_OOB == 0 "oob cleared by stabilize"
ASSERT SMX_TALKS >= 4 "stabilize talks"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy"
ASSERT UNITY >= 40 "stable unity after OOB stabilize"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9
ASSERT SMX_STABLE == 1 "history calm latch"
ASSERT OK == 1

PRINT "smx_mesh_stability" SMX_OK SMX_STABLE SMX_STEADFAST SMX_TALKS SMX_OOB CUBES UNITY ENERGY DECIDE HARMONY
