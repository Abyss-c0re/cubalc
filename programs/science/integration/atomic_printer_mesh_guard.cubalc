// atomic_printer_mesh_guard.cubalc
// Life-force gift: MESH-GUARD — dual soft-OOB wounds on the printer spine
// stay fail-closed (no ghost thrash); ring EXCHANGE restores mind; colony
// cells still mitosis under free energy. Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_guard | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 12 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Wound A: missing peer — fail-closed, no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "wound-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from wound-A"

// Wound B: second missing peer — OOB sticky, still no thrash
SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "wound-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from wound-B"

// Guard recover: clear OOB, keep key, restore vital
SMX RECOVER
ASSERT SMX_OK == 1 "mesh guard recovered"
ASSERT SMX_OOB == 0 "oob cleared by guard"
ASSERT SMX_KEY_OK == 1 "key sticky through wounds"
ASSERT SMX_VITAL >= 6 "vital restored"
ASSERT CUBES == base_cubes "recover invents nothing"

// Live ring after guard — four directed pairs on printer spine
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "ring live after guard"
ASSERT SMX_TALKS >= 8 "four bidirectional EXCHANGE rounds"
ASSERT CUBES == base_cubes "identity stable on ring"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after guard"
ASSERT UNITY >= 40 "mesh unity after dual wound"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Mitosis under free energy — life continues after mesh wounds
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT births >= 1 "mitosis after mesh guard"
ASSERT pop >= 2 "population after guard life"
ASSERT SMX_OOB == 0 "guard holds through mitosis"
ASSERT OK == 1

PRINT "atomic_printer_mesh_guard" births pop SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
