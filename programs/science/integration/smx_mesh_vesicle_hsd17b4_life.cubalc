ASSERT LAST_N == eggt - 3 "smx ggt e-3"
GETF vesicle atp
ASSERT LAST_N == aggt - 3 "smx ggt a-3"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive post-ggt"

SEND vesicle photosynth 18
SEND vesicle charge 22
SEND vesicle feed 16
SEND vesicle dug1 3
ASSERT LAST_N == 3 "smx pre dug1 3"
SEND vesicle photosynth 18
SEND vesicle charge 22
SEND vesicle feed 16
SEND vesicle cdo1 3
ASSERT LAST_N == 3 "smx pre cdo1 3"
SEND vesicle photosynth 18
SEND vesicle charge 22
SEND vesicle feed 16
GETF vesicle heat
LET hcsad = LAST_N
GETF vesicle energy
LET ecsad = LAST_N
GETF vesicle atp
LET acsad = LAST_N
SEND vesicle csad 3
ASSERT LAST_N == 3 "smx csad 3"
GETF vesicle heat
ASSERT LAST_N == hcsad + 3 "smx csad h+3"
GETF vesicle energy
ASSERT LAST_N == ecsad - 3 "smx csad e-3"
GETF vesicle atp
ASSERT LAST_N == acsad - 3 "smx csad a-3"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive post-csad"
SEND vesicle photosynth 10
SEND vesicle charge 12
SEND vesicle feed 8
GETF vesicle heat
LET vhf = LAST_N
GETF vesicle energy
LET vef = LAST_N
GETF vesicle atp
LET vaf = LAST_N
SEND vesicle fmo1 3
ASSERT LAST_N == 3 "smx fmo1 3"
GETF vesicle heat
ASSERT LAST_N == vhf + 3 "smx fmo1 h+3"
GETF vesicle energy
ASSERT LAST_N == vef - 3 "smx fmo1 e-3"
GETF vesicle atp
ASSERT LAST_N == vaf - 3 "smx fmo1 a-3"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive post-fmo1"

SEND vesicle photosynth 12
SEND vesicle charge 10
SEND vesicle feed 8
SEND vesicle baat 2
ASSERT LAST_N == 2 "smx baat vesicle"
GETF vesicle alive
ASSERT LAST_N == 1 "smx vesicle alive post-baat"
SEND vesicle photosynth 12
SEND vesicle charge 10
SEND vesicle feed 8
GETF vesicle heat
LET vhb = LAST_N
GETF vesicle energy
LET veb = LAST_N
GETF vesicle atp
LET vab = LAST_N
GETF vesicle age
LET vageb = LAST_N
GETF vesicle pcr
LET vpcrb = LAST_N
GETF vesicle reserve
LET vrsvb = LAST_N
GETF vesicle pmf
LET vpmfb = LAST_N
GETF vesicle threshold
LET vthrb = LAST_N
SEND vesicle oatp1b1 2
ASSERT LAST_N == 2 "smx oatp1b1 vesicle"
GETF vesicle heat
ASSERT LAST_N == vhb + 2 "smx oatp1b1 h+2"
GETF vesicle energy
ASSERT LAST_N == veb - 2 "smx oatp1b1 e-2"
GETF vesicle atp
ASSERT LAST_N == vab - 2 "smx oatp1b1 a-2"
GETF vesicle age
ASSERT LAST_N == vageb "smx oatp1b1 age held"
GETF vesicle pcr
ASSERT LAST_N == vpcrb "smx oatp1b1 pcr held"
GETF vesicle reserve
ASSERT LAST_N == vrsvb "smx oatp1b1 reserve held"
GETF vesicle pmf
ASSERT LAST_N == vpmfb "smx oatp1b1 pmf held"
GETF vesicle threshold
ASSERT LAST_N == vthrb "smx oatp1b1 thr held"
GETF vesicle alive
ASSERT LAST_N == 1 "smx vesicle alive post-oatp1b1"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
GETF vesicle heat
LET smxmp_h = LAST_N
GETF vesicle energy
LET smxmp_e = LAST_N
GETF vesicle atp
LET smxmp_a = LAST_N
SEND vesicle mrp2 2
ASSERT LAST_N == 2 "smxmp mrp2"
GETF vesicle heat
ASSERT LAST_N == smxmp_h + 2 "smxmp mrp2 h+2"
GETF vesicle energy
ASSERT LAST_N == smxmp_e - 2 "smxmp mrp2 e-2"
GETF vesicle atp
ASSERT LAST_N == smxmp_a - 2 "smxmp mrp2 a-2"
GETF vesicle alive
ASSERT LAST_N == 1 "smxmp alive post-mrp2"

# Asbt apical uptake after Ost
SEND vesicle photosynth 16
SEND vesicle charge 14
SEND vesicle feed 12
GETF vesicle heat
LET vash = LAST_N
GETF vesicle energy
LET vase = LAST_N
GETF vesicle atp
LET vasa = LAST_N
SEND vesicle asbt 2
ASSERT LAST_N == 2 "smx asbt 2"
GETF vesicle heat
ASSERT LAST_N == vash + 2 "smx asbt h+2"
GETF vesicle energy
ASSERT LAST_N == vase - 2 "smx asbt e-2"
GETF vesicle atp
ASSERT LAST_N == vasa - 2 "smx asbt a-2"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive post-asbt"
SEND vesicle asbt 0
ASSERT LAST_N == 0 "smx asbt n0"

ASSERT 1 == 1 "smx_mesh_vesicle_asbt_life checkpoint"

# Ost basolateral overflow after Mrp3 on vesicle
SEND vesicle photosynth 14
SEND vesicle charge 12
SEND vesicle feed 10
GETF vesicle heat
LET m3vh = LAST_N
GETF vesicle energy
LET m3ve = LAST_N
GETF vesicle atp
LET m3va = LAST_N
SEND vesicle ost 2
ASSERT LAST_N == 2 "smx ost 2"
GETF vesicle heat
ASSERT LAST_N == m3vh + 2 "smx ost h+2"
GETF vesicle energy
ASSERT LAST_N == m3ve - 2 "smx ost e-2"
GETF vesicle atp
ASSERT LAST_N == m3va - 2 "smx ost a-2"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive post-ost"
SEND vesicle ost 0
ASSERT LAST_N == 0 "smx ost n0"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive final ost"


# KLB hepatic RTK after FGF19 enterokine
SEND vesicle photosynth 14
SEND vesicle charge 12
SEND vesicle feed 10
GETF vesicle heat
LET vfbh = LAST_N
GETF vesicle energy
LET vfbe = LAST_N
GETF vesicle atp
LET vfba = LAST_N
SEND vesicle fabp6 2
ASSERT LAST_N == 2 "smx fabp6 2"
GETF vesicle heat
ASSERT LAST_N == vfbh + 2 "smx fabp6 h+2"
GETF vesicle energy
ASSERT LAST_N == vfbe - 2 "smx fabp6 e-2"
GETF vesicle atp
ASSERT LAST_N == vfba - 2 "smx fabp6 a-2"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive post-fabp6"
SEND vesicle fabp6 0
ASSERT LAST_N == 0 "smx fabp6 n0"
GETF vesicle alive
ASSERT LAST_N == 1 "smx alive final fabp6"
ASSERT 1 == 1 "smx_mesh_vesicle_klb_life PASS"

