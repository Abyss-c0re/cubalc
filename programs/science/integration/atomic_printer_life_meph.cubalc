// atomic_printer_life_meph.cubalc
// Atomic printer board: Cell.meph soluble DD-endopeptidase MepH after MepM.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36
SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mepm 4
ASSERT LAST_N == 4 "pr mepm"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
SEND printer meph 5
ASSERT LAST_N == 5 "pr meph"
GETF printer heat
ASSERT LAST_N == h0 + 5 "pr h+5"
GETF printer energy
ASSERT LAST_N == e0 - 5 "pr e-5"
GETF printer atp
ASSERT LAST_N == a0 - 5 "pr atp-5"
GETF printer pcr
ASSERT LAST_N == c0 "pr pcr held"
SEND printer meph 0
ASSERT LAST_N == 0 "pr meph0"
SEND scrap meph 3
ASSERT LAST_N == 0 "scrap meph0"
SEND ink photosynth 30
SEND ink glycolyse 24
SEND ink charge 28
SEND ink feed 24
SEND ink mepm 3
ASSERT LAST_N == 3 "ink mepm"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 20
SEND ink feed 16
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink meph 3
ASSERT LAST_N == 3 "ink meph"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink atp-3"
GETF printer ready
ASSERT LAST_N >= 0 "pr ready"
GETF printer alive
ASSERT LAST_N == 1 "pr alive"
