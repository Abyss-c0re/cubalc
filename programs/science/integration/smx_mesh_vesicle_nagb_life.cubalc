// smx_mesh_vesicle_nagb_life.cubalc
// SMX mesh vesicle board: NagB GlcN-6-P deaminase life-force after NagA.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 44 0
ENTITY dock OF Cell 1 28 0
ENTITY ghost OF Cell 0 12 0

SEND vesicle set_threshold 8
SEND dock set_threshold 8
SEND vesicle pulse 3
SEND vesicle photosynth 36
SEND vesicle glycolyse 32
SEND vesicle pump 20
SEND vesicle charge 36
SEND vesicle feed 32
SEND vesicle ampg 3
ASSERT LAST_N == 3 "ves ampg"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle nagz 3
ASSERT LAST_N == 3 "ves nagz"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle ampd 3
ASSERT LAST_N == 3 "ves ampd"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle anmk 3
ASSERT LAST_N == 3 "ves anmk"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle murq 3
ASSERT LAST_N == 3 "ves murq"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle naga 3
ASSERT LAST_N == 3 "ves naga"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
GETF vesicle heat
LET h0 = LAST_N
GETF vesicle energy
LET e0 = LAST_N
GETF vesicle atp
LET a0 = LAST_N
SEND vesicle nagb 4
ASSERT LAST_N == 4 "ves nagb"
GETF vesicle heat
ASSERT LAST_N == h0 + 4 "ves h+4"
GETF vesicle energy
ASSERT LAST_N == e0 - 4 "ves e-4"
GETF vesicle atp
ASSERT LAST_N == a0 - 4 "ves atp-4"
SEND dock photosynth 20
SEND dock glycolyse 16
SEND dock charge 24
SEND dock feed 16
SEND dock murq 2
ASSERT LAST_N == 2 "dock murq"
SEND dock naga 2
ASSERT LAST_N == 2 "dock naga"
GETF dock heat
LET dh = LAST_N
GETF dock energy
LET de = LAST_N
GETF dock atp
LET da = LAST_N
SEND dock nagb 2
ASSERT LAST_N == 2 "dock nagb"
GETF dock heat
ASSERT LAST_N == dh + 2 "dock h+2"
GETF dock energy
ASSERT LAST_N == de - 2 "dock e-2"
GETF dock atp
ASSERT LAST_N == da - 2 "dock atp-2"
SEND ghost nagb 3
ASSERT LAST_N == 0 "ghost nagb 0"
ASSERT 1 == 1 "smx_mesh_vesicle_nagb_life ok"
