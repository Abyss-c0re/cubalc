// atomic_printer_life_anmk.cubalc
// Atomic printer board: Cell.anmk AnmK anhMurNAc kinase after AmpD.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36
SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mepm 4
ASSERT LAST_N == 4 "pr mepm"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
SEND printer anmk 5
ASSERT LAST_N == 5 "pr anmk"
GETF printer heat
ASSERT LAST_N == h0 + 5 "pr h+5"
GETF printer energy
ASSERT LAST_N == e0 - 5 "pr e-5"
GETF printer atp
ASSERT LAST_N == a0 - 5 "pr atp-5"
GETF printer pcr
ASSERT LAST_N == c0 "pr pcr held"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink anmk 3
ASSERT LAST_N == 3 "ink anmk"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink h+3"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink atp-3"
SEND scrap anmk 4
ASSERT LAST_N == 0 "scrap dead anmk"
// continuum seal meps->...->anmk
SEND printer photosynth 32
SEND printer glycolyse 28
SEND printer charge 40
SEND printer feed 28
GETF printer heat
LET hx = LAST_N
GETF printer energy
LET ex = LAST_N
GETF printer atp
LET ax = LAST_N
SEND printer meps 2
ASSERT LAST_N == 2 "seal meps"
SEND printer mepm 2
ASSERT LAST_N == 2 "seal mepm"
SEND printer meph 2
ASSERT LAST_N == 2 "seal meph"
SEND printer slt 2
ASSERT LAST_N == 2 "seal slt"
SEND printer ampg 2
ASSERT LAST_N == 2 "seal ampg"
SEND printer nagz 2
ASSERT LAST_N == 2 "seal nagz"
SEND printer ampd 2
ASSERT LAST_N == 2 "seal ampd"
SEND printer anmk 2
ASSERT LAST_N == 2 "seal anmk"
GETF printer heat
ASSERT LAST_N == hx + 16 "seal h+16"
GETF printer energy
ASSERT LAST_N == ex - 16 "seal e-16"
GETF printer atp
ASSERT LAST_N == ax - 16 "seal atp-16"
ASSERT 1 == 1 "atomic_printer_life_anmk ok"
