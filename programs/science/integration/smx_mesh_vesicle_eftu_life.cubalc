// smx_mesh_vesicle_eftu_life.cubalc
// SMX mesh vesicle life-force: EF-Tu ternary A-site delivery after aars.
// Cube is SoT. Free energy must flow.
REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 44 0
SEND vesicle set_threshold 8
SEND vesicle pulse 4
SEND vesicle photosynth 32
SEND vesicle glycolyse 28
SEND vesicle pump 18
SEND vesicle photophos 18
SEND vesicle charge 26
SEND vesicle feed 26
SEND vesicle retrieve 2
SEND vesicle acidify 2
SEND vesicle mature 2
SEND vesicle recruit 2
SEND vesicle activate 2
SEND vesicle degrade 2
SEND vesicle export 2
SEND vesicle translate 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 14
SEND vesicle feed 12
SEND vesicle transloc 2
SEND vesicle cleave 2
SEND vesicle glycosyl 2
SEND vesicle trim 3
ASSERT LAST_N == 3 "smx trim3"
SEND vesicle cnx 2
ASSERT LAST_N == 2 "smx cnx2"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 12
SEND vesicle charge_pcr 14
SEND vesicle uggt 2
ASSERT LAST_N == 2 "smx uggt2"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 12
SEND vesicle mann 3
ASSERT LAST_N == 3 "smx pre mann3"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle os9 2
ASSERT LAST_N == 2 "smx pre os92"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle hrd 2
ASSERT LAST_N == 2 "smx pre hrd2"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle vcp 2
ASSERT LAST_N == 2 "smx pre vcp2"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle psm 2
ASSERT LAST_N == 2 "smx pre psm2"
GETF vesicle heat
LET h0 = LAST_N
GETF vesicle energy
LET e0 = LAST_N
GETF vesicle atp
LET a0 = LAST_N
GETF vesicle pcr
LET c0 = LAST_N
GETF vesicle age
LET age0 = LAST_N
GETF vesicle reserve
LET r0 = LAST_N
GETF vesicle pmf
LET pm0 = LAST_N
GETF vesicle threshold
LET t0 = LAST_N
GETF vesicle setpoint
LET s0 = LAST_N
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle pepr 2
ASSERT LAST_N == 2 "pre pepr2"
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle aars 2
ASSERT LAST_N == 2 "pre aars2"
GETF vesicle heat
LET heb0 = LAST_N
GETF vesicle energy
LET enb1 = LAST_N
GETF vesicle atp
LET atb2 = LAST_N
GETF vesicle reserve
LET reb3 = LAST_N
GETF vesicle age
LET agb4 = LAST_N
GETF vesicle pcr
LET pcb5 = LAST_N
GETF vesicle pmf
LET pmb6 = LAST_N
GETF vesicle setpoint
LET seb7 = LAST_N
GETF vesicle threshold
LET thb8 = LAST_N
SEND vesicle eftu 2
ASSERT LAST_N == 2 "eftu2"
GETF vesicle heat
ASSERT LAST_N == heb0 + 2 "h+2"
GETF vesicle energy
ASSERT LAST_N == enb1 - 2 "ene-2"
GETF vesicle atp
ASSERT LAST_N == atb2 - 2 "atp-2"
GETF vesicle reserve
ASSERT LAST_N == reb3 "res held"
GETF vesicle age
ASSERT LAST_N == agb4 "age held"
GETF vesicle pcr
ASSERT LAST_N == pcb5 - 2 "pcr-2"
GETF vesicle pmf
ASSERT LAST_N == pmb6 "pmf held"
GETF vesicle setpoint
ASSERT LAST_N == seb7 "set held"
GETF vesicle threshold
ASSERT LAST_N == thb8 "thr held"
SEND vesicle photosynth 18
SEND vesicle glycolyse 14
SEND vesicle charge 18
SEND vesicle feed 14
SEND vesicle charge_pcr 8
SEND vesicle mann 3
ASSERT LAST_N == 3 "smx pre2 mann3"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle os9 3
ASSERT LAST_N == 3 "smx pre2 os93"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle hrd 2
ASSERT LAST_N == 2 "smx pre2 hrd2"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle vcp 2
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle psm 2
GETF vesicle heat
LET h1 = LAST_N
GETF vesicle reserve
LET r1 = LAST_N
GETF vesicle pcr
LET c1 = LAST_N
GETF vesicle atp
LET a1 = LAST_N
GETF vesicle energy
LET e1 = LAST_N
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle pepr 3
ASSERT LAST_N == 3 "pre pepr3"
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle aars 3
ASSERT LAST_N == 3 "pre aars3"
GETF vesicle heat
LET heb0 = LAST_N
GETF vesicle reserve
LET reb1 = LAST_N
GETF vesicle pcr
LET pcb2 = LAST_N
GETF vesicle atp
LET atb3 = LAST_N
GETF vesicle energy
LET enb4 = LAST_N
SEND vesicle eftu 3
ASSERT LAST_N == 3 "eftu3"
GETF vesicle heat
ASSERT LAST_N == heb0 + 3 "h+3"
GETF vesicle reserve
ASSERT LAST_N == reb1 "res held"
GETF vesicle pcr
ASSERT LAST_N == pcb2 - 3 "pcr-3"
GETF vesicle atp
ASSERT LAST_N == atb3 - 3 "atp-3"
GETF vesicle energy
ASSERT LAST_N == enb4 - 3 "ene-3"
ASSERT 1 == 1 "smx_mesh_vesicle_eftu_life_ok"

PRINT "smx_mesh_vesicle_eftu_life PASS"
