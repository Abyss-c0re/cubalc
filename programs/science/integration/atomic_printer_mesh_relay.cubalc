// atomic_printer_mesh_relay.cubalc
// Life-force gift: MESH-RELAY — soft-OOB storm wounds fail-closed on the
// printer spine; RECOVER restores vital/key; multi-hop SEAL/OPEN relays carry
// matrix mind across opposite edges; VITAL/STATUS ring + mitosis under free
// energy. Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_relay | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 12 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Seal-wound: missing peer — fail-closed, no ghost place
SMX EXCHANGE hive offworld_relay
ASSERT SMX_OK == 0 "relay-wound soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from relay-wound"

// Storm B: second missing peer — OOB sticky, still no thrash
SMX TALK nozzle ghost_relay
ASSERT SMX_OK == 0 "relay-ghost soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from relay-ghost"

SMX EXCHANGE scrap void_relay
ASSERT SMX_OK == 0 "relay-void soft-OOB"
ASSERT SMX_OOB >= 3 "oob C storm depth"
ASSERT CUBES == base_cubes "no ghost relay-void"

// Seal recover: clear OOB, keep key, restore vital
SMX RECOVER
ASSERT SMX_OK == 1 "mesh relay recovered"
ASSERT SMX_OOB == 0 "oob cleared by recover"
ASSERT SMX_KEY_OK == 1 "key sticky through storm"
ASSERT SMX_VITAL >= 6 "vital restored"
ASSERT CUBES == base_cubes "recover invents nothing"

// MESH-RELAY: 3-hop SEAL/OPEN file-bus matrix gift
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "pre-relay ring ok"
ASSERT SMX_TALKS >= 2 "pre-relay talks"

SMX SEAL bed hive "state/smx_relay/hop_bh.cblc"
ASSERT SMX_OK == 1 "seal hop1 bed hive"
ASSERT SMX_N > 64 "hop1 frame size"

SMX OPEN scrap "state/smx_relay/hop_bh.cblc"
ASSERT SMX_OK == 1 "open hop1 onto scrap"
ASSERT CUBES == base_cubes "hop1 invents no cubes"

// hop1 already: bed->hive sealed, opened onto scrap
// hop2: scrap->nozzle sealed, opened onto hive (return)
SMX SEAL scrap nozzle "state/smx_relay/hop_sn.cblc"
ASSERT SMX_OK == 1 "seal hop2 scrap nozzle"
ASSERT SMX_N > 64 "hop2 frame size"

SMX OPEN hive "state/smx_relay/hop_sn.cblc"
ASSERT SMX_OK == 1 "open hop2 onto hive"
ASSERT CUBES == base_cubes "hop2 invents nothing"

// hop3: nozzle->bed sealed, opened onto scrap (close triangle)
SMX SEAL nozzle bed "state/smx_relay/hop_nb.cblc"
ASSERT SMX_OK == 1 "seal hop3 nozzle bed"
ASSERT SMX_N > 64 "hop3 frame size"

SMX OPEN scrap "state/smx_relay/hop_nb.cblc"
ASSERT SMX_OK == 1 "open hop3 onto scrap"
ASSERT CUBES == base_cubes "hop3 invents nothing"

SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after relay"
ASSERT SMX_KEY_OK == 1 "key after relay"
ASSERT SMX_VITAL >= 6 "vital holds after seal open"
ASSERT SMX_OOB == 0 "no oob after relay"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

SMX EXCHANGE bed hive
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "post-relay ring"
ASSERT SMX_TALKS >= 4 "talks after relay ring"
ASSERT CUBES == base_cubes "bridge invents nothing"
COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after relay"
ASSERT UNITY >= 40 "mesh unity after mesh relay"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Mitosis under free energy — life continues after mesh storm
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT births >= 1 "mitosis after mesh relay"
ASSERT pop >= 2 "population after relay life"
ASSERT SMX_OOB == 0 "guard holds through mitosis"
ASSERT OK == 1

PRINT "mesh_relay" births pop SMX_N SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
