// atomic_printer_life_uncouple.cubalc
// Science board: atomic printer + life_cell UCP thermogenesis (pmf to heat).
// Proton leak sheds yield as warmth; residual gradient still fuels synthase.
// Gift: CubalC life-force substrate. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_uncouple | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 4 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"
ASSERT ENERGY > 0 "energy flows"

// Chemios + uncouple: feed -> pump -> partial uncouple -> synthase -> oxidize
GETF seed energy
ASSERT LAST_N == 4 "life spark 4"
SEND seed feed 8
ASSERT LAST_N == 12 "fed to 12"
SEND seed pump 6
ASSERT LAST_N == 6 "pump 6"
SEND seed gradient
ASSERT LAST_N == 6 "pmf 6"
GETF seed energy
ASSERT LAST_N == 6 "active 6"
SEND seed yield
ASSERT LAST_N == 12 "yield conserved"

SEND seed uncouple 2
ASSERT LAST_N == 2 "uncouple 2"
GETF seed heat
ASSERT LAST_N == 2 "heat 2"
SEND seed gradient
ASSERT LAST_N == 4 "pmf 4"
SEND seed yield
ASSERT LAST_N == 10 "yield shed heat"

SEND seed synthase 3
ASSERT LAST_N == 3 "synthase 3"
SEND seed charged
ASSERT LAST_N == 3 "atp 3"
SEND seed gradient
ASSERT LAST_N == 1 "pmf 1"
SEND seed oxidize 3
ASSERT LAST_N == 3 "oxidize 3"
GETF seed energy
ASSERT LAST_N == 9 "active 9"
GETF seed heat
ASSERT LAST_N == 2 "heat ledger held"
SEND seed yield
ASSERT LAST_N == 10 "yield after oxidize"

SEND seed feed 1
ASSERT LAST_N == 10 "fed to 10"
GETF seed ready
ASSERT LAST_N == 1 "ready at thr"
SEND seed yield
ASSERT LAST_N == 11 "yield 10e+1pmf"

// Mitosis on printer bed
GETF seed energy
LET half = LAST_N / 2
IF half < 1 THEN
  LET half = 1
END
SEND seed after_div
ASSERT LAST_N >= 1 "parent halved"
SEND d1 birth half 1
ASSERT LAST_N == 1 "daughter birth"
GETF d1 alive
ASSERT LAST_N == 1 "daughter alive"
GETF d1 gen
ASSERT LAST_N == 1 "daughter gen 1"
GETF seed alive
ASSERT LAST_N == 1 "parent lives"

SEND d1 gradient
ASSERT LAST_N == 0 "daughter pmf 0"
GETF d1 heat
ASSERT LAST_N == 0 "daughter heat 0"
SEND d1 charged
ASSERT LAST_N == 0 "daughter atp 0"

SEND d1 photophos 5
ASSERT LAST_N == 5 "daughter solar"
SEND d1 reverse 4
ASSERT LAST_N == 4 "daughter reverse"
SEND d1 uncouple 3
ASSERT LAST_N == 3 "daughter uncouple"
GETF d1 heat
ASSERT LAST_N == 3 "daughter heat 3"
SEND d1 synthase 1
ASSERT LAST_N == 1 "daughter synthase"
SEND d1 charged
ASSERT LAST_N == 2 "daughter atp 5-4+1"
SEND d1 yield
ASSERT LAST_N == half + 2 "daughter yield heat shed"

ASSERT 1 == 1 "atomic_printer_life_uncouple PASS"
