// atomic_printer_colony_breath.cubalc
// Life-force gift: colony breath on atomic printer spine.
// Breath = ENERGYFLOW inhale + SEND tick metabolism + scrap recycle.
// Three living cells hold pop across breath cycles; mesh sticky.
// Wonder AGI can RUN: breath, not dual ladders.
// Cube is SoT · free energy must flow · matrix is key.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_colony_breath | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG scrap hive
PLUG bed scrap

ENTITY c0 OF Cell 1 14 0
ENTITY c1 OF Cell 0 0 0
ENTITY c2 OF Cell 0 0 0
PLUG bed c0

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE scrap 1
ENERGYFLOW 6
FLOW 4

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
ASSERT SMX_OK == 1 "spine mesh live"
ASSERT SMX_TALKS >= 6 "three EXCHANGE rounds"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy"
ASSERT UNITY >= 50 "mesh unity"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Seed colony: founder divides into c1 then c2
LET births = 0
LET step = 0
WHILE step < 12
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  SEND c0 tick
  SEND c1 tick
  SEND c2 tick

  GETF c0 alive
  LET al = LAST_N
  GETF c0 ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF c1 alive
      IF LAST_N == 0 THEN
        GETF c0 energy
        LET half = LAST_N / 2
        IF half < 1 THEN
          LET half = 1
        END
        GETF c0 gen
        LET dg = LAST_N + 1
        SEND c1 birth half dg
        SEND c0 after_div
        PLUG bed c1
        LET births = births + 1
      ELSE
        GETF c2 alive
        IF LAST_N == 0 THEN
          GETF c0 energy
          LET half = LAST_N / 2
          IF half < 1 THEN
            LET half = 1
          END
          GETF c0 gen
          LET dg = LAST_N + 1
          SEND c2 birth half dg
          SEND c0 after_div
          PLUG bed c2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF c0 alive
LET a0 = LAST_N
GETF c1 alive
LET a1 = LAST_N
GETF c2 alive
LET a2 = LAST_N
LET pop0 = a0 + a1 + a2
ASSERT births >= 2 "colony seeded"
ASSERT pop0 >= 3 "full colony before breath"

// Colony breath cycles: inhale energy, metabolize, recycle via scrap mesh
LET breaths = 0
LET min_pop = pop0
LET b = 0
WHILE b < 4
  // inhale
  ENERGYFLOW 3
  FLOW 2
  SMX EXCHANGE bed scrap
  SMX EXCHANGE scrap hive
  // metabolize each living voxel
  SEND c0 tick
  SEND c1 tick
  SEND c2 tick
  TICK 1
  // exhale / re-harmonize
  COMPARE bed hive
  HARMONY hive
  RESOLVE hive
  LET breaths = breaths + 1

  GETF c0 alive
  LET x0 = LAST_N
  GETF c1 alive
  LET x1 = LAST_N
  GETF c2 alive
  LET x2 = LAST_N
  LET pnow = x0 + x1 + x2
  IF pnow < min_pop THEN
    LET min_pop = pnow
  END
  LET b = b + 1
END

GETF c0 alive
LET f0 = LAST_N
GETF c1 alive
LET f1 = LAST_N
GETF c2 alive
LET f2 = LAST_N
LET popf = f0 + f1 + f2

ASSERT breaths == 4 "four breath cycles"
ASSERT popf >= 3 "colony holds through breath"
ASSERT min_pop >= 3 "no death during breath"
ASSERT SMX_OK == 1 "mesh sticky through breath"
ASSERT ENERGY > 0 "energy still flows"
ASSERT UNITY >= 40 "unity after breath"
ASSERT OK == 1

PRINT "atomic_printer_colony_breath" births breaths pop0 popf min_pop DECIDE ENERGY UNITY SMX_TALKS CUBES
