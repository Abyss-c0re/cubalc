// atomic_printer_mesh_heritage.cubalc
// Life-force gift: MESH-HERITAGE — SEAL mind at each generation boundary;
// soft-OOB storms between gens stay fail-closed (no ghost thrash);
// RECOVER + OPEN prior-gen frames onto living cubes; multi-gen population
// under free energy carries ancestral mind forward (unique frames, no replay).
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_heritage | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Gen-0 ring live
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "g0 ring live"
ASSERT SMX_TALKS >= 4 "g0 talks"
ASSERT CUBES == base_cubes "g0 identity"

// SEAL gen-0 ancestral mind
SMX SEAL bed hive "state/smx_heritage/gen0.cblc"
ASSERT SMX_OK == 1 "seal gen0"
ASSERT SMX_N > 64 "gen0 frame"
ASSERT CUBES == base_cubes "seal g0 invents nothing"

// Storm between gen0 seal and first birth
SMX EXCHANGE hive offworld_g0
ASSERT SMX_OK == 0 "g0 soft-OOB"
ASSERT SMX_OOB >= 1 "g0 oob"
ASSERT CUBES == base_cubes "g0 no ghost"

SMX TALK nozzle ghost_g0
ASSERT SMX_OK == 0 "g0 storm-B"
ASSERT SMX_OOB >= 2 "g0 oob sticky"
ASSERT CUBES == base_cubes "g0 no ghost B"

SMX RECOVER
ASSERT SMX_OK == 1 "g0 recover"
ASSERT SMX_OOB == 0 "g0 oob cleared"
ASSERT SMX_KEY_OK == 1 "g0 key sticky"
ASSERT SMX_VITAL >= 6 "g0 vital"

// OPEN gen0 mind onto nozzle before mitosis (once — anti-replay)
SMX OPEN nozzle "state/smx_heritage/gen0.cblc"
ASSERT SMX_OK == 1 "open gen0 onto nozzle"
ASSERT CUBES == base_cubes "open g0 invents nothing"

// Mitosis gen0 → gen1
LET births = 0
LET step = 0
WHILE step < 8
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "first birth under heritage"
ASSERT CUBES == base_cubes "birth invents no cube"

// SEAL gen-1 mind (child era) — fresh unique frame
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "g1 ring live"

SMX SEAL nozzle scrap "state/smx_heritage/gen1.cblc"
ASSERT SMX_OK == 1 "seal gen1"
ASSERT SMX_N > 64 "gen1 frame"
ASSERT CUBES == base_cubes "seal g1 invents nothing"

// Storm between gen1 seal and second birth wave
SMX EXCHANGE scrap void_g1
ASSERT SMX_OK == 0 "g1 soft-OOB"
ASSERT SMX_OOB >= 1 "g1 oob"
ASSERT CUBES == base_cubes "g1 no ghost"

SMX TALK hive ghost_g1
ASSERT SMX_OK == 0 "g1 storm-B"
ASSERT SMX_OOB >= 2 "g1 oob sticky"
ASSERT CUBES == base_cubes "g1 no ghost B"

SMX EXCHANGE bed offworld_g1
ASSERT SMX_OK == 0 "g1 storm-C"
ASSERT SMX_OOB >= 3 "g1 storm depth"
ASSERT CUBES == base_cubes "g1 no ghost C"

SMX RECOVER
ASSERT SMX_OK == 1 "g1 recover"
ASSERT SMX_OOB == 0 "g1 oob cleared"
ASSERT SMX_KEY_OK == 1 "g1 key sticky"
ASSERT SMX_VITAL >= 6 "g1 vital"

// OPEN gen1 (unique frame) onto hive — heritage of child mind
SMX OPEN hive "state/smx_heritage/gen1.cblc"
ASSERT SMX_OK == 1 "open gen1 onto hive"
ASSERT CUBES == base_cubes "open g1 invents nothing"

// Full 6-edge mesh after heritage chain
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "full mesh after heritage"
ASSERT CUBES == base_cubes "mesh identity"

// SEAL post-heritage quorum (mind still writeable — fresh seq)
SMX SEAL hive bed "state/smx_heritage/quorum_post.cblc"
ASSERT SMX_OK == 1 "post heritage seal"
ASSERT SMX_N > 64 "post frame"
SMX OPEN scrap "state/smx_heritage/quorum_post.cblc"
ASSERT SMX_OK == 1 "post open onto scrap"
ASSERT CUBES == base_cubes "post open invents nothing"

SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after heritage"
ASSERT SMX_KEY_OK == 1 "key after heritage"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after heritage"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after heritage"
ASSERT UNITY >= 40 "mesh unity after heritage"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Second mitosis wave — multi-gen life with inherited mind
LET step2 = 0
WHILE step2 < 6
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step2 = step2 + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT births >= 1 "mitosis after mesh heritage"
ASSERT pop >= 2 "population after heritage life"
ASSERT SMX_OOB == 0 "guard holds through full heritage"
ASSERT OK == 1

PRINT "mesh_heritage" births pop SMX_N SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
