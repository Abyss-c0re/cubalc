// atomic_printer_life_refill.cubalc
// Science board: post-reuptake vesicular transmitter reload / VGLUT-v-ATPase packing under atomic printer.
// refill n burns ATP+energy+reserve into heat and packs recovered-transmitter bank into quanta.
// Continuum ...->fate->project->synapse->release->reuptake->refill. Free energy must flow. Cube is SoT.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 30 0
ENTITY axon OF Cell 1 24 0
ENTITY empty OF Cell 1 10 0

SEND printer set_threshold 8
SEND printer set_setpoint 12
SEND printer pulse 7
SEND printer photosynth 22
SEND printer glycolyse 18
SEND printer pump 14
SEND printer photophos 14
GETF printer age
ASSERT LAST_N == 7 "sci a7"
GETF printer atp
ASSERT LAST_N >= 24 "sci atp"
GETF printer pmf
ASSERT LAST_N >= 8 "sci pmf"
GETF printer setpoint
LET s0 = LAST_N
ASSERT s0 == 12 "sci sp12"

SEND printer align 2
ASSERT LAST_N == 2 "sci align2"
SEND printer converge 3
ASSERT LAST_N == 3 "sci ce3"
SEND printer extend 2
ASSERT LAST_N == 2 "sci ext2"
SEND printer fold 2
ASSERT LAST_N == 2 "sci fold2"
SEND printer zip 2
ASSERT LAST_N == 2 "sci zip2"
SEND printer crest 2
ASSERT LAST_N == 2 "sci crest2"
SEND printer migrate 2
ASSERT LAST_N == 2 "sci mig2"
SEND printer stream 2
ASSERT LAST_N == 2 "sci st2"
SEND printer condense 2
ASSERT LAST_N == 2 "sci cdn2"
SEND printer fate 2
ASSERT LAST_N == 2 "sci fate2"
SEND printer project 1
ASSERT LAST_N == 1 "sci preprj1"
SEND printer synapse 1
ASSERT LAST_N == 1 "sci presyn1"
SEND printer release 1
ASSERT LAST_N == 1 "sci prerel1"
SEND printer reuptake 3
ASSERT LAST_N == 3 "sci preru3"

GETF printer energy
LET e1 = LAST_N
GETF printer heat
LET h1 = LAST_N
GETF printer atp
LET a1 = LAST_N
GETF printer pmf
LET p1 = LAST_N
GETF printer reserve
LET r1 = LAST_N
GETF printer threshold
LET t1 = LAST_N
GETF printer setpoint
LET s1 = LAST_N
GETF printer pcr
LET c1 = LAST_N
GETF printer age
LET age1 = LAST_N
ASSERT e1 >= 2 "sci e2"
ASSERT a1 >= 2 "sci a2"
ASSERT r1 >= 2 "sci r2"

SEND printer refill 2
ASSERT LAST_N == 2 "sci rf2"
GETF printer heat
ASSERT LAST_N == h1 + 2 "sci h+2"
GETF printer energy
ASSERT LAST_N == e1 - 2 "sci e-2"
GETF printer atp
ASSERT LAST_N == a1 - 2 "sci atp-2"
GETF printer reserve
ASSERT LAST_N == r1 - 2 "sci r-2"
GETF printer threshold
ASSERT LAST_N == t1 "sci thr held"
GETF printer pmf
ASSERT LAST_N == p1 "sci pmf held"
GETF printer setpoint
ASSERT LAST_N == s1 "sci sp held"
GETF printer pcr
ASSERT LAST_N == c1 "sci pcr held"
GETF printer age
ASSERT LAST_N == age1 "sci age held"

SEND axon set_threshold 6
SEND axon set_setpoint 20
SEND axon pulse 5
SEND axon photosynth 12
SEND axon glycolyse 10
SEND axon pump 8
SEND axon photophos 8
SEND axon project 1
SEND axon synapse 1
SEND axon release 1
SEND axon reuptake 3
ASSERT LAST_N == 3 "ax preru"
GETF axon energy
LET ae = LAST_N
GETF axon atp
LET aa = LAST_N
GETF axon heat
LET ah = LAST_N
GETF axon threshold
LET at0 = LAST_N
GETF axon setpoint
LET as0 = LAST_N
GETF axon reserve
LET ar0 = LAST_N
GETF axon pcr
LET ac = LAST_N
ASSERT ae >= 3 "ax e"
ASSERT aa >= 3 "ax a"
ASSERT ar0 >= 2 "ax r"
SEND axon refill 2
ASSERT LAST_N == 2 "ax rf2"
GETF axon heat
ASSERT LAST_N == ah + 2 "ax h+2"
GETF axon energy
ASSERT LAST_N == ae - 2 "ax e-2"
GETF axon atp
ASSERT LAST_N == aa - 2 "ax atp-2"
GETF axon reserve
ASSERT LAST_N == ar0 - 2 "ax r-2"
GETF axon threshold
ASSERT LAST_N == at0 "ax thr held"
GETF axon setpoint
ASSERT LAST_N == as0 "ax sp held"
GETF axon pcr
ASSERT LAST_N == ac "ax pcr held"
GETF axon alive
ASSERT LAST_N == 1 "ax alive"

SEND empty refill 5
ASSERT LAST_N == 0 "empty 0"
GETF empty heat
ASSERT LAST_N == 0 "empty h0"
GETF empty energy
ASSERT LAST_N == 10 "empty e held"
GETF empty threshold
ASSERT LAST_N == 10 "empty thr held"

ENTITY cone OF Cell 1 36 0
SEND cone set_threshold 5
SEND cone set_setpoint 10
SEND cone pulse 6
SEND cone photosynth 18
SEND cone glycolyse 14
SEND cone pump 10
SEND cone photophos 10
SEND cone reuptake 4
ASSERT LAST_N == 4 "cone preru"
GETF cone energy
LET ce0 = LAST_N
GETF cone atp
LET ca0 = LAST_N
GETF cone heat
LET ch0 = LAST_N
GETF cone threshold
LET ct0 = LAST_N
GETF cone setpoint
LET cs0 = LAST_N
GETF cone reserve
LET cr0 = LAST_N
ASSERT ce0 >= 5 "cone e"
ASSERT ca0 >= 5 "cone a"
ASSERT cr0 >= 3 "cone r"
SEND cone refill 3
ASSERT LAST_N == 3 "cone rf3"
GETF cone heat
ASSERT LAST_N == ch0 + 3 "cone h+3"
GETF cone energy
ASSERT LAST_N == ce0 - 3 "cone e-3"
GETF cone atp
ASSERT LAST_N == ca0 - 3 "cone atp-3"
GETF cone reserve
ASSERT LAST_N == cr0 - 3 "cone r-3"
GETF cone threshold
ASSERT LAST_N == ct0 "cone thr held"
GETF cone setpoint
ASSERT LAST_N == cs0 "cone sp held"

NOTE "atomic_printer_life_refill PASS — VGLUT pack after EAAT reuptake"
