// atomic_printer_life_crest.cubalc
// Science integration: neural-crest EMT after neural-tube zipper.
// Atomic printer continuum: converge -> extend -> fold -> zip -> crest.
// Snail/Slug EMT burns ATP into heat + raises energy for multipotent stream. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY plate OF Cell 1 28 0
ENTITY hinge OF Cell 1 22 0
ENTITY stream OF Cell 1 18 0

SEND plate set_threshold 10
SEND hinge set_threshold 10
SEND stream set_threshold 10

SEND plate pulse 4
SEND plate photosynth 14
SEND plate glycolyse 12
SEND plate pump 10
SEND plate photophos 10
GETF plate atp
ASSERT LAST_N >= 20 "sci atp"
GETF plate energy
LET e0 = LAST_N
GETF plate heat
LET h0 = LAST_N
GETF plate reserve
LET r0 = LAST_N
GETF plate threshold
ASSERT LAST_N == 10 "sci thr0"
GETF plate pmf
LET p0 = LAST_N
GETF plate setpoint
LET s0 = LAST_N
GETF plate pcr
LET c0 = LAST_N
GETF plate age
LET a0 = LAST_N

SEND plate converge 4
ASSERT LAST_N == 4 "sci ce4"
GETF plate reserve
ASSERT LAST_N == r0 + 4 "sci r+4"

SEND plate extend 3
ASSERT LAST_N == 3 "sci ext3"
GETF plate energy
LET e1 = LAST_N
ASSERT e1 == e0 + 3 "sci e+3"
GETF plate reserve
LET r1 = LAST_N
ASSERT r1 == r0 + 1 "sci r after ext"

SEND plate fold 3
ASSERT LAST_N == 3 "sci fold3"
GETF plate energy
LET e2 = LAST_N
ASSERT e2 == e1 - 3 "sci e after fold"
GETF plate heat
LET h2 = LAST_N
GETF plate atp
LET a2 = LAST_N
GETF plate threshold
LET t2 = LAST_N
ASSERT t2 == 10 "sci thr pre-zip"
GETF plate reserve
LET r2 = LAST_N
GETF plate pmf
LET p2 = LAST_N
GETF plate setpoint
LET s2 = LAST_N
GETF plate pcr
LET c2 = LAST_N
GETF plate age
LET age2 = LAST_N

SEND plate zip 2
ASSERT LAST_N == 2 "sci zip2"
GETF plate threshold
LET t3 = LAST_N
ASSERT t3 == 12 "sci thr after zip"
GETF plate energy
LET e3 = LAST_N
ASSERT e3 == e2 "sci e zip held"
GETF plate heat
LET h3 = LAST_N
GETF plate atp
LET a3 = LAST_N
GETF plate reserve
LET r3 = LAST_N
GETF plate pmf
LET p3 = LAST_N
GETF plate setpoint
LET s3 = LAST_N
GETF plate pcr
LET c3 = LAST_N
GETF plate age
LET age3 = LAST_N

SEND plate crest 4
ASSERT LAST_N == 4 "sci crest4"
GETF plate heat
ASSERT LAST_N == h3 + 4 "sci h+4"
GETF plate threshold
ASSERT LAST_N == t3 "sci thr held"
GETF plate energy
ASSERT LAST_N == e3 + 4 "sci e+4"
GETF plate atp
ASSERT LAST_N == a3 - 4 "sci atp-4"
GETF plate reserve
ASSERT LAST_N == r3 "sci r held"
GETF plate pmf
ASSERT LAST_N == p3 "sci pmf held"
GETF plate setpoint
ASSERT LAST_N == s3 "sci sp held"
GETF plate pcr
ASSERT LAST_N == c3 "sci pcr held"
GETF plate age
ASSERT LAST_N == age3 "sci age held"

SEND hinge pulse 5
SEND hinge photosynth 10
SEND hinge glycolyse 8
SEND hinge pump 6
SEND hinge photophos 6
SEND hinge converge 2
SEND hinge extend 2
SEND hinge fold 2
SEND hinge zip 1
GETF hinge energy
LET he = LAST_N
GETF hinge heat
LET hh = LAST_N
GETF hinge threshold
LET ht = LAST_N
SEND hinge crest 2
ASSERT LAST_N == 2 "hinge crest2"
GETF hinge energy
ASSERT LAST_N == he + 2 "hinge e+2"
GETF hinge heat
ASSERT LAST_N == hh + 2 "hinge h+2"
GETF hinge threshold
ASSERT LAST_N == ht "hinge thr held"

SEND stream pulse 2
GETF stream atp
ASSERT LAST_N == 0 "stream atp0"
GETF stream energy
LET se = LAST_N
GETF stream heat
LET sh = LAST_N
SEND stream crest 3
ASSERT LAST_N == 0 "stream crest0"
GETF stream energy
ASSERT LAST_N == se "stream e held"
GETF stream heat
ASSERT LAST_N == sh "stream h held"

ENTITY migrate OF Cell 1 12 0
SEND migrate set_threshold 10
SEND migrate photosynth 8
SEND migrate glycolyse 6
SEND migrate photophos 6
GETF migrate energy
ASSERT LAST_N == 12 "mig e12"
SEND migrate crest 5
ASSERT LAST_N == 5 "mig crest5"
GETF migrate energy
ASSERT LAST_N == 17 "mig e17"
GETF migrate threshold
ASSERT LAST_N == 10 "mig thr10"
GETF migrate ready
ASSERT LAST_N == 1 "mig ready1 EMT spark"

PRINT "atomic_printer_life_crest PASS"

