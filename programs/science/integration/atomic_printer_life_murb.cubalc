// atomic_printer_life_murb.cubalc
// Atomic printer: MurB UDP-MurNAc enolpyruvyl reductase after MurA PG commit.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36

SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mepm 4
ASSERT LAST_N == 4 "pr mepm"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer anmk 4
ASSERT LAST_N == 4 "pr anmk"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murq 4
ASSERT LAST_N == 4 "pr murq"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer naga 4
ASSERT LAST_N == 4 "pr naga"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagb 4
ASSERT LAST_N == 4 "pr nagb"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer pfka 4
ASSERT LAST_N == 4 "pr pfka"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mura 4
ASSERT LAST_N == 4 "pr mura"

GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
SEND printer murb 4
ASSERT LAST_N == 4 "pr murb"
GETF printer heat
ASSERT LAST_N == h0 + 4 "pr murb h+4"
GETF printer energy
ASSERT LAST_N == e0 - 4 "pr murb e-4"
GETF printer atp
ASSERT LAST_N == a0 - 4 "pr murb atp-4"

SEND ink photosynth 28
SEND ink glycolyse 24
SEND ink charge 32
SEND ink feed 24
SEND ink mura 3
ASSERT LAST_N == 3 "ink mura"
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink murb 3
ASSERT LAST_N == 3 "ink murb"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink murb h+3"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink murb e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink murb atp-3"

SEND scrap murb 3
ASSERT LAST_N == 0 "dead scrap murb"

GETF printer alive
ASSERT LAST_N == 1 "printer alive"
GETF printer energy
ASSERT LAST_N >= 0 "energy nonneg"
