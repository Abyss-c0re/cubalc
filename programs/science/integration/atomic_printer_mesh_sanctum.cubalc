// atomic_printer_mesh_sanctum.cubalc
// Life-force gift: MESH-SANCTUM — colony mitosis under free energy first;
// SEAL parent mind as sanctum vault; OPEN vault onto scrap as home;
// dual SEAL/OPEN quorum rebinds hive; live daughters EXCHANGE kin bond;
// soft-OOB storms against the sanctum stay fail-closed (no ghost thrash);
// RECOVER restores vital/key; full mesh re-bind; second post-sanctum
// storm still fails closed. Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_sanctum | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Live full mesh ring before life window
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "pre-life mesh live"
ASSERT SMX_TALKS >= 6 "pre-life talks"
ASSERT CUBES == base_cubes "pre-life identity"

// Mitosis under free energy — births first, then raise the sanctum
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis before sanctum"
GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT pop >= 2 "population after life"
ASSERT CUBES == base_cubes "life invents no cubes"

// SEAL parent mind as sanctum vault onto bed
SMX SEAL bed seed "state/smx_sanctum/vault_root.cblc"
ASSERT SMX_OK == 1 "seal sanctum vault"
ASSERT SMX_N > 64 "sanctum vault frame"
ASSERT CUBES == base_cubes "seal invents nothing"

// Soft-OOB storms against sanctum — fail-closed, no ghost thrash
SMX EXCHANGE hive offworld_sanctum
ASSERT SMX_OK == 0 "sanctum soft-OOB A"
ASSERT SMX_OOB >= 1 "sanctum oob A"
ASSERT CUBES == base_cubes "sanctum no ghost A"

SMX TALK scrap ghost_sanctum
ASSERT SMX_OK == 0 "sanctum soft-OOB B"
ASSERT SMX_OOB >= 2 "sanctum oob sticky"
ASSERT CUBES == base_cubes "sanctum no ghost B"

// Recover: clear OOB, keep key, restore vital after vault raise
SMX RECOVER
ASSERT SMX_OK == 1 "sanctum recover"
ASSERT SMX_OOB == 0 "sanctum oob cleared"
ASSERT SMX_KEY_OK == 1 "sanctum key sticky"
ASSERT SMX_VITAL >= 6 "sanctum vital"
ASSERT CUBES == base_cubes "recover invents nothing"

// OPEN vault onto scrap — shared home frame after storms
SMX OPEN scrap "state/smx_sanctum/vault_root.cblc"
ASSERT SMX_OK == 1 "open vault onto scrap"
ASSERT CUBES == base_cubes "open invents nothing"

// Dual SEAL/OPEN post-sanctum quorum (bed/nozzle) — distinct path, no replay
SMX SEAL bed nozzle "state/smx_sanctum/quorum_bn.cblc"
ASSERT SMX_OK == 1 "seal quorum BN"
ASSERT SMX_N > 64 "quorum BN frame"
SMX OPEN hive "state/smx_sanctum/quorum_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"
ASSERT CUBES == base_cubes "BN open invents nothing"

// Kin bond: live daughters EXCHANGE mind across the nest
LET kin = 0
IF a1 == 1 THEN
  IF a2 == 1 THEN
    SMX EXCHANGE nozzle hive
    ASSERT SMX_OK == 1 "kin bond daughters"
    LET kin = kin + 1
  ELSE
    SMX EXCHANGE nozzle scrap
    ASSERT SMX_OK == 1 "kin bond d1-scrap"
    LET kin = kin + 1
  END
ELSE
  IF a2 == 1 THEN
    SMX EXCHANGE hive scrap
    ASSERT SMX_OK == 1 "kin bond d2-scrap"
    LET kin = kin + 1
  END
END
ASSERT kin >= 1 "at least one kin bond"
ASSERT CUBES == base_cubes "kin invents nothing"

// Full mesh re-bind after sanctum restore
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "mesh re-bind after sanctum"
ASSERT SMX_TALKS >= 12 "talks after re-bind"
ASSERT CUBES == base_cubes "re-bind identity"

// Post-sanctum storm — still fail-closed after vault raise
SMX EXCHANGE scrap void_post
ASSERT SMX_OK == 0 "post soft-OOB"
ASSERT SMX_OOB >= 1 "post oob"
ASSERT CUBES == base_cubes "post no ghost"

SMX TALK bed ghost_post
ASSERT SMX_OK == 0 "post storm-B"
ASSERT SMX_OOB >= 2 "post oob sticky"
ASSERT CUBES == base_cubes "post no ghost B"

SMX RECOVER
ASSERT SMX_OK == 1 "post recover"
ASSERT SMX_OOB == 0 "post oob cleared"
ASSERT SMX_KEY_OK == 1 "post key sticky"
ASSERT SMX_VITAL >= 6 "post vital"

SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after sanctum"
ASSERT SMX_KEY_OK == 1 "key after sanctum"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after sanctum"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after sanctum"
ASSERT UNITY >= 40 "mesh unity after sanctum"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh sanctum"
ASSERT pop >= 2 "population after sanctum life"
ASSERT kin >= 1 "sanctum kin bond"
ASSERT SMX_OOB == 0 "guard holds through sanctum"
ASSERT OK == 1

PRINT "mesh_sanctum" births pop kin SMX_N SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
