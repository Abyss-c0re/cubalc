// atomic_printer_mesh_bergmann_life.cubalc
// Radial glia scaffold mesh — soft-OOB fail-closed life cascade.
// Place · bond · energize · SMX bergmann lock · mitosis. Free energy must flow.
// Cube is SoT. matrix is key. No dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 64
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_bergmann_life | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob counted"
ASSERT CUBES == base_cubes "no ghost place"

SMX LIFE_FORCE bed nozzle hive scrap
ASSERT SMX_OK == 1 "life_force live"
ASSERT SMX_OOB == 0 "oob cleared"

SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_AUTOHEALED == 1 "autoheal"

SMX THALAMUS bed nozzle hive scrap
ASSERT SMX_STABLE_MESH == 1 "stable_mesh"

SMX EPENDYMA bed nozzle hive scrap
ASSERT SMX_EPENDYMA == 1 "ependyma latch"

SMX SATELLITE bed nozzle hive scrap
ASSERT SMX_OK == 1 "satellite live"
ASSERT SMX_SATELLITE == 1 "satellite latch"
ASSERT SMX_MESH_SATELLITE == 1 "mesh_satellite"
ASSERT SMX_SATELLITE_SUM == 14 "bonds+wraps+sheaths"
ASSERT SMX_STABLE_MESH == 1 "stable via satellite"
ASSERT SMX_OOB == 0 "oob clear"
ASSERT CUBES == base_cubes "no invent"

SMX BERGMANN bed nozzle hive scrap
ASSERT SMX_OK == 1 "bergmann live"
ASSERT SMX_BERGMANN == 1 "bergmann latch"
ASSERT SMX_MESH_BERGMANN == 1 "mesh_bergmann"
ASSERT SMX_BERGMANN_SUM == 14 "bonds+wraps+sheaths"
ASSERT SMX_STABLE_MESH == 1 "stable via bergmann"
ASSERT SMX_OOB == 0 "oob clear"
ASSERT CUBES == base_cubes "no invent"


SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "mesh_exchange after satellite"

SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_STABLE == 1 "stabilize"

LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2

ASSERT births >= 1 "mitosis on satellite mesh"
ASSERT pop >= 2 "population grows"
ASSERT ENERGY > 0 "free energy flows"
ASSERT SMX_SATELLITE == 1 "satellite sticky"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky"
ASSERT OK == 1

PRINT "atomic_printer_mesh_bergmann_life" births pop SMX_SATELLITE SMX_MESH_SATELLITE SMX_SATELLITE_SUM SMX_STABLE_MESH ENERGY UNITY
PASS
