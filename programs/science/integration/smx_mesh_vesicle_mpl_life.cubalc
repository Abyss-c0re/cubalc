SEND vesicle feed 20
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
SEND vesicle mpl 3
ASSERT LAST_N == 3 "ves mpl"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "ves mpl h+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "ves mpl e-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "ves mpl atp-3"

