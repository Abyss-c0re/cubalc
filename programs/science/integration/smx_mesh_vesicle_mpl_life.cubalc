// smx_mesh_vesicle_mpl_life.cubalc
// SMX vesicle: Mpl murein peptide ligase recycling after EmtA.
// Cube is SoT. Free energy must flow.
// Continuum ...->daca->dacb->dacc->dacd->amph->mlta->mltb->mltc->mltd->mlte->emta->mpl

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 44 0
ENTITY dock OF Cell 1 28 0
ENTITY void OF Cell 0 12 0

SEND vesicle set_threshold 8
SEND dock set_threshold 8
SEND vesicle pulse 3
SEND vesicle photosynth 36
SEND vesicle glycolyse 32
SEND vesicle pump 20
SEND vesicle charge 36
SEND vesicle feed 32

SEND vesicle ampg 3
ASSERT LAST_N == 3 "ves ampg"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
