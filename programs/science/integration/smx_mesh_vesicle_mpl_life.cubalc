SEND dock feed 20
GETF dock heat
LET dh = LAST_N
GETF dock energy
LET de = LAST_N
GETF dock atp
LET da = LAST_N
SEND dock mpl 2
ASSERT LAST_N == 2 "dock mpl"
GETF dock heat
ASSERT LAST_N == dh + 2 "dock mpl h+2"
GETF dock energy
ASSERT LAST_N == de - 2 "dock mpl e-2"
GETF dock atp
ASSERT LAST_N == da - 2 "dock mpl atp-2"

SEND void photosynth 20
SEND void glycolyse 16
SEND void charge 24
SEND void feed 16
SEND void mltc 2
ASSERT LAST_N == 0 "pre mltc void dead"
SEND void photosynth 20
SEND void glycolyse 16
SEND void charge 24
SEND void feed 16
SEND void mlte 2
ASSERT LAST_N == 0 "pre mlte void dead"
SEND void photosynth 20
SEND void glycolyse 16
SEND void charge 24
SEND void feed 16
SEND void amph 2
ASSERT LAST_N == 0 "pre amph void dead"
SEND void mpl 2
ASSERT LAST_N == 0 "void mpl 0"

GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive"
GETF vesicle energy
ASSERT LAST_N >= 0 "ves energy nonneg"
