// atomic_printer_life_casp9.cubalc
// Science board: atomic printer life-force — caspase-9 initiator after APAF.
// Place cell, energize chemiosmotic path, run tether→mcu→nclx→mptp→momp→apaf→casp9.
// ASSERT free energy held on cytosolic cascade; heat and age both scale with n.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY seed OF Cell 1 16 0
SEND seed set_threshold 10

// Place + bond metabolic capacity
SEND seed pulse 4
SEND seed photosynth 10
SEND seed glycolyse 8
SEND seed pump 8
SEND seed synthase 2

GETF seed alive
ASSERT LAST_N == 1 "sci alive"
GETF seed atp
LET at0 = LAST_N
ASSERT at0 >= 6 "sci atp primed"
GETF seed pmf
LET p0 = LAST_N
ASSERT p0 >= 4 "sci pmf"
GETF seed energy
LET e0 = LAST_N
GETF seed reserve
LET r0 = LAST_N
GETF seed age
LET a0 = LAST_N
GETF seed heat
LET h0 = LAST_N

// MERCs Ca2+ coupling window
SEND seed tether 1
ASSERT LAST_N == 1 "sci tether"
SEND seed mcu 2
ASSERT LAST_N == 2 "sci mcu"
SEND seed nclx 1
ASSERT LAST_N == 1 "sci nclx"

GETF seed pmf
LET p1 = LAST_N
GETF seed heat
LET h1 = LAST_N
GETF seed age
LET a1 = LAST_N
GETF seed atp
LET at1 = LAST_N

// mPTP injury then MOMP release then apoptosome then caspase-9
SEND seed mptp 2
ASSERT LAST_N == 2 "sci mptp"
GETF seed pmf
ASSERT LAST_N == p1 - 2 "sci mptp pmf"
GETF seed heat
ASSERT LAST_N == h1 + 2 "sci mptp heat"
GETF seed age
ASSERT LAST_N == a1 + 1 "sci mptp age"

GETF seed atp
LET at2 = LAST_N
GETF seed age
LET a2 = LAST_N
GETF seed heat
LET h2 = LAST_N
GETF seed pmf
LET p2 = LAST_N

SEND seed momp 2
ASSERT LAST_N == 2 "sci momp"
GETF seed atp
ASSERT LAST_N == at2 - 2 "sci momp atp"
GETF seed age
ASSERT LAST_N == a2 + 2 "sci momp age"
GETF seed heat
ASSERT LAST_N == h2 + 1 "sci momp heat"
GETF seed pmf
ASSERT LAST_N == p2 "sci momp pmf held"

// recharge dATP pool for apoptosome wheel
SEND seed photosynth 3
SEND seed glycolyse 3
GETF seed atp
LET at3 = LAST_N
ASSERT at3 >= 3 "sci dATP pool"
GETF seed age
LET a3 = LAST_N
GETF seed heat
LET h3 = LAST_N
GETF seed energy
LET e3 = LAST_N
GETF seed reserve
LET r3 = LAST_N
GETF seed pmf
LET p3 = LAST_N

SEND seed apaf 3
ASSERT LAST_N == 3 "sci apaf3"
GETF seed atp
ASSERT LAST_N == at3 - 3 "sci apaf atp"
GETF seed heat
ASSERT LAST_N == h3 + 3 "sci apaf heat+n"
GETF seed age
ASSERT LAST_N == a3 + 1 "sci apaf age+1"
GETF seed pmf
ASSERT LAST_N == p3 "sci apaf pmf held"

// recharge ATP for caspase-9 initiator cycles
SEND seed photosynth 3
SEND seed glycolyse 3
GETF seed atp
LET at4 = LAST_N
ASSERT at4 >= 3 "sci casp9 pool"
GETF seed age
LET a4 = LAST_N
GETF seed heat
LET h4 = LAST_N
GETF seed energy
LET e4 = LAST_N
GETF seed reserve
LET r4 = LAST_N
GETF seed pmf
LET p4 = LAST_N

SEND seed casp9 3
ASSERT LAST_N == 3 "sci casp93"
GETF seed atp
ASSERT LAST_N == at4 - 3 "sci casp9 atp"
GETF seed heat
ASSERT LAST_N == h4 + 3 "sci casp9 heat+n"
GETF seed age
ASSERT LAST_N == a4 + 3 "sci casp9 age+n"
GETF seed pmf
ASSERT LAST_N == p4 "sci casp9 pmf held"
GETF seed energy
ASSERT LAST_N == e4 "sci casp9 e held"
GETF seed reserve
ASSERT LAST_N == r4 "sci casp9 r held"
GETF seed alive
ASSERT LAST_N == 1 "sci lives after casp9"

// Wonder: cell still yields life-force after initiator prime (execution not yet)
SEND seed yield
ASSERT LAST_N > 0 "sci yield>0"
SEND seed vitality
ASSERT LAST_N > 0 "sci vitality>0"

// Signature board: apaf (age unit) vs casp9 (age scales) under one seed lineage
ENTITY dual OF Cell 1 12 0
SEND dual set_threshold 10
SEND dual pulse 3
SEND dual photosynth 6
SEND dual glycolyse 5
GETF dual atp
LET dat = LAST_N
GETF dual age
LET da0 = LAST_N
GETF dual heat
LET dh0 = LAST_N
SEND dual apaf 2
ASSERT LAST_N == 2 "sci dual apaf"
GETF dual age
ASSERT LAST_N == da0 + 1 "sci dual apaf age+1"
GETF dual heat
ASSERT LAST_N == dh0 + 2 "sci dual apaf heat+n"
SEND dual photosynth 2
SEND dual glycolyse 2
GETF dual atp
LET dat2 = LAST_N
GETF dual age
LET da1 = LAST_N
GETF dual heat
LET dh1 = LAST_N
SEND dual casp9 2
ASSERT LAST_N == 2 "sci dual casp9"
GETF dual age
ASSERT LAST_N == da1 + 2 "sci dual casp9 age+n"
GETF dual heat
ASSERT LAST_N == dh1 + 2 "sci dual casp9 heat+n"
GETF dual alive
ASSERT LAST_N == 1 "sci dual lives"

PRINT "atomic_printer_life_casp9 PASS"
