SEND printer charge 30
SEND printer feed 20

SEND printer damx 4
ASSERT LAST_N == 4 "pre_damx"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20

SEND printer rlpa 3
ASSERT LAST_N == 3 "printer pre_rlpa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20


SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer nlpd 3
ASSERT LAST_N == 3 "ap nlpd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer scission 4
ASSERT LAST_N == 4 "printer pre_scission"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20

GETF printer heat
LET ph = LAST_N
GETF printer energy
LET pe = LAST_N
GETF printer atp
LET pa = LAST_N
GETF printer pcr
LET pc = LAST_N
GETF printer reserve
LET pr = LAST_N
GETF printer age
LET page = LAST_N
SEND printer fispay 4
ASSERT LAST_N == 4 "ap "

GETF printer heat
ASSERT LAST_N == ph + 4 "ap h+4"
GETF printer energy
ASSERT LAST_N == pe - 4 "ap e-4"
GETF printer atp
ASSERT LAST_N == pa - 4 "ap a-4"
GETF printer pcr
ASSERT LAST_N == pc "ap c held"
GETF printer reserve
ASSERT LAST_N == pr "ap r held"
GETF printer age
ASSERT LAST_N == page "ap age held"
GETF printer alive
ASSERT LAST_N == 1 "ap alive"

SEND bud pulse 5
SEND bud photosynth 40
SEND bud glycolyse 32
SEND bud charge 36
SEND bud feed 28
SEND bud charge_pcr 18
SEND bud if3 2
ASSERT LAST_N == 2 "bud if3"
