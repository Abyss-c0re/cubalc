SEND bud lpob 3
ASSERT LAST_N == 3 "bud lpob"
SEND bud photosynth 24
SEND bud glycolyse 20
SEND bud charge 30
SEND bud feed 20

SEND bud pbp1b 3
ASSERT LAST_N == 3 "bud pre_pbp1b"
