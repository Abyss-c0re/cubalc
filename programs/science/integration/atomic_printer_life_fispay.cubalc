SEND bud feed 20


SEND bud scission 3
ASSERT LAST_N == 3 "bud pre_scission"
SEND bud photosynth 24
SEND bud glycolyse 20
SEND bud charge 30
SEND bud feed 20

GETF bud heat
LET bh = LAST_N
GETF bud energy
LET be = LAST_N
GETF bud atp
LET ba = LAST_N
SEND bud fispay 3
ASSERT LAST_N == 3 "bud "
GETF bud heat
ASSERT LAST_N == bh + 3 "bud h+3"
GETF bud energy
ASSERT LAST_N == be - 3 "bud e-3"
GETF bud atp
ASSERT LAST_N == ba - 3 "bud a-3"
GETF bud alive
ASSERT LAST_N == 1 "bud alive"

ASSERT 1 == 1 "atomic_printer_life_fispay sealed"
