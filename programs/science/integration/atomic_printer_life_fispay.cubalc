// atomic_printer_life_fispay.cubalc
// Atomic printer board: Cell.fispay cytokinesis endowment energy split after Scission.
// Place/bond/energize life-force; NlpD LytM activator after IF3/IF2/FtsZ/FtsI/AmiC/EnvC/FtsN/FtsK/XerCD/Tol-Pal/CpoB/LpoB/Pbp1B/DedD/DamX/RlpA gates.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY bud OF Cell 1 36 0

SEND printer set_threshold 10
SEND bud set_threshold 10

SEND printer pulse 6
SEND printer photosynth 44
SEND printer glycolyse 36
SEND printer charge 40
SEND printer feed 36
SEND printer charge_pcr 22

SEND printer aars 3
ASSERT LAST_N == 3 "ap aars"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14
SEND printer eftu 3
ASSERT LAST_N == 3 "ap eftu"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer ptc 3
ASSERT LAST_N == 3 "ap ptc"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14
SEND printer efg 3
ASSERT LAST_N == 3 "ap efg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer rf1 3
ASSERT LAST_N == 3 "ap rf1"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14
SEND printer rf3 3
ASSERT LAST_N == 3 "ap rf3"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 16
SEND printer rrf 3
ASSERT LAST_N == 3 "ap rrf"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer if3 3
ASSERT LAST_N == 3 "ap if3"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer if2 3
ASSERT LAST_N == 3 "ap if2"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 12
SEND printer ftsz 3
ASSERT LAST_N == 3 "ap ftsz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer charge_pcr 14

SEND printer ftsi 4
ASSERT LAST_N == 4 "printer ftsi"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer amic 4
ASSERT LAST_N == 4 "ap amic"
SEND printer photosynth 24
