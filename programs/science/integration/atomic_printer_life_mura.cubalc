// atomic_printer_life_mura.cubalc
// Atomic printer: MurA UDP-GlcNAc enolpyruvyl transferase after MurA glycolysis commit.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36

SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mepm 4
ASSERT LAST_N == 4 "pr mepm"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer anmk 4
ASSERT LAST_N == 4 "pr anmk"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murq 4
ASSERT LAST_N == 4 "pr murq"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer naga 4
ASSERT LAST_N == 4 "pr naga"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagb 4
ASSERT LAST_N == 4 "pr nagb"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer pfka 4
ASSERT LAST_N == 4 "pr pfka"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
GETF printer heat
LET ph0 = LAST_N
GETF printer energy
LET pe0 = LAST_N
GETF printer atp
LET pa0 = LAST_N
SEND printer mura 4
ASSERT LAST_N == 4 "pr mura commit"
GETF printer heat
ASSERT LAST_N == ph0 + 4 "pr mura h+4"
GETF printer energy
ASSERT LAST_N == pe0 - 4 "pr mura e-4"
GETF printer atp
ASSERT LAST_N == pa0 - 4 "pr mura atp-4"

SEND ink photosynth 28
SEND ink glycolyse 22
SEND ink charge 24
SEND ink feed 20
GETF ink heat
LET ih = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink mura 3
ASSERT LAST_N == 3 "ink mura"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink mura h+3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink mura atp-3"

SEND scrap mura 4
ASSERT LAST_N == 0 "scrap mura 0"
GETF printer alive
ASSERT LAST_N == 1 "printer alive"

