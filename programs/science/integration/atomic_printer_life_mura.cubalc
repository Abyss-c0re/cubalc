// atomic_printer_life_mura.cubalc
// Atomic printer board: Cell.mura MurA UDP-GlcNAc enolpyruvyl transferase after MurQ.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36
SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer anmk 4
ASSERT LAST_N == 4 "pr anmk"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murq 5
ASSERT LAST_N == 5 "pr murq pre"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
SEND printer mura 5
ASSERT LAST_N == 5 "pr mura"
GETF printer heat
ASSERT LAST_N == h0 + 5 "pr h+5"
GETF printer energy
ASSERT LAST_N == e0 - 5 "pr e-5"
GETF printer atp
ASSERT LAST_N == a0 - 5 "pr atp-5"
GETF printer pcr
ASSERT LAST_N == c0 "pr pcr held"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink murq 3
ASSERT LAST_N == 3 "ink murq pre"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink mura 3
ASSERT LAST_N == 3 "ink mura"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink h+3"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink atp-3"
SEND scrap murq 3
ASSERT LAST_N == 0 "scrap murq0"
SEND scrap mura 3
ASSERT LAST_N == 0 "scrap mura0"
SEND printer mura 0
ASSERT LAST_N == 0 "pr mura n0"
SEND printer mura -2
ASSERT LAST_N == 0 "pr mura nneg"
GETF printer alive
ASSERT LAST_N == 1 "pr alive"
