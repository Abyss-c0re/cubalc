REQUIRE VERSION "1.15"
INCLUDE life_cell

# Atomic printer life force — Csad cysteine sulfinic acid decarboxylase after Cdo1
# Extends printer continuum after Gor: pepf->pdf->map->nata->natb->natc->nate->mete->metk->ahcy->cbs->cgl->gsha->gshb->gor->gpx->gst->ggt->dug1->nat8->cdo1->csad->fmo1
# Gift: Csad decarboxylates CSA->hypotaurine so taurine commitment completes on the printer board after Cdo1.
# Cube is SoT. Free energy must flow.

ENTITY printer OF Cell 1 60 0
SEND printer set_threshold 8
SEND printer pulse 4
SEND printer photosynth 48
SEND printer glycolyse 40
SEND printer pump 30
SEND printer photophos 28
SEND printer charge 44
SEND printer feed 40

SEND printer pepf 2
ASSERT LAST_N == 2 "ap pepf"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 20
SEND printer feed 14
SEND printer pdf 2
ASSERT LAST_N == 2 "ap pdf"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 20
SEND printer feed 14
SEND printer map 2
ASSERT LAST_N == 2 "ap map"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer nata 2
ASSERT LAST_N == 2 "ap nata"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer natb 2
ASSERT LAST_N == 2 "ap natb"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer natc 2
ASSERT LAST_N == 2 "ap natc"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer nate 2
ASSERT LAST_N == 2 "ap nate"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer mete 2
ASSERT LAST_N == 2 "ap mete"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer metk 2
ASSERT LAST_N == 2 "ap metk"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
SEND printer ahcy 2
ASSERT LAST_N == 2 "ap ahcy"
SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16

GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N

SEND printer cbs 3
ASSERT LAST_N == 3 "ap pre cbs3"
GETF printer heat
ASSERT LAST_N == h0 + 3 "ap pre cbs heat"
GETF printer energy
ASSERT LAST_N == e0 - 3 "ap pre cbs energy"
GETF printer atp
ASSERT LAST_N == a0 - 3 "ap pre cbs atp"

SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET h1 = LAST_N
GETF printer energy
LET e1 = LAST_N
GETF printer atp
LET a1 = LAST_N

SEND printer cgl 3
ASSERT LAST_N == 3 "ap pre cgl3"
GETF printer heat
ASSERT LAST_N == h1 + 3 "ap pre cgl heat"
GETF printer energy
ASSERT LAST_N == e1 - 3 "ap pre cgl energy"
GETF printer atp
ASSERT LAST_N == a1 - 3 "ap pre cgl atp"

SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET h2 = LAST_N
GETF printer energy
LET e2 = LAST_N
GETF printer atp
LET a2 = LAST_N

SEND printer gsha 3
ASSERT LAST_N == 3 "ap pre gsha3"
GETF printer heat
ASSERT LAST_N == h2 + 3 "ap pre gsha heat"
GETF printer energy
ASSERT LAST_N == e2 - 3 "ap pre gsha energy"
GETF printer atp
ASSERT LAST_N == a2 - 3 "ap pre gsha atp"

SEND printer photosynth 18
SEND printer glycolyse 14
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET h3 = LAST_N
GETF printer energy
LET e3 = LAST_N
GETF printer atp
LET a3 = LAST_N

SEND printer gshb 3
ASSERT LAST_N == 3 "ap gshb3"
GETF printer heat
ASSERT LAST_N == h3 + 3 "ap gshb heat"
GETF printer energy
ASSERT LAST_N == e3 - 3 "ap gshb energy"
GETF printer atp
ASSERT LAST_N == a3 - 3 "ap gshb atp"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-gshb"

SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET hg = LAST_N
GETF printer energy
LET eg = LAST_N
GETF printer atp
LET ag = LAST_N
SEND printer gor 3
ASSERT LAST_N == 3 "ap gor3"
GETF printer heat
ASSERT LAST_N == hg + 3 "ap gor h+3"
GETF printer energy
ASSERT LAST_N == eg - 3 "ap gor e-3"
GETF printer atp
ASSERT LAST_N == ag - 3 "ap gor a-3"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-gor"
SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET hx = LAST_N
GETF printer energy
LET ex = LAST_N
GETF printer atp
LET ax = LAST_N
SEND printer gpx 3
ASSERT LAST_N == 3 "ap gpx3"
GETF printer heat
ASSERT LAST_N == hx + 3 "ap gpx h+3"
GETF printer energy
ASSERT LAST_N == ex - 3 "ap gpx e-3"
GETF printer atp
ASSERT LAST_N == ax - 3 "ap gpx a-3"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-gpx"

SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET hs = LAST_N
GETF printer energy
LET es = LAST_N
GETF printer atp
LET as = LAST_N
SEND printer gst 3
ASSERT LAST_N == 3 "ap gst3"
GETF printer heat
ASSERT LAST_N == hs + 3 "ap gst h+3"
GETF printer energy
ASSERT LAST_N == es - 3 "ap gst e-3"
GETF printer atp
ASSERT LAST_N == as - 3 "ap gst a-3"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-gst"

SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET hggt = LAST_N
GETF printer energy
LET eggt = LAST_N
GETF printer atp
LET aggt = LAST_N
SEND printer ggt 3
ASSERT LAST_N == 3 "ap ggt3"
GETF printer heat
ASSERT LAST_N == hggt + 3 "ap ggt h+3"
GETF printer energy
ASSERT LAST_N == eggt - 3 "ap ggt e-3"
GETF printer atp
ASSERT LAST_N == aggt - 3 "ap ggt a-3"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-ggt"

SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
SEND printer dug1 3
ASSERT LAST_N == 3 "ap pre dug1 3"
SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
SEND printer cdo1 3
ASSERT LAST_N == 3 "ap pre cdo1 3"
SEND printer photosynth 18
SEND printer charge 22
SEND printer feed 16
GETF printer heat
LET hcsad = LAST_N
GETF printer energy
LET ecsad = LAST_N
GETF printer atp
LET acsad = LAST_N
SEND printer csad 3
ASSERT LAST_N == 3 "ap csad 3"
GETF printer heat
ASSERT LAST_N == hcsad + 3 "ap csad h+3"
GETF printer energy
ASSERT LAST_N == ecsad - 3 "ap csad e-3"
GETF printer atp
ASSERT LAST_N == acsad - 3 "ap csad a-3"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-csad"
ASSERT 1 == 1 "ATOMIC_PRINTER_LIFE_CSAD PASS"
SEND printer photosynth 14
SEND printer charge 16
SEND printer feed 12
GETF printer heat
LET fm_ap_h = LAST_N
GETF printer energy
LET fm_ap_e = LAST_N
GETF printer atp
LET fm_ap_a = LAST_N
GETF printer age
LET fm_ap_age = LAST_N
GETF printer pcr
LET fm_ap_pcr = LAST_N
GETF printer reserve
LET fm_ap_rsv = LAST_N
GETF printer pmf
LET fm_ap_pmf = LAST_N
GETF printer threshold
LET fm_ap_thr = LAST_N
SEND printer fmo1 2
ASSERT LAST_N == 2 "ap fmo1"
GETF printer heat
ASSERT LAST_N == fm_ap_h + 2 "ap fmo1 h+2"
GETF printer energy
ASSERT LAST_N == fm_ap_e - 2 "ap fmo1 e-2"
GETF printer atp
ASSERT LAST_N == fm_ap_a - 2 "ap fmo1 a-2"
GETF printer age
ASSERT LAST_N == fm_ap_age "ap fmo1 age held"
GETF printer pcr
ASSERT LAST_N == fm_ap_pcr "ap fmo1 pcr held"
GETF printer reserve
ASSERT LAST_N == fm_ap_rsv "ap fmo1 reserve held"
GETF printer pmf
ASSERT LAST_N == fm_ap_pmf "ap fmo1 pmf held"
GETF printer threshold
ASSERT LAST_N == fm_ap_thr "ap fmo1 thr held"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-fmo1"
