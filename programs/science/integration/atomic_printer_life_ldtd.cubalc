// atomic_printer_life_ldtd.cubalc
// Atomic printer: LdtD/YcbB L,D-transpeptidase 3-3 crosslink after UppP.
// Cube is SoT. Free energy must flow.
// Continuum ...->mura->murb->murc->murd->mure->murf->mray->murg->murj->mtga->uppp->ldtd

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36

SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mepm 4
ASSERT LAST_N == 4 "pr mepm"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer anmk 4
ASSERT LAST_N == 4 "pr anmk"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murq 4
ASSERT LAST_N == 4 "pr murq"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer naga 4
ASSERT LAST_N == 4 "pr naga"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagb 4
ASSERT LAST_N == 4 "pr nagb"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer pfka 4
ASSERT LAST_N == 4 "pr pfka"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mura 4
ASSERT LAST_N == 4 "pr mura"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murb 4
ASSERT LAST_N == 4 "pr murb"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murc 4
ASSERT LAST_N == 4 "pr murc"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murd 4
ASSERT LAST_N == 4 "pr murd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mure 4
ASSERT LAST_N == 4 "pr mure"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer murf 4
ASSERT LAST_N == 4 "pr murf"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mray 4
ASSERT LAST_N == 4 "pr mray"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murg 4
ASSERT LAST_N == 4 "pr murg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murj 4
ASSERT LAST_N == 4 "pr murj"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mtga 4
ASSERT LAST_N == 4 "pr mtga"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer uppp 4
ASSERT LAST_N == 4 "pr uppp"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
GETF printer heat
LET ph = LAST_N
GETF printer energy
LET pe = LAST_N
GETF printer atp
LET pa = LAST_N
SEND printer ldtd 4
ASSERT LAST_N == 4 "pr ldtd"
GETF printer heat
ASSERT LAST_N == ph + 4 "pr ldtd h+4"
GETF printer energy
ASSERT LAST_N == pe - 4 "pr ldtd e-4"
GETF printer atp
ASSERT LAST_N == pa - 4 "pr ldtd atp-4"

SEND ink photosynth 28
SEND ink glycolyse 24
SEND ink charge 32
SEND ink feed 24
SEND ink murj 3
ASSERT LAST_N == 3 "pre murj"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink mtga 3
ASSERT LAST_N == 3 "pre mtga"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink uppp 3
ASSERT LAST_N == 3 "pre uppp"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink ldtd 3
ASSERT LAST_N == 3 "ink ldtd"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink ldtd h+3"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink ldtd e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink ldtd atp-3"

SEND scrap ldtd 3
ASSERT LAST_N == 0 "dead scrap ldtd"

GETF printer alive
ASSERT LAST_N == 1 "printer alive"
GETF printer energy
ASSERT LAST_N >= 0 "energy nonneg"
