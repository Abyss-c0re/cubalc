SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink dacb 3
ASSERT LAST_N == 3 "ink dacb"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink dacb h+3"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink dacb e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink dacb atp-3"

SEND scrap dacb 3
ASSERT LAST_N == 0 "dead scrap dacb"

GETF printer alive
ASSERT LAST_N == 1 "printer alive"
GETF printer energy
ASSERT LAST_N >= 0 "energy nonneg"
