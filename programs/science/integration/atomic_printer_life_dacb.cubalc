SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
GETF printer heat
LET ph = LAST_N
GETF printer energy
LET pe = LAST_N
GETF printer atp
LET pa = LAST_N
SEND printer dacb 4
ASSERT LAST_N == 4 "pr dacb"
GETF printer heat
ASSERT LAST_N == ph + 4 "pr dacb h+4"
GETF printer energy
ASSERT LAST_N == pe - 4 "pr dacb e-4"
GETF printer atp
ASSERT LAST_N == pa - 4 "pr dacb atp-4"

SEND ink photosynth 28
SEND ink glycolyse 24
SEND ink charge 32
SEND ink feed 24
SEND ink murj 3
ASSERT LAST_N == 3 "pre murj"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink mtga 3
ASSERT LAST_N == 3 "pre mtga"
