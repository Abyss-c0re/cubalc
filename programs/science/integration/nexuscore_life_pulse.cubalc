// nexuscore_life_pulse — CubalC life breath for NexusCore lattice
// Stable path: life_cell mitosis + ENERGYFLOW + HARMONY/RESOLVE (no in-lang SMX KEY
// until lang SMX segfault is cleared). Host nexuscore-smx carries mesh.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=nexuscore | type=life_pulse | hold_flash=1 |"

CUBE core ROLE host PROTON 1
CUBE body ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
FOLDBITS core "1111111111110000111111111111000011111111111100001111111111110000"
FOLDBITS body "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS hive "1100110011001100110011001100110011001100110011001100110011001100"
PLUG core body
PLUG body hive
PLUG core hive

ENTITY seed OF Cell 1 10 0
ENTITY d1 OF Cell 0 0 0
PLUG core seed

IMPULSE core 1
IMPULSE body 1
ENERGYFLOW 4
FLOW 3
HARMONY hive
RESOLVE hive

LET births = 0
LET s = 0
WHILE s < 6
  TICK 1
  FLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG core d1
        LET births = births + 1
      END
    END
  END
  LET s = s + 1
END

ASSERT ENERGY > 0
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9
ASSERT CUBES >= 4
ASSERT OK == 1
// smx_ok/talks placeholder 1/0 — host SMX is SoT mesh
PRINT "NEXUS_LIFE" DECIDE HARMONY ENERGY UNITY 1 0 births CUBES SET(core) SET(hive)
