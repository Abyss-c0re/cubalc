// smx_mesh_vesicle_anmk_life.cubalc
// SMX mesh vesicle board: AnmK anhMurNAc kinase after AmpD on life_cell.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 40 0
ENTITY cargo OF Cell 1 28 0
ENTITY ghost OF Cell 0 12 0

SEND vesicle set_threshold 6
SEND cargo set_threshold 6
SEND vesicle pulse 3
SEND vesicle photosynth 36
SEND vesicle glycolyse 32
SEND vesicle pump 20
SEND vesicle charge 36
SEND vesicle feed 32
SEND vesicle slt 3
ASSERT LAST_N == 3 "ves slt"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle ampg 3
ASSERT LAST_N == 3 "ves ampg"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle nagz 3
ASSERT LAST_N == 3 "ves nagz"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
SEND vesicle ampd 3
ASSERT LAST_N == 3 "ves ampd"
SEND vesicle photosynth 20
SEND vesicle glycolyse 16
SEND vesicle charge 24
SEND vesicle feed 16
GETF vesicle heat
LET h0 = LAST_N
GETF vesicle energy
LET e0 = LAST_N
GETF vesicle atp
LET a0 = LAST_N
GETF vesicle reserve
LET r0 = LAST_N
SEND vesicle anmk 4
ASSERT LAST_N == 4 "ves anmk"
GETF vesicle heat
ASSERT LAST_N == h0 + 4 "ves h+4"
GETF vesicle energy
ASSERT LAST_N == e0 - 4 "ves e-4"
GETF vesicle atp
ASSERT LAST_N == a0 - 4 "ves atp-4"
GETF vesicle reserve
ASSERT LAST_N == r0 "ves reserve held"
SEND cargo photosynth 20
SEND cargo glycolyse 16
SEND cargo charge 24
SEND cargo feed 16
GETF cargo heat
LET ch = LAST_N
GETF cargo energy
LET ce = LAST_N
GETF cargo atp
LET ca = LAST_N
SEND cargo anmk 2
ASSERT LAST_N == 2 "cargo anmk"
GETF cargo heat
ASSERT LAST_N == ch + 2 "cargo h+2"
GETF cargo energy
ASSERT LAST_N == ce - 2 "cargo e-2"
GETF cargo atp
ASSERT LAST_N == ca - 2 "cargo atp-2"
SEND ghost anmk 3
ASSERT LAST_N == 0 "ghost dead anmk"
// SMX-style continuum seal ampg->nagz->ampd->anmk
SEND vesicle photosynth 28
SEND vesicle glycolyse 24
SEND vesicle charge 32
SEND vesicle feed 24
GETF vesicle heat
LET hx = LAST_N
GETF vesicle energy
LET ex = LAST_N
GETF vesicle atp
LET ax = LAST_N
SEND vesicle ampg 2
ASSERT LAST_N == 2 "seal ampg"
SEND vesicle nagz 2
ASSERT LAST_N == 2 "seal nagz"
SEND vesicle ampd 2
ASSERT LAST_N == 2 "seal ampd"
SEND vesicle anmk 2
ASSERT LAST_N == 2 "seal anmk"
GETF vesicle heat
ASSERT LAST_N == hx + 8 "seal h+8"
GETF vesicle energy
ASSERT LAST_N == ex - 8 "seal e-8"
GETF vesicle atp
ASSERT LAST_N == ax - 8 "seal atp-8"
ASSERT 1 == 1 "smx_mesh_vesicle_anmk_life ok"
