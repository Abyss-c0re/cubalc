REQUIRE VERSION "1.15"
INCLUDE life_cell

# Atomic printer life force - FXR-after-Fabp6 ileal bile-acid binding protein after Asbt
# Extends printer continuum: ...->fmo1->baat->bsep->ntcp->oatp1b1->mrp2->mrp3->ost->asbt->fabp6->fxr
# Gift: FXR-after-Fabp6 opens cytosolic IBABP bile-salt shuttle on the printer board so reclaimed acids transit epithelium after Asbt apical uptake.
# Cube is SoT. Free energy must flow.

ENTITY printer OF Cell 1 60 0
SEND printer set_threshold 8
SEND printer pulse 4
SEND printer photosynth 48
SEND printer glycolyse 40
SEND printer pump 30
SEND printer photophos 28
SEND printer charge 44
SEND printer feed 40

SEND printer pepf 2
ASSERT LAST_N == 2 "ap pepf"
