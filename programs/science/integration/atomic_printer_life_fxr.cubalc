# Asbt apical Na+-bile-acid uptake after Ost
SEND printer photosynth 16
SEND printer charge 14
SEND printer feed 12
GETF printer heat
LET ash = LAST_N
GETF printer energy
LET ase = LAST_N
GETF printer atp
LET asa = LAST_N
SEND printer asbt 2
ASSERT LAST_N == 2 "ap asbt 2"
GETF printer heat
ASSERT LAST_N == ash + 2 "ap asbt h+2"
GETF printer energy
ASSERT LAST_N == ase - 2 "ap asbt e-2"
GETF printer atp
ASSERT LAST_N == asa - 2 "ap asbt a-2"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-asbt"
SEND printer asbt 0
ASSERT LAST_N == 0 "ap asbt n0"

ASSERT 1 == 1 "atomic_printer_life_asbt checkpoint"

# Ost basolateral overflow after Mrp3
SEND printer photosynth 16
SEND printer charge 14
SEND printer feed 12
GETF printer heat
LET m3h = LAST_N
GETF printer energy
LET m3e = LAST_N
GETF printer atp
LET m3a = LAST_N
SEND printer ost 2
ASSERT LAST_N == 2 "ap ost 2"
GETF printer heat
ASSERT LAST_N == m3h + 2 "ap ost h+2"
GETF printer energy
ASSERT LAST_N == m3e - 2 "ap ost e-2"
GETF printer atp
ASSERT LAST_N == m3a - 2 "ap ost a-2"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-ost"
SEND printer ost 0
ASSERT LAST_N == 0 "ap ost n0"
GETF printer alive
ASSERT LAST_N == 1 "ap alive final ost"


# FXR-after-Fabp6 cytosolic IBABP shuttle after Asbt
SEND printer photosynth 16
SEND printer charge 14
SEND printer feed 12
GETF printer heat
LET fbh = LAST_N
GETF printer energy
LET fbe = LAST_N
GETF printer atp
LET fba = LAST_N
SEND printer fabp6 2
ASSERT LAST_N == 2 "ap fabp6 2"
GETF printer heat
ASSERT LAST_N == fbh + 2 "ap fabp6 h+2"
GETF printer energy
ASSERT LAST_N == fbe - 2 "ap fabp6 e-2"
GETF printer atp
ASSERT LAST_N == fba - 2 "ap fabp6 a-2"
GETF printer alive
ASSERT LAST_N == 1 "ap alive post-fabp6"
SEND printer fabp6 0
ASSERT LAST_N == 0 "ap fabp6 n0"
GETF printer alive
ASSERT LAST_N == 1 "ap alive final fabp6"
ASSERT 1 == 1 "atomic_printer_life_fxr PASS"

# FXR after Fabp6 on ap plate
# Cube is SoT. Free energy must flow.

SEND printer photosynth 10
