// atomic_printer_life_murf.cubalc
// Atomic printer board: Cell.murf MurF UDP-MurNAc-tripeptide:D-Ala-D-Ala ligase after MurE.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36
SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer anmk 4
ASSERT LAST_N == 4 "pr anmk"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murq 4
ASSERT LAST_N == 4 "pr murq"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mura 4
ASSERT LAST_N == 4 "pre printer mura"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murb 3
ASSERT LAST_N == 3 "pre printer murb"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murc 3
ASSERT LAST_N == 3 "pre printer murc"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer murd 3
ASSERT LAST_N == 3 "pre printer murd"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer mure 3
ASSERT LAST_N == 3 "pre printer mure"
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
GETF printer reserve
LET r0 = LAST_N
GETF printer age
LET age0 = LAST_N
GETF printer pmf
LET pmf0 = LAST_N
GETF printer setpoint
LET sp0 = LAST_N
GETF printer threshold
LET thr0 = LAST_N
SEND printer murf 5
ASSERT LAST_N == 5 "pr murf"
GETF printer heat
ASSERT LAST_N == h0 + 5 "pr h+5"
GETF printer energy
ASSERT LAST_N == e0 - 5 "pr e-5"
GETF printer atp
ASSERT LAST_N == a0 - 5 "pr atp-5"
GETF printer pcr
ASSERT LAST_N == c0 "pr pcr held"
GETF printer reserve
ASSERT LAST_N == r0 "pr reserve held"
GETF printer age
ASSERT LAST_N == age0 "pr age held"
GETF printer pmf
ASSERT LAST_N == pmf0 "pr pmf held"
GETF printer setpoint
ASSERT LAST_N == sp0 "pr sp held"
GETF printer threshold
ASSERT LAST_N == thr0 "pr thr held"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink anmk 3
ASSERT LAST_N == 3 "ink anmk"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink murq 3
ASSERT LAST_N == 3 "ink murq"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink mura 4
ASSERT LAST_N == 4 "pre ink mura"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink murb 3
ASSERT LAST_N == 3 "pre ink murb"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink murc 3
ASSERT LAST_N == 3 "pre ink murc"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink murd 3
ASSERT LAST_N == 3 "pre ink murd"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink mure 3
ASSERT LAST_N == 3 "pre ink mure"
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink murf 3
ASSERT LAST_N == 3 "ink murf"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink h+3"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink e-3"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink atp-3"
SEND scrap murd 3
SEND scrap mure 3
SEND scrap murf 3
ASSERT LAST_N == 0 "scrap murf0"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer murd 3
ASSERT LAST_N == 3 "pre printer murd"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer mure 3
ASSERT LAST_N == 3 "pre printer mure"
SEND printer murf 0
ASSERT LAST_N == 0 "pr murf n0"
SEND printer murf -2
ASSERT LAST_N == 0 "pr murf nneg"
GETF printer alive
ASSERT LAST_N == 1 "pr alive"
