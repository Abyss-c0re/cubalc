// atomic_printer_mesh_dendrite.cubalc
// Life-force gift: MESH-DENDRITE — complete dendrite mesh + dendrite branch ring + spine gather after soft-OOB storms.
// SMX DENDRITE|SPINE|BRANCH|MESH_DENDRITE|RAISE_DENDRITE|WE_DENDRITE|LIFE_DENDRITE clears thrash, every live pair exchanges
// both ways (C(n,2)), then dendrite branch ring settles so lattice raises synapse; latches SMX_DENDRITE|SMX_MESH_EXCHANGE|SMX_STABLE_MESH|SMX_BRANCH.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is dendrited;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+IS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "DENDRITE_COORD v1720 | from=gift | type=atomic_printer_mesh_dendrite | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then SYNAPSE latch — five live nodes root as complete mesh + exchange + nexi
SMX DENDRITE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "dendrite live"
ASSERT SMX_DENDRITE == 1 "dendrite latch on"
ASSERT SMX_DENDRITE_LATCH == 1 "dendrite latch sticky"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange latch on"
ASSERT SMX_HARDEN_DENDRITE == 1 "harden dendrite latch on"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh latch sticky"
ASSERT SMX_SPINE_LATCH == 1 "spine latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected links (C(5,2))"
ASSERT SMX_BRANCH == 5 "five dendrite branch ring"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_SPINES == 5 "five spines"
ASSERT SMX_BRANCHES == 5 "dendrite branch ring sticky"
ASSERT SMX_BRANCHES == 5 "five dendrite branch ring steps"
ASSERT SMX_DENDRITE_SUM == 20 "dendrite bonds+tracts+myelin"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+tracts+myelin"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by dendrite"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after dendrite (mesh + ring + nexi)"
ASSERT SMX_VITAL >= 14 "vital after dendrite"
ASSERT CUBES == base_cubes "dendrite invents nothing"

// Alias MESH_EXCHANGE form still pure
SMX MESH_DENDRITE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_dendrite rebind"
ASSERT SMX_DENDRITE == 1 "dendrite sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_SPINES == 5 "spines sticky"
ASSERT SMX_BRANCHES == 5 "branches sticky"

// Alias EXRINGS form
SMX BRANCHS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "tracts rebind"
ASSERT SMX_DENDRITE == 1 "plate dendrite"
ASSERT SMX_BRANCHES == 5 "branches sticky"


// Alias BRANCH / SPINE / ARBOR rebind
SMX BRANCH bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "branch rebind"
ASSERT SMX_DENDRITE == 1 "dendrite sticky via branch"
ASSERT SMX_BRANCHES == 5 "branches sticky"

SMX SPINES bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "spine rebind"
ASSERT SMX_SPINES == 5 "spines sticky"
ASSERT SMX_DENDRITE == 1 "dendrite via spine"

SMX ARBOR bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "arbor rebind"
ASSERT SMX_ARBOR == 1 "arbor latch"
ASSERT SMX_DENDRITE == 1 "dendrite via arbor"

// Mitosis under free energy while the mesh is dendrited
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      IF births == 0 THEN
        SETF d1 alive 1
        SETF d1 ready 0
        SETF d1 energy half
        SETF d1 gen dg
        PLUG bed d1
        LET births = 1
      ELSE
        IF births == 1 THEN
          SETF d2 alive 1
          SETF d2 ready 0
          SETF d2 energy half
          SETF d2 gen dg
          PLUG nozzle d2
          LET births = 2
        END
      END
      GETF seed energy
      LET left = LAST_N - half
      IF left < 1 THEN
        LET left = 1
      END
      SETF seed energy left
      SETF seed ready 0
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis under dendrite free energy"
ASSERT SMX_DENDRITE == 1 "dendrite holds through mitosis"

// RECOVER restores vital/key
SMX RECOVER
ASSERT SMX_OK == 1 "recover ok"
ASSERT SMX_KEY_OK == 1 "key after recover"
ASSERT SMX_VITAL >= 1 "vital after recover"

// dual SEAL/OPEN rails BN+IS rebind hive
SMX SEAL bed nozzle "state/smx_dendrite/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_dendrite/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"
SMX SEAL hive scrap "state/smx_dendrite/rail_is.cblc"
ASSERT SMX_OK == 1 "seal IS"
SMX OPEN pulse "state/smx_dendrite/rail_is.cblc"
ASSERT SMX_OK == 1 "open IS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Re-forge after rails
SMX DENDRITE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "re-dendrite live"
ASSERT SMX_DENDRITE == 1 "re-dendrite latch"
ASSERT SMX_BONDS == 10 "re-dendrite bonds"
ASSERT SMX_BRANCHES == 5 "re-dendrite exrings"
ASSERT SMX_SPINES == 5 "re-dendrite nexi"
ASSERT SMX_DENDRITE_SUM == 20 "re-dendrite sum"
ASSERT SMX_OOB == 0 "oob clear after re-forge"

// Second storm fail-closed
SMX TALK bed ghost_again
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

// SYNAPSE clears thrash again
SMX DENDRITE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "dendrite after storm2"
ASSERT SMX_DENDRITE == 1 "dendrite latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again"
ASSERT SMX_BONDS == 10 "bonds after storm2"
ASSERT SMX_BRANCHES == 5 "tracts after storm2"
ASSERT SMX_SPINES == 5 "myelins after storm2"

HALT
