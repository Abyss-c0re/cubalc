// atomic_printer_life_align.cubalc
// Science board: LIFE_CELL_ALIGN - planar cell polarity after primary cilia.
// Atomic printer continuum: ... lumen -> cilia -> align (PCP thr+sp co-lock).
// Free energy must flow. Cube is SoT. Gift law: life-force manifestation.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY cell OF Cell 1 16 0
ENTITY tissue OF Cell 1 14 0
ENTITY axis OF Cell 1 18 0

SEND cell set_threshold 10
SEND tissue set_threshold 10
SEND axis set_threshold 12
SEND cell set_setpoint 10
SEND tissue set_setpoint 10
SEND axis set_setpoint 10

SEND cell pulse 6
SEND cell photosynth 8
SEND cell glycolyse 6
SEND cell pump 5
SEND cell photophos 6
GETF cell atp
ASSERT LAST_N >= 10 "sci atp"
GETF cell age
LET a0 = LAST_N
GETF cell heat
LET h0 = LAST_N
GETF cell energy
LET e0 = LAST_N
GETF cell reserve
LET r0 = LAST_N
GETF cell threshold
LET t0 = LAST_N
GETF cell pmf
LET p0 = LAST_N
GETF cell setpoint
LET s0 = LAST_N
GETF cell pcr
LET c0 = LAST_N
ASSERT s0 == 10 "sci sp10"
ASSERT c0 == 0 "sci pcr0"

SEND cell seal 1
ASSERT LAST_N == 1 "sci seal"
SEND cell polar 1
ASSERT LAST_N == 1 "sci polar"
SEND cell lumen 1
ASSERT LAST_N == 1 "sci lumen"
SEND cell cilia 2
ASSERT LAST_N == 2 "sci cilia"
SEND cell align 3
ASSERT LAST_N == 3 "sci align3"

GETF cell heat
ASSERT LAST_N == h0 + 1 + 1 + 1 + 2 + 3 "sci heat path"
GETF cell threshold
ASSERT LAST_N == t0 + 1 + 3 "sci thr seal+align"
GETF cell setpoint
ASSERT LAST_N == s0 + 1 + 3 "sci sp polar+align"
GETF cell pmf
ASSERT LAST_N == p0 + 2 "sci pmf cilia held through align"
GETF cell pcr
ASSERT LAST_N == c0 + 1 "sci pcr lumen held"
GETF cell energy
ASSERT LAST_N == e0 "sci energy held"
GETF cell age
ASSERT LAST_N == a0 "sci age held"
GETF cell reserve
ASSERT LAST_N == r0 "sci reserve held"
GETF cell atp
ASSERT LAST_N >= 2 "sci atp remaining"
GETF cell alive
ASSERT LAST_N == 1 "sci cell lives"

SEND tissue pulse 5
SEND tissue photosynth 6
SEND tissue glycolyse 5
SEND tissue pump 3
SEND tissue photophos 4
GETF tissue pmf
LET tp0 = LAST_N
GETF tissue threshold
LET tt0 = LAST_N
GETF tissue setpoint
LET ts0 = LAST_N
GETF tissue heat
LET th0 = LAST_N
GETF tissue energy
LET te0 = LAST_N
GETF tissue atp
ASSERT LAST_N >= 3 "sci tissue atp"
SEND tissue cilia 1
SEND tissue align 2
ASSERT LAST_N == 2 "sci tissue align"
GETF tissue pmf
ASSERT LAST_N == tp0 + 1 "sci tissue pmf"
GETF tissue threshold
ASSERT LAST_N == tt0 + 2 "sci tissue thr"
GETF tissue setpoint
ASSERT LAST_N == ts0 + 2 "sci tissue sp"
GETF tissue heat
ASSERT LAST_N == th0 + 1 + 2 "sci tissue heat"
GETF tissue energy
ASSERT LAST_N == te0 "sci tissue energy held"
GETF tissue ready
LET tr = LAST_N
GETF tissue energy
LET te1 = LAST_N
GETF tissue threshold
LET tt1 = LAST_N
IF te1 >= tt1 THEN
  ASSERT tr == 1 "sci tissue ready1"
ELSE
  ASSERT tr == 0 "sci tissue ready0"
END

SEND axis pulse 5
SEND axis photosynth 6
SEND axis glycolyse 6
SEND axis photophos 6
SEND axis set_threshold 997
SEND axis set_setpoint 998
GETF axis atp
LET aa = LAST_N
ASSERT aa >= 4 "sci axis atp"
SEND axis align 4
ASSERT LAST_N == 4 "sci axis align4"
GETF axis threshold
ASSERT LAST_N == 1000 "sci axis thr cap"
GETF axis setpoint
ASSERT LAST_N == 1000 "sci axis sp cap"
GETF axis alive
ASSERT LAST_N == 1 "sci axis lives"

GETF cell pmf
LET p_end = LAST_N
ASSERT p_end >= p0 + 2 "sci wonder pmf retained"
GETF cell threshold
LET t_end = LAST_N
ASSERT t_end >= t0 + 4 "sci wonder thr axis bar"
GETF cell setpoint
LET s_end = LAST_N
ASSERT s_end >= s0 + 4 "sci wonder sp homeostat"

PRINT "atomic_printer_life_align OK"
