// smx_mesh_vesicle_aars_life.cubalc
// SMX mesh vesicle life-force: aminoacyl-tRNA synthetase charging after pepr.
// Cube is SoT. Free energy must flow.
REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY vesicle OF Cell 1 44 0
SEND vesicle set_threshold 8
SEND vesicle pulse 4
SEND vesicle photosynth 32
SEND vesicle glycolyse 28
SEND vesicle pump 18
SEND vesicle photophos 18
SEND vesicle charge 26
SEND vesicle feed 26
SEND vesicle retrieve 2
SEND vesicle acidify 2
SEND vesicle mature 2
SEND vesicle recruit 2
SEND vesicle activate 2
SEND vesicle degrade 2
SEND vesicle export 2
SEND vesicle translate 2
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 14
SEND vesicle feed 12
SEND vesicle transloc 2
SEND vesicle cleave 2
SEND vesicle glycosyl 2
SEND vesicle trim 3
ASSERT LAST_N == 3 "smx trim3"
SEND vesicle cnx 2
ASSERT LAST_N == 2 "smx cnx2"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 12
SEND vesicle charge_pcr 14
SEND vesicle uggt 2
ASSERT LAST_N == 2 "smx uggt2"
SEND vesicle photosynth 16
SEND vesicle glycolyse 12
SEND vesicle charge 18
SEND vesicle feed 12
SEND vesicle mann 3
ASSERT LAST_N == 3 "smx pre mann3"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle os9 2
ASSERT LAST_N == 2 "smx pre os92"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle hrd 2
ASSERT LAST_N == 2 "smx pre hrd2"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle vcp 2
ASSERT LAST_N == 2 "smx pre vcp2"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle psm 2
ASSERT LAST_N == 2 "smx pre psm2"
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle pepr 2
ASSERT LAST_N == 2 "smx pre pepr2"
GETF vesicle heat
LET h0 = LAST_N
GETF vesicle energy
LET e0 = LAST_N
GETF vesicle atp
LET a0 = LAST_N
GETF vesicle pcr
LET c0 = LAST_N
GETF vesicle age
LET age0 = LAST_N
GETF vesicle reserve
LET r0 = LAST_N
GETF vesicle pmf
LET pm0 = LAST_N
GETF vesicle threshold
LET t0 = LAST_N
GETF vesicle setpoint
LET s0 = LAST_N
SEND vesicle aars 2
ASSERT LAST_N == 2 "smx aars2"
GETF vesicle heat
ASSERT LAST_N == h0 + 2 "smx h+2"
GETF vesicle energy
ASSERT LAST_N == e0 - 2 "smx e-2"
GETF vesicle atp
ASSERT LAST_N == a0 - 2 "smx a-2"
GETF vesicle reserve
ASSERT LAST_N == r0 - 2 "smx res-2"
GETF vesicle age
ASSERT LAST_N == age0 "smx age"
GETF vesicle pcr
ASSERT LAST_N == c0 + 2 "smx pcr+2"
GETF vesicle pmf
ASSERT LAST_N == pm0 "smx pmf"
GETF vesicle setpoint
ASSERT LAST_N == s0 "smx sp"
GETF vesicle threshold
ASSERT LAST_N == t0 "smx thr"
SEND vesicle photosynth 18
SEND vesicle glycolyse 14
SEND vesicle charge 18
SEND vesicle feed 14
SEND vesicle charge_pcr 8
SEND vesicle mann 3
ASSERT LAST_N == 3 "smx pre2 mann3"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle os9 3
ASSERT LAST_N == 3 "smx pre2 os93"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle hrd 2
ASSERT LAST_N == 2 "smx pre2 hrd2"
SEND vesicle photosynth 14
SEND vesicle glycolyse 12
SEND vesicle charge 16
SEND vesicle feed 12
SEND vesicle vcp 2
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle psm 2
SEND vesicle photosynth 12
SEND vesicle glycolyse 10
SEND vesicle charge 14
SEND vesicle feed 10
SEND vesicle pepr 2
ASSERT LAST_N == 2 "smx pre pepr2b"
GETF vesicle heat
LET h1 = LAST_N
GETF vesicle reserve
LET r1 = LAST_N
GETF vesicle pcr
LET c1 = LAST_N
GETF vesicle atp
LET a1 = LAST_N
GETF vesicle energy
LET e1 = LAST_N
SEND vesicle aars 3
ASSERT LAST_N == 3 "smx aars3"
GETF vesicle heat
ASSERT LAST_N == h1 + 3 "smx h+3"
GETF vesicle reserve
ASSERT LAST_N == r1 - 3 "smx res-3"
GETF vesicle pcr
ASSERT LAST_N == c1 + 3 "smx pcr+3"
GETF vesicle atp
ASSERT LAST_N == a1 - 3 "smx a-3"
GETF vesicle energy
ASSERT LAST_N == e1 - 3 "smx e-3"
ASSERT 1 == 1 "smx_mesh_vesicle_aars_life_ok"

PRINT "smx_mesh_vesicle_aars_life PASS"
