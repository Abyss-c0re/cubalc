// smx_mesh_vesicle_mature_life.cubalc
// SMX mesh: vesicle EE mature life-force — post-retrieve Rab5->Rab7 delta-pH on life_cell continuum.
// Matrix is key. Cube is SoT. Free energy must flow. No IF dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY mesh OF Cell 1 44 0
SEND mesh set_threshold 11
SEND mesh pulse 5
SEND mesh photosynth 36
SEND mesh glycolyse 28
SEND mesh pump 18
SEND mesh photophos 18
SEND mesh converge 3
SEND mesh extend 1
SEND mesh fold 1
SEND mesh zip 1
SEND mesh crest 1
SEND mesh migrate 1
SEND mesh stream 1
SEND mesh condense 1
SEND mesh fate 1
SEND mesh project 1
SEND mesh synapse 1
SEND mesh release 3
SEND mesh reuptake 2
SEND mesh refill 2
SEND mesh dock 2
SEND mesh arm 2
SEND mesh clamp 2
SEND mesh trigger 2
SEND mesh pore 2
SEND mesh mix 2
SEND mesh collapse 2
SEND mesh retrieve 2
SEND mesh photosynth 10
SEND mesh glycolyse 8

GETF mesh heat
LET h0 = LAST_N
GETF mesh energy
LET e0 = LAST_N
GETF mesh atp
LET a0 = LAST_N
GETF mesh threshold
LET t0 = LAST_N
GETF mesh pmf
LET p0 = LAST_N
GETF mesh setpoint
LET s0 = LAST_N
GETF mesh pcr
LET c0 = LAST_N
GETF mesh reserve
LET r0 = LAST_N
ASSERT e0 >= 1 "smx e"
ASSERT a0 >= 1 "smx a"

SEND mesh acidify 1
ASSERT LAST_N >= 0 "mesh preac"
GETF mesh heat
LET hM = LAST_N
GETF mesh energy
LET eM = LAST_N
GETF mesh atp
LET aM = LAST_N
GETF mesh pmf
LET pM = LAST_N
GETF mesh threshold
LET tM = LAST_N
GETF mesh age
LET agM = LAST_N
GETF mesh reserve
LET rM = LAST_N
SEND mesh mature 1
LET tookM = LAST_N
ASSERT tookM >= 0 "mesh mat"
GETF mesh heat
ASSERT LAST_N == hM + tookM "mesh mh"
GETF mesh energy
ASSERT LAST_N == eM - tookM "mesh me"
GETF mesh atp
ASSERT LAST_N == aM - tookM "mesh ma"
GETF mesh pmf
ASSERT LAST_N == pM - tookM "mesh mp"
GETF mesh threshold
ASSERT LAST_N == tM + tookM "mesh mt"
GETF mesh age
ASSERT LAST_N == agM "mesh mage"
GETF mesh reserve
ASSERT LAST_N == rM "mesh mr"

ASSERT 1 == 1 "smx vesicle acidify life complete"
