// atomic_printer_life_momp.cubalc
// Science board: Bax/Bak MOMP on the atomic printer life cell.
// Pay n ATP oligomerize OMM pores → heat +1 + age +n (cyt c/SMAC/AIF release).
// Continuum: tether → mcu → nclx → mptp → momp apoptosis prime.
// Distinct from mptp (pmf bulk heat) and mitophagy. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 14 0
SEND printer set_threshold 10

SEND printer pulse 6
SEND printer photosynth 7
SEND printer glycolyse 4
SEND printer feed 4
SEND printer pump 6

GETF printer alive
ASSERT LAST_N == 1 "printer lives"
GETF printer age
ASSERT LAST_N == 6 "printer aged"
GETF printer atp
ASSERT LAST_N >= 4 "printer charged"
GETF printer pmf
ASSERT LAST_N == 6 "printer gradient"

GETF printer energy
LET e0 = LAST_N
GETF printer age
LET a0 = LAST_N
GETF printer pmf
LET p0 = LAST_N
GETF printer reserve
LET r0 = LAST_N
GETF printer atp
LET at0 = LAST_N
GETF printer heat
LET h0 = LAST_N

SEND printer tether 2
ASSERT LAST_N == 2 "tether take"
GETF printer energy
ASSERT LAST_N == e0 + 2 "MERCs yield"
GETF printer energy
LET e1 = LAST_N
GETF printer pmf
LET p1 = LAST_N
GETF printer atp
LET at1 = LAST_N

SEND printer mcu 2
ASSERT LAST_N == 2 "mcu take"
GETF printer energy
ASSERT LAST_N == e1 + 2 "TCA spark"
GETF printer heat
LET h2 = LAST_N
GETF printer age
LET a2 = LAST_N
GETF printer pmf
LET p2 = LAST_N
GETF printer energy
LET e2 = LAST_N

SEND printer nclx 1
ASSERT LAST_N == 1 "nclx take"
GETF printer heat
ASSERT LAST_N == h2 + 1 "exchanger tax"
GETF printer age
ASSERT LAST_N == a2 "nclx age held"
GETF printer pmf
LET p3 = LAST_N
GETF printer heat
LET h3 = LAST_N

SEND printer mptp 2
ASSERT LAST_N == 2 "mptp take"
GETF printer pmf
ASSERT LAST_N == p3 - 2 "mptp collapses"
GETF printer heat
ASSERT LAST_N == h3 + 2 "mptp bulk"
GETF printer age
ASSERT LAST_N == a2 + 1 "mptp injury"
GETF printer atp
LET at3 = LAST_N
GETF printer age
LET a3 = LAST_N
GETF printer heat
LET h4 = LAST_N
GETF printer pmf
LET p4 = LAST_N
GETF printer energy
LET e3 = LAST_N

SEND printer momp 2
ASSERT LAST_N == 2 "momp take"
GETF printer atp
ASSERT LAST_N == at3 - 2 "momp spends atp"
GETF printer age
ASSERT LAST_N == a3 + 2 "cyt-c release load"
GETF printer heat
ASSERT LAST_N == h4 + 1 "momp assembly tax"
GETF printer pmf
ASSERT LAST_N == p4 "momp pmf held"
GETF printer energy
ASSERT LAST_N == e3 "momp e held"
GETF printer reserve
ASSERT LAST_N == r0 "momp r held"
GETF printer alive
ASSERT LAST_N == 1 "printer lives after momp"

PRINT "atomic_printer_life_momp PASS"
