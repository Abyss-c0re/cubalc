// atomic_printer_life_collapse.cubalc
// Science board: life_cell collapse — post-mix omega-figure full-collapse fusion / vesicle-PM flatten.
// Atomic printer life-force continuum slice. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 50 0
SEND printer set_threshold 12
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 30
SEND printer pump 20
SEND printer photophos 20

SEND printer converge 3
SEND printer extend 1
SEND printer fold 1
SEND printer zip 1
SEND printer crest 1
SEND printer migrate 1
SEND printer stream 1
SEND printer condense 1
SEND printer fate 1
SEND printer project 1
SEND printer synapse 1
SEND printer release 4
SEND printer reuptake 2
SEND printer refill 2
SEND printer dock 2
SEND printer arm 2
SEND printer clamp 2
SEND printer trigger 2
SEND printer pore 2
SEND printer mix 2
SEND printer photosynth 12
SEND printer glycolyse 10

GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer threshold
LET t0 = LAST_N
GETF printer age
LET age0 = LAST_N
GETF printer reserve
LET r0 = LAST_N
GETF printer setpoint
LET s0 = LAST_N
GETF printer pmf
LET p0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
ASSERT r0 >= 1 "sci r primed"
ASSERT e0 >= 1 "sci e primed"
ASSERT a0 >= 1 "sci a primed"

SEND printer collapse 1
ASSERT LAST_N == 1 "sci collapse1"

GETF printer heat
ASSERT LAST_N == h0 + 1 "sci heat+1"
GETF printer energy
ASSERT LAST_N == e0 - 1 "sci energy-1"
GETF printer atp
ASSERT LAST_N == a0 - 1 "sci atp-1"
GETF printer reserve
ASSERT LAST_N == r0 - 1 "sci reserve-1"
GETF printer age
ASSERT LAST_N == age0 "sci age held"
GETF printer pcr
ASSERT LAST_N == c0 "sci pcr held"
GETF printer threshold
ASSERT LAST_N == t0 "sci thr held"
GETF printer setpoint
ASSERT LAST_N == s0 "sci sp held"
GETF printer pmf
ASSERT LAST_N == p0 "sci pmf held"

ENTITY dead OF Cell 0 20 0
SEND dead collapse 2
ASSERT LAST_N == 0 "sci dead0"

ENTITY poor OF Cell 1 0 0
SEND poor set_threshold 5
SEND poor collapse 2
ASSERT LAST_N == 0 "sci poor0"

ENTITY slim OF Cell 1 40 0
SEND slim set_threshold 9
SEND slim pulse 3
SEND slim photosynth 28
SEND slim glycolyse 22
SEND slim pump 14
SEND slim photophos 14
SEND slim converge 2
SEND slim release 3
SEND slim reuptake 2
SEND slim refill 1
SEND slim dock 1
SEND slim arm 1
SEND slim clamp 1
SEND slim trigger 1
SEND slim pore 1
SEND slim mix 1
SEND slim photosynth 8
GETF slim heat
LET sh = LAST_N
GETF slim energy
LET se = LAST_N
GETF slim atp
LET sa = LAST_N
GETF slim reserve
LET sr = LAST_N
GETF slim pcr
LET sc = LAST_N
ASSERT sr >= 1 "sci slim r"
ASSERT sa >= 1 "sci slim a"
SEND slim collapse 1
ASSERT LAST_N == 1 "sci slim1"
GETF slim heat
ASSERT LAST_N == sh + 1 "sci slim h"
GETF slim energy
ASSERT LAST_N == se - 1 "sci slim e"
GETF slim atp
ASSERT LAST_N == sa - 1 "sci slim a-"
GETF slim reserve
ASSERT LAST_N == sr - 1 "sci slim r-"
GETF slim pcr
ASSERT LAST_N == sc "sci slim pcr held"

ASSERT 1 == 1 "atomic printer life collapse science ok"
