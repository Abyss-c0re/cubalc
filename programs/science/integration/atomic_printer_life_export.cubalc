// atomic_printer_life_export.cubalc
// Atomic printer life-force: post-degrade lysosomal AA export.
// Continuum ...->recruit->activate->degrade->export. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY cell OF Cell 1 40 0
SEND cell set_threshold 10
SEND cell pulse 4
SEND cell photosynth 36
SEND cell glycolyse 30
SEND cell pump 20
SEND cell photophos 18
SEND cell charge 30
SEND cell feed 30

SEND cell converge 2
SEND cell extend 1
SEND cell fold 1
SEND cell zip 1
SEND cell crest 1
SEND cell migrate 1
SEND cell stream 1
SEND cell condense 1
SEND cell fate 1
SEND cell project 1
SEND cell synapse 1
SEND cell release 2
SEND cell reuptake 2
SEND cell refill 2
SEND cell dock 2
SEND cell arm 2
SEND cell clamp 2
SEND cell trigger 2
SEND cell pore 2
SEND cell mix 2
SEND cell collapse 2
SEND cell retrieve 2
SEND cell acidify 2
SEND cell mature 2
SEND cell photosynth 12
SEND cell glycolyse 10
SEND cell charge 12
SEND cell feed 12
SEND cell recruit 2
ASSERT LAST_N >= 0 "sci rec"
SEND cell activate 2
ASSERT LAST_N >= 0 "sci act"
SEND cell photosynth 10
SEND cell glycolyse 8
SEND cell charge 10
SEND cell feed 10
SEND cell degrade 2
ASSERT LAST_N == 2 "sci degprep"
SEND cell photosynth 8
SEND cell glycolyse 6
SEND cell charge 8
SEND cell feed 8

GETF cell heat
LET h0 = LAST_N
GETF cell energy
LET e0 = LAST_N
GETF cell atp
LET a0 = LAST_N
GETF cell age
LET ag0 = LAST_N
GETF cell pcr
LET c0 = LAST_N
GETF cell reserve
LET r0 = LAST_N
GETF cell threshold
LET t0 = LAST_N
GETF cell pmf
LET p0 = LAST_N
GETF cell setpoint
LET s0 = LAST_N

SEND cell export 2
LET took = LAST_N
ASSERT took == 2 "sci exp took2"
GETF cell heat
ASSERT LAST_N == h0 + took "sci exp heat"
GETF cell energy
ASSERT LAST_N == e0 - took "sci exp e"
GETF cell atp
ASSERT LAST_N == a0 - took "sci exp a"
GETF cell age
ASSERT LAST_N == ag0 "sci exp age held"
GETF cell pcr
ASSERT LAST_N == c0 - took "sci exp pcr"
GETF cell reserve
ASSERT LAST_N == r0 + took "sci exp r"
GETF cell threshold
ASSERT LAST_N == t0 "sci exp thr held"
GETF cell pmf
ASSERT LAST_N == p0 "sci exp pmf held"
GETF cell setpoint
ASSERT LAST_N == s0 "sci exp sp held"

PRINT "atomic_printer_life_export PASS"
