REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_FORCE MI2296 SMX mesh vesicle: CS after MDH on sealed BA limb.
# Vesicle cells exchange free energy under SMX-stable metabolism path:
#   pcca -> mcee -> mut -> suclg1 -> sdha -> fh -> mdh -> cs opens citrate TCA entry on the vesicle wall.
# Wonder: ASSERT heat+n atp-n energy-n synthase after MDH; dead refused.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY vesicle OF Cell 1 55 0
ENTITY cargo OF Cell 1 36 0
ENTITY lysed OF Cell 0 12 0

SEND vesicle set_threshold 9
SEND cargo set_threshold 11

SEND vesicle pulse 3
SEND vesicle photosynth 28
SEND vesicle glycolyse 20
SEND vesicle charge 26
SEND vesicle feed 20
GETF vesicle energy
ASSERT LAST_N >= 16 "vesicle energy"
GETF vesicle atp
ASSERT LAST_N >= 16 "vesicle atp"

SEND vesicle pcca 2
ASSERT LAST_N == 2 "vesicle pcca"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mcee 2
ASSERT LAST_N == 2 "vesicle mcee"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mut 2
ASSERT LAST_N == 2 "vesicle mut"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle suclg1 2
ASSERT LAST_N == 2 "vesicle suclg1"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle sdha 2
ASSERT LAST_N == 2 "vesicle sdha"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle fh 2
ASSERT LAST_N == 2 "vesicle fh"
SEND vesicle photosynth 12
SEND vesicle charge 12
SEND vesicle feed 10
SEND vesicle mdh 2
ASSERT LAST_N == 2 "vesicle mdh"
SEND vesicle photosynth 14
SEND vesicle charge 14
SEND vesicle feed 12
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
SEND vesicle cs 3
ASSERT LAST_N == 3 "vesicle cs 3"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "vesicle cs heat+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "vesicle cs energy-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "vesicle cs atp-3"
GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive post-cs"

SEND cargo photosynth 18
SEND cargo charge 16
SEND cargo feed 14
SEND cargo mdh 1
ASSERT LAST_N == 1 "cargo mdh open"
SEND cargo photosynth 10
SEND cargo charge 10
SEND cargo feed 8
GETF cargo heat
LET ch = LAST_N
GETF cargo energy
LET ce = LAST_N
GETF cargo atp
LET ca = LAST_N
SEND cargo cs 2
ASSERT LAST_N == 2 "cargo cs 2"
GETF cargo heat
ASSERT LAST_N == ch + 2 "cargo cs heat+2"
GETF cargo energy
ASSERT LAST_N == ce - 2 "cargo cs energy-2"
GETF cargo atp
ASSERT LAST_N == ca - 2 "cargo cs atp-2"
GETF cargo alive
ASSERT LAST_N == 1 "cargo alive post-cs"

SEND lysed cs 3
ASSERT LAST_N == 0 "lysed cs refused"
GETF lysed alive
ASSERT LAST_N == 0 "lysed stays dead"

ASSERT 1 == 1 "smx_mesh_vesicle_cs_life PASS"
