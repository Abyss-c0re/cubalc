// atomic_printer_life_secrete.cubalc
// Science board: atomic printer colony trophic vesicle via life_cell secrete.
// Merocrine bequeath — free energy meters from living donor into heir without PCD.
// Cube is SoT. Manifest life-force: secretion as colony metabolism path.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY founder OF Cell 1 48 0
ENTITY heir OF Cell 1 2 1
ENTITY witness OF Cell 1 1 2

SEND founder set_threshold 12
SEND heir set_threshold 12
SEND witness set_threshold 12

SEND founder photosynth 8
ASSERT LAST_N == 8 "founder fix 8 light->reserve"
SEND founder stores
ASSERT LAST_N == 8 "founder glycogen 8"
GETF founder energy
ASSERT LAST_N == 48 "founder active held"
SEND founder bank 16
ASSERT LAST_N == 16 "founder banks 16"
GETF founder energy
ASSERT LAST_N == 32 "founder e32"
SEND founder stores
ASSERT LAST_N == 24 "founder reserve 24"
SEND founder yield
LET yf0 = LAST_N
ASSERT yf0 == 56 "founder yield 56 before vesicle"

SEND founder secrete 20
LET code = LAST_N
ASSERT code == 20000 "vesicle code e20"
GETF founder alive
ASSERT LAST_N == 1 "founder still living merocrine"
SEND founder yield
LET yf1 = LAST_N
ASSERT yf0 - yf1 == 20 "founder shed 20 to vesicle"
GETF founder energy
ASSERT LAST_N == 12 "founder e12 after secrete"
SEND founder stores
ASSERT LAST_N == 24 "founder r held"

LET de = code / 1000
LET dr = code - de * 1000
ASSERT de == 20 "bequeath energy 20"
ASSERT dr == 0 "bequeath reserve 0"
ASSERT de + dr == 20 "vesicle size"

SEND heir yield
LET yh0 = LAST_N
ASSERT yh0 == 2 "heir prior yield 2"
SEND heir inherit code
ASSERT LAST_N == 20 "heir absorbed 20"
SEND heir yield
LET yh1 = LAST_N
ASSERT yh1 == 22 "heir yield 22"
GETF heir energy
ASSERT LAST_N == 22 "heir e22"
GETF heir ready
ASSERT LAST_N == 1 "heir ready after trophic vesicle"
ASSERT yh1 - yh0 == yf0 - yf1 "printer conservation law secrete"

SEND founder secrete 30
LET c2 = LAST_N
ASSERT c2 == 11019 "second vesicle energy+reserve"
GETF founder energy
ASSERT LAST_N == 1 "founder spark after deep secrete"
SEND founder stores
ASSERT LAST_N == 5 "founder r5 left"
GETF founder alive
ASSERT LAST_N == 1 "still alive after deep secrete"
SEND witness inherit c2
ASSERT LAST_N == 30 "witness +30"
GETF witness ready
ASSERT LAST_N == 1 "witness ready e1+11=12 >=12"

ENTITY nurse OF Cell 1 18 0
SEND nurse set_threshold 10
SEND nurse bank 6
SEND nurse quiesce
SEND nurse yield
LET yn = LAST_N
SEND nurse secrete 9
LET nc = LAST_N
LET nde = nc / 1000
LET ndr = nc - nde * 1000
ASSERT nde + ndr == 9 "nurse metered 9"
ASSERT nde + ndr <= yn "nurse within yield"
GETF nurse alive
ASSERT LAST_N == 1 "nurse lives G0 secrete"

ENTITY t_die OF Cell 1 14 0
ENTITY t_sec OF Cell 1 14 0
ENTITY sink OF Cell 1 0 5
SEND t_die set_threshold 10
SEND t_sec set_threshold 10
SEND sink set_threshold 10
SEND t_die bank 4
SEND t_sec bank 4
SEND t_die die
SEND t_sec secrete 100
LET sc2 = LAST_N
ASSERT sc2 == 9004 "secrete twin code transferable"
SEND t_die yield
ASSERT LAST_N == 0 "die twin empty"
GETF t_sec alive
ASSERT LAST_N == 1 "secrete twin lives"
SEND sink inherit sc2
ASSERT LAST_N == 13 "sink ate secrete twin pack"
SEND sink inherit 0
ASSERT LAST_N == 0 "nothing left from die twin"

ENTITY lx OF Cell 1 20 0
ENTITY sx OF Cell 1 20 0
SEND lx set_threshold 10
SEND sx set_threshold 10
SEND lx bank 5
SEND sx bank 5
SEND lx lyse
ASSERT LAST_N == 15005 "lyse full"
GETF lx alive
ASSERT LAST_N == 0 "lyse dead"
SEND sx secrete 100
ASSERT LAST_N == 14005 "secrete keeps spark"
GETF sx alive
ASSERT LAST_N == 1 "secrete alive"

ASSERT 1 == 1 "science secrete board sealed"
