SEND vesicle photosynth 24
SEND vesicle glycolyse 20
SEND vesicle charge 30
SEND vesicle feed 20
SEND vesicle rodz 2
ASSERT LAST_N == 2 "vx pre_rodz2"
SEND vesicle photosynth 24
SEND vesicle glycolyse 20
SEND vesicle charge 28
SEND vesicle feed 18
SEND vesicle pbp2 2
ASSERT LAST_N == 2 "vx pre_pbp22"
SEND vesicle photosynth 24
SEND vesicle glycolyse 20
SEND vesicle charge 28
SEND vesicle feed 18
SEND vesicle lpoa 2
ASSERT LAST_N == 2 "vesicle pre_lpoa"
SEND vesicle photosynth 24
SEND vesicle glycolyse 20
SEND vesicle charge 28
SEND vesicle feed 18
SEND vesicle pbp1a 2
ASSERT LAST_N == 2 "vx pbp1a2"
GETF vesicle pcr
ASSERT LAST_N == vp "vx pcr held"

ASSERT 1 == 1 "smx_mesh_vesicle_pbp1a_life sealed"

