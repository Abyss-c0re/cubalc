// atomic_printer_mesh_forged_life.cubalc
// Life-force gift: MESH-FORGED-LIFE — complete forged mesh + temper ring + anvil hub root after soft-OOB storms.
// SMX FORGED|TEMPERED|TEMPER|ANVILVERSE|WE_FORGED|LIFE_ANVIL|MESH_FORGED|RAISE_FORGED clears thrash, every live pair exchanges
// both ways (C(n,2)), then temper ring settles so lattice raises forged; latches SMX_FORGED|SMX_TEMPERED|SMX_ANVIL_LATCH|SMX_TEMPER.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is forged;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+IS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "ANVIL_COORD v1 | from=gift | type=atomic_printer_mesh_forged | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then FORGED latch — five live nodes root as complete mesh + temper + anvils
SMX FORGED bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "forged live"
ASSERT SMX_FORGED == 1 "forged latch on"
ASSERT SMX_FORGED_LATCH == 1 "forged latch sticky"
ASSERT SMX_TEMPERED == 1 "tempered latch on"
ASSERT SMX_TEMPER == 1 "temper latch on"
ASSERT SMX_ANVIL_LATCH == 1 "anvil latch on"
ASSERT SMX_ANVILVERSE == 1 "anvilverse latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected links (C(5,2))"
ASSERT SMX_STRIKE == 5 "five temper ring"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_ANVILS == 5 "five anvils"
ASSERT SMX_STRIKES == 5 "temper ring sticky"
ASSERT SMX_STRIKES == 5 "five temper ring steps"
ASSERT SMX_FORGE_SUM == 20 "forged bonds+strikes+anvils"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+strikes+anvils"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by forged"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after forged (mesh + temper + anvils)"
ASSERT SMX_VITAL >= 14 "vital after forged"
ASSERT CUBES == base_cubes "forged invents nothing"

// Alias TEMPER form still pure
SMX TEMPER bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "temper rebind"
ASSERT SMX_FORGED == 1 "forged sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_ANVILS == 5 "anvils sticky"
ASSERT SMX_STRIKES == 5 "strikes sticky"

// Alias STRIKES form
SMX STRIKES bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "strikes rebind"
ASSERT SMX_FORGED == 1 "plate forged"
ASSERT SMX_STRIKES == 5 "strikes sticky"

// Mitosis under free energy while the mesh is forged
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      IF births == 0 THEN
        SETF d1 alive 1
        SETF d1 ready 0
        SETF d1 energy half
        SETF d1 gen dg
        PLUG bed d1
        LET births = 1
      ELSE
        IF births == 1 THEN
          SETF d2 alive 1
          SETF d2 ready 0
          SETF d2 energy half
          SETF d2 gen dg
          PLUG nozzle d2
          LET births = 2
        END
      END
      GETF seed energy
      LET left = LAST_N - half
      IF left < 1 THEN
        LET left = 1
      END
      SETF seed energy left
      SETF seed ready 0
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis under forged free energy"
ASSERT SMX_FORGED == 1 "forged holds through mitosis"

// RECOVER restores vital/key

// RECOVER restores vital/key
SMX RECOVER
ASSERT SMX_OK == 1 "recover ok"
ASSERT SMX_KEY_OK == 1 "key after recover"
ASSERT SMX_VITAL >= 1 "vital after recover"

// Dual SEAL/OPEN rails BN+HS under forged orbit
SMX SEAL bed nozzle "state/smx_forged/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_forged/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_forged/rail_hs.cblc"
ASSERT SMX_OK == 1 "seal rail HS"
SMX OPEN pulse "state/smx_forged/rail_hs.cblc"
ASSERT SMX_OK == 1 "open HS onto pulse"
ASSERT CUBES >= base_cubes "rails keep cubes"

// Final forged lock + vitals
SMX FORGED bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "final forged lock"
ASSERT SMX_FORGED == 1 "final forged"
ASSERT SMX_FORGEDED == 1 "final forgeded"
ASSERT SMX_TEMPERED == 1 "final tempered"
ASSERT SMX_BONDS == 10 "final bonds"
ASSERT SMX_MESH == 5 "final mesh"
ASSERT SMX_STRIKES == 5 "final strikes"
ASSERT SMX_ANVILS == 5 "final anvils"
ASSERT SMX_FORGE_SUM == 20 "final forge sum"
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after forged"
ASSERT SMX_KEY_OK == 1 "key after forged"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after forged"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

// Second storm fail-closed
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

// FORGED clears thrash again
SMX FORGED bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "forged after storm2"
ASSERT SMX_FORGED == 1 "forged latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again"
ASSERT SMX_BONDS == 10 "bonds after storm2"
ASSERT SMX_STRIKES == 5 "strikes after storm2"
ASSERT SMX_ANVILS == 5 "anvils after storm2"
ASSERT SMX_FORGE_SUM == 20 "sum after storm2"

PRINT "atomic_printer_mesh_forged_life" births SMX_OK SMX_FORGED SMX_FORGEDED SMX_TEMPERED SMX_STRIKES SMX_ANVILS SMX_FORGE_SUM SMX_BONDS SMX_MESH SMX_OOB CUBES UNITY ENERGY
PASS
