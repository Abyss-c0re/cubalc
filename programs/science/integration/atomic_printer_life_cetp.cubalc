ASSERT LAST_N == 1 "ink alive post-cetp"

# press triple cassette: ABCA1 + ABCG1 + CETP
SEND press photosynth 16
SEND press charge 14
SEND press feed 12
SEND press abca1 1
ASSERT LAST_N == 1 "press abca1 triple seed"
SEND press abcg1 1
ASSERT LAST_N == 1 "press abcg1 triple load"
GETF press heat
LET ph = LAST_N
GETF press energy
LET pe = LAST_N
GETF press atp
LET pa = LAST_N
SEND press cetp 2
ASSERT LAST_N == 2 "press cetp CE-transfer pack-2"
GETF press heat
ASSERT LAST_N == ph + 2 "press cetp heat+2"
GETF press energy
ASSERT LAST_N == pe - 2 "press cetp energy-2"
GETF press atp
ASSERT LAST_N == pa - 2 "press cetp atp-2"
GETF press alive
ASSERT LAST_N == 1 "press alive post-cetp"

SEND dead cetp 3
ASSERT LAST_N == 0 "dead cetp refused"
GETF dead alive
ASSERT LAST_N == 0 "dead stays dead"

ASSERT 1 == 1 "atomic_printer_life_cetp PASS"
