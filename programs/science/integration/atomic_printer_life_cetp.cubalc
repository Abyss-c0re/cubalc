SEND ink cetp 2
ASSERT LAST_N == 2 "ink cetp CE-transfer pack-2"
GETF ink heat
ASSERT LAST_N == ih + 2 "ink cetp heat+2"
GETF ink energy
ASSERT LAST_N == ie - 2 "ink cetp energy-2"
GETF ink atp
ASSERT LAST_N == ia - 2 "ink cetp atp-2"
