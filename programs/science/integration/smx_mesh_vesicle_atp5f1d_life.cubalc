ASSERT LAST_N == s_age "mesh atp5f1d age held"
GETF mesh pcr
ASSERT LAST_N == s_pcr "mesh atp5f1d pcr held"
GETF mesh reserve
ASSERT LAST_N == s_rsv "mesh atp5f1d reserve held"
GETF mesh pmf
ASSERT LAST_N == s_pmf "mesh atp5f1d pmf held"
GETF mesh threshold
ASSERT LAST_N == s_thr "mesh atp5f1d thr held"
GETF mesh alive
ASSERT LAST_N == 1 "mesh alive post-atp5f1d-delta"

ASSERT 1 == 1 "smx_mesh_vesicle_atp5f1d_life PASS"
