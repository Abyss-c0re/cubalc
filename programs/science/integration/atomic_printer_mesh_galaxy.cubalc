// atomic_printer_mesh_galaxy — science integration board
// Life-force MESH-GALAXY sibling of flagship atomic printer.
// SMX GALAXY: stellar mesh + spiral arms + hub cores after soft-OOB storms.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_galaxy | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
PLUG bed seed

IMPULSE bed 1
ENERGYFLOW 4
FLOW 3

SMX KEY
SMX GALAXY bed nozzle hive scrap pulse
ASSERT SMX_GALAXIED == 1 "science galaxy latch"
ASSERT SMX_MESH == 5 "science five mesh"
ASSERT SMX_ARMS == 5 "science arm ring"
ASSERT SMX_CORES == 5 "science cores hub"
ASSERT SMX_STARS == 10 "science stars mesh"
ASSERT SMX_BONDS == 10 "science bonds C(5,2)"
ASSERT SMX_OOB == 0 "science clear channel"
ASSERT SMX_OK == 1 "science galaxy ok"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0
ASSERT UNITY >= 40
PRINT "science_mesh_galaxy" SMX_GALAXIED SMX_GALAXY SMX_MESH SMX_ARMS SMX_CORES SMX_STARS SMX_BONDS ENERGY UNITY
PASS
