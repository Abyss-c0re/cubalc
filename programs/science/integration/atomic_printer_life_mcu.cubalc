// atomic_printer_life_mcu.cubalc
// Science board: mito Ca2+ uniporter (MCU/MICU) on the atomic printer life cell.
// ΔΨm-paid Ca2+ entry kicks PDH/ICD/OGDH → energy while holding atp/age/reserve.
// Continuum with MERCs tether: contacts deliver Ca2+; MCU admits it into matrix.
// Cube is SoT. Free energy must flow. AGI INCLUDE life_cell wonder.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 14 0
SEND printer set_threshold 10

SEND printer pulse 6
SEND printer photosynth 7
SEND printer glycolyse 4
SEND printer feed 4
SEND printer pump 6

GETF printer alive
ASSERT LAST_N == 1 "printer lives"
GETF printer age
ASSERT LAST_N == 6 "printer aged"
GETF printer atp
ASSERT LAST_N >= 4 "printer charged"
GETF printer pmf
ASSERT LAST_N == 6 "printer gradient"

GETF printer energy
LET e0 = LAST_N
GETF printer age
LET a0 = LAST_N
GETF printer pmf
LET p0 = LAST_N
GETF printer atp
LET at0 = LAST_N
GETF printer reserve
LET r0 = LAST_N

// MERCs first (ATP tax, pmf held), then MCU (pmf tax, ATP held)
SEND printer tether 2
ASSERT LAST_N == 2 "tether take"
GETF printer energy
ASSERT LAST_N == e0 + 2 "mercs yield"
GETF printer pmf
ASSERT LAST_N == p0 "gradient held mercs"
GETF printer atp
ASSERT LAST_N == at0 - 2 "atp tax mercs"

GETF printer energy
LET e1 = LAST_N
GETF printer pmf
LET p1 = LAST_N
GETF printer atp
LET at1 = LAST_N
SEND printer mcu 3
ASSERT LAST_N == 3 "mcu take"
GETF printer heat
ASSERT LAST_N >= 2 "assembly+transit heat"
GETF printer energy
ASSERT LAST_N == e1 + 3 "PDH ICD OGDH yield"
GETF printer pmf
ASSERT LAST_N == p1 - 3 "delta psi spent"
GETF printer atp
ASSERT LAST_N == at1 "atp held mcu"
GETF printer age
ASSERT LAST_N == a0 "age held"
GETF printer reserve
ASSERT LAST_N == r0 "cargo held"

GETF printer alive
ASSERT LAST_N == 1 "colony lives"
PRINT "atomic_printer_life_mcu PASS"
