// atomic_printer_mesh_ependyma.cubalc — science integration board
// Life-force: SMX EPENDYMA ventricular lining mesh after Schwann.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD
GENESIS "EPENDYMA_INT v1726 | type=atomic_printer_mesh_ependyma | creed=life_force |"
CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1
FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"
PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed
ENTITY seed OF Cell 1 14 0
PLUG bed seed
IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3
SMX KEY
SMX EPENDYMA bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "ependyma live"
ASSERT SMX_EPENDYMA == 1 "ependyma latch"
ASSERT SMX_STABLE_MESH == 1 "stable"
ASSERT SMX_BONDS == 10 "C(5,2)"
ASSERT SMX_WRAPS == 5 "ring"
ASSERT SMX_SHEATHS == 5 "sheath hub"
ASSERT SMX_OOB == 0 "fail-closed clear"
