// atomic_printer_mesh_bridge.cubalc
// Life-force gift: MESH-BRIDGE — soft-OOB storm wounds fail-closed on the
// printer spine; RECOVER restores vital/key; dual SEAL/OPEN bridges carry
// matrix mind across opposite edges; VITAL/STATUS ring + mitosis under free
// energy. Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_bridge | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 12 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Seal-wound: missing peer — fail-closed, no ghost place
SMX EXCHANGE hive offworld_bridge
ASSERT SMX_OK == 0 "seal-wound soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from seal-wound"

// Storm B: second missing peer — OOB sticky, still no thrash
SMX TALK nozzle ghost_bridge
ASSERT SMX_OK == 0 "seal-ghost soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from seal-ghost"

SMX EXCHANGE scrap void_bridge
ASSERT SMX_OK == 0 "seal-void soft-OOB"
ASSERT SMX_OOB >= 3 "oob C storm depth"
ASSERT CUBES == base_cubes "no ghost seal-void"

// Seal recover: clear OOB, keep key, restore vital
SMX RECOVER
ASSERT SMX_OK == 1 "mesh bridge recovered"
ASSERT SMX_OOB == 0 "oob cleared by recover"
ASSERT SMX_KEY_OK == 1 "key sticky through storm"
ASSERT SMX_VITAL >= 6 "vital restored"
ASSERT CUBES == base_cubes "recover invents nothing"

// MESH-BRIDGE: pre-bridge ring + SMX SEAL/OPEN file-bus matrix gift
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "pre-bridge ring ok"
ASSERT SMX_TALKS >= 2 "pre-bridge talks"

SMX SEAL bed hive "state/smx_bridge/spine_bh.cblc"
ASSERT SMX_OK == 1 "seal bed to hive ok"
ASSERT SMX_N > 64 "bridge frame A size"

SMX OPEN scrap "state/smx_bridge/spine_bh.cblc"
ASSERT SMX_OK == 1 "open seal onto scrap"
ASSERT CUBES == base_cubes "open invents no cubes"

SMX SEAL nozzle scrap "state/smx_bridge/spine_ns.cblc"
ASSERT SMX_OK == 1 "seal nozzle to scrap ok"
ASSERT SMX_N > 64 "bridge frame B size"

SMX OPEN hive "state/smx_bridge/spine_ns.cblc"
ASSERT SMX_OK == 1 "open seal2 onto hive"
ASSERT CUBES == base_cubes "open2 invents nothing"

SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after bridge"
ASSERT SMX_KEY_OK == 1 "key after bridge"
ASSERT SMX_VITAL >= 6 "vital holds after seal open"
ASSERT SMX_OOB == 0 "no oob after bridge"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

SMX EXCHANGE bed hive
SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "post-bridge ring"
ASSERT SMX_TALKS >= 4 "talks after bridge ring"
ASSERT CUBES == base_cubes "bridge invents nothing"
COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after bridge"
ASSERT UNITY >= 40 "mesh unity after mesh bridge"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Mitosis under free energy — life continues after mesh storm
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT births >= 1 "mitosis after mesh bridge"
ASSERT pop >= 2 "population after bridge life"
ASSERT SMX_OOB == 0 "guard holds through mitosis"
ASSERT OK == 1

PRINT "mesh_bridge" births pop SMX_N SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
