SEND dock ldte 2
ASSERT LAST_N == 2 "dock ldte"
SEND dock photosynth 14
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock ldtf 2
ASSERT LAST_N == 2 "dock ldtf"
SEND dock photosynth 14
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
GETF dock heat
LET dh = LAST_N
GETF dock energy
LET de = LAST_N
GETF dock atp
LET da = LAST_N
SEND dock dacc 2
ASSERT LAST_N == 2 "dock dacc"
GETF dock heat
ASSERT LAST_N == dh + 2 "dock dacc h+2"
GETF dock energy
ASSERT LAST_N == de - 2 "dock dacc e-2"
GETF dock atp
ASSERT LAST_N == da - 2 "dock dacc atp-2"

SEND void dacc 2
ASSERT LAST_N == 0 "void dacc 0"

GETF vesicle alive
ASSERT LAST_N == 1 "vesicle alive"
GETF vesicle energy
ASSERT LAST_N >= 0 "ves energy nonneg"
