SEND vesicle photosynth 18
SEND vesicle glycolyse 16
SEND vesicle charge 22
SEND vesicle feed 16
SEND vesicle ldtf 3
ASSERT LAST_N == 3 "vesicle ldtf"
SEND vesicle photosynth 18
SEND vesicle glycolyse 16
SEND vesicle charge 22
SEND vesicle feed 16
GETF vesicle heat
LET vh = LAST_N
GETF vesicle energy
LET ve = LAST_N
GETF vesicle atp
LET va = LAST_N
SEND vesicle dacc 3
ASSERT LAST_N == 3 "ves dacc"
GETF vesicle heat
ASSERT LAST_N == vh + 3 "ves dacc h+3"
GETF vesicle energy
ASSERT LAST_N == ve - 3 "ves dacc e-3"
GETF vesicle atp
ASSERT LAST_N == va - 3 "ves dacc atp-3"

SEND dock photosynth 24
SEND dock glycolyse 20
SEND dock charge 28
SEND dock feed 20
SEND dock photosynth 14
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock ldta 2
ASSERT LAST_N == 2 "dock ldta"
SEND dock photosynth 14
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock ldtb 2
ASSERT LAST_N == 2 "dock ldtb"
SEND dock photosynth 14
SEND dock glycolyse 12
SEND dock charge 16
SEND dock feed 12
SEND dock ldtc 2
ASSERT LAST_N == 2 "dock ldtc"
