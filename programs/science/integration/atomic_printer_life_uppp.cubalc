// atomic_printer_life_uppp.cubalc
// Atomic printer board: Cell.uppp UppP/BacA C55-PP phosphatase after MurJ.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY printer OF Cell 1 48 0
ENTITY ink OF Cell 1 32 0
ENTITY scrap OF Cell 0 16 0

SEND printer set_threshold 8
SEND ink set_threshold 8
SEND printer pulse 4
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer pump 24
SEND printer charge 40
SEND printer feed 36
SEND printer lpoa 4
ASSERT LAST_N == 4 "pr lpoa"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meps 4
ASSERT LAST_N == 4 "pr meps"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer meph 4
ASSERT LAST_N == 4 "pr meph"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer slt 4
ASSERT LAST_N == 4 "pr slt"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampg 4
ASSERT LAST_N == 4 "pr ampg"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer nagz 4
ASSERT LAST_N == 4 "pr nagz"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer ampd 4
ASSERT LAST_N == 4 "pr ampd"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer anmk 4
ASSERT LAST_N == 4 "pr anmk"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murq 4
ASSERT LAST_N == 4 "pr murq"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer mura 4
ASSERT LAST_N == 4 "pre printer mura"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murb 3
ASSERT LAST_N == 3 "pre printer murb"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murc 3
ASSERT LAST_N == 3 "pre printer murc"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer murd 3
ASSERT LAST_N == 3 "pre printer murd"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer mure 3
ASSERT LAST_N == 3 "pre printer mure"
SEND printer photosynth 40
SEND printer glycolyse 36
SEND printer charge 40
SEND printer feed 36
GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
GETF printer pcr
LET c0 = LAST_N
GETF printer reserve
LET r0 = LAST_N
GETF printer age
LET age0 = LAST_N
GETF printer pmf
LET pmf0 = LAST_N
GETF printer setpoint
LET sp0 = LAST_N
GETF printer threshold
LET thr0 = LAST_N
SEND printer mray 5
ASSERT LAST_N == 5 "pre printer mray"
SEND printer murg 5
ASSERT LAST_N == 5 "pr murg"
SEND printer murj 5
ASSERT LAST_N == 5 "pr murj"
SEND printer uppp 5
ASSERT LAST_N == 5 "pr uppp"
GETF printer heat
ASSERT LAST_N == h0 + 20 "pr h+5"
GETF printer energy
ASSERT LAST_N == e0 - 20 "pr e-5"
GETF printer atp
ASSERT LAST_N == a0 - 20 "pr atp-5"
GETF printer pcr
ASSERT LAST_N == c0 "pr pcr held"
GETF printer reserve
ASSERT LAST_N == r0 "pr reserve held"
GETF printer age
ASSERT LAST_N == age0 "pr age held"
GETF printer pmf
ASSERT LAST_N == pmf0 "pr pmf held"
GETF printer setpoint
ASSERT LAST_N == sp0 "pr sp held"
GETF printer threshold
ASSERT LAST_N == thr0 "pr thr held"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink anmk 3
ASSERT LAST_N == 3 "ink anmk"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink murq 3
ASSERT LAST_N == 3 "ink murq"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink mura 4
ASSERT LAST_N == 4 "pre ink mura"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink murb 3
ASSERT LAST_N == 3 "pre ink murb"
SEND ink photosynth 24
SEND ink glycolyse 20
SEND ink charge 28
SEND ink feed 20
SEND ink murc 3
ASSERT LAST_N == 3 "pre ink murc"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink murd 3
ASSERT LAST_N == 3 "pre ink murd"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink mure 3
ASSERT LAST_N == 3 "pre ink mure"
SEND ink photosynth 40
SEND ink glycolyse 36
SEND ink charge 40
SEND ink feed 36
SEND ink mray 3
ASSERT LAST_N == 3 "pre ink mray"
SEND ink murg 3
ASSERT LAST_N == 3 "ink murg"
SEND ink murj 3
ASSERT LAST_N == 3 "ink murj"
SEND ink photosynth 40
SEND ink glycolyse 36
SEND ink charge 40
SEND ink feed 36
GETF ink heat
LET ih = LAST_N
GETF ink energy
LET ie = LAST_N
GETF ink atp
LET ia = LAST_N
SEND ink uppp 3
ASSERT LAST_N == 3 "ink uppp"
GETF ink heat
ASSERT LAST_N == ih + 3 "ink h+uppp"
GETF ink energy
ASSERT LAST_N == ie - 3 "ink e-uppp"
GETF ink atp
ASSERT LAST_N == ia - 3 "ink atp-uppp"
SEND scrap murd 3
SEND scrap mure 3
SEND scrap mray 3
ASSERT LAST_N == 0 "pre scrap mray"
SEND scrap murg 3
ASSERT LAST_N == 0 "scrap murg0"
SEND scrap murj 3
ASSERT LAST_N == 0 "scrap murj0"
SEND scrap uppp 3
ASSERT LAST_N == 0 "scrap uppp0"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer murd 3
ASSERT LAST_N == 3 "pre printer murd"
SEND printer photosynth 20
SEND printer glycolyse 16
SEND printer charge 24
SEND printer feed 16
SEND printer mure 3
ASSERT LAST_N == 3 "pre printer mure"
SEND printer murg 0
SEND printer murj 0
ASSERT LAST_N == 0 "pr murj n0"
SEND printer uppp 0
ASSERT LAST_N == 0 "pr uppp n0"
SEND printer murg -2
SEND printer murj -2
ASSERT LAST_N == 0 "pr murj nneg"
SEND printer uppp -2
ASSERT LAST_N == 0 "pr uppp nneg"
GETF printer alive
ASSERT LAST_N == 1 "pr alive"
