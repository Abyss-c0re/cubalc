SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 28
SEND printer feed 20
SEND printer murj 4
ASSERT LAST_N == 4 "pre murj"
SEND printer photosynth 24
SEND printer glycolyse 20
SEND printer charge 30
SEND printer feed 20
SEND printer mtga 4
ASSERT LAST_N == 4 "pre mtga"

GETF printer heat
LET h0 = LAST_N
GETF printer energy
LET e0 = LAST_N
GETF printer atp
LET a0 = LAST_N
SEND printer uppp 4
ASSERT LAST_N == 4 "pr uppp"
GETF printer heat
ASSERT LAST_N == h0 + 4 "pr uppp h+4"
GETF printer energy
ASSERT LAST_N == e0 - 4 "pr uppp e-4"
GETF printer atp
ASSERT LAST_N == a0 - 4 "pr uppp atp-4"

SEND ink photosynth 28
SEND ink glycolyse 24
SEND ink charge 32
SEND ink feed 24
SEND ink mura 3
ASSERT LAST_N == 3 "ink mura"
SEND ink photosynth 20
SEND ink glycolyse 16
SEND ink charge 24
SEND ink feed 16
SEND ink murb 3
ASSERT LAST_N == 3 "ink murb"
