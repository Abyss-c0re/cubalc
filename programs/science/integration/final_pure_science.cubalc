# Demo final — Pure science evolved (math + phys + chem + bio + earth)
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=science | exam=final | ver=1.10 |"

# MATH
ASSERT GCD(100,35) == 5
ASSERT POW(2,5) == 32
ASSERT HYP(3,4) == 5
ASSERT FACT(5) == 120
ASSERT CLAMP(99, 0, 50) == 50

# PHYSICS
ASSERT FORCE(3,5) == 15
ASSERT KE(4,3) == 18
ASSERT WAVE_V(50, 4) == 200
ASSERT BOYLE_P2(2, 6, 3) == 4

# CHEMISTRY
ASSERT CELSIUS_K(100) == 373
ASSERT H2O_BP == 100

# BIOLOGY + EARTH cubechain life-world
CUBE organism ROLE life PROTON 1
CUBE cell ROLE unit PROTON 1
CUBE gene ROLE code PROTON 1
CUBE earth ROLE planet PROTON 1
NEST organism cell
NEST cell gene
NEST earth organism
FOLDBITS organism "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS cell     "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS gene     "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS earth    "1010101010101010101010101010101010101010101010101010101010101010"
PLUG earth organism
PLUG organism cell
PLUG cell gene
IMPULSE earth 1
FLOW 4
COMPILE gene
COMPILE cell
COMPILE organism
COMPILE earth
ASSERT COMPILED(earth) == 1
ASSERT NESTED(gene) == 1
ASSERT EARTH_R == 6371
ASSERT ATM_O2 == 21
ASSERT CUBES == 4

PRINT "FINAL_EVOLVE" CUBES COMPILED(earth) HYP(3,4) ORBIT_PERIOD(4)
