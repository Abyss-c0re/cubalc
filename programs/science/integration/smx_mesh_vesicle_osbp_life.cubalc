REQUIRE VERSION "1.15"
INCLUDE life_cell

# SMX MESH VESICLE LIFE MI2345: OSBP after STARD3 on ER-Golgi MCS sterol limb.
# Continuum ...->soat1->nceh1->abca1->abcg1->lcat->cetp->pltp->scarb1->npc1l1->npc2->npc1->stard3->osbp (OSBP after STARD3 LE START limb)
# Gift: OSBP counterexchanges sterol at ER-Golgi MCS after STARD3 under ASSERT after STARD3 ward.
# Domain: post-STARD3 ER-Golgi MCS sterol transfer ward on the dietary/biliary sterol limb.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY mesh OF Cell 1 55 0
ENTITY cargo OF Cell 1 36 0
ENTITY lysed OF Cell 0 12 0

SEND mesh set_threshold 9
SEND cargo set_threshold 11

