# Proof 122 — digit-4 stack duals: SPICK SROLL SNDROP
HOLD_FLASH 1
SCIENCE LOAD

# SPICK — dual of PICK n (n from stack)
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 2
SPICK
ASSERT LAST_N == 10
ASSERT SP == 4
POP a
ASSERT a == 10

# PICKS alias: depth 0 after pop leaves TOS
CLEARSTACK
PUSH 7
PUSH 8
PUSH 0
PICKS
ASSERT LAST_N == 8
ASSERT SP == 3

# SROLL — dual of ROLL n
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 2
SROLL
# top 3 rolled: 1 2 3 with n=2 → 2 3 1
POP a
POP b
POP c
ASSERT c == 2
ASSERT b == 3
ASSERT a == 1

# ROLLS n=1 ≡ SWAP
CLEARSTACK
PUSH 4
PUSH 5
PUSH 1
ROLLS
POP a
POP b
ASSERT b == 5
ASSERT a == 4

# SNDROP — dual of NDROP n
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 2
SNDROP
ASSERT SP == 2
ASSERT LAST_N == 2
POP a
POP b
ASSERT b == 1
ASSERT a == 2

# DROPS drop all
CLEARSTACK
PUSH 9
PUSH 8
PUSH 2
DROPS
ASSERT SP == 0
ASSERT OK == 1

# soft fails
CLEARSTACK
SPICK
ASSERT OK == 0
SROLL
ASSERT OK == 0
SNDROP
ASSERT OK == 0

# under-depth SPICK
CLEARSTACK
PUSH 1
PUSH 5
SPICK
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof122_spick_sroll" LAST_N SP
