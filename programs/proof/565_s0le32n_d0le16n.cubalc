# Proof 565 — digit-4 stack+dual field signed LE0 32/16: S0LE32N S0LE16N D0LE32N D0LE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0LE32N: 0 → 1
PUSH 0x0
S0LE32N 0
POP x
ASSERT x == 1

# positive → 0
CLEARSTACK
PUSH 0x5
SLE032N 0
POP x
ASSERT x == 0

# -1 → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SNONPOS32N 0
POP x
ASSERT x == 1

# INT_MIN → 1
CLEARSTACK
PUSH 0x80000000
SISNONPOS32N 0
POP x
ASSERT x == 1

# high preserve: low +3 → 0
CLEARSTACK
PUSH 0xAABBCCDD00000003
S0LE32N 0
POP x
ASSERT x == 0xAABBCCDD00000000

# high preserve: low -2 → 1
CLEARSTACK
PUSH 0x11223344FFFFFFFE
S0LE32N 0
POP x
ASSERT x == 0x1122334400000001

# STACK0LE32N n1: high positive → 0
CLEARSTACK
PUSH 0x0000000200000000
STACK0LE32N 1
POP x
ASSERT x == 0x0000000000000000

# high negative → 1
CLEARSTACK
PUSH 0xFFFFFFFE00000007
STACK0LE32N 1
POP x
ASSERT x == 0x0000000100000007

# high zero → 1
CLEARSTACK
PUSH 0x0000000000000007
STACK0LE32N 1
POP x
ASSERT x == 0x0000000100000007

# S0LE16N: 0 → 1
CLEARSTACK
PUSH 0x0
S0LE16N 0
POP x
ASSERT x == 1

# positive → 0
CLEARSTACK
PUSH 0x7
SLE016N 0
POP x
ASSERT x == 0

# -1=0xFFFF → 1
CLEARSTACK
PUSH 0xFFFF
SNONPOS16N 0
POP x
ASSERT x == 1

# INT16_MIN → 1
CLEARSTACK
PUSH 0x8000
SISNONPOS16N 0
POP x
ASSERT x == 1

# high halfword positive: n1 of 0x0005_0000 → high 0
CLEARSTACK
PUSH 0x00050000
STACK0LE16N 1
POP x
ASSERT x == 0x00000000

# high halfword zero → 1
CLEARSTACK
PUSH 0x00000007
STACK0LE16N 1
POP x
ASSERT x == 0x00010007

# high preserve: low positive
CLEARSTACK
PUSH 0x12340003
S0LE16N 0
POP x
ASSERT x == 0x12340000

# high preserve: low negative
CLEARSTACK
PUSH 0x1234FFFE
S0LE16N 0
POP x
ASSERT x == 0x12340001

# D0LE32N
CLEARSTACK
PUSH 0x5
PUSH 0xFFFFFFFE
D0LE32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0LE32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LE32N n1
CLEARSTACK
PUSH 0x0000000300000000
PUSH 0xFFFFFFFD00000000
STACK20LE32N 1
POP y
POP x
ASSERT x == 0x0000000000000000
ASSERT y == 0x0000000100000000

# D0LE16N
CLEARSTACK
PUSH 0x7
PUSH 0xFFFE
D0LE16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0LE16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LE16N n1
CLEARSTACK
PUSH 0x00030000
PUSH 0xFFFD0000
STACK20LE16N 1
POP y
POP x
ASSERT x == 0x00000000
ASSERT y == 0x00010000

HOLD_FLASH 0
