# Proof 338 — digit-4 zero-relative compare TOC: SLTZTOC SGTZTOC SLEZTOC SGEZTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SLTZTOC true (negative)
PUSH 1
PUSH (-3)
SSETCELL
POP
PUSH 1
SLTZTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# S0LTTOC false (positive)
CELLSET 2 5
PUSH 2
S0LTTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SGTZTOC true
CELLSET 3 7
PUSH 3
SGTZTOC
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# SGTZAT false (zero)
CELLSET 4 0
PUSH 4
SGTZAT
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SLEZTOC zero → 1
CELLSET 5 0
PUSH 5
SLEZTOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# S0LETOC positive → 0
CELLSET 6 2
PUSH 6
S0LETOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SGEZTOC zero → 1
CELLSET 7 0
PUSH 7
SGEZTOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# SGEZAT negative → 0
PUSH 8
PUSH (-1)
SSETCELL
POP
PUSH 8
SGEZAT
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# S0GEZTOC positive → 1
CELLSET 9 9
PUSH 9
S0GEZTOC
ASSERT LAST_N == 1
ASSERT CELL(9) == 1
POP

# soft fails
CLEARSTACK
SLTZTOC
ASSERT OK == 0
SGTZTOC
ASSERT OK == 0
SLEZTOC
ASSERT OK == 0
SGEZTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof338_sltz_sgez_toc" LAST_N SP
HOLD_FLASH 1
