# Proof 55 — digit-5 ALIGN/ALIGNDN SETBYTE + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# ALIGN / ROUNDUP
ASSERT ALIGN(0, 8) == 0
ASSERT ALIGN(1, 8) == 8
ASSERT ALIGN(8, 8) == 8
ASSERT ALIGN(9, 8) == 16
ASSERT ROUNDUP(10, 4) == 12
ASSERT ALIGN(7, 1) == 7
ASSERT ALIGN(5, 0) == 5

# ALIGNDN / ROUNDDN
ASSERT ALIGNDN(0, 8) == 0
ASSERT ALIGNDN(1, 8) == 0
ASSERT ALIGNDN(8, 8) == 8
ASSERT ALIGNDN(15, 8) == 8
ASSERT ROUNDDN(10, 4) == 8
ASSERT ALIGNDN(-7, 4) == -8
ASSERT ALIGN(-7, 4) == -4

# SETBYTE / SETB
ASSERT SETBYTE(0, 0xAB, 0) == 0xAB
ASSERT SETBYTE(0, 0xCD, 1) == 0xCD00
ASSERT SETB(0xFFFF, 0x00, 0) == 0xFF00
ASSERT BYTE(SETBYTE(0xAABBCCDD, 0x11, 2), 2) == 0x11

# stack SALIGN
CLEARSTACK
PUSH 10
PUSH 4
SALIGN
ASSERT LAST_N == 12
CLEARSTACK
PUSH 15
PUSH 8
SROUNDUP
ASSERT LAST_N == 16

# stack SALIGNDN
CLEARSTACK
PUSH 15
PUSH 8
SALIGNDN
ASSERT LAST_N == 8
CLEARSTACK
PUSH 10
PUSH 4
SROUNDDN
ASSERT LAST_N == 8

# stack SSETBYTE
CLEARSTACK
PUSH 0
PUSH 0xAB
PUSH 0
SSETBYTE
ASSERT LAST_N == 0xAB
CLEARSTACK
PUSH 0xFFFF
PUSH 0x12
PUSH 1
SSETBY
ASSERT LAST_N == 0x12FF

# compose
CLEARSTACK
PUSH 13
PUSH 8
SALIGN
PUSH 0xEE
PUSH 0
SSETBYTE
ASSERT LAST_N == 0xEE
ASSERT BYTE(LAST_N, 0) == 0xEE

# underflow
CLEARSTACK
SALIGN
ASSERT OK == 0
CLEARSTACK
SSETBYTE
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof55_align_setbyte" LAST_N SP
