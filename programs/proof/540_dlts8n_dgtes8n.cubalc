# Proof 540 — digit-3 dual-stack imm 8-bit signed ordered-cmp: DLTS8N DGTS8N DLTES8N DGTES8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLTS8N: -1 (0xFF) < 1 → 1 ; 1 < 1 → 0
PUSH 0xFF
PUSH 0x1
DLTS8N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# unsigned DLT: 0xFF < 0x1 → 0
CLEARSTACK
PUSH 0xFF
PUSH 0x1
DLT8N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# equal signed → 0 for LT
CLEARSTACK
PUSH 0x80
PUSH 0x80
PAIRLTS8N 0x80 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mixed: 2 < 3 → 1; 4 < 3 → 0
CLEARSTACK
PUSH 0x2
PUSH 0x4
DLTS8N 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 1 < -1 → 0 both
CLEARSTACK
PUSH 0x1
PUSH 0x2
S2LTS8N 0xFF 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved high bytes
CLEARSTACK
PUSH 0x99AAFF
PUSH 0x112200
DLTS8N 0x1 0
POP y
POP x
ASSERT x == 0x99AA01
ASSERT y == 0x112201

# STACK2LTS8N n1
CLEARSTACK
PUSH 0x0000FF00
PUSH 0x00000100
STACK2LTS8N 0x0 1
POP y
POP x
ASSERT x == 0x00000100
ASSERT y == 0x00000000

# DGTS8N: 1 > -1 → 1 ; -1 > -1 → 0
CLEARSTACK
PUSH 0x1
PUSH 0xFF
DGTS8N 0xFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 0xFF > 0x1 signed → 0 both
CLEARSTACK
PUSH 0xFF
PUSH 0xFE
PAIRGTS8N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# -128 > 127 → 0
CLEARSTACK
PUSH 0x80
PUSH 0x80
DGTS8N 0x7F 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DLTES8N equal → 1
CLEARSTACK
PUSH 0x80
PUSH 0x80
DLTES8N 0x80 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# -1 <= 0 → 1; 1 <= 0 → 0
CLEARSTACK
PUSH 0xFF
PUSH 0x1
DLEQS8N 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DGTES8N equal → 1
CLEARSTACK
PUSH 0x55
PUSH 0x55
DGTES8N 0x55 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 1 >= -1 → 1; -128 >= 127 → 0
CLEARSTACK
PUSH 0x1
PUSH 0x80
DGEQS8N 0xFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DCMPLTS8N / DCMPGES8N
CLEARSTACK
PUSH 0xFE
PUSH 0x0
DCMPLTS8N 0xFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFF
PUSH 0xFE
DCMPGES8N 0xFE 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# n2 dual signed
CLEARSTACK
PUSH 0x00FF0000
PUSH 0x00010000
DLTS8N 0x0 2
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

HOLD_FLASH 0
