# Proof 462 — digit-7 stack imm 4-bit field unary: SNOT4N SROL4N SROR4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SNOT4N n0: 0x...8 low nibble 8 → ~8 = 7
PUSH 0x1122334455667788
SNOT4N 0
POP x
ASSERT x == 0x1122334455667787

# STACKNOT4N n1: nibble1 of 0x...88 is 8 → ~8 = 7 → 0x...878
CLEARSTACK
PUSH 0x1122334455667788
STACKNOT4N 1
POP x
ASSERT x == 0x1122334455667778

# NOT4N alias n0 on 0 → F
CLEARSTACK
PUSH 0
NOT4N 0
POP x
ASSERT x == 15

# SROL4N k=1 n=0: 0x1 rotl1 → 0x2
CLEARSTACK
PUSH 0x1
SROL4N 1 0
POP x
ASSERT x == 2

# SROL4N: 0x8 rotl1 → 0x1; preserve high nibbles
CLEARSTACK
PUSH 0x1122334455667788
SROL4N 1 0
POP x
ASSERT x == 0x1122334455667781

# STACKROL4N n2: nibble2 of 0x...7788 is 7=0111 rotl2 → 1101=0xD
CLEARSTACK
PUSH 0x1122334455667788
STACKROL4N 2 2
POP x
ASSERT x == 0x1122334455667D88

# SROR4N k=1 n=0: 0x2 rotr1 → 0x1
CLEARSTACK
PUSH 0x2
SROR4N 1 0
POP x
ASSERT x == 1

# SROR4N: 0x1 rotr1 → 0x8
CLEARSTACK
PUSH 0x1
SROR4N 1 0
POP x
ASSERT x == 8

# round-trip ROL then ROR on nibble 0
CLEARSTACK
PUSH 0xA5
SROL4N 1 0
SROR4N 1 0
POP x
ASSERT x == 0xA5

# k masked: k=5 → k&3=1
CLEARSTACK
PUSH 0x1
SROL4N 5 0
POP x
ASSERT x == 2

# SINV4N alias
CLEARSTACK
PUSH 0x0
SINV4N 0
POP x
ASSERT x == 15

HOLD_FLASH 0
