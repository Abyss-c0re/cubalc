# Proof 32 — foundation digit-0: BEXT/BDEP BYTE LOBYTE HIBYTE DIVCEIL
HOLD_FLASH 1
SCIENCE LOAD

# BEXT(val, pos, width)
ASSERT BEXT(0xF0, 4, 4) == 15
ASSERT BEXT(0xAB, 0, 4) == 11
ASSERT BEXT(0xAB, 4, 4) == 10
ASSERT BEXT(0xFF, 0, 8) == 255
ASSERT BITEXT(0x100, 8, 1) == 1

# BDEP(base, field, pos) — 8-bit deposit
ASSERT BDEP(0, 0xAB, 0) == 0xAB
ASSERT BDEP(0, 0x12, 8) == 0x1200
ASSERT BDEP(0xFFFF, 0, 0) == 0xFF00
ASSERT LOBYTE(BDEP(0x1234, 0xEE, 0)) == 0xEE
ASSERT BEXT(BDEP(0, 0x3C, 4), 4, 8) == 0x3C

# BYTE / LOBYTE / HIBYTE
ASSERT LOBYTE(0x1234) == 0x34
ASSERT HIBYTE(0x1234) == 0x12
ASSERT BYTE(0xAABBCCDD, 0) == 0xDD
ASSERT BYTE(0xAABBCCDD, 1) == 0xCC
ASSERT BYTE(0xAABBCCDD, 2) == 0xBB
ASSERT BYTE(0xAABBCCDD, 3) == 0xAA

# DIVCEIL
ASSERT DIVCEIL(10, 3) == 4
ASSERT DIVCEIL(9, 3) == 3
ASSERT DIVCEIL(1, 1) == 1
ASSERT DIVCEIL(0, 5) == 0
ASSERT CEILDIV(7, 2) == 4
ASSERT DIVCEIL(100, 10) == 10
ASSERT DIVCEIL(5, 0) == 0

# compose with existing bit plane
ASSERT BAND(BEXT(0xFF, 0, 4), 0xF) == 15
ASSERT BOR(SHL(BEXT(0xAB, 4, 4), 4), BEXT(0xAB, 0, 4)) == 0xAB

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof32_bitfield" BEXT(0xF0,4,4) DIVCEIL(10,3) LOBYTE(0x1234)
