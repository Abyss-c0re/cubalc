# Proof 486 — digit-2 dual-stack imm 4-bit field shift: DSHL4N DSHR4N DSAR4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DSHL4N: 1<<2=4 both
PUSH 0x1
PUSH 0x1
DSHL4N 2 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# overflow: 0x8 << 1 → 0; preserve high
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF08
PAIRSHL4N 1 0
POP y
POP x
ASSERT x == 0x1122334455667780
ASSERT y == 0x99AABBCCDDEEFF00

# k>=4 → 0
CLEARSTACK
PUSH 0xF
PUSH 0xA
DSHL4N 4 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# S2SHL4N n1: nibble1 of 0x..31 is 3 <<1 → 6 → 0x..61
CLEARSTACK
PUSH 0x31
PUSH 0x21
S2SHL4N 1 1
POP y
POP x
ASSERT x == 0x61
ASSERT y == 0x41

# DSHR4N logical: 0x8>>1=4 ; 0xF>>2=3
CLEARSTACK
PUSH 0x8
PUSH 0xF
DSHR4N 1 0
POP y
POP x
ASSERT x == 4
ASSERT y == 7

# high preserved shr
CLEARSTACK
PUSH 0x112233445566778F
PUSH 0x99AABBCCDDEEFF0C
PAIRSHR4N 2 0
POP y
POP x
ASSERT x == 0x1122334455667783
ASSERT y == 0x99AABBCCDDEEFF03

# STACK2SHR4N n1: 0x..88 nibble1=8>>1=4 → 0x..48
CLEARSTACK
PUSH 0x88
PUSH 0xA0
STACK2SHR4N 1 1
POP y
POP x
ASSERT x == 0x48
ASSERT y == 0x50

# DSAR4N: 0xE (-2)>>1 → 0xF ; 0x8 (-8)>>1 → 0xC
CLEARSTACK
PUSH 0xE
PUSH 0x8
DSAR4N 1 0
POP y
POP x
ASSERT x == 15
ASSERT y == 12

# k>=4 all sign: neg → F, pos → 0
CLEARSTACK
PUSH 0x8
PUSH 0x6
PAIRSAR4N 4 0
POP y
POP x
ASSERT x == 15
ASSERT y == 0

# positive SAR: 0x6>>1=3 both
CLEARSTACK
PUSH 0x6
PUSH 0x4
DSAR4N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved SAR nibble2: 0x..6E88 n2=E→F; 0x..E8C88 n2=C→E
CLEARSTACK
PUSH 0x112233445566E88
PUSH 0x99AABBCCDDE8C88
S2SAR4N 1 2
POP y
POP x
ASSERT x == 0x112233445566F88
ASSERT y == 0x99AABBCCDDE8E88

# DLSH4N / DASHR4N aliases
CLEARSTACK
PUSH 0x3
PUSH 0x3
DLSH4N 1 0
POP y
POP x
ASSERT x == 6
ASSERT y == 6

CLEARSTACK
PUSH 0xE
PUSH 0xE
DASHR4N 1 0
POP y
POP x
ASSERT x == 15
ASSERT y == 15

HOLD_FLASH 0
