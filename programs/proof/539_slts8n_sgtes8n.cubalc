# Proof 539 — digit-4 stack imm 8-bit signed ordered-cmp: SLTS8N SGTS8N SLTES8N SGTES8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SLTS8N: int8(-1=0xFF) < int8(1) → 1
PUSH 0xFF
SLTS8N 0x1 0
POP x
ASSERT x == 1

# unsigned SLT would say 0xFF > 0x1
CLEARSTACK
PUSH 0xFF
SLT8N 0x1 0
POP x
ASSERT x == 0

# equal → 0 for LT
CLEARSTACK
PUSH 0x80
LTS8N 0x80 0
POP x
ASSERT x == 0

# positive less: 2 < 3 → 1
CLEARSTACK
PUSH 0x2
SLTS8N 0x3 0
POP x
ASSERT x == 1

# 1 < -1 → 0
CLEARSTACK
PUSH 0x1
SLTS8N 0xFF 0
POP x
ASSERT x == 0

# preserved high bytes
CLEARSTACK
PUSH 0x99AAFF
SLTS8N 0x1 0
POP x
ASSERT x == 0x99AA01

# STACKLTS8N n1: byte1 0xFF < 0 → 1
CLEARSTACK
PUSH 0x0000FF00
STACKLTS8N 0x0 1
POP x
ASSERT x == 0x00000100

# SGTS8N: 1 > -1 → 1
CLEARSTACK
PUSH 0x1
SGTS8N 0xFF 0
POP x
ASSERT x == 1

# 0xFF > 0x1 signed → 0
CLEARSTACK
PUSH 0xFF
GTS8N 0x1 0
POP x
ASSERT x == 0

# equal → 0
CLEARSTACK
PUSH 0x55
SGTS8N 0x55 0
POP x
ASSERT x == 0

# 0x80 (-128) > 0x7F (127) → 0
CLEARSTACK
PUSH 0x80
SGTS8N 0x7F 0
POP x
ASSERT x == 0

# preserved gt
CLEARSTACK
PUSH 0xAB01
SGTS8N 0xFF 0
POP x
ASSERT x == 0xAB01

# SLTES8N equal → 1
CLEARSTACK
PUSH 0x80
SLTES8N 0x80 0
POP x
ASSERT x == 1

# -1 <= 0 → 1
CLEARSTACK
PUSH 0xFF
LTES8N 0x0 0
POP x
ASSERT x == 1

# 1 <= -1 → 0
CLEARSTACK
PUSH 0x1
SLTES8N 0xFF 0
POP x
ASSERT x == 0

# SLEQS8N alias
CLEARSTACK
PUSH 0x2
SLEQS8N 0x3 0
POP x
ASSERT x == 1

# SGTES8N equal → 1
CLEARSTACK
PUSH 0x55
SGTES8N 0x55 0
POP x
ASSERT x == 1

# 1 >= -1 → 1
CLEARSTACK
PUSH 0x1
GTES8N 0xFF 0
POP x
ASSERT x == 1

# -128 >= 127 → 0
CLEARSTACK
PUSH 0x80
SGTES8N 0x7F 0
POP x
ASSERT x == 0

# SGEQS8N: -1 >= -2 (0xFE) → 1
CLEARSTACK
PUSH 0xFF
SGEQS8N 0xFE 0
POP x
ASSERT x == 1

# SCMPLTS8N / SCMPGES8N
CLEARSTACK
PUSH 0xFE
SCMPLTS8N 0xFF 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0xFF
SCMPGES8N 0xFE 0
POP x
ASSERT x == 1

# n2 signed
CLEARSTACK
PUSH 0x00FF0000
SLTS8N 0x0 2
POP x
ASSERT x == 0x00010000

HOLD_FLASH 0
