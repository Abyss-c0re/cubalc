# HASENVANY / NEEDENVANY — multi host-env any-of gate (HASENVALL twin)

HOLD_FLASH 1

SYS ENV UNSET CUBALC_HENVANY_A
SYS ENV UNSET CUBALC_HENVANY_B
SYS ENV UNSET CUBALC_HENVANY_C

# empty names soft → 0
HASENVANY
ASSERT LAST_N == 0
ASSERT HASENVANY_N == 0

# missing all
HASENVANY CUBALC_HENVANY_A CUBALC_HENVANY_B CUBALC_HENVANY_C
ASSERT LAST_N == 0
ASSERT ENVMISS_N == 3
SYS HASLINE ENVMISS "CUBALC_HENVANY_A"
ASSERT LAST_N == 1
SYS HASLINE ENVMISS "CUBALC_HENVANY_C"
ASSERT LAST_N == 1
ASSERT HASENVANY_N == 0
ASSERT NEEDENVANY_N == 3

# partial hit (any-of succeeds with one)
SYS ENV SET CUBALC_HENVANY_A "a"
HASENVANY CUBALC_HENVANY_A CUBALC_HENVANY_B
ASSERT LAST_N == 1
ASSERT HASENVANY_N == 1
SYS HASLINE ENVHAVE "CUBALC_HENVANY_A"
ASSERT LAST_N == 1
SYS HASLINE ENVMISS "CUBALC_HENVANY_B"
ASSERT LAST_N == 1
ASSERT OK == 1

# all present
SYS ENV SET CUBALC_HENVANY_A "a"
SYS ENV SET CUBALC_HENVANY_B "b"
SYS ENV SET CUBALC_HENVANY_C "c"
HASENVANY CUBALC_HENVANY_A CUBALC_HENVANY_B CUBALC_HENVANY_C
ASSERT LAST_N == 1
ASSERT HASENVANY_N == 3
ASSERT ENVMISS_N == 0
ASSERT OK == 1

# bag / CSV
HASENVANY "CUBALC_HENVANY_A,CUBALC_HENVANY_B"
ASSERT LAST_N == 1

# hard twin passes when any present
SYS ENV UNSET CUBALC_HENVANY_B
SYS ENV UNSET CUBALC_HENVANY_C
NEEDENVANY CUBALC_HENVANY_A CUBALC_HENVANY_B
ASSERT LAST_N == 1
ASSERT OK == 1

# soft miss sticky ERR
SYS ENV UNSET CUBALC_HENVANY_A
HASENVANY CUBALC_HENVANY_A CUBALC_HENVANY_B
ASSERT LAST_N == 0
ASSERT OK == 0
SYS HASI "HASENVANY miss"
ASSERT LAST_N == 1

# IF without N× SYS HASENV
SYS ENV SET CUBALC_HENVANY_B "x"
HASENVANY CUBALC_HENVANY_A CUBALC_HENVANY_B
IF LAST_N == 1
  LET gate "ok"
ELSE
  LET gate "no"
END
SYS EQS gate "ok"
ASSERT LAST_N == 1

# discoverable
HASFORM HASENVANY
ASSERT LAST_N == 1
HASFORM NEEDENVANY
ASSERT LAST_N == 1

SYS ENV UNSET CUBALC_HENVANY_A
SYS ENV UNSET CUBALC_HENVANY_B
SYS ENV UNSET CUBALC_HENVANY_C

PRINT "hasenvany ok"
PASS
