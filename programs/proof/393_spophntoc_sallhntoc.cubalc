# Proof 393 — digit-4 stack dual high-n metric TOC: SPOPHNTOC SANYHNTOC SALLHNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOPHNTOC: high-4 all set → popcount 4
CELLSET 1 0
PUSH 1
SHMASKTOCN 4
POP
PUSH 1
PUSH 4
SPOPHNTOC
ASSERT LAST_N == 4
ASSERT CELL(1) == 4
POP a
ASSERT a == 4

# POPHNTOC n=0 → 0
CELLSET 2 255
PUSH 2
PUSH 0
POPHNTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SANYHNTOC: high-1 of 0 → 0; of MSB → 1
CELLSET 3 0
PUSH 3
PUSH 1
SANYHNTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP
CELLSET 4 0
PUSH 4
SHMASKTOCN 1
POP
PUSH 4
PUSH 1
ANYHNTOC
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# SALLHNTOC: high-4 full → 1; high-1 only not all-4 → 0
CELLSET 5 0
PUSH 5
SHMASKTOCN 4
POP
PUSH 5
PUSH 4
SALLHNTOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP
CELLSET 6 0
PUSH 6
SHMASKTOCN 1
POP
PUSH 6
PUSH 4
ALLHNTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# n=0 vacuous all → 1
CELLSET 7 0
PUSH 7
PUSH 0
SALLHNTOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# soft short stack OK=0
CLEARSTACK
SPOPHNTOC
ASSERT OK == 0
PUSH 1
SANYHNTOC
ASSERT OK == 0

PRINT "393_spophntoc_sallhntoc OK"
