# Proof 502 — digit-1 dual-stack imm 16-bit field unary+rotate: DNOT16N DROL16N DROR16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DNOT16N n0: 0x0000 → 0xFFFF ; 0x00FF → 0xFF00
PUSH 0x0000
PUSH 0x00FF
DNOT16N 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 65280

# high preserved not
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEE0000
PAIRNOT16N 0
POP y
POP x
ASSERT x == 0x1122334455668877
ASSERT y == 0x99AABBCCDDEEFFFF

# S2NOT16N n1: half1 of 0xAAAA0001 is AAAA → ~AAAA=5555 → 0x55550001
CLEARSTACK
PUSH 0xAAAA0001
PUSH 0x55550000
S2NOT16N 1
POP y
POP x
ASSERT x == 0x55550001
ASSERT y == 0xAAAA0000

# DINV16N alias: 0xFFFF → 0
CLEARSTACK
PUSH 0xFFFF
PUSH 0x8000
DINV16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 32767

# DROL16N k=1 n0: 0x8001 → 0x0003 ; 0x0001 → 0x0002
CLEARSTACK
PUSH 0x8001
PUSH 0x0001
DROL16N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved rol
CLEARSTACK
PUSH 0x112233448001
PUSH 0x99AABBCC8000
PAIRROL16N 1 0
POP y
POP x
ASSERT x == 0x112233440003
ASSERT y == 0x99AABBCC0001

# S2ROL16N n1: half1 of 0x00010002 is 0001 rotl1 → 0002 → 0x00020002
CLEARSTACK
PUSH 0x00010002
PUSH 0x80010000
S2ROL16N 1 1
POP y
POP x
ASSERT x == 0x00020002
ASSERT y == 0x00030000

# DROR16N k=1 n0: 0x0002 → 0x0001 ; 0x0001 → 0x8000
CLEARSTACK
PUSH 0x0002
PUSH 0x0001
DROR16N 1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 32768

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA55A
PUSH 0x3CC3
DROL16N 5 0
DROR16N 5 0
POP y
POP x
ASSERT x == 0xA55A
ASSERT y == 0x3CC3

# k masked: k=17 → k&15=1
CLEARSTACK
PUSH 0x0001
PUSH 0x8000
PAIRROR16N 17 0
POP y
POP x
ASSERT x == 32768
ASSERT y == 16384

# STACK2ROR16N n1: half1 of 0x00020000 is 0002 → rotr1 → 0001 → 0x00010000
CLEARSTACK
PUSH 0x00020000
PUSH 0x00040000
STACK2ROR16N 1 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00020000

# DROTL16N alias
CLEARSTACK
PUSH 0x1000
PUSH 0x1000
DROTL16N 1 0
POP y
POP x
ASSERT x == 0x2000
ASSERT y == 0x2000

HOLD_FLASH 0
