# Proof 290 — digit-0 stack imm overflow preds: SADDOVFN SSUBOVFN SMULOVFN
HOLD_FLASH 1
SCIENCE LOAD

# SADDOVFN n — no overflow
CLEARSTACK
PUSH 10
SADDOVFN 20
POP x
ASSERT x == 0

CLEARSTACK
PUSH -5
ADDOVFN -3
POP x
ASSERT x == 0

# SADDOVFN — overflow toward +inf
CLEARSTACK
PUSH 9223372036854775807
SADDOVFN 1
POP x
ASSERT x == 1

CLEARSTACK
PUSH 9223372036854775800
STACKADDOVFN 10
POP x
ASSERT x == 1

# SADDOVFN — overflow toward -inf
CLEARSTACK
PUSH -9223372036854775807
SADDOVFN -2
POP x
ASSERT x == 1

# SSUBOVFN n
CLEARSTACK
PUSH 10
SSUBOVFN 3
POP x
ASSERT x == 0

CLEARSTACK
PUSH -9223372036854775807
SUBOVFN 2
POP x
ASSERT x == 1

CLEARSTACK
PUSH 9223372036854775807
SSUBOVFN -1
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0
SSUBOVFIMM 0
POP x
ASSERT x == 0

# SMULOVFN n
CLEARSTACK
PUSH 6
SMULOVFN 7
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0
MULOVFN 999
POP x
ASSERT x == 0

CLEARSTACK
PUSH 3037000500
SMULOVFN 3037000500
POP x
ASSERT x == 1

CLEARSTACK
PUSH -3037000500
STACKMULOVFN 3037000500
POP x
ASSERT x == 1

CLEARSTACK
PUSH 9223372036854775807
SMULOVFN 2
POP x
ASSERT x == 1

# soft fails
CLEARSTACK
SADDOVFN 1
ASSERT OK == 0
CLEARSTACK
SSUBOVFN 1
ASSERT OK == 0
CLEARSTACK
SMULOVFN 1
ASSERT OK == 0

HOLD_FLASH 1
