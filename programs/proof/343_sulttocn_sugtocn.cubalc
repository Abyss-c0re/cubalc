# Proof 343 — digit-8 unsigned imm compare TOC: SULTTOCN SUGTTOCN SULETOCN SUGETOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SULTTOCN true
CELLSET 1 1
PUSH 1
SULTTOCN 5
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# ULTTOCN false
CELLSET 2 9
PUSH 2
ULTTOCN 2
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SUGTTOCN: -1 as u-max > 0
PUSH 3
PUSH (-1)
SSETCELL
POP
PUSH 3
SUGTTOCN 0
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# SUGTATN: 0 > u-max false
CELLSET 4 0
PUSH 4
SUGTATN (-1)
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SULETOCN equal
CELLSET 5 7
PUSH 5
SULETOCN 7
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# ULETOCN false
CELLSET 6 10
PUSH 6
ULETOCN 3
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SUGETOCN true
CELLSET 7 9
PUSH 7
SUGETOCN 2
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# UGETOCN: u-max >= 0
PUSH 8
PUSH (-1)
SSETCELL
POP
PUSH 8
UGETOCN 0
ASSERT LAST_N == 1
ASSERT CELL(8) == 1
POP

# contrast: signed SGETOCN on -1 vs 0 is false; unsigned SUGETOCN true
PUSH 9
PUSH (-1)
SSETCELL
POP
PUSH 9
SGETOCN 0
ASSERT LAST_N == 0
POP
PUSH 9
PUSH (-1)
SSETCELL
POP
PUSH 9
SUGETOCN 0
ASSERT LAST_N == 1
POP

# soft fails
CLEARSTACK
SULTTOCN 1
ASSERT OK == 0
SUGTTOCN 1
ASSERT OK == 0
SULETOCN 1
ASSERT OK == 0
SUGETOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof343_sulttocn_sugtocn" LAST_N SP
HOLD_FLASH 1
