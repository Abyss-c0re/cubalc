# Proof 377 — digit-7 stack bitfield TOC: SSETBTOC SCLRBTOC SFLPBTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSETBTOC: set bit 3 on 0 → 8
CELLSET 1 0
PUSH 1
PUSH 3
SSETBTOC
ASSERT LAST_N == 8
ASSERT CELL(1) == 8
POP a
ASSERT a == 8

# SETBTOC alias: 8 | (1<<0) = 9
CELLSET 2 8
PUSH 2
PUSH 0
SETBTOC
ASSERT LAST_N == 9
ASSERT CELL(2) == 9
POP

# SCLRBTOC: clear bit 3 from 15 → 7
CELLSET 3 15
PUSH 3
PUSH 3
SCLRBTOC
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# CLRBTOC missing bit: 1 clear bit 1 → 1
CELLSET 4 1
PUSH 4
PUSH 1
CLRBTOC
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# SFLPBTOC flip bit 1: 0→2→0
CELLSET 5 0
PUSH 5
PUSH 1
SFLPBTOC
ASSERT LAST_N == 2
ASSERT CELL(5) == 2
POP
PUSH 5
PUSH 1
SFLPBTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# FLPBTOC: 5 flip bit 0 → 4
CELLSET 6 5
PUSH 6
PUSH 0
FLPBTOC
ASSERT LAST_N == 4
ASSERT CELL(6) == 4
POP

# soft underfull OK=0
CLEARSTACK
PUSH 1
SSETBTOC
ASSERT OK == 0

PRINT "377_ssetbtoc_sflpbtoc OK"
