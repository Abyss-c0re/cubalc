# Proof 325 — digit-0 stack↔cell shift: SSHLTOC SSHRTOC SSARTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSHLTOC: 3 << 2 = 12
CELLSET 1 3
PUSH 1
PUSH 2
SSHLTOC
ASSERT LAST_N == 12
ASSERT CELL(1) == 12
POP a
ASSERT a == 12

# SHLTOC alias: 1 << 4 = 16
CELLSET 2 1
PUSH 2
PUSH 4
SHLTOC
ASSERT LAST_N == 16
ASSERT CELL(2) == 16
POP

# SSHRTOC logical: 0xF0 >> 4 = 0x0F = 15
CELLSET 3 240
PUSH 3
PUSH 4
SSHRTOC
ASSERT LAST_N == 15
ASSERT CELL(3) == 15
POP

# SCELLSHR alias
CELLSET 4 32
PUSH 4
PUSH 3
SCELLSHR
ASSERT LAST_N == 4
ASSERT CELL(4) == 4
POP

# SSARTOC arithmetic: -8 >> 2 = -2
PUSH 5
PUSH 8
NEGATE
SSETCELL
POP
ASSERT CELL(5) == -8
PUSH 5
PUSH 2
SSARTOC
ASSERT LAST_N == -2
ASSERT CELL(5) == -2
POP a
ASSERT a == -2

# SASHRTOC alias: -16 >> 3 = -2
PUSH 6
PUSH 16
NEGATE
SSETCELL
POP
ASSERT CELL(6) == -16
PUSH 6
PUSH 3
SASHRTOC
ASSERT LAST_N == -2
ASSERT CELL(6) == -2
POP

# n clamp: shift 0 leaves value
CELLSET 7 5
PUSH 7
PUSH 0
SSHLTOC
ASSERT LAST_N == 5
ASSERT CELL(7) == 5
POP

# soft fails
CLEARSTACK
SSHLTOC
ASSERT OK == 0
SSHRTOC
ASSERT OK == 0
SSARTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof325_sshltoc_ssartoc" LAST_N SP
HOLD_FLASH 1
