# Proof 530 — digit-4 stack imm 8-bit field ordered-cmp: SLT8N SGT8N SLTE8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SLT8N: 0x10 < 0xC0 → 1
PUSH 0x10
SLT8N 0xC0 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0xC0
LT8N 0xC0 0
POP x
ASSERT x == 0

# greater → 0
CLEARSTACK
PUSH 0xF0
SLT8N 0x20 0
POP x
ASSERT x == 0

# other bytes preserved
CLEARSTACK
PUSH 0xAABBCC10
SLT8N 0x20 0
POP x
ASSERT x == 0xAABBCC01

# STACKLT8N n1
CLEARSTACK
PUSH 0x00001000
STACKLT8N 0x20 1
POP x
ASSERT x == 0x00000100

# n2
CLEARSTACK
PUSH 0x00100000
SLT8N 0x20 2
POP x
ASSERT x == 0x00010000

# n3
CLEARSTACK
PUSH 0x10000000
SLT8N 0x20 3
POP x
ASSERT x == 0x01000000

# SGT8N: 0xF0 > 0x20 → 1
CLEARSTACK
PUSH 0xF0
SGT8N 0x20 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0x55
GT8N 0x55 0
POP x
ASSERT x == 0

# less → 0
CLEARSTACK
PUSH 0x10
SGT8N 0x20 0
POP x
ASSERT x == 0

# preserved gt
CLEARSTACK
PUSH 0x99AA0080
SGT8N 0x10 0
POP x
ASSERT x == 0x99AA0001

# STACKGT8N n1
CLEARSTACK
PUSH 0x00009000
STACKGT8N 0x10 1
POP x
ASSERT x == 0x00000100

# SLTE8N less → 1
CLEARSTACK
PUSH 0x10
SLTE8N 0xC0 0
POP x
ASSERT x == 1

# equal → 1
CLEARSTACK
PUSH 0xAB
LTE8N 0xAB 0
POP x
ASSERT x == 1

# greater → 0
CLEARSTACK
PUSH 0xFF
SLEQ8N 0xFE 0
POP x
ASSERT x == 0

# preserved lte
CLEARSTACK
PUSH 0x11227742
SLTE8N 0x42 0
POP x
ASSERT x == 0x11227701

# STACKLTE8N n1: 0x55 <= 0x54 → 0
CLEARSTACK
PUSH 0x00005500
STACKLTE8N 0x54 1
POP x
ASSERT x == 0x00000000

# aliases
CLEARSTACK
PUSH 1
SCMPLT8N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 3
SCMPGT8N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 2
SCMPLE8N 2 0
POP x
ASSERT x == 1

# unsigned: 0x80 > 0x7F → 1
CLEARSTACK
PUSH 0x80
SGT8N 0x7F 0
POP x
ASSERT x == 1

HOLD_FLASH 0
