# Proof 551 — digit-5 stack+dual imm 8-bit signed clamp+between: SCLAMPS8N SBETWEENS8N DCLAMPS8N DBETWEENS8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLAMPS8N: clamp -5=0xFB into [-1, 3] → -1
PUSH 0xFB
SCLAMPS8N 0xFF 0x3 0
POP x
ASSERT x == 0xFF

# clamp 10 into [-1, 3] → 3
CLEARSTACK
PUSH 0xA
CLAMPS8N 0xFF 0x3 0
POP x
ASSERT x == 3

# in range stays
CLEARSTACK
PUSH 0x1
SCLAMPSIGN8N 0xFF 0x3 0
POP x
ASSERT x == 1

# swap lo/hi
CLEARSTACK
PUSH 0x0
SCLAMPS8N 0x3 0xFF 0
POP x
ASSERT x == 0

# INT8_MIN clamp to [0, 10] → 0
CLEARSTACK
PUSH 0x80
SCLAMPS8N 0x0 0xA 0
POP x
ASSERT x == 0

# high byte preserved: low FF clamp [0,5] → 0 low
CLEARSTACK
PUSH 0x11FF
SCLAMPS8N 0x0 0x5 0
POP x
ASSERT x == 0x1100

# STACKCLAMPS8N n1: high FE (-2) clamp [-1,1] → FF
CLEARSTACK
PUSH 0xFE00
STACKCLAMPS8N 0xFF 0x1 1
POP x
ASSERT x == 0xFF00

# SBETWEENS8N: -1 in [-2, 0] → 1
CLEARSTACK
PUSH 0xFF
SBETWEENS8N 0xFE 0x0 0
POP x
ASSERT x == 1

# 5 not in [-1, 3]
CLEARSTACK
PUSH 0x5
BETWEENS8N 0xFF 0x3 0
POP x
ASSERT x == 0

# INT8_MIN not in [0, 10]
CLEARSTACK
PUSH 0x80
SINRANGES8N 0x0 0xA 0
POP x
ASSERT x == 0

# 0xFF signed -1 in [-5, 5]
CLEARSTACK
PUSH 0xFF
SBETWEENS8N 0xFB 0x5 0
POP x
ASSERT x == 1

# high preserved between
CLEARSTACK
PUSH 0xAA02
SBETWEENS8N 0x0 0x3 0
POP x
ASSERT x == 0xAA01

# STACKBETWEENS8N n1
CLEARSTACK
PUSH 0xFF00
STACKBETWEENS8N 0xFE 0x0 1
POP x
ASSERT x == 0x0100

# DCLAMPS8N
CLEARSTACK
PUSH 0xFB
PUSH 0xA
DCLAMPS8N 0xFF 0x3 0
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 3

# both in range
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRCLAMPS8N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# high preserve dual
CLEARSTACK
PUSH 0x11FF
PUSH 0x220A
S2CLAMPS8N 0x0 0x5 0
POP y
POP x
ASSERT x == 0x1100
ASSERT y == 0x2205

# STACK2CLAMPS8N n1
CLEARSTACK
PUSH 0xFE00
PUSH 0x0A00
STACK2CLAMPS8N 0xFF 0x1 1
POP y
POP x
ASSERT x == 0xFF00
ASSERT y == 0x0100

# DBETWEENS8N
CLEARSTACK
PUSH 0xFF
PUSH 0x5
DBETWEENS8N 0xFE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# both in
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRBETWEENS8N 0x0 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DINRANGESIGN8N
CLEARSTACK
PUSH 0x80
PUSH 0xFF
DINRANGESIGN8N 0xFE 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK2BETWEENS8N n1
CLEARSTACK
PUSH 0xFF00
PUSH 0x0500
STACK2BETWEENS8N 0xFE 0x0 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

HOLD_FLASH 0
