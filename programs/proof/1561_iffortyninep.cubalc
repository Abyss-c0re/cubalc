# IFFORTYNINEP - plate exactly-forty-nine key diagnostic branch
# Continues ladder after IFFORTYEIGHTP. Soft twin ENNEATETRACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET fortyeight = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48}"
LET fortynine = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49}"
LET fifty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50}"
LET empty = "{}"

IFFORTYNINEP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFORTYNINEP_N == 1
ASSERT FORTYNINEP_N == 1
ASSERT IFFORTYNINEP_LEN == 49
ASSERT IFENNEATETRACONTAP_N == 1
ASSERT IFFORTYNINEKEYP_N == 1

IFENNEATETRACONTAP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYNINEKEYP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYNINEP fortyeight
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYNINEP_N == 0
ASSERT IFFORTYNINEP_LEN == 48

IFFORTYNINEP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYNINEP_LEN == 50

IFFORTYNINEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFORTYNINEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFORTYNINEP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENENNEATETRACONTAP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFORTYNINEKEYP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffortyninep_ok" IFFORTYNINEP_N IFFORTYNINEP_LEN
