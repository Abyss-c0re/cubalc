# Proof 85 — digit-6 RNG: RANDRANGE/SHUFFLECELL/PICKCELL/RANDBITS/ENERGYGET
HOLD_FLASH 1
SCIENCE LOAD

# deterministic seed
SEED 42
GETSEED
ASSERT LAST_N == 42

# RANDRANGE inclusive
RANDRANGE 5 5
ASSERT LAST_N == 5
SEED 99
RANDRANGE 0 9
ASSERT LAST_N >= 0
ASSERT LAST_N <= 9

# SRANDRANGE on stack
SEED 7
PUSH 10
PUSH 20
SRANDRANGE
POP
ASSERT LAST_N >= 10
ASSERT LAST_N <= 20

# SHUFFLECELL preserves multiset
CLEARCELLS
IOTA 0 4 1 1
# 1 2 3 4 5
SUMCELL 0 4
ASSERT LAST_N == 15
SEED 12345
SHUFFLECELL 0 4
SUMCELL 0 4
ASSERT LAST_N == 15
# still permutation of 1..5
MINCELL 0 4
ASSERT LAST_N == 1
MAXCELL 0 4
ASSERT LAST_N == 5
PRODCELL 0 4
ASSERT LAST_N == 120

# PICKCELL
SEED 1
IOTA 0 3 10 10
# 10 20 30 40
PICKCELL 0 3
ASSERT LAST_N == 10 OR LAST_N == 20 OR LAST_N == 30 OR LAST_N == 40
ASSERT IT >= 0
ASSERT IT <= 3

# RANDBITS density extremes
CUBE m ROLE matrix PROTON 1
SEED 55
RANDBITS m 0
ONES m
ASSERT LAST_N == 0
RANDBITS m 100
ONES m
ASSERT LAST_N == 64
SEED 77
RANDBITS m 50
ONES m
ASSERT LAST_N >= 0
ASSERT LAST_N <= 64

# ENERGYGET
CUBE e ROLE matrix PROTON 1
ENERGYSET e 42
ENERGYGET e
ASSERT LAST_N == 42
ENERGYGET nosuch
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof85_rand_shuffle" LAST_N
