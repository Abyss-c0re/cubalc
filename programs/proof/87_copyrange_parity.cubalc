# Proof 87 — digit-7 COP: PARITYBITS + COPYRANGE + SWAPRANGE
HOLD_FLASH 1
SCIENCE LOAD

CUBE m ROLE matrix PROTON 1
CLEARBITS m
PARITYBITS m
ASSERT LAST_N == 0
SETBIT m 0 1
PARITYBITS m
ASSERT LAST_N == 1
SETBIT m 1 1
PARITYBITS m
ASSERT LAST_N == 0
SETBIT m 3 1
PARITYBITS m
ASSERT LAST_N == 1
ONES m
ASSERT LAST_N == 3

# COPYRANGE: copy a[0..3] to b[4..7]
CUBE a ROLE matrix PROTON 1
CUBE b ROLE matrix PROTON 1
CLEARBITS a
CLEARBITS b
SETBIT a 0 1
SETBIT a 1 1
SETBIT a 2 0
SETBIT a 3 1
COPYRANGE b 4 a 0 4
GETBIT b 4
ASSERT LAST_N == 1
GETBIT b 5
ASSERT LAST_N == 1
GETBIT b 6
ASSERT LAST_N == 0
GETBIT b 7
ASSERT LAST_N == 1
GETBIT b 0
ASSERT LAST_N == 0
# LAST_N after copy = count copied
COPYRANGE b 0 a 0 4
ASSERT LAST_N == 4

# SWAPRANGE reverse [0..3]: 1,1,0,1 → 1,0,1,1
CLEARBITS m
SETBIT m 0 1
SETBIT m 1 1
SETBIT m 2 0
SETBIT m 3 1
SWAPRANGE m 0 3
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 0
GETBIT m 2
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 1
# reverse again restores
REVRANGE m 0 3
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 0
GETBIT m 3
ASSERT LAST_N == 1

# soft fail
PARITYBITS nosuch
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof87_copyrange_parity" LAST_N
