# EACH OBJ — walk live OOP objects (optional class filter)
# Usability: no LISTOBJS + EACH LINE glue for per-object GETF/SEND

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 3 0
NEW Cell b 1 5 0
NEW Cell c 1 7 0

# sum energy over all Cell objects
LET sum = 0
LET n = 0
EACH OBJ Cell AS o
  GETF o energy
  LET sum = sum + LAST_N
  LET n = n + 1
END
ASSERT EACH_N == 3
ASSERT n == 3
ASSERT sum == 15 "3+5+7"

# default bind name OBJ
LET hit = 0
EACH OBJ Cell
  HASOBJ OBJ
  IF LAST_N == 1 THEN
    LET hit = hit + 1
  END
END
ASSERT hit == 3

# all objects (no class filter) — still 3 Cells only
LET alln = 0
EACH OBJ AS x
  LET alln = alln + 1
END
ASSERT alln == 3
ASSERT EACH_N == 3

# mixed classes
CLASS Marker
  FIELD tag 0
  METHOD init t
    SETF THIS tag t
  END
END
NEW Marker m1 9

LET cells = 0
LET marks = 0
EACH OBJ Cell AS o
  LET cells = cells + 1
END
ASSERT cells == 3
EACH OBJ Marker AS o
  GETF o tag
  ASSERT LAST_N == 9
  LET marks = marks + 1
END
ASSERT marks == 1
ASSERT EACH_N == 1

# OF sugar
LET k = 0
EACH OBJ AS z OF Cell
  LET k = k + 1
END
ASSERT k == 3

# FOREACH alias
LET f = 0
FOREACH OBJ Cell AS o
  LET f = f + 1
END
ASSERT f == 3

# empty class filter
LET zed = 0
EACH OBJ NoSuchClassZz AS o
  LET zed = zed + 1
END
ASSERT zed == 0
ASSERT EACH_N == 0

PRINT "oop_each_obj ok"
