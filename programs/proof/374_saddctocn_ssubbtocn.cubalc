# Proof 374 — digit-4 multiword carry/borrow imm TOC: SADDCTOCN SSUBBTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SADDCTOCN no carry: 10+7 = 17, CARRY=0
LET CARRY = 0
CELLSET 1 10
PUSH 1
SADDCTOCN 7
ASSERT LAST_N == 17
ASSERT CELL(1) == 17
ASSERT CARRY == 0
POP a
ASSERT a == 17

# SADDCTOCN with cin: 5+3+1 = 9
LET CARRY = 1
CELLSET 2 5
PUSH 2
ADDCTOCN 3
ASSERT LAST_N == 9
ASSERT CELL(2) == 9
ASSERT CARRY == 0
POP

# SADDCTOCN overflow: all1 + 1 → 0, CARRY=1
LET CARRY = 0
LET all1 = 0 - 1
CELLSET 3 all1
PUSH 3
SADDCTOCN 1
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
ASSERT CARRY == 1
POP

# SSUBBTOCN no borrow: 10-3 = 7
LET BORROW = 0
LET CARRY = 0
CELLSET 4 10
PUSH 4
SSUBBTOCN 3
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
ASSERT BORROW == 0
POP

# SSUBBTOCN with bin: 10-3-1 = 6
LET BORROW = 1
CELLSET 5 10
PUSH 5
SUBBTOCN 3
ASSERT LAST_N == 6
ASSERT CELL(5) == 6
ASSERT BORROW == 0
POP

# SSUBBTOCN underflow: 0-1 → all1, BORROW=1
LET BORROW = 0
LET CARRY = 0
CELLSET 6 0
PUSH 6
SSUBBTOCN 1
ASSERT LAST_N == all1
ASSERT CELL(6) == all1
ASSERT BORROW == 1
POP

# soft empty OK=0
CLEARSTACK
SADDCTOCN 1
ASSERT OK == 0

PRINT "374_saddctocn_ssubbtocn OK"
