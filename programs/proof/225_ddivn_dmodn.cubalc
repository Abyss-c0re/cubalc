# Proof 225 — digit-7 dual-stack immediate div/mod: DDIVN DMODN
HOLD_FLASH 1
SCIENCE LOAD

# DDIVN
CLEARSTACK
PUSH 20
PUSH 15
DDIVN 5
POP y
POP x
ASSERT x == 4
ASSERT y == 3

CLEARSTACK
PUSH 100
PUSH -10
2DIVN 10
POP y
POP x
ASSERT x == 10
ASSERT y == -1

# PAIRDIVN / DDIVIMM / n=1 identity
CLEARSTACK
PUSH 7
PUSH 9
PAIRDIVN 1
POP y
POP x
ASSERT x == 7
ASSERT y == 9

CLEARSTACK
PUSH 8
PUSH 6
DDIVIMM 2
POP y
POP x
ASSERT x == 4
ASSERT y == 3

# DQUOTN alias / soft div0
CLEARSTACK
PUSH 11
PUSH 22
DQUOTN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DMODN
CLEARSTACK
PUSH 17
PUSH 23
DMODN 5
POP y
POP x
ASSERT x == 2
ASSERT y == 3

CLEARSTACK
PUSH 100
PUSH 50
2MODN 7
POP y
POP x
ASSERT x == 2
ASSERT y == 1

# PAIRMODN / DMODIMM / n=1 rem0
CLEARSTACK
PUSH 42
PUSH 99
PAIRMODN 1
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 13
PUSH 8
DMODIMM 4
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DREMN alias / soft mod0
CLEARSTACK
PUSH 5
PUSH 9
DREMN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# chain MUL then DIV then MOD
CLEARSTACK
PUSH 3
PUSH 4
DMULN 10
DDIVN 5
DMODN 3
POP y
POP x
ASSERT x == 0
ASSERT y == 2

# negative remainder (C signed %)
CLEARSTACK
PUSH -17
PUSH -7
DDIVN 5
POP y
POP x
ASSERT x == -3
ASSERT y == -1

CLEARSTACK
PUSH -17
PUSH 17
DMODN 5
POP y
POP x
ASSERT x == -2
ASSERT y == 2
