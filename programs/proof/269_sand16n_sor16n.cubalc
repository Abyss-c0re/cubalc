# Proof 269 — digit-0 stack imm 16-bit field bitwise: SAND16N SOR16N SXOR16N
HOLD_FLASH 1
SCIENCE LOAD

# SAND16N field n
CLEARSTACK
PUSH 0x1122334455667788
SAND16N 0x00FF 0
POP x
ASSERT x == 0x1122334455660088

CLEARSTACK
PUSH 0x1122334455667788
STACKAND16N 0x00FF 1
POP x
ASSERT x == 0x1122334400667788

CLEARSTACK
PUSH -1
AND16N 0xABCD 0
POP x
ASSERT x == -21555

# SOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
SOR16N 0xF000 0
POP x
ASSERT x == 0x112233445566F788

CLEARSTACK
PUSH 0x1122334455667788
STACKOR16N 0xF000 2
POP x
ASSERT x == 0x1122F34455667788

CLEARSTACK
PUSH 0
OR16N 0xABCD 0
POP x
ASSERT x == 0xABCD

CLEARSTACK
PUSH 0
SSETOR16N 0x1234 3
POP x
ASSERT x == 0x1234000000000000

# SXOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
SXOR16N 0x00FF 0
POP x
ASSERT x == 0x1122334455667777

CLEARSTACK
PUSH 0x1122334455667788
STACKXOR16N 0xFFFF 3
POP x
ASSERT x == 0xEEDD334455667788

CLEARSTACK
PUSH 0
XOR16N 0xABCD 1
POP x
ASSERT x == 0xABCD0000

CLEARSTACK
PUSH -1
SFLIP16N 0xFFFF 0
POP x
ASSERT x == -65536

# clamp n
CLEARSTACK
PUSH 0x1122334455667788
SAND16N 0x00FF 99
POP x
ASSERT x == 0x0022334455667788

# soft fails
CLEARSTACK
SAND16N 1 0
ASSERT OK == 0
CLEARSTACK
SOR16N 1 0
ASSERT OK == 0
CLEARSTACK
SXOR16N 1 0
ASSERT OK == 0

HOLD_FLASH 1
