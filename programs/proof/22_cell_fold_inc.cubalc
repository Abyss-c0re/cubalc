# Proof 22 — INC/DEC + cell fold (digit 9 data/loop plane)
HOLD_FLASH 1
SCIENCE LOAD

# INC / DEC vars
LET n = 10
INC n
ASSERT n == 11
INC n 5
ASSERT n == 16
DEC n 6
ASSERT n == 10
DEC n
ASSERT n == 9

# cells + INC CELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CELLSET 3 4
CELLSET 4 5
INC CELL 0
ASSERT CELL(0) == 2
INC CELL 1 10
ASSERT CELL(1) == 12
DEC CELL 2
ASSERT CELL(2) == 2

# fold aggregates
ASSERT SUMCELL(0, 4) == 2+12+2+4+5
SUMCELL 0 4
ASSERT LAST_N == 25
ASSERT MINCELL(0, 4) == 2
ASSERT MAXCELL(0, 4) == 12
MAXCELL 0 4
ASSERT LAST_N == 12

# loop fill + sum
CLEARCELLS
LET i = 0
WHILE i < 5
  CELLSET i i * 10
  INC i
END
ASSERT CELL(0) == 0
ASSERT CELL(4) == 40
ASSERT SUMCELL(0, 4) == 100

ASSERT OK == 1
CUBE g ROLE matrix PROTON 1
FOLDBITS g "1111000011110000111100001111000011110000111100001111000011110000"
ASSERT DIGIT(g) >= 0

PRINT "proof22_cell_fold" n SUMCELL(0,4) MAXCELL(0,4) DIGIT(g)
