# Proof 240 — digit-5 dual-stack low-n bitfield metrics: DPOPMN DANYMN DALLMN
HOLD_FLASH 1
SCIENCE LOAD

# DPOPMN — popcount low n
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
DPOPMN 4
POP y
POP x
ASSERT x == 4
ASSERT y == 4

CLEARSTACK
PUSH 0xAB
PUSH 0x00
2POPMN 8
POP y
POP x
# 0xAB = 10101011 → 5 ones
ASSERT x == 5
ASSERT y == 0

# DONESMN alias / n=0 → 0
CLEARSTACK
PUSH -1
PUSH 7
DONESMN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# n=64 full popcount of -1 = 64
CLEARSTACK
PUSH -1
PUSH 0
DPOPMN 64
POP y
POP x
ASSERT x == 64
ASSERT y == 0

# DANYMN
CLEARSTACK
PUSH 0x10
PUSH 0x00
DANYMN 4
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 0x10
PUSH 0x08
2ANYMN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# PAIRANYMN n=0 → 0
CLEARSTACK
PUSH 99
PUSH 1
PAIRANYMN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DALLMN
CLEARSTACK
PUSH 0x0F
PUSH 0x07
DALLMN 4
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFF
PUSH 0xFE
2ALLMN 8
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# PAIRALLMN n=0 vacuous true
CLEARSTACK
PUSH 0
PUSH 0
PAIRALLMN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# n=64 all ones
CLEARSTACK
PUSH -1
PUSH 0
DALLMN 64
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fails
CLEARSTACK
DPOPMN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DANYMN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DALLMN 4
ASSERT OK == 0

HOLD_FLASH 1
