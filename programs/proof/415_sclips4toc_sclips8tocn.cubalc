# Proof 415 — digit-7 signed clip 4/32 + imm8: SCLIPS4TOC SCLIPS32TOC SCLIPS8TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLIPS4TOC: 20 → 7
CELLSET 1 20
PUSH 1
SCLIPS4TOC
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP

# CLIPS4TOC: -20 → -8 via SSEXT32 path
CELLSET 2 4294967276
PUSH 2
SSEXT32TOC
POP
PUSH 2
CLIPS4TOC
ASSERT LAST_N == -8
ASSERT CELL(2) == -8
POP

# SCLIPS4TOC mid: 3 stays
CELLSET 3 3
PUSH 3
SCLIPS4TOC
ASSERT LAST_N == 3
ASSERT CELL(3) == 3
POP

# SCLIPS32TOC: value within 32-bit stays
CELLSET 4 1000
PUSH 4
SCLIPS32TOC
ASSERT LAST_N == 1000
ASSERT CELL(4) == 1000
POP

# CLIPS32TOC: above INT32_MAX → 2147483647
CELLSET 5 3000000000
PUSH 5
CLIPS32TOC
ASSERT LAST_N == 2147483647
ASSERT CELL(5) == 2147483647
POP

# SCLIPS32TOC: below INT32_MIN → -2147483648
CLEARSTACK
PUSH 6
PUSH 0
PUSH 3000000000
SUB
SSETCELL
POP
PUSH 6
SCLIPS32TOC
ASSERT LAST_N == -2147483648
ASSERT CELL(6) == -2147483648
POP

# SCLIPS8TOCN: 200 → 127, i replaced with result
CELLSET 7 200
PUSH 7
SCLIPS8TOCN
ASSERT LAST_N == 127
ASSERT CELL(7) == 127
POP

# CLIPS8TOCN: -200 → -128
CELLSET 8 4294967096
PUSH 8
SSEXT32TOC
POP
PUSH 8
CLIPS8TOCN
ASSERT LAST_N == -128
ASSERT CELL(8) == -128
POP

# soft short stack OK=0
CLEARSTACK
SCLIPS4TOC
ASSERT OK == 0

CLEARSTACK
SCLIPS8TOCN
ASSERT OK == 0

HOLD_FLASH 0
