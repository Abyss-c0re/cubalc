# FORMGUIDE — FORMHINT + covering topics + first-topic GUIDE one-shot

FORMGUIDE HASFORM
ASSERT OK == 1
ASSERT FORMGUIDE_OF == "HASFORM"
ASSERT FORMGUIDE_TOPIC == "cap"
ASSERT FORMTOPICS_N >= 1
ASSERT GUIDE_RELATED_N >= 3
SYS HASI "cubalc.formguide.v1"
ASSERT LAST_N == 1
SYS HASI "HASFORM"
ASSERT LAST_N == 1

# multi-topic form: first is general
FORMGUIDE INCLUDE
ASSERT OK == 1
ASSERT FORMGUIDE_TOPIC == "general"
ASSERT FORMTOPICS_N >= 2
SYS HASI "lib"
ASSERT LAST_N == 1

GUIDEFORM SETP
ASSERT OK == 1
ASSERT FORMGUIDE_TOPIC == "plate"
SYS HASI "fat"
ASSERT LAST_N == 1

# quoted — bare FORMHINT would resolve to prior FORM_HINT bag var
FORMGUIDE "FORMHINT"
ASSERT OK == 1
ASSERT FORMGUIDE_TOPIC == "cap"
SYS HASI "FORMHINT"
ASSERT LAST_N == 1

FORMGUIDE STATUS
ASSERT OK == 1
ASSERT FORMTOPICS_N >= 2
SYS HASI "general"
ASSERT LAST_N == 1

# miss soft
FORMGUIDE ZZZ_NO_SUCH
ASSERT OK == 0
CLEAR_ERR

# need name
FORMGUIDE
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1344_formguide: PASS"
