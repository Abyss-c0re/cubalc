# Proof 433 — digit-4 cell bitfield width ladder: BSWAP64CELL BITREV16CELL ROL16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# BSWAP64CELL: 0x0102030405060708 → 0x0807060504030201
CELLSET 0 72623859790382856
BSWAP64CELL 0 0
ASSERT CELL(0) == 578437695752307201
ASSERT LAST_N == 1

# BSWAP64RANGE identity 0
CELLSET 1 0
BSWAP64RANGE 1 1
ASSERT CELL(1) == 0

# round-trip bswap64
CELLSET 2 72623859790382856
BSWAP64CELL 2 2
BSWAP64CELL 2 2
ASSERT CELL(2) == 72623859790382856

# BITREV16CELL: 1 → 0x8000; 0x8000 → 1
CELLSET 3 1
CELLSET 4 32768
BITREV16CELL 3 4
ASSERT CELL(3) == 32768
ASSERT CELL(4) == 1
ASSERT LAST_N == 2

# BREV16CELL: 0 → 0
CELLSET 5 0
BREV16CELL 5 5
ASSERT CELL(5) == 0

# ROL16CELL: 0x0001 rotl 4 → 0x0010; 0x8000 rotl 1 → 0x0001
CELLSET 6 1
CELLSET 7 32768
ROL16CELL 6 7 4
ASSERT CELL(6) == 16
# 0x8000 rotl 4 = 0x0008
ASSERT CELL(7) == 8
ASSERT LAST_N == 2

# ROL16RANGE: 0x12 rotl 8 → 0x1200
CELLSET 8 18
ROL16RANGE 8 8 8
ASSERT CELL(8) == 4608
ASSERT LAST_N == 1

# identity k=0
CELLSET 9 42
ROL16CELL 9 9 0
ASSERT CELL(9) == 42

HOLD_FLASH 0
