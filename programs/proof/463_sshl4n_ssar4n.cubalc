# Proof 463 — digit-7 stack imm 4-bit field shift: SSHL4N SSHR4N SSAR4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSHL4N: 0x1 << 2 → 0x4
PUSH 0x1
SSHL4N 2 0
POP x
ASSERT x == 4

# SSHL4N: 0x8 << 1 → 0 (uint4 overflow); preserve high
CLEARSTACK
PUSH 0x1122334455667788
SSHL4N 1 0
POP x
ASSERT x == 0x1122334455667780

# k>=4 → 0 in nibble
CLEARSTACK
PUSH 0xF
SSHL4N 4 0
POP x
ASSERT x == 0

# SSHR4N: 0x8 >> 1 → 0x4
CLEARSTACK
PUSH 0x8
SSHR4N 1 0
POP x
ASSERT x == 4

# SSHR4N: 0xF >> 2 → 0x3 on nibble0 of 0x...F
CLEARSTACK
PUSH 0x112233445566778F
SSHR4N 2 0
POP x
ASSERT x == 0x1122334455667783

# STACKSHR4N n1: nibble1 of 0x...88 is 8 >> 1 → 4 → 0x...848
CLEARSTACK
PUSH 0x1122334455667788
STACKSHR4N 1 1
POP x
ASSERT x == 0x1122334455667748

# SSAR4N: 0xE (-2) >> 1 → -1 = 0xF in nibble
CLEARSTACK
PUSH 0xE
SSAR4N 1 0
POP x
ASSERT x == 15

# SSAR4N: 0x8 (-8) >> 1 → -4 = 0xC
CLEARSTACK
PUSH 0x8
SSAR4N 1 0
POP x
ASSERT x == 12

# SSAR4N k>=4 all sign: 0x8 → 0xF
CLEARSTACK
PUSH 0x8
SSAR4N 4 0
POP x
ASSERT x == 15

# positive SAR: 0x6 >> 1 → 0x3
CLEARSTACK
PUSH 0x6
SSAR4N 1 0
POP x
ASSERT x == 3

# SHL4N alias
CLEARSTACK
PUSH 0x3
SHL4N 1 0
POP x
ASSERT x == 6

# SAR4N alias on nibble 2 of 0x...E88: n2=E (-2) >>1 → F
CLEARSTACK
PUSH 0x112233445566E88
SAR4N 1 2
POP x
ASSERT x == 0x112233445566F88

HOLD_FLASH 0
