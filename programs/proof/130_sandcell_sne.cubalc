# Proof 130 — digit-9 cell-logic duals: SANDCELL SORCELL SXORCELL SNOTCELL SEQCELL SNECELL NECELL
HOLD_FLASH 1
SCIENCE LOAD

# SANDCELL
CLEARCELLS
CELLSET 0 15
CELLSET 1 255
CELLSET 2 7
CLEARSTACK
PUSH 0
PUSH 2
PUSH 3
SANDCELL
ASSERT LAST_N == 3
ASSERT CELL(0) == 3
ASSERT CELL(1) == 3
ASSERT CELL(2) == 3

# SORCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CLEARSTACK
PUSH 0
PUSH 1
PUSH 4
SORCELL
ASSERT CELL(0) == 5
ASSERT CELL(1) == 6

# SXORCELL
CLEARCELLS
CELLSET 0 15
CLEARSTACK
PUSH 0
PUSH 0
PUSH 15
SXORCELL
ASSERT CELL(0) == 0

# SNOTCELL
CLEARCELLS
CELLSET 0 0
CLEARSTACK
PUSH 0
PUSH 0
SNOTCELL
ASSERT LAST_N == 1
ASSERT CELL(0) == -1

# SCELLEQ (not SEQCELL — IOTA alias)
CLEARCELLS
CELLSET 0 7
CELLSET 1 3
CELLSET 2 7
CLEARSTACK
PUSH 0
PUSH 2
PUSH 7
SCELLEQ
ASSERT LAST_N == 2
ASSERT CELL(0) == 1
ASSERT CELL(1) == 0
ASSERT CELL(2) == 1

# NECELL stmt
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 1
NECELL 0 2 1
ASSERT LAST_N == 1
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1
ASSERT CELL(2) == 0

# SNECELL
CLEARCELLS
CELLSET 0 9
CELLSET 1 8
CELLSET 2 9
CLEARSTACK
PUSH 0
PUSH 2
PUSH 9
SNECELL
ASSERT LAST_N == 1
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1
ASSERT CELL(2) == 0

# soft fails
CLEARSTACK
SANDCELL
ASSERT OK == 0
SNOTCELL
ASSERT OK == 0
SCELLEQ
ASSERT OK == 0
SNECELL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof130_sandcell_sne" LAST_N SP
