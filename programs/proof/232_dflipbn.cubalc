# Proof 232 — digit-1 dual-stack control-flag flip: DFLIPBN
HOLD_FLASH 1
SCIENCE LOAD

# DFLIPBN bit0
CLEARSTACK
PUSH 0
PUSH 1
DFLIPBN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 2FLIPBN bit3: 0x08 toggle
CLEARSTACK
PUSH 0
PUSH 0x0F
2FLIPBN 3
POP y
POP x
ASSERT x == 8
ASSERT y == 7

# PAIRFLIPBN
CLEARSTACK
PUSH 0xAA
PUSH 0x55
PAIRFLIPBN 1
POP y
POP x
ASSERT x == 0xA8
ASSERT y == 0x57

# DTGLBN alias double-flip identity
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
DTGLBN 5
DTGLBN 5
POP y
POP x
ASSERT x == 0x1234
ASSERT y == 0xABCD

# DFLIPBITN / high bit 63
CLEARSTACK
PUSH 0
PUSH 0
DFLIPBITN 63
POP y
POP x
# 1<<63 as signed is negative min
ASSERT x != 0
ASSERT y != 0
ASSERT x == y

# chain SET then FLIP clears
CLEARSTACK
PUSH 0
PUSH 0
DSETBN 2
DFLIPBN 2
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft empty
CLEARSTACK
DFLIPBN 1
ASSERT OK == 0

# n clamp: n>63 treated as 63
CLEARSTACK
PUSH 0
PUSH 0
DFLIPBN 100
POP y
POP x
ASSERT x != 0
ASSERT y != 0
