# Proof 289 — digit-2 dual-stack imm reverse ALU: DSUBFROMN DDIVFROMN DMODFROMN
HOLD_FLASH 1
SCIENCE LOAD

# DSUBFROMN n — a b → (n-a) (n-b)
CLEARSTACK
PUSH 3
PUSH 7
DSUBFROMN 10
POP y
POP x
ASSERT x == 7
ASSERT y == 3

CLEARSTACK
PUSH 10
PUSH 0
PAIRSUBFROMN 3
POP y
POP x
ASSERT x == -7
ASSERT y == 3

CLEARSTACK
PUSH -5
PUSH 5
DRSUBN 0
POP y
POP x
ASSERT x == 5
ASSERT y == -5

# DDIVFROMN n — a b → n/a n/b
CLEARSTACK
PUSH 5
PUSH 4
DDIVFROMN 20
POP y
POP x
ASSERT x == 4
ASSERT y == 5

CLEARSTACK
PUSH 3
PUSH -2
PAIRDIVFROMN 10
POP y
POP x
ASSERT x == 3
ASSERT y == -5

CLEARSTACK
PUSH 0
PUSH 5
DRDIVN 99
POP y
POP x
ASSERT x == 0
ASSERT y == 19

# DMODFROMN n — a b → n%a n%b
CLEARSTACK
PUSH 3
PUSH 7
DMODFROMN 10
POP y
POP x
ASSERT x == 1
ASSERT y == 3

CLEARSTACK
PUSH 5
PUSH 4
PAIRMODFROMN 17
POP y
POP x
ASSERT x == 2
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH 3
DREMFROMN 100
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# soft fails
CLEARSTACK
DSUBFROMN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DDIVFROMN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
POP z
DMODFROMN 1
ASSERT OK == 0

HOLD_FLASH 1
