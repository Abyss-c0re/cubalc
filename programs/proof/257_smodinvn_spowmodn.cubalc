# Proof 257 — digit-2 stack immediate modular inv/pow/div: SMODINVN SPOWMODN SMODDIVN
HOLD_FLASH 1
SCIENCE LOAD

# SMODINVN m — inverse mod prime
CLEARSTACK
PUSH 3
SMODINVN 7
POP x
# 3*5=15≡1 mod 7
ASSERT x == 5

CLEARSTACK
PUSH 2
STACKMODINVN 5
POP x
ASSERT x == 3

# MODINVN / no inverse
CLEARSTACK
PUSH 2
MODINVN 4
POP x
ASSERT x == 0

CLEARSTACK
PUSH 1
INVMODN 1
POP x
ASSERT x == 0

# SPOWMODN exp m
CLEARSTACK
PUSH 2
SPOWMODN 10 1000
POP x
# 2^10 = 1024 ≡ 24 mod 1000
ASSERT x == 24

CLEARSTACK
PUSH 3
STACKPOWMODN 4 7
POP x
# 3^4=81≡4 mod 7
ASSERT x == 4

CLEARSTACK
PUSH 5
POWMODN 0 7
POP x
# x^0 = 1
ASSERT x == 1

CLEARSTACK
PUSH 2
SPOWMODN 3 0
POP x
ASSERT x == 0

# SMODDIVN b m — a * inv(b) mod m
CLEARSTACK
PUSH 6
SMODDIVN 3 7
POP x
# 6 * inv(3) = 6*5 = 30 ≡ 2 mod 7  (6/3=2)
ASSERT x == 2

CLEARSTACK
PUSH 10
STACKMODDIVN 4 13
POP x
# 10 * inv(4) mod 13; 4*10=40≡1 mod 13 → inv=10; 10*10=100≡9 mod 13
ASSERT x == 9

CLEARSTACK
PUSH 5
MODDIVN 2 4
POP x
# no inv of 2 mod 4
ASSERT x == 0

# soft fails
CLEARSTACK
SMODINVN 7
ASSERT OK == 0
CLEARSTACK
SPOWMODN 2 7
ASSERT OK == 0
CLEARSTACK
SMODDIVN 2 7
ASSERT OK == 0

HOLD_FLASH 1
