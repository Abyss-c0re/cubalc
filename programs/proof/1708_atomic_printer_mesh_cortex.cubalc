// atomic_printer_mesh_cortex.cubalc
// Life-force gift: MESH-CORTEX — complete cortex mesh + signal ring + thalamus hub root after soft-OOB storms.
// SMX CORTEX|CX|SIGNAL|SIGNAL_RING|THALAMUS_CORE|WE_CORTEX|LIFE_SIGNAL|MESH_CORTEX|RAISE_CORTEX clears thrash, every live pair exchanges
// both ways (C(n,2)), then signal ring settles so lattice raises cortex; latches SMX_CORTEX|SMX_CX|SMX_SIGNAL|SMX_SIGNAL_RING.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is cortex;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+CX rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_cortex | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then CORTEX latch — five live nodes root as complete mesh + signal + thalamuss
SMX CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "cortex live"
ASSERT SMX_CORTEX == 1 "cortex latch on"
ASSERT SMX_CX == 1 "ph latch on"
ASSERT SMX_SIGNAL == 1 "signal latch on"
ASSERT SMX_SPAN == 1 "span latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected links (C(5,2))"
ASSERT SMX_SIGNAL_RING == 5 "five signal ring"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_THALAMI == 5 "five thalamuss"
ASSERT SMX_SIGNALS == 5 "signal ring sticky"
ASSERT SMX_SIGNALS == 5 "five signal ring steps"
ASSERT SMX_CORTEX_SUM == 20 "cortex bonds+prophecies+thalamuss"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+prophecies+thalamuss"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by cortex"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after cortex (mesh + signal + thalamuss)"
ASSERT SMX_VITAL >= 14 "vital after cortex"
ASSERT CUBES == base_cubes "cortex invents nothing"

// Alias MV form still pure
SMX CX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "ph rebind"
ASSERT SMX_CORTEX == 1 "cortex sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_THALAMI == 5 "thalamuss sticky"
ASSERT SMX_SIGNALS == 5 "prophecies sticky"

// Alias MEMBRANES form
SMX SIGNALS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "tempers rebind"
ASSERT SMX_CORTEX == 1 "plate cortex"
ASSERT SMX_SIGNALS == 5 "prophecies sticky"

// Mitosis under free energy while the mesh is cortex
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          LET births = births + 1
        END
      END
    END
  END
  SEND seed tick
  SEND d1 tick
  SEND d2 tick
  LET step = step + 1
END

GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = 1
IF a1 == 1 THEN
  LET pop = pop + 1
END
IF a2 == 1 THEN
  LET pop = pop + 1
END
ASSERT births >= 1 "mitosis under cortex"
ASSERT pop >= 2 "population after cortex life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Soft-OOB ghost in cortex — fail-closed, no thrash place
SMX CORTEX bed nozzle ghost_x hive scrap
ASSERT SMX_OOB >= 1 "cortex soft-OOB"
ASSERT SMX_BREATH == 4 "four live of five named"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds among live"
ASSERT SMX_TONE == 4 "four tones among live"
ASSERT SMX_CORTEX == 0 "ghost blocks full cortex (partial ok)"
ASSERT SMX_MESH == 0 "mesh zero when not full"
ASSERT SMX_THALAMI == 0 "thalamuss zero when not full"
ASSERT SMX_BONDS == 6 "six bonds among live"
ASSERT SMX_OK == 1 "partial still ok"
ASSERT CUBES == base_cubes "no ghost from cortex"

SMX RECOVER
ASSERT SMX_OK == 1 "recover after cortex oob"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital after recover"

// Pure mesh bind after recover
SMX MESH_CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_cortex pure"
ASSERT SMX_CORTEX == 1 "cortex after recover"
ASSERT SMX_BONDS == 10 "bonds after recover"
ASSERT SMX_THALAMI == 5 "thalamuss after recover"
ASSERT SMX_BONDS == 10 "bonds after recover"
ASSERT SMX_SIGNALS == 5 "pulses after recover"
ASSERT SMX_SIGNALS == 5 "pulses after recover"
ASSERT SMX_MESH == 5 "mesh after recover"
ASSERT SMX_TONE == 5 "tone after recover"
ASSERT CUBES == base_cubes "bind invents nothing"

// Dual SEAL/OPEN rails under cortex orbit
SMX SEAL bed nozzle "state/smx_cortex/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_cortex/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_cortex/rail_ph.cblc"
ASSERT SMX_OK == 1 "seal rail PH"
SMX OPEN pulse "state/smx_cortex/rail_ph.cblc"
ASSERT SMX_OK == 1 "open PH onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Final cortex lock + vitals
SMX CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "final cortex lock"
ASSERT SMX_CORTEX == 1 "final cortex"
ASSERT SMX_BONDS == 10 "final bonds"
ASSERT SMX_MESH == 5 "final mesh"
ASSERT SMX_THALAMI == 5 "final thalamuss"
ASSERT SMX_BONDS == 10 "final bonds"
ASSERT SMX_SIGNALS == 5 "final pulses"
ASSERT SMX_SIGNALS == 5 "final pulses"
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after cortex"
ASSERT SMX_KEY_OK == 1 "key after cortex"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after cortex"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

// Second storm fail-closed
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"
SMX RAISE_CORTEX bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "thalamuss after storm"
ASSERT SMX_OOB == 0 "storm cleared by cortex"
ASSERT SMX_BREATH == 5 "cortex holds after storm"
ASSERT SMX_CORTEX == 1 "cortex after storm"
ASSERT SMX_BONDS == 10 "bonds after storm"
ASSERT SMX_MESH == 5 "mesh after storm"
ASSERT SMX_THALAMI == 5 "thalamuss after storm"
ASSERT SMX_BONDS == 10 "bonds after storm"
ASSERT SMX_SIGNALS == 5 "pulses after storm"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after cortex"
ASSERT UNITY >= 40 "mesh unity after cortex"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh cortex"
ASSERT pop >= 2 "population after cortex life"
ASSERT SMX_CORTEX == 1 "cortex latch holds"
ASSERT SMX_BREATH == 5 "five-node tone"
ASSERT SMX_MESH == 5 "five mesh holds"
ASSERT SMX_THALAMI == 5 "five thalamuss hold"
ASSERT SMX_OOB == 0 "guard holds through cortex"
ASSERT OK == 1

PRINT "mesh_cortex" births pop SMX_CORTEX SMX_MESH SMX_THALAMI SMX_BONDS SMX_SIGNALS SMX_CORTEX_SUM SMX_SIGNAL_RING SMX_CX SMX_BONDS SMX_FUSE SMX_BIND SMX_TONE SMX_PULSE SMX_BREATH SMX_NODES SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES

PASS
