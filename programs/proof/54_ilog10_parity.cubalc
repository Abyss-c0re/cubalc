# Proof 54 — digit-6/2 ILOG10 ODD/EVEN + stack SILOG10 SODD SEVEN
HOLD_FLASH 1
SCIENCE LOAD

# ILOG10 / LOG10
ASSERT ILOG10(1) == 0
ASSERT ILOG10(9) == 0
ASSERT ILOG10(10) == 1
ASSERT ILOG10(99) == 1
ASSERT ILOG10(100) == 2
ASSERT ILOG10(1000) == 3
ASSERT LOG10(12345) == 4
ASSERT ILOG10(0) == -1
ASSERT ILOG10(-5) == -1

# ODD / EVEN
ASSERT ODD(1) == 1
ASSERT ODD(2) == 0
ASSERT ODD(-3) == 1
ASSERT EVEN(0) == 1
ASSERT EVEN(4) == 1
ASSERT EVEN(7) == 0
ASSERT EVEN(-2) == 1

# stack SILOG10
CLEARSTACK
PUSH 1000
SILOG10
ASSERT LAST_N == 3
CLEARSTACK
PUSH 7
SLOG10
ASSERT LAST_N == 0
CLEARSTACK
PUSH 0
STACKILOG10
ASSERT LAST_N == -1

# stack SODD / SEVEN
CLEARSTACK
PUSH 5
SODD
ASSERT LAST_N == 1
CLEARSTACK
PUSH 8
SEVEN
ASSERT LAST_N == 1
CLEARSTACK
PUSH 9
STACKEVEN
ASSERT LAST_N == 0
CLEARSTACK
PUSH 0
STACKODD
ASSERT LAST_N == 0

# compose: log10 of power of 10
CLEARSTACK
PUSH 6
SPOW2
SILOG10
ASSERT LAST_N == 1

# underflow
CLEARSTACK
SILOG10
ASSERT OK == 0
CLEARSTACK
SODD
ASSERT OK == 0
CLEARSTACK
SEVEN
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof54_ilog10_parity" LAST_N SP
