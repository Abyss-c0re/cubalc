# Proof 423 — digit-8 word bit metrics TOC: SPARITYTOC SBSWAPTOC SBITREV32TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPARITYTOC: 0b1011 → parity 1
CELLSET 1 11
PUSH 1
SPARITYTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP

# PARITYTOC: 0b1010 → 0
CELLSET 2 10
PUSH 2
PARITYTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SBSWAPTOC: 0x12345678 → 0x78563412
CELLSET 3 305419896
PUSH 3
SBSWAPTOC
ASSERT LAST_N == 2018915346
ASSERT CELL(3) == 2018915346
POP

# BSWAPTOC identity mid: 0
CELLSET 4 0
PUSH 4
BSWAPTOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SBITREV32TOC: 0x00000001 → 0x80000000
CELLSET 5 1
PUSH 5
SBITREV32TOC
ASSERT LAST_N == 2147483648
ASSERT CELL(5) == 2147483648
POP

# SREV32TOC: 0x80000000 → 0x00000001
CELLSET 6 2147483648
PUSH 6
SREV32TOC
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# soft short
CLEARSTACK
SPARITYTOC
ASSERT OK == 0

CLEARSTACK
SBSWAPTOC
ASSERT OK == 0

CLEARSTACK
SBITREV32TOC
ASSERT OK == 0

HOLD_FLASH 0
