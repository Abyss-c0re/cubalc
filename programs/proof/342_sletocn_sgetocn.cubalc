# Proof 342 — digit-9 imm compare bounds TOC: SLETOCN SGETOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SLETOCN equal
CELLSET 1 5
PUSH 1
SLETOCN 5
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# LETOCN true less
CELLSET 2 3
PUSH 2
LETOCN 10
ASSERT LAST_N == 1
ASSERT CELL(2) == 1
POP

# SLEATN false
CELLSET 3 10
PUSH 3
SLEATN 3
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SGETOCN equal
CELLSET 4 7
PUSH 4
SGETOCN 7
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# GETOCN true greater
CELLSET 5 9
PUSH 5
GETOCN 2
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# SGEATN false
CELLSET 6 1
PUSH 6
SGEATN 5
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# negative cell vs 0
PUSH 7
PUSH (-3)
SSETCELL
POP
PUSH 7
SLETOCN 0
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

PUSH 8
PUSH (-3)
SSETCELL
POP
PUSH 8
SGETOCN 0
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# soft fails
CLEARSTACK
SLETOCN 1
ASSERT OK == 0
SGETOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof342_sletocn_sgetocn" LAST_N SP
HOLD_FLASH 1
