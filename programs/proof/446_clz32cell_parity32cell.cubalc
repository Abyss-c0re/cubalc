# Proof 446 — digit-5 cell fixed-width 32 metrics: CLZ32CELL CTZ32CELL PARITY32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# CLZ32CELL: 0x0F → 28; 0x80000000 → 0; 0 → 32; 1 → 31
CELLSET 0 15
CELLSET 1 2147483648
CELLSET 2 0
CELLSET 3 1
CLZ32CELL 0 3
ASSERT CELL(0) == 28
ASSERT CELL(1) == 0
ASSERT CELL(2) == 32
ASSERT CELL(3) == 31
ASSERT LAST_N == 4

# CTZ32CELL: 0xF0 → 4; 0x80000000 → 31; 0 → 32; 1 → 0
CELLSET 4 240
CELLSET 5 2147483648
CELLSET 6 0
CELLSET 7 1
CTZ32CELL 4 7
ASSERT CELL(4) == 4
ASSERT CELL(5) == 31
ASSERT CELL(6) == 32
ASSERT CELL(7) == 0
ASSERT LAST_N == 4

# PARITY32CELL: 0x0F → 0 (4 ones); 0x01 → 1; 0xFFFFFFFF → 0; 0x03 → 0
CELLSET 8 15
CELLSET 9 1
CELLSET 10 4294967295
CELLSET 11 3
PARITY32CELL 8 11
ASSERT CELL(8) == 0
ASSERT CELL(9) == 1
ASSERT CELL(10) == 0
ASSERT CELL(11) == 0
ASSERT LAST_N == 4

# PARITY32RANGE single: 0x07 → 1 (3 ones)
CELLSET 12 7
PARITY32RANGE 12 12
ASSERT CELL(12) == 1

# high bits above 32 ignored
CELLSET 13 4294967296
CLZ32CELL 13 13
ASSERT CELL(13) == 32
CELLSET 14 4294967296
CTZ32CELL 14 14
ASSERT CELL(14) == 32
CELLSET 15 4294967297
PARITY32CELL 15 15
ASSERT CELL(15) == 1

# CLZ32RANGE alias: 0x10000 → 15
CELLSET 16 65536
CLZ32RANGE 16 16
ASSERT CELL(16) == 15

HOLD_FLASH 0
