# INCLUDE class_boot - agent_boot + class_guard one-shot

HOLD_FLASH 1

CLASS Ticket
  FIELD id
END

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
INCLUDE class_boot
ASSERT OK == 1
ASSERT CLASS_GUARD_OK == 1
HASINCLUDE agent_boot
