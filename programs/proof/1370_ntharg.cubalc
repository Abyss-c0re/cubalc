# NTHARG / GETARG — peel CUBALC_ARGi raw argv (NTHPOS twin; flags kept)

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"

# miss without fallback
NTHARG 0
ASSERT LAST_N == 0
ASSERT NTHARG_HIT == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# miss with OR fallback
NTHARG 0 OR "default.txt"
ASSERT LAST_N == 0
ASSERT NTHARG_HIT == 0
SYS EQS LAST "default.txt"
ASSERT LAST_N == 1

# hit flag and file
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "--out=x"
SYS ENV SET CUBALC_ARG2 "a.txt"
SYS ENV SET CUBALC_ARGC "3"
NTHARG 0
ASSERT LAST_N == 1
ASSERT NTHARG_HIT == 1
SYS EQS LAST "--verbose"
ASSERT LAST_N == 1
ASSERT NTHARG_N == 0

NTHARG 2
ASSERT LAST_N == 1
SYS EQS LAST "a.txt"
ASSERT LAST_N == 1
ASSERT NTHARG_N == 2

# GETARG alias
GETARG 1
SYS EQS LAST "--out=x"
ASSERT LAST_N == 1

# NTHPOS peels non-flag only — ARG0 is flag so NTHPOS 0 is a.txt
NTHPOS 0
SYS EQS LAST "a.txt"
ASSERT LAST_N == 1

# beyond argc
NTHARG 9 OR "none"
ASSERT LAST_N == 0
SYS EQS LAST "none"
ASSERT LAST_N == 1

# discoverable
HASFORM "NTHARG"
ASSERT LAST_N == 1
HASFORM "GETARG"
ASSERT LAST_N == 1

RELATED "NTHARG"
SYS HASLINE LAST "ARGMAP"
ASSERT LAST_N == 1

PRINT "ntharg ok"
PASS
