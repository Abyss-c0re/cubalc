# Proof 339 — digit-1 unary parity TOC: SODDTOC SEVENTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SODDTOC odd
CELLSET 1 7
PUSH 1
SODDTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# ODDTOC even → 0
CELLSET 2 8
PUSH 2
ODDTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SODDAT negative odd (-3 = ...11101)
PUSH 3
PUSH (-3)
SSETCELL
POP
PUSH 3
SODDAT
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# SEVENTOC even
CELLSET 4 10
PUSH 4
SEVENTOC
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# EVENTOC odd → 0
CELLSET 5 11
PUSH 5
EVENTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SEVENAT zero even
CELLSET 6 0
PUSH 6
SEVENAT
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# negative even (-4)
PUSH 7
PUSH (-4)
SSETCELL
POP
PUSH 7
SEVENTOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# soft fails
CLEARSTACK
SODDTOC
ASSERT OK == 0
SEVENTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof339_soddtoc_seventoc" LAST_N SP
HOLD_FLASH 1
