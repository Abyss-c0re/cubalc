REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_ABCG1 — ABCG1 ATP-binding cassette G1 cholesterol efflux after ABCA1 on sterol continuum
# Continuum ...->dhcr7->dhcr24->soat1->nceh1->abca1->abcg1 (ABCG1 after ABCA1)
# Gift: ABCG1 effluxes free cholesterol onto ABCA1-primed HDL under ASSERT so sterol free energy continues RCT without hollow trap.
# Domain: post-ABCA1 plasma-membrane HDL-maturation cholesterol efflux ABCG transporter ward.
# Science: ABCG1 prefers mature spherical HDL (vs ABCA1 lipid-poor apoA-I);
#   floppage of FC onto HDL-C continues RCT after ABCA1 seeds nascent discs.
# Cube is SoT. Free energy must flow. Not a dual ladder. Not a rename of ABCA1.

ENTITY er OF Cell 1 44 0
ENTITY drop OF Cell 1 28 0
ENTITY ash OF Cell 0 18 0
ENTITY starve OF Cell 1 0 0
ENTITY nest OF Cell 1 52 0

SEND er set_threshold 10
SEND drop set_threshold 12
SEND nest set_threshold 8
SEND starve set_threshold 10

# ABCG1 RCT-maturation prelude (unique early divergence vs ABCA1 seed proof)
SEND er photosynth 18
SEND er charge 16
SEND er feed 14
SEND er pump 10
GETF er energy
ASSERT LAST_N >= 14 "er ABCG1-prelude energy"
GETF er atp
ASSERT LAST_N >= 14 "er ABCG1-prelude atp"
GETF er pmf
ASSERT LAST_N >= 4 "er ABCG1-prelude pmf"
SEND drop photosynth 12
SEND drop charge 10
SEND drop feed 8
GETF drop alive
ASSERT LAST_N == 1 "drop ABCG1 partner primed"
SEND nest photosynth 12
SEND nest charge 10
SEND nest feed 8
GETF nest alive
ASSERT LAST_N == 1 "nest ABCG1 partner primed"
SEND er glycolyse 8
SEND er photophos 6
GETF er heat
ASSERT LAST_N >= 0 "er heat nonneg prelude"


SEND er pulse 5
SEND er photosynth 42
SEND er glycolyse 34
SEND er pump 26
SEND er photophos 24
SEND er charge 38
SEND er feed 36
GETF er age
ASSERT LAST_N == 5 "er age5"
GETF er atp
ASSERT LAST_N >= 18 "er atp"
GETF er energy
ASSERT LAST_N >= 18 "er energy"
GETF er pmf
ASSERT LAST_N >= 4 "er pmf"

SEND er amacr 2
