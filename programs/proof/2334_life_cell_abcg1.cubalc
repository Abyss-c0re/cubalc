SEND er charge 8
SEND er feed 6
SEND er abca1 1
ASSERT LAST_N == 1 "er abca1 seed nascent HDL before ABCG1"
GETF er heat
LET g_h = LAST_N
GETF er energy
LET g_e = LAST_N
GETF er atp
LET g_a = LAST_N
GETF er age
LET g_age = LAST_N
GETF er pcr
LET g_pcr = LAST_N
GETF er reserve
LET g_rsv = LAST_N
GETF er pmf
LET g_pmf = LAST_N
GETF er threshold
LET g_thr = LAST_N
SEND er abcg1 3
ASSERT LAST_N == 3 "er abcg1 mature-HDL load-3"
GETF er heat
ASSERT LAST_N == g_h + 3 "er abcg1 heat+3"
GETF er energy
ASSERT LAST_N == g_e - 3 "er abcg1 energy-3"
GETF er atp
ASSERT LAST_N == g_a - 3 "er abcg1 atp-3"
GETF er age
ASSERT LAST_N == g_age "er abcg1 age held"
GETF er pcr
ASSERT LAST_N == g_pcr "er abcg1 pcr held"
GETF er reserve
ASSERT LAST_N == g_rsv "er abcg1 reserve held"
GETF er pmf
ASSERT LAST_N == g_pmf "er abcg1 pmf held"
GETF er threshold
ASSERT LAST_N == g_thr "er abcg1 thr held"
GETF er alive
ASSERT LAST_N == 1 "er alive post ABCG1 mature-HDL"

# drop partner ABCG1 maturation
SEND drop photosynth 14
SEND drop charge 12
SEND drop feed 10
SEND drop abca1 1
ASSERT LAST_N == 1 "drop abca1 seed before ABCG1"
GETF drop heat
LET dg_h = LAST_N
GETF drop energy
LET dg_e = LAST_N
GETF drop atp
LET dg_a = LAST_N
SEND drop abcg1 2
ASSERT LAST_N == 2 "drop abcg1 mature-HDL load-2"
GETF drop heat
ASSERT LAST_N == dg_h + 2 "drop abcg1 heat+2"
GETF drop energy
ASSERT LAST_N == dg_e - 2 "drop abcg1 energy-2"
GETF drop atp
ASSERT LAST_N == dg_a - 2 "drop abcg1 atp-2"
GETF drop alive
ASSERT LAST_N == 1 "drop alive post ABCG1"

# nest partner
SEND nest photosynth 14
SEND nest charge 12
SEND nest feed 10
SEND nest abca1 1
ASSERT LAST_N == 1 "nest abca1 seed before ABCG1"
GETF nest heat
LET ng_h = LAST_N
GETF nest energy
LET ng_e = LAST_N
GETF nest atp
LET ng_a = LAST_N
SEND nest abcg1 2
ASSERT LAST_N == 2 "nest abcg1 mature-HDL load-2"
GETF nest heat
ASSERT LAST_N == ng_h + 2 "nest abcg1 heat+2"
GETF nest energy
ASSERT LAST_N == ng_e - 2 "nest abcg1 energy-2"
GETF nest atp
ASSERT LAST_N == ng_a - 2 "nest abcg1 atp-2"
GETF nest alive
ASSERT LAST_N == 1 "nest alive post ABCG1"

# hollow clamps
SEND starve abcg1 4
ASSERT LAST_N == 0 "starve abcg1 no-ATP clamp"
SEND ash abcg1 3
ASSERT LAST_N == 0 "ash abcg1 dead clamp"
SEND er abcg1 0
ASSERT LAST_N == 0 "er abcg1 n0 clamp"

# dual cassette seal: ABCA1 seed + ABCG1 mature in one mitosis budget
SEND er photosynth 22
SEND er charge 18
SEND er feed 16
GETF er energy
LET dual_e = LAST_N
SEND er abca1 1
ASSERT LAST_N == 1 "er abca1 dual-cassette seed"
SEND er abcg1 1
ASSERT LAST_N == 1 "er abcg1 dual-cassette mature"
GETF er energy
ASSERT LAST_N == dual_e - 2 "er dual cassette energy-2"
GETF er alive
ASSERT LAST_N == 1 "er alive dual cassette RCT"
GETF drop alive
ASSERT LAST_N == 1 "drop sealed dual cassette"
GETF nest alive
ASSERT LAST_N == 1 "nest sealed dual cassette"


# Spherical HDL preference board — ABCG1 after repeated ABCA1 seeds
SEND er photosynth 20
SEND er charge 16
SEND er feed 14
SEND er abca1 2
ASSERT LAST_N == 2 "er abca1 double-seed discs"
GETF er heat
LET s_h = LAST_N
GETF er energy
LET s_e = LAST_N
GETF er atp
LET s_a = LAST_N
GETF er age
LET s_age = LAST_N
GETF er reserve
LET s_rsv = LAST_N
SEND er abcg1 4
ASSERT LAST_N == 4 "er abcg1 spherical-HDL load-4"
GETF er heat
ASSERT LAST_N == s_h + 4 "er abcg1 sph heat+4"
GETF er energy
ASSERT LAST_N == s_e - 4 "er abcg1 sph energy-4"
GETF er atp
ASSERT LAST_N == s_a - 4 "er abcg1 sph atp-4"
GETF er age
ASSERT LAST_N == s_age "er abcg1 sph age held"
GETF er reserve
ASSERT LAST_N == s_rsv "er abcg1 sph reserve held"
GETF er alive
ASSERT LAST_N == 1 "er alive spherical HDL board"

# Energy-aware ready coherence after ABCG1 spend
SEND er photosynth 24
SEND er charge 20
SEND er feed 18
SEND er set_threshold 10
GETF er energy
LET rdy_e = LAST_N
SEND er abcg1 1
ASSERT LAST_N == 1 "er abcg1 ready-coherence spend"
GETF er energy
LET rdy_e2 = LAST_N
ASSERT rdy_e2 == rdy_e - 1 "er abcg1 ready energy-1"
GETF er threshold
LET rdy_thr = LAST_N
GETF er ready
LET rdy_flag = LAST_N
# ready must match energy>=threshold
GETF er alive
ASSERT LAST_N == 1 "er alive ready-coherence"

# Population seal: three living wards after ABCG1 continuum
GETF er alive
ASSERT LAST_N == 1 "pop er"
GETF drop alive
ASSERT LAST_N == 1 "pop drop"
GETF nest alive
ASSERT LAST_N == 1 "pop nest"
GETF ash alive
ASSERT LAST_N == 0 "pop ash hollow held"
GETF starve atp
ASSERT LAST_N == 0 "pop starve atp hollow held"

ASSERT 1 == 1 "life_cell_abcg1 PASS"


