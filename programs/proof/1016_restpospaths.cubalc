# RESTPOSPATHS / TAILPATHS — files after subcommand as absolute path bag
# Usability: tool seal a.txt b.txt without RESTPOS + EACH + REALPATH glue.

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV UNSET CUBALC_ARG3
SYS ENV SET CUBALC_ARGC "0"

# empty
RESTPOSPATHS
ASSERT LAST_N == 0
ASSERT RESTPOSPATHS_N == 0
ASSERT RESTPOSPATHS_EXIST_N == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# only subcommand → 0 files
SYS ENV SET CUBALC_ARG0 "seal"
SYS ENV SET CUBALC_ARGC "1"
RESTPOSPATHS
ASSERT LAST_N == 0
ASSERT RESTPOS_N == 0

# subcommand + two existing files
SYS ENV SET CUBALC_ARG0 "parse"
SYS ENV SET CUBALC_ARG1 "Makefile"
SYS ENV SET CUBALC_ARG2 "include/cubalc_law.h"
SYS ENV SET CUBALC_ARGC "3"
RESTPOSPATHS
ASSERT LAST_N == 2
ASSERT RESTPOSPATHS_N == 2
ASSERT RESTPOSPATHS_EXIST_N == 2
ASSERT RESTPOS_N == 2
# raw RESTPOS kept relative
SYS HASLINE RESTPOS "Makefile"
ASSERT LAST_N == 1
SYS HASLINE RESTPOS "include/cubalc_law.h"
ASSERT LAST_N == 1
# abs fields
SYS NTH 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "Makefile"
ASSERT LAST_N == 1
RESTPOSPATHS
SYS NTH 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "cubalc_law.h"
ASSERT LAST_N == 1
# subcommand not in bag
SYS HASLINE RESTPOSPATHS "parse"
ASSERT LAST_N == 0

# flags (= form) + subcommand + file — bare --flag steals next token
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "export"
SYS ENV SET CUBALC_ARG2 "docs/MEANINGFUL_ITER.md"
SYS ENV SET CUBALC_ARGC "3"
TAILPATHS
ASSERT LAST_N == 1
ASSERT RESTPOSPATHS_EXIST_N == 1
SYS ENDS LAST "MEANINGFUL_ITER.md"
ASSERT LAST_N == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1

# missing path still abs, EXIST lower
SYS ENV SET CUBALC_ARG0 "run"
SYS ENV SET CUBALC_ARG1 "no/such/restpospaths_xyz.cubalc"
SYS ENV SET CUBALC_ARG2 "Makefile"
SYS ENV SET CUBALC_ARGC "3"
RESTPOSPATHS
ASSERT LAST_N == 2
ASSERT RESTPOSPATHS_EXIST_N == 1
SYS NTH 0
SYS HAS LAST "no/such/restpospaths_xyz.cubalc"
ASSERT LAST_N == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1

# works after SUBCMD (same bag)
SYS ENV SET CUBALC_ARG0 "seal"
SYS ENV SET CUBALC_ARG1 "include"
SYS ENV SET CUBALC_ARGC "2"
SUBCMD
SYS EQS LAST "seal"
ASSERT LAST_N == 1
RESTPOSPATHS
ASSERT LAST_N == 1
SYS ENDS LAST "include"
ASSERT LAST_N == 1
SYS ISDIR LAST
ASSERT LAST_N == 1

PRINT "restpospaths ok"
