# Proof 428 — digit-0 imm fixed-width shift32 TOC: SSHL32TOCN SSHR32TOCN SSAR32TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSHL32TOCN: cell 1 = 1, k=4 → 16
CELLSET 1 1
PUSH 1
SSHL32TOCN 4
ASSERT LAST_N == 16
ASSERT CELL(1) == 16
POP

# SHL32TOCN: 0x80000000 << 1 → 0
CELLSET 2 2147483648
PUSH 2
SHL32TOCN 1
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SSHR32TOCN: 0x80000000 >> 1 → 0x40000000
CELLSET 3 2147483648
PUSH 3
SSHR32TOCN 1
ASSERT LAST_N == 1073741824
ASSERT CELL(3) == 1073741824
POP

# SHR32TOCN: k>=32 → 0
CELLSET 4 255
PUSH 4
SHR32TOCN 32
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SSAR32TOCN: -16 >> 2 → -4 (build -16 via NOTCELL ~15)
CELLSET 5 15
NOTCELL 5 5
ASSERT CELL(5) == -16
PUSH 5
SSAR32TOCN 2
ASSERT LAST_N == -4
ASSERT CELL(5) == -4
POP

# SAR32TOCN: 0x80000000 as int32 >> 31 → -1
CELLSET 6 2147483648
PUSH 6
SAR32TOCN 31
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# soft short
CLEARSTACK
SSHL32TOCN 1
ASSERT OK == 0

CLEARSTACK
SSHR32TOCN 1
ASSERT OK == 0

CLEARSTACK
SSAR32TOCN 1
ASSERT OK == 0

HOLD_FLASH 0
