# IFFIFTYP - plate exactly-fifty key diagnostic branch
# Continues ladder after IFFORTYNINEP. Soft twin PENTECONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET fortynine = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49}"
LET fifty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50}"
LET fiftyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51}"
LET empty = "{}"

IFFIFTYP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFIFTYP_N == 1
ASSERT FIFTYP_N == 1
ASSERT IFFIFTYP_LEN == 50
ASSERT IFPENTECONTAP_N == 1
ASSERT IFFIFTYKEYP_N == 1

IFPENTECONTAP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFIFTYKEYP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFIFTYP fortynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFIFTYP_N == 0
ASSERT IFFIFTYP_LEN == 49

IFFIFTYP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFIFTYP_LEN == 51

IFFIFTYP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFIFTYP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFIFTYP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENPENTECONTAP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFIFTYKEYP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffiftyp_ok" IFFIFTYP_N IFFIFTYP_LEN
