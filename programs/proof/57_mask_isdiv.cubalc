# Proof 57 — digit-0 MASK/BITMASK ISDIV + stack SMASK SISDIV
HOLD_FLASH 1
SCIENCE LOAD

# MASK / BITMASK
ASSERT MASK(0) == 0
ASSERT MASK(1) == 1
ASSERT MASK(4) == 15
ASSERT MASK(8) == 255
ASSERT BITMASK(16) == 65535
ASSERT MASK(-1) == 0
ASSERT BAND(MASK(3), 7) == 7

# ISDIV / DIVISIBLE
ASSERT ISDIV(10, 5) == 1
ASSERT ISDIV(10, 3) == 0
ASSERT ISDIV(0, 7) == 1
ASSERT ISDIV(7, 0) == 0
ASSERT DIVISIBLE(100, 10) == 1
ASSERT ISDIV(-12, 4) == 1
ASSERT ISDIV(12, -3) == 1

# stack SMASK
CLEARSTACK
PUSH 8
SMASK
ASSERT LAST_N == 255
CLEARSTACK
PUSH 4
SBITMASK
ASSERT LAST_N == 15
CLEARSTACK
PUSH 0
STACKMASK
ASSERT LAST_N == 0

# stack SISDIV
CLEARSTACK
PUSH 20
PUSH 5
SISDIV
ASSERT LAST_N == 1
CLEARSTACK
PUSH 20
PUSH 6
SDIVISIBLE
ASSERT LAST_N == 0
CLEARSTACK
PUSH 9
PUSH 0
STACKISDIV
ASSERT LAST_N == 0

# compose: mask then band
CLEARSTACK
PUSH 0xABCD
PUSH 8
SMASK
SAND
ASSERT LAST_N == 0xCD

# underflow
CLEARSTACK
SMASK
ASSERT OK == 0
CLEARSTACK
SISDIV
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof57_mask_isdiv" LAST_N SP
