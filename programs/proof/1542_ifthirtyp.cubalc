# IFTHIRTYP - plate exactly-thirty key diagnostic branch
# Continues ladder after IFTWENTYNINEP. Soft twin TRIACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET twentynine = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29}"
LET thirty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30}"
LET thirtyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31}"
LET empty = "{}"

IFTHIRTYP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFTHIRTYP_N == 1
ASSERT THIRTYP_N == 1
ASSERT IFTHIRTYP_LEN == 30
ASSERT IFTRIACONTAP_N == 1
ASSERT IFTHIRTYKEYP_N == 1

IFTRIACONTAP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTHIRTYKEYP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTHIRTYP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTHIRTYP_N == 0
ASSERT IFTHIRTYP_LEN == 29

IFTHIRTYP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTHIRTYP_LEN == 31

IFTHIRTYP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFTHIRTYP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENTHIRTYP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTRIACONTAP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTHIRTYKEYP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "ifthirtyp_ok" IFTHIRTYP_N IFTHIRTYP_LEN
PASS
