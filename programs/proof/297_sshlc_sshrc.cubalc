# Proof 297 — digit-5 shift-through-CARRY: SSHLC SSHRC DSHLCC DSHRCC
HOLD_FLASH 1
SCIENCE LOAD

# SSHLC — no cin, no cout
CLEARSTACK
LET CARRY = 0
PUSH 5
SSHLC
POP x
ASSERT x == 10
ASSERT CARRY == 0

# SSHLC — with cin
CLEARSTACK
LET CARRY = 1
PUSH 4
SHLCY
POP x
ASSERT x == 9
ASSERT CARRY == 0

# SSHLC — cout from MSB
CLEARSTACK
LET CARRY = 0
PUSH -1
SSHLCF
POP x
ASSERT x == -2
ASSERT CARRY == 1

# SSHLC — MSB + cin → 1 with cout (build high bit via SSHLN)
CLEARSTACK
LET CARRY = 1
PUSH 1
SSHLN 63
SSHLC
POP x
ASSERT x == 1
ASSERT CY == 1

# SSHRC — no cin
CLEARSTACK
LET CARRY = 0
PUSH 10
SSHRC
POP x
ASSERT x == 5
ASSERT CARRY == 0

# SSHRC — odd → cout LSB
CLEARSTACK
LET CARRY = 0
PUSH 7
SHRCY
POP x
ASSERT x == 3
ASSERT CARRY == 1

# SSHRC — cin injects MSB
CLEARSTACK
LET CARRY = 1
PUSH 2
SSHRCF
POP x
ASSERT x < 0
ASSERT CARRY == 0

# DSHLCC — shared cin
CLEARSTACK
LET CARRY = 1
PUSH 4
PUSH 6
DSHLCC
POP y
POP x
ASSERT x == 9
ASSERT y == 13
ASSERT CARRY == 0

# DSHLCC — cout OR
CLEARSTACK
LET CARRY = 0
PUSH -1
PUSH 1
PAIRSHLCC
POP y
POP x
ASSERT x == -2
ASSERT y == 2
ASSERT CARRY == 1

# DSHRCC — shared cin
CLEARSTACK
LET CARRY = 0
PUSH 10
PUSH 7
DSHRCC
POP y
POP x
ASSERT x == 5
ASSERT y == 3
ASSERT CARRY == 1

# DSHRCC — cin injects high both
CLEARSTACK
LET CARRY = 1
PUSH 0
PUSH 2
PAIRSHRCC
POP y
POP x
ASSERT x < 0
ASSERT y < 0
ASSERT CARRY == 0

# soft fails
CLEARSTACK
SSHLC
ASSERT OK == 0
CLEARSTACK
SSHRC
ASSERT OK == 0
CLEARSTACK
DSHLCC
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSHRCC
ASSERT OK == 0

HOLD_FLASH 1
