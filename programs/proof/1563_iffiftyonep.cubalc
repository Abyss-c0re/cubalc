# IFFIFTYONEP - plate exactly-fifty-one key diagnostic branch
# Continues ladder after IFFIFTYP. Soft twin HENPENTECONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET fifty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50}"
LET fiftyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51}"
LET fiftytwo = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51,\"P\":52}"
LET empty = "{}"

IFFIFTYONEP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFIFTYONEP_N == 1
ASSERT FIFTYONEP_N == 1
ASSERT IFFIFTYONEP_LEN == 51
ASSERT IFHENPENTECONTAP_N == 1
ASSERT IFFIFTYONEKEYP_N == 1

IFHENPENTECONTAP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFIFTYONEKEYP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFIFTYONEP fifty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFIFTYONEP_N == 0
ASSERT IFFIFTYONEP_LEN == 50

IFFIFTYONEP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFIFTYONEP_LEN == 52

IFFIFTYONEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFIFTYONEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFIFTYONEP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENHENPENTECONTAP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFIFTYONEKEYP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffiftyonep_ok" IFFIFTYONEP_N IFFIFTYONEP_LEN
PASS
