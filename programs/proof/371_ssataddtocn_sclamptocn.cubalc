# Proof 371 — digit-3 imm sat TOC: SSATADDTOCN SSATSUBTOCN SSATMULTOCN SCLAMPTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSATADDTOCN: 10+7 = 17
CELLSET 1 10
PUSH 1
SSATADDTOCN 7
ASSERT LAST_N == 17
ASSERT CELL(1) == 17
POP a
ASSERT a == 17

# SATADDTOCN: 5+(-2) = 3
CELLSET 2 5
PUSH 2
SATADDTOCN -2
ASSERT LAST_N == 3
ASSERT CELL(2) == 3
POP

# SSATSUBTOCN: 10-3 = 7
CELLSET 3 10
PUSH 3
SSATSUBTOCN 3
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# SATSUBTOCN: 5-8 = -3
CELLSET 4 5
PUSH 4
SATSUBTOCN 8
ASSERT LAST_N == -3
ASSERT CELL(4) == -3
POP

# SSATMULTOCN: 6*7 = 42
CELLSET 5 6
PUSH 5
SSATMULTOCN 7
ASSERT LAST_N == 42
ASSERT CELL(5) == 42
POP

# SATMULTOCN: 0*99 = 0
CELLSET 6 0
PUSH 6
SATMULTOCN 99
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SCLAMPTOCN: clamp(15, 0, 10) = 10
CELLSET 7 15
PUSH 7
SCLAMPTOCN 0 10
ASSERT LAST_N == 10
ASSERT CELL(7) == 10
POP

# CLAMPTOCN: clamp(-3, 0, 10) = 0
CELLSET 8 -3
PUSH 8
CLAMPTOCN 0 10
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# SCLAMPTOCN mid: clamp(5, 0, 10) = 5
CELLSET 9 5
PUSH 9
SCLAMPTOCN 0 10
ASSERT LAST_N == 5
ASSERT CELL(9) == 5
POP

# soft empty OK=0
CLEARSTACK
SSATADDTOCN 1
ASSERT OK == 0

PRINT "371_ssataddtocn_sclamptocn OK"
