# IFEIGHTEENP — plate exactly-eighteen key diagnostic branch
# Continues ladder after IFSEVENTEENP. Soft twin OCTODECAP.

HOLD_FLASH 1

LET one = "{\"solo\":1}"
LET seventeen = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17}"
