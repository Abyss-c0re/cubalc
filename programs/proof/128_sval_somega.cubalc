# Proof 128 — digit-2 factor metrics: SVAL SOMEGA SOMEGA0 + expr forms
HOLD_FLASH 1
SCIENCE LOAD

# VALUATION expr
ASSERT VALUATION(12, 2) == 2
ASSERT PVAL(81, 3) == 4
ASSERT VP(7, 2) == 0
ASSERT VALUATION(0, 5) == 0
ASSERT VALUATION(16, 1) == 0
ASSERT VALUATION(-24, 2) == 3

# OMEGA / OMEGA0 expr
ASSERT OMEGA(12) == 3
ASSERT BIGOMEGA(8) == 3
ASSERT OMEGA(1) == 0
ASSERT OMEGA(17) == 1
ASSERT OMEGA0(12) == 2
ASSERT LITTLEOMEGA(30) == 3
ASSERT NUOMEGA(16) == 1
ASSERT OMEGA0(1) == 0

# stack SVAL
CLEARSTACK
PUSH 12
PUSH 2
SVAL
ASSERT LAST_N == 2
PUSH 81
PUSH 3
SPVAL
ASSERT LAST_N == 4

# stack SOMEGA
CLEARSTACK
PUSH 12
SOMEGA
ASSERT LAST_N == 3
PUSH 8
SBIGOMEGA
ASSERT LAST_N == 3
PUSH 1
SOMEGA
ASSERT LAST_N == 0

# stack SOMEGA0
CLEARSTACK
PUSH 12
SOMEGA0
ASSERT LAST_N == 2
PUSH 30
SLITTLEOMEGA
ASSERT LAST_N == 3
PUSH 16
SNUOMEGA
ASSERT LAST_N == 1

# soft fails
CLEARSTACK
SVAL
ASSERT OK == 0
SOMEGA
ASSERT OK == 0
SOMEGA0
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof128_sval_somega" LAST_N SP
