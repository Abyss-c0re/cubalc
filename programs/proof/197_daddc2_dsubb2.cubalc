# Proof 197 — digit-7 dual-stack multiword stack-cin: DADDC2 DSUBB2
HOLD_FLASH 1
SCIENCE LOAD

# DADDC2: a b c d ca cb → sum+cin per lane
CLEARSTACK
LET CARRY = 0
PUSH 10
PUSH 20
PUSH 3
PUSH 4
PUSH 1
PUSH 0
DADDC2
POP y
POP x
ASSERT x == 14
ASSERT y == 24
ASSERT CARRY == 0

# wrap with cin
CLEARSTACK
LET CARRY = 0
PUSH -1
PUSH 5
PUSH 0
PUSH 1
PUSH 1
PUSH 0
2ADDC2
POP y
POP x
ASSERT x == 0
ASSERT y == 6
ASSERT CARRY == 1

# both cout
CLEARSTACK
LET CARRY = 0
PUSH -1
PUSH -2
PUSH 1
PUSH 3
PUSH 0
PUSH 0
PAIRADDC2
POP y
POP x
ASSERT x == 0
ASSERT y == 1
ASSERT CARRY == 1

# DADC2 alias with dual cin
CLEARSTACK
LET CARRY = 0
PUSH 100
PUSH 200
PUSH 0
PUSH 0
PUSH 1
PUSH 1
DADC2
POP y
POP x
ASSERT x == 101
ASSERT y == 201
ASSERT CARRY == 0

# DSUBB2: a b c d ba bb → sub-bin per lane
CLEARSTACK
LET BORROW = 0
LET CARRY = 0
PUSH 10
PUSH 20
PUSH 3
PUSH 5
PUSH 1
PUSH 0
DSUBB2
POP y
POP x
ASSERT x == 6
ASSERT y == 15
ASSERT BORROW == 0

# borrow out
CLEARSTACK
LET BORROW = 0
PUSH 5
PUSH 10
PUSH 5
PUSH 1
PUSH 1
PUSH 0
2SUBB2
POP y
POP x
ASSERT x == -1
ASSERT y == 9
ASSERT BORROW == 1

# PAIRSUBB2 both borrow
CLEARSTACK
LET BORROW = 0
PUSH 0
PUSH 1
PUSH 0
PUSH 1
PUSH 1
PUSH 1
PAIRSUBB2
POP y
POP x
ASSERT x == -1
ASSERT y == -1
ASSERT BORROW == 1

# DSBB2 alias no bin
CLEARSTACK
LET BORROW = 0
PUSH 8
PUSH 9
PUSH 3
PUSH 2
PUSH 0
PUSH 0
DSBB2
POP y
POP x
ASSERT x == 5
ASSERT y == 7
ASSERT BORROW == 0
