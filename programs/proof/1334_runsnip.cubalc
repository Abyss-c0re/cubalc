# RUNSNIP — execute curated SNIP mini one-shot

RUNSNIP
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "general"
ASSERT RUNSNIP_OK == 1
ASSERT RUNSNIP_ASSERTS_OK >= 0

RUNSNIP cap
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "cap"
ASSERT RUNSNIP_OK == 1
# nested printed RELATED bag or FORMHINT
SYS LINES LAST
ASSERT LAST_N >= 1

SNIPRUN fat
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "fat"
ASSERT RUNSNIP_OK == 1

RUNSNIP plate
ASSERT OK == 1
ASSERT RUNSNIP_OK == 1

RUNSNIP lib
ASSERT OK == 1
ASSERT RUNSNIP_OK == 1

RUNSNIP run
ASSERT OK == 1
ASSERT RUNSNIP_OK == 1

# alias forms → cap
RUNSNIP forms
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "cap"

# soft miss
RUNSNIP zzz_nope
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1334_runsnip: PASS"
