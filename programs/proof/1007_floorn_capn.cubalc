# FLOORN / CAPN — one-sided floor and cap after GETFLAGN
# (not MINN/MAXN — those are stack SMINN/SMAXN aliases)

HOLD_FLASH 1

# FLOORN raise floor
FLOORN 0 1
ASSERT LAST_N == 1
ASSERT FLOORN_CHANGED == 1
ASSERT FLOORN_X == 0

# already above floor
FLOORN 5 1
ASSERT LAST_N == 5
ASSERT FLOORN_CHANGED == 0

# CAPN lower ceiling
CAPN 100 16
ASSERT LAST_N == 16
ASSERT CAPN_CHANGED == 1
ASSERT CAPN_X == 100

# already under cap
CAPN 8 16
ASSERT LAST_N == 8
ASSERT CAPN_CHANGED == 0

# ATLEASTN / ATMOSTN aliases
ATLEASTN -3 0
ASSERT LAST_N == 0
ATMOSTN 99 10
ASSERT LAST_N == 10

# pipeline: GETFLAGN then floor then cap
SYS ENV SET CUBALC_ARG0 "--workers=100"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN workers|w OR ENV WORKERS OR 4
ASSERT LAST_N == 100
FLOORN LAST_N 1
ASSERT LAST_N == 100
ASSERT FLOORN_CHANGED == 0
CAPN LAST_N 16
ASSERT LAST_N == 16
ASSERT CAPN_CHANGED == 1

# low value floor
SYS ENV SET CUBALC_ARG0 "--workers=0"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN workers OR 0
FLOORN LAST_N 1
ASSERT LAST_N == 1
ASSERT FLOORN_CHANGED == 1

# var subject
LET n -5
FLOORN n 0
ASSERT LAST_N == 0
LET n 999
CAPN n 255
ASSERT LAST_N == 255

# LAST decimal
CAPN 50 10
SYS EQS LAST "10"
ASSERT LAST_N == 1

# optional TO
FLOORN 2 TO 5
ASSERT LAST_N == 5

PRINT "floorn_capn ok"
