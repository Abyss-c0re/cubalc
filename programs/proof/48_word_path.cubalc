# Proof 48 — digit-1 word data path: BSWAP BITREV PARITY NIBBLE + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# expr BSWAP / BSWAP32
ASSERT BSWAP(0x11223344) == 0x44332211
ASSERT BSWAP32(0xAABBCCDD) == 0xDDCCBBAA
ASSERT BSWAP(0) == 0
ASSERT BSWAP(BSWAP(0x01020304)) == 0x01020304

# expr BITREV / REVBITS (32-bit)
ASSERT BITREV(1) == 0x80000000
ASSERT BITREV(0x80000000) == 1
ASSERT REVBITS(0xF0000000) == 0x0F
ASSERT BITREV(BITREV(0xA5A5A5A5)) == 0xA5A5A5A5

# expr PARITY
ASSERT PARITY(0) == 0
ASSERT PARITY(1) == 1
ASSERT PARITY(3) == 0
ASSERT PARITY(0xFF) == 0
ASSERT PARITY(0xFE) == 1

# expr NIBBLE / NIB
ASSERT NIBBLE(0xABCD, 0) == 0xD
ASSERT NIBBLE(0xABCD, 1) == 0xC
ASSERT NIB(0xABCD, 2) == 0xB
ASSERT NIBBLE(0xABCD, 3) == 0xA
ASSERT NIBBLE(0xF0, 1) == 0xF

# stack SBSWAP
CLEARSTACK
PUSH 0x11223344
SBSWAP
ASSERT LAST_N == 0x44332211

# stack SBITREV
CLEARSTACK
PUSH 1
SBITREV
ASSERT LAST_N == 0x80000000
CLEARSTACK
PUSH 0x80000000
SREVBITS
ASSERT LAST_N == 1

# stack SPARITY
CLEARSTACK
PUSH 0xFE
SPARITY
ASSERT LAST_N == 1
PUSH 1
SPAR
ASSERT LAST_N == 1

# stack SNIB / SNIBBLE
CLEARSTACK
PUSH 0xABCD
PUSH 0
SNIB
ASSERT LAST_N == 0xD
CLEARSTACK
PUSH 0xABCD
PUSH 2
SNIBBLE
ASSERT LAST_N == 0xB

# aliases + compose
CLEARSTACK
PUSH 0x01020304
STACKBSWAP
ASSERT LAST_N == 0x04030201
SBSWAP32
ASSERT LAST_N == 0x01020304

# underflow
CLEARSTACK
SBSWAP
ASSERT OK == 0
CLEARSTACK
SBITREV
ASSERT OK == 0
CLEARSTACK
SPARITY
ASSERT OK == 0
CLEARSTACK
SNIB
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof48_word_path" LAST_N SP
