# Proof 104 — 3OVER + UNDER (1.12.81)
HOLD_FLASH 1
SCIENCE LOAD

# UNDER: a b → a a b
CLEARSTACK
PUSH 5
PUSH 6
UNDER
ASSERT SP == 3
POP t
ASSERT t == 6
POP m
ASSERT m == 5
POP b
ASSERT b == 5

# SUNDER alias
CLEARSTACK
PUSH 1
PUSH 2
SUNDER
ASSERT SP == 3
POP x
ASSERT x == 2
POP y
ASSERT y == 1
POP z
ASSERT z == 1

# 3OVER: a b c d e f → a b c d e f a b c
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
3OVER
ASSERT SP == 9
POP p0
ASSERT p0 == 3
POP p1
ASSERT p1 == 2
POP p2
ASSERT p2 == 1
POP p3
ASSERT p3 == 6
POP p4
ASSERT p4 == 5
POP p5
ASSERT p5 == 4
POP p6
ASSERT p6 == 3
POP p7
ASSERT p7 == 2
POP p8
ASSERT p8 == 1

# TOVER alias
CLEARSTACK
PUSH 9
PUSH 8
PUSH 7
PUSH 6
PUSH 5
PUSH 4
TOVER
ASSERT SP == 9
POP a
ASSERT a == 7

# underflow soft
CLEARSTACK
PUSH 1
UNDER
ASSERT OK == 0

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
3OVER
ASSERT OK == 0
