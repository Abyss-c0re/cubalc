# Proof 249 — digit-1 stack low-n bitfield metrics: SPOPMN SANYMN SALLMN
HOLD_FLASH 1
SCIENCE LOAD

# SPOPMN — popcount low n
CLEARSTACK
PUSH 0x0F
SPOPMN 4
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0xF0AB
STACKPOPMN 8
POP x
# 0xAB = 10101011 → 5 ones
ASSERT x == 5

# SONESMN alias
CLEARSTACK
PUSH 0x00
SONESMN 8
POP x
ASSERT x == 0

# SANYMN
CLEARSTACK
PUSH 0x10
SANYMN 4
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x18
STACKANYMN 4
POP x
# bit 3 set in low 4
ASSERT x == 1

CLEARSTACK
PUSH 0x00
ANYMN 8
POP x
ASSERT x == 0

# SALLMN
CLEARSTACK
PUSH 0x0F
SALLMN 4
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x07
STACKALLMN 4
POP x
ASSERT x == 0

# n=0 vacuous all
CLEARSTACK
PUSH 0x00
ALLMN 0
POP x
ASSERT x == 1

# soft fails
CLEARSTACK
SPOPMN 4
ASSERT OK == 0
CLEARSTACK
SANYMN 4
ASSERT OK == 0
CLEARSTACK
SALLMN 4
ASSERT OK == 0

HOLD_FLASH 1
