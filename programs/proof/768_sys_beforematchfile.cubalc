# SYS BEFOREMATCHFILE / INSERTBEFOREMATCH / FILEINSERTBEFORE
# — insert line BEFORE first file line containing needle
# Usability: dual of AFTERMATCHFILE for header/import patches
# BEFOREMATCHFILEI icase. Soft no-match. Soft path miss.

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS JOIN td "beforematchfile_mi_fixture"
LET fix = LAST
SYS MKDIR fix

SYS JOIN fix "sample.txt"
LET fs = LAST
SYS WRITE fs "header\n[section]\nkeep=1\nfooter"

# insert before [section]
SYS BEFOREMATCHFILE fs "[section]" "preamble"
ASSERT OK == 1
ASSERT BEFOREMATCHFILE_N == 1
ASSERT BEFOREMATCHFILE_I == 1
ASSERT BEFOREMATCHFILE_TOTAL == 5
SYS EQS LAST "preamble"
ASSERT LAST_N == 1

SYS LINEAT fs 0
SYS EQS LAST "header"
ASSERT LAST_N == 1
SYS LINEAT fs 1
SYS EQS LAST "preamble"
ASSERT LAST_N == 1
SYS LINEAT fs 2
SYS EQS LAST "[section]"
ASSERT LAST_N == 1
SYS LINEAT fs 3
SYS EQS LAST "keep=1"
ASSERT LAST_N == 1
SYS LINEAT fs 4
SYS EQS LAST "footer"
ASSERT LAST_N == 1

# icase match SECTION
SYS WRITE fs "a\n[SECTION]\nb"
SYS BEFOREMATCHFILEI fs "[section]" "x=1"
ASSERT BEFOREMATCHFILE_N == 1
ASSERT BEFOREMATCHFILE_I == 1
SYS LINEAT fs 0
SYS EQS LAST "a"
ASSERT LAST_N == 1
SYS LINEAT fs 1
SYS EQS LAST "x=1"
ASSERT LAST_N == 1
SYS LINEAT fs 2
SYS EQS LAST "[SECTION]"
ASSERT LAST_N == 1
SYS LINEAT fs 3
SYS EQS LAST "b"
ASSERT LAST_N == 1

# alias soft no-match
SYS INSERTBEFOREMATCH fs "missing" "nope"
ASSERT OK == 1
ASSERT BEFOREMATCHFILE_N == 0
ASSERT BEFOREMATCHFILE_I == -1

# soft path miss
SYS BEFOREMATCHFILE "no_such_beforematchfile_mi.txt" "a" "b"
ASSERT OK == 0
ASSERT BEFOREMATCHFILE_N == 0

# cleanup
SYS RM fs

PRINT "sys_beforematchfile ok"
