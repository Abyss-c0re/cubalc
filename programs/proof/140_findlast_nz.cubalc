# Proof 140 — digit-5 cell search: FINDLASTCELL FIRSTNZ LASTNZ + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# FINDLASTCELL
CLEARCELLS
CELLSET 0 7
CELLSET 1 3
CELLSET 2 7
CELLSET 3 9
FINDLASTCELL 7
ASSERT LAST_N == 2
ASSERT OK == 1
FINDLASTCELL 7 0 1
ASSERT LAST_N == 0
RFINDCELL 9
ASSERT LAST_N == 3
FINDLASTCELL 99
ASSERT LAST_N == -1
ASSERT OK == 0

# FINDCELL still first
FINDCELL 7
ASSERT LAST_N == 0

# FIRSTNZ / LASTNZ
CLEARCELLS
CELLSET 0 0
CELLSET 1 0
CELLSET 2 5
CELLSET 3 0
CELLSET 4 8
FIRSTNZ 0 4
ASSERT LAST_N == 2
ASSERT OK == 1
LASTNZ 0 4
ASSERT LAST_N == 4
FINDNZ 0 4
ASSERT LAST_N == 2
RFINDNZ 0 4
ASSERT LAST_N == 4

# no nonzero
CLEARCELLS
FIRSTNZ 0 3
ASSERT LAST_N == -1
ASSERT OK == 0
LASTNZ 0 3
ASSERT LAST_N == -1

# stack SFINDCELL
CLEARCELLS
CELLSET 1 42
CELLSET 3 42
CLEARSTACK
PUSH 0
PUSH 5
PUSH 42
SFINDCELL
ASSERT LAST_N == 1
POP a
ASSERT a == 1

# SFINDLAST
CLEARSTACK
PUSH 0
PUSH 5
PUSH 42
SFINDLAST
ASSERT LAST_N == 3
POP a
ASSERT a == 3

# not found
CLEARSTACK
PUSH 0
PUSH 5
PUSH 99
SFINDCELL
ASSERT LAST_N == -1
ASSERT OK == 0

# SFIRSTNZ / SLASTNZ
CLEARCELLS
CELLSET 0 0
CELLSET 1 11
CELLSET 2 0
CELLSET 3 22
CLEARSTACK
PUSH 0
PUSH 3
SFIRSTNZ
ASSERT LAST_N == 1
POP a
ASSERT a == 1
CLEARSTACK
PUSH 0
PUSH 3
SLASTNZ
ASSERT LAST_N == 3
POP a
ASSERT a == 3

# soft fails
CLEARSTACK
SFINDCELL
ASSERT OK == 0
SFINDLAST
ASSERT OK == 0
SFIRSTNZ
ASSERT OK == 0
SLASTNZ
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof140_findlast_nz" LAST_N SP
