# Proof 204 — digit-8 dual-stack fixed-width rotate: DROL8 DROR8 DROL16 DROR16
HOLD_FLASH 1
SCIENCE LOAD

# DROL8: rotate low byte left (mask high garbage)
CLEARSTACK
PUSH 0x81
PUSH 0x01
PUSH 1
PUSH 1
DROL8
POP y
POP x
ASSERT x == 0x03
ASSERT y == 0x02

# wrap within byte
CLEARSTACK
PUSH 0x80
PUSH 0xAB
PUSH 1
PUSH 4
2ROL8
POP y
POP x
ASSERT x == 0x01
ASSERT y == 0xBA

# PAIRROL8 / DROTL8 amount 0 identity (low 8)
CLEARSTACK
PUSH 0x7F
PUSH 0x55
PUSH 0
PUSH 0
PAIRROL8
POP y
POP x
ASSERT x == 0x7F
ASSERT y == 0x55

# DROR8
CLEARSTACK
PUSH 0x03
PUSH 0x02
PUSH 1
PUSH 1
DROR8
POP y
POP x
ASSERT x == 0x81
ASSERT y == 0x01

# 2ROR8 / PAIRROR8
CLEARSTACK
PUSH 0x01
PUSH 0xBA
PUSH 1
PUSH 4
PAIRROR8
POP y
POP x
ASSERT x == 0x80
ASSERT y == 0xAB

# DROL16: halfword rotate left
CLEARSTACK
PUSH 0x8001
PUSH 0x0001
PUSH 1
PUSH 1
DROL16
POP y
POP x
ASSERT x == 0x0003
ASSERT y == 0x0002

# wrap within 16
CLEARSTACK
PUSH 0x8000
PUSH 0xABCD
PUSH 1
PUSH 4
2ROL16
POP y
POP x
ASSERT x == 0x0001
ASSERT y == 0xBCDA

# DROR16
CLEARSTACK
PUSH 0x0003
PUSH 0x0002
PUSH 1
PUSH 1
DROR16
POP y
POP x
ASSERT x == 0x8001
ASSERT y == 0x0001

# PAIRROR16 / DROTR16
CLEARSTACK
PUSH 0x0001
PUSH 0xBCDA
PUSH 1
PUSH 4
PAIRROR16
POP y
POP x
ASSERT x == 0x8000
ASSERT y == 0xABCD

# amount mod width: 9 ≡ 1 for 8-bit
CLEARSTACK
PUSH 0x01
PUSH 0x80
PUSH 9
PUSH 9
DROL8
POP y
POP x
ASSERT x == 0x02
ASSERT y == 0x01
