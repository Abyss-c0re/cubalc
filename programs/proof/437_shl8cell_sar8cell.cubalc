# Proof 437 — digit-1 cell fixed-width 8 shift: SHL8CELL SHR8CELL SAR8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SHL8CELL: 1<<3 → 8; 0x80<<1 → 0 (uint8 overflow)
CELLSET 0 1
CELLSET 1 128
SHL8CELL 0 1 3
ASSERT CELL(0) == 8
# 0x80 << 3 = 0x400 & 0xFF = 0
ASSERT CELL(1) == 0
ASSERT LAST_N == 2

# SHL8RANGE k>=8 → 0
CELLSET 2 255
SHL8RANGE 2 2 8
ASSERT CELL(2) == 0

# SHR8CELL: 0x80 >> 1 → 0x40; 255 >> 4 → 15
CELLSET 3 128
CELLSET 4 255
SHR8CELL 3 4 1
ASSERT CELL(3) == 64
ASSERT CELL(4) == 127
ASSERT LAST_N == 2

CELLSET 5 255
SHR8RANGE 5 5 4
ASSERT CELL(5) == 15

# SAR8CELL: 0xF0 (-16) >> 2 → -4; 0x80 (-128) >> 1 → -64
CELLSET 6 240
CELLSET 7 128
SAR8CELL 6 7 2
ASSERT CELL(6) == -4
ASSERT CELL(7) == -32
ASSERT LAST_N == 2

# SAR8RANGE k>=8 → all sign
CELLSET 8 128
SAR8RANGE 8 8 8
ASSERT CELL(8) == -1
CELLSET 9 64
SAR8RANGE 9 9 10
ASSERT CELL(9) == 0

# positive SAR
CELLSET 10 32
SAR8CELL 10 10 3
ASSERT CELL(10) == 4

# high bits above 8 ignored on shift
CELLSET 11 257
SHL8CELL 11 11 1
ASSERT CELL(11) == 2

HOLD_FLASH 0
