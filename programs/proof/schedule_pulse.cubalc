SCHED pulse
PULSE 180 0.5 2000
PULSE 200 2000 1000
PULSE 10 1.25 100
SCHEDOUT /tmp/cubalc-pulse-proof.txt
SYS READ "/tmp/cubalc-pulse-proof.txt"
SYS HAS LAST "MSCHED 1"
ASSERT LAST_N == 1
SYS HAS LAST "PULSE 180 0.500 2000"
ASSERT LAST_N == 1
SYS HAS LAST "PULSE 200 2000 1000"
ASSERT LAST_N == 1
SYS HAS LAST "PULSE 10 1.250 100"
ASSERT LAST_N == 1
SYS HAS LAST "END"
ASSERT LAST_N == 1
ASSERT SCHED_N == 3
