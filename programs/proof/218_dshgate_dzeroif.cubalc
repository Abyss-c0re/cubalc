# Proof 218 — digit-1 dual-stack shared-flag gates: DSHGATE DZEROIF
HOLD_FLASH 1
SCIENCE LOAD

# DSHGATE true → pass both
CLEARSTACK
PUSH 7
PUSH 9
PUSH 1
DSHGATE
POP y
POP x
ASSERT x == 7
ASSERT y == 9

# false → zero both
CLEARSTACK
PUSH 7
PUSH 9
PUSH 0
2SHGATE
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRSHGATE / DGATES / DZEROUNLESS
CLEARSTACK
PUSH -3
PUSH 4
PUSH -1
PAIRSHGATE
POP y
POP x
ASSERT x == -3
ASSERT y == 4

CLEARSTACK
PUSH 1
PUSH 2
PUSH 0
DGATES
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 5
PUSH 6
PUSH 1
DZEROUNLESS
POP y
POP x
ASSERT x == 5
ASSERT y == 6

# DZEROIF true → zero both
CLEARSTACK
PUSH 7
PUSH 9
PUSH 1
DZEROIF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# false → leave both
CLEARSTACK
PUSH 7
PUSH 9
PUSH 0
2ZEROIF
POP y
POP x
ASSERT x == 7
ASSERT y == 9

# PAIRZEROIF / DZAPIF / DQZERO
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
PAIRZEROIF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 10
PUSH 20
PUSH 0
DZAPIF
POP y
POP x
ASSERT x == 10
ASSERT y == 20

CLEARSTACK
PUSH 3
PUSH 4
PUSH 1
DQZERO
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DZEROWHEN alias
CLEARSTACK
PUSH 8
PUSH 9
PUSH 0
DZEROWHEN
POP y
POP x
ASSERT x == 8
ASSERT y == 9

# complementarity: SHGATE then ZEROIF with same f
CLEARSTACK
PUSH 11
PUSH 22
PUSH 1
DSHGATE
POP y
POP x
ASSERT x == 11
ASSERT y == 22

CLEARSTACK
PUSH 11
PUSH 22
PUSH 1
DZEROIF
POP y
POP x
ASSERT x == 0
ASSERT y == 0
