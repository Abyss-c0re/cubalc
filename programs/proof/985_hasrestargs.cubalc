# HASRESTARGS / HASPOS — soft 0|1 min non-flag positionals (REQUIRE RESTARGS twin)

HOLD_FLASH 1

# empty
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
HASRESTARGS 1
ASSERT LAST_N == 0
HASRESTARGS
ASSERT LAST_N == 0

# flags only — no files
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "--verbose=1"
SYS ENV SET CUBALC_ARGC "2"
HASRESTARGS 1
ASSERT LAST_N == 0
HASARGC 2
ASSERT LAST_N == 1

# files after flags
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARG2 "b.txt"
SYS ENV SET CUBALC_ARGC "3"
HASRESTARGS 1
ASSERT LAST_N == 1
HASRESTARGS 2
ASSERT LAST_N == 1
HASRESTARGS 3
ASSERT LAST_N == 0
ASSERT RESTARGS_N == 2

# branch without REQUIRE
HASRESTARGS 1
IF LAST_N == 1
  LET mode "files"
ELSE
  LET mode "none"
END
SYS EQS mode "files"
ASSERT LAST_N == 1

# hard twin still works
REQUIRE RESTARGS 2
ASSERT LAST_N == 2

# HASPOS alias
SYS ENV SET CUBALC_ARG0 "only.txt"
SYS ENV SET CUBALC_ARGC "1"
HASPOS
ASSERT LAST_N == 1

PRINT "hasrestargs ok"
