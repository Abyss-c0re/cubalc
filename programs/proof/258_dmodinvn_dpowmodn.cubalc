# Proof 258 — digit-1 dual-stack imm modular inv/pow/div: DMODINVN DPOWMODN DMODDIVN
HOLD_FLASH 1
SCIENCE LOAD

# DMODINVN m
CLEARSTACK
PUSH 3
PUSH 2
DMODINVN 7
POP y
POP x
# 3*5=15≡1; 2*4=8≡1 mod 7
ASSERT x == 5
ASSERT y == 4

CLEARSTACK
PUSH 2
PUSH 1
2MODINVN 5
POP y
POP x
ASSERT x == 3
ASSERT y == 1

# PAIRMODINVN — 2 no inv mod 4; 3*3≡1 mod 4
CLEARSTACK
PUSH 2
PUSH 3
PAIRMODINVN 4
POP y
POP x
ASSERT x == 0
ASSERT y == 3

# DPOWMODN exp m
CLEARSTACK
PUSH 2
PUSH 3
DPOWMODN 4 7
POP y
POP x
# 2^4=16≡2; 3^4=81≡4 mod 7
ASSERT x == 2
ASSERT y == 4

CLEARSTACK
PUSH 5
PUSH 2
2POWMODN 0 7
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 2
PUSH 3
PAIRPOWMODN 3 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DMODDIVN c m — a * inv(c) mod m
CLEARSTACK
PUSH 6
PUSH 3
DMODDIVN 3 7
POP y
POP x
# inv(3)=5; 6*5=30≡2; 3*5=15≡1 mod 7
ASSERT x == 2
ASSERT y == 1

CLEARSTACK
PUSH 10
PUSH 4
2MODDIVN 4 13
POP y
POP x
# inv(4)=10 mod 13; 10*10=100≡9; 4*10=40≡1
ASSERT x == 9
ASSERT y == 1

CLEARSTACK
PUSH 5
PUSH 1
PAIRMODDIVN 2 4
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fails
CLEARSTACK
DMODINVN 7
ASSERT OK == 0
CLEARSTACK
PUSH 1
DPOWMODN 2 7
ASSERT OK == 0
CLEARSTACK
DMODDIVN 2 7
ASSERT OK == 0

HOLD_FLASH 1
