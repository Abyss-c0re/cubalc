# Proof 351 — digit-1 imm rotate TOC: SROLTOCN SRORTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SROLTOCN: 0b0001 rotl 1 → 0b0010 = 2
CELLSET 1 1
PUSH 1
SROLTOCN 1
ASSERT LAST_N == 2
ASSERT CELL(1) == 2
POP a
ASSERT a == 2

# ROLTOCN: high|1 rotl 1 → 3
PUSH 2
PUSH (-9223372036854775807)
SSETCELL
POP
PUSH 2
ROLTOCN 1
ASSERT LAST_N == 3
ASSERT CELL(2) == 3
POP

# SROLATN by 0 identity
CELLSET 3 42
PUSH 3
SROLATN 0
ASSERT LAST_N == 42
ASSERT CELL(3) == 42
POP

# SRORTOCN: 2 rotr 1 → 1
CELLSET 4 2
PUSH 4
SRORTOCN 1
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# RORTOCN: 1 rotr 1 → only bit63 set (negative, popcount 1)
CELLSET 5 1
PUSH 5
RORTOCN 1
ASSERT LAST_N < 0
PUSH LAST_N
SPOPCNT
ASSERT LAST_N == 1
POP
POP

# SRORATN by 0 identity
CELLSET 6 99
PUSH 6
SRORATN 0
ASSERT LAST_N == 99
ASSERT CELL(6) == 99
POP

# round-trip: 0x0F rotl 4 then rotr 4
CELLSET 7 15
PUSH 7
SROLTOCN 4
ASSERT LAST_N == 240
POP
PUSH 7
SRORTOCN 4
ASSERT LAST_N == 15
ASSERT CELL(7) == 15
POP

# soft fails empty stack
CLEARSTACK
SROLTOCN 1
ASSERT OK == 0
SRORTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof351_sroltocn_srortocn" LAST_N SP
HOLD_FLASH 1
