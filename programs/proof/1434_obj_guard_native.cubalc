# obj_guard via native HASOBJS/NEEDOBJS + HASOBJANY/NEEDOBJANY (no N× HASOBJ soup)

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

NEW Ticket t1
NEW Order order1

# empty skip
DEFAULT NEED_OBJS = ""
DEFAULT NEED_OBJ_ANY = ""
DEFAULT OBJ_GUARD_SOFT = 0
INCLUDE obj_guard
ASSERT OBJ_GUARD_OK == 1
ASSERT OBJ_GUARD_ALL_OK == 1
ASSERT OBJ_GUARD_ANY_OK == 1

# soft ALL hit
LET NEED_OBJS = "t1\norder1"
LET NEED_OBJ_ANY = ""
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 1
ASSERT OBJ_GUARD_OK == 1
ASSERT OBJHAVE_N >= 2
ASSERT OBJMISS_N == 0

# soft ALL miss — OBJMISS bag from HASOBJS
LET NEED_OBJS = "t1\nghost_obj_all"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 0
ASSERT OBJ_GUARD_OK == 0
ASSERT OBJMISS_N >= 1
SYS HASI OBJMISS "ghost_obj_all"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY hit — HASOBJANY bags
LET NEED_OBJS = ""
LET NEED_OBJ_ANY = "ghost_a\nt1"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 1
ASSERT OBJHAVE_N >= 1
SYS HASI OBJHAVE "t1"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY all-miss
LET NEED_OBJ_ANY = "ghostA\nghostB"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ANY_OK == 0
ASSERT OBJ_GUARD_OK == 0
ASSERT OBJHAVE_N == 0
ASSERT OBJMISS_N >= 2
CLEAR_ERR

# hard ALL via NEEDOBJS
LET NEED_OBJS = "t1\norder1"
LET NEED_OBJ_ANY = ""
LET OBJ_GUARD_SOFT = 0
INCLUDE obj_guard
ASSERT OBJ_GUARD_OK == 1

# hard ANY hit via NEEDOBJANY
LET NEED_OBJS = ""
LET NEED_OBJ_ANY = "ghost_z\nt1"
LET OBJ_GUARD_SOFT = 0
INCLUDE obj_guard
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 1

# combined soft
LET NEED_OBJS = "t1"
LET NEED_OBJ_ANY = "order1\nghost_z"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 1
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 1

# soft ALL miss + soft ANY hit → overall fail
LET NEED_OBJS = "t1\nghost_all"
LET NEED_OBJ_ANY = "order1"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 0
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 0
CLEAR_ERR

# surface discovery
HASOBJS t1 order1
ASSERT LAST_N == 1
HASOBJANY t1 ghost_x
ASSERT LAST_N == 1
HASFORM "HASOBJS"
ASSERT LAST_N == 1
HASFORM "HASOBJANY"
ASSERT LAST_N == 1
HASLIB obj_guard
ASSERT LAST_N == 1

PRINT "1434_obj_guard_native ok"
PASS
