# MEDIAN3N / MID3N — median of three → LAST_N (usability)

HOLD_FLASH 1

MEDIAN3N 1 2 3
ASSERT LAST_N == 2
ASSERT MEDIAN3N_OK == 1
ASSERT MID3N == 2

MEDIAN3N 3 1 2
ASSERT LAST_N == 2

MEDIAN3N 2 2 2
ASSERT LAST_N == 2

MEDIAN3N 5 1 3
ASSERT LAST_N == 3

MEDIAN3N 9 0 4
ASSERT LAST_N == 4

# negatives
LET n = 0
LET n = n - 5
MEDIAN3N n 0 5
ASSERT LAST_N == 0

LET a = 0
LET a = a - 10
LET b = 0
LET b = b - 3
LET c = 0
LET c = c - 7
MEDIAN3N a b c
ASSERT LAST_N == -7

# aliases
MID3N 8 1 4
ASSERT LAST_N == 4
MED3N 10 20 15
ASSERT LAST_N == 15
MIDDLE3N 7 7 9
ASSERT LAST_N == 7

# glue (comma / AND / OF)
MEDIAN3N 1 , 9 , 5
ASSERT LAST_N == 5
MEDIAN3N 4 AND 2 AND 6
ASSERT LAST_N == 4
MEDIAN3N OF 3 8 1
ASSERT LAST_N == 3

# surfaces
MEDIAN3N 11 22 33
ASSERT MEDIAN3N_A == 11
ASSERT MEDIAN3N_B == 22
ASSERT MEDIAN3N_C == 33
ASSERT MEDIAN3N == 22
ASSERT LAST_N == 22

PRINT "median3n ok"
PASS
