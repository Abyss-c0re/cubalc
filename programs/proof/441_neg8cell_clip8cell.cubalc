# Proof 441 — digit-7 cell fixed-width 8 math: NEG8CELL ZEXT8CELL CLIP8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NEG8CELL: 5 → -5; -5 (0xFB) → 5; min int8 0x80 stays 0x80
CELLSET 0 5
CELLSET 1 251
CELLSET 2 128
NEG8CELL 0 2
ASSERT CELL(0) == -5
ASSERT CELL(1) == 5
ASSERT CELL(2) == 128
ASSERT LAST_N == 3

# ZEXT8CELL: clear high bits
CELLSET 3 511
CELLSET 4 65535
ZEXT8CELL 3 4
ASSERT CELL(3) == 255
ASSERT CELL(4) == 255
ASSERT LAST_N == 2

# CLIP8CELL: clamp to [0,255]
# negative via SEXT8 of 0xF6 (-10)
CELLSET 5 246
SEXT8CELL 5 5
CELLSET 6 100
CELLSET 7 300
CLIP8CELL 5 7
ASSERT CELL(5) == 0
ASSERT CELL(6) == 100
ASSERT CELL(7) == 255
ASSERT LAST_N == 3

# CLIP8RANGE single
CELLSET 8 1000
CLIP8RANGE 8 8
ASSERT CELL(8) == 255

# round-trip NEG then ABS8 of 42
CELLSET 9 42
NEG8CELL 9 9
ABS8CELL 9 9
ASSERT CELL(9) == 42

# ZEXT after SEXT of 0x80
CELLSET 10 128
SEXT8CELL 10 10
ASSERT CELL(10) == -128
ZEXT8CELL 10 10
ASSERT CELL(10) == 128

HOLD_FLASH 0
