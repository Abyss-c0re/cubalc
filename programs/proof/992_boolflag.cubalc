# BOOLFLAG / TRUTHY / FALSY — CLI bool probes without EQS glue

HOLD_FLASH 1

# empty → false
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
BOOLFLAG verbose
ASSERT LAST_N == 0
ASSERT BOOLFLAG_HIT == 0
ASSERT BOOL == 0

# bare --verbose → true
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG verbose
ASSERT LAST_N == 1
ASSERT BOOLFLAG_HIT == 1
ASSERT BOOL == 1

# --quiet=false → false even when present (HASFLAG would be 1)
SYS ENV SET CUBALC_ARG0 "--quiet=false"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG quiet
ASSERT LAST_N == 0
ASSERT BOOLFLAG_HIT == 1
HASFLAG quiet
ASSERT LAST_N == 1

# --dry=0 / off / no
SYS ENV SET CUBALC_ARG0 "--dry=0"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG dry
ASSERT LAST_N == 0
SYS ENV SET CUBALC_ARG0 "--dry=off"
BOOLFLAG dry
ASSERT LAST_N == 0
SYS ENV SET CUBALC_ARG0 "--dry=no"
BOOLFLAG dry
ASSERT LAST_N == 0

# --force=true / yes / on
SYS ENV SET CUBALC_ARG0 "--force=true"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG force
ASSERT LAST_N == 1
SYS ENV SET CUBALC_ARG0 "--force=yes"
BOOLFLAG force
ASSERT LAST_N == 1
SYS ENV SET CUBALC_ARG0 "--force=ON"
BOOLFLAG force
ASSERT LAST_N == 1

# OR default when missing
SYS ENV SET CUBALC_ARGC "0"
BOOLFLAG debug OR 1
ASSERT LAST_N == 1
ASSERT BOOLFLAG_HIT == 0
BOOLFLAG debug OR 0
ASSERT LAST_N == 0

# TRUTHY / FALSY on strings
TRUTHY "yes"
ASSERT LAST_N == 1
TRUTHY "false"
ASSERT LAST_N == 0
FALSY "no"
ASSERT LAST_N == 1
FALSY "1"
ASSERT LAST_N == 0
TRUTHY "fast"
ASSERT LAST_N == 1
FALSY ""
ASSERT LAST_N == 1

# TRUTHY LAST after GETFLAG
SYS ENV SET CUBALC_ARG0 "--enabled=1"
SYS ENV SET CUBALC_ARGC "1"
GETFLAG enabled
TRUTHY LAST
ASSERT LAST_N == 1
GETFLAG enabled
FALSY
ASSERT LAST_N == 0

# BOOLFLAG with dashes stripped
SYS ENV SET CUBALC_ARG0 "--dry-run=yes"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG dry-run
ASSERT LAST_N == 1

PRINT "boolflag ok"
