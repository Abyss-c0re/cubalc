# INCLUDE method_boot - agent_boot + method_guard one-shot

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
END

DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
INCLUDE method_boot
ASSERT OK == 1
ASSERT METHOD_GUARD_OK == 1
HASINCLUDE agent_boot
ASSERT LAST_N == 1
HASINCLUDE method_guard
ASSERT LAST_N == 1
HASINCLUDE method_boot
ASSERT LAST_N == 1
HASLIB method_boot
ASSERT LAST_N == 1
VERSION
ASSERT LAST != ""

LET NEED_METHODS = "nosuch_method_boot_miss"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 1
INCLUDE method_boot
ASSERT METHOD_GUARD_OK == 0
CLEAR_ERR

LET NEED_METHODS = "Ticket.ping"
LET METHOD_GUARD_SOFT = 0
INCLUDE method_boot
ASSERT METHOD_GUARD_OK == 1

PRINT "1402_method_boot: PASS"
PASS
