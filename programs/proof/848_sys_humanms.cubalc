# SYS HUMANMS / FMTMS — milliseconds → human duration label
# Usability: WAITFILE_MS / SLEEP_MS / elapsed plates without shell

HOLD_FLASH 1

# zero
SYS HUMANMS 0
ASSERT OK == 1
SYS EQS LAST "0ms"
ASSERT LAST_N == 1
ASSERT HUMANMS_MS == 0

# sub-second
SYS HUMANMS 250
ASSERT OK == 1
SYS EQS LAST "250ms"
ASSERT LAST_N == 1
ASSERT HUMANMS_MS == 250
ASSERT HUMANMS_N == 250

# pure seconds
SYS HUMANMS 5000
ASSERT OK == 1
SYS EQS LAST "5s"
ASSERT LAST_N == 1
ASSERT HUMANMS_MS == 5000

# seconds + ms
SYS HUMANMS 1250
ASSERT OK == 1
SYS EQS LAST "1s250ms"
ASSERT LAST_N == 1

# minutes + seconds
SYS HUMANMS 90000
ASSERT OK == 1
SYS EQS LAST "1m30s"
ASSERT LAST_N == 1
ASSERT HUMANMS_MS == 90000

# hours
SYS HUMANMS 3600000
ASSERT OK == 1
SYS EQS LAST "1h"
ASSERT LAST_N == 1

SYS HUMANMS 3661000
ASSERT OK == 1
SYS EQS LAST "1h1m1s"
ASSERT LAST_N == 1

# days / weeks
SYS HUMANMS 86400000
ASSERT OK == 1
SYS EQS LAST "1d"
ASSERT LAST_N == 1

SYS HUMANMS 604800000
ASSERT OK == 1
SYS EQS LAST "1w"
ASSERT LAST_N == 1

# compound week+day
SYS HUMANMS 691200000
ASSERT OK == 1
SYS EQS LAST "1w1d"
ASSERT LAST_N == 1

# aliases
SYS FMTMS 2000
ASSERT OK == 1
SYS EQS LAST "2s"
ASSERT LAST_N == 1
SYS HUMANDUR 60000
ASSERT OK == 1
SYS EQS LAST "1m"
ASSERT LAST_N == 1

# default LAST_N
LET wait_ms = 4500
SYS HUMANMS wait_ms
ASSERT OK == 1
SYS EQS LAST "4s500ms"
ASSERT LAST_N == 1
ASSERT HUMANMS_MS == 4500

# negative clamps to 0
SYS HUMANMS -10
ASSERT OK == 1
SYS EQS LAST "0ms"
ASSERT LAST_N == 1

# round-trip single-unit via PARSEMS
SYS HUMANMS 120000
SYS PARSEMS LAST
ASSERT OK == 1
ASSERT LAST_N == 120000

SYS HUMANMS 3
SYS PARSEMS LAST
ASSERT OK == 1
ASSERT LAST_N == 3

PRINT "sys_humanms ok"
