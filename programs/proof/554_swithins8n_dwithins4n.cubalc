# Proof 554 — digit-3 stack+dual signed WITHIN 8/4: SWITHINS8N SWITHINS4N DWITHINS8N DWITHINS4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SWITHINS8N: 0 in [0,5) → 1; 5 not
PUSH 0x0
SWITHINS8N 0x0 0x5 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x5
WITHINS8N 0x0 0x5 0
POP x
ASSERT x == 0

# -1 in [-2,0)
CLEARSTACK
PUSH 0xFF
SWITHINSIGN8N 0xFE 0x0 0
POP x
ASSERT x == 1

# high preserve
CLEARSTACK
PUSH 0xAA03
SWITHINS8N 0x0 0x5 0
POP x
ASSERT x == 0xAA01

# STACKWITHINS8N n1
CLEARSTACK
PUSH 0x0400
STACKWITHINS8N 0x0 0x5 1
POP x
ASSERT x == 0x0100

# SWITHINS4N: 0 in [0,5) → 1; 5 not
CLEARSTACK
PUSH 0x0
SWITHINS4N 0x0 0x5 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x5
WITHINS4N 0x0 0x5 0
POP x
ASSERT x == 0

# -1=0xF in [-2,0)
CLEARSTACK
PUSH 0xF
SWITHINSIGN4N 0xE 0x0 0
POP x
ASSERT x == 1

# high nibble
CLEARSTACK
PUSH 0x13
SWITHINS4N 0x0 0x5 0
POP x
ASSERT x == 0x11

# STACKWITHINS4N n1
CLEARSTACK
PUSH 0x40
STACKWITHINS4N 0x0 0x5 1
POP x
ASSERT x == 0x10

# DWITHINS8N
CLEARSTACK
PUSH 0x0
PUSH 0x5
DWITHINS8N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFF
PUSH 0x0
PAIRWITHINS8N 0xFE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK2WITHINS8N n1
CLEARSTACK
PUSH 0x0300
PUSH 0x0500
STACK2WITHINS8N 0x0 0x5 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

# DWITHINS4N
CLEARSTACK
PUSH 0x0
PUSH 0x5
DWITHINS4N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xF
PUSH 0x1
PAIRWITHINS4N 0xE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK2WITHINS4N n1
CLEARSTACK
PUSH 0x30
PUSH 0x50
STACK2WITHINS4N 0x0 0x5 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x00

HOLD_FLASH 0
