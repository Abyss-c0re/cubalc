# Proof 408 — digit-4 stack dual fixed zext + nibble sext: SZEXT16TOC SZEXT32TOC SSEXT4TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SZEXT16TOC: low 16 of 0xABCD1234=2882343476 → 0x1234=4660
CELLSET 1 2882343476
PUSH 1
SZEXT16TOC
ASSERT LAST_N == 4660
ASSERT CELL(1) == 4660
POP

# ZEXT16TOC alias: 0xFFFF → 65535
CELLSET 2 65535
PUSH 2
ZEXT16TOC
ASSERT LAST_N == 65535
ASSERT CELL(2) == 65535
POP

# SZEXT32TOC: low 32 of 0x1FFFFFFFF=8589934591 → 0xFFFFFFFF=4294967295
CELLSET 3 8589934591
PUSH 3
SZEXT32TOC
ASSERT LAST_N == 4294967295
ASSERT CELL(3) == 4294967295
POP

# ZEXT32TOC: 0x80000000 stays
CELLSET 4 2147483648
PUSH 4
ZEXT32TOC
ASSERT LAST_N == 2147483648
ASSERT CELL(4) == 2147483648
POP

# SSEXT4TOC: low 4 of 0x0F → -1
CELLSET 5 15
PUSH 5
SSEXT4TOC
ASSERT LAST_N == -1
ASSERT CELL(5) == -1
POP

# SEXT4TOC alias: low 4 of 0x07 → 7
CELLSET 6 7
PUSH 6
SEXT4TOC
ASSERT LAST_N == 7
ASSERT CELL(6) == 7
POP

# SSEXTNTOC: low 4 of 0xF8=248 → -8
CELLSET 7 248
PUSH 7
SSEXTNTOC
ASSERT LAST_N == -8
ASSERT CELL(7) == -8
POP

# soft short stack OK=0
CLEARSTACK
SZEXT16TOC
ASSERT OK == 0
SZEXT32TOC
ASSERT OK == 0
SSEXT4TOC
ASSERT OK == 0

PRINT "408_szext16toc_ssext4toc OK"
