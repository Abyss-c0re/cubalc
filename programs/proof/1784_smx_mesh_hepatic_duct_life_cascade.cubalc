// 1784_smx_mesh_hepatic_duct_life_cascade.cubalc
// Cascade: LIFE_FORCE -> SINUSOID -> DISSE -> HEPATOCYTE -> KUPFFER -> STELLATE -> OVAL -> CANALICULUS -> DUCTULE -> HEPATIC_DUCT -> STABILIZE -> WE_AUTOHEAL
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 48
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_hepatic_duct_life_cascade | hold_flash=1 | creed=life_force |"

CUBE a ROLE host PROTON 1
CUBE b ROLE construct PROTON 1
CUBE c ROLE nanobot PROTON 1
CUBE d ROLE recycle PROTON 1

PLUG a b
PLUG b c
PLUG c d
PLUG d a

IMPULSE a 1
ENERGYFLOW 3
FLOW 2

LET base_cubes = CUBES
SMX KEY

SMX EXCHANGE a ghost_x
ASSERT SMX_OK == 0 "cascade storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob counted"

SMX LIFE_FORCE a b c d
ASSERT SMX_LIFE_FORCE == 1 "lf"
SMX SINUSOID a b c d
ASSERT SMX_SINUSOID == 1 "sin"
SMX DISSE a b c d
ASSERT SMX_DISSE == 1 "disse"
SMX HEPATOCYTE a b c d
ASSERT SMX_HEPATOCYTE == 1 "hep"
SMX KUPFFER a b c d
ASSERT SMX_KUPFFER == 1 "kup"
SMX STELLATE a b c d
ASSERT SMX_STELLATE == 1 "stel"
ASSERT SMX_MESH_STELLATE == 1 "mesh_stel"
ASSERT SMX_ITO == 1 "ito"
ASSERT SMX_VITAMIN_A == 1 "vitA"
ASSERT SMX_FIBROGENIC == 1 "fibro"
ASSERT SMX_STELLATE_SUM == 14 "sum"
ASSERT SMX_OOB == 0 "oob clear"
SMX OVAL a b c d
ASSERT SMX_OVAL == 1 "oval"
ASSERT SMX_MESH_OVAL == 1 "mesh_oval"
ASSERT SMX_OOB == 0 "oob clear after oval"
SMX CANALICULUS a b c d
ASSERT SMX_CANALICULUS == 1 "canaliculus"
ASSERT SMX_MESH_CANALICULUS == 1 "mesh_canaliculus"
ASSERT SMX_BILE_CANALICULUS == 1 "bile_can"
ASSERT SMX_CANALICULAR == 1 "canalicular"
ASSERT SMX_BILE_CHANNEL == 1 "bile_ch"
ASSERT SMX_BILE_FLOW == 1 "bile_flow"
ASSERT SMX_CANALICULUS_SUM == 14 "sum"
ASSERT SMX_OOB == 0 "oob clear"
SMX DUCTULE a b c d
ASSERT SMX_DUCTULE == 1 "ductule"
ASSERT SMX_MESH_DUCTULE == 1 "mesh_ductule"
ASSERT SMX_BILE_DUCTULE == 1 "bile_ductule"
ASSERT SMX_CHOLANGIOLE == 1 "cholangiole"
ASSERT SMX_INTERLOBULAR == 1 "interlobular"
ASSERT SMX_CHOLANGIOCYTE == 1 "cholangiocyte"
ASSERT SMX_DUCTULE_SUM == 14 "sum"
ASSERT SMX_OOB == 0 "oob clear"
SMX HEPATIC_DUCT a b c d
ASSERT SMX_HEPATIC_DUCT == 1 "hepatic_duct"
ASSERT SMX_MESH_HEPATIC_DUCT == 1 "mesh_hepatic_duct"
ASSERT SMX_HEPATIC_BILE_DUCT == 1 "hepatic_bile_duct"
ASSERT SMX_HEPATIC_TRUNK == 1 "hepatic_trunk"
ASSERT SMX_COMMON_HEPATIC == 1 "common_hepatic"
ASSERT SMX_HEPATIC_CHOLANGIOCYTE == 1 "hepatic_cholangiocyte"
ASSERT SMX_HEPATIC_DUCT_SUM == 14 "sum"
ASSERT SMX_OOB == 0 "oob clear"
SMX STABILIZE a b c d
ASSERT SMX_STABLE == 1 "stable"
SMX WE_AUTOHEAL a b c d
ASSERT SMX_AUTOHEALED == 1 "heal"
ASSERT CUBES == base_cubes "no ghosts"

ASSERT OK == 1
PRINT "smx_mesh_hepatic_duct_life_cascade" SMX_OVAL SMX_CANALICULUS SMX_DUCTULE SMX_CHOLANGIOLE SMX_INTERLOBULAR SMX_STABLE SMX_AUTOHEALED SMX_OOB
PASS
