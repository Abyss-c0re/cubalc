# Proof 114 — digit-0 stack immediate bitwise dual forms: SANDN SORN SXORN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 0xFF
SANDN 0x0F
ASSERT LAST_N == 15
SORN 0xF0
ASSERT LAST_N == 255
SXORN 0x0F
ASSERT LAST_N == 240
POP a
ASSERT a == 240

CLEARSTACK
PUSH 0xAA
ANDN 0x0F
ASSERT LAST_N == 10
ORN 0x05
ASSERT LAST_N == 15
XORN 0x0A
ASSERT LAST_N == 5
POP b
ASSERT b == 5

# dual I-forms still live
CLEARSTACK
PUSH 0xF0
SANDI 0xFF
ASSERT LAST_N == 240
SORI 0x0F
ASSERT LAST_N == 255
SXORI 0xF0
ASSERT LAST_N == 15

# empty soft fail
CLEARSTACK
SANDN 1
ASSERT OK == 0
SORN 1
ASSERT OK == 0
SXORN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof114_sandn_sxorn" LAST_N SP
