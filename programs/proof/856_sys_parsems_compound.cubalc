# SYS PARSEMS compound durations — multi-unit 1h30m dual of HUMANMS
# Usability: config "1h30m" and HUMANMS round-trip without shell

HOLD_FLASH 1

# compound hour+minute
SYS PARSEMS "1h30m"
ASSERT OK == 1
ASSERT LAST_N == 5400000
ASSERT PARSEMS_SEGS == 2

# compound with spaces
SYS PARSEMS "1h 30m"
ASSERT OK == 1
ASSERT LAST_N == 5400000

# minute+second
SYS PARSEMS "2m15s"
ASSERT OK == 1
ASSERT LAST_N == 135000

# second+ms
SYS PARSEMS "1s250ms"
ASSERT OK == 1
ASSERT LAST_N == 1250
ASSERT PARSEMS_SEGS == 2

# day+hour
SYS PARSEMS "1d12h"
ASSERT OK == 1
ASSERT LAST_N == 129600000

# three segments
SYS PARSEMS "1h1m1s"
ASSERT OK == 1
ASSERT LAST_N == 3661000
ASSERT PARSEMS_SEGS == 3

# HUMANMS → PARSEMS round-trip
SYS HUMANMS 90000
SYS EQS LAST "1m30s"
ASSERT LAST_N == 1
SYS PARSEMS "1m30s"
ASSERT OK == 1
ASSERT LAST_N == 90000

SYS HUMANMS 3661000
SYS PARSEMS LAST
ASSERT OK == 1
ASSERT LAST_N == 3661000

SYS HUMANMS 1250
SYS PARSEMS LAST
ASSERT OK == 1
ASSERT LAST_N == 1250

# single still works
SYS PARSEMS "5s"
ASSERT LAST_N == 5000
ASSERT PARSEMS_SEGS == 1
SYS PARSEMS "500"
ASSERT LAST_N == 500

# soft fail
SYS PARSEMS "1h30x"
ASSERT OK == 0
SYS PARSEMS "1h30"
ASSERT OK == 0

# signed duration (leading - / +) — avoid strtoull wrap on "-"
SYS PARSEMS "-30s"
ASSERT OK == 1
ASSERT LAST_N == -30000
SYS PARSEMS "+1m30s"
ASSERT OK == 1
ASSERT LAST_N == 90000
SYS PARSEMS "-"
ASSERT OK == 0
# ADDISO string offset uses PARSEMS floor secs
SYS ADDISO "2020-01-01T01:00:00Z" "-30s"
ASSERT OK == 1
SYS EQS LAST "2020-01-01T00:59:30Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == -30
CLEAR_ERR

PRINT "sys_parsems_compound ok"
