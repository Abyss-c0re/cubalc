# Proof 385 — digit-3 imm inverted low-n mask TOC: SNANDMNTOCN SNORMNTOCN SXNORMNTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SNANDMNTOCN: ~(0b1101 & low-4) = ~13 = ~0xD → all bits flipped of 0..3 only wait:
# cells[1]=13=0b1101; low-4 mask=0xF; 13&0xF=13; ~13 = -14 (two's complement full width)
CELLSET 1 13
PUSH 1
SNANDMNTOCN 4
ASSERT LAST_N == -14
ASSERT CELL(1) == -14
POP a
ASSERT a == -14

# NANDMNTOCN n=0: ~(x & 0) = ~0 = -1
CELLSET 2 99
PUSH 2
NANDMNTOCN 0
ASSERT LAST_N == -1
ASSERT CELL(2) == -1
POP

# SNORMNTOCN: ~(0 | low-3) = ~7 = -8
CELLSET 3 0
PUSH 3
SNORMNTOCN 3
ASSERT LAST_N == -8
ASSERT CELL(3) == -8
POP

# NORMNTOCN: ~(8 | low-2) = ~(8|3)= ~11 = -12
CELLSET 4 8
PUSH 4
NORMNTOCN 2
ASSERT LAST_N == -12
ASSERT CELL(4) == -12
POP

# SXNORMNTOCN: ~(0 ^ low-4) = ~15 = -16; then ~( -16 ^ 15 ) restores 0 path check
CELLSET 5 0
PUSH 5
SXNORMNTOCN 4
ASSERT LAST_N == -16
ASSERT CELL(5) == -16
POP

# XNORMNTOCN: ~(15 ^ low-4=15) = ~0 = -1
CELLSET 6 15
PUSH 6
XNORMNTOCN 4
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# soft empty OK=0
CLEARSTACK
SNANDMNTOCN 3
ASSERT OK == 0

PRINT "385_snandmntocn_sxnormntocn OK"
