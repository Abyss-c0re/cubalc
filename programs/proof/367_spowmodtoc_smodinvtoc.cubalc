# Proof 367 — digit-2 stack↔cell modular inv/pow/div TOC: SPOWMODTOC SMODDIVTOC SMODINVTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOWMODTOC: 3^5 mod 13 = 9
CELLSET 1 3
PUSH 1
PUSH 5
PUSH 13
SPOWMODTOC
ASSERT LAST_N == 9
ASSERT CELL(1) == 9
POP a
ASSERT a == 9

# POWMODTOC: 2^10 mod 1000 = 24
CELLSET 2 2
PUSH 2
PUSH 10
PUSH 1000
POWMODTOC
ASSERT LAST_N == 24
ASSERT CELL(2) == 24
POP

# SEXPMMODTOC: 5^0 mod 7 = 1
CELLSET 3 5
PUSH 3
PUSH 0
PUSH 7
SEXPMMODTOC
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# soft m<=0 → 0
CELLSET 4 9
PUSH 4
PUSH 3
PUSH 0
SPOWMODTOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SMODDIVTOC: 10 * inv(3) mod 7 = 1
CELLSET 5 10
PUSH 5
PUSH 3
PUSH 7
SMODDIVTOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# MODDIVTOC: 1 * inv(2) mod 5 = 3
CELLSET 6 1
PUSH 6
PUSH 2
PUSH 5
MODDIVTOC
ASSERT LAST_N == 3
ASSERT CELL(6) == 3
POP

# no inverse → 0
CELLSET 7 1
PUSH 7
PUSH 2
PUSH 4
SMODDIVTOC
ASSERT LAST_N == 0
ASSERT CELL(7) == 0
POP

# SMODINVTOC: inv(3) mod 7 = 5
CELLSET 8 3
PUSH 8
PUSH 7
SMODINVTOC
ASSERT LAST_N == 5
ASSERT CELL(8) == 5
POP

# INVMODTOC: inv(2) mod 5 = 3
CELLSET 9 2
PUSH 9
PUSH 5
INVMODTOC
ASSERT LAST_N == 3
ASSERT CELL(9) == 3
POP

# no inverse m<=1 → 0
CELLSET 10 3
PUSH 10
PUSH 1
SMODINVTOC
ASSERT LAST_N == 0
ASSERT CELL(10) == 0
POP

# soft shallow stack OK=0
CLEARSTACK
PUSH 1
SPOWMODTOC
ASSERT OK == 0

PRINT "367_spowmodtoc_smodinvtoc OK"
