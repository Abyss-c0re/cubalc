# Proof 523 — digit-1 dual-stack imm 32-bit field div/mod/min: DDIV32N DMOD32N DMIN32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DDIV32N: 100/10 → 10 ; 50/10 → 5
PUSH 100
PUSH 50
DDIV32N 10 0
POP y
POP x
ASSERT x == 10
ASSERT y == 5

# floor: 23/5 → 4 ; 17/5 → 3
CLEARSTACK
PUSH 23
PUSH 17
PAIRDIV32N 5 0
POP y
POP x
ASSERT x == 4
ASSERT y == 3

# div by zero → 0
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x12345678
DDIV32N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved: low 0xC8 / 4 → 0x32
CLEARSTACK
PUSH 0x11223344000000C8
PUSH 0x99AABBCC000000C8
DDIV32N 4 0
POP y
POP x
ASSERT x == 0x1122334400000032
ASSERT y == 0x99AABBCC00000032

# S2DIV32N n1: high 0x64 / 10 → high 0xA
CLEARSTACK
PUSH 0x0000006400000000
PUSH 0x000000C800000000
S2DIV32N 10 1
POP y
POP x
ASSERT x == 0x0000000A00000000
ASSERT y == 0x0000001400000000

# DMOD32N: 23%5 → 3 ; 17%5 → 2
CLEARSTACK
PUSH 23
PUSH 17
DMOD32N 5 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# exact: 100%10 → 0
CLEARSTACK
PUSH 100
PUSH 100
PAIRMOD32N 10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mod by zero → 0
CLEARSTACK
PUSH 0xABCD1234
PUSH 0x11111111
DREM32N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# STACK2MOD32N n1
CLEARSTACK
PUSH 0x0000001700000000
PUSH 0x0000001B00000000
STACK2MOD32N 5 1
POP y
POP x
ASSERT x == 0x0000000300000000
ASSERT y == 0x0000000200000000

# DMIN32N: min(0xC0000000, 0x40000000) → 0x40000000
CLEARSTACK
PUSH 0xC0000000
PUSH 0xE0000000
DMIN32N 0x40000000 0
POP y
POP x
ASSERT x == 0x40000000
ASSERT y == 0x40000000

# keeps smaller
CLEARSTACK
PUSH 0x10
PUSH 0x20
PAIRMIN32N 0x90000000 0
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x20

# high preserved min
CLEARSTACK
PUSH 0x11223344FFFFFFFE
PUSH 0x99AABBCCFFFFFFFE
DMIN32N 0x20 0
POP y
POP x
ASSERT x == 0x1122334400000020
ASSERT y == 0x99AABBCC00000020

# STACK2MIN32N n1
CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x000000FF00000000
S2MIN32N 0x11 1
POP y
POP x
ASSERT x == 0x0000001100000000
ASSERT y == 0x0000001100000000

# DLE32N alias min equal
CLEARSTACK
PUSH 0x55555555
PUSH 0x55555555
DLE32N 0x55555555 0
POP y
POP x
ASSERT x == 0x55555555
ASSERT y == 0x55555555

# DQUO32N alias div
CLEARSTACK
PUSH 30
PUSH 24
DQUO32N 6 0
POP y
POP x
ASSERT x == 5
ASSERT y == 4

HOLD_FLASH 0
