# Proof 56 — digit-2 POW10 / TENPOW + stack SPOW10 (inverse of ILOG10)
HOLD_FLASH 1
SCIENCE LOAD

# expr POW10
ASSERT POW10(0) == 1
ASSERT POW10(1) == 10
ASSERT POW10(2) == 100
ASSERT POW10(3) == 1000
ASSERT POW10(6) == 1000000
ASSERT TENPOW(4) == 10000
ASSERT POW10(18) == 1000000000000000000
ASSERT POW10(-1) == 0
ASSERT POW10(19) == 0

# round-trip with ILOG10
ASSERT ILOG10(POW10(5)) == 5
ASSERT ILOG10(POW10(0)) == 0
ASSERT ILOG10(POW10(9) - 1) == 8
ASSERT ILOG10(POW10(9)) == 9

# stack SPOW10
CLEARSTACK
PUSH 0
SPOW10
ASSERT LAST_N == 1
CLEARSTACK
PUSH 3
SPOW10
ASSERT LAST_N == 1000
CLEARSTACK
PUSH 5
STENPOW
ASSERT LAST_N == 100000
CLEARSTACK
PUSH 2
STACKPOW10
ASSERT LAST_N == 100

# compose: pow10 then digsum / ilog
CLEARSTACK
PUSH 4
SPOW10
SILOG10
ASSERT LAST_N == 4
CLEARSTACK
PUSH 3
SPOW10
SNDIGITS
ASSERT LAST_N == 4

# underflow
CLEARSTACK
SPOW10
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof56_pow10" LAST_N SP
