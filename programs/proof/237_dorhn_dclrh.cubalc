# Proof 237 — digit-5 dual-stack high-plane or/xor/clear: DORHN DXORHN DCLRHN
HOLD_FLASH 1
SCIENCE LOAD

# DORHN — set high n bits
CLEARSTACK
PUSH 0
PUSH 1
DORHN 8
POP y
POP x
ASSERT x == 0xFF00000000000000
ASSERT y == 0xFF00000000000001

CLEARSTACK
PUSH 0x00FF
PUSH 0x0000
2ORHN 16
POP y
POP x
ASSERT x == 0xFFFF0000000000FF
ASSERT y == 0xFFFF000000000000

# DSETHN alias / n=0 noop
CLEARSTACK
PUSH 0x55
PUSH 0xAA
DSETHN 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0xAA

# n=64 all-ones
CLEARSTACK
PUSH 0
PUSH 0
DORHN 64
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DXORHN — toggle high n
CLEARSTACK
PUSH 0
PUSH -1
DXORHN 8
POP y
POP x
ASSERT x == 0xFF00000000000000
ASSERT y == 0x00FFFFFFFFFFFFFF

# double-toggle identity
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
DFLIPHN 12
POP y
POP x
CLEARSTACK
PUSH x
PUSH y
DXORHN 12
POP y2
POP x2
ASSERT x2 == 0x1234
ASSERT y2 == 0xABCD

# 2XORHN
CLEARSTACK
PUSH 0xFF00000000000000
PUSH 0
2XORHN 8
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFF00000000000000

# DCLRHN — clear high n
CLEARSTACK
PUSH -1
PUSH 0xFF000000000000FF
DCLRHN 8
POP y
POP x
ASSERT x == 0x00FFFFFFFFFFFFFF
ASSERT y == 0xFF

CLEARSTACK
PUSH 0xFFFF000000000000
PUSH 0x1234567890ABCDEF
2CLRHN 16
POP y
POP x
ASSERT x == 0
ASSERT y == 0x0000567890ABCDEF

# PAIRCLRHN / n=0
CLEARSTACK
PUSH 0x55
PUSH 0xAA
PAIRCLRHN 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0xAA

# n=64 → 0
CLEARSTACK
PUSH -1
PUSH 7
DCLRHN 64
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# round-trip: DORHN then DCLRHN
CLEARSTACK
PUSH 0x1000
PUSH 0x2000
DORHN 8
DCLRHN 8
POP y
POP x
ASSERT x == 0x1000
ASSERT y == 0x2000

# soft fails
CLEARSTACK
DORHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DXORHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DCLRHN 4
ASSERT OK == 0

HOLD_FLASH 1
