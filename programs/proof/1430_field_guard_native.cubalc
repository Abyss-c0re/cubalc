# field_guard via native HASCLASS/HASFIELD (no LISTFIELDS soup)

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  FIELD kind
END

CLASS Order
  FIELD n
END

DEFAULT NEED_FIELDS = ""
DEFAULT NEED_FIELD_ANY = ""
DEFAULT FIELD_GUARD_SOFT = 0
INCLUDE field_guard
ASSERT FIELD_GUARD_OK == 1
ASSERT FIELD_GUARD_ALL_OK == 1
ASSERT FIELD_GUARD_ANY_OK == 1

LET NEED_FIELDS = "Ticket.id\nTicket.kind\nOrder.n"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ALL_OK == 1
ASSERT FIELD_GUARD_OK == 1
ASSERT FLDHAVE_N >= 3
ASSERT FLDMISS_N == 0

LET NEED_FIELDS = "Ticket.id\nGhost.nope"
LET NEED_FIELD_ANY = ""
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ALL_OK == 0
ASSERT FIELD_GUARD_OK == 0
ASSERT FLDMISS_N >= 1
SYS HASI FLDMISS "Ghost.nope"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_FIELDS = ""
LET NEED_FIELD_ANY = "Ghost.nope\nOrder.n"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ANY_OK == 1
ASSERT FIELD_GUARD_OK == 1
SYS HASI FLDHAVE "Order.n"
ASSERT LAST_N == 1

LET NEED_FIELD_ANY = "Ghost.a\nGhost.b"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ANY_OK == 0
ASSERT FIELD_GUARD_OK == 0
CLEAR_ERR

HASFIELD Ticket id
ASSERT LAST_N == 1
HASFIELDS Ticket id kind
ASSERT LAST_N == 1
HASFIELDANY Ticket nope kind
ASSERT LAST_N == 1

PRINT "1430_field_guard_native ok"
PASS
