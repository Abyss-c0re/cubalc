# Proof 331 — digit-9 depth-9 combinators: 9NIP 9ROT 9RROT
HOLD_FLASH 1
SCIENCE LOAD

# 9NIP — keep ends
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
9NIP
ASSERT SP == 2
POP h
POP a
ASSERT a == 1
ASSERT h == 9

# NIP9 alias
CLEARSTACK
PUSH 10
PUSH 11
PUSH 12
PUSH 13
PUSH 14
PUSH 15
PUSH 16
PUSH 17
PUSH 18
NIP9
ASSERT SP == 2
POP x
ASSERT x == 18

# 9ROT: 1..9 → 2..9 1
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
9ROT
POP i
POP h
POP g
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 2
ASSERT b == 3
ASSERT c == 4
ASSERT d == 5
ASSERT e == 6
ASSERT f == 7
ASSERT g == 8
ASSERT h == 9
ASSERT i == 1

# ROT9 alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
ROT9
POP x
ASSERT x == 1

# 9RROT: 1..9 → 9 1..8
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
9RROT
POP i
POP h
POP g
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 9
ASSERT b == 1
ASSERT c == 2
ASSERT d == 3
ASSERT e == 4
ASSERT f == 5
ASSERT g == 6
ASSERT h == 7
ASSERT i == 8

# RROT9 alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
RROT9
POP x
ASSERT x == 8

# soft fails
CLEARSTACK
9NIP
ASSERT OK == 0
9ROT
ASSERT OK == 0
9RROT
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof331_9nip_9rot" LAST_N SP
HOLD_FLASH 1
