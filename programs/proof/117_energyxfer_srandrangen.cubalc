# Proof 117 — digit-6 energy xfer/clamp + stack-imm range RNG
HOLD_FLASH 1
SCIENCE LOAD

# SRANDRANGEN deterministic
SEED 42
CLEARSTACK
SRANDRANGEN 10 20
ASSERT LAST_N >= 10
ASSERT LAST_N <= 20
ASSERT SP == 1
LET a = LAST_N
SEED 42
CLEARSTACK
RANDRANGEN 10 20
ASSERT LAST_N == a

# alias SRNGX + swap bounds
SEED 7
CLEARSTACK
SRNGX 50 40
ASSERT LAST_N >= 40
ASSERT LAST_N <= 50

# ENERGYXFER src→dst
CUBE a ROLE core PROTON 1
CUBE b ROLE core PROTON 1
ENERGYSET a 80
ENERGYSET b 10
ENERGYXFER a b 30
ASSERT ENERGY(a) == 50
ASSERT ENERGY(b) == 40
# LAST_N = moved amount
ASSERT LAST_N == 30

# cannot over-drain source
ENERGYSET a 10
ENERGYSET b 0
SENRX a b 50
ASSERT ENERGY(a) == 0
ASSERT ENERGY(b) == 10
ASSERT LAST_N == 10

# ENERGYCLAMP
ENERGYSET a 90
ENERGYCLAMP a 20 60
ASSERT ENERGY(a) == 60
CLAMPENERGY a 0 30
ASSERT ENERGY(a) == 30
ENERGYSET a 5
SFLWX a 10 80
ASSERT ENERGY(a) == 10

# soft stack full not tested; flow still ok
CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof117_energyxfer_srandrangen" LAST_N SP
