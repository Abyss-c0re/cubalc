# Proof 129 — digit-9 cell-fold duals: SSCANCELL SDIFFCELL SSHIFTCELL SCLAMPCELL DIFFCELL
HOLD_FLASH 1
SCIENCE LOAD

# DIFFCELL stmt — inverse of SCANCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CELLSET 3 4
SCANCELL 0 3
ASSERT CELL(0) == 1
ASSERT CELL(1) == 3
ASSERT CELL(2) == 6
ASSERT CELL(3) == 10
DIFFCELL 0 3
ASSERT CELL(0) == 1
ASSERT CELL(1) == 2
ASSERT CELL(2) == 3
ASSERT CELL(3) == 4

# SSCANCELL stack dual
CLEARCELLS
CELLSET 0 5
CELLSET 1 5
CELLSET 2 5
CLEARSTACK
PUSH 0
PUSH 2
SSCANCELL
ASSERT LAST_N == 15
ASSERT SP == 0
ASSERT CELL(0) == 5
ASSERT CELL(1) == 10
ASSERT CELL(2) == 15

# SDIFFCELL restores
CLEARSTACK
PUSH 0
PUSH 2
SDIFFCELL
ASSERT CELL(0) == 5
ASSERT CELL(1) == 5
ASSERT CELL(2) == 5

# SSHIFTCELL left by 1: 1 2 3 4 → 2 3 4 0
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CELLSET 3 4
CLEARSTACK
PUSH 0
PUSH 3
PUSH 1
SSHIFTCELL
ASSERT LAST_N == 4
ASSERT CELL(0) == 2
ASSERT CELL(1) == 3
ASSERT CELL(2) == 4
ASSERT CELL(3) == 0

# right shift by 1: 2 3 4 0 → 0 2 3 4
CLEARSTACK
PUSH 0
PUSH 3
PUSH -1
SCELLSHIFT
ASSERT CELL(0) == 0
ASSERT CELL(1) == 2
ASSERT CELL(2) == 3
ASSERT CELL(3) == 4

# SCLAMPCELL
CLEARCELLS
CELLSET 0 -5
CELLSET 1 3
CELLSET 2 99
CLEARSTACK
PUSH 0
PUSH 2
PUSH 0
PUSH 10
SCLAMPCELL
ASSERT LAST_N == 3
ASSERT CELL(0) == 0
ASSERT CELL(1) == 3
ASSERT CELL(2) == 10

# soft fails
CLEARSTACK
SSCANCELL
ASSERT OK == 0
SDIFFCELL
ASSERT OK == 0
SSHIFTCELL
ASSERT OK == 0
SCLAMPCELL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof129_sscan_sdiff" LAST_N SP
