PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
9TUCK
ASSERT SP == 10
POP t
POP i
POP h
POP g
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 9
ASSERT b == 1
ASSERT c == 2
ASSERT d == 3
ASSERT e == 4
ASSERT f == 5
ASSERT g == 6
ASSERT h == 7
ASSERT i == 8
ASSERT t == 9

