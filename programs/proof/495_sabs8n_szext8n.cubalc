# Proof 495 — digit-5 stack imm 8-bit field abs+extend: SABS8N SSEXT8N SZEXT8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SABS8N: 0xFE (-2)→2 ; 0x05→5
PUSH 0xFE
SABS8N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x05
ABS8N 0
POP x
ASSERT x == 5

# min int8 -128 stays 0x80
CLEARSTACK
PUSH 0x80
SABS8N 0
POP x
ASSERT x == 128

# high preserved abs
CLEARSTACK
PUSH 0x11223344556677FE
SABS8N 0
POP x
ASSERT x == 0x1122334455667702

# STACKABS8N n1: 0xD000 byte1=D0=-48 → abs 48 → 0x3000
CLEARSTACK
PUSH 0xD000
STACKABS8N 1
POP x
ASSERT x == 0x3000

# SSEXT8N: 0x7F→127 ; 0xFE→-2 ; 0x80→-128
CLEARSTACK
PUSH 0x7F
SSEXT8N 0
POP x
ASSERT x == 127

CLEARSTACK
PUSH 0xFE
SSEXT8N 0
POP x
ASSERT x == -2

CLEARSTACK
PUSH 0x80
SEXT8N 0
POP x
ASSERT x == -128

# STACKSEXT8N n1: 0xA000 byte1=A0=-96
CLEARSTACK
PUSH 0xA000
STACKSEXT8N 1
POP x
ASSERT x == -96

# high ignored: 0x1FF → -1
CLEARSTACK
PUSH 0x1FF
SSEXT8N 0
POP x
ASSERT x == -1

# SZEXT8N: extract byte
CLEARSTACK
PUSH 0xABCD
SZEXT8N 0
POP x
ASSERT x == 0xCD

CLEARSTACK
PUSH 0xABCD
STACKZEXT8N 1
POP x
ASSERT x == 0xAB

# STACKZEXT8N n2 of 0x123456: byte2=0x12
CLEARSTACK
PUSH 0x123456
ZEXT8N 2
POP x
ASSERT x == 0x12

# aliases
CLEARSTACK
PUSH 0xFC
SIABS8N 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0xFC
SBYTESEXTN 0
POP x
ASSERT x == -4

CLEARSTACK
PUSH 0xFF00
SBYTEZEXTN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x00FF
SBYTEZEXTN 0
POP x
ASSERT x == 255

# nibble of higher byte via SABSBYTEN n3
CLEARSTACK
PUSH 0xFE000000
SABSBYTEN 3
POP x
ASSERT x == 0x02000000

HOLD_FLASH 0
