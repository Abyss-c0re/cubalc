# Proof 115 — digit-6 energy/flow/RNG dual: SRANDN ENERGYSUB SEFLOW
HOLD_FLASH 1
SCIENCE LOAD

# SRANDN — deterministic range with SEED
SEED 42
CLEARSTACK
SRANDN 10
ASSERT LAST_N >= 0
ASSERT LAST_N < 10
ASSERT SP == 1
LET a = LAST_N
SEED 42
CLEARSTACK
RANDN 10
ASSERT LAST_N == a

# alias SRNGN + replay
SEED 7
CLEARSTACK
SRNGN 100
LET b = LAST_N
SEED 7
CLEARSTACK
SRANDIMM 100
ASSERT LAST_N == b
ASSERT LAST_N >= 0
ASSERT LAST_N < 100

# SRANDN n<=0 falls back to range 10
SEED 3
CLEARSTACK
SRANDN 0
ASSERT LAST_N >= 0
ASSERT LAST_N < 10

# ENERGYSUB / DRAIN complete set/add/sub
CUBE e ROLE core PROTON 1
ENERGYSET e 80
ASSERT ENERGY(e) == 80
ENERGYSUB e 30
ASSERT ENERGY(e) == 50
DRAIN e 60
ASSERT ENERGY(e) == 0
ENERGYADD e 40
SENRN e 15
ASSERT ENERGY(e) == 25
SUBENERGY e 25
ASSERT ENERGY(e) == 0

# SEFLOWN / SFLWN immediate hops
CUBE f ROLE matrix PROTON 1
ENERGYSET f 10
SEFLOWN 2
ASSERT ENERGY >= 0
ASSERT OK == 1
SFLWN 1
ASSERT OK == 1

# SEFLOW stack form
CLEARSTACK
PUSH 2
SEFLOW
ASSERT OK == 1
ASSERT ENERGY >= 0

# soft fail empty stack
CLEARSTACK
SEFLOW
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof115_srandn_energysub" LAST_N SP
