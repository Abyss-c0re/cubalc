# Proof 2417 — MULTIFILE_EXTEND_NTHSIBLING_FIRSTLAST_LINK3
# Multi-file CLASS EXTEND + NTHSIBLING + FIRSTSIBLING/LASTSIBLING.
# Complements SIBLINGS bag + NTHCHILD + NTHPARENT.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

CLASS DeepLeaf EXTEND SoftTag
  FIELD deep 1
  METHOD z
    RET 1
  END
END
HASCLASS DeepLeaf
ASSERT LAST_N == 1

CLASS TwinDeep EXTEND SoftTag
  FIELD td 1
  METHOD z
    RET 2
  END
END
HASCLASS TwinDeep
ASSERT LAST_N == 1

SIBLINGS TagGreeter
ASSERT OK == 1
ASSERT SIBLINGS_N >= 1

SIBLINGS TwinGreet
ASSERT SIBLINGS_N >= 1

SIBLINGS LoudTag
ASSERT SIBLINGS_N >= 1

SIBLINGS SoftTag
ASSERT SIBLINGS_N >= 1

SIBLINGS DeepLeaf
ASSERT SIBLINGS_N == 1

SIBLINGS Solo
ASSERT SIBLINGS_N == 0

SIBLINGS Greeter
ASSERT SIBLINGS_N == 0

FIRSTSIBLING TagGreeter
ASSERT OK == 1
ASSERT FIRSTSIBLING_N == 1
ASSERT LAST_N == 1

LASTSIBLING TagGreeter
ASSERT OK == 1
ASSERT LASTSIBLING_N == 1
ASSERT LAST_N == 1

FIRSTSIBLING TwinGreet
ASSERT FIRSTSIBLING_N == 1

LASTSIBLING TwinGreet
ASSERT LASTSIBLING_N == 1

FIRSTSIBLING LoudTag
ASSERT FIRSTSIBLING_N == 1

LASTSIBLING LoudTag
ASSERT LASTSIBLING_N == 1

FIRSTSIBLING SoftTag
ASSERT FIRSTSIBLING_N == 1

LASTSIBLING SoftTag
ASSERT LASTSIBLING_N == 1

FIRSTSIBLING DeepLeaf
ASSERT OK == 1
ASSERT FIRSTSIBLING_N == 1
ASSERT LAST == "TwinDeep"

LASTSIBLING DeepLeaf
ASSERT LASTSIBLING_N == 1
ASSERT LAST == "TwinDeep"

FIRSTSIBLING TwinDeep
ASSERT LAST == "DeepLeaf"
ASSERT FIRSTSIBLING_N == 1

LASTSIBLING TwinDeep
ASSERT LAST == "DeepLeaf"

FIRSTSIBLING Greeter
ASSERT OK == 1
ASSERT FIRSTSIBLING_N == 0
ASSERT LAST_N == 0

LASTSIBLING Solo
ASSERT LASTSIBLING_N == 0

NTHSIBLING DeepLeaf 0
ASSERT OK == 1
ASSERT NTHSIBLING_N == 1
ASSERT LAST == "TwinDeep"

NTHSIBLING TwinDeep 0
ASSERT NTHSIBLING_N == 1
ASSERT LAST == "DeepLeaf"

NTHSIBLING DeepLeaf 1
ASSERT OK == 1
ASSERT NTHSIBLING_N == 0
ASSERT LAST_N == 0

NTHSIBLING DeepLeaf 9
ASSERT NTHSIBLING_N == 0

NTHSIBLING TagGreeter 0
ASSERT NTHSIBLING_N == 1

NTHSIBLING TwinGreet 0
ASSERT NTHSIBLING_N == 1

NTHSIBLING LoudTag 0
ASSERT NTHSIBLING_N == 1

NTHSIBLING SoftTag 0
ASSERT NTHSIBLING_N == 1

NTHSIBLING Solo 0
ASSERT NTHSIBLING_N == 0

NTHSIBLING Greeter 0
ASSERT NTHSIBLING_N == 0

SIBLINGAT DeepLeaf 0
ASSERT NTHSIBLING_N == 1
ASSERT LAST == "TwinDeep"

SIBLINGS DeepLeaf
ASSERT SIBLINGS_N == 1
NTHSIBLING DeepLeaf 0
ASSERT NTHSIBLING_N == 1

SIBLINGS SoftTag
NTHSIBLING SoftTag 0
ASSERT NTHSIBLING_N == 1

PRINT "MI2417_NTHSIBLING_FIRSTLAST_PASS"
