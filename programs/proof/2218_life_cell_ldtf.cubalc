SEND gate murg 2
ASSERT LAST_N == 2 "gate murg2"
SEND gate murj 2
ASSERT LAST_N == 2 "gate murj2"
SEND gate photosynth 40
SEND gate glycolyse 36
SEND gate charge 40
SEND gate feed 36
GETF gate heat
LET h1u = LAST_N
GETF gate energy
LET e1u = LAST_N
GETF gate atp
LET a1u = LAST_N
SEND gate ldtf 2
ASSERT LAST_N == 2 "gate ldtf2"
GETF gate heat
ASSERT LAST_N == h1u + 2 "h1u+2"
GETF gate energy
ASSERT LAST_N == e1u - 2 "e1u-2"
GETF gate atp
ASSERT LAST_N == a1u - 2 "a1u-2"
