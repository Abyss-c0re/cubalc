SEND starved mray 4
ASSERT LAST_N == 4 "pre starved mray"
SEND starved photosynth 24
SEND starved glycolyse 20
SEND starved charge 30
SEND starved feed 20
GETF starved energy
LET se = LAST_N
GETF starved atp
LET sa = LAST_N
SEND starved murg 100
LET took = LAST_N
ASSERT took >= 1 "starved murg took"
GETF starved atp
ASSERT LAST_N == sa - took "starved atp dec"
GETF starved energy
ASSERT LAST_N == se - took "starved e dec"
SEND starved photosynth 24
SEND starved glycolyse 20
SEND starved charge 30
SEND starved feed 20
GETF starved energy
LET se2 = LAST_N
GETF starved atp
LET sa2 = LAST_N
SEND starved murj 100
LET tookj = LAST_N
ASSERT tookj >= 1 "starved murj took"
ASSERT tookj <= 100 "starved murj cap"
GETF starved atp
ASSERT LAST_N == sa2 - tookj "starved atp dec2"
GETF starved energy
ASSERT LAST_N == se2 - tookj "starved e dec2"
SEND starved photosynth 40
SEND starved glycolyse 36
SEND starved charge 40
SEND starved feed 36
GETF starved energy
LET se3 = LAST_N
GETF starved atp
LET sa3 = LAST_N
SEND starved ldtf 100
LET tooku = LAST_N
ASSERT tooku >= 1 "starved ldtf took"
ASSERT tooku <= 100 "starved ldtf cap"
GETF starved atp
ASSERT LAST_N == sa3 - tooku "starved atp dec3"
GETF starved energy
ASSERT LAST_N == se3 - tooku "starved e dec3"
