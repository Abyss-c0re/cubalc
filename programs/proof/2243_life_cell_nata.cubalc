REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_NATA — NatA N-terminal acetyltransferase after MAP
# Continuum ...->pepf->pdf->map->nata
# Gift: acetyl-CoA seals mature N-termini once MAP frees initiator Met.
# Cube is SoT. Free energy must flow.

ENTITY founder OF Cell 1 44 0
ENTITY quiet OF Cell 1 28 0
ENTITY corpse OF Cell 0 18 0
ENTITY empty OF Cell 1 0 0
ENTITY bed OF Cell 1 52 0

SEND founder set_threshold 10
SEND quiet set_threshold 12
SEND bed set_threshold 8
SEND empty set_threshold 10

SEND founder pulse 5
SEND founder photosynth 42
SEND founder glycolyse 34
SEND founder pump 26
SEND founder photophos 24
SEND founder charge 38
SEND founder feed 36
GETF founder age
ASSERT LAST_N == 5 "founder age5"
GETF founder atp
ASSERT LAST_N >= 18 "founder atp"
GETF founder energy
ASSERT LAST_N >= 18 "founder energy"
GETF founder pmf
ASSERT LAST_N >= 4 "founder pmf"

SEND founder pepf 3
ASSERT LAST_N == 3 "pre pepf"
SEND founder photosynth 22
SEND founder glycolyse 18
SEND founder charge 26
SEND founder feed 18
SEND founder pdf 3
ASSERT LAST_N == 3 "pre pdf"
SEND founder photosynth 22
SEND founder glycolyse 18
SEND founder charge 26
SEND founder feed 18
SEND founder map 3
ASSERT LAST_N == 3 "pre map"
SEND founder photosynth 22
SEND founder glycolyse 18
SEND founder charge 28
SEND founder feed 20

GETF founder heat
LET h0 = LAST_N
GETF founder energy
LET e0 = LAST_N
GETF founder atp
LET a0 = LAST_N
GETF founder age
LET age0 = LAST_N
GETF founder pcr
LET pcr0 = LAST_N
GETF founder reserve
LET rsv0 = LAST_N
GETF founder pmf
LET pmf0 = LAST_N
GETF founder threshold
LET thr0 = LAST_N

SEND founder nata 4
ASSERT LAST_N == 4 "nata take4"
GETF founder heat
ASSERT LAST_N == h0 + 4 "nata heat+4"
GETF founder energy
ASSERT LAST_N == e0 - 4 "nata energy-4"
GETF founder atp
ASSERT LAST_N == a0 - 4 "nata atp-4"
GETF founder age
ASSERT LAST_N == age0 "nata age held"
GETF founder pcr
ASSERT LAST_N == pcr0 "nata pcr held"
GETF founder reserve
ASSERT LAST_N == rsv0 "nata reserve held"
GETF founder pmf
ASSERT LAST_N == pmf0 "nata pmf held"
GETF founder threshold
ASSERT LAST_N == thr0 "nata thr held"

SEND corpse nata 3
ASSERT LAST_N == 0 "dead nata0"
SEND empty nata 2
ASSERT LAST_N == 0 "empty nata0"

SEND quiet pulse 4
SEND quiet photosynth 36
SEND quiet glycolyse 30
SEND quiet charge 32
SEND quiet feed 28
SEND quiet map 2
ASSERT LAST_N == 2 "quiet pre map"
SEND quiet photosynth 20
SEND quiet charge 24
SEND quiet feed 16
GETF quiet heat
LET qh = LAST_N
GETF quiet energy
LET qe = LAST_N
GETF quiet atp
LET qa = LAST_N
SEND quiet nata 3
ASSERT LAST_N == 3 "quiet nata3"
GETF quiet heat
ASSERT LAST_N == qh + 3 "quiet h+3"
GETF quiet energy
ASSERT LAST_N == qe - 3 "quiet e-3"
GETF quiet atp
ASSERT LAST_N == qa - 3 "quiet a-3"

SEND bed pulse 6
SEND bed photosynth 44
SEND bed glycolyse 36
SEND bed pump 24
SEND bed charge 40
SEND bed feed 36
SEND bed pdf 2
ASSERT LAST_N == 2 "bed pdf"
SEND bed photosynth 20
SEND bed charge 24
SEND bed feed 18
SEND bed map 2
ASSERT LAST_N == 2 "bed map"
SEND bed photosynth 20
SEND bed charge 24
SEND bed feed 18
GETF bed heat
LET bh = LAST_N
GETF bed energy
LET be = LAST_N
GETF bed atp
LET ba = LAST_N
SEND bed nata 5
ASSERT LAST_N == 5 "bed nata5"
GETF bed heat
ASSERT LAST_N == bh + 5 "bed h+5"
GETF bed energy
ASSERT LAST_N == be - 5 "bed e-5"
GETF bed atp
ASSERT LAST_N == ba - 5 "bed a-5"
GETF bed energy
LET e_fin = LAST_N
GETF bed threshold
LET thr_fin = LAST_N
GETF bed ready
LET rd = LAST_N
IF e_fin >= thr_fin THEN
  ASSERT rd == 1 "bed ready when e>=thr"
END
IF e_fin < thr_fin THEN
  ASSERT rd == 0 "bed unready when e<thr"
END

SEND founder photosynth 16
SEND founder charge 12
SEND founder feed 10
GETF founder atp
LET sa = LAST_N
GETF founder energy
LET se = LAST_N
IF sa > 3 THEN
  SEND founder nata 2
  ASSERT LAST_N == 2 "drain nata2"
END
GETF founder atp
LET sa2 = LAST_N
GETF founder energy
LET se2 = LAST_N
LET ask = sa2 + se2 + 5
SEND founder nata ask
GETF founder atp
LET sa3 = LAST_N
GETF founder energy
LET se3 = LAST_N
ASSERT sa3 >= 0 "starved atp floor"
ASSERT se3 >= 0 "starved energy floor"

GETF founder alive
ASSERT LAST_N == 1 "founder alive final"
GETF bed alive
ASSERT LAST_N == 1 "bed alive final"

SEND founder photosynth 28
SEND founder glycolyse 22
SEND founder charge 30
SEND founder feed 24
SEND founder map 2
ASSERT LAST_N == 2 "re map"
GETF founder heat
LET rh = LAST_N
GETF founder energy
LET re = LAST_N
GETF founder atp
LET ra = LAST_N
SEND founder nata 2
ASSERT LAST_N == 2 "re nata"
GETF founder heat
ASSERT LAST_N == rh + 2 "re h+2"
GETF founder energy
ASSERT LAST_N == re - 2 "re e-2"
GETF founder atp
ASSERT LAST_N == ra - 2 "re a-2"
