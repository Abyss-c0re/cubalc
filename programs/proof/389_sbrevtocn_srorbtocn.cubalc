# Proof 389 — digit-3 imm low-n reverse/rotate TOC: SBREVTOCN SROLBTOCN SRORBTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SBREVTOCN: reverse low-4 of 0b1101=13 → 0b1011=11
CELLSET 1 13
PUSH 1
SBREVTOCN 4
ASSERT LAST_N == 11
ASSERT CELL(1) == 11
POP a
ASSERT a == 11

# BREVTOCN n=0: no-op leave 7
CELLSET 2 7
PUSH 2
BREVTOCN 0
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SROLBTOCN: rotl-1 low-4 of 0b1001=9 → 0b0011=3
CELLSET 3 9
PUSH 3
SROLBTOCN 4
ASSERT LAST_N == 3
ASSERT CELL(3) == 3
POP

# ROLBTOCN n=1: width 1 is no-op (n < 2)
CELLSET 4 5
PUSH 4
ROLBTOCN 1
ASSERT LAST_N == 5
ASSERT CELL(4) == 5
POP

# SRORBTOCN: rotr-1 low-4 of 0b1001=9 → 0b1100=12
CELLSET 5 9
PUSH 5
SRORBTOCN 4
ASSERT LAST_N == 12
ASSERT CELL(5) == 12
POP

# RORBTOCN high kept: 0x10|0x9=25, rotr low-4 → 0x10|12=28
CELLSET 6 25
PUSH 6
RORBTOCN 4
ASSERT LAST_N == 28
ASSERT CELL(6) == 28
POP

# soft empty OK=0
CLEARSTACK
SBREVTOCN 3
ASSERT OK == 0

PRINT "389_sbrevtocn_srorbtocn OK"
