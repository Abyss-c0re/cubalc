# Proof 341 — digit-3 imm compare TOC: SEQTOCN SNETOCN SLTTOCN SGTTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SEQTOCN equal
CELLSET 1 42
PUSH 1
SEQTOCN 42
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# EQTOCN unequal
CELLSET 2 5
PUSH 2
EQTOCN 6
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SNETOCN true
CELLSET 3 7
PUSH 3
SNETOCN 8
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# NETOCN equal → 0
CELLSET 4 9
PUSH 4
NETOCN 9
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SLTTOCN true
CELLSET 5 3
PUSH 5
SLTTOCN 10
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# LTTOCN false
CELLSET 6 10
PUSH 6
LTTOCN 3
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SGTTOCN true
CELLSET 7 9
PUSH 7
SGTTOCN 2
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# GTTOCN false
CELLSET 8 2
PUSH 8
GTTOCN 9
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# negative imm via parens
PUSH 9
PUSH (-5)
SSETCELL
POP
PUSH 9
SLTTOCN 0
ASSERT LAST_N == 1
ASSERT CELL(9) == 1
POP

# soft fails
CLEARSTACK
SEQTOCN 1
ASSERT OK == 0
SNETOCN 1
ASSERT OK == 0
SLTTOCN 1
ASSERT OK == 0
SGTTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof341_seqtocn_sgttocn" LAST_N SP
HOLD_FLASH 1
