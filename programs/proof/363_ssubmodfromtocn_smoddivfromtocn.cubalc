# Proof 363 — digit-3 reverse imm modular TOC: SSUBMODFROMTOCN SPOWMODFROMTOCN SMODDIVFROMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSUBMODFROMTOCN: (10-3) mod 12 = 7
CELLSET 1 3
PUSH 1
SSUBMODFROMTOCN 10 12
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP a
ASSERT a == 7

# RSUBMODTOCN: (3-5) mod 12 = 10
CELLSET 2 5
PUSH 2
RSUBMODTOCN 3 12
ASSERT LAST_N == 10
ASSERT CELL(2) == 10
POP

# soft m<=0 → 0
CELLSET 3 9
PUSH 3
SSUBMODFROMTOCN 1 0
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SPOWMODFROMTOCN: 2^10 mod 1000 = 24
CELLSET 4 10
PUSH 4
SPOWMODFROMTOCN 2 1000
ASSERT LAST_N == 24
ASSERT CELL(4) == 24
POP

# RPOWMODTOCN: 3^5 mod 13 = 9
CELLSET 5 5
PUSH 5
RPOWMODTOCN 3 13
ASSERT LAST_N == 9
ASSERT CELL(5) == 9
POP

# SBASEPOWMODTOCN: 5^0 mod 7 = 1
CELLSET 6 0
PUSH 6
SBASEPOWMODTOCN 5 7
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# SMODDIVFROMTOCN: 10 * inv(3) mod 7 = 1
CELLSET 7 3
PUSH 7
SMODDIVFROMTOCN 10 7
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# RMODDIVTOCN: 1 * inv(2) mod 5 = 3
CELLSET 8 2
PUSH 8
RMODDIVTOCN 1 5
ASSERT LAST_N == 3
ASSERT CELL(8) == 3
POP

# no inverse → 0
CELLSET 9 2
PUSH 9
SMODDIVFROMTOCN 1 4
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft empty OK=0
CLEARSTACK
SSUBMODFROMTOCN 1 5
ASSERT OK == 0

PRINT "363_ssubmodfromtocn_smoddivfromtocn OK"
