# Proof 484 — digit-9 dual-stack imm 4-bit field max+eq: DMAX4N DEQ4N DNE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DMAX4N
PUSH 0x2
PUSH 0xC
DMAX4N 0x5 0
POP y
POP x
ASSERT x == 0x5
ASSERT y == 0xC

# keeps larger
CLEARSTACK
PUSH 0xE
PUSH 0xD
PAIRMAX4N 0x3 0
POP y
POP x
ASSERT x == 0xE
ASSERT y == 0xD

# high preserved max
CLEARSTACK
PUSH 0x1122334455667703
PUSH 0x99AABBCCDDEEFF02
DMAX4N 0x8 0
POP y
POP x
ASSERT x == 0x1122334455667708
ASSERT y == 0x99AABBCCDDEEFF08

# S2MAX4N n1
CLEARSTACK
PUSH 0x20
PUSH 0x10
S2MAX4N 0x9 1
POP y
POP x
ASSERT x == 0x90
ASSERT y == 0x90

# DGE4N alias
CLEARSTACK
PUSH 0x5
PUSH 0x5
DGE4N 0x5 0
POP y
POP x
ASSERT x == 0x5
ASSERT y == 0x5

# DEQ4N equal → 1
CLEARSTACK
PUSH 0xA
PUSH 0xA
DEQ4N 0xA 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# mixed eq
CLEARSTACK
PUSH 0xA
PUSH 0xB
PAIREQ4N 0xA 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# high preserved eq
CLEARSTACK
PUSH 0x1122334455667707
PUSH 0x99AABBCCDDEEFF07
DEQ4N 0x7 0
POP y
POP x
ASSERT x == 0x1122334455667701
ASSERT y == 0x99AABBCCDDEEFF01

# STACK2EQ4N n1
CLEARSTACK
PUSH 0x70
PUSH 0x80
STACK2EQ4N 0x7 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x00

# DNE4N
CLEARSTACK
PUSH 0x1
PUSH 0x2
DNE4N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# equal → 0 both
CLEARSTACK
PUSH 0x1
PUSH 0x1
PAIRNE4N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved ne
CLEARSTACK
PUSH 0x112233445566770F
PUSH 0x99AABBCCDDEEFF00
DNE4N 0 0
POP y
POP x
ASSERT x == 0x1122334455667701
ASSERT y == 0x99AABBCCDDEEFF00

# S2NE4N n1
CLEARSTACK
PUSH 0x50
PUSH 0x60
S2NE4N 0x5 1
POP y
POP x
ASSERT x == 0x00
ASSERT y == 0x10

# DCMPEQ4N / DCMPNE4N
CLEARSTACK
PUSH 0xF
PUSH 0x0
DCMPEQ4N 0xF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x1
DCMPNE4N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

HOLD_FLASH 0
