# Proof 166 — digit-8 dual-stack word pack: DLO32 DHI32 DPACK32
HOLD_FLASH 1
SCIENCE LOAD

# DLO32
CLEARSTACK
PUSH 0x123456789ABCDEF0
PUSH 0xABCD
DLO32
POP y
POP x
ASSERT x == 0x9ABCDEF0
ASSERT y == 0xABCD

CLEARSTACK
PUSH 4294967296
PUSH -1
2LO32
POP y
POP x
ASSERT x == 0
ASSERT y == 4294967295

# DHI32
CLEARSTACK
PUSH 0x123456789ABCDEF0
PUSH 0xABCDEF0100000000
DHI32
POP y
POP x
ASSERT x == 0x12345678
ASSERT y == 0xABCDEF01

CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x00000000FFFFFFFF
2HI32
POP y
POP x
ASSERT x == 0xFFFFFFFF
ASSERT y == 0

# DPACK32 — a b c d → (a<<32|c) (b<<32|d)
CLEARSTACK
PUSH 0x12345678
PUSH 0xABCDEF01
PUSH 0x9ABCDEF0
PUSH 0x11223344
DPACK32
POP y
POP x
ASSERT x == 0x123456789ABCDEF0
ASSERT y == 0xABCDEF0111223344

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2PACK32
POP y
POP x
ASSERT x == 0x0000000100000003
ASSERT y == 0x0000000200000004

# round-trip
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DHI32
POP hb
POP ha
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DLO32
POP lb
POP la
CLEARSTACK
PUSH ha
PUSH hb
PUSH la
PUSH lb
DPACK32
POP y
POP x
ASSERT x == 0x1122334455667788
ASSERT y == 0x99AABBCCDDEEFF00

# aliases
CLEARSTACK
PUSH 0x0F0F0F0F12345678
PUSH 0xF0F0F0F0ABCDEF01
PAIRLO32
POP y
POP x
ASSERT x == 0x12345678
ASSERT y == 0xABCDEF01

CLEARSTACK
PUSH 0x0A0B0C0D
PUSH 0x0E0F1011
PUSH 0x12131415
PUSH 0x16171819
PAIRPACK32
POP y
POP x
ASSERT x == 0x0A0B0C0D12131415
ASSERT y == 0x0E0F101116171819

# soft fails
CLEARSTACK
DLO32
ASSERT OK == 0
CLEARSTACK
DHI32
ASSERT OK == 0
CLEARSTACK
DPACK32
ASSERT OK == 0
CLEARSTACK
PUSH 1
2LO32
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2PACK32
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof166_dlo32_dpack32" LAST_N SP
