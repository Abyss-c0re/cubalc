# Proof 553 — digit-7 stack+dual signed WITHIN 32/16: SWITHINS32N SWITHINS16N DWITHINS32N DWITHINS16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SWITHINS32N: 0 in [0, 5) → 1
PUSH 0x0
SWITHINS32N 0x0 0x5 0
POP x
ASSERT x == 1

# 5 not in [0, 5) (hi exclusive)
CLEARSTACK
PUSH 0x5
WITHINS32N 0x0 0x5 0
POP x
ASSERT x == 0

# -1 in [-2, 0) → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SWITHINSIGN32N 0xFFFFFFFE 0x0 0
POP x
ASSERT x == 1

# 0 not in [-2, 0)
CLEARSTACK
PUSH 0x0
SWITHINS32N 0xFFFFFFFE 0x0 0
POP x
ASSERT x == 0

# contrast BETWEEN inclusive: 5 in [0,5] → 1
CLEARSTACK
PUSH 0x5
SBETWEENS32N 0x0 0x5 0
POP x
ASSERT x == 1

# no swap: lo>hi yields empty when v not matching weird
CLEARSTACK
PUSH 0x2
SWITHINS32N 0x5 0x0 0
POP x
ASSERT x == 0

# high preserve
CLEARSTACK
PUSH 0xAABBCCDD00000003
SWITHINS32N 0x0 0x5 0
POP x
ASSERT x == 0xAABBCCDD00000001

# STACKWITHINS32N n1
CLEARSTACK
PUSH 0x0000000400000000
STACKWITHINS32N 0x0 0x5 1
POP x
ASSERT x == 0x0000000100000000

# SWITHINS16N: 0 in [0,5) → 1; 5 not
CLEARSTACK
PUSH 0x0
SWITHINS16N 0x0 0x5 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x5
WITHINS16N 0x0 0x5 0
POP x
ASSERT x == 0

# -1=0xFFFF in [-2,0)
CLEARSTACK
PUSH 0xFFFF
SWITHINSIGN16N 0xFFFE 0x0 0
POP x
ASSERT x == 1

# high halfword
CLEARSTACK
PUSH 0x11220003
SWITHINS16N 0x0 0x5 0
POP x
ASSERT x == 0x11220001

# STACKWITHINS16N n1
CLEARSTACK
PUSH 0x00040000
STACKWITHINS16N 0x0 0x5 1
POP x
ASSERT x == 0x00010000

# DWITHINS32N
CLEARSTACK
PUSH 0x0
PUSH 0x5
DWITHINS32N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# dual signed
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x0
PAIRWITHINS32N 0xFFFFFFFE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK2WITHINS32N n1
CLEARSTACK
PUSH 0x0000000300000000
PUSH 0x0000000500000000
STACK2WITHINS32N 0x0 0x5 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# DWITHINS16N
CLEARSTACK
PUSH 0x0
PUSH 0x5
DWITHINS16N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFF
PUSH 0x1
PAIRWITHINS16N 0xFFFE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK2WITHINS16N n1
CLEARSTACK
PUSH 0x00030000
PUSH 0x00050000
STACK2WITHINS16N 0x0 0x5 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

HOLD_FLASH 0
