# ENSURENEW / NEW OR — keep live instance or soft-create without HASOBJ+IF+NEW

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
END

# create via ENSURENEW
ENSURENEW Ticket t1
ASSERT OK == 1
ASSERT ENSURENEW_N == 1
ASSERT ENSURED == 1
ASSERT LAST_N == 1
ASSERT LAST == "t1"
HASOBJ t1
ASSERT LAST_N == 1
SEND t1 ping
ASSERT LAST == "pong"

# second ensure — already live, no re-init
SETF t1 id 42
ENSURENEW Ticket t1
ASSERT OK == 1
ASSERT ENSURENEW_N == 0
ASSERT ENSURED == 1
ASSERT LAST_N == 0
ASSERT LAST == "t1"
GETF t1 id
ASSERT LAST_N == 42

# NEW OR sugar create
NEW OR Ticket t2
ASSERT OK == 1
ASSERT ENSURENEW_N == 1
HASOBJ t2
ASSERT LAST_N == 1

# NEW OR already
NEW OR Ticket t2
ASSERT OK == 1
ASSERT ENSURENEW_N == 0

# GETORNEW alias
GETORNEW Ticket t3
ASSERT OK == 1
ASSERT ENSURENEW_N == 1
GETORNEW Ticket t3
ASSERT ENSURENEW_N == 0

# soft miss unknown class
ENSURENEW Ghost g1
ASSERT OK == 0
ASSERT ENSURENEW_N == 0
ASSERT ENSURED == 0
SYS HASI LAST_ERR "CLASS"
ASSERT LAST_N == 1
HASOBJ g1
ASSERT LAST_N == 0
CLEAR_ERR

# class mismatch — live wrong type
CLASS Other
  FIELD x
END
NEW Other o1
ENSURENEW Ticket o1
ASSERT OK == 0
SYS HASI LAST_ERR "mismatch"
ASSERT LAST_N == 1
# still Other
HASOBJ o1
ASSERT LAST_N == 1
CLEAR_ERR

HASFORM "ENSURENEW"
ASSERT LAST_N == 1
HASFORM "TRYNEW"
ASSERT LAST_N == 1

PRINT "1414_ensurenew ok"
PASS
