# Proof 107 — digit-4 stack immediate ALU: SADDN SSUBN SMULN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 10
SADDN 5
ASSERT LAST_N == 15
SSUBN 3
ASSERT LAST_N == 12
SMULN 2
ASSERT LAST_N == 24
POP a
ASSERT a == 24

# aliases
CLEARSTACK
PUSH 7
PLUSN 3
ASSERT LAST_N == 10
MINUSN 4
ASSERT LAST_N == 6
TIMESN 5
ASSERT LAST_N == 30

# zero / negative immediates
CLEARSTACK
PUSH 8
SADDN 0
ASSERT LAST_N == 8
SSUBN -2
ASSERT LAST_N == 10
SMULN -1
ASSERT LAST_N == -10

# soft fail empty
CLEARSTACK
SADDN 1
ASSERT OK == 0
SSUBN 1
ASSERT OK == 0
SMULN 2
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof107_saddn_smuln" LAST_N SP
