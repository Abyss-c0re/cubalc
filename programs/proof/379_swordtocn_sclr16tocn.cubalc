# Proof 379 — digit-9 imm halfword field TOC: SWORDTOCN SSET16TOCN SCLR16TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSET16TOCN: build 0x00020001 = 131073
CELLSET 1 0
PUSH 1
SSET16TOCN 1 0
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
SSET16TOCN 2 1
ASSERT LAST_N == 131073
ASSERT CELL(1) == 131073
POP

# SWORDTOCN extract halfword 1 → 2
CELLSET 2 131073
PUSH 2
SWORDTOCN 1
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# WORDTOCN alias: halfword 0 of 0x12345678
# 0x12345678 = 305419896; lo16 = 0x5678 = 22136
CELLSET 3 305419896
PUSH 3
WORDTOCN 0
ASSERT LAST_N == 22136
ASSERT CELL(3) == 22136
POP

# SCLR16TOCN clear halfword 0 of 0x00010002 = 65538 → 0x00010000 = 65536
CELLSET 4 65538
PUSH 4
SCLR16TOCN 0
ASSERT LAST_N == 65536
ASSERT CELL(4) == 65536
POP

# CLR16TOCN clear halfword 1 then extract is 0
CELLSET 5 131073
PUSH 5
CLR16TOCN 1
POP
PUSH 5
SWORDTOCN 1
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft empty OK=0
CLEARSTACK
SWORDTOCN 0
ASSERT OK == 0

PRINT "379_swordtocn_sclr16tocn OK"
