# Proof 132 — digit-2 modular ext: SQPART ISPRIMITIVE SCRT + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# SQPART expr
ASSERT SQPART(1) == 1
ASSERT SQPART(12) == 4
ASSERT LARGESQ(18) == 9
ASSERT MAXSQ(16) == 16
ASSERT SQPART(7) == 1
ASSERT SQPART(0) == 0
ASSERT SQPART(72) == 36

# ISPRIMITIVE expr (mod prime) — 3 is prim root mod 7; 2 is not
ASSERT ISPRIMITIVE(3, 7) == 1
ASSERT ISPRROOT(5, 7) == 1
ASSERT ISPRIMITIVE(2, 7) == 0
ASSERT PRIMROOTP(1, 7) == 0
ASSERT ISPRIMITIVE(2, 8) == 0
ASSERT ISPRIMITIVE(3, 8) == 0

# stack SSQPART
CLEARSTACK
PUSH 12
SSQPART
ASSERT LAST_N == 4
PUSH 72
SLARGESQ
ASSERT LAST_N == 36

# stack SIPRIMITIVE
CLEARSTACK
PUSH 3
PUSH 7
SIPRIMITIVE
ASSERT LAST_N == 1
PUSH 1
PUSH 7
SIPRROOT
ASSERT LAST_N == 0

# SCRT — x≡2 (mod 3), x≡3 (mod 5) → 8
CLEARSTACK
PUSH 2
PUSH 3
PUSH 3
PUSH 5
SCRT
ASSERT LAST_N == 8
POP x
ASSERT x == 8

# SCRT inconsistent: 1 mod 4, 2 mod 6 (diff not multiple of gcd)
CLEARSTACK
PUSH 1
PUSH 4
PUSH 2
PUSH 6
SCRT
ASSERT LAST_N == 0

# SCRT alias
CLEARSTACK
PUSH 0
PUSH 4
PUSH 1
PUSH 5
SCHINREM
ASSERT LAST_N == 16

# soft fails
CLEARSTACK
SSQPART
ASSERT OK == 0
SIPRIMITIVE
ASSERT OK == 0
SCRT
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof132_sqpart_scrt" LAST_N SP
