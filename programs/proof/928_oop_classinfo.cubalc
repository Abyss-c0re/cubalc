# CLASSINFO / DUMPCLASS — class schema plate for agents
# Usability: no LISTFIELDS + LISTMETHODS + COUNTOBJ glue

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 10 0
NEW Cell b 1 20 0

CLASSINFO Cell
ASSERT OK == 1
ASSERT CLASSINFO_N == 6
ASSERT NFIELDS == 6
ASSERT NMETHODS == 5
ASSERT CLASSINFO_METHODS == 5
ASSERT CLASSINFO_LIVE == 2
SYS EQS CLASS "Cell"
ASSERT LAST_N == 1
SYS HAS LAST "name:Cell"
ASSERT LAST_N == 1
SYS HAS LAST "n_fields:6"
ASSERT LAST_N == 1
SYS HAS LAST "n_methods:5"
ASSERT LAST_N == 1
SYS HAS LAST "live:2"
ASSERT LAST_N == 1
SYS HAS LAST "fields:"
ASSERT LAST_N == 1
SYS HAS LAST "energy"
ASSERT LAST_N == 1
SYS HAS LAST "methods:"
ASSERT LAST_N == 1
SYS HAS LAST "init"
ASSERT LAST_N == 1
SYS HAS LAST "tick"
ASSERT LAST_N == 1
# FIELDS/METHODS convenience bags (comma-joined)
SYS HAS FIELDS "energy"
ASSERT LAST_N == 1
SYS HAS METHODS "tick"
ASSERT LAST_N == 1

# JSON plate
CLASSINFO JSON Cell
ASSERT OK == 1
SYS HAS LAST "cubalc.class.v1"
ASSERT LAST_N == 1
SYS HAS LAST "\"name\":\"Cell\""
ASSERT LAST_N == 1
SYS HAS LAST "\"n_fields\":6"
ASSERT LAST_N == 1
SYS HAS LAST "\"live\":2"
ASSERT LAST_N == 1
SYS HAS LAST "\"fields\":["
ASSERT LAST_N == 1
SYS HAS LAST "\"methods\":["
ASSERT LAST_N == 1

# from live object name
CLASSINFO a
ASSERT OK == 1
SYS EQS CLASS "Cell"
ASSERT LAST_N == 1
ASSERT CLASSINFO_LIVE == 2

# aliases
DUMPCLASS Cell
ASSERT OK == 1
ASSERT CLASSINFO_N == 6
DESCRIBECLASS Cell
ASSERT NMETHODS == 5
INSPECTCLASS JSON Cell
SYS HAS LAST "cubalc.class.v1"
ASSERT LAST_N == 1

# unknown soft
CLASSINFO NoSuchClass
ASSERT OK == 0
ASSERT CLASSINFO_N == 0
ASSERT CLASSINFO_LIVE == 0
SYS EQS LAST ""
ASSERT LAST_N == 1

# empty class zero live
CLASS Empty
  FIELD x 0
  METHOD noop
    RET 0
  END
END
CLASSINFO Empty
ASSERT OK == 1
ASSERT NFIELDS == 1
ASSERT NMETHODS == 1
ASSERT CLASSINFO_LIVE == 0
SYS HAS LAST "live:0"
ASSERT LAST_N == 1
SYS HAS FIELDS "x"
ASSERT LAST_N == 1
SYS HAS METHODS "noop"
ASSERT LAST_N == 1

PRINT "proof928_oop_classinfo" 1
ASSERT OK == 1
