# Proof 229 — digit-3 dual-stack immediate compare: DEQN DLTN DGTN
HOLD_FLASH 1
SCIENCE LOAD

# DEQN
CLEARSTACK
PUSH 5
PUSH 7
DEQN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH 3
2EQN 3
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# PAIREQN / DEQIMM
CLEARSTACK
PUSH 0
PUSH 1
PAIREQN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -1
PUSH -1
DEQIMM -1
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DLTN
CLEARSTACK
PUSH 2
PUSH 10
DLTN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 5
PUSH 4
2LTN 5
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# PAIRLTN
CLEARSTACK
PUSH -3
PUSH 0
PAIRLTN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DGTN
CLEARSTACK
PUSH 9
PUSH 1
DGTN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 5
PUSH 6
2GTN 5
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# PAIRGTN / DGTIMM
CLEARSTACK
PUSH 100
PUSH 100
PAIRGTN 50
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH -1
DGTIMM 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# trichotomy: eq + lt + gt cover for constants
CLEARSTACK
PUSH 7
PUSH 3
DEQN 7
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 7
PUSH 3
DLTN 7
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 7
PUSH 3
DGTN 7
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft empty
CLEARSTACK
DEQN 1
ASSERT OK == 0
