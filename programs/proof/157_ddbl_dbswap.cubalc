# Proof 157 — digit-7 dual-stack ALU unary: DDBL DHALF DBSWAP
HOLD_FLASH 1
SCIENCE LOAD

# DDBL — *2 pair
CLEARSTACK
PUSH 5
PUSH -3
DDBL
POP y
POP x
ASSERT x == 10
ASSERT y == -6

CLEARSTACK
PUSH 0
PUSH 100
2DBL
POP y
POP x
ASSERT x == 0
ASSERT y == 200

# DHALF — toward-zero /2
CLEARSTACK
PUSH 9
PUSH -9
DHALF
POP y
POP x
ASSERT x == 4
ASSERT y == -4

CLEARSTACK
PUSH 1
PUSH 0
2HALF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DBSWAP — 32-bit byte reverse
CLEARSTACK
PUSH 0x12345678
PUSH 0xAABBCCDD
DBSWAP
POP y
POP x
ASSERT x == 0x78563412
ASSERT y == 0xDDCCBBAA

CLEARSTACK
PUSH 0x01020304
PUSH 0
2BSWAP
POP y
POP x
ASSERT x == 0x04030201
ASSERT y == 0

# aliases
CLEARSTACK
PUSH 7
PUSH 8
PAIRDBL
POP y
POP x
ASSERT x == 14
ASSERT y == 16

CLEARSTACK
PUSH 15
PUSH -2
PAIRHALF
POP y
POP x
ASSERT x == 7
ASSERT y == -1

CLEARSTACK
PUSH 0xFF000000
PUSH 0x000000FF
PAIRBSWAP
POP y
POP x
ASSERT x == 0x000000FF
ASSERT y == 0xFF000000

# soft fails
CLEARSTACK
DDBL
ASSERT OK == 0
CLEARSTACK
DHALF
ASSERT OK == 0
CLEARSTACK
DBSWAP
ASSERT OK == 0
CLEARSTACK
PUSH 1
2DBL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof157_ddbl_dbswap" LAST_N SP
