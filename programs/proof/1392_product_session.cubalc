LET ENV_GUARD_SOFT = 0
LET TIME_GUARD_SOFT = 0
INCLUDE product_session
ASSERT OK == 1
ASSERT TOOL_SESSION_OK == 1
ASSERT ENV_GUARD_OK == 1
ASSERT TIME_GUARD_OK == 1
