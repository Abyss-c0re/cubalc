# Proof 58 — digit-1 BETWEEN/INRANGE WITHIN MEDIAN + stack SBETWEEN SMEDIAN
HOLD_FLASH 1
SCIENCE LOAD

# BETWEEN / INRANGE inclusive
ASSERT BETWEEN(5, 0, 10) == 1
ASSERT BETWEEN(0, 0, 10) == 1
ASSERT BETWEEN(10, 0, 10) == 1
ASSERT BETWEEN(11, 0, 10) == 0
ASSERT BETWEEN(-1, 0, 10) == 0
ASSERT INRANGE(7, 10, 0) == 1
ASSERT BETWEEN(3, 3, 3) == 1

# WITHIN half-open [lo, hi)
ASSERT WITHIN(5, 0, 10) == 1
ASSERT WITHIN(0, 0, 10) == 1
ASSERT WITHIN(10, 0, 10) == 0
ASSERT WITHIN(9, 0, 10) == 1
ASSERT WITHIN(-1, 0, 10) == 0

# MEDIAN / MID3
ASSERT MEDIAN(1, 2, 3) == 2
ASSERT MEDIAN(3, 1, 2) == 2
ASSERT MEDIAN(9, 9, 1) == 9
ASSERT MID3(-5, 0, 5) == 0
ASSERT MEDIAN(7, 7, 7) == 7

# compose with SELECT/CLAMP
ASSERT SELECT(BETWEEN(4, 1, 8), 100, 0) == 100
ASSERT CLAMP(MEDIAN(0, 50, 100), 10, 90) == 50
ASSERT CLAMP(MEDIAN(0, 5, 100), 10, 90) == 10

# stack SBETWEEN / SINRANGE
CLEARSTACK
PUSH 5
PUSH 0
PUSH 10
SBETWEEN
ASSERT LAST_N == 1
CLEARSTACK
PUSH 10
PUSH 0
PUSH 10
SINRANGE
ASSERT LAST_N == 1
CLEARSTACK
PUSH 11
PUSH 0
PUSH 10
STACKBETWEEN
ASSERT LAST_N == 0

# stack SMEDIAN
CLEARSTACK
PUSH 3
PUSH 1
PUSH 2
SMEDIAN
ASSERT LAST_N == 2
CLEARSTACK
PUSH 8
PUSH 2
PUSH 5
SMID3
ASSERT LAST_N == 5
CLEARSTACK
PUSH -1
PUSH -9
PUSH 4
STACKMEDIAN
ASSERT LAST_N == -1

# underflow
CLEARSTACK
SBETWEEN
ASSERT OK == 0
CLEARSTACK
SMEDIAN
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof58_select_clamp_range" LAST_N SP
