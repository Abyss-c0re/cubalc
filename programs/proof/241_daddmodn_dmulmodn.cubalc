# Proof 241 — digit-2 dual-stack immediate modular ALU: DADDMODN DSUBMODN DMULMODN
HOLD_FLASH 1
SCIENCE LOAD

# DADDMODN
CLEARSTACK
PUSH 10
PUSH 14
DADDMODN 5 12
POP y
POP x
ASSERT x == 3
ASSERT y == 7

CLEARSTACK
PUSH 11
PUSH -1
2ADDMODN 1 10
POP y
POP x
ASSERT x == 2
ASSERT y == 0

# DSUBMODN
CLEARSTACK
PUSH 3
PUSH 1
DSUBMODN 5 12
POP y
POP x
ASSERT x == 10
ASSERT y == 8

CLEARSTACK
PUSH 0
PUSH 5
2SUBMODN 1 7
POP y
POP x
ASSERT x == 6
ASSERT y == 4

# DMULMODN
CLEARSTACK
PUSH 7
PUSH 3
DMULMODN 5 11
POP y
POP x
ASSERT x == 2
ASSERT y == 4

CLEARSTACK
PUSH 10
PUSH 0
2MULMODN 3 7
POP y
POP x
ASSERT x == 2
ASSERT y == 0

# m<=0 → 0
CLEARSTACK
PUSH 9
PUSH 8
DADDMODN 1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fails
CLEARSTACK
DADDMODN 1 5
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSUBMODN 1 5
ASSERT OK == 0
CLEARSTACK
PUSH 1
DMULMODN 2 7
ASSERT OK == 0

HOLD_FLASH 1
