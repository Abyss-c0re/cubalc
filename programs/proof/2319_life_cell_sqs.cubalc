GETF nest heat
ASSERT LAST_N == b_h + 2 "nest sqs h+2"
GETF nest energy
ASSERT LAST_N == b_e - 2 "nest sqs e-2"
GETF nest atp
ASSERT LAST_N == b_a - 2 "nest sqs a-2"
GETF nest age
ASSERT LAST_N == b_age "nest sqs age held"
GETF nest pcr
ASSERT LAST_N == b_pcr "nest sqs pcr held"
GETF nest reserve
ASSERT LAST_N == b_rsv "nest sqs reserve held"
GETF nest pmf
ASSERT LAST_N == b_pmf "nest sqs pmf held"
GETF nest threshold
ASSERT LAST_N == b_thr "nest sqs thr held"
GETF nest alive
ASSERT LAST_N == 1 "nest alive post-sqs"

