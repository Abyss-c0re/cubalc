# Proof 170 — digit-7 dual-stack: DBHSI DCEILPOW2
HOLD_FLASH 1
SCIENCE LOAD

# DBHSI — isolate highest set bit
CLEARSTACK
PUSH 12
PUSH 10
DBHSI
POP y
POP x
ASSERT x == 8
ASSERT y == 8

CLEARSTACK
PUSH 0
PUSH 1
2BHSI
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0xF0
PUSH 0xA0
PAIRBHSI
POP y
POP x
ASSERT x == 128
ASSERT y == 128

CLEARSTACK
PUSH 7
PUSH 0x80000000
DHIBIT
POP y
POP x
ASSERT x == 4
ASSERT y == 2147483648

# DCEILPOW2 — smallest power of 2 ≥ n
CLEARSTACK
PUSH 5
PUSH 8
DCEILPOW2
POP y
POP x
ASSERT x == 8
ASSERT y == 8

CLEARSTACK
PUSH 1
PUSH 0
2CEILPOW2
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH 17
PAIRCEILPOW2
POP y
POP x
ASSERT x == 4
ASSERT y == 32

CLEARSTACK
PUSH -5
PUSH 100
DNEXTPOW2
POP y
POP x
ASSERT x == 0
ASSERT y == 128

# soft fails
CLEARSTACK
DBHSI
ASSERT OK == 0
CLEARSTACK
DCEILPOW2
ASSERT OK == 0
CLEARSTACK
PUSH 1
2BHSI
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof170_dbhsi_dceilpow2" LAST_N SP
