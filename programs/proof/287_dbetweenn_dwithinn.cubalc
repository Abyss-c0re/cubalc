# Proof 287 — digit-3 dual-stack imm range: DBETWEENN DWITHINN
HOLD_FLASH 1
SCIENCE LOAD

# DBETWEENN lo hi — inclusive [lo,hi]
CLEARSTACK
PUSH 5
PUSH 10
DBETWEENN 0 10
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH 11
PAIRBETWEENN 0 10
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -1
PUSH 50
DINRANGEN 0 10
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# lo>hi swap
CLEARSTACK
PUSH 5
PUSH 3
DBETWEENN 10 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 11
PUSH -2
PAIRBETWEENIMM 10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DWITHINN lo hi — half-open [lo,hi)
CLEARSTACK
PUSH 0
PUSH 9
DWITHINN 0 10
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 10
PUSH 5
PAIRWITHINN 0 10
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -1
PUSH 10
DINTERVALN 0 10
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# no lo/hi swap for WITHIN (hi exclusive raw)
CLEARSTACK
PUSH 5
PUSH 1
DWITHINN 10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fails
CLEARSTACK
DBETWEENN 0 10
ASSERT OK == 0
CLEARSTACK
PUSH 1
DWITHINN 0 10
ASSERT OK == 0

HOLD_FLASH 1
