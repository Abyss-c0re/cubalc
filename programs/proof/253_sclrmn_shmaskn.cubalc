# Proof 253 — digit-7 stack clear + high-mask: SCLRMN SCLRHN SHMASKN
HOLD_FLASH 1
SCIENCE LOAD

# SCLRMN — clear low n
CLEARSTACK
PUSH 0xABCD
SCLRMN 8
POP x
ASSERT x == 0xAB00

CLEARSTACK
PUSH 0xF0FF
STACKCLRMN 4
POP x
ASSERT x == 0xF0F0

# CLRLN alias + n=0 noop
CLEARSTACK
PUSH 0x55
CLRLN 0
POP x
ASSERT x == 0x55

# SCLRHN — clear high n
CLEARSTACK
PUSH 0xF00000000000000F
SCLRHN 4
POP x
ASSERT x == 0x000000000000000F

CLEARSTACK
PUSH 0xAB00000000000011
STACKCLRHN 8
POP x
ASSERT x == 0x0000000000000011

# CLRHN alias
CLEARSTACK
PUSH 0xFF00000000000000
CLRHN 8
POP x
ASSERT x == 0

# SHMASKN — high-n mask
CLEARSTACK
PUSH 0
SHMASKN 4
POP x
ASSERT x == 0xF000000000000000

CLEARSTACK
PUSH 0
STACKHMASKN 8
POP x
ASSERT x == 0xFF00000000000000

# HMASKN n=0
CLEARSTACK
PUSH 0x1234
HMASKN 0
POP x
ASSERT x == 0

# soft fails
CLEARSTACK
SCLRMN 4
ASSERT OK == 0
CLEARSTACK
SCLRHN 4
ASSERT OK == 0

HOLD_FLASH 1
