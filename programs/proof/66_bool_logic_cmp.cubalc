# Proof 66 — digit-1 LAND/LOR/LXOR/LNOT IMPLY EQ/NE/LT EQZ/NEZ + stack
HOLD_FLASH 1
SCIENCE LOAD

# LAND LOR LXOR LNOT
ASSERT LAND(1, 1) == 1
ASSERT LAND(1, 0) == 0
ASSERT LAND(5, 7) == 1
ASSERT LAND(0, 9) == 0
ASSERT LOR(0, 0) == 0
ASSERT LOR(0, 3) == 1
ASSERT LXOR(1, 0) == 1
ASSERT LXOR(1, 1) == 0
ASSERT LXOR(5, 0) == 1
ASSERT LNOT(0) == 1
ASSERT LNOT(9) == 0

# IMPLY / IMPLIES
ASSERT IMPLY(0, 0) == 1
ASSERT IMPLY(0, 1) == 1
ASSERT IMPLY(1, 1) == 1
ASSERT IMPLY(1, 0) == 0
ASSERT IMPLIES(2, 0) == 0

# EQZ / NEZ
ASSERT EQZ(0) == 1
ASSERT EQZ(3) == 0
ASSERT ISZERO(0) == 1
ASSERT NEZ(0) == 0
ASSERT NEZ(4) == 1
ASSERT ISNZ(-1) == 1
ASSERT NONZERO(0) == 0

# signed compare predicates
ASSERT EQ(3, 3) == 1
ASSERT EQ(3, 4) == 0
ASSERT NE(3, 4) == 1
ASSERT LT(-1, 0) == 1
ASSERT LE(5, 5) == 1
ASSERT GT(2, 1) == 1
ASSERT GE(2, 2) == 1
ASSERT LT(5, 3) == 0

# compose with SELECT/ISel
ASSERT SELECT(LAND(1, 1), 10, 20) == 10
ASSERT SELECT(EQZ(0), 1, 0) == 1
ASSERT SELECT(IMPLY(1, 0), 0, 99) == 99
ASSERT LAND(LT(1, 2), GT(3, 0)) == 1

# stack SLAND SLOR SLXOR SIMP
CLEARSTACK
PUSH 1
PUSH 1
SLAND
ASSERT LAST_N == 1
CLEARSTACK
PUSH 0
PUSH 5
SLOR
ASSERT LAST_N == 1
CLEARSTACK
PUSH 1
PUSH 1
SLXOR
ASSERT LAST_N == 0
CLEARSTACK
PUSH 1
PUSH 0
SIMP
ASSERT LAST_N == 0
CLEARSTACK
PUSH 0
PUSH 0
STACKIMPLY
ASSERT LAST_N == 1

# stack SLNOT SEQZ SNEZ
CLEARSTACK
PUSH 0
SLNOT
ASSERT LAST_N == 1
CLEARSTACK
PUSH 7
SLNOT
ASSERT LAST_N == 0
CLEARSTACK
PUSH 0
SEQZ
ASSERT LAST_N == 1
CLEARSTACK
PUSH 3
SISZERO
ASSERT LAST_N == 0
CLEARSTACK
PUSH 0
SNEZ
ASSERT LAST_N == 0
CLEARSTACK
PUSH -2
SNONZERO
ASSERT LAST_N == 1

# underflow
CLEARSTACK
SLAND
ASSERT OK == 0
CLEARSTACK
SLNOT
ASSERT OK == 0
CLEARSTACK
SEQZ
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof66_bool_logic_cmp" LAST_N SP
