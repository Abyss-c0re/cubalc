# Proof 113 — digit-6 stack immediate bitwise mask: SANDI SORI SXORI
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 0xFF
SANDI 0x0F
ASSERT LAST_N == 15
SORI 0xF0
ASSERT LAST_N == 255
SXORI 0x0F
ASSERT LAST_N == 240
POP a
ASSERT a == 240

CLEARSTACK
PUSH 0xAA
ANDIMM 0x0F
ASSERT LAST_N == 10
ORIMM 0x05
ASSERT LAST_N == 15
XORIMM 0x0A
ASSERT LAST_N == 5
POP b
ASSERT b == 5

CLEARSTACK
PUSH 0
SANDI 0xFFFF
ASSERT LAST_N == 0
SORI 1
ASSERT LAST_N == 1
SXORI 1
ASSERT LAST_N == 0

# empty soft fail
CLEARSTACK
SANDI 1
ASSERT OK == 0
SORI 1
ASSERT OK == 0
SXORI 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof113_sandi_sxori" LAST_N SP
