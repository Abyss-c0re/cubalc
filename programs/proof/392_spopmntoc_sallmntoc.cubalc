# Proof 392 — digit-9 stack dual low-n metric TOC: SPOPMNTOC SANYMNTOC SALLMNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOPMNTOC: popcount low-4 of 13=0b1101 → 3
CELLSET 1 13
PUSH 1
PUSH 4
SPOPMNTOC
ASSERT LAST_N == 3
ASSERT CELL(1) == 3
POP a
ASSERT a == 3

# POPMNTOC n=0 → 0
CELLSET 2 255
PUSH 2
PUSH 0
POPMNTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SANYMNTOC: low-3 of 8=0b1000 → 0; of 9=0b1001 → 1
CELLSET 3 8
PUSH 3
PUSH 3
SANYMNTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP
CELLSET 4 9
PUSH 4
PUSH 3
ANYMNTOC
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# SALLMNTOC: low-4 of 15 → 1; of 7 → 0
CELLSET 5 15
PUSH 5
PUSH 4
SALLMNTOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP
CELLSET 6 7
PUSH 6
PUSH 4
ALLMNTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# n=0 vacuous all → 1
CELLSET 7 0
PUSH 7
PUSH 0
SALLMNTOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# soft empty / short stack OK=0
CLEARSTACK
SPOPMNTOC
ASSERT OK == 0
PUSH 1
SANYMNTOC
ASSERT OK == 0

PRINT "392_spopmntoc_sallmntoc OK"
