# Proof 422 — digit-1 stack word32: SSAR32 SROTL32 SROTR32
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSAR32: 0x80000000 ≫ 1 → 0xC0000000 as signed = -1073741824
PUSH 2147483648
PUSH 1
SSAR32
ASSERT LAST_N == -1073741824
POP

# SASHR32: -16 ≫ 2 → -4 (via low32 of -16)
PUSH 4294967280
PUSH 2
SASHR32
ASSERT LAST_N == -4
POP

# SSAR32 k>=32 all sign
PUSH 2147483648
PUSH 32
SSAR32
ASSERT LAST_N == -1
POP

PUSH 100
PUSH 40
SSAR32
ASSERT LAST_N == 0
POP

# SROTL32: 0x12345678 rol 4 → 0x23456781
PUSH 305419896
PUSH 4
SROTL32
ASSERT LAST_N == 591751041
POP

# SROTR32: 0x80000001 ror 1 → 0xC0000000 = 3221225472
PUSH 2147483649
PUSH 1
SROTR32
ASSERT LAST_N == 3221225472
POP

# SROL32 / SROR32 zero amt
PUSH 42
PUSH 0
SROL32
ASSERT LAST_N == 42
POP

PUSH 99
PUSH 0
SROR32
ASSERT LAST_N == 99
POP

# soft short
CLEARSTACK
SSAR32
ASSERT OK == 0

CLEARSTACK
PUSH 1
SROTL32
ASSERT OK == 0

CLEARSTACK
SROTR32
ASSERT OK == 0

HOLD_FLASH 0
