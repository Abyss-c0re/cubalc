# Proof 467 — digit-0 stack imm 4-bit field arith merge: SADD4N SSUB4N SMUL4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SADD4N: 0x3 + 0x4 → 0x7
PUSH 0x3
SADD4N 4 0
POP x
ASSERT x == 7

# wrap: 0xF + 0x2 → 0x1
CLEARSTACK
PUSH 0xF
ADD4N 2 0
POP x
ASSERT x == 1

# high preserved: 0x...70 + 5 → 0x...75
CLEARSTACK
PUSH 0x1122334455667770
SADD4N 5 0
POP x
ASSERT x == 0x1122334455667775

# STACKADD4N n1: nibble1 of 0x...20 + 3 → 0x...50
CLEARSTACK
PUSH 0x20
STACKADD4N 3 1
POP x
ASSERT x == 0x50

# SSUB4N: 0x9 - 0x4 → 0x5
CLEARSTACK
PUSH 0x9
SSUB4N 4 0
POP x
ASSERT x == 5

# wrap borrow: 0x1 - 0x2 → 0xF
CLEARSTACK
PUSH 0x1
SUB4N 2 0
POP x
ASSERT x == 15

# STACKSUB4N n1: nibble1 of 0x...A0 - 1 → 0x...90
CLEARSTACK
PUSH 0xA0
STACKSUB4N 1 1
POP x
ASSERT x == 0x90

# SMUL4N: 0x3 * 0x5 → 0xF
CLEARSTACK
PUSH 0x3
SMUL4N 5 0
POP x
ASSERT x == 15

# wrap mul: 0x4 * 0x5 → 0x14 & 0xF = 0x4
CLEARSTACK
PUSH 0x4
MUL4N 5 0
POP x
ASSERT x == 4

# zero annihilator
CLEARSTACK
PUSH 0xF
SMUL4N 0 0
POP x
ASSERT x == 0

# high preserved mul: 0x...72 * 3 → 0x...76 (2*3=6)
CLEARSTACK
PUSH 0x1122334455667772
SMUL4N 3 0
POP x
ASSERT x == 0x1122334455667776

# STACKMUL4N n1: nibble1 of 0x...30 * 4 → 0x...C0
CLEARSTACK
PUSH 0x30
STACKMUL4N 4 1
POP x
ASSERT x == 0xC0

# SINC4N alias add1
CLEARSTACK
PUSH 0xE
SINC4N 1 0
POP x
ASSERT x == 15

# SDEC4N alias sub1 wrap
CLEARSTACK
PUSH 0x0
SDEC4N 1 0
POP x
ASSERT x == 15

# round-trip add then sub
CLEARSTACK
PUSH 0xA5
SADD4N 3 0
SSUB4N 3 0
POP x
ASSERT x == 0xA5

HOLD_FLASH 0
