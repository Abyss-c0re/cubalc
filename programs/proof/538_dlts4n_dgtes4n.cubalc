# Proof 538 — digit-1 dual-stack imm 4-bit signed ordered-cmp: DLTS4N DGTS4N DLTES4N DGTES4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLTS4N: -1 (0xF) < 1 → 1 ; 1 < 1 → 0
PUSH 0xF
PUSH 0x1
DLTS4N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# unsigned DLT would treat 0xF > 0x1
CLEARSTACK
PUSH 0xF
PUSH 0x1
DLT4N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# equal signed → 0 for LT
CLEARSTACK
PUSH 0x8
PUSH 0x8
PAIRLTS4N 0x8 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mixed: 0x2 < 0x3 → 1; 0x4 < 0x3 → 0
CLEARSTACK
PUSH 0x2
PUSH 0x4
DLTS4N 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 1 < -1 → 0 both
CLEARSTACK
PUSH 0x1
PUSH 0x2
S2LTS4N 0xF 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved other nibbles
CLEARSTACK
PUSH 0x9AF
PUSH 0x120
DLTS4N 0x1 0
POP y
POP x
ASSERT x == 0x9A1
ASSERT y == 0x121

# STACK2LTS4N n1
CLEARSTACK
PUSH 0x00F0
PUSH 0x0010
STACK2LTS4N 0x0 1
POP y
POP x
ASSERT x == 0x0010
ASSERT y == 0x0000

# DGTS4N: 1 > -1 → 1 ; -1 > -1 → 0
CLEARSTACK
PUSH 0x1
PUSH 0xF
DGTS4N 0xF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 0xF > 0x1 signed → 0 both
CLEARSTACK
PUSH 0xF
PUSH 0xE
PAIRGTS4N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# -8 > 7 → 0
CLEARSTACK
PUSH 0x8
PUSH 0x8
DGTS4N 0x7 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DLTES4N equal → 1
CLEARSTACK
PUSH 0x8
PUSH 0x8
DLTES4N 0x8 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# -1 <= 0 → 1; 1 <= 0 → 0
CLEARSTACK
PUSH 0xF
PUSH 0x1
DLEQS4N 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DGTES4N equal → 1
CLEARSTACK
PUSH 0x5
PUSH 0x5
DGTES4N 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 1 >= -1 → 1; -8 >= 7 → 0
CLEARSTACK
PUSH 0x1
PUSH 0x8
DGEQS4N 0xF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DCMPLTS4N / DCMPGES4N
CLEARSTACK
PUSH 0xE
PUSH 0x0
DCMPLTS4N 0xF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xF
PUSH 0xE
DCMPGES4N 0xE 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# n2 dual signed
CLEARSTACK
PUSH 0x0F00
PUSH 0x0100
DLTS4N 0x0 2
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

HOLD_FLASH 0
