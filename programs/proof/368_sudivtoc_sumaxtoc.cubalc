# Proof 368 — digit-0 foundation stack↔cell unsigned TOC: SUDIVTOC SUMODTOC SUMINTOC SUMAXTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SUDIVTOC: 100 / 7 = 14
CELLSET 1 100
PUSH 1
PUSH 7
SUDIVTOC
ASSERT LAST_N == 14
ASSERT CELL(1) == 14
POP a
ASSERT a == 14

# UDIVTOC: 17 / 5 = 3
CELLSET 2 17
PUSH 2
PUSH 5
UDIVTOC
ASSERT LAST_N == 3
ASSERT CELL(2) == 3
POP

# soft v==0 → 0
CELLSET 3 9
PUSH 3
PUSH 0
SUDIVTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SUMODTOC: 100 % 7 = 2
CELLSET 4 100
PUSH 4
PUSH 7
SUMODTOC
ASSERT LAST_N == 2
ASSERT CELL(4) == 2
POP

# UMODTOC: 17 % 5 = 2
CELLSET 5 17
PUSH 5
PUSH 5
UMODTOC
ASSERT LAST_N == 2
ASSERT CELL(5) == 2
POP

# soft v==0 → 0
CELLSET 6 11
PUSH 6
PUSH 0
SUMODTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SUMINTOC: umin(5, 3) = 3
CELLSET 7 5
PUSH 7
PUSH 3
SUMINTOC
ASSERT LAST_N == 3
ASSERT CELL(7) == 3
POP

# UMINTOC: umin(2, 9) = 2
CELLSET 8 2
PUSH 8
PUSH 9
UMINTOC
ASSERT LAST_N == 2
ASSERT CELL(8) == 2
POP

# SUMAXTOC: umax(5, 3) = 5
CELLSET 9 5
PUSH 9
PUSH 3
SUMAXTOC
ASSERT LAST_N == 5
ASSERT CELL(9) == 5
POP

# UMAXTOC: umax(2, 9) = 9
CELLSET 10 2
PUSH 10
PUSH 9
UMAXTOC
ASSERT LAST_N == 9
ASSERT CELL(10) == 9
POP

# soft shallow OK=0
CLEARSTACK
PUSH 1
SUDIVTOC
ASSERT OK == 0

PRINT "368_sudivtoc_sumaxtoc OK"
