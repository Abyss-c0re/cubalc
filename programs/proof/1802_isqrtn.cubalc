# ISQRTN / SQRTN / IROOT2N — floor integer square root usability form

HOLD_FLASH 1

# perfect square
ISQRTN 100
ASSERT LAST_N == 10
ASSERT ISQRTN_OK == 1
ASSERT ISQRTN_X == 100

# non-square floor
ISQRTN 99
ASSERT LAST_N == 9

ISQRTN 2
ASSERT LAST_N == 1

ISQRTN 1
ASSERT LAST_N == 1

# zero
ISQRTN 0
ASSERT LAST_N == 0
ASSERT ISQRTN_OK == 1

# negative soft
ISQRTN -4
ASSERT LAST_N == 0
ASSERT ISQRTN_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

# aliases
SQRTN 144
ASSERT LAST_N == 12
IROOT2N 81
ASSERT LAST_N == 9
FLOORSQRTN 50
ASSERT LAST_N == 7
INTSQRTN 16
ASSERT LAST_N == 4
ROOT2N 10
ASSERT LAST_N == 3

# var subject
LET area = 10000
ISQRTN area
ASSERT LAST_N == 100

# pipeline after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--area=4096"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN area OR 0
ISQRTN LAST_N
ASSERT LAST_N == 64

# large-ish
ISQRTN 1000000
ASSERT LAST_N == 1000

PRINT "isqrtn ok"
