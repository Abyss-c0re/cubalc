# Proof 244 — digit-7 dual-stack high-n field reverse/rotate: DBREVHN DROLHN DRORHN
HOLD_FLASH 1
SCIENCE LOAD

# DBREVHN — reverse high n bits; low kept
# 0xB0...0F high nibble 1011 → 1101; low 0xF kept
CLEARSTACK
PUSH 0xB00000000000000F
PUSH 0x30000000000000A5
DBREVHN 4
POP y
POP x
ASSERT x == 0xD00000000000000F
# 0x3=0011 → 1100=0xC
ASSERT y == 0xC0000000000000A5

CLEARSTACK
PUSH 0xAB00000000000011
PUSH 0xCD00000000000022
2BREVHN 8
POP y
POP x
# 0xAB=10101011 → 11010101=0xD5
# 0xCD=11001101 → 10110011=0xB3
ASSERT x == 0xD500000000000011
ASSERT y == 0xB300000000000022

# n=0 noop
CLEARSTACK
PUSH 0x55
PUSH 0xAA
DBREVHN 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0xAA

# DROLHN — rotl1 within high n
CLEARSTACK
PUSH 0x9000000000000007
PUSH 0x500000000000000E
DROLHN 4
POP y
POP x
# 1001 → 0011; low 7 kept
ASSERT x == 0x3000000000000007
# 0101 → 1010
ASSERT y == 0xA00000000000000E

CLEARSTACK
PUSH 0x81000000000000F0
PUSH 0x420000000000000F
2ROLHN 8
POP y
POP x
# 0x81=10000001 → 00000011=0x03
# 0x42=01000010 → 10000100=0x84
ASSERT x == 0x03000000000000F0
ASSERT y == 0x840000000000000F

# DRORHN — rotr1 within high n
CLEARSTACK
PUSH 0x9000000000000007
PUSH 0x500000000000000E
DRORHN 4
POP y
POP x
# 1001 → 1100
ASSERT x == 0xC000000000000007
# 0101 → 1010
ASSERT y == 0xA00000000000000E

CLEARSTACK
PUSH 0x81000000000000F0
PUSH 0x420000000000000F
2RORHN 8
POP y
POP x
# 0x81 → 0xC0; 0x42 → 0x21
ASSERT x == 0xC0000000000000F0
ASSERT y == 0x210000000000000F

# round-trip: rol then ror
CLEARSTACK
PUSH 0xA5000000000000FF
PUSH 0x5A00000000000011
DROLHN 8
DRORHN 8
POP y
POP x
ASSERT x == 0xA5000000000000FF
ASSERT y == 0x5A00000000000011

# soft fails
CLEARSTACK
DBREVHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DROLHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DRORHN 4
ASSERT OK == 0

HOLD_FLASH 1
