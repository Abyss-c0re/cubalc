# Proof 213 — digit-6 dual-stack energy residual+step: DDIFFSQ DSTEP
HOLD_FLASH 1
SCIENCE LOAD

# DDIFFSQ
CLEARSTACK
PUSH 5
PUSH 10
PUSH 2
PUSH 4
DDIFFSQ
POP y
POP x
ASSERT x == 9
ASSERT y == 36

CLEARSTACK
PUSH 0
PUSH 3
PUSH 0
PUSH -1
2DIFFSQ
POP y
POP x
ASSERT x == 0
ASSERT y == 16

# PAIRDIFFSQ / DSQDIFF / DERRSQ
CLEARSTACK
PUSH 7
PUSH 7
PUSH 7
PUSH 8
PAIRDIFFSQ
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -3
PUSH 4
PUSH 1
PUSH 0
DSQDIFF
POP y
POP x
ASSERT x == 16
ASSERT y == 16

CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
PUSH 2
DERRSQ
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DSTEP unit step
CLEARSTACK
PUSH -1
PUSH 0
DSTEP
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 5
2STEP
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# PAIRSTEP / DHEAVI / DUNITSTEP
CLEARSTACK
PUSH 0
PUSH -10
PAIRSTEP
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 100
PUSH -1
DHEAVI
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 0
DUNITSTEP
POP y
POP x
ASSERT x == 1
ASSERT y == 0
