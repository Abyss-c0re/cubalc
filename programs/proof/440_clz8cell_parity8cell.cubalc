# Proof 440 — digit-0 cell fixed-width 8 metrics foundation: CLZ8CELL CTZ8CELL PARITY8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# CLZ8CELL: 0x0F → 4; 0x80 → 0; 0 → 8; 1 → 7
CELLSET 0 15
CELLSET 1 128
CELLSET 2 0
CELLSET 3 1
CLZ8CELL 0 3
ASSERT CELL(0) == 4
ASSERT CELL(1) == 0
ASSERT CELL(2) == 8
ASSERT CELL(3) == 7
ASSERT LAST_N == 4

# CTZ8CELL: 0xF0 → 4; 0x80 → 7; 0 → 8; 1 → 0
CELLSET 4 240
CELLSET 5 128
CELLSET 6 0
CELLSET 7 1
CTZ8CELL 4 7
ASSERT CELL(4) == 4
ASSERT CELL(5) == 7
ASSERT CELL(6) == 8
ASSERT CELL(7) == 0
ASSERT LAST_N == 4

# PARITY8CELL: 0x0F → 0 (4 ones); 0x01 → 1; 0xFF → 0; 0x03 → 0
CELLSET 8 15
CELLSET 9 1
CELLSET 10 255
CELLSET 11 3
PARITY8CELL 8 11
ASSERT CELL(8) == 0
ASSERT CELL(9) == 1
ASSERT CELL(10) == 0
ASSERT CELL(11) == 0
ASSERT LAST_N == 4

# PARITY8RANGE single: 0x07 → 1 (3 ones)
CELLSET 12 7
PARITY8RANGE 12 12
ASSERT CELL(12) == 1

# high bits above 8 ignored
CELLSET 13 256
CLZ8CELL 13 13
ASSERT CELL(13) == 8
CELLSET 14 256
CTZ8CELL 14 14
ASSERT CELL(14) == 8
CELLSET 15 257
PARITY8CELL 15 15
ASSERT CELL(15) == 1

HOLD_FLASH 0
