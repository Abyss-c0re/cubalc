# Proof 477 — digit-0 dual-stack imm 16-bit field div/mod/min: DDIV16N DMOD16N DMIN16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DDIV16N: 0x0064 / 10 → 10 ; 0x0032 / 10 → 5
PUSH 0x0064
PUSH 0x0032
DDIV16N 10 0
POP y
POP x
ASSERT x == 10
ASSERT y == 5

# floor both: 0x0017 / 5 → 4 ; 0x0016 / 5 → 4
CLEARSTACK
PUSH 0x0017
PUSH 0x0016
PAIRDIV16N 5 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# div by zero → 0 both
CLEARSTACK
PUSH 0xFFFF
PUSH 0x1234
DDIV16N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved: half0 / 4
CLEARSTACK
PUSH 0x11223344000000C8
PUSH 0x99AABBCC00000064
DDIV16N 4 0
POP y
POP x
ASSERT x == 0x1122334400000032
ASSERT y == 0x99AABBCC00000019

# S2DIV16N n1: half1 of 0x00640000 / 10 → 0x000A0000
CLEARSTACK
PUSH 0x00640000
PUSH 0x00C80000
S2DIV16N 10 1
POP y
POP x
ASSERT x == 0x000A0000
ASSERT y == 0x00140000

# DQUO16N alias
CLEARSTACK
PUSH 0x001E
PUSH 0x0012
DQUO16N 6 0
POP y
POP x
ASSERT x == 5
ASSERT y == 3

# DMOD16N: 0x0017 % 5 → 3 ; 0x0016 % 5 → 2
CLEARSTACK
PUSH 0x0017
PUSH 0x0016
DMOD16N 5 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# exact both
CLEARSTACK
PUSH 0x0064
PUSH 0x0032
PAIRMOD16N 10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mod by zero → 0
CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
DREM16N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# STACK2MOD16N n1
CLEARSTACK
PUSH 0x00170000
PUSH 0x00160000
STACK2MOD16N 5 1
POP y
POP x
ASSERT x == 0x00030000
ASSERT y == 0x00020000

# DMIN16N: min both with field
CLEARSTACK
PUSH 0xC000
PUSH 0x1000
DMIN16N 0x4000 0
POP y
POP x
ASSERT x == 0x4000
ASSERT y == 0x1000

# keeps smaller both
CLEARSTACK
PUSH 0x0010
PUSH 0x0020
PAIRMIN16N 0x9000 0
POP y
POP x
ASSERT x == 0x0010
ASSERT y == 0x0020

# high preserved min
CLEARSTACK
PUSH 0x112233440000FFFE
PUSH 0x99AABBCC0000ABCD
DMIN16N 0x20 0
POP y
POP x
ASSERT x == 0x1122334400000020
ASSERT y == 0x99AABBCC00000020

# S2MIN16N n1
CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x00110000
S2MIN16N 0x11 1
POP y
POP x
ASSERT x == 0x00110000
ASSERT y == 0x00110000

# DLE16N alias min equal
CLEARSTACK
PUSH 0x5555
PUSH 0x5555
DLE16N 0x5555 0
POP y
POP x
ASSERT x == 0x5555
ASSERT y == 0x5555

HOLD_FLASH 0
