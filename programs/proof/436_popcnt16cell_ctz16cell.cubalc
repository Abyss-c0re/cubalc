# Proof 436 — digit-9 cell fixed-width 16 metrics: POPCNT16CELL CLZ16CELL CTZ16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# POPCNT16CELL: 0x00FF → 8; 0xFFFF → 16; 0 → 0
CELLSET 0 255
CELLSET 1 65535
CELLSET 2 0
POPCNT16CELL 0 2
ASSERT CELL(0) == 8
ASSERT CELL(1) == 16
ASSERT CELL(2) == 0
ASSERT LAST_N == 3

# POPCNT16RANGE single: 0x8001 → 2
CELLSET 3 32769
POPCNT16RANGE 3 3
ASSERT CELL(3) == 2

# CLZ16CELL: 0x00FF → 8; 0x8000 → 0; 0 → 16; 1 → 15
CELLSET 4 255
CELLSET 5 32768
CELLSET 6 0
CELLSET 7 1
CLZ16CELL 4 7
ASSERT CELL(4) == 8
ASSERT CELL(5) == 0
ASSERT CELL(6) == 16
ASSERT CELL(7) == 15
ASSERT LAST_N == 4

# CTZ16CELL: 0x00F0 → 4; 0x8000 → 15; 0 → 16; 1 → 0
CELLSET 8 240
CELLSET 9 32768
CELLSET 10 0
CELLSET 11 1
CTZ16CELL 8 11
ASSERT CELL(8) == 4
ASSERT CELL(9) == 15
ASSERT CELL(10) == 16
ASSERT CELL(11) == 0
ASSERT LAST_N == 4

# high bits above 16 ignored for metrics
CELLSET 12 65537
POPCNT16CELL 12 12
ASSERT CELL(12) == 1
CELLSET 13 65536
CLZ16CELL 13 13
ASSERT CELL(13) == 16
CELLSET 14 65536
CTZ16CELL 14 14
ASSERT CELL(14) == 16

HOLD_FLASH 0
