# Proof 566 — digit-1 stack+dual field signed GE0 32/16: S0GE32N S0GE16N D0GE32N D0GE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0GE32N: 0 → 1
PUSH 0x0
S0GE32N 0
POP x
ASSERT x == 1

# positive → 1
CLEARSTACK
PUSH 0x5
SGE032N 0
POP x
ASSERT x == 1

# -1 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
SNONNEG32N 0
POP x
ASSERT x == 0

# INT_MIN → 0
CLEARSTACK
PUSH 0x80000000
SISNONNEG32N 0
POP x
ASSERT x == 0

# high preserve: low +3 → 1
CLEARSTACK
PUSH 0xAABBCCDD00000003
S0GE32N 0
POP x
ASSERT x == 0xAABBCCDD00000001

# high preserve: low -2 → 0
CLEARSTACK
PUSH 0x11223344FFFFFFFE
S0GE32N 0
POP x
ASSERT x == 0x1122334400000000

# STACK0GE32N n1: high positive → 1
CLEARSTACK
PUSH 0x0000000200000000
STACK0GE32N 1
POP x
ASSERT x == 0x0000000100000000

# high negative → 0
CLEARSTACK
PUSH 0xFFFFFFFE00000007
STACK0GE32N 1
POP x
ASSERT x == 0x0000000000000007

# high zero → 1
CLEARSTACK
PUSH 0x0000000000000007
STACK0GE32N 1
POP x
ASSERT x == 0x0000000100000007

# S0GE16N: 0 → 1
CLEARSTACK
PUSH 0x0
S0GE16N 0
POP x
ASSERT x == 1

# positive → 1
CLEARSTACK
PUSH 0x7
SGE016N 0
POP x
ASSERT x == 1

# -1=0xFFFF → 0
CLEARSTACK
PUSH 0xFFFF
SNONNEG16N 0
POP x
ASSERT x == 0

# INT16_MIN → 0
CLEARSTACK
PUSH 0x8000
SISNONNEG16N 0
POP x
ASSERT x == 0

# high halfword positive: n1 of 0x0005_0000 → high 1
CLEARSTACK
PUSH 0x00050000
STACK0GE16N 1
POP x
ASSERT x == 0x00010000

# high halfword zero → 1
CLEARSTACK
PUSH 0x00000007
STACK0GE16N 1
POP x
ASSERT x == 0x00010007

# high preserve: low positive
CLEARSTACK
PUSH 0x12340003
S0GE16N 0
POP x
ASSERT x == 0x12340001

# high preserve: low negative
CLEARSTACK
PUSH 0x1234FFFE
S0GE16N 0
POP x
ASSERT x == 0x12340000

# D0GE32N
CLEARSTACK
PUSH 0x5
PUSH 0xFFFFFFFE
D0GE32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0GE32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# STACK20GE32N n1
CLEARSTACK
PUSH 0x0000000300000000
PUSH 0xFFFFFFFD00000000
STACK20GE32N 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# D0GE16N
CLEARSTACK
PUSH 0x7
PUSH 0xFFFE
D0GE16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0GE16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# STACK20GE16N n1
CLEARSTACK
PUSH 0x00030000
PUSH 0xFFFD0000
STACK20GE16N 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

HOLD_FLASH 0
