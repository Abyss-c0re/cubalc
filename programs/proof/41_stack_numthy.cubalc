# Proof 41 — stack number theory digit-2: SPOW SGCD SLCM SSQR SISQRT SDIVCEIL SDIVFLOOR
HOLD_FLASH 1
SCIENCE LOAD

# SSQR
CLEARSTACK
PUSH 7
SSQR
ASSERT LAST_N == 49

# SISQRT
CLEARSTACK
PUSH 50
SISQRT
ASSERT LAST_N == 7
CLEARSTACK
PUSH -3
SISQRT
ASSERT LAST_N == 0

# SPOW
CLEARSTACK
PUSH 2
PUSH 10
SPOW
ASSERT LAST_N == 1024
CLEARSTACK
PUSH 5
PUSH 0
SPOW
ASSERT LAST_N == 1
CLEARSTACK
PUSH 3
PUSH -1
SPOW
ASSERT LAST_N == 0

# SGCD
CLEARSTACK
PUSH 48
PUSH 18
SGCD
ASSERT LAST_N == 6
CLEARSTACK
PUSH -48
PUSH 18
STACKGCD
ASSERT LAST_N == 6

# SLCM
CLEARSTACK
PUSH 4
PUSH 6
SLCM
ASSERT LAST_N == 12
CLEARSTACK
PUSH 0
PUSH 5
SLCM
ASSERT LAST_N == 0

# SDIVCEIL
CLEARSTACK
PUSH 10
PUSH 3
SDIVCEIL
ASSERT LAST_N == 4
CLEARSTACK
PUSH 9
PUSH 3
SCEILDIV
ASSERT LAST_N == 3

# SDIVFLOOR toward -inf
CLEARSTACK
PUSH -10
PUSH 3
SDIVFLOOR
ASSERT LAST_N == -4
# C trunc DIV would be -3; floor is -4
CLEARSTACK
PUSH 10
PUSH 3
SFLOORDIV
ASSERT LAST_N == 3

# underflow
CLEARSTACK
SPOW
ASSERT OK == 0
CLEARSTACK
SSQR
ASSERT OK == 0

# compose: gcd of squares then isqrt
CLEARSTACK
PUSH 6
SSQR
PUSH 8
SSQR
SGCD
# gcd(36,64)=4
ASSERT LAST_N == 4
SISQRT
ASSERT LAST_N == 2

# compose with SPOW + SMIN
CLEARSTACK
PUSH 2
PUSH 5
SPOW
PUSH 40
SMIN
ASSERT LAST_N == 32

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof41_stack_numthy" LAST_N SP
