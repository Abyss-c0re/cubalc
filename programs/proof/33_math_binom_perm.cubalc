# Proof 33 — math digit-2: SQR DIVFLOOR BINOM/CHOOSE PERM
HOLD_FLASH 1
SCIENCE LOAD

# SQR
ASSERT SQR(0) == 0
ASSERT SQR(7) == 49
ASSERT SQUARE(12) == 144
ASSERT SQR(-5) == 25

# DIVFLOOR toward -inf
ASSERT DIVFLOOR(7, 3) == 2
ASSERT DIVFLOOR(6, 3) == 2
ASSERT DIVFLOOR(-7, 3) == -3
ASSERT DIVFLOOR(7, -3) == -3
ASSERT DIVFLOOR(-7, -3) == 2
ASSERT DIVFLOOR(5, 0) == 0
ASSERT FLOORDIV(10, 4) == 2

# BINOM / CHOOSE
ASSERT BINOM(5, 2) == 10
ASSERT BINOM(10, 0) == 1
ASSERT BINOM(10, 10) == 1
ASSERT BINOM(10, 1) == 10
ASSERT CHOOSE(6, 3) == 20
ASSERT BINOM(8, 3) == 56
ASSERT BINOM(5, 6) == 0
ASSERT BINOM(-1, 2) == 0

# PERM
ASSERT PERM(5, 2) == 20
ASSERT PERM(5, 0) == 1
ASSERT PERM(5, 5) == 120
ASSERT PNR(6, 3) == 120
ASSERT PERM(4, 5) == 0

# compose with existing modular / fib
ASSERT BINOM(FIB(6), 2) == BINOM(8, 2)
ASSERT SQR(ILOG2(16)) == 16
ASSERT DIVCEIL(10, 3) == 4
ASSERT DIVFLOOR(10, 3) == 3

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof33_math_binom" BINOM(10,3) PERM(5,2) SQR(9)
