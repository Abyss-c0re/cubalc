# Proof 162 — digit-4 dual-stack control words: DLO8 DHI8 DPACK8
HOLD_FLASH 1
SCIENCE LOAD

# DLO8
CLEARSTACK
PUSH 0x1234
PUSH 0xAB
DLO8
POP y
POP x
ASSERT x == 0x34
ASSERT y == 0xAB

CLEARSTACK
PUSH 256
PUSH -1
2LO8
POP y
POP x
ASSERT x == 0
ASSERT y == 255

# DHI8
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
DHI8
POP y
POP x
ASSERT x == 0x12
ASSERT y == 0xAB

CLEARSTACK
PUSH 0xFF00
PUSH 0x00FF
2HI8
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0

# DPACK8 — a b c d → (a<<8|c) (b<<8|d)
CLEARSTACK
PUSH 0x12
PUSH 0xAB
PUSH 0x34
PUSH 0xCD
DPACK8
POP y
POP x
ASSERT x == 0x1234
ASSERT y == 0xABCD

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2PACK8
POP y
POP x
ASSERT x == 0x0103
ASSERT y == 0x0204

# round-trip style
CLEARSTACK
PUSH 0x1122
PUSH 0x3344
DHI8
POP hb
POP ha
CLEARSTACK
PUSH 0x1122
PUSH 0x3344
DLO8
POP lb
POP la
CLEARSTACK
PUSH ha
PUSH hb
PUSH la
PUSH lb
DPACK8
POP y
POP x
ASSERT x == 0x1122
ASSERT y == 0x3344

# aliases
CLEARSTACK
PUSH 0x0F0F
PUSH 0xF0F0
PAIRLO8
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0xF0

CLEARSTACK
PUSH 0x0A
PUSH 0x0B
PUSH 0x0C
PUSH 0x0D
PAIRPACK8
POP y
POP x
ASSERT x == 0x0A0C
ASSERT y == 0x0B0D

# soft fails
CLEARSTACK
DLO8
ASSERT OK == 0
CLEARSTACK
DHI8
ASSERT OK == 0
CLEARSTACK
DPACK8
ASSERT OK == 0
CLEARSTACK
PUSH 1
2LO8
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2PACK8
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof162_dlo8_dpack8" LAST_N SP
