# Proof 459 — digit-7 cell fixed-width 4 nibble math: NEG4CELL ZEXT4CELL CLIP4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NEG4CELL: 0x3 → -3; 0xE (-2) → 2; min 0x8 stays -8
CELLSET 0 3
CELLSET 1 14
CELLSET 2 8
NEG4CELL 0 2
ASSERT CELL(0) == -3
ASSERT CELL(1) == 2
ASSERT CELL(2) == -8
ASSERT LAST_N == 3

# NEG4RANGE: 0x1 → -1
CELLSET 3 1
NEG4RANGE 3 3
ASSERT CELL(3) == -1

# ZEXT4CELL: clear high bits — 0x13 → 0x3; 0xFF → 0xF
CELLSET 4 19
CELLSET 5 255
ZEXT4CELL 4 5
ASSERT CELL(4) == 3
ASSERT CELL(5) == 15
ASSERT LAST_N == 2

# ZEXT4RANGE: 0x20 → 0
CELLSET 6 32
ZEXT4RANGE 6 6
ASSERT CELL(6) == 0

# CLIP4CELL: clamp to [0,15]
CELLSET 7 -5
CELLSET 8 20
CELLSET 9 7
CLIP4CELL 7 9
ASSERT CELL(7) == 0
ASSERT CELL(8) == 15
ASSERT CELL(9) == 7
ASSERT LAST_N == 3

# CLIP4RANGE: 100 → 15
CELLSET 10 100
CLIP4RANGE 10 10
ASSERT CELL(10) == 15

# CELLNEG4 alias: 0x5 → -5
CELLSET 11 5
CELLNEG4 11 11
ASSERT CELL(11) == -5

# ZEXTNIBCELL alias
CELLSET 12 0x2B
ZEXTNIBCELL 12 12
ASSERT CELL(12) == 11

# CLIPNIBCELL alias: -1 → 0
CELLSET 13 -1
CLIPNIBCELL 13 13
ASSERT CELL(13) == 0

# double ZEXT idempotent
CELLSET 14 0x47
ZEXT4CELL 14 14
ZEXT4CELL 14 14
ASSERT CELL(14) == 7

HOLD_FLASH 0
