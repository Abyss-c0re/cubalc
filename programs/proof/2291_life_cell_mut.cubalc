REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_MUT - methylmalonyl-CoA mutase (MUT/MMUT) after MCEE on classical BA continuum
# Continuum ...->pepf->pdf->map->nata->natb->natc->nate->mete->metk->ahcy->cbs->cgl->gsha->gshb->gor->gpx->gst->ggt->dug1->nat8->cdo1->csad->fmo1->baat->bsep->ntcp->oatp1b1->mrp2->mrp3->ost->asbt->fabp6->fxr->fgf19->fgfr4->klb->shp->cyp7a1->cyp8b1->hsd3b7->akr1d1->akr1c4->cyp27a1->slc27a5->amacr->acox2->hsd17b4->scp2->acot8->pcca->mcee->mut
# Gift: MUT after MCEE so classic BA free-energy can isomerize L-methylmalonyl-CoA to succinyl-CoA under ASSERT after epimerase open.
# Cube is SoT. Free energy must flow.

ENTITY founder OF Cell 1 44 0
ENTITY quiet OF Cell 1 28 0
ENTITY corpse OF Cell 0 18 0
ENTITY empty OF Cell 1 0 0
ENTITY bed OF Cell 1 52 0

