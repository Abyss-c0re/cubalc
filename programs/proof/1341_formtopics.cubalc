# FORMTOPICS / TOPICSOF — reverse FORMSFOR (form → covering topics)

FORMTOPICS HASFORM
ASSERT OK == 1
ASSERT FORMTOPICS_OF == "HASFORM"
ASSERT FORMTOPICS_N >= 1
ASSERT LAST_N >= 1
SYS HASI "cap"
ASSERT LAST_N == 1

# multi-topic form
FORMTOPICS INCLUDE
ASSERT OK == 1
ASSERT FORMTOPICS_N >= 2
SYS HASI "general"
ASSERT LAST_N == 1
SYS HASI "lib"
ASSERT LAST_N == 1

FORMTOPICS STATUS
ASSERT OK == 1
ASSERT FORMTOPICS_N >= 2
SYS HASI "general"
ASSERT LAST_N == 1
SYS HASI "fat"
ASSERT LAST_N == 1

# plate form
TOPICSOF SETP
ASSERT OK == 1
ASSERT FORMTOPICS_OF == "SETP"
SYS HASI "plate"
ASSERT LAST_N == 1

FORMTOPICS FORMHINT
ASSERT OK == 1
SYS HASI "cap"
ASSERT LAST_N == 1

# chain: first topic → TOPICHINT
FORMTOPICS HASFORM
SYS NTH 0
TOPICHINT LAST
ASSERT OK == 1
ASSERT LAST_N >= 5

# discovery forms
FORMTOPICS RELATEDTOPIC
ASSERT OK == 1
SYS HASI "general"
ASSERT LAST_N == 1

# quoted — bare FORMTOPICS would resolve to prior bag var
FORMTOPICS "FORMTOPICS"
ASSERT OK == 1
ASSERT FORMTOPICS_N >= 1

# miss soft
FORMTOPICS ZZZ_NO_SUCH_FORM
ASSERT OK == 0
CLEAR_ERR

# need name
FORMTOPICS
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1341_formtopics: PASS"
