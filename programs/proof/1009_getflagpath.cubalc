# GETFLAGPATH / FLAGPATH — path peel + absolute resolve

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CONFIG

# default relative → abspath
GETFLAGPATH conf|c OR ENV CONFIG OR "state/MEANINGFUL_ITER.json"
ASSERT GETFLAGPATH_HIT == 0
SYS EQS GETFLAGPATH_SRC "default"
ASSERT LAST_N == 1
# should be absolute (starts with /)
SYS STARTS LAST "/"
ASSERT LAST_N == 1
# plate file should exist in workspace
ASSERT GETFLAGPATH_EXIST == 1
LET abs1 = LAST

# ENV wins over default
SYS ENV SET CONFIG "include/cubalc_law.h"
GETFLAGPATH conf OR ENV CONFIG OR "missing.xyz"
SYS EQS GETFLAGPATH_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "CONFIG"
ASSERT LAST_N == 1
ASSERT GETFLAGPATH_EXIST == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS HAS LAST
# ends with header name
SYS ENDS LAST "cubalc_law.h"
ASSERT LAST_N == 1

# CLI beats ENV
SYS ENV SET CONFIG "include/cubalc_law.h"
SYS ENV SET CUBALC_ARG0 "--conf"
SYS ENV SET CUBALC_ARG1 "docs/MEANINGFUL_ITER.md"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGPATH conf|c OR ENV CONFIG OR "x"
ASSERT GETFLAGPATH_HIT == 1
SYS EQS GETFLAGPATH_SRC "cli"
ASSERT LAST_N == 1
ASSERT GETFLAGPATH_EXIST == 1
SYS ENDS LAST "MEANINGFUL_ITER.md"
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "conf"
ASSERT LAST_N == 1

# short -c
SYS ENV SET CUBALC_ARG0 "-c"
SYS ENV SET CUBALC_ARG1 "Makefile"
SYS ENV SET CUBALC_ARGC "2"
FLAGPATH conf|c OR "none"
ASSERT GETFLAGPATH_HIT == 1
SYS EQS FLAG_HIT_NAME "c"
ASSERT LAST_N == 1
ASSERT GETFLAGPATH_EXIST == 1
SYS ENDS LAST "Makefile"
ASSERT LAST_N == 1

# missing path still absolute, EXIST=0
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CONFIG
GETFLAGPATH conf OR "no/such/file_xyz.cubalc"
ASSERT GETFLAGPATH_EXIST == 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS HAS GETFLAGPATH_RAW
SYS EQS GETFLAGPATH_RAW "no/such/file_xyz.cubalc"
ASSERT LAST_N == 1

PRINT "getflagpath ok"
