# Proof 45 — stack number predicates digit-2: SFIB SISPRIME SISPOW2 SPOW2 SNDIGITS SDIGSUM
HOLD_FLASH 1
SCIENCE LOAD

# SFIB
CLEARSTACK
PUSH 10
SFIB
ASSERT LAST_N == 55
CLEARSTACK
PUSH 1
SFIB
ASSERT LAST_N == 1
CLEARSTACK
PUSH 0
SFIB
ASSERT LAST_N == 0

# SISPRIME
CLEARSTACK
PUSH 17
SISPRIME
ASSERT LAST_N == 1
CLEARSTACK
PUSH 15
SPRIME
ASSERT LAST_N == 0
CLEARSTACK
PUSH 2
SISPRIME
ASSERT LAST_N == 1

# SISPOW2 / SPOW2
CLEARSTACK
PUSH 16
SISPOW2
ASSERT LAST_N == 1
CLEARSTACK
PUSH 12
SISPOW2
ASSERT LAST_N == 0
CLEARSTACK
PUSH 8
SPOW2
ASSERT LAST_N == 256
CLEARSTACK
PUSH 63
SPOW2
ASSERT LAST_N == 0

# SNDIGITS / SDIGSUM
CLEARSTACK
PUSH 12345
SNDIGITS
ASSERT LAST_N == 5
CLEARSTACK
PUSH -99
SNDIG
ASSERT LAST_N == 2
CLEARSTACK
PUSH 12345
SDIGSUM
ASSERT LAST_N == 15
CLEARSTACK
PUSH 0
SDIGSUM
ASSERT LAST_N == 0

# underflow
CLEARSTACK
SFIB
ASSERT OK == 0

# compose: fib then isprime?
CLEARSTACK
PUSH 7
SFIB
# fib(7)=13 prime
SISPRIME
ASSERT LAST_N == 1

# compose: pow2 then ispow2
CLEARSTACK
PUSH 5
SPOW2
SISPOW2
ASSERT LAST_N == 1

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof45_stack_numpred" LAST_N SP
