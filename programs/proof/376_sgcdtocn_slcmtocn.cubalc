# Proof 376 — digit-2 imm numthy TOC: SGCDTOCN SLCMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SGCDTOCN: gcd(48,18)=6
CELLSET 1 48
PUSH 1
SGCDTOCN 18
ASSERT LAST_N == 6
ASSERT CELL(1) == 6
POP a
ASSERT a == 6

# SGCDTOCN negatives: gcd(|-21|,14)=7
CELLSET 2 0
LET n = 0 - 21
CELLSET 2 n
PUSH 2
GCDTOCN 14
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SGCDTOCN with 0: gcd(15,0)=15
CELLSET 3 15
PUSH 3
SGCDTOCN 0
ASSERT LAST_N == 15
ASSERT CELL(3) == 15
POP

# SLCMTOCN: lcm(4,6)=12
CELLSET 4 4
PUSH 4
SLCMTOCN 6
ASSERT LAST_N == 12
ASSERT CELL(4) == 12
POP

# SLCMTOCN zeros: lcm(0,5)=0
CELLSET 5 0
PUSH 5
LCMTOCN 5
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SLCMTOCN coprime: lcm(7,5)=35
CELLSET 6 7
PUSH 6
SLCMTOCN 5
ASSERT LAST_N == 35
ASSERT CELL(6) == 35
POP

# soft empty OK=0
CLEARSTACK
SGCDTOCN 3
ASSERT OK == 0

PRINT "376_sgcdtocn_slcmtocn OK"
