# Proof 366 — digit-0 foundation forward unsigned imm TOC: SUDIVTOCN SUMODTOCN SUMINTOCN SUMAXTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SUDIVTOCN: 100 / 7 = 14 (unsigned)
CELLSET 1 100
PUSH 1
SUDIVTOCN 7
ASSERT LAST_N == 14
ASSERT CELL(1) == 14
POP a
ASSERT a == 14

# UDIVTOCN: 17 / 5 = 3
CELLSET 2 17
PUSH 2
UDIVTOCN 5
ASSERT LAST_N == 3
ASSERT CELL(2) == 3
POP

# soft n==0 → 0
CELLSET 3 9
PUSH 3
SUDIVTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SUMODTOCN: 100 % 7 = 2
CELLSET 4 100
PUSH 4
SUMODTOCN 7
ASSERT LAST_N == 2
ASSERT CELL(4) == 2
POP

# UMODTOCN: 17 % 5 = 2
CELLSET 5 17
PUSH 5
UMODTOCN 5
ASSERT LAST_N == 2
ASSERT CELL(5) == 2
POP

# soft n==0 → 0
CELLSET 6 11
PUSH 6
SUMODTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SUMINTOCN: umin(5, 3) = 3
CELLSET 7 5
PUSH 7
SUMINTOCN 3
ASSERT LAST_N == 3
ASSERT CELL(7) == 3
POP

# UMINTOCN: umin(2, 9) = 2
CELLSET 8 2
PUSH 8
UMINTOCN 9
ASSERT LAST_N == 2
ASSERT CELL(8) == 2
POP

# SUMAXTOCN: umax(5, 3) = 5
CELLSET 9 5
PUSH 9
SUMAXTOCN 3
ASSERT LAST_N == 5
ASSERT CELL(9) == 5
POP

# UMAXTOCN: umax(2, 9) = 9
CELLSET 10 2
PUSH 10
UMAXTOCN 9
ASSERT LAST_N == 9
ASSERT CELL(10) == 9
POP

# soft empty OK=0
CLEARSTACK
SUDIVTOCN 5
ASSERT OK == 0

PRINT "366_sudivtocn_sumaxtocn OK"
