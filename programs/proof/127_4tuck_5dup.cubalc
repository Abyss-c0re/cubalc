# Proof 127 — digit-8 depth duals: 4TUCK 5DUP 5DROP 5SWAP
HOLD_FLASH 1
SCIENCE LOAD

# 4TUCK — a b c d → d a b c d
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4TUCK
ASSERT SP == 5
ASSERT LAST_N == 4
POP a
POP b
POP c
POP d
POP e
ASSERT e == 4
ASSERT d == 1
ASSERT c == 2
ASSERT b == 3
ASSERT a == 4

# QTUCK alias
CLEARSTACK
PUSH 9
PUSH 8
PUSH 7
PUSH 6
QTUCK
ASSERT SP == 5
POP a
ASSERT a == 6

# 5DUP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
5DUP
ASSERT SP == 10
ASSERT LAST_N == 5
POP a
POP b
POP c
POP d
POP e
ASSERT e == 1
ASSERT d == 2
ASSERT c == 3
ASSERT b == 4
ASSERT a == 5
POP a
ASSERT a == 5

# DUP5 alias
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
PUSH 50
DUP5
ASSERT SP == 10

# 5DROP
CLEARSTACK
PUSH 99
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
5DROP
ASSERT SP == 1
ASSERT LAST_N == 99

# 5SWAP — reverse top 5
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
5SWAP
ASSERT SP == 5
ASSERT LAST_N == 1
POP a
POP b
POP c
POP d
POP e
ASSERT e == 5
ASSERT d == 4
ASSERT c == 3
ASSERT b == 2
ASSERT a == 1

# SWAP5 alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
SWAP5
5SWAP
POP a
POP b
POP c
POP d
POP e
ASSERT e == 1
ASSERT d == 2
ASSERT c == 3
ASSERT b == 4
ASSERT a == 5

# soft fails
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
4TUCK
ASSERT OK == 0
5DUP
ASSERT OK == 0
5DROP
ASSERT OK == 0
5SWAP
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof127_4tuck_5dup" LAST_N SP
