# Proof 239 — digit-0 dual-stack inverted high-n mask: DNANDHN DNORHN DXNORHN
HOLD_FLASH 1
SCIENCE LOAD

# DNANDHN — ~(x & himask)
CLEARSTACK
PUSH -1
PUSH 0
DNANDHN 8
POP y
POP x
# ~(-1 & 0xFF00..00) = ~0xFF00..00 = 0x00FF..FF
ASSERT x == 0x00FFFFFFFFFFFFFF
ASSERT y == -1

CLEARSTACK
PUSH 0xFF00000000000000
PUSH 0x00FF000000000000
2NANDHN 16
POP y
POP x
ASSERT x == 0x00FFFFFFFFFFFFFF
ASSERT y == 0xFF00FFFFFFFFFFFF

# PAIRNANDHN n=0 → ~0 = -1
CLEARSTACK
PUSH 5
PUSH 7
PAIRNANDHN 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DNORHN — ~(x | himask)
CLEARSTACK
PUSH 0
PUSH 1
DNORHN 8
POP y
POP x
# ~(0|hm8)= ~hm8 = 0x00FF..FF; ~(1|hm8)= same low plus bit0 clear in high only
ASSERT x == 0x00FFFFFFFFFFFFFF
ASSERT y == 0x00FFFFFFFFFFFFFE

CLEARSTACK
PUSH 0x0000FFFFFFFFFFFF
PUSH 0
2NORHN 16
POP y
POP x
ASSERT x == 0
ASSERT y == 0x0000FFFFFFFFFFFF

# DXNORHN — ~(x ^ himask)
CLEARSTACK
PUSH 0
PUSH -1
DXNORHN 8
POP y
POP x
# ~(0^hm)= ~hm = 0x00FF..FF; ~(-1^hm)= ~(~hm)= hm
ASSERT x == 0x00FFFFFFFFFFFFFF
ASSERT y == 0xFF00000000000000

# double XNORHN identity
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
DEQUIVHN 12
POP y
POP x
CLEARSTACK
PUSH x
PUSH y
DXNORHN 12
POP y2
POP x2
ASSERT x2 == 0x1234
ASSERT y2 == 0xABCD

# 2XNORHN
CLEARSTACK
PUSH 0xFF00000000000000
PUSH 0
2XNORHN 8
POP y
POP x
ASSERT x == -1
ASSERT y == 0x00FFFFFFFFFFFFFF

# soft fails
CLEARSTACK
DNANDHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DNORHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DXNORHN 4
ASSERT OK == 0

HOLD_FLASH 1
