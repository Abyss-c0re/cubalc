# Proof 251 — digit-2 stack immediate modular ALU: SADDMODN SSUBMODN SMULMODN
HOLD_FLASH 1
SCIENCE LOAD

# SADDMODN
CLEARSTACK
PUSH 10
SADDMODN 5 7
POP x
# (10%7 + 5%7) % 7 = (3+5)%7 = 1
ASSERT x == 1

CLEARSTACK
PUSH 3
STACKADDMODN 4 5
POP x
# (3+4)%5 = 2
ASSERT x == 2

# SSUBMODN
CLEARSTACK
PUSH 3
SSUBMODN 5 7
POP x
# (3-5+7)%7 = 5
ASSERT x == 5

CLEARSTACK
PUSH 10
STACKSUBMODN 3 8
POP x
# (2-3+8)%8 = 7
ASSERT x == 7

# SMULMODN
CLEARSTACK
PUSH 6
SMULMODN 7 13
POP x
# 6*7 = 42 % 13 = 3
ASSERT x == 3

CLEARSTACK
PUSH 5
STACKMULMODN 5 11
POP x
# 25 % 11 = 3
ASSERT x == 3

# MULMODN alias
CLEARSTACK
PUSH 9
MULMODN 9 10
POP x
ASSERT x == 1

# m<=0 → 0
CLEARSTACK
PUSH 5
SADDMODN 1 0
POP x
ASSERT x == 0

# soft fails
CLEARSTACK
SADDMODN 1 5
ASSERT OK == 0
CLEARSTACK
SSUBMODN 1 5
ASSERT OK == 0
CLEARSTACK
SMULMODN 1 5
ASSERT OK == 0

HOLD_FLASH 1
