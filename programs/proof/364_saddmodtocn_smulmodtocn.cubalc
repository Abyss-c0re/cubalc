# Proof 364 — digit-3 forward imm modular TOC: SADDMODTOCN SSUBMODTOCN SMULMODTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SADDMODTOCN: (10+7) mod 12 = 5
CELLSET 1 10
PUSH 1
SADDMODTOCN 7 12
ASSERT LAST_N == 5
ASSERT CELL(1) == 5
POP a
ASSERT a == 5

# ADDMODTOCN: (11+1) mod 10 = 2
CELLSET 2 11
PUSH 2
ADDMODTOCN 1 10
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# soft m<=0 → 0
CELLSET 3 9
PUSH 3
SADDMODTOCN 1 0
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SSUBMODTOCN: (3-5) mod 12 = 10
CELLSET 4 3
PUSH 4
SSUBMODTOCN 5 12
ASSERT LAST_N == 10
ASSERT CELL(4) == 10
POP

# SUBMODTOCN: (0-1) mod 7 = 6
CELLSET 5 0
PUSH 5
SUBMODTOCN 1 7
ASSERT LAST_N == 6
ASSERT CELL(5) == 6
POP

# SMULMODTOCN: (7*8) mod 11 = 1
CELLSET 6 7
PUSH 6
SMULMODTOCN 8 11
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# MULMODTOCN: (6*7) mod 13 = 3
CELLSET 7 6
PUSH 7
MULMODTOCN 7 13
ASSERT LAST_N == 3
ASSERT CELL(7) == 3
POP

# SMULMODATN: (5*5) mod 7 = 4
CELLSET 8 5
PUSH 8
SMULMODATN 5 7
ASSERT LAST_N == 4
ASSERT CELL(8) == 4
POP

# soft empty OK=0
CLEARSTACK
SADDMODTOCN 1 5
ASSERT OK == 0

PRINT "364_saddmodtocn_smulmodtocn OK"
