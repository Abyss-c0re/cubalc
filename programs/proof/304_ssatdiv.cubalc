# Proof 304 — digit-3 stack sat div: SSATDIV (complete SSAT* plane)
HOLD_FLASH 1
SCIENCE LOAD

# SSATDIV normal
CLEARSTACK
PUSH 20
PUSH 4
SSATDIV
POP x
ASSERT x == 5

CLEARSTACK
PUSH -20
PUSH 3
STACKSATDIV
POP x
ASSERT x == -6

CLEARSTACK
PUSH 7
PUSH 2
SATDIVST
POP x
ASSERT x == 3

# /0 → 0
CLEARSTACK
PUSH 99
PUSH 0
SSATDIV
POP x
ASSERT x == 0

# LONG_MIN / -1 → LONG_MAX
CLEARSTACK
PUSH 1
SSHLN 63
PUSH -1
SSATDIV
POP x
ASSERT x == 9223372036854775807

# soft fail
CLEARSTACK
SSATDIV
ASSERT OK == 0
CLEARSTACK
PUSH 1
SSATDIV
ASSERT OK == 0

# still works with siblings
CLEARSTACK
PUSH 10
PUSH 20
SSATADD
POP x
ASSERT x == 30

HOLD_FLASH 1
