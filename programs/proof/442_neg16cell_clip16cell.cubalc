# Proof 442 — digit-7 cell fixed-width 16 math: NEG16CELL ZEXT16CELL CLIP16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NEG16CELL: 100 → -100; -100 (0xFF9C) → 100; min int16 0x8000 stays
CELLSET 0 100
CELLSET 1 65436
CELLSET 2 32768
NEG16CELL 0 2
ASSERT CELL(0) == -100
ASSERT CELL(1) == 100
ASSERT CELL(2) == 32768
ASSERT LAST_N == 3

# ZEXT16CELL: clear high bits
CELLSET 3 131071
CELLSET 4 65535
ZEXT16CELL 3 4
ASSERT CELL(3) == 65535
ASSERT CELL(4) == 65535
ASSERT LAST_N == 2

# CLIP16CELL: clamp to [0,65535]
CELLSET 5 65436
SEXT16CELL 5 5
CELLSET 6 1000
CELLSET 7 100000
CLIP16CELL 5 7
ASSERT CELL(5) == 0
ASSERT CELL(6) == 1000
ASSERT CELL(7) == 65535
ASSERT LAST_N == 3

# CLIP16RANGE single
CELLSET 8 70000
CLIP16RANGE 8 8
ASSERT CELL(8) == 65535

# round-trip NEG then ABS16 of 42
CELLSET 9 42
NEG16CELL 9 9
ABS16CELL 9 9
ASSERT CELL(9) == 42

# ZEXT after SEXT of 0x8000
CELLSET 10 32768
SEXT16CELL 10 10
ASSERT CELL(10) == -32768
ZEXT16CELL 10 10
ASSERT CELL(10) == 32768

HOLD_FLASH 0
