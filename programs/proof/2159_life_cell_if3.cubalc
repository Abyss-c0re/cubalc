// 2159_life_cell_if3.cubalc
// Proof 2159: life_cell if3 - post-rrf IF3 30S anti-association gate.
// Pay min(n,energy) -> heat+n energy-n; age/atp/pcr/reserve/pmf/sp/thr held.
// Continuum after rrf. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 40 0
ENTITY poor OF Cell 1 0 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 24 0
ENTITY twin OF Cell 1 30 0
ENTITY ceil OF Cell 1 28 0
ENTITY starved OF Cell 1 36 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND ceil set_threshold 10
SEND starved set_threshold 10
SEND gate pulse 6
SEND gate photosynth 40
SEND gate glycolyse 36
SEND gate pump 28
SEND gate photophos 28
SEND gate photosynth 36
SEND gate glycolyse 30
SEND gate pump 20
SEND gate charge 40
SEND gate feed 40
GETF gate age
ASSERT LAST_N == 6 "af a6"
GETF gate atp
ASSERT LAST_N >= 20 "af atp"
GETF gate pmf
LET pbase = LAST_N
ASSERT pbase >= 5 "af pmf"
SEND gate trim 8
ASSERT LAST_N == 8 "pre trim"
SEND gate cnx 4
ASSERT LAST_N == 4 "pre cnx"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 16
SEND gate uggt 4
ASSERT LAST_N == 4 "pre uggt"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate mann 6
ASSERT LAST_N == 6 "pre mann"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate os9 5
ASSERT LAST_N == 5 "pre os9"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate hrd 4
ASSERT LAST_N == 4 "pre hrd"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate vcp 4
ASSERT LAST_N == 4 "pre vcp"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate psm 4
ASSERT LAST_N == 4 "pre psm"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate pepr 4
ASSERT LAST_N == 4 "pre pepr"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate aars 4
ASSERT LAST_N == 4 "pre aars"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 14
SEND gate eftu 4
ASSERT LAST_N == 4 "pre eftu"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate ptc 4
ASSERT LAST_N == 4 "pre ptc"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 14
SEND gate efg 4
ASSERT LAST_N == 4 "pre efg"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate rf1 4
ASSERT LAST_N == 4 "pre rf1"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 14
SEND gate rf3 4
ASSERT LAST_N == 4 "pre rf3"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 16
SEND gate rrf 4
ASSERT LAST_N == 4 "pre rrf"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20

GETF gate heat
LET h0 = LAST_N
GETF gate energy
LET e0 = LAST_N
GETF gate atp
LET a0 = LAST_N
GETF gate pcr
LET c0 = LAST_N
GETF gate reserve
LET r0 = LAST_N
GETF gate age
LET age0 = LAST_N
GETF gate pmf
LET pmf0 = LAST_N
GETF gate setpoint
LET sp0 = LAST_N
GETF gate threshold
LET thr0 = LAST_N

SEND gate if3 5
ASSERT LAST_N == 5 "gate if3"

GETF gate heat
ASSERT LAST_N == h0 + 5 "h+5"
GETF gate energy
ASSERT LAST_N == e0 - 5 "e-5"
GETF gate atp
ASSERT LAST_N == a0 "atp held"
GETF gate pcr
ASSERT LAST_N == c0 "pcr held"
GETF gate reserve
ASSERT LAST_N == r0 "reserve held"
GETF gate age
ASSERT LAST_N == age0 "age held"
GETF gate pmf
ASSERT LAST_N == pmf0 "pmf held"
GETF gate setpoint
ASSERT LAST_N == sp0 "sp held"
GETF gate threshold
ASSERT LAST_N == thr0 "thr held"
GETF gate alive
ASSERT LAST_N == 1 "alive"

SEND dead if3 3
ASSERT LAST_N == 0 "dead0"
SEND poor if3 3
ASSERT LAST_N == 0 "poor0"
SEND gate if3 0
ASSERT LAST_N == 0 "n0"
SEND gate if3 -2
ASSERT LAST_N == 0 "nneg"

# starved clamp to energy
SEND starved pulse 4
SEND starved photosynth 20
SEND starved glycolyse 12
SEND starved charge 8
SEND starved feed 6
GETF starved energy
LET se = LAST_N
SEND starved if3 100
LET st = LAST_N
ASSERT st >= 1 "starved take>=1"
ASSERT st <= se "starved <=e"

# twin continuum rf3->rrf->if3
SEND twin pulse 4
SEND twin photosynth 36
SEND twin glycolyse 30
SEND twin charge 28
SEND twin feed 24
SEND twin charge_pcr 16
SEND twin aars 3
ASSERT LAST_N == 3 "twin aars"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 12
SEND twin eftu 3
ASSERT LAST_N == 3 "twin eftu"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin ptc 3
ASSERT LAST_N == 3 "twin ptc"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 12
SEND twin efg 3
ASSERT LAST_N == 3 "twin efg"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin rf1 3
ASSERT LAST_N == 3 "twin rf1"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 12
SEND twin rf3 3
ASSERT LAST_N == 3 "twin rf3"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 14
SEND twin rrf 3
ASSERT LAST_N == 3 "twin rrf"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
GETF twin heat
LET th0 = LAST_N
GETF twin energy
LET te0 = LAST_N
GETF twin atp
LET ta0 = LAST_N
GETF twin reserve
LET tr0 = LAST_N
SEND twin if3 3
ASSERT LAST_N == 3 "twin if3"
GETF twin heat
ASSERT LAST_N == th0 + 3 "twin h+3"
GETF twin energy
ASSERT LAST_N == te0 - 3 "twin e-3"
GETF twin atp
ASSERT LAST_N == ta0 "twin atp held"
GETF twin reserve
ASSERT LAST_N == tr0 "twin r held"
GETF twin alive
ASSERT LAST_N == 1 "twin alive"

# ceil path
SEND ceil pulse 5
SEND ceil photosynth 40
SEND ceil glycolyse 32
SEND ceil charge 36
SEND ceil feed 28
SEND ceil charge_pcr 16
SEND ceil aars 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 12
SEND ceil eftu 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil ptc 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 12
SEND ceil efg 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil rf1 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 12
SEND ceil rf3 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 14
SEND ceil rrf 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
GETF ceil energy
LET ce0 = LAST_N
GETF ceil heat
LET ch0 = LAST_N
SEND ceil if3 4
ASSERT LAST_N == 4 "ceil if3"
GETF ceil energy
ASSERT LAST_N == ce0 - 4 "ceil e-4"
GETF ceil heat
ASSERT LAST_N == ch0 + 4 "ceil h+4"

# g0 quiescent holds ready 0
SEND g0 set_threshold 10
SEND g0 pulse 3
SEND g0 photosynth 30
SEND g0 glycolyse 24
SEND g0 charge 28
SEND g0 feed 20
SEND g0 charge_pcr 14
SEND g0 quiesce
SEND g0 if3 2
ASSERT LAST_N == 2 "g0 if3"
GETF g0 ready
ASSERT LAST_N == 0 "g0 ready0"

ASSERT 1 == 1 "2159_life_cell_if3 sealed"
