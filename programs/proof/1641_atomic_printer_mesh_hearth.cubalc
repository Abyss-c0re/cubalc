// 1641_atomic_printer_mesh_hearth.cubalc — proof twin
// Life-force gift: MESH-HEARTH — colony mitosis under free energy first;
// SEAL parent mind as hearth root; SEAL each live daughter as hearth ember;
// OPEN hearth root onto scrap so the nest holds one shared home frame;
// soft-OOB storms against the hearth stay fail-closed (no ghost thrash);
// RECOVER restores vital/key; dual SEAL/OPEN quorum rebinds mesh;
// second post-hearth storm still fails closed.
// Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_hearth | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Live full mesh ring before life window
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "pre-life mesh live"
ASSERT SMX_TALKS >= 6 "pre-life talks"
ASSERT CUBES == base_cubes "pre-life identity"

// Mitosis under free energy — births first, then raise the hearth
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis before hearth"
GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT pop >= 2 "population after life"
ASSERT CUBES == base_cubes "life invents no cubes"

// SEAL parent mind as hearth root onto bed
SMX SEAL bed seed "state/smx_hearth/hearth_root.cblc"
ASSERT SMX_OK == 1 "seal hearth root"
ASSERT SMX_N > 64 "hearth root frame"
ASSERT CUBES == base_cubes "seal invents nothing"

// SEAL each live daughter as hearth ember (distinct paths — no replay)
LET embers = 0
IF a1 == 1 THEN
  SMX SEAL nozzle d1 "state/smx_hearth/ember_d1.cblc"
  ASSERT SMX_OK == 1 "seal ember d1"
  ASSERT SMX_N > 64 "ember d1 frame"
  LET embers = embers + 1
END
IF a2 == 1 THEN
  SMX SEAL hive d2 "state/smx_hearth/ember_d2.cblc"
  ASSERT SMX_OK == 1 "seal ember d2"
  ASSERT SMX_N > 64 "ember d2 frame"
  LET embers = embers + 1
END
ASSERT embers >= 1 "at least one hearth ember"
ASSERT CUBES == base_cubes "ember seals invent nothing"

// Soft-OOB storms against hearth — fail-closed, no ghost thrash
SMX EXCHANGE hive offworld_hearth
ASSERT SMX_OK == 0 "hearth soft-OOB A"
ASSERT SMX_OOB >= 1 "hearth oob A"
ASSERT CUBES == base_cubes "hearth no ghost A"

SMX TALK scrap ghost_hearth
ASSERT SMX_OK == 0 "hearth soft-OOB B"
ASSERT SMX_OOB >= 2 "hearth oob sticky"
ASSERT CUBES == base_cubes "hearth no ghost B"

// Recover: clear OOB, keep key, restore vital after hearth raise
SMX RECOVER
ASSERT SMX_OK == 1 "hearth recover"
ASSERT SMX_OOB == 0 "hearth oob cleared"
ASSERT SMX_KEY_OK == 1 "hearth key sticky"
ASSERT SMX_VITAL >= 6 "hearth vital"
ASSERT CUBES == base_cubes "recover invents nothing"

// OPEN hearth root onto scrap — shared home frame after storms
SMX OPEN scrap "state/smx_hearth/hearth_root.cblc"
ASSERT SMX_OK == 1 "open hearth root onto scrap"
ASSERT CUBES == base_cubes "open invents nothing"

// Dual SEAL/OPEN post-hearth quorum (bed/nozzle)
SMX SEAL bed nozzle "state/smx_hearth/quorum_bn.cblc"
ASSERT SMX_OK == 1 "seal quorum BN"
ASSERT SMX_N > 64 "quorum BN frame"
SMX OPEN hive "state/smx_hearth/quorum_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"
ASSERT CUBES == base_cubes "BN open invents nothing"

// Full mesh re-bind after hearth restore
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "mesh re-bind after hearth"
ASSERT SMX_TALKS >= 12 "talks after re-bind"
ASSERT CUBES == base_cubes "re-bind identity"

// Post-hearth storm — still fail-closed after hearth raise
SMX EXCHANGE scrap void_post
ASSERT SMX_OK == 0 "post soft-OOB"
ASSERT SMX_OOB >= 1 "post oob"
ASSERT CUBES == base_cubes "post no ghost"

SMX TALK bed ghost_post
ASSERT SMX_OK == 0 "post storm-B"
ASSERT SMX_OOB >= 2 "post oob sticky"
ASSERT CUBES == base_cubes "post no ghost B"

SMX RECOVER
ASSERT SMX_OK == 1 "post recover"
ASSERT SMX_OOB == 0 "post oob cleared"
ASSERT SMX_KEY_OK == 1 "post key sticky"
ASSERT SMX_VITAL >= 6 "post vital"

SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after hearth"
ASSERT SMX_KEY_OK == 1 "key after hearth"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after hearth"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after hearth"
ASSERT UNITY >= 40 "mesh unity after hearth"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh hearth"
ASSERT pop >= 2 "population after hearth life"
ASSERT embers >= 1 "hearth embers sealed"
ASSERT SMX_OOB == 0 "guard holds through hearth"
ASSERT OK == 1

PRINT "mesh_hearth" births pop embers SMX_N SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
