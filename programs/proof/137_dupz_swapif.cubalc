# Proof 137 — digit-1 stack conditionals: DUPZ SSWAPIF SKEEPIF SNIPIF
HOLD_FLASH 1
SCIENCE LOAD

# DUPZ — dup only if zero
CLEARSTACK
PUSH 0
DUPZ
ASSERT SP == 2
ASSERT LAST_N == 0
POP a
ASSERT a == 0
POP a
ASSERT a == 0

CLEARSTACK
PUSH 5
DUPZ
ASSERT SP == 1
ASSERT LAST_N == 5
POP a
ASSERT a == 5

# QDUP0 alias
CLEARSTACK
PUSH 0
QDUP0
ASSERT SP == 2

# SSWAPIF — a b f → swap if f
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
SSWAPIF
ASSERT SP == 2
POP b
POP a
ASSERT a == 2
ASSERT b == 1

CLEARSTACK
PUSH 1
PUSH 2
PUSH 0
SWAPIF
ASSERT SP == 2
POP b
POP a
ASSERT a == 1
ASSERT b == 2

# QSWAP alias with true
CLEARSTACK
PUSH 10
PUSH 20
PUSH 7
QSWAP
POP b
POP a
ASSERT a == 20
ASSERT b == 10

# SKEEPIF — v f → keep v if f
CLEARSTACK
PUSH 42
PUSH 1
SKEEPIF
ASSERT SP == 1
ASSERT LAST_N == 42
POP a
ASSERT a == 42

CLEARSTACK
PUSH 42
PUSH 0
KEEPIF
ASSERT SP == 0
ASSERT OK == 1

# SNIPIF — a b f → f?b:a
CLEARSTACK
PUSH 3
PUSH 9
PUSH 1
SNIPIF
ASSERT LAST_N == 9
ASSERT SP == 1
POP a
ASSERT a == 9

CLEARSTACK
PUSH 3
PUSH 9
PUSH 0
NIPIF
ASSERT LAST_N == 3
POP a
ASSERT a == 3

# NIPWHEN alias
CLEARSTACK
PUSH 100
PUSH 200
PUSH 1
NIPWHEN
ASSERT LAST_N == 200

# soft fails
CLEARSTACK
DUPZ
ASSERT OK == 0
SSWAPIF
ASSERT OK == 0
SKEEPIF
ASSERT OK == 0
SNIPIF
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof137_dupz_swapif" LAST_N SP
