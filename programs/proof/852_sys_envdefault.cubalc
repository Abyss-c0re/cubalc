# SYS ENVDEFAULT / ENSUREENV — setenv only if missing or empty
# Usability: agent boot defaults without IF HASENV + SETENV glue
# Distinct from ENV OR (read-only) and SETENV (always overwrite)

HOLD_FLASH 1

# clean slate
SYS UNSETENV CUBALC_MI_ENVDEF_A
SYS UNSETENV CUBALC_MI_ENVDEF_B
SYS UNSETENV CUBALC_MI_ENVDEF_C

# first write
SYS ENVDEFAULT CUBALC_MI_ENVDEF_A "hello"
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ENVDEFAULT_N == 1
ASSERT ENVDEFAULT_SET == 1
SYS EQS LAST "hello"
ASSERT LAST_N == 1

SYS ENV CUBALC_MI_ENVDEF_A
SYS EQS LAST "hello"
ASSERT LAST_N == 1

# second write does not overwrite
SYS ENVDEFAULT CUBALC_MI_ENVDEF_A "world"
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ENVDEFAULT_SET == 0
SYS EQS LAST "hello"
ASSERT LAST_N == 1
SYS ENV CUBALC_MI_ENVDEF_A
SYS EQS LAST "hello"
ASSERT LAST_N == 1

# aliases
SYS ENSUREENV CUBALC_MI_ENVDEF_B "beta"
ASSERT OK == 1
ASSERT LAST_N == 1
SYS DEFAULTENV CUBALC_MI_ENVDEF_B "nope"
ASSERT OK == 1
ASSERT LAST_N == 0
SYS ENV CUBALC_MI_ENVDEF_B
SYS EQS LAST "beta"
ASSERT LAST_N == 1

# empty existing treated as missing → write
SYS ENV SET CUBALC_MI_ENVDEF_C ""
SYS ENVDEFAULT CUBALC_MI_ENVDEF_C "filled"
ASSERT OK == 1
ASSERT LAST_N == 1
SYS ENV CUBALC_MI_ENVDEF_C
SYS EQS LAST "filled"
ASSERT LAST_N == 1

# SETENV still overwrites after ENVDEFAULT
SYS ENVDEFAULT CUBALC_MI_ENVDEF_A "ignored"
ASSERT LAST_N == 0
SYS SETENV CUBALC_MI_ENVDEF_A "forced"
SYS ENV CUBALC_MI_ENVDEF_A
SYS EQS LAST "forced"
ASSERT LAST_N == 1

# cleanup
SYS UNSETENV CUBALC_MI_ENVDEF_A
SYS UNSETENV CUBALC_MI_ENVDEF_B
SYS UNSETENV CUBALC_MI_ENVDEF_C

PRINT "sys_envdefault ok"
