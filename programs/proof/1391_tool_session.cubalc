# INCLUDE tool_session — cli_boot + cli_guard + arg_guard full CLI contract

HOLD_FLASH 1

# empty contracts (skip all gates)
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 0
LET NEED_ARGS = ""
LET NEED_ARG_ANY = ""
LET CLI_GUARD_SOFT = 0
LET ARG_GUARD_SOFT = 0
INCLUDE tool_session
ASSERT OK == 1
ASSERT CLI_GUARD_OK == 1
ASSERT ARG_GUARD_OK == 1
ASSERT TOOL_SESSION_OK == 1
HASINCLUDE cli_boot
ASSERT LAST_N == 1
HASINCLUDE cli_guard
ASSERT LAST_N == 1
HASINCLUDE arg_guard
ASSERT LAST_N == 1
HASINCLUDE tool_session
ASSERT LAST_N == 1
SYS HASI "cubalc.cli.v1"
ASSERT LAST_N == 1
VERSION
ASSERT LAST != ""

# flags + rest pass
SYS ENV SET CUBALC_ARG0 "--out=x"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = "out"
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 1
LET NEED_ARGS = ""
LET NEED_ARG_ANY = ""
LET CLI_GUARD_SOFT = 0
LET ARG_GUARD_SOFT = 0
INCLUDE tool_session
ASSERT CLI_GUARD_OK == 1
ASSERT ARG_GUARD_OK == 1
ASSERT TOOL_SESSION_OK == 1
ASSERT LISTFLAGS_N >= 1
ASSERT RESTARGS_N >= 1

# soft flag miss → TOOL_SESSION_OK 0
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CUBALC_ARG0
LET NEED_FLAGS = "missing"
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 0
LET NEED_ARGS = ""
LET NEED_ARG_ANY = ""
LET CLI_GUARD_SOFT = 1
LET ARG_GUARD_SOFT = 0
INCLUDE tool_session
ASSERT CLI_GUARD_OK == 0
ASSERT TOOL_SESSION_OK == 0
CLEAR_ERR

# soft arg miss alone via arg_guard (tool_session recomposes both)
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CUBALC_ARG0
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 0
LET NEED_ARGS = "0"
LET NEED_ARG_ANY = ""
LET CLI_GUARD_SOFT = 0
LET ARG_GUARD_SOFT = 1
INCLUDE arg_guard
ASSERT ARG_GUARD_OK == 0
# re-run tool_session with same knobs
INCLUDE tool_session
ASSERT ARG_GUARD_OK == 0
ASSERT TOOL_SESSION_OK == 0
CLEAR_ERR

# hard both pass
SYS ENV SET CUBALC_ARG0 "--mode=run"
SYS ENV SET CUBALC_ARG1 "file0"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 1
LET NEED_ARGS = "1"
LET NEED_ARG_ANY = ""
LET CLI_GUARD_SOFT = 0
LET ARG_GUARD_SOFT = 0
INCLUDE tool_session
ASSERT CLI_GUARD_REST_OK == 1
ASSERT ARG_GUARD_OK == 1
ASSERT TOOL_SESSION_OK == 1

HASLIB tool_session
ASSERT LAST_N == 1

PASS
PRINT "1391_tool_session: PASS"
