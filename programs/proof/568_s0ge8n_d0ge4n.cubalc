# Proof 568 — digit-3 stack+dual field signed GE0 8/4: S0GE8N S0GE4N D0GE8N D0GE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0GE8N: 0 → 1
PUSH 0x0
S0GE8N 0
POP x
ASSERT x == 1

# positive → 1
CLEARSTACK
PUSH 0x5
SGE08N 0
POP x
ASSERT x == 1

# -1=0xFF → 0
CLEARSTACK
PUSH 0xFF
SNONNEG8N 0
POP x
ASSERT x == 0

# INT8_MIN=0x80 → 0
CLEARSTACK
PUSH 0x80
SISNONNEG8N 0
POP x
ASSERT x == 0

# high preserve: low +3 → 1
CLEARSTACK
PUSH 0xAA03
S0GE8N 0
POP x
ASSERT x == 0xAA01

# high preserve: low -2 → 0
CLEARSTACK
PUSH 0xAAFE
S0GE8N 0
POP x
ASSERT x == 0xAA00

# STACK0GE8N n1: high positive → 1
CLEARSTACK
PUSH 0x0200
STACK0GE8N 1
POP x
ASSERT x == 0x0100

# high negative → 0
CLEARSTACK
PUSH 0xFE03
STACK0GE8N 1
POP x
ASSERT x == 0x0003

# high zero → 1
CLEARSTACK
PUSH 0x0003
STACK0GE8N 1
POP x
ASSERT x == 0x0103

# S0GE4N: 0 → 1
CLEARSTACK
PUSH 0x0
S0GE4N 0
POP x
ASSERT x == 1

# positive → 1
CLEARSTACK
PUSH 0x3
SGE04N 0
POP x
ASSERT x == 1

# -1=0xF → 0
CLEARSTACK
PUSH 0xF
SNONNEG4N 0
POP x
ASSERT x == 0

# INT4_MIN=0x8 → 0
CLEARSTACK
PUSH 0x8
SISNONNEG4N 0
POP x
ASSERT x == 0

# high nibble preserve: low positive → 1
CLEARSTACK
PUSH 0x13
S0GE4N 0
POP x
ASSERT x == 0x11

# high nibble preserve: low negative → 0
CLEARSTACK
PUSH 0x1E
S0GE4N 0
POP x
ASSERT x == 0x10

# high positive: n1 of 0x20 → 1
CLEARSTACK
PUSH 0x20
STACK0GE4N 1
POP x
ASSERT x == 0x10

# high negative: n1 of 0xD0 → 0
CLEARSTACK
PUSH 0xD0
STACK0GE4N 1
POP x
ASSERT x == 0x00

# high zero n1 → 1
CLEARSTACK
PUSH 0x03
STACK0GE4N 1
POP x
ASSERT x == 0x13

# D0GE8N
CLEARSTACK
PUSH 0x5
PUSH 0xFE
D0GE8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0GE8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# STACK20GE8N n1
CLEARSTACK
PUSH 0x0300
PUSH 0xFD00
STACK20GE8N 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

# D0GE4N
CLEARSTACK
PUSH 0x3
PUSH 0xE
D0GE4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x2
PAIR0GE4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# STACK20GE4N n1
CLEARSTACK
PUSH 0x30
PUSH 0xD0
STACK20GE4N 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x00

HOLD_FLASH 0
