# Proof 145 — digit-2 dual-stack pair numthy: DGCD DLCM DPOW
HOLD_FLASH 1
SCIENCE LOAD

# DGCD — a b c d → gcd(a,c) gcd(b,d)
CLEARSTACK
PUSH 12
PUSH 18
PUSH 8
PUSH 27
DGCD
POP y
POP x
ASSERT x == 4
ASSERT y == 9

# negative abs
CLEARSTACK
PUSH -15
PUSH 21
PUSH 25
PUSH -14
DGCD
POP y
POP x
ASSERT x == 5
ASSERT y == 7

# DLCM
CLEARSTACK
PUSH 4
PUSH 6
PUSH 6
PUSH 9
DLCM
POP y
POP x
ASSERT x == 12
ASSERT y == 18

# 0-safe LCM
CLEARSTACK
PUSH 0
PUSH 5
PUSH 7
PUSH 0
DLCM
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DPOW — a^c b^d
CLEARSTACK
PUSH 2
PUSH 3
PUSH 5
PUSH 4
DPOW
POP y
POP x
ASSERT x == 32
ASSERT y == 81

# 2GCD / PAIRPOW aliases
CLEARSTACK
PUSH 10
PUSH 14
PUSH 15
PUSH 21
2GCD
POP y
POP x
ASSERT x == 5
ASSERT y == 7

CLEARSTACK
PUSH 2
PUSH 5
PUSH 3
PUSH 2
PAIRPOW
POP y
POP x
ASSERT x == 8
ASSERT y == 25

# neg exp → 0
CLEARSTACK
PUSH 9
PUSH 4
PUSH -1
PUSH 2
DPOW
POP y
POP x
ASSERT x == 0
ASSERT y == 16

# soft fails
CLEARSTACK
DGCD
ASSERT OK == 0
DLCM
ASSERT OK == 0
DPOW
ASSERT OK == 0
PUSH 1
PUSH 2
PUSH 3
2LCM
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof145_dgcd_dlcm" LAST_N SP
