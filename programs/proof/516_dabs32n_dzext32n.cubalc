# Proof 516 — digit-1 dual-stack imm 32-bit field abs+extend: DABS32N DSEXT32N DZEXT32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DABS32N: 0xFFFFFFFE (-2)→2 ; 0x00000005→5
PUSH 0xFFFFFFFE
PUSH 0x00000005
DABS32N 0
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# min int32 -2147483648 stays 0x80000000
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
PAIRABS32N 0
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 2147483648

# high preserved abs: 0xFFFFFFFE→2 ; 0xFFFFFFFD→3
CLEARSTACK
PUSH 0x11223344FFFFFFFE
PUSH 0x99AABBCCFFFFFFFD
DABS32N 0
POP y
POP x
ASSERT x == 0x1122334400000002
ASSERT y == 0x99AABBCC00000003

# S2ABS32N n1: high of 0xFFFFFFFE00000001 is FFFFFFFE=-2 → abs 2
CLEARSTACK
PUSH 0xFFFFFFFE00000001
PUSH 0xFFFFFFFC00000002
S2ABS32N 1
POP y
POP x
ASSERT x == 0x0000000200000001
ASSERT y == 0x0000000400000002

# DSEXT32N: 0x7FFFFFFF→2147483647 ; 0xFFFFFFFE→-2
CLEARSTACK
PUSH 0x7FFFFFFF
PUSH 0xFFFFFFFE
DSEXT32N 0
POP y
POP x
ASSERT x == 2147483647
ASSERT y == -2

CLEARSTACK
PUSH 0x80000000
PUSH 0x0
PAIRSEXT32N 0
POP y
POP x
ASSERT x == -2147483648
ASSERT y == 0

# S2SEXT32N n1: high A0000001 / C0000002
CLEARSTACK
PUSH 0xA000000100000001
PUSH 0xC000000200000002
S2SEXT32N 1
POP y
POP x
ASSERT x == -1610612735
ASSERT y == -1073741822

# high ignored for n0: 0x1FFFFFFFF → -1
CLEARSTACK
PUSH 0x1FFFFFFFF
PUSH 0xFFFFFFFF
DSEXT32N 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DZEXT32N: extract word
CLEARSTACK
PUSH 0xABCD123456789ABC
PUSH 0x1122334455667788
DZEXT32N 0
POP y
POP x
ASSERT x == 0x56789ABC
ASSERT y == 0x55667788

CLEARSTACK
PUSH 0xABCD123456789ABC
PUSH 0x1122334455667788
PAIRZEXT32N 1
POP y
POP x
ASSERT x == 0xABCD1234
ASSERT y == 0x11223344

# aliases
CLEARSTACK
PUSH 0xFFFFFFFC
PUSH 0x00000009
DIABS32N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 9

CLEARSTACK
PUSH 0xFFFFFFFC
PUSH 0x00000009
DDWSEXTN 0
POP y
POP x
ASSERT x == -4
ASSERT y == 9

CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x00000000FFFFFFFF
DDWZEXTN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 4294967295

# DABSDWN n1: min high stays
CLEARSTACK
PUSH 0x8000000000000000
PUSH 0x8000000000000001
DABSDWN 1
POP y
POP x
ASSERT x == 0x8000000000000000
ASSERT y == 0x8000000000000001

HOLD_FLASH 0
