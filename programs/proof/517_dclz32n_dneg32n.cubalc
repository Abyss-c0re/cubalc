# Proof 517 — digit-1 dual-stack imm 32-bit field zeros+signed: DCLZ32N DCTZ32N DNEG32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DCLZ32N: 0→32 ; 1→31
PUSH 0x0
PUSH 0x1
DCLZ32N 0
POP y
POP x
ASSERT x == 32
ASSERT y == 31

# 0x80000000→0 ; 0x00000002→30
CLEARSTACK
PUSH 0x80000000
PUSH 0x00000002
PAIRCLZ32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 30

# high preserved clz0→32
CLEARSTACK
PUSH 0x1122334400000000
PUSH 0x99AABBCC00000001
DCLZ32N 0
POP y
POP x
ASSERT x == 0x1122334400000020
ASSERT y == 0x99AABBCC0000001F

# S2CLZ32N n1: high 0x40000000 clz1 → 0x00000001 in high word
CLEARSTACK
PUSH 0x4000000000000000
PUSH 0x2000000000000000
S2CLZ32N 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000200000000

# DCTZ32N: 0→32 ; 1→0 ; 0x80000000→31 ; 0x00000006→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DCTZ32N 0
POP y
POP x
ASSERT x == 32
ASSERT y == 0

CLEARSTACK
PUSH 0x80000000
PUSH 0x00000006
PAIRCTZ32N 0
POP y
POP x
ASSERT x == 31
ASSERT y == 1

# STACK2CTZ32N n1: high C0000000 ctz30 → 0x1E high
CLEARSTACK
PUSH 0xC000000000000000
PUSH 0xA000000000000000
STACK2CTZ32N 1
POP y
POP x
ASSERT x == 0x0000001E00000000
ASSERT y == 0x0000001D00000000

# DNEG32N: 3→0xFFFFFFFD ; 0xFFFFFFFE (-2)→2 ; min stays
CLEARSTACK
PUSH 0x3
PUSH 0xFFFFFFFE
DNEG32N 0
POP y
POP x
ASSERT x == 4294967293
ASSERT y == 2

CLEARSTACK
PUSH 0x80000000
PUSH 0x1
PAIRNEG32N 0
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 4294967295

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455555555
PUSH 0x99AABBCC00000003
DNEG32N 0
POP y
POP x
ASSERT x == 0x11223344AAAAAAAB
ASSERT y == 0x99AABBCCFFFFFFFD

CLEARSTACK
PUSH 0x11223344AAAAAAAB
PUSH 0x99AABBCCFFFFFFFD
DNEG32N 0
POP y
POP x
ASSERT x == 0x1122334455555555
ASSERT y == 0x99AABBCC00000003

# S2NEG32N n1: high 0x30000000 → 0xD0000000
CLEARSTACK
PUSH 0x3000000000000000
PUSH 0x2000000000000000
S2NEG32N 1
POP y
POP x
ASSERT x == 0xD000000000000000
ASSERT y == 0xE000000000000000

# aliases
CLEARSTACK
PUSH 0x10000000
PUSH 0x10000000
DNLZ32N 0
POP y
POP x
ASSERT x == 3
ASSERT y == 3

CLEARSTACK
PUSH 0x10000000
PUSH 0x10000000
DNTZ32N 0
POP y
POP x
ASSERT x == 28
ASSERT y == 28

CLEARSTACK
PUSH 0x2
PUSH 0x2
DINEG32N 0
POP y
POP x
ASSERT x == 4294967294
ASSERT y == 4294967294

HOLD_FLASH 0
