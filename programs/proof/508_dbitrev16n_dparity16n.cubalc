# Proof 508 — digit-5 dual-stack imm 16-bit field metrics: DBITREV16N DPOPCNT16N DPARITY16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DBITREV16N: 0x0001 → 0x8000 ; 0x0003 → 0xC000
PUSH 0x0001
PUSH 0x0003
DBITREV16N 0
POP y
POP x
ASSERT x == 32768
ASSERT y == 49152

# 0x00FF → 0xFF00 ; 0x0F0F → 0xF0F0
CLEARSTACK
PUSH 0x00FF
PUSH 0x0F0F
PAIRBITREV16N 0
POP y
POP x
ASSERT x == 0xFF00
ASSERT y == 0xF0F0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
PUSH 0x99AABBCCDDEEFF05
DBITREV16N 0
DBITREV16N 0
POP y
POP x
ASSERT x == 0x112233445566778A
ASSERT y == 0x99AABBCCDDEEFF05

# S2BITREV16N n1: half1 of 0x00018000 is 0001 → 8000 → 0x80008000
CLEARSTACK
PUSH 0x00018000
PUSH 0x000F0000
S2BITREV16N 1
POP y
POP x
ASSERT x == 0x80008000
ASSERT y == 0xF0000000

# DBREV16N alias
CLEARSTACK
PUSH 0x0001
PUSH 0x0001
DBREV16N 0
POP y
POP x
ASSERT x == 32768
ASSERT y == 32768

# DPOPCNT16N: 0→0 ; FFFF→16
CLEARSTACK
PUSH 0x0
PUSH 0xFFFF
DPOPCNT16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 16

# high preserved: 0x...5555 → pop 8
CLEARSTACK
PUSH 0x1122334455665555
PUSH 0x99AABBCCDDEE0007
PAIRPOPCNT16N 0
POP y
POP x
ASSERT x == 0x1122334455660008
ASSERT y == 0x99AABBCCDDEE0003

# STACK2POPCNT16N n1: 0xFFFF0000 half1=FFFF→16 → 0x00100000
CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x00070000
STACK2POPCNT16N 1
POP y
POP x
ASSERT x == 0x00100000
ASSERT y == 0x00030000

# DPCNT16N alias: 0xAAAA→8 ; 0x0003→2
CLEARSTACK
PUSH 0xAAAA
PUSH 0x0003
DPCNT16N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 2

# DPARITY16N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DPARITY16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x3
PUSH 0x7
PAIRPARITY16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# high preserved parity half1: 0x90000000 half1=9000 even→0; 0xB0000000 odd→1
CLEARSTACK
PUSH 0x90000000
PUSH 0xB0000000
S2PARITY16N 1
POP y
POP x
ASSERT x == 0x00000000
ASSERT y == 0x00010000

# DXORRED16N alias: FFFF even→0 ; FFFE odd→1
CLEARSTACK
PUSH 0xFFFF
PUSH 0xFFFE
DXORRED16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DBITREVWORDN alias: 0x8000 → 0x0001
CLEARSTACK
PUSH 0x8000
PUSH 0x4000
DBITREVWORDN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2

HOLD_FLASH 0
