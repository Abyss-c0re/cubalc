# TOPNBYFWHERE / HEADWHERE — top-n matching objects by numeric field
# Usability: no WHERE+TOPNBYF or SORTBYFWHERE+TAKE glue

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 30 0
NEW Cell b 1 10 0
NEW Cell c 1 20 0
NEW Cell d 1 10 0
NEW Cell e 1 50 0
NEW Cell f 1 5 0
SETF a age 1
SETF b age 0
SETF c age 1
SETF d age 0
SETF e age 1
SETF f age 0

# age==1 energies: a30 c20 e50 → ASC top2: c a
TOPNBYFWHERE Cell energy 2 age 1 ASC
ASSERT OK == 1
ASSERT TOPNBYFWHERE_N == 2
ASSERT LAST_N == 2
ASSERT TOPNBYFWHERE_TOTAL == 3
ASSERT TOPNBYFWHERE_REQ == 2
ASSERT TOPNBYFWHERE_DESC == 0
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "c"
ASSERT LAST_N == 1
SYS NTH 1 TOPNBYFWHERE
SYS EQS LAST "a"
ASSERT LAST_N == 1
SYS HASLINE TOPNBYFWHERE "e"
ASSERT LAST_N == 0 "e is 3rd ASC not in top2"
SYS HASLINE TOPNBYFWHERE "b"
ASSERT LAST_N == 0 "age0 excluded"

# DESC top2 age1: e a
TOPNBYFWHERE Cell energy 2 age 1 DESC
ASSERT TOPNBYFWHERE_DESC == 1
ASSERT TOPNBYFWHERE_N == 2
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1
SYS NTH 1 TOPNBYFWHERE
SYS EQS LAST "a"
ASSERT LAST_N == 1

# WHERE sugar
TOPNBYFWHERE Cell energy 1 WHERE age 1 DESC
ASSERT TOPNBYFWHERE_N == 1
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1

# OF sugar + TAKE keyword
TOPNBYFWHERE OF Cell energy TAKE 2 WHERE age 0 ASC
ASSERT TOPNBYFWHERE_N == 2
ASSERT TOPNBYFWHERE_TOTAL == 3
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "f"
ASSERT LAST_N == 1
SYS NTH 1 TOPNBYFWHERE
SYS EQS LAST "b"
ASSERT LAST_N == 1

# n larger than match set
TOPNBYFWHERE Cell energy 99 age 1 DESC
ASSERT TOPNBYFWHERE_N == 3
ASSERT TOPNBYFWHERE_REQ == 99
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1

# n=0 empty
TOPNBYFWHERE Cell energy 0 age 1 DESC
ASSERT OK == 1
ASSERT TOPNBYFWHERE_N == 0
ASSERT TOPNBYFWHERE_TOTAL == 3
SYS EQS LAST ""
ASSERT LAST_N == 1

# aliases
HEADWHERE Cell energy 1 age 0 ASC
ASSERT HEADWHERE_N == 1
SYS NTH 0 HEADWHERE
SYS EQS LAST "f"
ASSERT LAST_N == 1
TAKEWHERE Cell energy 1 age 1 DESC
ASSERT TAKEWHERE_N == 1
SYS NTH 0 TAKEWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1
TOPNIF Cell energy 2 age 0 ASC
ASSERT TOPNBYFWHERE_N == 2

# var n
LET k = 1
TOPNBYFWHERE Cell energy k age 1 DESC
ASSERT TOPNBYFWHERE_N == 1
ASSERT TOPNBYFWHERE_REQ == 1
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1

# string match · open tickets top2 by retries DESC
CLASS Ticket
  FIELD status "new"
  FIELD retries 0
  METHOD init s r
    SETF THIS status s
    SETF THIS retries r
  END
END
NEW Ticket t1 "open" 7
NEW Ticket t2 "closed" 9
NEW Ticket t3 "open" 2
NEW Ticket t4 "open" 5
TOPNBYFWHERE Ticket retries 2 status "open" DESC
ASSERT OK == 1
ASSERT TOPNBYFWHERE_N == 2
ASSERT TOPNBYFWHERE_TOTAL == 3
SYS NTH 0 TOPNBYFWHERE
SYS EQS LAST "t1"
ASSERT LAST_N == 1
SYS NTH 1 TOPNBYFWHERE
SYS EQS LAST "t4"
ASSERT LAST_N == 1
SYS HASLINE TOPNBYFWHERE "t2"
ASSERT LAST_N == 0 "closed excluded"
SYS HASLINE TOPNBYFWHERE "t3"
ASSERT LAST_N == 0 "not in top2"

# no match → empty soft
TOPNBYFWHERE Ticket retries 3 status "missing" DESC
ASSERT OK == 1
ASSERT TOPNBYFWHERE_N == 0
ASSERT TOPNBYFWHERE_TOTAL == 0
SYS EQS LAST ""
ASSERT LAST_N == 1

PRINT "proof921_oop_topnbyfwhere" 1
ASSERT OK == 1
