# Proof 545 — digit-5 stack+dual imm 32-bit signed min/max: SMINS32N SMAXS32N DMINS32N DMAXS32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMINS32N: signed min(-1=0xFFFFFFFF, 1) → -1
PUSH 0xFFFFFFFF
SMINS32N 0x1 0
POP x
ASSERT x == 0xFFFFFFFF

# unsigned SMIN: min(0xFFFFFFFF, 1) → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SMIN32N 0x1 0
POP x
ASSERT x == 1

# positive keeps smaller: min(2, 3) → 2
CLEARSTACK
PUSH 0x2
SMINS32N 0x3 0
POP x
ASSERT x == 2

# field smaller: min(5, -2) → -2
CLEARSTACK
PUSH 0x5
MINS32N 0xFFFFFFFE 0
POP x
ASSERT x == 0xFFFFFFFE

# equal → field/value
CLEARSTACK
PUSH 0x80000000
SMINSIGN32N 0x80000000 0
POP x
ASSERT x == 0x80000000

# INT_MIN vs INT_MAX → INT_MIN
CLEARSTACK
PUSH 0x80000000
SMINS32N 0x7FFFFFFF 0
POP x
ASSERT x == 0x80000000

# preserved high word: low -1 min 0 → low -1
CLEARSTACK
PUSH 0x11223344FFFFFFFF
SMINS32N 0x0 0
POP x
ASSERT x == 0x11223344FFFFFFFF

# STACKMINS32N n1: high 0xFFFFFFFF (-1) min 0 → high -1
CLEARSTACK
PUSH 0xFFFFFFFF00000001
STACKMINS32N 0x0 1
POP x
ASSERT x == 0xFFFFFFFF00000001

# SMAXS32N: signed max(-1, 1) → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SMAXS32N 0x1 0
POP x
ASSERT x == 1

# unsigned SMAX: max(0xFFFFFFFF, 1) → 0xFFFFFFFF
CLEARSTACK
PUSH 0xFFFFFFFF
SMAX32N 0x1 0
POP x
ASSERT x == 0xFFFFFFFF

# keeps larger signed: max(2, -3) → 2
CLEARSTACK
PUSH 0x2
MAXS32N 0xFFFFFFFD 0
POP x
ASSERT x == 2

# INT_MAX vs INT_MIN → INT_MAX
CLEARSTACK
PUSH 0x80000000
SMAXSIGN32N 0x7FFFFFFF 0
POP x
ASSERT x == 0x7FFFFFFF

# equal → value
CLEARSTACK
PUSH 0x55555555
SMAXS32N 0x55555555 0
POP x
ASSERT x == 0x55555555

# preserved high: low 1 max -1 → low 1
CLEARSTACK
PUSH 0xAABBCCDD00000001
SMAXS32N 0xFFFFFFFF 0
POP x
ASSERT x == 0xAABBCCDD00000001

# STACKMAXS32N n1
CLEARSTACK
PUSH 0x0000000200000000
STACKMAXS32N 0xFFFFFFFF 1
POP x
ASSERT x == 0x0000000200000000

# DMINS32N: -1 min 0 → -1; 1 min 0 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x1
DMINS32N 0x0 0
POP y
POP x
ASSERT x == 0xFFFFFFFF
ASSERT y == 0

# unsigned DMIN contrast: 0xFFFFFFFF min 1 → 1 both if field 1
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFF
DMIN32N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# mixed signed dual
CLEARSTACK
PUSH 0x2
PUSH 0xFFFFFFFE
PAIRMINS32N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFFFFFFFE

# preserved high dual min
CLEARSTACK
PUSH 0x11223344FFFFFFFF
PUSH 0xAABBCCDD00000005
S2MINS32N 0x1 0
POP y
POP x
ASSERT x == 0x11223344FFFFFFFF
ASSERT y == 0xAABBCCDD00000001

# STACK2MINS32N n1
CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x0000000200000000
STACK2MINS32N 0x0 1
POP y
POP x
ASSERT x == 0xFFFFFFFF00000000
ASSERT y == 0x0000000000000000

# DMAXS32N: -1 max 0 → 0; 1 max 0 → 1
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x1
DMAXS32N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# INT_MIN max INT_MAX field
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
PAIRMAXS32N 0x7FFFFFFF 0
POP y
POP x
ASSERT x == 0x7FFFFFFF
ASSERT y == 0x7FFFFFFF

# unsigned dual max contrast: max(0xFFFFFFFF,1) unsigned → 0xFFFFFFFF
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x2
DMAX32N 0x1 0
POP y
POP x
ASSERT x == 0xFFFFFFFF
ASSERT y == 2

# DMAXSIGN32N mixed
CLEARSTACK
PUSH 0xFFFFFFFE
PUSH 0x3
DMAXSIGN32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == 0xFFFFFFFF
ASSERT y == 3

# STACK2MAXS32N n1
CLEARSTACK
PUSH 0xFFFFFFFE00000000
PUSH 0x0000000100000000
STACK2MAXS32N 0x0 1
POP y
POP x
ASSERT x == 0x0000000000000000
ASSERT y == 0x0000000100000000

HOLD_FLASH 0
