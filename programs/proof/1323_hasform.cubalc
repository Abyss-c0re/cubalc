# HASFORM / NEEDFORM / REQUIRE FORM — capability gates via HELP catalog

HASFORM SORTLIBS
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT HASFORM_N == 1
ASSERT FORM == "SORTLIBS"
ASSERT FORM_HINT != ""

HASFORM LIBAGE
ASSERT LAST_N == 1

HASFORM FRESHLIBS
ASSERT LAST_N == 1

HASFORM NEEDFRESH
ASSERT LAST_N == 1

# multi-word catalog entry
HASFORM "REQUIRE FN"
ASSERT OK == 1
ASSERT LAST_N == 1

# missing form
HASFORM NO_SUCH_FORM_XYZ_ZZZ
ASSERT OK == 0
ASSERT LAST_N == 0
CLEAR_ERR

# NEEDFORM hard pass
NEEDFORM HASFORM
ASSERT OK == 1
ASSERT LAST_N == 1

# REQUIRE FORM dual
REQUIRE FORM SORTLIBS
ASSERT OK == 1
ASSERT REQUIRE_FORM == "SORTLIBS"
ASSERT LAST == "SORTLIBS"

REQUIRE FORM LIBAGE
ASSERT OK == 1

# KNOWNFORM alias
KNOWNFORM INCLUDE
ASSERT LAST_N == 1

# var form name
LET f = "NEWESTLIB"
HASFORM f
ASSERT LAST_N == 1

PASS
PRINT "1323_hasform: PASS"
