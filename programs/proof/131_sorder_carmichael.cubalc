# Proof 131 — digit-2 modular order: SOPF CARMICHAEL ORDER + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# SOPF / SOPFR expr
ASSERT SOPF(12) == 5
ASSERT SOPF(30) == 10
ASSERT SOPF(1) == 0
ASSERT SOPF(17) == 17
ASSERT SOPFR(12) == 7
ASSERT SOPFR(8) == 6

# CARMICHAEL / LAMBDA
ASSERT CARMICHAEL(1) == 1
ASSERT LAMBDA(2) == 1
ASSERT CARMICHAEL(4) == 2
ASSERT CARMICHAEL(8) == 2
ASSERT CARMICHAEL(16) == 4
ASSERT CARMICHAEL(15) == 4
ASSERT CARM(7) == 6
ASSERT CARMICHAEL(0) == 0

# ORDER
ASSERT ORDER(2, 7) == 3
ASSERT ORDER(3, 7) == 6
ASSERT MULTORDER(2, 5) == 4
ASSERT ORDER(2, 8) == 0
ASSERT ORDER(1, 1) == 0

# stack SSOPF
CLEARSTACK
PUSH 12
SSOPF
ASSERT LAST_N == 5
PUSH 30
SSUMOPF
ASSERT LAST_N == 10

# stack SCARMICHAEL
CLEARSTACK
PUSH 15
SCARMICHAEL
ASSERT LAST_N == 4
PUSH 16
SLAMBDA
ASSERT LAST_N == 4

# stack SORDER
CLEARSTACK
PUSH 2
PUSH 7
SORDER
ASSERT LAST_N == 3
PUSH 3
PUSH 7
SMULTORDER
ASSERT LAST_N == 6
PUSH 2
PUSH 8
SORD
ASSERT LAST_N == 0

# soft fails
CLEARSTACK
SSOPF
ASSERT OK == 0
SCARMICHAEL
ASSERT OK == 0
SORDER
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof131_sorder_carmichael" LAST_N SP
