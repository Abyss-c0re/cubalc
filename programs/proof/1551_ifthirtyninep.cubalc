IFTHIRTYNINEP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTHIRTYNINEP_LEN == 40

IFTHIRTYNINEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFTHIRTYNINEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENTHIRTYNINEP thirtynine
  LET q = 1
ELSE
  LET q = 0
END
