# IFFORTYP - plate exactly-forty key diagnostic branch
# Continues ladder after IFTHIRTYNINEP. Soft twin TETRACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET thirtynine = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39}"
LET forty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40}"
LET fortyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41}"
LET empty = "{}"

IFFORTYP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFORTYP_N == 1
ASSERT FORTYP_N == 1
ASSERT IFFORTYP_LEN == 40
ASSERT IFTETRACONTAP_N == 1
ASSERT IFFORTYKEYP_N == 1

IFTETRACONTAP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYKEYP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYP thirtynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYP_N == 0
ASSERT IFFORTYP_LEN == 39

IFFORTYP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYP_LEN == 41

IFFORTYP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFORTYP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFORTYP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTETRACONTAP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFORTYKEYP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffortyp_ok" IFFORTYP_N IFFORTYP_LEN
PASS
