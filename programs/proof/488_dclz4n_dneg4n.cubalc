# Proof 488 — digit-2 dual-stack imm 4-bit field zeros+signed: DCLZ4N DCTZ4N DNEG4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DCLZ4N: 0→4 ; 1→3
PUSH 0x0
PUSH 0x1
DCLZ4N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 3

# 8→0 ; 2→2
CLEARSTACK
PUSH 0x8
PUSH 0x2
PAIRCLZ4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 2

# high preserved clz0→4
CLEARSTACK
PUSH 0x1122334455667700
PUSH 0x99AABBCCDDEEFF01
DCLZ4N 0
POP y
POP x
ASSERT x == 0x1122334455667704
ASSERT y == 0x99AABBCCDDEEFF03

# S2CLZ4N n1: 0x40 n1=4=0100 clz1 → 0x10
CLEARSTACK
PUSH 0x40
PUSH 0x20
S2CLZ4N 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x20

# DCTZ4N: 0→4 ; 1→0 ; 8→3 ; 6→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DCTZ4N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 0

CLEARSTACK
PUSH 0x8
PUSH 0x6
PAIRCTZ4N 0
POP y
POP x
ASSERT x == 3
ASSERT y == 1

# STACK2CTZ4N n1: 0xC0 n1=C=1100 ctz2 → 0x20
CLEARSTACK
PUSH 0xC0
PUSH 0xA0
STACK2CTZ4N 1
POP y
POP x
ASSERT x == 0x20
ASSERT y == 0x10

# DNEG4N: 3→D ; E→2 ; 8 stays 8
CLEARSTACK
PUSH 0x3
PUSH 0xE
DNEG4N 0
POP y
POP x
ASSERT x == 13
ASSERT y == 2

CLEARSTACK
PUSH 0x8
PUSH 0x1
PAIRNEG4N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 15

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455667755
PUSH 0x99AABBCCDDEEFF03
DNEG4N 0
POP y
POP x
ASSERT x == 0x112233445566775B
ASSERT y == 0x99AABBCCDDEEFF0D

CLEARSTACK
PUSH 0x112233445566775B
PUSH 0x99AABBCCDDEEFF0D
DNEG4N 0
POP y
POP x
ASSERT x == 0x1122334455667755
ASSERT y == 0x99AABBCCDDEEFF03

# S2NEG4N n1: 0x30 n1=3 → D → 0xD0
CLEARSTACK
PUSH 0x30
PUSH 0x20
S2NEG4N 1
POP y
POP x
ASSERT x == 0xD0
ASSERT y == 0xE0

# aliases
CLEARSTACK
PUSH 0x4
PUSH 0x4
DNLZ4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x4
PUSH 0x4
DNTZ4N 0
POP y
POP x
ASSERT x == 2
ASSERT y == 2

CLEARSTACK
PUSH 0x2
PUSH 0x2
DNIBNEGN 0
