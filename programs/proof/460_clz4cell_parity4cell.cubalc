# Proof 460 — digit-3 cell fixed-width 4 nibble metrics: CLZ4CELL CTZ4CELL PARITY4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# CLZ4CELL: 0 → 4; 0x1 → 3; 0x8 → 0; 0x2 → 2
CELLSET 0 0
CELLSET 1 1
CELLSET 2 8
CELLSET 3 2
CLZ4CELL 0 3
ASSERT CELL(0) == 4
ASSERT CELL(1) == 3
ASSERT CELL(2) == 0
ASSERT CELL(3) == 2
ASSERT LAST_N == 4

# CLZ4RANGE: 0x4 → 1
CELLSET 4 4
CLZ4RANGE 4 4
ASSERT CELL(4) == 1

# CTZ4CELL: 0 → 4; 0x1 → 0; 0x8 → 3; 0x6 → 1
CELLSET 5 0
CELLSET 6 1
CELLSET 7 8
CELLSET 8 6
CTZ4CELL 5 8
ASSERT CELL(5) == 4
ASSERT CELL(6) == 0
ASSERT CELL(7) == 3
ASSERT CELL(8) == 1
ASSERT LAST_N == 4

# CTZ4RANGE: 0xC → 2
CELLSET 9 12
CTZ4RANGE 9 9
ASSERT CELL(9) == 2

# PARITY4CELL: 0 → 0; 0x1 → 1; 0x3 → 0; 0xF → 0; 0x7 → 1
CELLSET 10 0
CELLSET 11 1
CELLSET 12 3
CELLSET 13 15
CELLSET 14 7
PARITY4CELL 10 14
ASSERT CELL(10) == 0
ASSERT CELL(11) == 1
ASSERT CELL(12) == 0
ASSERT CELL(13) == 0
ASSERT CELL(14) == 1
ASSERT LAST_N == 5

# high bits ignored: 0x10 → low4 0 → clz 4
CELLSET 15 16
CLZ4CELL 15 15
ASSERT CELL(15) == 4

# CLZNIBCELL alias: 0x5 → clz 1
CELLSET 16 5
CLZNIBCELL 16 16
ASSERT CELL(16) == 1

# CELLCTZ4: 0xA → 1
CELLSET 17 10
CELLCTZ4 17 17
ASSERT CELL(17) == 1

# XORRED4CELL alias parity: 0x9 → 0 (1001)
CELLSET 18 9
XORRED4CELL 18 18
ASSERT CELL(18) == 0

HOLD_FLASH 0
