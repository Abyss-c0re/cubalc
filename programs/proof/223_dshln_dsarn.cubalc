# Proof 223 — digit-3 dual-stack immediate shift: DSHLN DSHRN DSARN
HOLD_FLASH 1
SCIENCE LOAD

# DSHLN
CLEARSTACK
PUSH 1
PUSH 3
DSHLN 2
POP y
POP x
ASSERT x == 4
ASSERT y == 12

CLEARSTACK
PUSH 0x0F
PUSH 0x01
2SHLN 4
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0x10

# PAIRSHLN / n=0 no-op
CLEARSTACK
PUSH 7
PUSH 8
PAIRSHLN 0
POP y
POP x
ASSERT x == 7
ASSERT y == 8

# DSHRN logical
CLEARSTACK
PUSH 16
PUSH 12
DSHRN 2
POP y
POP x
ASSERT x == 4
ASSERT y == 3

CLEARSTACK
PUSH 0xF0
PUSH 0x80
2SHRN 4
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0x08

# PAIRSHRN
CLEARSTACK
PUSH 255
PUSH 128
PAIRSHRN 1
POP y
POP x
ASSERT x == 127
ASSERT y == 64

# DSARN arithmetic (negative)
CLEARSTACK
PUSH -8
PUSH -4
DSARN 1
POP y
POP x
ASSERT x == -4
ASSERT y == -2

CLEARSTACK
PUSH -16
PUSH 16
2SARN 2
POP y
POP x
ASSERT x == -4
ASSERT y == 4

# DASHRN / PAIRSARN
CLEARSTACK
PUSH -1
PUSH 8
DASHRN 3
POP y
POP x
ASSERT x == -1
ASSERT y == 1

CLEARSTACK
PUSH -32
PUSH 32
PAIRSARN 4
POP y
POP x
ASSERT x == -2
ASSERT y == 2

# round-trip SHL then SHR
CLEARSTACK
PUSH 5
PUSH 9
DSHLN 3
DSHRN 3
POP y
POP x
ASSERT x == 5
ASSERT y == 9
