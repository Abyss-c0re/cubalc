# Proof 425 — digit-8 endian/bitrev width ladder TOC: SBSWAP16TOC SBSWAP64TOC SBITREV16TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SBSWAP16TOC: 0x1234 → 0x3412
CELLSET 1 4660
PUSH 1
SBSWAP16TOC
ASSERT LAST_N == 13330
ASSERT CELL(1) == 13330
POP

# BSWAP16TOC: 0x00FF → 0xFF00
CELLSET 2 255
PUSH 2
BSWAP16TOC
ASSERT LAST_N == 65280
ASSERT CELL(2) == 65280
POP

# SBSWAP64TOC: 0x0102030405060708 → 0x0807060504030201
CELLSET 3 72623859790382856
PUSH 3
SBSWAP64TOC
ASSERT LAST_N == 578437695752307201
ASSERT CELL(3) == 578437695752307201
POP

# BSWAP64TOC identity mid: 0
CELLSET 4 0
PUSH 4
BSWAP64TOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SBITREV16TOC: 0x0001 → 0x8000
CELLSET 5 1
PUSH 5
SBITREV16TOC
ASSERT LAST_N == 32768
ASSERT CELL(5) == 32768
POP

# SREV16TOC: 0x8000 → 0x0001
CELLSET 6 32768
PUSH 6
SREV16TOC
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# soft short
CLEARSTACK
SBSWAP16TOC
ASSERT OK == 0

CLEARSTACK
SBSWAP64TOC
ASSERT OK == 0

CLEARSTACK
SBITREV16TOC
ASSERT OK == 0

HOLD_FLASH 0
