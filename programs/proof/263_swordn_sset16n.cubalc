# Proof 263 — digit-9 stack imm 16-bit halfword field: SWORDN SSET16N SCLR16N
HOLD_FLASH 1
SCIENCE LOAD

# SWORDN — extract LE halfword
CLEARSTACK
PUSH 0xAABBCCDD
SWORDN 0
POP x
ASSERT x == 0xCCDD

CLEARSTACK
PUSH 0xAABBCCDD
STACKWORDN 1
POP x
ASSERT x == 0xAABB

CLEARSTACK
PUSH 0x1122334455667788
SGET16N 0
POP x
ASSERT x == 0x7788

CLEARSTACK
PUSH 0x1122334455667788
SHALFN 1
POP x
ASSERT x == 0x5566

CLEARSTACK
PUSH 0x1122334455667788
GET16N 2
POP x
ASSERT x == 0x3344

CLEARSTACK
PUSH 0x1122334455667788
WORDN 3
POP x
ASSERT x == 0x1122

# clamp index
CLEARSTACK
PUSH 0x1122334455667788
SWORDN 99
POP x
ASSERT x == 0x1122

# SSET16N field n
CLEARSTACK
PUSH 0
SSET16N 0xABCD 0
POP x
ASSERT x == 0xABCD

CLEARSTACK
PUSH 0
STACKSET16N 0x1234 1
POP x
ASSERT x == 0x12340000

CLEARSTACK
PUSH -1
SET16N 0 2
POP x
# clear halfword 2 (bits 32..47): -1 & ~0xFFFF00000000
ASSERT x == -281470681743361

CLEARSTACK
PUSH 0
PUT16N 0xFFFF 3
POP x
ASSERT x == -281474976710656
# 0xFFFF << 48

# SCLR16N n
CLEARSTACK
PUSH 0xAABBCCDD
SCLR16N 0
POP x
ASSERT x == 0xAABB0000

CLEARSTACK
PUSH 0xAABBCCDD
STACKCLR16N 1
POP x
ASSERT x == 0x0000CCDD

CLEARSTACK
PUSH 0x1122334455667788
CLR16N 2
POP x
ASSERT x == 0x1122000055667788

CLEARSTACK
PUSH 0x1122334455667788
ZAP16N 3
POP x
ASSERT x == 0x0000334455667788

# soft fails
CLEARSTACK
SWORDN 0
ASSERT OK == 0
CLEARSTACK
SSET16N 1 0
ASSERT OK == 0
CLEARSTACK
SCLR16N 0
ASSERT OK == 0

HOLD_FLASH 1
