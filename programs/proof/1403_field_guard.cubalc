# INCLUDE field_guard - multi Class.field catalog ALL + ANY contract

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  FIELD kind
  METHOD ping
    LET LAST = "pong"
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

DEFAULT NEED_FIELDS = ""
DEFAULT NEED_FIELD_ANY = ""
DEFAULT FIELD_GUARD_SOFT = 0
INCLUDE field_guard
ASSERT FIELD_GUARD_OK == 1
ASSERT FIELD_GUARD_ALL_OK == 1
ASSERT FIELD_GUARD_ANY_OK == 1

LET NEED_FIELDS = "Ticket.id\nnosuch_cubalc_field_all"
LET NEED_FIELD_ANY = ""
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_OK == 0
ASSERT FIELD_GUARD_ALL_OK == 0
ASSERT FLDMISS_N >= 1
SYS HASLINE FLDMISS "nosuch_cubalc_field_all"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_FIELDS = "Ticket.id\nTicket.kind"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ALL_OK == 1
ASSERT FIELD_GUARD_OK == 1
ASSERT FLDHAVE_N >= 2

LET NEED_FIELDS = ""
LET NEED_FIELD_ANY = "nosuch_a\nnosuch_b"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ANY_OK == 0
ASSERT FIELD_GUARD_OK == 0
CLEAR_ERR

LET NEED_FIELD_ANY = "nosuch_a\nTicket.id"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ANY_OK == 1
ASSERT FIELD_GUARD_OK == 1
CLEAR_ERR

LET NEED_FIELDS = "Ticket.id\nTicket.kind"
LET NEED_FIELD_ANY = ""
LET FIELD_GUARD_SOFT = 0
INCLUDE field_guard
ASSERT FIELD_GUARD_OK == 1

LET NEED_FIELDS = ""
LET NEED_FIELD_ANY = "nosuch_z\nTicket.id"
LET FIELD_GUARD_SOFT = 0
INCLUDE field_guard
ASSERT FIELD_GUARD_ANY_OK == 1
ASSERT FIELD_GUARD_OK == 1

LET NEED_FIELDS = "Ticket.id"
LET NEED_FIELD_ANY = "Order.n\nnosuch_z"
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ALL_OK == 1
ASSERT FIELD_GUARD_ANY_OK == 1
ASSERT FIELD_GUARD_OK == 1

# missing class also counts as field miss
LET NEED_FIELDS = "Ghost.id"
LET NEED_FIELD_ANY = ""
LET FIELD_GUARD_SOFT = 1
INCLUDE field_guard
ASSERT FIELD_GUARD_ALL_OK == 0
SYS HASLINE FLDMISS "Ghost.id"
ASSERT LAST_N == 1
CLEAR_ERR

HASFORM "LISTFIELDS"
ASSERT LAST_N == 1
HASFORM "HASFIELD"
ASSERT LAST_N == 1
HASLIB field_guard
ASSERT LAST_N == 1

PRINT "1403_field_guard: PASS"
PASS
