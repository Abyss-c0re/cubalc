# Proof 219 — digit-5 dual-stack immediate bitfield: DSETBN DCLRBN DBTESTN
HOLD_FLASH 1
SCIENCE LOAD

# DSETBN
CLEARSTACK
PUSH 0
PUSH 0
DSETBN 3
POP y
POP x
ASSERT x == 8
ASSERT y == 8

CLEARSTACK
PUSH 1
PUSH 2
2SETBN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 3

# PAIRSETBN / DSETBITN
CLEARSTACK
PUSH 0
PUSH 16
PAIRSETBN 4
POP y
POP x
ASSERT x == 16
ASSERT y == 16

CLEARSTACK
PUSH 0
PUSH 0
DSETBITN 1
POP y
POP x
ASSERT x == 2
ASSERT y == 2

# DCLRBN
CLEARSTACK
PUSH 15
PUSH 15
DCLRBN 0
POP y
POP x
ASSERT x == 14
ASSERT y == 14

CLEARSTACK
PUSH 12
PUSH 10
2CLRBN 1
POP y
POP x
ASSERT x == 12
ASSERT y == 8

# PAIRCLRBN
CLEARSTACK
PUSH 255
PUSH 255
PAIRCLRBN 7
POP y
POP x
ASSERT x == 127
ASSERT y == 127

# DBTESTN
CLEARSTACK
PUSH 10
PUSH 4
DBTESTN 1
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 10
PUSH 4
2BTESTN 2
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# PAIRBTESTN / DBITN / DTESTBITN
CLEARSTACK
PUSH 8
PUSH 9
PAIRBTESTN 3
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 1
PUSH 2
DBITN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 16
PUSH 0
DTESTBITN 4
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# chain set then test
CLEARSTACK
PUSH 0
PUSH 0
DSETBN 5
DBTESTN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 1
