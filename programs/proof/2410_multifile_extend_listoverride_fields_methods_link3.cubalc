# Proof 2410 — MULTIFILE_EXTEND_LISTOVERRIDE_FIELDS_METHODS_LINK3
# Three-unit multi-file CLASS EXTEND/link + LISTOVERRIDEFIELDS + LISTOVERRIDEMETHODS.
# Partition: OWN = introduced+override; INHERITED = pure reuse; OVERRIDE = own∩ancestor.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
HASCLASS Greeter
ASSERT LAST_N == 1

INCLUDE demo_greeter_extend
ASSERT OK == 1
ASSERT EXTEND_N == 1

INCLUDE demo_greeter_override
ASSERT OK == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1

INCLUDE demo_greeter_loudtag
ASSERT OK == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

# Greeter root: no overrides (no ancestor)
LISTOVERRIDEFIELDS Greeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT OVERRIDEFIELDS_N == 0
ASSERT LISTOVERRIDEFIELDS_N == 0

LISTOVERRIDEMETHODS Greeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT OVERRIDEMETHODS_N == 0

# own: name,hits,tag + methods after EXTEND pack
LISTOWNFIELDS Greeter
ASSERT OK == 1
ASSERT LAST_N == 3
ASSERT OWNFIELDS_N == 3

LISTOWNMETHODS Greeter
ASSERT OK == 1
ASSERT LAST_N == 5
ASSERT OWNMETHODS_N == 5

# TagGreeter: tag redefines Greeter.tag default → OVERRIDEFIELDS=1
LISTOVERRIDEFIELDS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT OVERRIDEFIELDS_N == 1
ASSERT LAST == "tag"

LISTOWNFIELDS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT OWNFIELDS_N == 1

LISTINHERITEDFIELDS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 2
ASSERT INHERITEDFIELDS_N == 2

# TagGreeter methods: hi overrides Greeter.hi; set_tag/base_hi/shout introduced
LISTOVERRIDEMETHODS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT OVERRIDEMETHODS_N == 1
ASSERT LAST == "hi"

LISTOWNMETHODS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 4
ASSERT OWNMETHODS_N == 4

LISTINHERITEDMETHODS TagGreeter
ASSERT OK == 1
# init,bump,reset,greet pure inherit
ASSERT LAST_N == 4
ASSERT INHERITEDMETHODS_N == 4

# LoudTag depth-2: bang introduced (not override); hi overrides TagGreeter.hi
LISTOVERRIDEFIELDS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT OVERRIDEFIELDS_N == 0

LISTOWNFIELDS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT OWNFIELDS_N == 1

LISTINHERITEDFIELDS LoudTag
ASSERT OK == 1
# name,hits,tag
ASSERT LAST_N == 3
ASSERT INHERITEDFIELDS_N == 3

LISTOVERRIDEMETHODS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT OVERRIDEMETHODS_N == 1
ASSERT LAST == "hi"

LISTOWNMETHODS LoudTag
ASSERT OK == 1
# mark, hi, mid_hi, root_hi
ASSERT LAST_N == 4
ASSERT OWNMETHODS_N == 4

# live instance path
NEW TagGreeter tg "x"
ASSERT OK == 1
LISTOVERRIDEMETHODS tg
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "hi"

LISTOVERRIDEFIELDS tg
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "tag"

NEW LoudTag lt "y"
ASSERT OK == 1
LISTOVERRIDEMETHODS lt
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT OVERRIDEMETHODS_N == 1

LISTOVERRIDEFIELDS lt
ASSERT OK == 1
ASSERT LAST_N == 0

# aliases
OVERRIDEFIELDS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
REDEFINEDMETHODS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
METHODS_OVERRIDE LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
REDEFINEDFIELDS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1

# partition: LISTFIELDS = OWN + INHERITED
LISTFIELDS TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 3

LISTFIELDS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 4

LISTMETHODS TagGreeter
ASSERT OK == 1
ASSERT LAST_N >= 7

# dual: override subset of own
LISTOWNMETHODS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 4
LISTOVERRIDEMETHODS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1

PRINT "2410 LISTOVERRIDE fields/methods PASS"
