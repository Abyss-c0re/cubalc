# HASMATCHTOPICS / NEEDMATCHTOPICS / COUNTMATCHTOPICS — topic filter gates

HASMATCHTOPICS cap
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT HASMATCHTOPICS_N == 1

HASMATCHTOPICS p
ASSERT OK == 1
ASSERT LAST_N == 1

COUNTMATCHTOPICS p
ASSERT OK == 1
ASSERT LAST_N >= 2
ASSERT COUNTMATCHTOPICS_N >= 2

COUNTMATCHTOPICS mesh
ASSERT OK == 1
ASSERT LAST_N == 1

NEEDMATCHTOPICS plate
ASSERT OK == 1
ASSERT LAST_N == 1

# soft miss
HASMATCHTOPICS zzz_nope
ASSERT OK == 0
ASSERT LAST_N == 0
CLEAR_ERR

COUNTMATCHTOPICS zzz_nope
ASSERT OK == 1
ASSERT LAST_N == 0

# need needle soft
HASMATCHTOPICS
ASSERT OK == 0
CLEAR_ERR

# chain with MATCHTOPICS after has
HASMATCHTOPICS lib
ASSERT LAST_N == 1
MATCHTOPICS lib
ASSERT MATCHTOPICS_N == 1

PASS
PRINT "1348_hasmatchtopics: PASS"
