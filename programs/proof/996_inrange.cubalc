# REQUIRE BETWEEN / INRANGE — numeric range gates after GETFLAGN

HOLD_FLASH 1

# soft hit
INRANGE 50 1 100
ASSERT LAST_N == 1
ASSERT INRANGE_X == 50

# soft miss
INRANGE 0 1 100
ASSERT LAST_N == 0

# TO syntax + swap lo/hi
INRANGE 5 10 TO 1
ASSERT LAST_N == 1

# LAST_N subject after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--port=8080"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN port OR 80
ASSERT LAST_N == 8080
REQUIRE BETWEEN LAST_N 1 65535
ASSERT OK == 1
ASSERT LAST_N == 8080

# var subject
LET retries 3
REQUIRE BETWEEN retries 0 TO 10
ASSERT OK == 1

# NUMBETWEEN alias soft
NUMBETWEEN 7 5 9
ASSERT LAST_N == 1
NUMBETWEEN 4 5 9
ASSERT LAST_N == 0

# negative range
INRANGE -3 -5 TO -1
ASSERT LAST_N == 1

# BETWEENN alias
BETWEENN 100 100 100
ASSERT LAST_N == 1

PRINT "inrange ok"
