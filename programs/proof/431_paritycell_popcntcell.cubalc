# Proof 431 — digit-9 cell bit-metrics: PARITYCELL BSWAPCELL POPCNTCELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# PARITYCELL: 0b1011 → 1; 0b1010 → 0
CELLSET 0 11
CELLSET 1 10
PARITYCELL 0 1
ASSERT CELL(0) == 1
ASSERT CELL(1) == 0
ASSERT LAST_N == 2

# PARITYRANGE alias: 0 → 0; 1 → 1
CELLSET 2 0
CELLSET 3 1
PARITYRANGE 2 3
ASSERT CELL(2) == 0
ASSERT CELL(3) == 1

# BSWAPCELL: 0x12345678 → 0x78563412
CELLSET 4 305419896
BSWAPCELL 4 4
ASSERT CELL(4) == 2018915346
ASSERT LAST_N == 1

# BSWAP32CELL identity 0
CELLSET 5 0
BSWAP32CELL 5 5
ASSERT CELL(5) == 0

# POPCNTCELL: 0xFF → 8; 0x0F0F → 8
CELLSET 6 255
CELLSET 7 3855
POPCNTCELL 6 7
ASSERT CELL(6) == 8
ASSERT CELL(7) == 8
ASSERT LAST_N == 2

# PCNTCELL: 1 → 1; 0 → 0
CELLSET 8 1
CELLSET 9 0
PCNTCELL 8 9
ASSERT CELL(8) == 1
ASSERT CELL(9) == 0

# round-trip bswap
CELLSET 10 305419896
BSWAPCELL 10 10
BSWAPCELL 10 10
ASSERT CELL(10) == 305419896

HOLD_FLASH 0
