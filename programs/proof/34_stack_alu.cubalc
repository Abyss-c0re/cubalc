# Proof 34 — stack ALU digit-7: ADD SUB MUL DIV MOD SNEG SABS
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 3
PUSH 4
ADD
ASSERT SP == 1
PEEK
ASSERT LAST_N == 7

CLEARSTACK
PUSH 10
PUSH 3
SUB
ASSERT LAST_N == 7
MUL
# only one item left after SUB — MUL needs 2
ASSERT OK == 0

CLEARSTACK
PUSH 6
PUSH 7
MUL
ASSERT LAST_N == 42

CLEARSTACK
PUSH 20
PUSH 4
DIV
ASSERT LAST_N == 5
PUSH 3
MOD
ASSERT LAST_N == 2
ASSERT SP == 1

# div by zero soft
CLEARSTACK
PUSH 5
PUSH 0
DIV
ASSERT LAST_N == 0
ASSERT OK == 1

CLEARSTACK
PUSH 5
PUSH 0
MOD
ASSERT LAST_N == 0

# SNEG / SABS
CLEARSTACK
PUSH 9
SNEG
ASSERT LAST_N == -9
SABS
ASSERT LAST_N == 9
SNEG
SABS
ASSERT LAST_N == 9

# empty guards
CLEARSTACK
ADD
ASSERT OK == 0
SNEG
ASSERT OK == 0
SABS
ASSERT OK == 0

# compose with combinators
CLEARSTACK
PUSH 2
PUSH 3
PUSH 4
# stack 2 3 4 → OVER → 2 3 4 3 → MUL → 2 3 12 → ADD → 2 15 → ADD → 17
OVER
MUL
ADD
ADD
ASSERT LAST_N == 17
ASSERT SP == 1

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof34_stack_alu" LAST_N SP
