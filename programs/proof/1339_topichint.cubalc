# TOPICHINT — one-line topic docs (FORMHINT twin)

TOPICHINT cap
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"
ASSERT LAST_N >= 10
SYS HASI "HASFORM"
ASSERT LAST_N == 1
SYS HASI "NEEDFORMS"
ASSERT LAST_N == 1

DESCRIBETOPIC plate
ASSERT OK == 1
ASSERT TOPIC_NAME == "plate"
SYS HASI "SETP"
ASSERT LAST_N == 1

TOPICHINT forms
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"

TOPICHINT fat
ASSERT OK == 1
SYS HASI "VARROOM"
ASSERT LAST_N == 1

TOPICHINT p2p
ASSERT OK == 1
SYS HASI "SMX"
ASSERT LAST_N == 1

# miss soft
TOPICHINT zzz_nope
ASSERT OK == 0
CLEAR_ERR

# need name
TOPICHINT
ASSERT OK == 0
CLEAR_ERR

# EACH + TOPICHINT
EACH TOPIC AS t
  TOPICHINT t
  ASSERT OK == 1
  ASSERT LAST_N >= 5
END

PASS
PRINT "1339_topichint: PASS"
