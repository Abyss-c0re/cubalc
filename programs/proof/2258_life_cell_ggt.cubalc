REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_GGT — Ggt gamma-glutamyltransferase after Gst
# Continuum ...->pepf->pdf->map->nata->natb->natc->nate->mete->metk->ahcy->cbs->cgl->gsha->gshb->gor->gpx->gst->ggt
# Gift: Ggt cleaves gamma-Glu from GSH/GS-R so the glutathione free-energy shield engages its mercapturic salvage limb after Gst.
# Cube is SoT. Free energy must flow.

ENTITY founder OF Cell 1 44 0
