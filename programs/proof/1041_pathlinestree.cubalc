# PATHLINETREE / GREPNTREE / RGLINES — recursive path:lineno:line harvest (grep -rn)
# Annotated line bag under a tree without WALK+EACH+READ or shell.

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS PID
SYS STR LAST_N
LET pid = LAST
SYS JOIN td "mi_plt_"
SYS CAT LAST pid
LET base = LAST
SYS MKDIR base
ASSERT OK == 1

# nested logs
SYS JOIN base "a/err.log"
WRITEOUT LAST "ok start\nerror: boom\nerror: again\nok end"
ASSERT OK == 1
SYS JOIN base "a/b/note.txt"
WRITEOUT LAST "all good\nno problem"
ASSERT OK == 1
SYS JOIN base "a/b/warn.log"
WRITEOUT LAST "info\nWARNING: careful\ninfo"
ASSERT OK == 1
SYS JOIN base "plain.txt"
SYS WRITE LAST "nothing here"
ASSERT OK == 1

# harvest error lines with path:lineno (2 from err.log · lines 2 and 3)
PATHLINETREE base "error"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 2
ASSERT LAST_N == 2
ASSERT PATHLINETREE_FILES == 1
SYS HAS LAST "error: boom"
ASSERT LAST_N == 1
SYS HAS LAST "error: again"
ASSERT LAST_N == 1
SYS HAS LAST ":2:"
ASSERT LAST_N == 1
SYS HAS LAST ":3:"
ASSERT LAST_N == 1
SYS HAS LAST "err.log"
ASSERT LAST_N == 1
SYS HAS LAST "good"
ASSERT LAST_N == 0

# multi-file hits with ":" (err 2, warn 1 = 3 annotated)
PATHLINETREE base ":"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 3
ASSERT PATHLINETREE_FILES == 2

# case-sensitive WARNING
PATHLINETREE base "WARNING"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 1
SYS HAS LAST "careful"
ASSERT LAST_N == 1
SYS HAS LAST "warn.log"
ASSERT LAST_N == 1
SYS HAS LAST ":2:"
ASSERT LAST_N == 1

# PATHLINETREEI
PATHLINETREEI base "warning"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 1
ASSERT PATHLINETREE_FILES == 1

# no match
PATHLINETREE base "zzzz_nope"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 0
ASSERT LAST_N == 0

# GREPNTREE / RGLINES aliases
GREPNTREE base "boom"
ASSERT OK == 1
ASSERT GREPNTREE_N == 1
SYS HAS LAST "boom"
ASSERT LAST_N == 1
SYS HAS LAST "err.log"
ASSERT LAST_N == 1
RGLINES base "good"
ASSERT OK == 1
ASSERT RGLINES_N == 1
SYS HAS LAST "all good"
ASSERT LAST_N == 1
SYS HAS LAST "note.txt"
ASSERT LAST_N == 1

# SYS form
SYS PATHLINETREE base "again"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 1
SYS HAS LAST ":3:"
ASSERT LAST_N == 1

# single file root
SYS JOIN base "a/err.log"
LET p = LAST
PATHLINETREE p "error"
ASSERT OK == 1
ASSERT PATHLINETREE_N == 2
ASSERT PATHLINETREE_FILES == 1

# missing soft
PATHLINETREE "/no/such/pathlinestree" "x"
ASSERT OK == 0
LET e = LAST_ERR
SYS HAS e "missing"
ASSERT LAST_N == 1

# empty soft
PATHLINETREE "" "x"
ASSERT OK == 0
LET e2 = LAST_ERR
SYS HAS e2 "empty"
ASSERT LAST_N == 1

# cleanup
RMTREE base
ASSERT OK == 1

PRINT "pathlinestree ok"
ASSERT OK == 1
