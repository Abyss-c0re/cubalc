# IFTWENTYFIVEP — plate exactly-twenty-five key diagnostic branch
# Continues ladder after IFTWENTYFOURP. Soft twin PENTEICOSAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET twentyfour = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24}"
LET twentyfive = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25}"
LET twentysix = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26}"
LET empty = "{}"

IFTWENTYFIVEP twentyfive
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFTWENTYFIVEP_N == 1
ASSERT TWENTYFIVEP_N == 1
ASSERT IFTWENTYFIVEP_LEN == 25
ASSERT IFPENTEICOSAP_N == 1
ASSERT IFTWENTYFIVEKEYP_N == 1

IFPENTEICOSAP twentyfive
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYFIVEKEYP twentyfive
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYFIVEP twentyfour
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYFIVEP_N == 0
ASSERT IFTWENTYFIVEP_LEN == 24

