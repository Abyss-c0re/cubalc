# Proof 261 — digit-5 dual-stack imm byte field: DBYTEN DSETBYTEN DCLRBYTEN
HOLD_FLASH 1
SCIENCE LOAD

# DBYTEN n
CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
DBYTEN 0
POP y
POP x
ASSERT x == 0xDD
ASSERT y == 0x44

CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
2BYTEN 1
POP y
POP x
ASSERT x == 0xCC
ASSERT y == 0x33

CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
PAIRBYTEN 2
POP y
POP x
ASSERT x == 0xBB
ASSERT y == 0x22

# DSETBYTEN field n
CLEARSTACK
PUSH 0x00000000
PUSH -1
DSETBYTEN 0xAB 0
POP y
POP x
ASSERT x == 0xAB
ASSERT y == -85

CLEARSTACK
PUSH 0
PUSH 0
2SETBYTEN 0xCD 1
POP y
POP x
ASSERT x == 0xCD00
ASSERT y == 0xCD00

CLEARSTACK
PUSH -1
PUSH -1
PAIRSETBYTEN 0 2
POP y
POP x
ASSERT x == -16711681
ASSERT y == -16711681

# DCLRBYTEN n
CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
DCLRBYTEN 0
POP y
POP x
ASSERT x == 0xAABBCC00
ASSERT y == 0x11223300

CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
2CLRBYTEN 1
POP y
POP x
ASSERT x == 0xAABB00DD
ASSERT y == 0x11220044

CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
PAIRCLRBYTEN 2
POP y
POP x
ASSERT x == 0xAA00CCDD
ASSERT y == 0x11003344

# soft fails
CLEARSTACK
DBYTEN 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSETBYTEN 2 0
ASSERT OK == 0
CLEARSTACK
DCLRBYTEN 0
ASSERT OK == 0

HOLD_FLASH 1
