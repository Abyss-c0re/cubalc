# Proof 308 — digit-2 imm GCD/LCM: SGCDN SLCMN DGCDN DLCMN
HOLD_FLASH 1
SCIENCE LOAD

# SGCDN n
CLEARSTACK
PUSH 12
SGCDN 18
POP x
ASSERT x == 6

CLEARSTACK
PUSH -15
GCDN 25
POP x
ASSERT x == 5

CLEARSTACK
PUSH 7
STACKGCDN 1
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0
SGCDN 42
POP x
ASSERT x == 42

CLEARSTACK
PUSH 42
SGCDN 0
POP x
ASSERT x == 42

# SLCMN n
CLEARSTACK
PUSH 4
SLCMN 6
POP x
ASSERT x == 12

CLEARSTACK
PUSH -3
LCMN 5
POP x
ASSERT x == 15

CLEARSTACK
PUSH 0
SLCMN 10
POP x
ASSERT x == 0

CLEARSTACK
PUSH 7
STACKLCMN 0
POP x
ASSERT x == 0

# soft fails
CLEARSTACK
SGCDN 3
ASSERT OK == 0
CLEARSTACK
SLCMN 3
ASSERT OK == 0

# DGCDN n — shared n
CLEARSTACK
PUSH 12
PUSH 18
DGCDN 30
POP y
POP x
# gcd(12,30)=6; gcd(18,30)=6
ASSERT x == 6
ASSERT y == 6

CLEARSTACK
PUSH 7
PUSH 14
PAIRGCDN 21
POP y
POP x
ASSERT x == 7
ASSERT y == 7

CLEARSTACK
PUSH -9
PUSH 0
2GCDN 6
POP y
POP x
ASSERT x == 3
ASSERT y == 6

# DLCMN n
CLEARSTACK
PUSH 4
PUSH 6
DLCMN 3
POP y
POP x
# lcm(4,3)=12; lcm(6,3)=6
ASSERT x == 12
ASSERT y == 6

CLEARSTACK
PUSH 5
PUSH 0
PAIRLCMN 10
POP y
POP x
ASSERT x == 10
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 3
2LCMN 4
POP y
POP x
ASSERT x == 4
ASSERT y == 12

# dual soft fail
CLEARSTACK
DGCDN 5
ASSERT OK == 0
CLEARSTACK
PUSH 1
DLCMN 5
ASSERT OK == 0

# still works with binary siblings
CLEARSTACK
PUSH 12
PUSH 18
SGCD
POP x
ASSERT x == 6

HOLD_FLASH 1
