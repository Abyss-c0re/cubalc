# class_guard via native HASCLASSES/NEEDCLASSES + HASCLASSANY/NEEDCLASSANY

HOLD_FLASH 1

CLASS Ticket
  FIELD id
END

CLASS Order
  FIELD n
END

# empty skip
DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_ANY_OK == 1

# soft ALL hit
LET NEED_CLASSES = "Ticket\nOrder"
LET NEED_CLASS_ANY = ""
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASSHAVE_N >= 2
ASSERT CLASSMISS_N == 0

# soft ALL miss — CLASSMISS from HASCLASSES
LET NEED_CLASSES = "Ticket\nGhostClassAll"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 0
ASSERT CLASS_GUARD_OK == 0
ASSERT CLASSMISS_N >= 1
SYS HASI CLASSMISS "GhostClassAll"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY hit — HASCLASSANY bags
LET NEED_CLASSES = ""
LET NEED_CLASS_ANY = "GhostA\nTicket"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASSHAVE_N >= 1
SYS HASI CLASSHAVE "Ticket"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY all-miss
LET NEED_CLASS_ANY = "GhostX\nGhostY"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 0
ASSERT CLASS_GUARD_OK == 0
ASSERT CLASSHAVE_N == 0
ASSERT CLASSMISS_N >= 2
CLEAR_ERR

# hard ALL via NEEDCLASSES
LET NEED_CLASSES = "Ticket\nOrder"
LET NEED_CLASS_ANY = ""
LET CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_OK == 1

# hard ANY via NEEDCLASSANY
LET NEED_CLASSES = ""
LET NEED_CLASS_ANY = "GhostZ\nTicket"
LET CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1

# combined soft
LET NEED_CLASSES = "Ticket"
LET NEED_CLASS_ANY = "Order\nGhostZ"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1

# soft ALL miss + soft ANY hit → overall fail
LET NEED_CLASSES = "Ticket\nGhostAll"
LET NEED_CLASS_ANY = "Order"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 0
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 0
CLEAR_ERR

# surface
HASCLASSES Ticket Order
ASSERT LAST_N == 1
HASCLASSANY Ticket GhostX
ASSERT LAST_N == 1
HASFORM "HASCLASSES"
ASSERT LAST_N == 1
HASFORM "HASCLASSANY"
ASSERT LAST_N == 1
HASLIB class_guard
ASSERT LAST_N == 1

PRINT "1435_class_guard_multi_native ok"
PASS
