# Proof 560 — digit-3 stack+dual field nonzero 8/4: S0NE8N S0NE4N D0NE8N D0NE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0NE8N: 0 → 0
PUSH 0x0
S0NE8N 0
POP x
ASSERT x == 0

# non-zero → 1
CLEARSTACK
PUSH 0x5
SNZ8N 0
POP x
ASSERT x == 1

# 0xFF nonzero
CLEARSTACK
PUSH 0xFF
SNEZ8N 0
POP x
ASSERT x == 1

# high preserve: low 0 → 0
CLEARSTACK
PUSH 0xAA00
SISNZ8N 0
POP x
ASSERT x == 0xAA00

# high preserve: low 3 → 1
CLEARSTACK
PUSH 0xAA03
S0NE8N 0
POP x
ASSERT x == 0xAA01

# STACK0NE8N n1: high nonzero → 1
CLEARSTACK
PUSH 0x0200
STACK0NE8N 1
POP x
ASSERT x == 0x0100

# high zero → 0; low stays
CLEARSTACK
PUSH 0x0003
STACK0NE8N 1
POP x
ASSERT x == 0x0003

# S0NE4N: 0 → 0
CLEARSTACK
PUSH 0x0
S0NE4N 0
POP x
ASSERT x == 0

# non-zero → 1
CLEARSTACK
PUSH 0x3
SNZ4N 0
POP x
ASSERT x == 1

# high nibble preserve: low 0 → 0
CLEARSTACK
PUSH 0x10
S0NE4N 0
POP x
ASSERT x == 0x10

# high preserve: low F → 1
CLEARSTACK
PUSH 0x2F
S0NE4N 0
POP x
ASSERT x == 0x21

# STACK0NE4N n1: high nonzero → 1
CLEARSTACK
PUSH 0x50
STACK0NE4N 1
POP x
ASSERT x == 0x10

# D0NE8N
CLEARSTACK
PUSH 0x0
PUSH 0x7
D0NE8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0xFF
PUSH 0x0
PAIR0NE8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20NE8N n1
CLEARSTACK
PUSH 0x0001
PUSH 0x0500
STACK20NE8N 1
POP y
POP x
ASSERT x == 0x0001
ASSERT y == 0x0100

# D0NE4N
CLEARSTACK
PUSH 0x0
PUSH 0x3
D0NE4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0xF
PUSH 0x0
PAIR0NE4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20NE4N n1
CLEARSTACK
PUSH 0x03
PUSH 0x50
STACK20NE4N 1
POP y
POP x
ASSERT x == 0x03
ASSERT y == 0x10

HOLD_FLASH 0
