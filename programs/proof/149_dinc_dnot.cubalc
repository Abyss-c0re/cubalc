# Proof 149 — digit-1 dual-stack unary control: DINC DDEC DNOT DEQZ DNEZ
HOLD_FLASH 1
SCIENCE LOAD

# DINC
CLEARSTACK
PUSH 5
PUSH -1
DINC
POP y
POP x
ASSERT x == 6
ASSERT y == 0

# DDEC
CLEARSTACK
PUSH 10
PUSH 0
DDEC
POP y
POP x
ASSERT x == 9
ASSERT y == -1

# DNOT
CLEARSTACK
PUSH 0
PUSH -1
DNOT
POP y
POP x
ASSERT x == -1
ASSERT y == 0

# DEQZ
CLEARSTACK
PUSH 0
PUSH 7
DEQZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DNEZ
CLEARSTACK
PUSH 3
PUSH 0
DNEZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# aliases
CLEARSTACK
PUSH 1
PUSH 2
2INC
POP y
POP x
ASSERT x == 2
ASSERT y == 3

CLEARSTACK
PUSH 0
PUSH 1
2EQZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 8
PUSH 9
PAIRNOT
POP y
POP x
ASSERT x == -9
ASSERT y == -10

# soft fails
CLEARSTACK
DINC
ASSERT OK == 0
CLEARSTACK
DDEC
ASSERT OK == 0
CLEARSTACK
DNOT
ASSERT OK == 0
CLEARSTACK
DEQZ
ASSERT OK == 0
CLEARSTACK
DNEZ
ASSERT OK == 0
CLEARSTACK
PUSH 1
2DEC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof149_dinc_dnot" LAST_N SP
