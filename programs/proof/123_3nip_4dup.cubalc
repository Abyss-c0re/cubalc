# Proof 123 — digit-8 depth duals: 3NIP 4DUP 4DROP 4SWAP
HOLD_FLASH 1
SCIENCE LOAD

# 3NIP — a b c → a c
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
3NIP
ASSERT SP == 2
ASSERT LAST_N == 3
POP a
POP b
ASSERT b == 1
ASSERT a == 3

# TNIP alias
CLEARSTACK
PUSH 9
PUSH 8
PUSH 7
TNIP
POP a
POP b
ASSERT b == 9
ASSERT a == 7

# 4DUP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4DUP
ASSERT SP == 8
ASSERT LAST_N == 4
POP a
POP b
POP c
POP d
ASSERT d == 1
ASSERT c == 2
ASSERT b == 3
ASSERT a == 4

# 4DROP
CLEARSTACK
PUSH 10
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4DROP
ASSERT SP == 1
ASSERT LAST_N == 10

# 4SWAP — reverse top 4
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4SWAP
POP a
POP b
POP c
POP d
ASSERT d == 4
ASSERT c == 3
ASSERT b == 2
ASSERT a == 1

# soft fails
CLEARSTACK
PUSH 1
PUSH 2
3NIP
ASSERT OK == 0
4DUP
ASSERT OK == 0
4DROP
ASSERT OK == 0
4SWAP
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof123_3nip_4dup" LAST_N SP
