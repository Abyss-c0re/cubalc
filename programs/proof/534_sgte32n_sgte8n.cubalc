# Proof 534 — digit-6 stack imm field GTE: SGTE32N SGTE16N SGTE8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SGTE32N: greater → 1
PUSH 0xC0000000
SGTE32N 0x10000000 0
POP x
ASSERT x == 1

# equal → 1
CLEARSTACK
PUSH 0xABCD1234
GTE32N 0xABCD1234 0
POP x
ASSERT x == 1

# less → 0
CLEARSTACK
PUSH 0x10000000
SGTE32N 0xC0000000 0
POP x
ASSERT x == 0

# high preserved: low 0x8000 >= 0x1000 → 1
CLEARSTACK
PUSH 0x1122334400008000
SGTE32N 0x1000 0
POP x
ASSERT x == 0x1122334400000001

# STACKGTE32N n1
CLEARSTACK
PUSH 0x9000000000000000
STACKGTE32N 0x10000000 1
POP x
ASSERT x == 0x0000000100000000

# SCMPGE32N / SGEQ32N aliases
CLEARSTACK
PUSH 2
SCMPGE32N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 1
SGEQ32N 2 0
POP x
ASSERT x == 0

# unsigned high bit: 0x80000000 >= 0x7FFFFFFF → 1
CLEARSTACK
PUSH 0x80000000
SGTE32N 0x7FFFFFFF 0
POP x
ASSERT x == 1

# SGTE16N
CLEARSTACK
PUSH 0xF000
SGTE16N 0x2000 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x5555
GTE16N 0x5555 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x10
SGTE16N 0x20 0
POP x
ASSERT x == 0

# preserved half
CLEARSTACK
PUSH 0xAABB8000
SGTE16N 0x1000 0
POP x
ASSERT x == 0xAABB0001

# STACKGTE16N n1
CLEARSTACK
PUSH 0x90000000
STACKGTE16N 0x1000 1
POP x
ASSERT x == 0x00010000

# SGTE8N
CLEARSTACK
PUSH 0xF0
SGTE8N 0x20 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x55
GTE8N 0x55 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x10
SGTE8N 0x20 0
POP x
ASSERT x == 0

# preserved byte
CLEARSTACK
PUSH 0x99AA0080
SGTE8N 0x10 0
POP x
ASSERT x == 0x99AA0001

# STACKGTE8N n1
CLEARSTACK
PUSH 0x00009000
STACKGTE8N 0x10 1
POP x
ASSERT x == 0x00000100

# SCMPGE8N
CLEARSTACK
PUSH 2
SCMPGE8N 2 0
POP x
ASSERT x == 1

# unsigned: 0x80 >= 0x7F → 1
CLEARSTACK
PUSH 0x80
SGTE8N 0x7F 0
POP x
ASSERT x == 1

HOLD_FLASH 0
