# Proof 485 — digit-1 dual-stack imm 4-bit field unary+rotate: DNOT4N DROL4N DROR4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DNOT4N n0: 0x8 → ~8=7 both lanes
PUSH 0x8
PUSH 0x8
DNOT4N 0
POP y
POP x
ASSERT x == 7
ASSERT y == 7

# mixed: 0 → F, F → 0
CLEARSTACK
PUSH 0x0
PUSH 0xF
PAIRNOT4N 0
POP y
POP x
ASSERT x == 15
ASSERT y == 0

# high preserved not
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF08
DNOT4N 0
POP y
POP x
ASSERT x == 0x1122334455667787
ASSERT y == 0x99AABBCCDDEEFF07

# S2NOT4N n1: nibble1 of 0x..88 is 8 → 7 → 0x..78
CLEARSTACK
PUSH 0x88
PUSH 0x88
S2NOT4N 1
POP y
POP x
ASSERT x == 0x78
ASSERT y == 0x78

# DINV4N alias
CLEARSTACK
PUSH 0x0
PUSH 0x1
DINV4N 0
POP y
POP x
ASSERT x == 15
ASSERT y == 14

# DROL4N k=1 n=0: 1 → 2 ; 8 → 1
CLEARSTACK
PUSH 0x1
PUSH 0x8
DROL4N 1 0
POP y
POP x
ASSERT x == 2
ASSERT y == 1

# high preserved rol
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF01
PAIRROL4N 1 0
POP y
POP x
ASSERT x == 0x1122334455667781
ASSERT y == 0x99AABBCCDDEEFF02

# S2ROL4N n2: nibble2 of 0x..7788 is 7=0111 rotl2 → 1101=D
CLEARSTACK
PUSH 0x7788
PUSH 0x7788
S2ROL4N 2 2
POP y
POP x
ASSERT x == 0x7D88
ASSERT y == 0x7D88

# DROR4N k=1 n=0: 2 → 1 ; 1 → 8
CLEARSTACK
PUSH 0x2
PUSH 0x1
DROR4N 1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 8

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA5
PUSH 0x3C
DROL4N 1 0
DROR4N 1 0
POP y
POP x
ASSERT x == 0xA5
ASSERT y == 0x3C

# k masked: k=5 → k&3=1
CLEARSTACK
PUSH 0x1
PUSH 0x1
PAIRROR4N 5 0
POP y
POP x
ASSERT x == 8
ASSERT y == 8

# DROTL4N / STACK2ROR4N aliases
CLEARSTACK
PUSH 0x4
PUSH 0x4
DROTL4N 1 0
POP y
POP x
ASSERT x == 8
ASSERT y == 8

CLEARSTACK
PUSH 0x40
PUSH 0x80
STACK2ROR4N 1 1
POP y
POP x
ASSERT x == 0x20
ASSERT y == 0x40

HOLD_FLASH 0
