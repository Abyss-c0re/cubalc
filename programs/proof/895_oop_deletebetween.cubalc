# DELETEBETWEEN / FREEBETWEEN / FREEBAND — free live objs in closed range
# Usability: WHEREBETWEEN + DELETEWHERE one-shot · band GC without
# dual DELETEWHEREGE+DELETEWHERELE or EACH+GETF+IF+DELETEOBJ

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 10 0
NEW Cell b 1 0 0
NEW Cell c 1 30 0
NEW Cell d 1 5 0
NEW Cell e 1 20 0

CLASS Counter
  FIELD n 0
  METHOD init x
    SETF THIS n x
  END
END
NEW Counter k1 3
NEW Counter k2 50
NEW Counter k3 15
NEW Counter k4 25

# free energy in [5, 20] → a d e
DELETEBETWEEN Cell energy 5 20
ASSERT OK == 1
ASSERT DELETEBETWEEN_N == 3
ASSERT LAST_N == 3
ASSERT DELETEBETWEEN_LO == 5
ASSERT DELETEBETWEEN_HI == 20
SYS HASLINE DELETEBETWEEN "a"
ASSERT LAST_N == 1
SYS HASLINE DELETEBETWEEN "d"
ASSERT LAST_N == 1
SYS HASLINE DELETEBETWEEN "e"
ASSERT LAST_N == 1
HASOBJ a
ASSERT LAST_N == 0
HASOBJ d
ASSERT LAST_N == 0
HASOBJ e
ASSERT LAST_N == 0
HASOBJ b
ASSERT LAST_N == 1 "survivors kept"
HASOBJ c
ASSERT LAST_N == 1

# TO sugar + auto-swap
NEW Cell x 1 8 0
NEW Cell y 1 12 0
DELETEBETWEEN Cell energy 15 TO 7
ASSERT DELETEBETWEEN_N == 2 "x y · lo/hi swapped"
ASSERT DELETEBETWEEN_LO == 7
ASSERT DELETEBETWEEN_HI == 15
HASOBJ x
ASSERT LAST_N == 0
HASOBJ y
ASSERT LAST_N == 0
HASOBJ b
ASSERT LAST_N == 1
HASOBJ c
ASSERT LAST_N == 1

# FREEBAND alias — free counters n in [10, 30]
FREEBAND Counter n 10 30
ASSERT FREEBAND_N == 2 "k3 k4"
HASOBJ k3
ASSERT LAST_N == 0
HASOBJ k4
ASSERT LAST_N == 0
HASOBJ k1
ASSERT LAST_N == 1
HASOBJ k2
ASSERT LAST_N == 1

# OF sugar
NEW Counter m1 12
NEW Counter m2 40
DELETEBETWEEN OF Counter n 10 20
ASSERT DELETEBETWEEN_N == 1 "m1"
HASOBJ m1
ASSERT LAST_N == 0
HASOBJ m2
ASSERT LAST_N == 1
HASOBJ k1
ASSERT LAST_N == 1

# bare field
NEW Cell z 1 1 0
DELETEBETWEEN energy 0 1
ASSERT DELETEBETWEEN_N == 2 "b z · Cell only"
HASOBJ b
ASSERT LAST_N == 0
HASOBJ z
ASSERT LAST_N == 0
HASOBJ c
ASSERT LAST_N == 1
HASOBJ k1
ASSERT LAST_N == 1 "Counter has n not energy"

# empty soft
DELETEBETWEEN Cell energy 100 200
ASSERT OK == 1
ASSERT DELETEBETWEEN_N == 0
HASOBJ c
ASSERT LAST_N == 1

# inclusive single value = DELETEWHERE numeric
NEW Cell p 1 99 0
NEW Cell q 1 99 0
DELETEBETWEEN Cell energy 99 99
ASSERT DELETEBETWEEN_N == 2
HASOBJ p
ASSERT LAST_N == 0
HASOBJ q
ASSERT LAST_N == 0

# NEW reuses freed names
NEW Cell a 1 7 0
HASOBJ a
ASSERT LAST_N == 1
GETF a energy
ASSERT LAST_N == 7

# PURGEBETWEEN alias
NEW Cell u 1 2 0
NEW Cell v 1 3 0
PURGEBETWEEN Cell energy 2 3
ASSERT PURGEBETWEEN_N == 2
HASOBJ u
ASSERT LAST_N == 0
HASOBJ v
ASSERT LAST_N == 0

PRINT "oop_deletebetween ok"
