# Proof 432 — digit-4 cell bit-metrics ext: CLZCELL CTZCELL BSWAP16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# CLZCELL: 0 → 64; 1 → 63; 0x8000000000000000 → 0
CELLSET 0 0
CELLSET 1 1
CLZCELL 0 1
ASSERT CELL(0) == 64
ASSERT CELL(1) == 63
ASSERT LAST_N == 2

# CLZRANGE: high bit of low32 0x80000000 → clz64 = 32
CELLSET 2 2147483648
CLZRANGE 2 2
ASSERT CELL(2) == 32

# CTZCELL: 0 → 64; 8 → 3; 1 → 0
CELLSET 3 0
CELLSET 4 8
CELLSET 5 1
CTZCELL 3 5
ASSERT CELL(3) == 64
ASSERT CELL(4) == 3
ASSERT CELL(5) == 0
ASSERT LAST_N == 3

# CTZRANGE alias
CELLSET 6 16
CTZRANGE 6 6
ASSERT CELL(6) == 4

# BSWAP16CELL: 0x1234 → 0x3412
CELLSET 7 4660
BSWAP16CELL 7 7
ASSERT CELL(7) == 13330
ASSERT LAST_N == 1

# BSWAP16RANGE: 0x00FF → 0xFF00; 0 → 0
CELLSET 8 255
CELLSET 9 0
BSWAP16RANGE 8 9
ASSERT CELL(8) == 65280
ASSERT CELL(9) == 0
ASSERT LAST_N == 2

# round-trip bswap16
CELLSET 10 4660
BSWAP16CELL 10 10
BSWAP16CELL 10 10
ASSERT CELL(10) == 4660

HOLD_FLASH 0
