# NEXTPOW2N / PREVPOW2N / ISPOW2N — power-of-two ceil/floor/predicate
# Twin of stack SCEILPOW2 / SISPOW2. Usability: pagesz = NEXTPOW2N nbytes.

HOLD_FLASH 1

# exact powers stay
NEXTPOW2N 1
ASSERT LAST_N == 1
ASSERT NEXTPOW2N_OK == 1

NEXTPOW2N 8
ASSERT LAST_N == 8
ASSERT NEXTPOW2N_X == 8

PREVPOW2N 8
ASSERT LAST_N == 8

ISPOW2N 8
ASSERT LAST_N == 1
ASSERT ISPOW2N_OK == 1

# ceil / floor non-power
NEXTPOW2N 9
ASSERT LAST_N == 16
ASSERT NEXTPOW2N_OK == 1

PREVPOW2N 9
ASSERT LAST_N == 8

ISPOW2N 9
ASSERT LAST_N == 0

NEXTPOW2N 3
ASSERT LAST_N == 4

PREVPOW2N 3
ASSERT LAST_N == 2

NEXTPOW2N 100
ASSERT LAST_N == 128

PREVPOW2N 100
ASSERT LAST_N == 64

# zero / negative
NEXTPOW2N 0
ASSERT LAST_N == 0
ASSERT NEXTPOW2N_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

PREVPOW2N 0
ASSERT LAST_N == 0

ISPOW2N 0
ASSERT LAST_N == 0

NEXTPOW2N -5
ASSERT LAST_N == 0
ASSERT NEXTPOW2N_OK == 0

PREVPOW2N -5
ASSERT LAST_N == 0

ISPOW2N -8
ASSERT LAST_N == 0

# aliases
CEILPOW2N 10
ASSERT LAST_N == 16
SNEXTPOW2N 10
ASSERT LAST_N == 16
FLOORPOW2N 10
ASSERT LAST_N == 8
SPREVPOW2N 10
ASSERT LAST_N == 8
ISPOWER2N 16
ASSERT LAST_N == 1
POW2PN 15
ASSERT LAST_N == 0

# var subject + pipeline
LET n = 50
NEXTPOW2N n
ASSERT LAST_N == 64
LET n = 50
PREVPOW2N n
ASSERT LAST_N == 32

# LAST decimal
NEXTPOW2N 7
SYS EQS LAST "8"
ASSERT LAST_N == 1

# GETFLAGN pad to next page power
SYS ENV SET CUBALC_ARG0 "--bytes=300"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN bytes OR 0
LET bytes = LAST_N
NEXTPOW2N bytes
ASSERT LAST_N == 512

PRINT "nextpow2n_prevpow2n ok"
