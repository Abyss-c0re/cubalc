# Proof 207 — digit-2 dual-stack numthy: DFIB DFACT DLOG10 DPOW10
HOLD_FLASH 1
SCIENCE LOAD

# DFIB
CLEARSTACK
PUSH 0
PUSH 1
DFIB
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 7
PUSH 10
2FIB
POP y
POP x
ASSERT x == 13
ASSERT y == 55

# PAIRFIB / DFIBONACCI
CLEARSTACK
PUSH 2
PUSH 3
PAIRFIB
POP y
POP x
ASSERT x == 1
ASSERT y == 2

CLEARSTACK
PUSH -1
PUSH 5
DFIBONACCI
POP y
POP x
ASSERT x == 0
ASSERT y == 5

# DFACT
CLEARSTACK
PUSH 0
PUSH 1
DFACT
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 5
PUSH 6
2FACT
POP y
POP x
ASSERT x == 120
ASSERT y == 720

# PAIRFACT negative → 0
CLEARSTACK
PUSH -3
PUSH 4
PAIRFACT
POP y
POP x
ASSERT x == 0
ASSERT y == 24

# DLOG10
CLEARSTACK
PUSH 1
PUSH 9
DLOG10
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 10
PUSH 999
2LOG10
POP y
POP x
ASSERT x == 1
ASSERT y == 2

CLEARSTACK
PUSH 1000
PUSH 0
PAIRLOG10
POP y
POP x
ASSERT x == 3
ASSERT y == -1

# DILOG10 negative
CLEARSTACK
PUSH -5
PUSH 100
DILOG10
POP y
POP x
ASSERT x == -1
ASSERT y == 2

# DPOW10
CLEARSTACK
PUSH 0
PUSH 1
DPOW10
POP y
POP x
ASSERT x == 1
ASSERT y == 10

CLEARSTACK
PUSH 3
PUSH 5
2POW10
POP y
POP x
ASSERT x == 1000
ASSERT y == 100000

# DTENPOW out of range
CLEARSTACK
PUSH 19
PUSH -1
DTENPOW
POP y
POP x
ASSERT x == 0
ASSERT y == 0
