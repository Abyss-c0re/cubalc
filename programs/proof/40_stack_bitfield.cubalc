# Proof 40 — stack bitfield digit-5: SBTEST SSETB SCLRB SFLPB SBEXT SBDEP
HOLD_FLASH 1
SCIENCE LOAD

# SBTEST
CLEARSTACK
PUSH 0x0A
PUSH 1
SBTEST
ASSERT LAST_N == 1
CLEARSTACK
PUSH 0x0A
PUSH 2
SBTEST
ASSERT LAST_N == 0

# SSETB
CLEARSTACK
PUSH 0
PUSH 3
SSETB
ASSERT LAST_N == 8

# SCLRB
CLEARSTACK
PUSH 0x0F
PUSH 0
SCLRB
ASSERT LAST_N == 14

# SFLPB
CLEARSTACK
PUSH 0x0F
PUSH 0
SFLPB
ASSERT LAST_N == 14
PUSH 0
SFLPB
ASSERT LAST_N == 15

# SBEXT: extract 4 bits at pos 4 from 0xAB → 0xA
CLEARSTACK
PUSH 0xAB
PUSH 4
PUSH 4
SBEXT
ASSERT LAST_N == 10

# SBEXT low nibble
CLEARSTACK
PUSH 0xAB
PUSH 0
PUSH 4
SEXTR
ASSERT LAST_N == 11

# SBDEP: deposit 0xC at bit 4 into 0x0A → 0xCA
CLEARSTACK
PUSH 0x0A
PUSH 0xC
PUSH 4
SBDEP
ASSERT LAST_N == 0xCA

# aliases
CLEARSTACK
PUSH 1
PUSH 0
SSETBIT
ASSERT LAST_N == 1
PUSH 0
SCLRBIT
ASSERT LAST_N == 0

# underflow
CLEARSTACK
SBTEST
ASSERT OK == 0
CLEARSTACK
PUSH 1
SBEXT
ASSERT OK == 0

# compose with SSETB chain + popcnt
CLEARSTACK
PUSH 0
PUSH 0
SSETB
PUSH 2
SSETB
PUSH 4
SSETB
ASSERT LAST_N == 21
SPOPCNT
ASSERT LAST_N == 3

# compose SBEXT
CLEARSTACK
PUSH 0xF0
PUSH 4
PUSH 4
SBEXT
ASSERT LAST_N == 15

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof40_stack_bitfield" LAST_N SP
