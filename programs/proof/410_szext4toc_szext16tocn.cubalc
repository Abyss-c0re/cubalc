# Proof 410 — digit-6 stack/imm zext dual ladder: SZEXT4TOC SZEXT8TOCN SZEXT16TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SZEXT4TOC: 0xAB=171 → 0xB=11
CELLSET 1 171
PUSH 1
SZEXT4TOC
ASSERT LAST_N == 11
ASSERT CELL(1) == 11
POP

# ZEXT4TOC alias: 0xFF → 15
CELLSET 2 255
PUSH 2
ZEXT4TOC
ASSERT LAST_N == 15
ASSERT CELL(2) == 15
POP

# SZEXTNTOC: 0xF5=245 → 5
CELLSET 3 245
PUSH 3
SZEXTNTOC
ASSERT LAST_N == 5
ASSERT CELL(3) == 5
POP

# SZEXT8TOCN: 0xABCD=43981 → 0xCD=205
CELLSET 4 43981
PUSH 4
SZEXT8TOCN
ASSERT LAST_N == 205
ASSERT CELL(4) == 205
POP

# ZEXT8TOCN alias: 0xFF → 255
CELLSET 5 255
PUSH 5
ZEXT8TOCN
ASSERT LAST_N == 255
ASSERT CELL(5) == 255
POP

# SZEXT16TOCN: 0xABCD1234=2882343476 → 0x1234=4660
CELLSET 6 2882343476
PUSH 6
SZEXT16TOCN
ASSERT LAST_N == 4660
ASSERT CELL(6) == 4660
POP

# ZEXT16TOCN: 0xFFFF → 65535
CELLSET 7 65535
PUSH 7
ZEXT16TOCN
ASSERT LAST_N == 65535
ASSERT CELL(7) == 65535
POP

# soft short stack OK=0
CLEARSTACK
SZEXT4TOC
ASSERT OK == 0
SZEXT8TOCN
ASSERT OK == 0
SZEXT16TOCN
ASSERT OK == 0

PRINT "410_szext4toc_szext16tocn OK"
