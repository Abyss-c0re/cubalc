# Proof 72 — digit-2 IROOT / ISSQUARE / ISCUBE / NEXTPRIME / PREVPRIME + stack
HOLD_FLASH 1
SCIENCE LOAD

# IROOT
ASSERT IROOT(27, 3) == 3
ASSERT IROOT(26, 3) == 2
ASSERT IROOT(100, 2) == 10
ASSERT IROOT(99, 2) == 9
ASSERT IROOT(16, 4) == 2
ASSERT IROOT(1, 5) == 1
ASSERT IROOT(0, 3) == 0
ASSERT IROOT(8, 1) == 8
ASSERT IROOT(-8, 3) == -2
ASSERT IROOT(-8, 2) == 0
ASSERT IROOT(100, 0) == 0

# ISSQUARE / ISCUBE
ASSERT ISSQUARE(0) == 1
ASSERT ISSQUARE(1) == 1
ASSERT ISSQUARE(16) == 1
ASSERT ISSQUARE(15) == 0
ASSERT ISSQUARE(-4) == 0
ASSERT ISCUBE(27) == 1
ASSERT ISCUBE(8) == 1
ASSERT ISCUBE(-8) == 1
ASSERT ISCUBE(9) == 0
ASSERT ISCUBE(0) == 1

# NEXTPRIME / PREVPRIME
ASSERT NEXTPRIME(1) == 2
ASSERT NEXTPRIME(2) == 3
ASSERT NEXTPRIME(10) == 11
ASSERT NEXTPRIME(100) == 101
ASSERT PREVPRIME(10) == 7
ASSERT PREVPRIME(3) == 2
ASSERT PREVPRIME(2) == 0
ASSERT PREVPRIME(100) == 97

# compose with ISPRIME
ASSERT ISPRIME(NEXTPRIME(90)) == 1
ASSERT ISPRIME(PREVPRIME(90)) == 1

# stack SIROOT
CLEARSTACK
PUSH 81
PUSH 2
SIROOT
ASSERT LAST_N == 9

CLEARSTACK
PUSH 64
PUSH 3
SIROOT
ASSERT LAST_N == 4

# stack SISSQUARE SISCUBE
CLEARSTACK
PUSH 36
SISSQUARE
ASSERT LAST_N == 1
CLEARSTACK
PUSH 20
SISSQUARE
ASSERT LAST_N == 0
CLEARSTACK
PUSH 125
SISCUBE
ASSERT LAST_N == 1

# stack SNEXTPRIME SPREVPRIME
CLEARSTACK
PUSH 14
SNEXTPRIME
ASSERT LAST_N == 17
CLEARSTACK
PUSH 14
SPREVPRIME
ASSERT LAST_N == 13

CLEARSTACK
SIROOT
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof72_iroot_nextprime" LAST_N
