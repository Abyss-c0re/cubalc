# method_guard + HASMETHODS Class.method bag (no N× HASMETHOD soup)

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
  METHOD init
    LET id = 1
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

# empty skip
DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_OK == 1
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_ANY_OK == 1

# soft ALL multi-class hit
LET NEED_METHODS = "Ticket.ping\nTicket.init\nOrder.pay"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_OK == 1
ASSERT METHHAVE_N >= 3
ASSERT METHMISS_N == 0

# soft ALL miss
LET NEED_METHODS = "Ticket.ping\nGhost.nope"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 0
ASSERT METHOD_GUARD_OK == 0
ASSERT METHMISS_N >= 1
SYS HASI METHMISS "Ghost.nope"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY hit
LET NEED_METHODS = ""
LET NEED_METHOD_ANY = "Ghost.x\nTicket.ping"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1
ASSERT METHHAVE_N >= 1
SYS HASI METHHAVE "Ticket.ping"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY all-miss
LET NEED_METHOD_ANY = "Ghost.a\nGhost.b"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 0
ASSERT METHOD_GUARD_OK == 0
ASSERT METHHAVE_N == 0
CLEAR_ERR

# hard ALL
LET NEED_METHODS = "Ticket.ping\nOrder.pay"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_OK == 1

# hard ANY
LET NEED_METHODS = ""
LET NEED_METHOD_ANY = "Ghost.z\nTicket.init"
LET METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1

# combined soft
LET NEED_METHODS = "Ticket.ping"
LET NEED_METHOD_ANY = "Order.pay\nGhost.z"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1

# direct dotted bag form
HASMETHODS "Ticket.ping\nOrder.pay"
ASSERT LAST_N == 1
HASMETHODANY "Ghost.x\nTicket.init"
ASSERT LAST_N == 1
SYS HASI METHHAVE "Ticket.init"
ASSERT LAST_N == 1

# classic Class methods… still works
HASMETHODS Ticket ping init
ASSERT LAST_N == 1

HASFORM "HASMETHODS"
ASSERT LAST_N == 1
HASFORM "HASMETHODANY"
ASSERT LAST_N == 1
HASLIB method_guard
ASSERT LAST_N == 1

PRINT "1436_method_guard_multi_native ok"
PASS
