# Proof 103 — digit-8 stack depth: 3DUP + 3DROP + 2TUCK + 3SWAP
HOLD_FLASH 1
SCIENCE LOAD

# 3DUP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
3DUP
ASSERT SP == 6
POP a
ASSERT a == 3
POP b
ASSERT b == 2
POP c
ASSERT c == 1
POP d
ASSERT d == 3
POP e
ASSERT e == 2
POP f
ASSERT f == 1

# 3DROP
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
3DROP
ASSERT SP == 1
PEEK
ASSERT LAST_N == 10

# TDROP alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
TDROP
ASSERT SP == 0
SEMPTY
ASSERT LAST_N == 1

# 2TUCK: a b c d → c d a b c d
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2TUCK
ASSERT SP == 6
POP p0
ASSERT p0 == 4
POP p1
ASSERT p1 == 3
POP p2
ASSERT p2 == 2
POP p3
ASSERT p3 == 1
POP p4
ASSERT p4 == 4
POP p5
ASSERT p5 == 3

# 3SWAP: a b c → c b a
CLEARSTACK
PUSH 7
PUSH 8
PUSH 9
3SWAP
POP x
ASSERT x == 7
POP y
ASSERT y == 8
POP z
ASSERT z == 9

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
3DUP
ASSERT OK == 0
3DROP
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2TUCK
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof103_3dup_2tuck" LAST_N SP
