# Proof 112 — digit-3 stack immediate rotate + arithmetic shift: SROLN SRORN SSARN
HOLD_FLASH 1
SCIENCE LOAD

# SROLN — 0x12 rotated left 4 → 0x120
CLEARSTACK
PUSH 0x12
SROLN 4
ASSERT LAST_N == 0x120
# full circle: rotl 1 then rotr 1
CLEARSTACK
PUSH 0x8000000000000001
SROLN 1
ASSERT LAST_N == 0x3
SRORN 1
ASSERT LAST_N == 0x8000000000000001

# aliases ROLN / RORN
CLEARSTACK
PUSH 0x0F
ROLN 4
ASSERT LAST_N == 0xF0
RORN 4
ASSERT LAST_N == 0x0F

# rotate by 0 is identity
CLEARSTACK
PUSH 42
SROLN 0
ASSERT LAST_N == 42
SRORN 0
ASSERT LAST_N == 42

# SSARN arithmetic right shift
CLEARSTACK
PUSH -16
SSARN 2
ASSERT LAST_N == -4
CLEARSTACK
PUSH -1
SARN 5
ASSERT LAST_N == -1
CLEARSTACK
PUSH 16
ASHRN 3
ASSERT LAST_N == 2

# chain with SSHLN — 1<<60 rotl 4 wraps to 1
CLEARSTACK
PUSH 1
SSHLN 60
SROLN 4
ASSERT LAST_N == 1
# 0xF0...0 rotl 4 → low nibble 0xF
CLEARSTACK
PUSH -1152921504606846976
SROLN 4
ASSERT LAST_N == 15

# soft fail empty
CLEARSTACK
SROLN 1
ASSERT OK == 0
SRORN 1
ASSERT OK == 0
SSARN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof112_sroln_ssarn" LAST_N SP
