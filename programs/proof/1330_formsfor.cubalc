# FORMSFOR — curated form-name bag by topic (dual of TIPS prose)

FORMSFOR
ASSERT OK == 1
ASSERT FORMSFOR_TOPIC == "general"
ASSERT FORMSFOR_N >= 5
ASSERT LAST_N >= 5
SYS HASI "TIPS"
ASSERT LAST_N == 1
SYS HASI "FORMSFOR"
ASSERT LAST_N == 1

FORMSFOR cap
ASSERT OK == 1
ASSERT FORMSFOR_TOPIC == "cap"
ASSERT FORMSFOR_N >= 5
SYS HASI "HASFORM"
ASSERT LAST_N == 1
SYS HASI "NEEDFORMS"
ASSERT LAST_N == 1
SYS HASI "FORMHINT"
ASSERT LAST_N == 1

FORMSFOR fat
ASSERT OK == 1
ASSERT FORMSFOR_TOPIC == "fat"
SYS HASI "VARROOM"
ASSERT LAST_N == 1
SYS HASI "REMAIN_MS"
ASSERT LAST_N == 1

FORMSFOR plate
ASSERT OK == 1
SYS HASI "SETP"
ASSERT LAST_N == 1
SYS HASI "NEEDP"
ASSERT LAST_N == 1

# alias
TOPICFORMS lib
ASSERT OK == 1
ASSERT FORMSFOR_TOPIC == "lib"
SYS HASI "LISTLIBS"
ASSERT LAST_N == 1
SYS HASI "RECIPE"
ASSERT LAST_N == 1

FORMSFOR run
ASSERT OK == 1
SYS HASI "WHY"
ASSERT LAST_N == 1

# capability alias
FORMSFOR forms
ASSERT OK == 1
ASSERT FORMSFOR_TOPIC == "cap"

# unknown soft fail
FORMSFOR zzz_no_topic
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1330_formsfor: PASS"
