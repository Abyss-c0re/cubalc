# Proof 209 — digit-8 dual-stack nibble rotate/swap: DROL4 DROR4 DNIBSWAP
HOLD_FLASH 1
SCIENCE LOAD

# DROL4: rotate low nibble left
CLEARSTACK
PUSH 0x1
PUSH 0x8
PUSH 1
PUSH 1
DROL4
POP y
POP x
ASSERT x == 0x2
ASSERT y == 0x1

# wrap within 4 bits
CLEARSTACK
PUSH 0x9
PUSH 0xF
PUSH 1
PUSH 2
2ROL4
POP y
POP x
ASSERT x == 0x3
ASSERT y == 0xF

# PAIRROL4 amount 0 identity (low 4)
CLEARSTACK
PUSH 0xA
PUSH 0x5
PUSH 0
PUSH 0
PAIRROL4
POP y
POP x
ASSERT x == 0xA
ASSERT y == 0x5

# DROR4
CLEARSTACK
PUSH 0x2
PUSH 0x1
PUSH 1
PUSH 1
DROR4
POP y
POP x
ASSERT x == 0x1
ASSERT y == 0x8

# 2ROR4 / PAIRROR4
CLEARSTACK
PUSH 0x3
PUSH 0xF
PUSH 1
PUSH 2
PAIRROR4
POP y
POP x
ASSERT x == 0x9
ASSERT y == 0xF

# amount mod 4: 5 ≡ 1
CLEARSTACK
PUSH 0x1
PUSH 0x4
PUSH 5
PUSH 5
DROL4
POP y
POP x
ASSERT x == 0x2
ASSERT y == 0x8

# DNIBSWAP: high/low nibble of low byte
CLEARSTACK
PUSH 0xAB
PUSH 0x12
DNIBSWAP
POP y
POP x
ASSERT x == 0xBA
ASSERT y == 0x21

# 2NIBSWAP masks high garbage
CLEARSTACK
PUSH 0x1F0
PUSH 0x0F
2NIBSWAP
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0xF0

# PAIRNIBSWAP / DSWAPNIB
CLEARSTACK
PUSH 0x34
PUSH 0x56
PAIRNIBSWAP
POP y
POP x
ASSERT x == 0x43
ASSERT y == 0x65

CLEARSTACK
PUSH 0x00
PUSH 0xFF
DSWAPNIB
POP y
POP x
ASSERT x == 0x00
ASSERT y == 0xFF
