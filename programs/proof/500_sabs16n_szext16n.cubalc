# Proof 500 — digit-9 stack imm 16-bit field abs+extend: SABS16N SSEXT16N SZEXT16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SABS16N: 0xFFFE (-2)→2 ; 0x0005→5
PUSH 0xFFFE
SABS16N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x0005
ABS16N 0
POP x
ASSERT x == 5

# min int16 -32768 stays 0x8000
CLEARSTACK
PUSH 0x8000
SABS16N 0
POP x
ASSERT x == 32768

# high preserved abs: low16 FE00 abs? 0xFFFE → 2; use 0x...FFFE
CLEARSTACK
PUSH 0x11223344FFFE
SABS16N 0
POP x
ASSERT x == 0x112233440002

# STACKABS16N n1: half1 of 0xFFFE0001 is FFFE=-2 → abs 2 → 0x00020001
CLEARSTACK
PUSH 0xFFFE0001
STACKABS16N 1
POP x
ASSERT x == 0x00020001

# SSEXT16N: 0x7FFF→32767 ; 0xFFFE→-2 ; 0x8000→-32768
CLEARSTACK
PUSH 0x7FFF
SSEXT16N 0
POP x
ASSERT x == 32767

CLEARSTACK
PUSH 0xFFFE
SSEXT16N 0
POP x
ASSERT x == -2

CLEARSTACK
PUSH 0x8000
SEXT16N 0
POP x
ASSERT x == -32768

# STACKSEXT16N n1: 0xA0000001 half1=A000=-24576
CLEARSTACK
PUSH 0xA0000001
STACKSEXT16N 1
POP x
ASSERT x == -24576

# high ignored: 0x1FFFF → -1
CLEARSTACK
PUSH 0x1FFFF
SSEXT16N 0
POP x
ASSERT x == -1

# SZEXT16N: extract halfword
CLEARSTACK
PUSH 0xABCD1234
SZEXT16N 0
POP x
ASSERT x == 0x1234

CLEARSTACK
PUSH 0xABCD1234
STACKZEXT16N 1
POP x
ASSERT x == 0xABCD

# ZEXT16N n2 of 0x112233445566: half2=0x2233? 
# halves: n0=5566, n1=3344, n2=1122, n3=0 on 48-bit... for 0x112233445566
# 0x112233445566: n0=0x5566, n1=0x3344, n2=0x1122
CLEARSTACK
PUSH 0x112233445566
ZEXT16N 2
POP x
ASSERT x == 0x1122

# aliases
CLEARSTACK
PUSH 0xFFFC
SIABS16N 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0xFFFC
SWORDSEXTN 0
POP x
ASSERT x == -4

CLEARSTACK
PUSH 0xFFFF0000
SWORDZEXTN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x0000FFFF
SWORDZEXTN 0
POP x
ASSERT x == 65535

# SABSWORDN n1: 0x80000000 half1=8000 min stays 8000
CLEARSTACK
PUSH 0x80000000
SABSWORDN 1
POP x
ASSERT x == 0x80000000

HOLD_FLASH 0
