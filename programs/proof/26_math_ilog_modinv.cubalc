# Proof 26 — math plane digit-2: ILOG2/CTZ/CLZ/ISPOW2/POW2/NDIGITS/DIGSUM/MODINV
HOLD_FLASH 1
SCIENCE LOAD

# ILOG2 / LOG2
ASSERT ILOG2(1) == 0
ASSERT ILOG2(2) == 1
ASSERT ILOG2(3) == 1
ASSERT ILOG2(8) == 3
ASSERT ILOG2(1024) == 10
ASSERT LOG2(16) == 4
ASSERT ILOG2(0) == -1
ASSERT ILOG2(-3) == -1

# POW2 / ISPOW2
ASSERT POW2(0) == 1
ASSERT POW2(3) == 8
ASSERT POW2(10) == 1024
ASSERT ISPOW2(1) == 1
ASSERT ISPOW2(8) == 1
ASSERT ISPOW2(6) == 0
ASSERT ISPOW2(0) == 0
ASSERT ISPOW2(-2) == 0

# CTZ / CLZ (64-bit word)
ASSERT CTZ(1) == 0
ASSERT CTZ(2) == 1
ASSERT CTZ(8) == 3
ASSERT CTZ(12) == 2
ASSERT CTZ(0) == 64
ASSERT CLZ(1) == 63
ASSERT CLZ(POW2(62)) == 1
ASSERT CLZ(0) == 64

# NDIGITS / DIGSUM
ASSERT NDIGITS(0) == 1
ASSERT NDIGITS(7) == 1
ASSERT NDIGITS(99) == 2
ASSERT NDIGITS(1000) == 4
ASSERT NDIGITS(-42) == 2
ASSERT DIGSUM(0) == 0
ASSERT DIGSUM(7) == 7
ASSERT DIGSUM(99) == 18
ASSERT DIGSUM(1234) == 10
ASSERT DIGSUM(-55) == 10

# MODINV / INVMOD
ASSERT MODINV(3, 7) == 5
ASSERT (3 * MODINV(3, 7)) % 7 == 1
ASSERT INVMOD(5, 11) == 9
ASSERT (5 * INVMOD(5, 11)) % 11 == 1
ASSERT MODINV(2, 4) == 0
ASSERT MODINV(0, 5) == 0

# compose with existing modular plane
ASSERT POWMOD(2, ILOG2(8), 1000) == 8
ASSERT ADDMOD(DIGSUM(99), 1, 10) == 9

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof26_math_ilog" ILOG2(1024) CTZ(8) MODINV(3,7) DIGSUM(1234)
