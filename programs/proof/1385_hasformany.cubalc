# HASFORMANY / NEEDFORMANY — multi form any-of capability gate (HASFORMS twin)

HOLD_FLASH 1

# empty soft → 0
HASFORMANY
ASSERT LAST_N == 0
ASSERT HASFORMANY_N == 0

# missing all
HASFORMANY NO_SUCH_FORM_AAA_ZZZ NO_SUCH_FORM_BBB_ZZZ
ASSERT LAST_N == 0
ASSERT FORMMISS_N == 2
ASSERT HASFORMANY_N == 0
ASSERT NEEDFORMANY_N == 2
ASSERT OK == 0
SYS HASLINE FORMMISS "NO_SUCH_FORM_AAA_ZZZ"
ASSERT LAST_N == 1

# partial hit (any-of succeeds with one real form)
HASFORMANY NO_SUCH_FORM_AAA_ZZZ HASFORM SORTLIBS
ASSERT LAST_N == 1
ASSERT HASFORMANY_N >= 1
ASSERT OK == 1
SYS HASLINE FORMHAVE "HASFORM"
ASSERT LAST_N == 1
SYS HASLINE FORMMISS "NO_SUCH_FORM_AAA_ZZZ"
ASSERT LAST_N == 1

# all present
HASFORMANY HASFORM NEEDFORM HASFORMS
ASSERT LAST_N == 1
ASSERT HASFORMANY_N == 3
ASSERT FORMMISS_N == 0
ASSERT OK == 1

# bag / CSV
HASFORMANY "HASFORM,NEEDFORM"
ASSERT LAST_N == 1

# hard twin passes when any known
NEEDFORMANY HASFORM NO_SUCH_FORM_CCC_ZZZ
ASSERT LAST_N == 1
ASSERT OK == 1

# soft miss sticky ERR
HASFORMANY NO_SUCH_FORM_DDD_ZZZ NO_SUCH_FORM_EEE_ZZZ
ASSERT LAST_N == 0
ASSERT OK == 0
SYS HASI LAST_ERR "HASFORMANY miss"
ASSERT LAST_N == 1
CLEAR_ERR

# IF without N× HASFORM
HASFORMANY HASFORM WALK PATHGLOB
IF LAST_N == 1
  LET gate "ok"
ELSE
  LET gate "no"
END
SYS EQS gate "ok"
ASSERT LAST_N == 1

# discoverable
HASFORM HASFORMANY
ASSERT LAST_N == 1
HASFORM NEEDFORMANY
ASSERT LAST_N == 1

# form_guard ANY dual
LET NEED_FORMS = ""
LET NEED_FORM_ANY = "HASFORM\nNO_SUCH_FORM_ZZZ"
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_ANY_OK == 1
ASSERT FORM_GUARD_OK == 1
SYS HASLINE FORMHAVE "HASFORM"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_FORM_ANY = "NO_SUCH_FORM_AAA\nNO_SUCH_FORM_BBB"
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_ANY_OK == 0
ASSERT FORM_GUARD_OK == 0
CLEAR_ERR

# hard any with known form
LET NEED_FORMS = ""
LET NEED_FORM_ANY = "HASFORM\nNO_SUCH_FORM_CCC"
LET FORM_GUARD_SOFT = 0
INCLUDE form_guard
ASSERT FORM_GUARD_ANY_OK == 1
ASSERT FORM_GUARD_OK == 1

PRINT "hasformany ok"
PASS
