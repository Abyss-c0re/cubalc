# Proof 247 — digit-6 stack low-n mask plane: SANDMN SORMN SXORMN
HOLD_FLASH 1
SCIENCE LOAD

# SANDMN — keep low n bits
CLEARSTACK
PUSH 0xABCD
SANDMN 8
POP x
ASSERT x == 0xCD

CLEARSTACK
PUSH 0xF0AB
STACKANDMN 4
POP x
ASSERT x == 0x0B

# KEEPLN alias
CLEARSTACK
PUSH 0x55AA
KEEPLN 0
POP x
ASSERT x == 0

# SORMN — set low n bits
CLEARSTACK
PUSH 0xF000
SORMN 8
POP x
ASSERT x == 0xF0FF

CLEARSTACK
PUSH 0x00
STACKORMN 4
POP x
ASSERT x == 0x0F

# SETLN alias
CLEARSTACK
PUSH 0xA0
SETLN 4
POP x
ASSERT x == 0xAF

# SXORMN — toggle low n bits
CLEARSTACK
PUSH 0x0F
SXORMN 8
POP x
# 0x0F ^ 0xFF = 0xF0
ASSERT x == 0xF0

CLEARSTACK
PUSH 0xF0AB
STACKXORMN 4
POP x
# low nibble 0xB ^ 0xF = 0x4 → 0xF0A4
ASSERT x == 0xF0A4

# FLIPLN alias + round-trip double xor
CLEARSTACK
PUSH 0xA5
FLIPLN 8
FLIPLN 8
POP x
ASSERT x == 0xA5

# n=64 all ones
CLEARSTACK
PUSH 0
SORMN 64
POP x
ASSERT x == -1

# soft fails
CLEARSTACK
SANDMN 4
ASSERT OK == 0
CLEARSTACK
SORMN 4
ASSERT OK == 0
CLEARSTACK
SXORMN 4
ASSERT OK == 0

HOLD_FLASH 1
