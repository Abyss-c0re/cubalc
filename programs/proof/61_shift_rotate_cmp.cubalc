# Proof 61 — digit-1 SAR ROTL64/ROTR64 ICMP UCMP ULT/UGT + stack
HOLD_FLASH 1
SCIENCE LOAD

# SAR / ASHR arithmetic right shift (sign-preserving)
ASSERT SAR(-8, 1) == -4
ASSERT SAR(-8, 2) == -2
ASSERT ASHR(16, 2) == 4
ASSERT SAR(7, 1) == 3
ASSERT SHR(-8, 1) != SAR(-8, 1)

# ROTL64 / ROTR64
ASSERT ROTL64(1, 1) == 2
ASSERT ROTR64(2, 1) == 1
ASSERT ROL64(1, 63) == BSET(0, 63)
ASSERT ROR64(BSET(0, 63), 63) == 1
ASSERT ROTL64(0x0123456789ABCDEF, 4) == ROTR64(0x0123456789ABCDEF, 60)

# ICMP / CMP3 signed three-way
ASSERT ICMP(3, 5) == -1
ASSERT ICMP(5, 3) == 1
ASSERT ICMP(7, 7) == 0
ASSERT CMP3(-2, -1) == -1
ASSERT CMP3(0, -1) == 1

# ULT/UGT/ULE/UGE unsigned (negative as large)
ASSERT ULT(1, 2) == 1
ASSERT UGT(2, 1) == 1
ASSERT ULE(5, 5) == 1
ASSERT UGE(5, 5) == 1
ASSERT ULT(-1, 1) == 0
ASSERT UGT(-1, 1) == 1
ASSERT ULE(0, -1) == 1

# UCMP three-way unsigned
ASSERT UCMP(1, 2) == -1
ASSERT UCMP(-1, 1) == 1
ASSERT UCMP3(9, 9) == 0

# compose with SELECT/SAR
ASSERT SELECT(ULT(1, 2), 10, 0) == 10
ASSERT SAR(ROTL64(1, 3), 1) == 4
ASSERT ICMP(SAR(-16, 2), -4) == 0

# stack SCMP / SUCMP
CLEARSTACK
PUSH 3
PUSH 5
SCMP
ASSERT LAST_N == -1
CLEARSTACK
PUSH 9
PUSH 9
SICMP
ASSERT LAST_N == 0
CLEARSTACK
PUSH -1
PUSH 1
SUCMP
ASSERT LAST_N == 1

# stack SULT SUGT
CLEARSTACK
PUSH 1
PUSH 2
SULT
ASSERT LAST_N == 1
CLEARSTACK
PUSH -1
PUSH 1
SUGT
ASSERT LAST_N == 1
CLEARSTACK
PUSH 5
PUSH 5
SULE
ASSERT LAST_N == 1
CLEARSTACK
PUSH 5
PUSH 5
SUGE
ASSERT LAST_N == 1

# stack SROTL64 SROTR64
CLEARSTACK
PUSH 1
PUSH 1
SROTL64
ASSERT LAST_N == 2
CLEARSTACK
PUSH 2
PUSH 1
SROTR64
ASSERT LAST_N == 1
CLEARSTACK
PUSH 1
PUSH 63
SROL64
ASSERT LAST_N == BSET(0, 63)

# underflow
CLEARSTACK
SCMP
ASSERT OK == 0
CLEARSTACK
SULT
ASSERT OK == 0
CLEARSTACK
SROTL64
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof61_shift_rotate_cmp" LAST_N SP
