# Proof 336 — digit-1 stack↔cell 3-way compare TOC: SCMPTOC SUCMPTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCMPTOC equal → 0
CELLSET 1 5
PUSH 1
PUSH 5
SCMPTOC
ASSERT LAST_N == 0
ASSERT CELL(1) == 0
POP a
ASSERT a == 0

# SICMPTOC less → -1
CELLSET 2 3
PUSH 2
PUSH 10
SICMPTOC
ASSERT LAST_N == (-1)
ASSERT CELL(2) == (-1)
POP

# SCMPAT greater → 1
CELLSET 3 9
PUSH 3
PUSH 2
SCMPAT
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# CMP3TOC alias equal
CELLSET 4 7
PUSH 4
PUSH 7
CMP3TOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SUCMPTOC equal
CELLSET 5 4
PUSH 5
PUSH 4
SUCMPTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# unsigned: -1 (u-max) vs 0 → greater (+1)
PUSH 6
PUSH (-1)
SSETCELL
POP
PUSH 6
PUSH 0
SUCMPTOC
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# signed: -1 vs 0 → less (-1)
PUSH 7
PUSH (-1)
SSETCELL
POP
PUSH 7
PUSH 0
SCMPTOC
ASSERT LAST_N == (-1)
ASSERT CELL(7) == (-1)
POP

# SUCMPAT: 0 vs u-max → less (-1)
CELLSET 8 0
PUSH 8
PUSH (-1)
SUCMPAT
ASSERT LAST_N == (-1)
ASSERT CELL(8) == (-1)
POP

# SUCMP3TOC: 10 vs 3 unsigned greater
CELLSET 9 10
PUSH 9
PUSH 3
SUCMP3TOC
ASSERT LAST_N == 1
ASSERT CELL(9) == 1
POP

# soft fails
CLEARSTACK
SCMPTOC
ASSERT OK == 0
SUCMPTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof336_scmptoc_sucmptoc" LAST_N SP
HOLD_FLASH 1
