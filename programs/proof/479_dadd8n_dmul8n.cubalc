# Proof 479 — digit-7 dual-stack imm 8-bit field arith: DADD8N DSUB8N DMUL8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DADD8N: byte0 of pair + 0x20
PUSH 0x10
PUSH 0x30
DADD8N 0x20 0
POP y
POP x
ASSERT x == 0x30
ASSERT y == 0x50

# wrap: 0xFF + 2 → 0x01 both
CLEARSTACK
PUSH 0xFF
PUSH 0xFE
PAIRADD8N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# high preserved: byte0 + 0x05
CLEARSTACK
PUSH 0x1122334455667710
PUSH 0x99AABBCCDDEEFF20
DADD8N 0x05 0
POP y
POP x
ASSERT x == 0x1122334455667715
ASSERT y == 0x99AABBCCDDEEFF25

# S2ADD8N n1: byte1 of each + 0x10
CLEARSTACK
PUSH 0x0200
PUSH 0x0400
S2ADD8N 0x10 1
POP y
POP x
ASSERT x == 0x1200
ASSERT y == 0x1400

# DINC8N alias
CLEARSTACK
PUSH 0xFE
PUSH 0x01
DINC8N 1 0
POP y
POP x
ASSERT x == 255
ASSERT y == 2

# DSUB8N
CLEARSTACK
PUSH 0x50
PUSH 0x40
DSUB8N 0x10 0
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0x30

# wrap borrow: 0x01 - 2 → 0xFF
CLEARSTACK
PUSH 0x01
PUSH 0x00
PAIRSUB8N 2 0
POP y
POP x
ASSERT x == 255
ASSERT y == 254

# STACK2SUB8N n1
CLEARSTACK
PUSH 0x5000
PUSH 0x3000
STACK2SUB8N 0x10 1
POP y
POP x
ASSERT x == 0x4000
ASSERT y == 0x2000

# DDEC8N alias
CLEARSTACK
PUSH 0x00
PUSH 0x05
DDEC8N 1 0
POP y
POP x
ASSERT x == 255
ASSERT y == 4

# DMUL8N wrap: 0x10 * 0x10 → 0 both
CLEARSTACK
PUSH 0x10
PUSH 0x20
DMUL8N 0x10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# non-wrap mul
CLEARSTACK
PUSH 0x03
PUSH 0x04
PAIRMUL8N 5 0
POP y
POP x
ASSERT x == 15
ASSERT y == 20

# zero annihilator
CLEARSTACK
PUSH 0xAB
PUSH 0xCD
DMUL8N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved mul: byte0 * 3
CLEARSTACK
PUSH 0x1122334455667703
PUSH 0x99AABBCCDDEEFF07
DMUL8N 3 0
POP y
POP x
ASSERT x == 0x1122334455667709
ASSERT y == 0x99AABBCCDDEEFF15

# S2MUL8N n1: byte1 * 2
CLEARSTACK
PUSH 0x0400
PUSH 0x0500
S2MUL8N 2 1
POP y
POP x
ASSERT x == 0x0800
ASSERT y == 0x0A00

# DTIMES8N alias
CLEARSTACK
PUSH 0x06
PUSH 0x07
DTIMES8N 4 0
POP y
POP x
ASSERT x == 24
ASSERT y == 28

# round-trip add then sub
CLEARSTACK
PUSH 0xA5
PUSH 0x12
DADD8N 0x11 0
DSUB8N 0x11 0
POP y
POP x
ASSERT x == 0xA5
ASSERT y == 0x12

HOLD_FLASH 0
