# MEDIANP / P50P — multi-plate integer median (MEDIANKV dual · robust twin of AVGNP)
# Usability: score mid without TOKV+MEDIANKV or JSONVALUES+MEDIAN glue.

HOLD_FLASH 1

# odd count: 1,3,8,10,100 → mid 8 (not mean ~24)
LET PLATE = "{\"a\":10,\"b\":3,\"c\":8,\"d\":1,\"e\":100,\"label\":\"x\"}"
LET PEER = "{\"w\":2,\"x\":4,\"y\":6,\"z\":8}"
LET empty = "{}"
LET one = "{\"only\":7,\"tag\":\"t\"}"

MEDIANP
ASSERT OK == 1
ASSERT LAST_N == 8
ASSERT MEDIANP_N == 8
ASSERT MEDIANP_USED == 5
ASSERT MEDIANP_FROM == 0

# mean would be 24 — median robust to outlier 100
AVGNP
ASSERT AVGNP_N == 24

# FROM PEER even count 2,4,6,8 → lower mid vals[1]=4
MEDIANP FROM PEER
ASSERT MEDIANP_FROM == 1
ASSERT LAST_N == 4
ASSERT MEDIANP_USED == 4
SYS EQS MEDIANP_SRC "PEER"
ASSERT LAST_N == 1
# re-set LAST_N from median after EQS clobber
MEDIANP FROM PEER
ASSERT MEDIANP_N == 4

# aliases
P50P FROM PEER
ASSERT P50P_N == 4
MIDP
ASSERT MEDIANP_N == 8

# single value
MEDIANP FROM one
ASSERT MEDIANP_N == 7
ASSERT MEDIANP_USED == 1

# empty soft 0
MEDIANP FROM empty
ASSERT MEDIANP_N == 0
ASSERT MEDIANP_USED == 0
ASSERT OK == 1

PRINT "medianp soft ok"
