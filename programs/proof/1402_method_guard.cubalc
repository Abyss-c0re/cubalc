# INCLUDE method_guard - multi Class.method catalog ALL + ANY contract

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
  METHOD init
    LET id = 1
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_OK == 1
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_ANY_OK == 1

LET NEED_METHODS = "Ticket.ping\nnosuch_cubalc_method_all"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_OK == 0
ASSERT METHOD_GUARD_ALL_OK == 0
ASSERT METHMISS_N >= 1
SYS HASLINE METHMISS "nosuch_cubalc_method_all"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_METHODS = "Ticket.ping\nTicket.init"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_OK == 1
ASSERT METHHAVE_N >= 2

LET NEED_METHODS = ""
LET NEED_METHOD_ANY = "nosuch_a\nnosuch_b"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 0
ASSERT METHOD_GUARD_OK == 0
CLEAR_ERR

LET NEED_METHOD_ANY = "nosuch_a\nTicket.ping"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1
CLEAR_ERR

LET NEED_METHODS = "Ticket.ping\nTicket.init"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_OK == 1

LET NEED_METHODS = ""
LET NEED_METHOD_ANY = "nosuch_z\nTicket.ping"
LET METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1

LET NEED_METHODS = "Ticket.ping"
LET NEED_METHOD_ANY = "Order.pay\nnosuch_z"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1

# missing class also counts as method miss
LET NEED_METHODS = "Ghost.ping"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 0
SYS HASLINE METHMISS "Ghost.ping"
ASSERT LAST_N == 1
CLEAR_ERR

HASFORM "LISTMETHODS"
ASSERT LAST_N == 1
HASFORM "HASMETHOD"
ASSERT LAST_N == 1
HASLIB method_guard
ASSERT LAST_N == 1

PRINT "1402_method_guard ok"
PASS
