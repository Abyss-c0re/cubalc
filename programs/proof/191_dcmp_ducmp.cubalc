# Proof 191 — digit-1 dual-stack 3-way compare: DCMP DUCMP
HOLD_FLASH 1
SCIENCE LOAD

# DCMP: a b c d → cmp(a,c) cmp(b,d)
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 4
DCMP
POP y
POP x
ASSERT x == -1
ASSERT y == 1

# equal
CLEARSTACK
PUSH 7
PUSH 7
PUSH 7
PUSH 7
2CMP
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRCMP / DICMP / DCMP3
CLEARSTACK
PUSH 10
PUSH 1
PUSH 2
PUSH 1
PAIRCMP
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -5
PUSH 0
PUSH 0
PUSH -1
DICMP
POP y
POP x
ASSERT x == -1
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH 0
PUSH 1
PUSH -1
DCMP3
POP y
POP x
ASSERT x == -1
ASSERT y == 1

# DUCMP: -1 as unsigned is max
CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DUCMP
POP y
POP x
ASSERT x == 1
ASSERT y == -1

# 2UCMP equal
CLEARSTACK
PUSH 0
PUSH 0
PUSH 0
PUSH 0
2UCMP
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRUCMP / DUCMP3
CLEARSTACK
PUSH 1
PUSH 100
PUSH 2
PUSH 50
PAIRUCMP
POP y
POP x
ASSERT x == -1
ASSERT y == 1

CLEARSTACK
PUSH 8
PUSH 8
PUSH 8
PUSH 9
DUCMP3
POP y
POP x
ASSERT x == 0
ASSERT y == -1

# signed vs unsigned differ on high bit
CLEARSTACK
PUSH -1
PUSH -1
PUSH 0
PUSH 0
DCMP
POP y
POP x
ASSERT x == -1
ASSERT y == -1
CLEARSTACK
PUSH -1
PUSH -1
PUSH 0
PUSH 0
DUCMP
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# S2CMP / STACK2UCMP aliases
CLEARSTACK
PUSH 2
PUSH 3
PUSH 2
PUSH 1
S2CMP
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 2
PUSH 3
PUSH 2
PUSH 1
STACK2UCMP
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# soft fail
CLEARSTACK
PUSH 1
PUSH 2
DCMP
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DUCMP
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof191_dcmp_ducmp" LAST_N SP
