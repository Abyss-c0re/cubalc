# Proof 228 — digit-9 dual-stack immediate min/max/clamp: DMINN DMAXN DCLAMPN
HOLD_FLASH 1
SCIENCE LOAD

# DMINN
CLEARSTACK
PUSH 10
PUSH 3
DMINN 5
POP y
POP x
ASSERT x == 5
ASSERT y == 3

CLEARSTACK
PUSH -2
PUSH 8
2MINN 0
POP y
POP x
ASSERT x == -2
ASSERT y == 0

# PAIRMINN / DMINIMM
CLEARSTACK
PUSH 100
PUSH 100
PAIRMINN 50
POP y
POP x
ASSERT x == 50
ASSERT y == 50

CLEARSTACK
PUSH 1
PUSH 2
DMINIMM 1
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DMAXN
CLEARSTACK
PUSH 10
PUSH 3
DMAXN 5
POP y
POP x
ASSERT x == 10
ASSERT y == 5

CLEARSTACK
PUSH -5
PUSH 0
2MAXN -1
POP y
POP x
ASSERT x == -1
ASSERT y == 0

# PAIRMAXN / DMAXIMM
CLEARSTACK
PUSH 7
PUSH 9
PAIRMAXN 8
POP y
POP x
ASSERT x == 8
ASSERT y == 9

CLEARSTACK
PUSH 0
PUSH 0
DMAXIMM 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DCLAMPN lo hi
CLEARSTACK
PUSH -5
PUSH 50
DCLAMPN 0 10
POP y
POP x
ASSERT x == 0
ASSERT y == 10

CLEARSTACK
PUSH 3
PUSH 7
2CLAMPN 0 10
POP y
POP x
ASSERT x == 3
ASSERT y == 7

# swapped bounds still work
CLEARSTACK
PUSH 100
PUSH -100
PAIRCLAMPN 20 5
POP y
POP x
ASSERT x == 20
ASSERT y == 5

# DBOUNDN alias
CLEARSTACK
PUSH 15
PUSH -3
DBOUNDN 0 10
POP y
POP x
ASSERT x == 10
ASSERT y == 0

# chain MAX then MIN (clamp style)
CLEARSTACK
PUSH -20
PUSH 40
DMAXN 0
DMINN 10
POP y
POP x
ASSERT x == 0
ASSERT y == 10

# soft empty
CLEARSTACK
DMINN 1
ASSERT OK == 0
