# Proof 53 — digit-8 PACK8/PACKNIB/SETNIB + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# PACK8 / PACKB
ASSERT PACK8(0xAB, 0xCD) == 0xABCD
ASSERT PACKB(0x11, 0x22) == 0x1122
ASSERT PACK8(0x1FF, 0x2EE) == 0xFFEE
ASSERT HIBYTE(PACK8(0x12, 0x34)) == 0x12
ASSERT LOBYTE(PACK8(0x12, 0x34)) == 0x34

# PACKNIB / PACK4
ASSERT PACKNIB(0xA, 0xB) == 0xAB
ASSERT PACK4(0xF, 0x0) == 0xF0
ASSERT PACKNIB(0x1A, 0x2B) == 0xAB

# SETNIB / SETNIBBLE
ASSERT SETNIB(0x0000, 0xC, 0) == 0xC
ASSERT SETNIB(0x0000, 0xA, 1) == 0xA0
ASSERT SETNIBBLE(0xABCD, 0x0, 0) == 0xABC0
ASSERT SETNIB(0xABCD, 0xE, 2) == 0xAECD
ASSERT NIBBLE(SETNIB(0, 0xF, 3), 3) == 0xF

# stack SPACK8
CLEARSTACK
PUSH 0xAB
PUSH 0xCD
SPACK8
ASSERT LAST_N == 0xABCD

# stack SPACKNIB
CLEARSTACK
PUSH 0xA
PUSH 0xB
SPACKNIB
ASSERT LAST_N == 0xAB
CLEARSTACK
PUSH 0xF
PUSH 0x0
SPACK4
ASSERT LAST_N == 0xF0

# stack SSETNIB
CLEARSTACK
PUSH 0xABCD
PUSH 0x0
PUSH 0
SSETNIB
ASSERT LAST_N == 0xABC0
CLEARSTACK
PUSH 0
PUSH 0xE
PUSH 2
SSETNIBBLE
ASSERT LAST_N == 0xE00

# compose: pack then extract
CLEARSTACK
PUSH 0x12
PUSH 0x34
SPACK8
SHIBYTE
ASSERT LAST_N == 0x12
CLEARSTACK
PUSH 0xC
PUSH 0xD
SPACKNIB
PUSH 0
SNIB
ASSERT LAST_N == 0xD

# aliases
CLEARSTACK
PUSH 0x01
PUSH 0x02
STACKPACK8
ASSERT LAST_N == 0x0102

# underflow
CLEARSTACK
SPACK8
ASSERT OK == 0
CLEARSTACK
SPACKNIB
ASSERT OK == 0
CLEARSTACK
SSETNIB
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof53_pack8_nibble" LAST_N SP
