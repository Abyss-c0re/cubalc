# Proof 265 — digit-5 stack imm 32-bit field: SGET32N SSET32N SCLR32N
HOLD_FLASH 1
SCIENCE LOAD

# SGET32N — extract LE 32-bit word
CLEARSTACK
PUSH 0x1122334455667788
SGET32N 0
POP x
ASSERT x == 0x55667788

CLEARSTACK
PUSH 0x1122334455667788
STACKGET32N 1
POP x
ASSERT x == 0x11223344

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
SWORD32N 0
POP x
ASSERT x == 0xEEFF0011

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
GET32N 1
POP x
ASSERT x == 0xAABBCCDD

# clamp index
CLEARSTACK
PUSH 0x1122334455667788
SGET32N 99
POP x
ASSERT x == 0x11223344

# SSET32N field n
CLEARSTACK
PUSH 0
SSET32N 0xAABBCCDD 0
POP x
ASSERT x == 0xAABBCCDD

CLEARSTACK
PUSH 0
STACKSET32N 0x12345678 1
POP x
ASSERT x == 0x1234567800000000

CLEARSTACK
PUSH -1
SET32N 0 0
POP x
# clear low 32: -1 & ~0xFFFFFFFF = 0xFFFFFFFF00000000
ASSERT x == -4294967296

CLEARSTACK
PUSH -1
PUT32N 0 1
POP x
# clear high 32: -1 & ~0xFFFFFFFF00000000 = 0x00000000FFFFFFFF
ASSERT x == 4294967295

# SCLR32N n
CLEARSTACK
PUSH 0x1122334455667788
SCLR32N 0
POP x
ASSERT x == 0x1122334400000000

CLEARSTACK
PUSH 0x1122334455667788
STACKCLR32N 1
POP x
ASSERT x == 0x55667788

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
ZAP32N 0
POP x
ASSERT x == 0xAABBCCDD00000000

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
CLR32N 1
POP x
ASSERT x == 0xEEFF0011

# soft fails
CLEARSTACK
SGET32N 0
ASSERT OK == 0
CLEARSTACK
SSET32N 1 0
ASSERT OK == 0
CLEARSTACK
SCLR32N 0
ASSERT OK == 0

HOLD_FLASH 1
