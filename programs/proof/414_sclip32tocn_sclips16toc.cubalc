# Proof 414 — digit-6 imm clip32 + signed clip: SCLIP32TOCN SCLIPS8TOC SCLIPS16TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLIP32TOCN: negative → 0
CELLSET 1 15
PUSH 1
SSEXT4TOC
POP
PUSH 1
SCLIP32TOCN
ASSERT LAST_N == 0
ASSERT CELL(1) == 0
POP

# CLIP32TOCN: 100 stays
CELLSET 2 100
PUSH 2
CLIP32TOCN
ASSERT LAST_N == 100
ASSERT CELL(2) == 100
POP

# SCLIPS8TOC: 200 → 127
CELLSET 3 200
PUSH 3
SCLIPS8TOC
ASSERT LAST_N == 127
ASSERT CELL(3) == 127
POP

# CLIPS8TOC: -200 → -128 via large negative then clamp
CELLSET 4 0
# build -200: use SSEXT of value with high bits
# -200 as cell: set via SSEXTTOC width 0 first then...
# Use arithmetic: CELLSET with signed via SEXT path
# 0xFFFFFF38 = -200 if we had 32-bit; on 64-bit store -200
# CELLSET may not take negative; use SSEXT32 of 0xFFFFFF38
CELLSET 4 4294967096
PUSH 4
SSEXT32TOC
POP
PUSH 4
CLIPS8TOC
ASSERT LAST_N == -128
ASSERT CELL(4) == -128
POP

# SCLIPS8TOC mid: 50 stays
CELLSET 5 50
PUSH 5
SCLIPS8TOC
ASSERT LAST_N == 50
ASSERT CELL(5) == 50
POP

# SCLIPS16TOC: 40000 → 32767
CELLSET 6 40000
PUSH 6
SCLIPS16TOC
ASSERT LAST_N == 32767
ASSERT CELL(6) == 32767
POP

# CLIPS16TOC: -40000 → -32768
CELLSET 7 4294927296
PUSH 7
SSEXT32TOC
POP
PUSH 7
CLIPS16TOC
ASSERT LAST_N == -32768
ASSERT CELL(7) == -32768
POP

# soft short stack OK=0
CLEARSTACK
SCLIP32TOCN
ASSERT OK == 0
SCLIPS8TOC
ASSERT OK == 0
SCLIPS16TOC
ASSERT OK == 0

PRINT "414_sclip32tocn_sclips16toc OK"
