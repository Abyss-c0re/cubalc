# Proof 380 — digit-2 imm ceil/floor div TOC: SDIVCEILTOCN SDIVFLOORTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SDIVCEILTOCN: ceil(10/3)=4
CELLSET 1 10
PUSH 1
SDIVCEILTOCN 3
ASSERT LAST_N == 4
ASSERT CELL(1) == 4
POP a
ASSERT a == 4

# CEILDIVTOCN exact: ceil(9/3)=3
CELLSET 2 9
PUSH 2
CEILDIVTOCN 3
ASSERT LAST_N == 3
ASSERT CELL(2) == 3
POP

# SDIVFLOORTOCN: floor(10/3)=3
CELLSET 3 10
PUSH 3
SDIVFLOORTOCN 3
ASSERT LAST_N == 3
ASSERT CELL(3) == 3
POP

# FLOORDIVTOCN negative: floor(-10/3) = -4
CELLSET 4 0
LET neg = 0 - 10
CELLSET 4 neg
PUSH 4
FLOORDIVTOCN 3
ASSERT LAST_N == 0 - 4
ASSERT CELL(4) == 0 - 4
POP

# ceil negative mixed: ceil(-10/3) = -3 (a/n trunc toward 0 when signs differ)
CELLSET 5 neg
PUSH 5
SDIVCEILTOCN 3
ASSERT LAST_N == 0 - 3
ASSERT CELL(5) == 0 - 3
POP

# n==0 soft → 0
CELLSET 6 42
PUSH 6
SDIVCEILTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# soft empty OK=0
CLEARSTACK
SDIVFLOORTOCN 2
ASSERT OK == 0

PRINT "380_sdivceiltocn_sdivfloortocn OK"
