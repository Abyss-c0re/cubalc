# Proof 62 — digit-1 BNAND BNOR BXNOR ANDN ORN BSEL + stack
HOLD_FLASH 1
SCIENCE LOAD

# BNAND BNOR BXNOR
ASSERT BNAND(0xF, 0x3) == BNOT(BAND(0xF, 0x3))
ASSERT BNOR(0x1, 0x2) == BNOT(BOR(0x1, 0x2))
ASSERT BXNOR(0xA, 0xA) == BNOT(0)
ASSERT XNOR(0xA, 0x5) == BNOT(BXOR(0xA, 0x5))
ASSERT BNAND(0, 0) == -1
ASSERT BNOR(0, 0) == -1

# ANDN / ANDNOT / BIC  (a & ~b)
ASSERT ANDN(0xFF, 0x0F) == 0xF0
ASSERT ANDNOT(0xFF, 0xF0) == 0x0F
ASSERT BIC(7, 1) == 6
ASSERT ANDN(0xABCD, 0) == 0xABCD
ASSERT ANDN(0xABCD, -1) == 0

# ORN / ORNOT  (a | ~b)
ASSERT ORN(0, 0) == -1
ASSERT ORNOT(0x0F, 0xF0) == BOR(0x0F, BNOT(0xF0))
ASSERT BAND(ORN(0x0, 0xF), 0xF) == 0
ASSERT ORN(0xFF, 0x0F) == -1

# BSEL / BITSEL / BLEND — bit blend by mask
ASSERT BSEL(0x0F, 0xAA, 0x55) == BOR(BAND(0xAA, 0x0F), BAND(0x55, BNOT(0x0F)))
ASSERT BITSEL(0xFF, 0x12, 0x34) == 0x12
ASSERT BLEND(0, 0x12, 0x34) == 0x34
ASSERT BSEL(-1, 0x99, 0x11) == 0x99
ASSERT BSEL(0xF0, 0xAB, 0xCD) == 0xAD

# compose with SELECT
ASSERT SELECT(BAND(BSEL(1, 2, 0), 1), 1, 0) == 0
ASSERT ANDN(BSET(0, 3), BSET(0, 0)) == 8

# stack SNAND SNOR SXNOR
CLEARSTACK
PUSH 0xF
PUSH 0x3
SNAND
ASSERT LAST_N == BNOT(BAND(0xF, 0x3))
CLEARSTACK
PUSH 1
PUSH 2
SNOR
ASSERT LAST_N == BNOT(BOR(1, 2))
CLEARSTACK
PUSH 0xA
PUSH 0xA
SXNOR
ASSERT LAST_N == -1

# stack SANDN SORN
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
SANDN
ASSERT LAST_N == 0xF0
CLEARSTACK
PUSH 0xFF
PUSH 0xF0
SBIC
ASSERT LAST_N == 0x0F
CLEARSTACK
PUSH 0
PUSH 0
SORN
ASSERT LAST_N == -1

# stack SBSEL
CLEARSTACK
PUSH 0x0F
PUSH 0xAA
PUSH 0x55
SBSEL
ASSERT LAST_N == BSEL(0x0F, 0xAA, 0x55)
CLEARSTACK
PUSH 0
PUSH 0x12
PUSH 0x34
SBLEND
ASSERT LAST_N == 0x34
CLEARSTACK
PUSH -1
PUSH 0x99
PUSH 0x11
SBITSEL
ASSERT LAST_N == 0x99

# underflow
CLEARSTACK
SNAND
ASSERT OK == 0
CLEARSTACK
SANDN
ASSERT OK == 0
CLEARSTACK
SBSEL
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof62_bitwise_logic_select" LAST_N SP
