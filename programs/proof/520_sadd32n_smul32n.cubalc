# Proof 520 — digit-5 stack imm 32-bit field arith merge: SADD32N SSUB32N SMUL32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SADD32N: 0x10000000 + 0x02000000 → 0x12000000
PUSH 0x10000000
SADD32N 0x2000000 0
POP x
ASSERT x == 0x12000000

# wrap: 0xFFFFFFFF + 2 → 0x00000001
CLEARSTACK
PUSH 0xFFFFFFFF
ADD32N 2 0
POP x
ASSERT x == 1

# high word preserved: 0x1122334400001000 + 0x55 → 0x1122334400001055
CLEARSTACK
PUSH 0x1122334400001000
SADD32N 0x55 0
POP x
ASSERT x == 0x1122334400001055

# STACKADD32N n1: high of 0x0000000200000000 is 2 + 0x30 → high 0x32
CLEARSTACK
PUSH 0x0000000200000000
STACKADD32N 0x30 1
POP x
ASSERT x == 0x0000003200000000

# SSUB32N: 0x05000000 - 0x01000000 → 0x04000000
CLEARSTACK
PUSH 0x05000000
SSUB32N 0x1000000 0
POP x
ASSERT x == 0x04000000

# wrap borrow: 0x00000001 - 2 → 0xFFFFFFFF
CLEARSTACK
PUSH 0x00000001
SUB32N 2 0
POP x
ASSERT x == 4294967295

# STACKSUB32N n1: high 0x50000000 - 0x10000000 → 0x40000000 high
CLEARSTACK
PUSH 0x5000000000000000
STACKSUB32N 0x10000000 1
POP x
ASSERT x == 0x4000000000000000

# SMUL32N: 0x10 * 0x10 → 0x100
CLEARSTACK
PUSH 0x10
SMUL32N 0x10 0
POP x
ASSERT x == 0x100

# wrap mul: 0x10000 * 0x10000 → 0 (low 32 of 2^32)
CLEARSTACK
PUSH 0x10000
MUL32N 0x10000 0
POP x
ASSERT x == 0

# zero annihilator
CLEARSTACK
PUSH 0xABCD1234
SMUL32N 0 0
POP x
ASSERT x == 0

# high preserved mul: 0x1122334400000003 * 5 → 0x112233440000000F
CLEARSTACK
PUSH 0x1122334400000003
SMUL32N 5 0
POP x
ASSERT x == 0x112233440000000F

# aliases
CLEARSTACK
PUSH 0x10
SINC32N 5 0
POP x
ASSERT x == 0x15

CLEARSTACK
PUSH 0x10
SDEC32N 3 0
POP x
ASSERT x == 0xD

CLEARSTACK
PUSH 0x7
STIMES32N 3 0
POP x
ASSERT x == 0x15

HOLD_FLASH 0
