# Proof 344 — digit-1 3-way imm compare TOC: SCMPTOCN SUCMPTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCMPTOCN equal → 0
CELLSET 1 5
PUSH 1
SCMPTOCN 5
ASSERT LAST_N == 0
ASSERT CELL(1) == 0
POP a
ASSERT a == 0

# CMP3TOCN less → -1
CELLSET 2 3
PUSH 2
CMP3TOCN 10
ASSERT LAST_N == (-1)
ASSERT CELL(2) == (-1)
POP

# SCMPATN greater → 1
CELLSET 3 9
PUSH 3
SCMPATN 2
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# SUCMPTOCN equal
CELLSET 4 4
PUSH 4
SUCMPTOCN 4
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# unsigned: -1 (u-max) vs 0 → greater (+1)
PUSH 5
PUSH (-1)
SSETCELL
POP
PUSH 5
SUCMPTOCN 0
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# signed: -1 vs 0 → less (-1)
PUSH 6
PUSH (-1)
SSETCELL
POP
PUSH 6
SCMPTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(6) == (-1)
POP

# SUCMPATN: 0 vs u-max → less (-1)
CELLSET 7 0
PUSH 7
SUCMPATN (-1)
ASSERT LAST_N == (-1)
ASSERT CELL(7) == (-1)
POP

# UCMP3TOCN: 10 vs 3 unsigned greater
CELLSET 8 10
PUSH 8
UCMP3TOCN 3
ASSERT LAST_N == 1
ASSERT CELL(8) == 1
POP

# soft fails
CLEARSTACK
SCMPTOCN 1
ASSERT OK == 0
SUCMPTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof344_scmptocn_sucmptocn" LAST_N SP
HOLD_FLASH 1
