# Proof 17 — COP matrix algebra (digit 5): COPY/AND/OR/XOR/NOT/CLEAR bits
HOLD_FLASH 1
SCIENCE LOAD

CUBE a ROLE core PROTON 1
CUBE b ROLE core PROTON 1
CUBE c ROLE core PROTON 1

FOLDBITS a "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS b "1010101010101010101010101010101010101010101010101010101010101010"

LET sa = SET(a)
LET sb = SET(b)
ASSERT sa > 0
ASSERT sb > 0

# COPYBITS dst src
COPYBITS c a
ASSERT SET(c) == sa
ASSERT BIT(c, 0) == 1
ASSERT BIT(c, 4) == 0

# ANDBITS dst src  (c &= b)
ANDBITS c b
ASSERT SET(c) <= sa
ASSERT SET(c) <= sb

# ORBITS restore density
COPYBITS c a
ORBITS c b
ASSERT SET(c) >= sa
ASSERT SET(c) >= sb

# XORBITS self-cancel
COPYBITS c a
XORBITS c a
ASSERT SET(c) == 0

# NOTBITS flips
COPYBITS c a
LET s0 = SET(c)
NOTBITS c
LET s1 = SET(c)
ASSERT s0 + s1 == BITS(c)

# CLEARBITS
CLEARBITS c
ASSERT SET(c) == 0

# FILLBITS all ones
FILLBITS c 1
ASSERT SET(c) == BITS(c)

# COP queries
ASSERT PORTS(a) >= 0
ASSERT PLUGGED(a) >= 0
ASSERT DIGIT(a) >= 0
ASSERT DIGIT(a) <= 9
ASSERT OK == 1

PRINT "proof17_cop_matrix" sa sb SET(c) DIGIT(a) PORTS(a)
