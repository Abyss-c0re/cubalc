# Proof 138 — digit-5 cell range predicates: ANYCELL ALLCELL NONECELL NZCOUNT EQRANGE
HOLD_FLASH 1
SCIENCE LOAD

# ANYCELL / ALLCELL / NONECELL
CLEARCELLS
CELLSET 0 0
CELLSET 1 0
CELLSET 2 0
NONECELL 0 2
ASSERT LAST_N == 1
ANYCELL 0 2
ASSERT LAST_N == 0
ALLCELL 0 2
ASSERT LAST_N == 0

CELLSET 1 7
ANYCELL 0 2
ASSERT LAST_N == 1
NONECELL 0 2
ASSERT LAST_N == 0
ALLCELL 0 2
ASSERT LAST_N == 0

CELLSET 0 1
CELLSET 2 2
ALLCELL 0 2
ASSERT LAST_N == 1
NZCOUNT 0 2
ASSERT LAST_N == 3

# empty-ish single zero
CLEARCELLS
CELLSET 0 0
NZCOUNT 0 0
ASSERT LAST_N == 0
NONECELL 0 0
ASSERT LAST_N == 1

# EQRANGE
CLEARCELLS
CELLSET 0 5
CELLSET 1 6
CELLSET 2 7
CELLSET 10 5
CELLSET 11 6
CELLSET 12 7
EQRANGE 0 10 3
ASSERT LAST_N == 1
CELLSET 11 99
EQRANGE 0 10 3
ASSERT LAST_N == 0
# n=0 always equal
EQRANGE 0 10 0
ASSERT LAST_N == 1

# aliases
CLEARCELLS
CELLSET 0 1
CELLANY 0 0
ASSERT LAST_N == 1
CELLALL 0 0
ASSERT LAST_N == 1
COUNTNZCELL 0 0
ASSERT LAST_N == 1

# stack SANYCELL
CLEARCELLS
CELLSET 0 0
CELLSET 1 3
CLEARSTACK
PUSH 0
PUSH 1
SANYCELL
ASSERT LAST_N == 1
POP a
ASSERT a == 1

# SALLCELL / SNONECELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CLEARSTACK
PUSH 0
PUSH 1
SALLCELL
ASSERT LAST_N == 1
CLEARCELLS
CELLSET 0 0
CELLSET 1 0
CLEARSTACK
PUSH 0
PUSH 1
SNONECELL
ASSERT LAST_N == 1

# SNZCOUNT
CLEARCELLS
CELLSET 0 1
CELLSET 1 0
CELLSET 2 4
CLEARSTACK
PUSH 0
PUSH 2
SNZCOUNT
ASSERT LAST_N == 2
POP a
ASSERT a == 2

# SEQRANGES
CLEARCELLS
CELLSET 0 8
CELLSET 1 9
CELLSET 5 8
CELLSET 6 9
CLEARSTACK
PUSH 0
PUSH 5
PUSH 2
SEQRANGES
ASSERT LAST_N == 1
CELLSET 6 0
CLEARSTACK
PUSH 0
PUSH 5
PUSH 2
SEQRANGES
ASSERT LAST_N == 0

# soft fails
CLEARSTACK
SANYCELL
ASSERT OK == 0
SALLCELL
ASSERT OK == 0
SNZCOUNT
ASSERT OK == 0
SEQRANGES
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof138_anycell_eqrange" LAST_N SP
