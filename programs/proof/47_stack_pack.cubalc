# Proof 47 — stack pack/byte digit-3/0: SPACK16 SHI16 SLO16 SBYTE SLOBYTE SHIBYTE
HOLD_FLASH 1
SCIENCE LOAD

# SPACK16
CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
SPACK16
ASSERT LAST_N == 0xABCD1234

# SHI16 / SLO16 round-trip
CLEARSTACK
PUSH 0xABCD1234
SHI16
ASSERT LAST_N == 0xABCD
CLEARSTACK
PUSH 0xABCD1234
SLO16
ASSERT LAST_N == 0x1234

# LOBYTE / HIBYTE
CLEARSTACK
PUSH 0xABCD
SLOBYTE
ASSERT LAST_N == 0xCD
CLEARSTACK
PUSH 0xABCD
SHIBYTE
ASSERT LAST_N == 0xAB

# SBYTE little-endian indices
CLEARSTACK
PUSH 0x01020304
PUSH 0
SBYTE
ASSERT LAST_N == 4
CLEARSTACK
PUSH 0x01020304
PUSH 1
SBYTE
ASSERT LAST_N == 3
CLEARSTACK
PUSH 0x01020304
PUSH 3
SBYTE
ASSERT LAST_N == 1

# aliases
CLEARSTACK
PUSH 0x11
PUSH 0x22
SPACK
ASSERT LAST_N == 0x00110022
SLOWORD
ASSERT LAST_N == 0x0022

# underflow
CLEARSTACK
SPACK16
ASSERT OK == 0
CLEARSTACK
SBYTE
ASSERT OK == 0

# compose: pack then extract high half
CLEARSTACK
PUSH 7
PUSH 9
SPACK16
SHI16
ASSERT LAST_N == 7

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof47_stack_pack" LAST_N SP
