# Proof 77 — digit-3 COP matrix: SHLBITS/SHRBITS + FINDONE/LASTONE/ANYBITS
HOLD_FLASH 1
SCIENCE LOAD

CUBE m ROLE matrix PROTON 1
CLEARBITS m
FINDONE m
ASSERT LAST_N == -1
ANYBITS m
ASSERT LAST_N == 0
NONEBITS m
ASSERT LAST_N == 1
ALLBITS m
ASSERT LAST_N == 0

# single bit at 0
SETBIT m 0 1
FINDONE m
ASSERT LAST_N == 0
LASTONE m
ASSERT LAST_N == 0
ANYBITS m
ASSERT LAST_N == 1
NONEBITS m
ASSERT LAST_N == 0

# bits at 1 and 5
CLEARBITS m
SETBIT m 1 1
SETBIT m 5 1
FINDONE m
ASSERT LAST_N == 1
FIRSTBIT m
ASSERT LAST_N == 1
LASTONE m
ASSERT LAST_N == 5
LASTBIT m
ASSERT LAST_N == 5
ONES m
ASSERT LAST_N == 2

# SHLBITS: move bits to higher indices, zero-fill low
SHLBITS m 2
FINDONE m
ASSERT LAST_N == 3
LASTONE m
ASSERT LAST_N == 7
GETBIT m 1
ASSERT LAST_N == 0
GETBIT m 3
ASSERT LAST_N == 1
GETBIT m 5
ASSERT LAST_N == 0
GETBIT m 7
ASSERT LAST_N == 1
ONES m
ASSERT LAST_N == 2

# SHRBITS: move toward zero, drop underflow
SHRBITS m 1
FINDONE m
ASSERT LAST_N == 2
LASTONE m
ASSERT LAST_N == 6
ONES m
ASSERT LAST_N == 2

# large shift clears
SHLBITS m 100
ONES m
ASSERT LAST_N == 0
FINDONE m
ASSERT LAST_N == -1
NONEBITS m
ASSERT LAST_N == 1

# FOLDBITS + LSHBITS alias + energy flow
FOLDBITS m "11000000"
LSHBITS m 1
GETBIT m 0
ASSERT LAST_N == 0
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 1
FINDONE m
ASSERT LAST_N == 1

# RSHIFTBITS alias
RSHIFTBITS m 1
FINDONE m
ASSERT LAST_N == 0
LASTONE m
ASSERT LAST_N == 1

# soft fail unknown cube
FINDONE nosuch
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof77_shlbits_findone" LAST_N SET
