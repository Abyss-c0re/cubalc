# Proof 64 — digit-0/2 UDIV/UMOD MULHI/UMULHI BSWAP16/64 + stack
HOLD_FLASH 1
SCIENCE LOAD

# UDIV / UMOD unsigned
ASSERT UDIV(10, 3) == 3
ASSERT UMOD(10, 3) == 1
ASSERT UDIVIDE(100, 10) == 10
ASSERT UREM(17, 5) == 2
ASSERT UDIV(5, 0) == 0
ASSERT UMOD(5, 0) == 0
# negative as large unsigned: -1 / 2 → huge/2
ASSERT UDIV(-1, 2) == UDIV(BNOT(0), 2)
ASSERT UMOD(-1, 2) == 1
ASSERT UDIV(8, 2) == IDIV(8, 2)

# MULHI / UMULHI high half of product
ASSERT MULHI(2, 3) == 0
ASSERT MULH(1, 1) == 0
ASSERT MULHI(-1, -1) == 0
# 2^32 * 2^32 = 2^64 → hi = 1
ASSERT UMULHI(4294967296, 4294967296) == 1
ASSERT UMULH(0x100000000, 0x100000000) == 1
ASSERT MULHI(0x100000000, 0x100000000) == 1

# BSWAP16 / BSWAP64
ASSERT BSWAP16(0x1234) == 0x3412
ASSERT BSWAP16(0x00FF) == 0xFF00
ASSERT BSWAP16(0xABCD) == 0xCDAB
ASSERT BSWAP32(0x12345678) == 0x78563412
ASSERT BSWAP64(0x0123456789ABCDEF) == 0xEFCDAB8967452301
ASSERT BSWAP64(BSWAP64(0x1122334455667788)) == 0x1122334455667788
ASSERT BSWAP16(BSWAP16(0xABCD)) == 0xABCD

# compose
ASSERT UDIV(BSWAP16(0x0200), 2) == 1
ASSERT UMOD(MULHI(0, 99), 7) == 0

# stack SUDIV SUMOD
CLEARSTACK
PUSH 10
PUSH 3
SUDIV
ASSERT LAST_N == 3
CLEARSTACK
PUSH 10
PUSH 3
SUMOD
ASSERT LAST_N == 1
CLEARSTACK
PUSH 5
PUSH 0
SUDIVIDE
ASSERT LAST_N == 0

# stack SMULHI SUMULHI
CLEARSTACK
PUSH 4294967296
PUSH 4294967296
SUMULHI
ASSERT LAST_N == 1
CLEARSTACK
PUSH 2
PUSH 3
SMULHI
ASSERT LAST_N == 0

# stack SBSWAP16 SBSWAP64
CLEARSTACK
PUSH 0x1234
SBSWAP16
ASSERT LAST_N == 0x3412
CLEARSTACK
PUSH 0x0123456789ABCDEF
SBSWAP64
ASSERT LAST_N == 0xEFCDAB8967452301
CLEARSTACK
PUSH 0xAABB
STACKBSWAP16
ASSERT LAST_N == 0xBBAA

# underflow
CLEARSTACK
SUDIV
ASSERT OK == 0
CLEARSTACK
SMULHI
ASSERT OK == 0
CLEARSTACK
SBSWAP16
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof64_muldiv_bswap" LAST_N SP
