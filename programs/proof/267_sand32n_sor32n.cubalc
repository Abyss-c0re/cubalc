# Proof 267 — digit-0 stack imm 32-bit field bitwise: SAND32N SOR32N SXOR32N
HOLD_FLASH 1
SCIENCE LOAD

# SAND32N field n
CLEARSTACK
PUSH 0x1122334455667788
SAND32N 0x0000FFFF 0
POP x
ASSERT x == 0x1122334400007788

CLEARSTACK
PUSH 0x1122334455667788
STACKAND32N 0x00FFFFFF 1
POP x
ASSERT x == 0x0022334455667788

CLEARSTACK
PUSH -1
AND32N 0xAABBCCDD 0
POP x
# high remains FFFFFFFF, low = AABBCCDD
ASSERT x == -1430532899

# SOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
SOR32N 0xFF000000 0
POP x
ASSERT x == 0x11223344FF667788

CLEARSTACK
PUSH 0x1122334455667788
STACKOR32N 0xFF000000 1
POP x
ASSERT x == 0xFF22334455667788

CLEARSTACK
PUSH 0
OR32N 0xAABBCCDD 0
POP x
ASSERT x == 0xAABBCCDD

CLEARSTACK
PUSH 0
SSETOR32N 0x12345678 1
POP x
ASSERT x == 0x1234567800000000

# SXOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
SXOR32N 0x000000FF 0
POP x
ASSERT x == 0x1122334455667777

CLEARSTACK
PUSH 0x1122334455667788
STACKXOR32N 0x000000FF 1
POP x
ASSERT x == 0x112233BB55667788

CLEARSTACK
PUSH 0
XOR32N 0xAABBCCDD 0
POP x
ASSERT x == 0xAABBCCDD

CLEARSTACK
PUSH -1
SFLIP32N 0xFFFFFFFF 0
POP x
# flip low 32 of -1 → high FFFFFFFF, low 0
ASSERT x == -4294967296

# clamp n
CLEARSTACK
PUSH 0x1122334455667788
SAND32N 0x0000FFFF 99
POP x
ASSERT x == 0x0000334455667788

# soft fails
CLEARSTACK
SAND32N 1 0
ASSERT OK == 0
CLEARSTACK
SOR32N 1 0
ASSERT OK == 0
CLEARSTACK
SXOR32N 1 0
ASSERT OK == 0

HOLD_FLASH 1
