# method_guard via native HASCLASS/HASMETHOD (no LISTMETHODS soup)

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
  METHOD init
    LET id = 1
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

# empty contract OK
DEFAULT NEED_METHODS = ""
DEFAULT NEED_METHOD_ANY = ""
DEFAULT METHOD_GUARD_SOFT = 0
INCLUDE method_guard
ASSERT METHOD_GUARD_OK == 1
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_ANY_OK == 1

# ALL hit
LET NEED_METHODS = "Ticket.ping\nTicket.init\nOrder.pay"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 1
ASSERT METHOD_GUARD_OK == 1
ASSERT METHHAVE_N >= 3
ASSERT METHMISS_N == 0

# ALL soft miss
LET NEED_METHODS = "Ticket.ping\nGhost.nope"
LET NEED_METHOD_ANY = ""
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ALL_OK == 0
ASSERT METHOD_GUARD_OK == 0
ASSERT METHMISS_N >= 1
SYS HASI METHMISS "Ghost.nope"
ASSERT LAST_N == 1
CLEAR_ERR

# ANY hit among options
LET NEED_METHODS = ""
LET NEED_METHOD_ANY = "Ghost.nope\nOrder.pay"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 1
ASSERT METHOD_GUARD_OK == 1
SYS HASI METHHAVE "Order.pay"
ASSERT LAST_N == 1

# ANY all miss soft
LET NEED_METHOD_ANY = "Ghost.a\nGhost.b"
LET METHOD_GUARD_SOFT = 1
INCLUDE method_guard
ASSERT METHOD_GUARD_ANY_OK == 0
ASSERT METHOD_GUARD_OK == 0
CLEAR_ERR

# native forms still present for direct use
HASMETHOD Ticket ping
ASSERT LAST_N == 1
HASMETHODS Ticket ping init
ASSERT LAST_N == 1
HASMETHODANY Ticket nope ping
ASSERT LAST_N == 1

PRINT "1428_method_guard_native ok"
PASS
