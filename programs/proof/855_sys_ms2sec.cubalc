# SYS MS2SEC / SEC2MS — unit bridge between ms and seconds
# Usability: PARSEMS→DEADLINE and REMAINING→SLEEP without shell $(( ))

HOLD_FLASH 1

# ms → seconds floor
SYS MS2SEC 30000
ASSERT OK == 1
ASSERT LAST_N == 30
ASSERT MS2SEC_N == 30
ASSERT MS2SEC_MS == 30000

SYS MS2SEC 999
ASSERT LAST_N == 0
SYS MS2SEC 1000
ASSERT LAST_N == 1
SYS MS2SEC 1999
ASSERT LAST_N == 1
SYS MS2SEC 0
ASSERT LAST_N == 0

# aliases
SYS TOSECS 5000
ASSERT LAST_N == 5
SYS FROMMS 2500
ASSERT LAST_N == 2

# secs → ms
SYS SEC2MS 30
ASSERT OK == 1
ASSERT LAST_N == 30000
ASSERT SEC2MS_N == 30000
ASSERT SEC2MS_SECS == 30

SYS SEC2MS 0
ASSERT LAST_N == 0
SYS SEC2MS 1
ASSERT LAST_N == 1000

# aliases
SYS SECS2MS 7
ASSERT LAST_N == 7000
SYS S2MS 2
ASSERT LAST_N == 2000

# negative clamps
SYS MS2SEC -5
ASSERT LAST_N == 0
SYS SEC2MS -3
ASSERT LAST_N == 0

# default LAST_N
LET ms = 45000
SYS MS2SEC ms
ASSERT LAST_N == 45

# pipeline: PARSEMS "30s" → MS2SEC → DEADLINE scale
SYS PARSEMS "30s"
ASSERT LAST_N == 30000
SYS MS2SEC
ASSERT LAST_N == 30
SYS DEADLINE
# now+30; just check OK and future remaining
ASSERT OK == 1
SYS REMAINING
ASSERT LAST_N >= 25
ASSERT LAST_N <= 30

# reverse: REMAINING secs → SEC2MS for SLEEP budget label
SYS SEC2MS 5
ASSERT LAST_N == 5000
# SLEEP would pause; just convert
SYS MS2SEC 5000
ASSERT LAST_N == 5

# round-trip floor
SYS SEC2MS 42
SYS MS2SEC
ASSERT LAST_N == 42

PRINT "sys_ms2sec ok"
