# Proof 82 — digit-9 cell fold: DIV/MOD/SUB + SCAN + PROD/MEAN + CLAMP
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
IOTA 0 4 10 5
# cells: 10 15 20 25 30
CELLGET 0
ASSERT LAST_N == 10
CELLGET 4
ASSERT LAST_N == 30

SUMCELL 0 4
ASSERT LAST_N == 100
PRODCELL 0 2
# 10*15*20 = 3000
ASSERT LAST_N == 3000
MEANCELL 0 4
ASSERT LAST_N == 20
AVGCELL 0 3
ASSERT LAST_N == 17

SUBCELL 0 4 5
# 5 10 15 20 25
CELLGET 0
ASSERT LAST_N == 5
CELLGET 4
ASSERT LAST_N == 25

DIVCELL 0 4 5
# 1 2 3 4 5
CELLGET 0
ASSERT LAST_N == 1
CELLGET 4
ASSERT LAST_N == 5
SUMCELL 0 4
ASSERT LAST_N == 15

# MODCELL
IOTA 0 4 7 3
# 7 10 13 16 19
MODCELL 0 4 5
# 2 0 3 1 4
CELLGET 0
ASSERT LAST_N == 2
CELLGET 1
ASSERT LAST_N == 0
CELLGET 4
ASSERT LAST_N == 4

# SCANCELL prefix sum
CLEARCELLS
IOTA 0 3 1 1
# 1 2 3 4
SCANCELL 0 3
# 1 3 6 10
CELLGET 0
ASSERT LAST_N == 1
CELLGET 1
ASSERT LAST_N == 3
CELLGET 2
ASSERT LAST_N == 6
CELLGET 3
ASSERT LAST_N == 10
# LAST_N from scan is total
ASSERT LAST_N == 10

# CLAMPCELL
IOTA 0 4 0 10
# 0 10 20 30 40
CLAMPCELL 0 4 5 25
CELLGET 0
ASSERT LAST_N == 5
CELLGET 1
ASSERT LAST_N == 10
CELLGET 2
ASSERT LAST_N == 20
CELLGET 3
ASSERT LAST_N == 25
CELLGET 4
ASSERT LAST_N == 25

# div by zero soft
DIVCELL 0 0 0
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof82_cell_div_scan" LAST_N
