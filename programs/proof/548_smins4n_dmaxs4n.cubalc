# Proof 548 — digit-4 stack+dual imm 4-bit signed min/max: SMINS4N SMAXS4N DMINS4N DMAXS4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMINS4N: signed min(-1=0xF, 1) → -1
PUSH 0xF
SMINS4N 0x1 0
POP x
ASSERT x == 0xF

# unsigned SMIN: min(0xF, 1) → 1
CLEARSTACK
PUSH 0xF
SMIN4N 0x1 0
POP x
ASSERT x == 1

# positive: min(2, 3) → 2
CLEARSTACK
PUSH 0x2
SMINS4N 0x3 0
POP x
ASSERT x == 2

# field smaller: min(5, -2=0xE) → -2
CLEARSTACK
PUSH 0x5
MINS4N 0xE 0
POP x
ASSERT x == 0xE

# INT4_MIN(0x8=-8) vs INT4_MAX(0x7=7) → INT4_MIN
CLEARSTACK
PUSH 0x8
SMINSIGN4N 0x7 0
POP x
ASSERT x == 0x8

# equal
CLEARSTACK
PUSH 0x8
SMINS4N 0x8 0
POP x
ASSERT x == 0x8

# preserved high nibble: low -1 min 0 → low -1
CLEARSTACK
PUSH 0x1F
SMINS4N 0x0 0
POP x
ASSERT x == 0x1F

# STACKMINS4N n1: nibble1 of 0xF1 is F → min 0 stays F
CLEARSTACK
PUSH 0xF1
STACKMINS4N 0x0 1
POP x
ASSERT x == 0xF1

# n2: 0xE00 min 0 → 0xE00
CLEARSTACK
PUSH 0x0E00
SMINS4N 0x0 2
POP x
ASSERT x == 0x0E00

# SMAXS4N: signed max(-1, 1) → 1
CLEARSTACK
PUSH 0xF
SMAXS4N 0x1 0
POP x
ASSERT x == 1

# unsigned SMAX: max(0xF, 1) → 0xF
CLEARSTACK
PUSH 0xF
SMAX4N 0x1 0
POP x
ASSERT x == 0xF

# max(2, -3=0xD) → 2
CLEARSTACK
PUSH 0x2
MAXS4N 0xD 0
POP x
ASSERT x == 2

# INT4_MIN max INT4_MAX → INT4_MAX
CLEARSTACK
PUSH 0x8
SMAXSIGN4N 0x7 0
POP x
ASSERT x == 0x7

# equal
CLEARSTACK
PUSH 0x5
SMAXS4N 0x5 0
POP x
ASSERT x == 0x5

# preserved high: low 1 max -1 → low 1
CLEARSTACK
PUSH 0xA1
SMAXS4N 0xF 0
POP x
ASSERT x == 0xA1

# STACKMAXS4N n1
CLEARSTACK
PUSH 0x20
STACKMAXS4N 0xF 1
POP x
ASSERT x == 0x20

# DMINS4N: -1 min 0 → -1; 1 min 0 → 0
CLEARSTACK
PUSH 0xF
PUSH 0x1
DMINS4N 0x0 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 0

# unsigned dual contrast
CLEARSTACK
PUSH 0xF
PUSH 0xF
DMIN4N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# mixed
CLEARSTACK
PUSH 0x2
PUSH 0xE
PAIRMINS4N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xE

# preserved high dual
CLEARSTACK
PUSH 0x1F
PUSH 0xA5
S2MINS4N 0x1 0
POP y
POP x
ASSERT x == 0x1F
ASSERT y == 0xA1

# STACK2MINS4N n1
CLEARSTACK
PUSH 0xF0
PUSH 0x20
STACK2MINS4N 0x0 1
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0x00

# DMAXS4N: -1 max 0 → 0; 1 max 0 → 1
CLEARSTACK
PUSH 0xF
PUSH 0x1
DMAXS4N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# INT4_MIN max INT4_MAX field
CLEARSTACK
PUSH 0x8
PUSH 0x8
PAIRMAXS4N 0x7 0
POP y
POP x
ASSERT x == 0x7
ASSERT y == 0x7

# unsigned dual max contrast
CLEARSTACK
PUSH 0xF
PUSH 0x2
DMAX4N 0x1 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 2

# DMAXSIGN4N
CLEARSTACK
PUSH 0xE
PUSH 0x3
DMAXSIGN4N 0xF 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 3

# STACK2MAXS4N n1
CLEARSTACK
PUSH 0xE0
PUSH 0x10
STACK2MAXS4N 0x0 1
POP y
POP x
ASSERT x == 0x00
ASSERT y == 0x10

HOLD_FLASH 0
