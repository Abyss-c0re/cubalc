ASSERT LAST_N == 2 "af pretr2"
SEND gate pore 2
ASSERT LAST_N == 2 "af prepo2"
SEND gate mix 2
ASSERT LAST_N == 2 "af premx2"
SEND gate collapse 2
ASSERT LAST_N == 2 "af precol2"
SEND gate retrieve 2
ASSERT LAST_N == 2 "af prert2"
SEND gate photosynth 30
SEND gate glycolyse 24
SEND gate pump 18
SEND gate photophos 16
SEND gate charge 20
SEND gate feed 20

GETF gate heat
LET h1 = LAST_N
GETF gate energy
LET e1 = LAST_N
GETF gate atp
LET at1 = LAST_N
GETF gate pmf
LET p1 = LAST_N
GETF gate age
LET ag1 = LAST_N
GETF gate reserve
LET r1 = LAST_N
GETF gate threshold
LET t1 = LAST_N
GETF gate setpoint
LET s1 = LAST_N
GETF gate pcr
LET c1 = LAST_N
ASSERT e1 >= 1 "af e primed"
ASSERT at1 >= 1 "af a primed"

SEND gate acidify 2
ASSERT LAST_N >= 0 "gate preac"
GETF gate heat
LET hM = LAST_N
GETF gate energy
LET eM = LAST_N
GETF gate atp
LET aM = LAST_N
GETF gate pmf
LET pM = LAST_N
GETF gate threshold
LET tM = LAST_N
GETF gate age
LET agM = LAST_N
GETF gate reserve
LET rM = LAST_N
GETF gate setpoint
LET sM = LAST_N
GETF gate pcr
LET cM = LAST_N
SEND gate mature 2
LET tookM = LAST_N
ASSERT tookM >= 0 "gate mat took"
GETF gate heat
ASSERT LAST_N == hM + tookM "gate mat heat"
GETF gate energy
ASSERT LAST_N == eM - tookM "gate mat e"
GETF gate atp
ASSERT LAST_N == aM - tookM "gate mat a"
GETF gate pmf
ASSERT LAST_N == pM - tookM "gate mat pmf"
GETF gate threshold
ASSERT LAST_N == tM + tookM "gate mat thr"
GETF gate age
ASSERT LAST_N == agM "gate mat age"
GETF gate reserve
ASSERT LAST_N == rM "gate mat r"
GETF gate setpoint
ASSERT LAST_N == sM "gate mat sp"
GETF gate pcr
ASSERT LAST_N == cM "gate mat pcr"

SEND gate mature 0
ASSERT LAST_N == 0 "af zero"

SEND dead mature 3
ASSERT LAST_N == 0 "af dead0"

SEND poor mature 3
ASSERT LAST_N == 0 "af poor0"

