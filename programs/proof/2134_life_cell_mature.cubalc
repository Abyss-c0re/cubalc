GETF twin heat
ASSERT LAST_N == hM + tookM "twin mat heat"
GETF twin energy
ASSERT LAST_N == eM - tookM "twin mat e"
GETF twin atp
ASSERT LAST_N == aM - tookM "twin mat a"
GETF twin pmf
ASSERT LAST_N == pM - tookM "twin mat pmf"
GETF twin threshold
ASSERT LAST_N == tM + tookM "twin mat thr"
GETF twin age
ASSERT LAST_N == agM "twin mat age"
GETF twin reserve
ASSERT LAST_N == rM "twin mat r"
GETF twin setpoint
ASSERT LAST_N == sM "twin mat sp"
