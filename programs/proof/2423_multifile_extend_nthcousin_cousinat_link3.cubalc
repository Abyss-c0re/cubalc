# Proof 2423 — MULTIFILE_EXTEND_NTHCOUSIN_COUSINAT_LINK3
# Multi-file CLASS EXTEND + NTHCOUSIN/COUSINAT index pick on first-cousin lattice.
# Complements COUSINS bag + FIRSTCOUSIN + LASTCOUSIN + COUSINCOUNT + ARECOUSINS.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS TwinLeafA EXTEND TwinGreet
  FIELD a 1
  METHOD za
    RET 1
  END
END
HASCLASS TwinLeafA
ASSERT LAST_N == 1

CLASS TwinLeafB EXTEND TwinGreet
  FIELD b 1
  METHOD zb
    RET 1
  END
END
HASCLASS TwinLeafB
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

CLASS DeepLeaf EXTEND SoftTag
  FIELD deep 1
  METHOD z
    RET 1
  END
END
HASCLASS DeepLeaf
ASSERT LAST_N == 1

COUSINS LoudTag
ASSERT OK == 1
ASSERT LAST_N == 2
ASSERT COUSINS_N == 2

FIRSTCOUSIN LoudTag
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafA"

LASTCOUSIN LoudTag
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafB"

NTHCOUSIN LoudTag 0
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT NTHCOUSIN_N == 1
ASSERT LAST == "TwinLeafA"
ASSERT NTHCOUSIN == "TwinLeafA"
ASSERT COUSIN == "TwinLeafA"
ASSERT COUSINS_N == 2

NTHCOUSIN LoudTag 1
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafB"
ASSERT NTHCOUSIN == "TwinLeafB"

NTHCOUSIN SoftTag 0
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafA"

NTHCOUSIN SoftTag 1
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafB"

NTHCOUSIN TwinLeafA 0
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"

NTHCOUSIN TwinLeafA 1
ASSERT LAST_N == 1
ASSERT LAST == "SoftTag"

NTHCOUSIN TwinLeafB 0
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"

NTHCOUSIN TwinLeafB 1
ASSERT LAST_N == 1
ASSERT LAST == "SoftTag"

COUSINAT LoudTag 0
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafA"
ASSERT COUSINAT_N == 1

COUSINAT SoftTag AT 1
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafB"

NTH_COUSIN TwinLeafA 0
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"

COUSIN_AT TwinLeafB 1
ASSERT LAST_N == 1
ASSERT LAST == "SoftTag"

NTHCOUSIN LoudTag 2
ASSERT OK == 1
ASSERT LAST_N == 0

NTHCOUSIN LoudTag 99
ASSERT LAST_N == 0

NTHCOUSIN DeepLeaf 0
ASSERT OK == 1
ASSERT LAST_N == 0

NTHCOUSIN Solo 0
ASSERT LAST_N == 0

NTHCOUSIN Greeter 0
ASSERT LAST_N == 0

NTHCOUSIN TagGreeter 0
ASSERT LAST_N == 0

LET i = 0
NTHCOUSIN LoudTag i
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafA"
LET i = 1
NTHCOUSIN LoudTag i
ASSERT LAST_N == 1
ASSERT LAST == "TwinLeafB"

COUSINCOUNT LoudTag
ASSERT LAST_N == 2
ARECOUSINS LoudTag TwinLeafA
ASSERT LAST_N == 1
ARECOUSINS LoudTag SoftTag
ASSERT LAST_N == 0
HASCOUSIN TwinLeafB
ASSERT LAST_N == 1

PRINT "2423_NTHCOUSIN_COUSINAT PASS"
