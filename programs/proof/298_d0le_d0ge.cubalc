# Proof 298 — digit-6 zero-bound preds: D0LE D0GE S0LE S0GE
HOLD_FLASH 1
SCIENCE LOAD

# D0LE / DNONPOS — non-positive pair
CLEARSTACK
PUSH -3
PUSH 0
D0LE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 5
PUSH -1
PAIR0LE
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 2
PUSH 7
DNONPOS
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# D0GE / DNONNEG — non-negative pair
CLEARSTACK
PUSH 0
PUSH 4
D0GE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH -2
PUSH 3
PAIR0GE
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -5
PUSH -1
DNONNEG
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# S0LE / SNONPOS — single-stack
CLEARSTACK
PUSH -1
S0LE
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0
STACK0LE
POP x
ASSERT x == 1

CLEARSTACK
PUSH 9
SNONPOS
POP x
ASSERT x == 0

# S0GE / SNONNEG — single-stack
CLEARSTACK
PUSH 0
S0GE
POP x
ASSERT x == 1

CLEARSTACK
PUSH 3
STACK0GE
POP x
ASSERT x == 1

CLEARSTACK
PUSH -4
SNONNEG
POP x
ASSERT x == 0

# chain with D0LT/D0GT siblings
CLEARSTACK
PUSH -2
PUSH 0
D0LT
POP y
POP x
ASSERT x == 1
ASSERT y == 0
CLEARSTACK
PUSH -2
PUSH 0
D0LE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# soft fails
CLEARSTACK
D0LE
ASSERT OK == 0
CLEARSTACK
PUSH 1
D0GE
ASSERT OK == 0
CLEARSTACK
S0LE
ASSERT OK == 0
CLEARSTACK
S0GE
ASSERT OK == 0

HOLD_FLASH 1
