# INCLUDE live_session - oop_session + obj_guard combined live OOP contract

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  FIELD status
  METHOD ping
    LET LAST = "pong"
  END
  METHOD init
    LET id = 1
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

NEW Ticket t1
NEW Order o1

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_METHODS = ""
DEFAULT NEED_FIELDS = ""
DEFAULT NEED_OBJS = ""
DEFAULT CLASS_GUARD_SOFT = 0
DEFAULT METHOD_GUARD_SOFT = 0
DEFAULT FIELD_GUARD_SOFT = 0
DEFAULT OBJ_GUARD_SOFT = 0
INCLUDE live_session
ASSERT LIVE_SESSION_OK == 1
ASSERT OOP_SESSION_OK == 1
ASSERT OBJ_GUARD_OK == 1

LET NEED_CLASSES = "Ticket\nOrder"
LET NEED_METHODS = "Ticket.ping\nOrder.pay"
LET NEED_FIELDS = "Ticket.id\nOrder.n"
LET NEED_OBJS = "t1\no1"
LET CLASS_GUARD_SOFT = 1
LET METHOD_GUARD_SOFT = 1
LET FIELD_GUARD_SOFT = 1
LET OBJ_GUARD_SOFT = 1
INCLUDE live_session
ASSERT LIVE_SESSION_OK == 1

LET NEED_OBJS = "t1\nnosuch_live_obj"
LET OBJ_GUARD_SOFT = 1
INCLUDE live_session
ASSERT OBJ_GUARD_OK == 0
ASSERT LIVE_SESSION_OK == 0
CLEAR_ERR

LET NEED_OBJS = "t1\no1"
LET NEED_CLASSES = "nosuch_live_class"
LET CLASS_GUARD_SOFT = 1
INCLUDE live_session
ASSERT OOP_SESSION_OK == 0
ASSERT LIVE_SESSION_OK == 0
CLEAR_ERR

LET NEED_CLASSES = "Ticket\nOrder"
LET NEED_METHODS = "Ticket.ping"
LET NEED_FIELDS = "Ticket.status"
LET NEED_OBJS = "t1"
LET CLASS_GUARD_SOFT = 0
LET METHOD_GUARD_SOFT = 0
LET FIELD_GUARD_SOFT = 0
LET OBJ_GUARD_SOFT = 0
INCLUDE live_session
ASSERT LIVE_SESSION_OK == 1

HASLIB live_session
ASSERT LAST_N == 1
HASLIB oop_session
ASSERT LAST_N == 1
HASLIB obj_guard
ASSERT LAST_N == 1

PRINT "1406_live_session ok"
PASS
