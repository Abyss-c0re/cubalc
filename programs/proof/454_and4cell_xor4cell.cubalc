# Proof 454 — digit-4 cell fixed-width 4 nibble bitwise: AND4CELL OR4CELL XOR4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# AND4CELL: 0xF & 0x3 → 0x3; high bits ignored
CELLSET 0 15
CELLSET 1 255
AND4CELL 0 1 3
ASSERT CELL(0) == 3
ASSERT CELL(1) == 3
ASSERT LAST_N == 2

# OR4CELL: 0x3 | 0xC → 0xF
CELLSET 2 3
OR4CELL 2 2 12
ASSERT CELL(2) == 15
ASSERT LAST_N == 1

# XOR4CELL: 0xF ^ 0x5 → 0xA = 10
CELLSET 3 15
XOR4CELL 3 3 5
ASSERT CELL(3) == 10
ASSERT LAST_N == 1

# high bits above 4 ignored
CELLSET 4 17
AND4CELL 4 4 15
ASSERT CELL(4) == 1

CELLSET 5 17
OR4CELL 5 5 2
ASSERT CELL(5) == 3

CELLSET 6 15
XOR4CELL 6 6 15
ASSERT CELL(6) == 0

CELLSET 7 11
AND4RANGE 7 7 7
ASSERT CELL(7) == 3

CELLSET 8 1
CELLSET 9 2
OR4CELL 8 9 4
ASSERT CELL(8) == 5
ASSERT CELL(9) == 6
ASSERT LAST_N == 2

CELLSET 10 10
XOR4RANGE 10 10 15
ASSERT CELL(10) == 5

HOLD_FLASH 0
