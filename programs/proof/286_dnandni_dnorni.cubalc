# Proof 286 — digit-3 dual-stack imm inverted ANDN: DNANDNI DNORNI DXNORNI
HOLD_FLASH 1
SCIENCE LOAD

# DNANDNI n — a b → ~(a&~n) ~(b&~n)
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNANDNI 0x0F
POP y
POP x
ASSERT x == 0xEEDDCCBBAA99887F
ASSERT y == 0x66554433221100FF

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
PAIRNANDNI 0xFF
POP y
POP x
ASSERT x == -43777
ASSERT y == -4609

CLEARSTACK
PUSH -1
PUSH -1
DINVERTANDNI 0xF0
POP y
POP x
ASSERT x == 240
ASSERT y == 240

# DNORNI n — a b → ~(a|~n) ~(b|~n)
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNORNI 0x0F
POP y
POP x
ASSERT x == 7
ASSERT y == 15

CLEARSTACK
PUSH 0
PUSH 0
PAIRNORNI 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 0
PUSH 0
DINVERTORNI 0xFF
POP y
POP x
ASSERT x == 255
ASSERT y == 255

CLEARSTACK
PUSH 0xF0
PUSH 0x0F
DNORNOTI 0xFF
POP y
POP x
ASSERT x == 15
ASSERT y == 240

# DXNORNI n — a b → ~(a^~n) ~(b^~n) ≡ a^n , b^n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNORNI 0x0F
POP y
POP x
ASSERT x == 0x1122334455667787
ASSERT y == 0x99AABBCCDDEEFF0F

CLEARSTACK
PUSH -1
PUSH -1
PAIRXNORNI 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

CLEARSTACK
PUSH -1
PUSH 0
DEQUIVNI 0xF
POP y
POP x
ASSERT x == -16
ASSERT y == 15

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXORI 0x0F
POP y2
POP x2
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNORNI 0x0F
POP y
POP x
ASSERT x == x2
ASSERT y == y2

# soft fails (need 2)
CLEARSTACK
DNANDNI 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DNORNI 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
POP z
DXNORNI 1
ASSERT OK == 0

HOLD_FLASH 1
