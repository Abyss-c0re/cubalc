# Proof 480 — digit-1 dual-stack imm 8-bit field div/mod/min: DDIV8N DMOD8N DMIN8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DDIV8N: 100/10=10 ; 50/10=5
PUSH 100
PUSH 50
DDIV8N 10 0
POP y
POP x
ASSERT x == 10
ASSERT y == 5

# floor both
CLEARSTACK
PUSH 23
PUSH 22
PAIRDIV8N 5 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# div0 → 0
CLEARSTACK
PUSH 0xFF
PUSH 0x12
DDIV8N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved: byte0 / 4
CLEARSTACK
PUSH 0x11223344556677C8
PUSH 0x99AABBCCDDEEFF64
DDIV8N 4 0
POP y
POP x
ASSERT x == 0x1122334455667732
ASSERT y == 0x99AABBCCDDEEFF19

# S2DIV8N n1
CLEARSTACK
PUSH 0x6400
PUSH 0xC800
S2DIV8N 10 1
POP y
POP x
ASSERT x == 0x0A00
ASSERT y == 0x1400

# DQUO8N alias
CLEARSTACK
PUSH 30
PUSH 18
DQUO8N 6 0
POP y
POP x
ASSERT x == 5
ASSERT y == 3

# DMOD8N
CLEARSTACK
PUSH 23
PUSH 22
DMOD8N 5 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# exact both
CLEARSTACK
PUSH 100
PUSH 50
PAIRMOD8N 10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mod0 → 0
CLEARSTACK
PUSH 0xAB
PUSH 0xCD
DREM8N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# STACK2MOD8N n1
CLEARSTACK
PUSH 0x1700
PUSH 0x1600
STACK2MOD8N 5 1
POP y
POP x
ASSERT x == 0x0300
ASSERT y == 0x0200

# DMIN8N
CLEARSTACK
PUSH 0xC0
PUSH 0x10
DMIN8N 0x40 0
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0x10

# keeps smaller
CLEARSTACK
PUSH 0x10
PUSH 0x20
PAIRMIN8N 0x90 0
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x20

# high preserved min
CLEARSTACK
PUSH 0x11223344556677FE
PUSH 0x99AABBCCDDEEFFAB
DMIN8N 0x20 0
POP y
POP x
ASSERT x == 0x1122334455667720
ASSERT y == 0x99AABBCCDDEEFF20

# S2MIN8N n1
CLEARSTACK
PUSH 0xFF00
PUSH 0x1100
S2MIN8N 0x11 1
POP y
POP x
ASSERT x == 0x1100
ASSERT y == 0x1100

# DLE8N alias min equal
CLEARSTACK
PUSH 0x55
PUSH 0x55
DLE8N 0x55 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0x55

HOLD_FLASH 0
