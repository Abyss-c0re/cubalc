# Proof 136 — digit-2 abundance: ALIQUOT ISPERFECT ISABUNDANT ISDEFICIENT + stack
HOLD_FLASH 1
SCIENCE LOAD

# ALIQUOT / PROPERSIGMA — s(n) = σ(n) - n
ASSERT ALIQUOT(1) == 0
ASSERT ALIQUOT(6) == 6
ASSERT PROPERSIGMA(12) == 16
ASSERT ALIQUOT(28) == 28
ASSERT ALIQUOT(10) == 8
ASSERT ALIQUOT(0) == 0

# ISPERFECT — 6, 28 perfect; 12 not
ASSERT ISPERFECT(6) == 1
ASSERT PERFECTP(28) == 1
ASSERT ISPERFECT(12) == 0
ASSERT ISPERFECT(1) == 0
ASSERT ISPERFECT(7) == 0

# ISABUNDANT — 12 abundant (s=16>12); 18 abundant
ASSERT ISABUNDANT(12) == 1
ASSERT ABUNDANTP(18) == 1
ASSERT ISABUNDANT(6) == 0
ASSERT ISABUNDANT(10) == 0

# ISDEFICIENT — primes and 10
ASSERT ISDEFICIENT(7) == 1
ASSERT DEFICIENTP(10) == 1
ASSERT ISDEFICIENT(12) == 0
ASSERT ISDEFICIENT(28) == 0

# mutual exclusion on 20: σ(20)=1+2+4+5+10+20=42, s=22>20 abundant
ASSERT ISABUNDANT(20) == 1
ASSERT ISPERFECT(20) == 0
ASSERT ISDEFICIENT(20) == 0

# stack SALIQUOT
CLEARSTACK
PUSH 12
SALIQUOT
ASSERT LAST_N == 16
PUSH 6
SPROPERSIGMA
ASSERT LAST_N == 6

# stack SISPERFECT
CLEARSTACK
PUSH 28
SISPERFECT
ASSERT LAST_N == 1
PUSH 12
SPERFECTP
ASSERT LAST_N == 0

# stack SISABUNDANT / SISDEFICIENT
CLEARSTACK
PUSH 12
SISABUNDANT
ASSERT LAST_N == 1
PUSH 7
SISDEFICIENT
ASSERT LAST_N == 1
PUSH 6
SABUNDANTP
ASSERT LAST_N == 0

# soft fails
CLEARSTACK
SALIQUOT
ASSERT OK == 0
SISPERFECT
ASSERT OK == 0
SISABUNDANT
ASSERT OK == 0
SISDEFICIENT
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof136_aliquot_perfect" LAST_N SP
