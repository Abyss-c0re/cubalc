# Past the old 128 soft-fail zone — specials must still bind
SETP "role" "worker"
SETP "cfg.role" "worker"
SETP "other.role" "leader"
ALLEQFLAT "role"
ASSERT LAST_N == 0 "mixed roles"
FIRSTUNEQFLAT "role"
# LAST must be a real path (not dark 0 under var pressure)
ASSERT LAST_N == 1 "firstuneq found under fat LET board"
SYS HAS LAST "role"
ASSERT OK == 1 "LAST path has role"

VARS
ASSERT VARS_MAX >= 256 "agent ceiling raised"
ASSERT VARS_N >= 150 "fat board still counted"
ASSERT VARS_FULL == 0 "not full yet"

STATUS
PRINT "vars_max_ok" VARS_N VARS_MAX VARS_FULL
