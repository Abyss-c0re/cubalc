# Proof 546 — digit-8 stack+dual imm 16-bit signed min/max: SMINS16N SMAXS16N DMINS16N DMAXS16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMINS16N: signed min(-1=0xFFFF, 1) → -1
PUSH 0xFFFF
SMINS16N 0x1 0
POP x
ASSERT x == 0xFFFF

# unsigned SMIN: min(0xFFFF, 1) → 1
CLEARSTACK
PUSH 0xFFFF
SMIN16N 0x1 0
POP x
ASSERT x == 1

# positive: min(2, 3) → 2
CLEARSTACK
PUSH 0x2
SMINS16N 0x3 0
POP x
ASSERT x == 2

# field smaller: min(5, -2) → -2
CLEARSTACK
PUSH 0x5
MINS16N 0xFFFE 0
POP x
ASSERT x == 0xFFFE

# INT16_MIN vs INT16_MAX → INT16_MIN
CLEARSTACK
PUSH 0x8000
SMINSIGN16N 0x7FFF 0
POP x
ASSERT x == 0x8000

# equal
CLEARSTACK
PUSH 0x8000
SMINS16N 0x8000 0
POP x
ASSERT x == 0x8000

# preserved high halfword: low -1 min 0 → low -1
CLEARSTACK
PUSH 0x1122FFFF
SMINS16N 0x0 0
POP x
ASSERT x == 0x1122FFFF

# STACKMINS16N n1: halfword1 of 0xFFFF0001 is FFFF → min 0 stays FFFF
CLEARSTACK
PUSH 0xFFFF0001
STACKMINS16N 0x0 1
POP x
ASSERT x == 0xFFFF0001

# n2 high-mid: 0xFFFE00000000 min 0 → 0xFFFE00000000
CLEARSTACK
PUSH 0x0000FFFE00000000
SMINS16N 0x0 2
POP x
ASSERT x == 0x0000FFFE00000000

# SMAXS16N: signed max(-1, 1) → 1
CLEARSTACK
PUSH 0xFFFF
SMAXS16N 0x1 0
POP x
ASSERT x == 1

# unsigned SMAX: max(0xFFFF, 1) → 0xFFFF
CLEARSTACK
PUSH 0xFFFF
SMAX16N 0x1 0
POP x
ASSERT x == 0xFFFF

# max(2, -3) → 2
CLEARSTACK
PUSH 0x2
MAXS16N 0xFFFD 0
POP x
ASSERT x == 2

# INT16_MIN max INT16_MAX → INT16_MAX
CLEARSTACK
PUSH 0x8000
SMAXSIGN16N 0x7FFF 0
POP x
ASSERT x == 0x7FFF

# equal
CLEARSTACK
PUSH 0x5555
SMAXS16N 0x5555 0
POP x
ASSERT x == 0x5555

# preserved high: low 1 max -1 → low 1
CLEARSTACK
PUSH 0xAABB0001
SMAXS16N 0xFFFF 0
POP x
ASSERT x == 0xAABB0001

# STACKMAXS16N n1
CLEARSTACK
PUSH 0x00020000
STACKMAXS16N 0xFFFF 1
POP x
ASSERT x == 0x00020000

# DMINS16N: -1 min 0 → -1; 1 min 0 → 0
CLEARSTACK
PUSH 0xFFFF
PUSH 0x1
DMINS16N 0x0 0
POP y
POP x
ASSERT x == 0xFFFF
ASSERT y == 0

# unsigned dual contrast
CLEARSTACK
PUSH 0xFFFF
PUSH 0xFFFF
DMIN16N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# mixed
CLEARSTACK
PUSH 0x2
PUSH 0xFFFE
PAIRMINS16N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFFFE

# preserved high dual
CLEARSTACK
PUSH 0x1122FFFF
PUSH 0xAABB0005
S2MINS16N 0x1 0
POP y
POP x
ASSERT x == 0x1122FFFF
ASSERT y == 0xAABB0001

# STACK2MINS16N n1
CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x00020000
STACK2MINS16N 0x0 1
POP y
POP x
ASSERT x == 0xFFFF0000
ASSERT y == 0x00000000

# DMAXS16N: -1 max 0 → 0; 1 max 0 → 1
CLEARSTACK
PUSH 0xFFFF
PUSH 0x1
DMAXS16N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# INT16_MIN max INT16_MAX field
CLEARSTACK
PUSH 0x8000
PUSH 0x8000
PAIRMAXS16N 0x7FFF 0
POP y
POP x
ASSERT x == 0x7FFF
ASSERT y == 0x7FFF

# unsigned dual max contrast
CLEARSTACK
PUSH 0xFFFF
PUSH 0x2
DMAX16N 0x1 0
POP y
POP x
ASSERT x == 0xFFFF
ASSERT y == 2

# DMAXSIGN16N
CLEARSTACK
PUSH 0xFFFE
PUSH 0x3
DMAXSIGN16N 0xFFFF 0
POP y
POP x
ASSERT x == 0xFFFF
ASSERT y == 3

# STACK2MAXS16N n1
CLEARSTACK
PUSH 0xFFFE0000
PUSH 0x00010000
STACK2MAXS16N 0x0 1
POP y
POP x
ASSERT x == 0x00000000
ASSERT y == 0x00010000

HOLD_FLASH 0
