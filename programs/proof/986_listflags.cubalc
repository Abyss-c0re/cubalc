# LISTFLAGS / FLAGS — bag of CLI flag names (no dashes) from CUBALC_ARGn

HOLD_FLASH 1

# empty
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
LISTFLAGS
ASSERT LAST_N == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# mixed flags + files
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "--verbose"
SYS ENV SET CUBALC_ARG2 "a.txt"
SYS ENV SET CUBALC_ARGC "3"
LISTFLAGS
ASSERT LAST_N == 2
SYS HASLINE LAST "mode"
ASSERT LAST_N == 1
LISTFLAGS
SYS HASLINE LAST "verbose"
ASSERT LAST_N == 1
LISTFLAGS
SYS HASLINE LAST "a.txt"
ASSERT LAST_N == 0

# --name value form still names the flag once
SYS ENV SET CUBALC_ARG0 "--out"
SYS ENV SET CUBALC_ARG1 "hi.txt"
SYS ENV SET CUBALC_ARG2 "-n"
SYS ENV SET CUBALC_ARG3 "3"
SYS ENV SET CUBALC_ARGC "4"
FLAGS
ASSERT LAST_N == 2
SYS HASLINE LAST "out"
ASSERT LAST_N == 1
FLAGS
SYS HASLINE LAST "n"
ASSERT LAST_N == 1

# bare -- ends flags; after that not listed
SYS ENV SET CUBALC_ARG0 "--dry"
SYS ENV SET CUBALC_ARG1 "--"
SYS ENV SET CUBALC_ARG2 "--notflag"
SYS ENV SET CUBALC_ARGC "3"
LISTFLAGS
ASSERT LAST_N == 1
SYS EQS LAST "dry"
ASSERT LAST_N == 1

# pairs with HASFLAG
HASFLAG mode
ASSERT LAST_N == 0
SYS ENV SET CUBALC_ARG0 "--mode=x"
SYS ENV SET CUBALC_ARGC "1"
LISTFLAGS
SYS HASLINE LAST "mode"
ASSERT LAST_N == 1
HASFLAG mode
ASSERT LAST_N == 1

PRINT "listflags ok"
