# INCLUDE form_guard — multi form ALL + ANY contract (env_guard twin for forms)

HOLD_FLASH 1

# --- skip both gates when empty (clear defaults) ---
DEFAULT NEED_FORMS = ""
DEFAULT NEED_FORM_ANY = ""
DEFAULT FORM_GUARD_SOFT = 0
INCLUDE form_guard
ASSERT FORM_GUARD_OK == 1
ASSERT FORM_GUARD_ALL_OK == 1
ASSERT FORM_GUARD_ANY_OK == 1

# --- soft ALL miss ---
LET NEED_FORMS = "HASFORM\nNO_SUCH_FORM_FG_ZZZ"
LET NEED_FORM_ANY = ""
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_OK == 0
ASSERT FORM_GUARD_ALL_OK == 0
ASSERT FORMMISS_N >= 1
SYS HASLINE FORMMISS "NO_SUCH_FORM_FG_ZZZ"
ASSERT LAST_N == 1
CLEAR_ERR

# --- soft ALL hit ---
LET NEED_FORMS = "HASFORM\nNEEDFORM\nHASFORMS"
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_ALL_OK == 1
ASSERT FORM_GUARD_OK == 1

# --- soft ANY miss ---
LET NEED_FORMS = ""
LET NEED_FORM_ANY = "NO_SUCH_FORM_X_ZZZ\nNO_SUCH_FORM_Y_ZZZ"
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_ANY_OK == 0
ASSERT FORM_GUARD_OK == 0
ASSERT FORMMISS_N >= 1
CLEAR_ERR

# --- soft ANY hit with one ---
LET NEED_FORM_ANY = "NO_SUCH_FORM_X_ZZZ\nHASFORM"
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_ANY_OK == 1
ASSERT FORM_GUARD_OK == 1
SYS HASLINE FORMHAVE "HASFORM"
ASSERT LAST_N == 1
CLEAR_ERR

# --- hard ALL path (must pass) ---
LET NEED_FORMS = "HASFORM\nNEEDFORM"
LET NEED_FORM_ANY = ""
LET FORM_GUARD_SOFT = 0
INCLUDE form_guard
ASSERT FORM_GUARD_OK == 1

# --- hard ANY path ---
LET NEED_FORMS = ""
LET NEED_FORM_ANY = "HASFORM\nNO_SUCH_FORM_Z_ZZZ"
LET FORM_GUARD_SOFT = 0
INCLUDE form_guard
ASSERT FORM_GUARD_ANY_OK == 1
ASSERT FORM_GUARD_OK == 1

# --- combined ALL + ANY soft ---
LET NEED_FORMS = "HASFORM\nNEEDFORM"
LET NEED_FORM_ANY = "HASFORMS\nNO_SUCH_FORM_W_ZZZ"
LET FORM_GUARD_SOFT = 1
INCLUDE form_guard
ASSERT FORM_GUARD_ALL_OK == 1
ASSERT FORM_GUARD_ANY_OK == 1
ASSERT FORM_GUARD_OK == 1

# discoverable
HASFORM HASFORMANY
ASSERT LAST_N == 1
HASFORM NEEDFORMANY
ASSERT LAST_N == 1
HASLIB form_guard
ASSERT LAST_N == 1

PRINT "1386_form_guard ok"
PASS
