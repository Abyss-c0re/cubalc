LET tookM = LAST_N
ASSERT tookM >= 0 "twin rec took"
GETF twin heat
ASSERT LAST_N == hM + tookM "twin rec heat"
GETF twin energy
ASSERT LAST_N == eM - tookM "twin rec e"
GETF twin atp
ASSERT LAST_N == aM - tookM "twin rec a"
GETF twin reserve
ASSERT LAST_N == rM + tookM "twin rec r"
GETF twin pmf
ASSERT LAST_N == pM "twin rec pmf"
GETF twin threshold
ASSERT LAST_N == tM "twin rec thr"
GETF twin age
ASSERT LAST_N == agM "twin rec age"
GETF twin setpoint
ASSERT LAST_N == sM "twin rec sp"
GETF twin pcr
ASSERT LAST_N == cM "twin rec pcr"

