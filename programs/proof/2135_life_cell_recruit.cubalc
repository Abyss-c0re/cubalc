// 2135_life_cell_recruit.cubalc
// Proof 2135: life_cell recruit - post-mature M6PR/sortilin hydrolase cargo recruit.
// Pay min(n,atp,energy) -> heat+n energy-n reserve+n; age/pmf/thr/sp/pcr held.
// Continuum after mature. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 40 0
ENTITY poor OF Cell 1 0 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 24 0
ENTITY twin OF Cell 1 30 0
ENTITY ceil OF Cell 1 28 0
ENTITY starved OF Cell 1 36 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND ceil set_threshold 10
SEND starved set_threshold 10
SEND gate pulse 6
SEND gate photosynth 40
SEND gate glycolyse 36
SEND gate pump 28
SEND gate photophos 28
SEND gate photosynth 36
SEND gate glycolyse 30
SEND gate pump 20
SEND gate charge 40
SEND gate feed 40
GETF gate age
ASSERT LAST_N == 6 "af a6"
GETF gate atp
ASSERT LAST_N >= 20 "af atp"
GETF gate heat
LET hbase = LAST_N
GETF gate energy
LET ebase = LAST_N
GETF gate reserve
LET rbase = LAST_N
GETF gate pmf
LET pbase = LAST_N
ASSERT pbase >= 5 "af pmf base"
GETF gate threshold
ASSERT LAST_N == 10 "af thr10"
GETF gate setpoint
ASSERT LAST_N == 10 "af sp10"
GETF gate pcr
ASSERT LAST_N == 0 "af pcr0"

SEND gate converge 3
ASSERT LAST_N == 3 "af prece3"
SEND gate extend 1
ASSERT LAST_N == 1 "af prext1"
SEND gate fold 1
ASSERT LAST_N == 1 "af prefd1"
SEND gate zip 1
ASSERT LAST_N == 1 "af prez1"
SEND gate crest 1
ASSERT LAST_N == 1 "af prec1"
SEND gate migrate 1
ASSERT LAST_N == 1 "af prem1"
SEND gate stream 1
ASSERT LAST_N == 1 "af prest1"
SEND gate condense 1
ASSERT LAST_N == 1 "af precd1"
SEND gate fate 1
ASSERT LAST_N == 1 "af pref1"
SEND gate project 1
ASSERT LAST_N == 1 "af prep1"
SEND gate synapse 1
ASSERT LAST_N == 1 "af presy1"
SEND gate release 4
ASSERT LAST_N == 4 "af prer4"
SEND gate reuptake 3
ASSERT LAST_N == 3 "af preru3"
SEND gate refill 2
ASSERT LAST_N == 2 "af prerf2"
SEND gate dock 2
ASSERT LAST_N == 2 "af predk2"
SEND gate arm 2
ASSERT LAST_N == 2 "af prear2"
SEND gate clamp 2
ASSERT LAST_N == 2 "af precl2"
SEND gate trigger 2
ASSERT LAST_N == 2 "af pretr2"
SEND gate pore 2
ASSERT LAST_N == 2 "af prepo2"
SEND gate mix 2
ASSERT LAST_N == 2 "af premx2"
SEND gate collapse 2
ASSERT LAST_N == 2 "af precol2"
SEND gate retrieve 2
ASSERT LAST_N == 2 "af prert2"
SEND gate photosynth 30
SEND gate glycolyse 24
SEND gate pump 18
SEND gate photophos 16
SEND gate charge 20
SEND gate feed 20

GETF gate heat
LET h1 = LAST_N
GETF gate energy
LET e1 = LAST_N
GETF gate atp
LET at1 = LAST_N
GETF gate pmf
LET p1 = LAST_N
GETF gate age
LET ag1 = LAST_N
GETF gate reserve
LET r1 = LAST_N
GETF gate threshold
LET t1 = LAST_N
GETF gate setpoint
LET s1 = LAST_N
GETF gate pcr
LET c1 = LAST_N
ASSERT e1 >= 1 "af e primed"
ASSERT at1 >= 1 "af a primed"

SEND gate acidify 2
ASSERT LAST_N >= 0 "gate preac"
SEND gate mature 2
ASSERT LAST_N >= 0 "gate premat"
GETF gate heat
LET hM = LAST_N
GETF gate energy
LET eM = LAST_N
GETF gate atp
LET aM = LAST_N
GETF gate pmf
LET pM = LAST_N
GETF gate threshold
LET tM = LAST_N
GETF gate age
LET agM = LAST_N
GETF gate reserve
LET rM = LAST_N
GETF gate setpoint
LET sM = LAST_N
GETF gate pcr
LET cM = LAST_N
SEND gate recruit 2
LET tookM = LAST_N
ASSERT tookM >= 0 "gate rec took"
GETF gate heat
ASSERT LAST_N == hM + tookM "gate rec heat"
GETF gate energy
ASSERT LAST_N == eM - tookM "gate rec e"
GETF gate atp
ASSERT LAST_N == aM - tookM "gate rec a"
GETF gate reserve
ASSERT LAST_N == rM + tookM "gate rec r"
GETF gate pmf
ASSERT LAST_N == pM "gate rec pmf"
GETF gate threshold
ASSERT LAST_N == tM "gate rec thr"
GETF gate age
ASSERT LAST_N == agM "gate rec age"
GETF gate setpoint
ASSERT LAST_N == sM "gate rec sp"
GETF gate pcr
ASSERT LAST_N == cM "gate rec pcr"

SEND gate recruit 0
ASSERT LAST_N == 0 "af zero"

SEND dead recruit 3
ASSERT LAST_N == 0 "af dead0"

SEND poor recruit 3
ASSERT LAST_N == 0 "af poor0"

