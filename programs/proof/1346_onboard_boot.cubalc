# INCLUDE onboard_boot — agent_boot + START one-shot

INCLUDE onboard_boot
ASSERT OK == 1
ASSERT START_TOPICS_N == 8
ASSERT START_NEXT_N >= 8
SYS HASI "cubalc.start.v1"
ASSERT LAST_N == 1
VERSION
ASSERT LAST_N >= 1

# discovery chain still works after lib load
GUIDE general
ASSERT OK == 1
ASSERT GUIDE_RELATED_N >= 3

PASS
PRINT "1346_onboard_boot: PASS"
