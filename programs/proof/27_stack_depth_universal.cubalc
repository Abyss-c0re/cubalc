# Proof 27 — stack depth plane (digit 8): NIP TUCK 2DUP 2DROP 2SWAP ROLL DEPTH
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
# NIP: a b → b
PUSH 1
PUSH 2
NIP
ASSERT SP == 1
PEEK
ASSERT LAST_N == 2

# TUCK: a b → b a b
CLEARSTACK
PUSH 10
PUSH 20
TUCK
ASSERT SP == 3
POP x
ASSERT x == 20
POP y
ASSERT y == 10
POP z
ASSERT z == 20

# 2DUP: a b → a b a b
CLEARSTACK
PUSH 3
PUSH 4
2DUP
ASSERT SP == 4
POP a
ASSERT a == 4
POP b
ASSERT b == 3
POP c
ASSERT c == 4
POP d
ASSERT d == 3

# 2DROP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2DROP
ASSERT SP == 2
PEEK
ASSERT LAST_N == 2

# 2SWAP: a b c d → c d a b
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2SWAP
POP w
ASSERT w == 2
POP x
ASSERT x == 1
POP y
ASSERT y == 4
POP z
ASSERT z == 3
ASSERT SP == 0

# ROLL 2 ≡ ROT: a b c → b c a
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
ROLL 2
POP r0
ASSERT r0 == 1
POP r1
ASSERT r1 == 3
POP r2
ASSERT r2 == 2

# ROLL 1 ≡ SWAP
CLEARSTACK
PUSH 5
PUSH 6
ROLL 1
POP p
ASSERT p == 5
POP q
ASSERT q == 6

# DEPTH
CLEARSTACK
PUSH 9
PUSH 8
PUSH 7
DEPTH
ASSERT LAST_N == 3
ASSERT SP == 4
PEEK
ASSERT LAST_N == 3

# empty guards
CLEARSTACK
NIP
ASSERT OK == 0
TUCK
ASSERT OK == 0
2DUP
ASSERT OK == 0
2DROP
ASSERT OK == 0
2SWAP
ASSERT OK == 0
ROLL 3
ASSERT OK == 0

CUBE s ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof27_stack_depth" SP
