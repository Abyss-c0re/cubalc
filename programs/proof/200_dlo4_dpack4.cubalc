# Proof 200 — digit-3 dual-stack nibble plane: DLO4 DHI4 DPACK4
HOLD_FLASH 1
SCIENCE LOAD

# DLO4: low nibble
CLEARSTACK
PUSH 0xAB
PUSH 0xC5
DLO4
POP y
POP x
ASSERT x == 0xB
ASSERT y == 0x5

# 2LO4
CLEARSTACK
PUSH 0x10
PUSH 0x0F
2LO4
POP y
POP x
ASSERT x == 0
ASSERT y == 0xF

# DNIBLO alias
CLEARSTACK
PUSH 0x21
PUSH 0x33
DNIBLO
POP y
POP x
ASSERT x == 1
ASSERT y == 3

# DHI4: high nibble of low byte
CLEARSTACK
PUSH 0xAB
PUSH 0xC5
DHI4
POP y
POP x
ASSERT x == 0xA
ASSERT y == 0xC

# 2HI4
CLEARSTACK
PUSH 0x10
PUSH 0x0F
2HI4
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DNIBHI alias
CLEARSTACK
PUSH 0xF0
PUSH 0x80
DNIBHI
POP y
POP x
ASSERT x == 0xF
ASSERT y == 8

# DPACK4: a b c d → (a<<4)|c  (b<<4)|d  (nibble-masked)
CLEARSTACK
PUSH 0xA
PUSH 0xB
PUSH 0xC
PUSH 0xD
DPACK4
POP y
POP x
ASSERT x == 0xAC
ASSERT y == 0xBD

# 2PACK4 with excess bits masked
CLEARSTACK
PUSH 0x1F
PUSH 0x22
PUSH 0x33
PUSH 0x44
2PACK4
POP y
POP x
ASSERT x == 0xF3
ASSERT y == 0x24

# PAIRPACK4 / DPACKN
CLEARSTACK
PUSH 0
PUSH 1
PUSH 2
PUSH 3
PAIRPACK4
POP y
POP x
ASSERT x == 2
ASSERT y == 0x13

CLEARSTACK
PUSH 0xE
PUSH 0x7
PUSH 0x1
PUSH 0x8
DPACKN
POP y
POP x
ASSERT x == 0xE1
ASSERT y == 0x78
