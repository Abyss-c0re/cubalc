# POPCOUNTN / CLZN / CTZN / PARITYN — bit density usability
# Twin of stack SPOPCNT/SCLZ/SCTZ. Usability: bits = POPCOUNTN flags after GETFLAGN.

HOLD_FLASH 1

# popcount basics
POPCOUNTN 0
ASSERT LAST_N == 0
ASSERT POPCOUNTN_OK == 1

POPCOUNTN 1
ASSERT LAST_N == 1

POPCOUNTN 7
ASSERT LAST_N == 3
ASSERT POPCOUNTN == 3

POPCOUNTN 255
ASSERT LAST_N == 8

POPCOUNTN 256
ASSERT LAST_N == 1

# clz / ctz
CLZN 0
ASSERT LAST_N == 64
ASSERT CLZN_OK == 1

CLZN 1
ASSERT LAST_N == 63

CLZN 8
ASSERT LAST_N == 60

CTZN 0
ASSERT LAST_N == 64

CTZN 1
ASSERT LAST_N == 0

CTZN 8
ASSERT LAST_N == 3
ASSERT CTZN == 3

# parity
PARITYN 0
ASSERT LAST_N == 0

PARITYN 1
ASSERT LAST_N == 1

PARITYN 3
ASSERT LAST_N == 0

PARITYN 7
ASSERT LAST_N == 1

# aliases
BITCOUNTN 15
ASSERT LAST_N == 4
PCNTN 15
ASSERT LAST_N == 4
NLZN 16
ASSERT LAST_N == 59
LZCNTN 16
ASSERT LAST_N == 59
NTZN 16
ASSERT LAST_N == 4
TZCNTN 16
ASSERT LAST_N == 4
XORREDN 15
ASSERT LAST_N == 0
PARN 15
ASSERT LAST_N == 0

# all-ones two's complement
POPCOUNTN -1
ASSERT LAST_N == 64

# var subject
LET flags 240
POPCOUNTN flags
ASSERT LAST_N == 4
CTZN flags
ASSERT LAST_N == 4
CLZN flags
ASSERT LAST_N == 56
PARITYN flags
ASSERT LAST_N == 0

# GETFLAGN pipeline
SYS ENV SET CUBALC_ARG0 "--mask=255"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN mask OR 0
ASSERT LAST_N == 255
POPCOUNTN LAST_N
ASSERT LAST_N == 8
PARITYN 255
ASSERT LAST_N == 0

PRINT "popcountn_clzn_ctzn_parityn ok"
