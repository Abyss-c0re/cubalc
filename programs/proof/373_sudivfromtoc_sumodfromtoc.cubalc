# Proof 373 — digit-2 reverse unsigned stack TOC: SUDIVFROMTOC SUMODFROMTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SUDIVFROMTOC: 100 / 7 cell=7 → 14
CELLSET 1 7
PUSH 1
PUSH 100
SUDIVFROMTOC
ASSERT LAST_N == 14
ASSERT CELL(1) == 14
POP a
ASSERT a == 14

# RUDIVTOC: 17 / 5 cell=5 → 3
CELLSET 2 5
PUSH 2
PUSH 17
RUDIVTOC
ASSERT LAST_N == 3
ASSERT CELL(2) == 3
POP

# soft cell0 → 0
CELLSET 3 0
PUSH 3
PUSH 9
SUDIVFROMTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SUMODFROMTOC: 100 % 7 cell=7 → 2
CELLSET 4 7
PUSH 4
PUSH 100
SUMODFROMTOC
ASSERT LAST_N == 2
ASSERT CELL(4) == 2
POP

# RUMODTOC: 17 % 5 cell=5 → 2
CELLSET 5 5
PUSH 5
PUSH 17
RUMODTOC
ASSERT LAST_N == 2
ASSERT CELL(5) == 2
POP

# soft cell0 → 0
CELLSET 6 0
PUSH 6
PUSH 11
SUMODFROMTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# UDIVFROMTOC: 20 / 4 cell=4 → 5
CELLSET 7 4
PUSH 7
PUSH 20
UDIVFROMTOC
ASSERT LAST_N == 5
ASSERT CELL(7) == 5
POP

# UREMFROMTOC: 20 % 6 cell=6 → 2
CELLSET 8 6
PUSH 8
PUSH 20
UREMFROMTOC
ASSERT LAST_N == 2
ASSERT CELL(8) == 2
POP

# soft shallow OK=0
CLEARSTACK
PUSH 1
SUDIVFROMTOC
ASSERT OK == 0

PRINT "373_sudivfromtoc_sumodfromtoc OK"
