// 2143_life_cell_trim.cubalc
// Proof 2143: life_cell trim - post-glycosyl GLS I/II Glc trim / CNX monoglucosylated entry.
// Pay min(n,atp,energy) -> heat+n energy-n atp-n sp+n; age/reserve/thr/pmf/pcr held.
// Continuum after glycosyl. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 40 0
ENTITY poor OF Cell 1 0 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 24 0
ENTITY twin OF Cell 1 30 0
ENTITY ceil OF Cell 1 28 0
ENTITY starved OF Cell 1 36 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND ceil set_threshold 10
SEND starved set_threshold 10
SEND gate pulse 6
SEND gate photosynth 40
SEND gate glycolyse 36
SEND gate pump 28
SEND gate photophos 28
SEND gate photosynth 36
SEND gate glycolyse 30
SEND gate pump 20
SEND gate charge 40
SEND gate feed 40
GETF gate age
ASSERT LAST_N == 6 "af a6"
GETF gate atp
ASSERT LAST_N >= 20 "af atp"
GETF gate heat
LET hbase = LAST_N
GETF gate energy
LET ebase = LAST_N
GETF gate reserve
LET rbase = LAST_N
GETF gate pmf
LET pbase = LAST_N
ASSERT pbase >= 5 "af pmf base"
GETF gate threshold
ASSERT LAST_N == 10 "af thr10"
GETF gate setpoint
ASSERT LAST_N == 10 "af sp10"
GETF gate pcr
ASSERT LAST_N == 0 "af pcr0"

SEND gate converge 3
ASSERT LAST_N == 3 "af prece3"
SEND gate extend 1
ASSERT LAST_N == 1 "af prext1"
SEND gate fold 1
ASSERT LAST_N == 1 "af prefd1"
SEND gate zip 1
ASSERT LAST_N == 1 "af prez1"
SEND gate crest 1
ASSERT LAST_N == 1 "af prec1"
SEND gate migrate 1
ASSERT LAST_N == 1 "af prem1"
SEND gate stream 1
ASSERT LAST_N == 1 "af prest1"
SEND gate condense 1
ASSERT LAST_N == 1 "af precd1"
SEND gate fate 1
ASSERT LAST_N == 1 "af pref1"
SEND gate project 1
ASSERT LAST_N == 1 "af prep1"
SEND gate synapse 1
ASSERT LAST_N == 1 "af presy1"
SEND gate release 4
ASSERT LAST_N == 4 "af prer4"
SEND gate reuptake 3
ASSERT LAST_N == 3 "af preru3"
SEND gate refill 2
ASSERT LAST_N == 2 "af prerf2"
SEND gate dock 2
ASSERT LAST_N == 2 "af predk2"
SEND gate arm 2
ASSERT LAST_N == 2 "af prear2"
SEND gate clamp 2
ASSERT LAST_N == 2 "af precl2"
SEND gate trigger 2
ASSERT LAST_N == 2 "af pretrg2"
SEND gate pore 2
ASSERT LAST_N == 2 "af prepo2"
SEND gate mix 2
ASSERT LAST_N == 2 "af premi2"
SEND gate collapse 2
ASSERT LAST_N == 2 "af preco2"
SEND gate retrieve 2
ASSERT LAST_N == 2 "af prert2"
SEND gate photosynth 16
SEND gate glycolyse 14
SEND gate photophos 16
SEND gate charge 20
SEND gate feed 20

GETF gate heat
LET h1 = LAST_N
GETF gate energy
LET e1 = LAST_N
GETF gate atp
LET at1 = LAST_N
GETF gate pmf
LET p1 = LAST_N
GETF gate age
LET ag1 = LAST_N
GETF gate reserve
LET r1 = LAST_N
GETF gate threshold
LET t1 = LAST_N
GETF gate setpoint
LET s1 = LAST_N
GETF gate pcr
LET c1 = LAST_N
ASSERT e1 >= 1 "af e primed"
ASSERT at1 >= 1 "af a primed"

SEND gate acidify 2
ASSERT LAST_N >= 0 "gate preac"
SEND gate mature 2
ASSERT LAST_N >= 0 "gate premat"
SEND gate photosynth 12
SEND gate glycolyse 10
SEND gate charge 12
SEND gate feed 12
SEND gate recruit 2
ASSERT LAST_N >= 0 "gate prerec"
SEND gate activate 2
ASSERT LAST_N >= 0 "gate prearm"
SEND gate photosynth 10
SEND gate glycolyse 8
SEND gate charge 10
SEND gate feed 10
SEND gate degrade 3
ASSERT LAST_N == 3 "gate predg3"
GETF gate pcr
ASSERT LAST_N >= 3 "gate pcr after deg"
SEND gate photosynth 10
SEND gate glycolyse 8
SEND gate charge 10
SEND gate feed 10
SEND gate export 2
ASSERT LAST_N >= 0 "gate preexp"
SEND gate photosynth 8
SEND gate glycolyse 6
SEND gate charge 8
SEND gate feed 8
SEND gate photosynth 8
SEND gate glycolyse 6
SEND gate charge 8
SEND gate feed 8
SEND gate translate 2
ASSERT LAST_N >= 0 "gate pretr"
SEND gate photosynth 10
SEND gate glycolyse 8
SEND gate charge 10
SEND gate feed 10
SEND gate translate 1
ASSERT LAST_N >= 0 "af pretl1"
SEND gate photosynth 8
SEND gate glycolyse 6
SEND gate charge 8
SEND gate feed 8
SEND gate transloc 1
ASSERT LAST_N >= 0 "af pretloc1"
SEND gate photosynth 10
SEND gate glycolyse 8
SEND gate charge 10
SEND gate feed 10
SEND gate cleave 2
ASSERT LAST_N >= 0 "gate precv"
SEND gate photosynth 10
SEND gate glycolyse 8
SEND gate charge 10
SEND gate feed 10
SEND gate glycosyl 2
ASSERT LAST_N >= 0 "gate pregy"
SEND gate photosynth 10
SEND gate glycolyse 8
SEND gate charge 10
SEND gate feed 10

GETF gate heat
LET hM = LAST_N
GETF gate energy
LET eM = LAST_N
GETF gate atp
LET aM = LAST_N
GETF gate pmf
LET pM = LAST_N
GETF gate threshold
LET tM = LAST_N
GETF gate age
LET agM = LAST_N
GETF gate reserve
LET rM = LAST_N
GETF gate setpoint
LET sM = LAST_N
GETF gate pcr
LET cM = LAST_N
SEND gate trim 2
LET tookM = LAST_N
ASSERT tookM == 2 "gate tm took"
GETF gate heat
ASSERT LAST_N == hM + tookM "gate tm heat"
GETF gate energy
ASSERT LAST_N == eM - tookM "gate tm e"
GETF gate atp
ASSERT LAST_N == aM - tookM "gate tm a"
GETF gate reserve
ASSERT LAST_N == rM "gate tm r"
GETF gate pmf
ASSERT LAST_N == pM "gate tm pmf"
GETF gate threshold
ASSERT LAST_N == tM "gate tm thr"
GETF gate age
ASSERT LAST_N == agM "gate tm age"
GETF gate setpoint
ASSERT LAST_N == sM + tookM "gate tm sp"
GETF gate pcr
ASSERT LAST_N == cM "gate tm pcr"

SEND gate photosynth 8
SEND gate glycolyse 6
SEND gate charge 8
SEND gate feed 8
SEND gate trim 0
ASSERT LAST_N == 0 "af zero"

SEND dead trim 3
ASSERT LAST_N == 0 "af dead0"

SEND poor trim 3
ASSERT LAST_N == 0 "af poor0"

