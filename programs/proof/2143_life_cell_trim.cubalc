// chain continuity: second trim still flows free energy
SEND gate photosynth 12
SEND gate glycolyse 10
SEND gate charge 12
SEND gate feed 12
GETF gate setpoint
LET s2 = LAST_N
GETF gate heat
LET h2 = LAST_N
GETF gate energy
LET e2 = LAST_N
GETF gate atp
LET a2 = LAST_N
SEND gate trim 1
LET t2 = LAST_N
ASSERT t2 == 1 "chain tm1"
GETF gate setpoint
ASSERT LAST_N == s2 + t2 "chain sp+"
GETF gate heat
ASSERT LAST_N == h2 + t2 "chain heat"
GETF gate energy
ASSERT LAST_N == e2 - t2 "chain e"
GETF gate atp
ASSERT LAST_N == a2 - t2 "chain a"
GETF gate alive
ASSERT LAST_N == 1 "chain alive"

ASSERT 1 == 1 "life_cell_trim continuum ok"
