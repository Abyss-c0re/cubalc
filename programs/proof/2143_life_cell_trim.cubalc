ASSERT LAST_N >= 0 "af twin gy"
SEND twin photosynth 8
SEND twin glycolyse 6
SEND twin charge 8
SEND twin feed 8
GETF twin heat
LET hM = LAST_N
GETF twin energy
LET eM = LAST_N
GETF twin atp
LET aM = LAST_N
GETF twin pmf
LET pM = LAST_N
GETF twin threshold
LET tM = LAST_N
GETF twin age
LET agM = LAST_N
GETF twin reserve
LET rM = LAST_N
GETF twin setpoint
LET sM = LAST_N
GETF twin pcr
LET cM = LAST_N
SEND twin trim 2
LET tookM = LAST_N
ASSERT tookM == 2 "twin tm took"
GETF twin heat
ASSERT LAST_N == hM + tookM "twin tm heat"
GETF twin energy
ASSERT LAST_N == eM - tookM "twin tm e"
GETF twin atp
ASSERT LAST_N == aM - tookM "twin tm a"
GETF twin reserve
ASSERT LAST_N == rM "twin tm r"
GETF twin pmf
ASSERT LAST_N == pM "twin tm pmf"
GETF twin threshold
ASSERT LAST_N == tM "twin tm thr"
GETF twin age
ASSERT LAST_N == agM "twin tm age"
GETF twin setpoint
ASSERT LAST_N == sM + tookM "twin tm sp"
GETF twin pcr
ASSERT LAST_N == cM "twin tm pcr"

