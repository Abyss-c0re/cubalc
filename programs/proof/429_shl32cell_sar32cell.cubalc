# Proof 429 — digit-9 cell fixed-width shift32: SHL32CELL SHR32CELL SAR32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SHL32CELL: [1,2,3] << 2 → [4,8,12]
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
SHL32CELL 0 2 2
ASSERT CELL(0) == 4
ASSERT CELL(1) == 8
ASSERT CELL(2) == 12
ASSERT LAST_N == 3

# SHL32RANGE alias: 0x80000000 << 1 → 0
CELLSET 3 2147483648
SHL32RANGE 3 3 1
ASSERT CELL(3) == 0
ASSERT LAST_N == 1

# SHR32CELL: 0x80000000 >> 1 → 0x40000000; 255 >> 4 → 15
CELLSET 4 2147483648
CELLSET 5 255
SHR32CELL 4 5 1
ASSERT CELL(4) == 1073741824
ASSERT CELL(5) == 127
ASSERT LAST_N == 2

# SHR32RANGE k>=32 → 0
CELLSET 6 255
SHR32RANGE 6 6 32
ASSERT CELL(6) == 0

# SAR32CELL: build -16 via NOTCELL ~15, >> 2 → -4
CELLSET 7 15
NOTCELL 7 7
ASSERT CELL(7) == -16
SAR32CELL 7 7 2
ASSERT CELL(7) == -4
ASSERT LAST_N == 1

# ASHR32CELL: 0x80000000 as int32 >> 31 → -1
CELLSET 8 2147483648
ASHR32CELL 8 8 31
ASSERT CELL(8) == -1
ASSERT LAST_N == 1

# range SAR identity k=0
CELLSET 9 42
CELLSET 10 99
SAR32CELL 9 10 0
ASSERT CELL(9) == 42
ASSERT CELL(10) == 99

HOLD_FLASH 0
