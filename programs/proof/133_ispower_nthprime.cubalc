# Proof 133 — digit-2 primes/powers: ISPOWER ISPRIMEPOWER NTHPRIME + stack
HOLD_FLASH 1
SCIENCE LOAD

# ISPOWER / PERFPOW
ASSERT ISPOWER(1) == 0
ASSERT ISPOWER(2) == 0
ASSERT ISPOWER(4) == 1
ASSERT PERFPOW(8) == 1
ASSERT ISPOW(9) == 1
ASSERT ISPOWER(12) == 0
ASSERT ISPOWER(16) == 1
ASSERT ISPOWER(36) == 1
ASSERT ISPOWER(32) == 1

# ISPRIMEPOWER / IPP
ASSERT ISPRIMEPOWER(1) == 0
ASSERT IPP(2) == 1
ASSERT ISPRIMEPOWER(4) == 1
ASSERT ISPRIMEPOWER(8) == 1
ASSERT ISPRIMEPOWER(9) == 1
ASSERT PRIMEPOWERP(12) == 0
ASSERT ISPRIMEPOWER(7) == 1
ASSERT ISPRIMEPOWER(6) == 0

# NTHPRIME
ASSERT NTHPRIME(1) == 2
ASSERT PRIMEN(2) == 3
ASSERT PRIMEK(3) == 5
ASSERT NTHPRIME(5) == 11
ASSERT NTHPRIME(10) == 29
ASSERT NTHPRIME(0) == 0

# stack SISPOWER
CLEARSTACK
PUSH 8
SISPOWER
ASSERT LAST_N == 1
PUSH 12
SPERFPOW
ASSERT LAST_N == 0

# stack SIPP
CLEARSTACK
PUSH 9
SIPP
ASSERT LAST_N == 1
PUSH 12
SISPRIMEPOWER
ASSERT LAST_N == 0

# stack SNTHPRIME
CLEARSTACK
PUSH 1
SNTHPRIME
ASSERT LAST_N == 2
PUSH 10
SPRIMEN
ASSERT LAST_N == 29
PUSH 5
SNPRIME
ASSERT LAST_N == 11

# soft fails
CLEARSTACK
SISPOWER
ASSERT OK == 0
SIPP
ASSERT OK == 0
SNTHPRIME
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof133_ispower_nthprime" LAST_N SP
