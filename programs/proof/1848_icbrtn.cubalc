# ICBRTN / CBRTN / IROOT3N — floor integer cube root usability form

HOLD_FLASH 1

# perfect cubes
ICBRTN 27
ASSERT LAST_N == 3
ASSERT ICBRTN_OK == 1
ASSERT ICBRTN_X == 27

ICBRTN 1000
ASSERT LAST_N == 10

ICBRTN 1
ASSERT LAST_N == 1

ICBRTN 0
ASSERT LAST_N == 0
ASSERT ICBRTN_OK == 1

ICBRTN 8
ASSERT LAST_N == 2

# non-cube floor
ICBRTN 26
ASSERT LAST_N == 2

ICBRTN 28
ASSERT LAST_N == 3

ICBRTN 999
ASSERT LAST_N == 9

ICBRTN 2
ASSERT LAST_N == 1

# negative signed floor cbrt
ICBRTN -8
ASSERT LAST_N == -2
ASSERT ICBRTN_OK == 1

ICBRTN -27
ASSERT LAST_N == -3

ICBRTN -1
ASSERT LAST_N == -1

ICBRTN -26
ASSERT LAST_N == -2

# aliases
CBRTN 64
ASSERT LAST_N == 4
IROOT3N 125
ASSERT LAST_N == 5
FLOORCBRTN 100
ASSERT LAST_N == 4
INTCBRTN 216
ASSERT LAST_N == 6
ROOT3N 50
ASSERT LAST_N == 3
CUBEROOTN 343
ASSERT LAST_N == 7

# var subject
LET vol = 1000000
ICBRTN vol
ASSERT LAST_N == 100

# pipeline after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--volume=32768"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN volume OR 0
ICBRTN LAST_N
ASSERT LAST_N == 32

# larger
ICBRTN 1000000000
ASSERT LAST_N == 1000

PRINT "icbrtn ok"
