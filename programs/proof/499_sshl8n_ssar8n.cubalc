# Proof 499 — digit-0 stack imm 8-bit field shift: SSHL8N SSHR8N SSAR8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSHL8N: 1<<2=4
PUSH 0x1
SSHL8N 2 0
POP x
ASSERT x == 4

# overflow: 0x80 << 1 → 0; preserve high
CLEARSTACK
PUSH 0x1122334455667780
SSHL8N 1 0
POP x
ASSERT x == 0x1122334455667700

# k>=8 → 0
CLEARSTACK
PUSH 0xFF
SHL8N 8 0
POP x
ASSERT x == 0

# STACKSHL8N n1: byte1 of 0x0301 is 03 <<1 → 06 → 0x0601
CLEARSTACK
PUSH 0x0301
STACKSHL8N 1 1
POP x
ASSERT x == 0x0601

# SSHR8N logical: 0x80>>1=0x40 ; 0xFF>>2=0x3F
CLEARSTACK
PUSH 0x80
SSHR8N 1 0
POP x
ASSERT x == 64

CLEARSTACK
PUSH 0xFF
SHR8N 2 0
POP x
ASSERT x == 63

# high preserved shr
CLEARSTACK
PUSH 0x11223344556677FC
SSHR8N 2 0
POP x
ASSERT x == 0x112233445566773F

# STACKSHR8N n1: 0x8000 byte1=80>>1=40 → 0x4000
CLEARSTACK
PUSH 0x8000
STACKSHR8N 1 1
POP x
ASSERT x == 0x4000

# SSAR8N: 0xFE (-2)>>1 → 0xFF ; 0x80 (-128)>>1 → 0xC0
CLEARSTACK
PUSH 0xFE
SSAR8N 1 0
POP x
ASSERT x == 255

CLEARSTACK
PUSH 0x80
SAR8N 1 0
POP x
ASSERT x == 192

# k>=8 all sign: neg → FF, pos → 0
CLEARSTACK
PUSH 0x80
SSAR8N 8 0
POP x
ASSERT x == 255

CLEARSTACK
PUSH 0x7F
SSAR8N 8 0
POP x
ASSERT x == 0

# positive SAR: 0x06>>1=3
CLEARSTACK
PUSH 0x06
SSAR8N 1 0
POP x
ASSERT x == 3

# high preserved SAR byte1: 0x..FE00 byte1=FE → FF
CLEARSTACK
PUSH 0x112233445566FE00
STACKSAR8N 1 1
POP x
ASSERT x == 0x112233445566FF00

# aliases
CLEARSTACK
PUSH 0x03
SLSH8N 1 0
POP x
ASSERT x == 6

CLEARSTACK
PUSH 0xFE
SASHR8N 1 0
POP x
ASSERT x == 255

CLEARSTACK
PUSH 0x40
SSHLBYTEN 1 0
POP x
ASSERT x == 128

HOLD_FLASH 0
