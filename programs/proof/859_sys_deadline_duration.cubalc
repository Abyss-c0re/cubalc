# SYS DEADLINE / ADDTIME human duration — lease offsets without PARSEMS+MS2SEC glue
# Usability: DEADLINE "5m" / "30s" / "1h30m" · ADDTIME epoch "1m" · DEADLINE_SECS

HOLD_FLASH 1

# DEADLINE "30s" ≈ now + 30
SYS TIME
LET t0 = LAST_N
SYS DEADLINE "30s"
ASSERT OK == 1
ASSERT LAST_N >= t0 + 29
ASSERT LAST_N <= t0 + 31
ASSERT DEADLINE_N == LAST_N
ASSERT DEADLINE_SECS == 30
ASSERT LEASE_SECS == 30

# minutes
SYS TIME
LET t1 = LAST_N
SYS DEADLINE "1m"
ASSERT OK == 1
ASSERT LAST_N >= t1 + 59
ASSERT LAST_N <= t1 + 61
ASSERT DEADLINE_SECS == 60

# compound hour+minute → seconds
SYS TIME
LET t2 = LAST_N
SYS DEADLINE "1h30m"
ASSERT OK == 1
ASSERT LAST_N >= t2 + 5399
ASSERT LAST_N <= t2 + 5401
ASSERT DEADLINE_SECS == 5400

# string var
LET LEASE = "45s"
SYS TIME
LET t3 = LAST_N
SYS DEADLINE LEASE
ASSERT OK == 1
ASSERT LAST_N >= t3 + 44
ASSERT LAST_N <= t3 + 46
ASSERT DEADLINE_SECS == 45

# EXPIRESAT alias
SYS TIME
LET t4 = LAST_N
SYS EXPIRESAT "10s"
ASSERT OK == 1
ASSERT LAST_N >= t4 + 9
ASSERT LAST_N <= t4 + 11

# numeric path still seconds
SYS TIME
LET t5 = LAST_N
SYS DEADLINE 20
ASSERT OK == 1
ASSERT LAST_N >= t5 + 19
ASSERT LAST_N <= t5 + 21
ASSERT DEADLINE_SECS == 20

# ADDTIME epoch + duration offset
SYS ADDTIME 1000000 "5s"
ASSERT OK == 1
ASSERT LAST_N == 1000005
ASSERT ADDTIME_N == 1000005

SYS ADDTIME 1000 "1m"
ASSERT OK == 1
ASSERT LAST_N == 1060

# one-arg ADDTIME duration adds to prior LAST_N
SYS ADDTIME 2000 0
ASSERT LAST_N == 2000
SYS ADDTIME "10s"
ASSERT OK == 1
ASSERT LAST_N == 2010

# lease IF: DEADLINE "2m" not yet expired, REMAINING ~120
SYS DEADLINE "2m"
LET due = LAST_N
SYS EXPIRED due
ASSERT LAST_N == 0
SYS REMAINING due
ASSERT LAST_N >= 110
ASSERT LAST_N <= 120

# soft-fail bad duration
SYS DEADLINE "nope"
ASSERT OK == 0
ASSERT LAST_N == 0

SYS ADDTIME 1000 "bad"
ASSERT OK == 0

PRINT "sys_deadline_duration ok"
