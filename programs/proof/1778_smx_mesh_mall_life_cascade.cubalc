LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1
  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2

ASSERT births >= 1 "mitosis life cascade on stable mesh"
ASSERT pop >= 2 "population after life cascade"
ASSERT ENERGY > 0 "energy after life cascade"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky through mitosis"
ASSERT SMX_RESILIENT == 1 "resilient sticky through mitosis"
ASSERT SMX_HOMEOSTATIC == 1 "homeostatic sticky through mitosis"
ASSERT SMX_IONOSPHERED == 1 "ionosphered sticky through mitosis"
ASSERT SMX_THERMOSPHERED == 1 "thermosphered sticky through mitosis"
ASSERT SMX_EXOSPHERED == 1 "exosphered sticky through mitosis"
ASSERT SMX_HELIOSPHERED == 1 "heliosphered sticky through mitosis"
ASSERT SMX_LOCALBUBBLED == 1 "localbubbled sticky through mitosis"
ASSERT SMX_LOCALGROUPED == 1 "localgrouped sticky through mitosis"
ASSERT SMX_MULTIVERSED == 1 "multiversed sticky through mitosis"
ASSERT SMX_OMNIVERSED == 1 "omniversed sticky through mitosis"
