# Proof 419 — digit-3 dual-stack signed clip: DCLIPS4 DCLIPS8 DCLIPS16
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# DCLIPS4: 20,-20 → under=7 TOS=-8
PUSH 20
PUSH 0
PUSH 20
SUB
DCLIPS4
ASSERT LAST_N == -8
SWAP
ASSERT LAST_N == 7
POP
POP

# 2CLIPS4 mid: 3, -3 stay
CLEARSTACK
PUSH 3
PUSH 0
PUSH 3
SUB
2CLIPS4
ASSERT LAST_N == -3
SWAP
ASSERT LAST_N == 3
POP
POP

# DCLIPS8: 200,-200 → 127,-128
CLEARSTACK
PUSH 200
PUSH 0
PUSH 200
SUB
DCLIPS8
ASSERT LAST_N == -128
SWAP
ASSERT LAST_N == 127
POP
POP

# PAIRCLIPS8 mid: 50,-50 stay
CLEARSTACK
PUSH 50
PUSH 0
PUSH 50
SUB
PAIRCLIPS8
ASSERT LAST_N == -50
SWAP
ASSERT LAST_N == 50
POP
POP

# DCLIPS16: 40000,-40000 → 32767,-32768
CLEARSTACK
PUSH 40000
PUSH 0
PUSH 40000
SUB
DCLIPS16
ASSERT LAST_N == -32768
SWAP
ASSERT LAST_N == 32767
POP
POP

# 2CLIPS16 mid: 100,-100 stay
CLEARSTACK
PUSH 100
PUSH 0
PUSH 100
SUB
2CLIPS16
ASSERT LAST_N == -100
SWAP
ASSERT LAST_N == 100
POP
POP

# soft short stack OK=0
CLEARSTACK
DCLIPS4
ASSERT OK == 0

CLEARSTACK
PUSH 1
DCLIPS8
ASSERT OK == 0

CLEARSTACK
DCLIPS16
ASSERT OK == 0

HOLD_FLASH 0
