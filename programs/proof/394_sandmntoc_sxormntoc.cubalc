# Proof 394 — digit-5 stack dual low-n mask TOC: SANDMNTOC SORMNTOC SXORMNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDMNTOC: keep low 4 of 255 → 15
CELLSET 1 255
PUSH 1
PUSH 4
SANDMNTOC
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP a
ASSERT a == 15

# ANDMNTOC n=0 → 0
CELLSET 2 99
PUSH 2
PUSH 0
ANDMNTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SORMNTOC: set low 3 of 0 → 7
CELLSET 3 0
PUSH 3
PUSH 3
SORMNTOC
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# ORMNTOC: 8 | low-2 = 11
CELLSET 4 8
PUSH 4
PUSH 2
ORMNTOC
ASSERT LAST_N == 11
ASSERT CELL(4) == 11
POP

# SXORMNTOC: 0 ^ low-4 = 15; again → 0
CELLSET 5 0
PUSH 5
PUSH 4
SXORMNTOC
ASSERT LAST_N == 15
ASSERT CELL(5) == 15
POP
PUSH 5
PUSH 4
XORMNTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft short stack OK=0
CLEARSTACK
SANDMNTOC
ASSERT OK == 0
PUSH 1
SORMNTOC
ASSERT OK == 0

PRINT "394_sandmntoc_sxormntoc OK"
