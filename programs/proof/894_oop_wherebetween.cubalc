# WHEREBETWEEN / COUNTBETWEEN / HASBETWEEN — closed-range fleet query
# Usability: lo <= field <= hi band without dual WHEREGE+WHERELE glue

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 10 0
NEW Cell b 1 0 0
NEW Cell c 1 30 0
NEW Cell d 1 5 0
NEW Cell e 1 20 0

CLASS Counter
  FIELD n 0
  METHOD init x
    SETF THIS n x
  END
END
NEW Counter k1 3
NEW Counter k2 50
NEW Counter k3 15
NEW Counter k4 25

# bag: energy in [5, 20] → a(10) d(5) e(20)
WHEREBETWEEN Cell energy 5 20
ASSERT OK == 1
ASSERT WHEREBETWEEN_N == 3
ASSERT LAST_N == 3
ASSERT WHEREBETWEEN_LO == 5
ASSERT WHEREBETWEEN_HI == 20
SYS HASLINE WHEREBETWEEN "a"
ASSERT LAST_N == 1
SYS HASLINE WHEREBETWEEN "d"
ASSERT LAST_N == 1
SYS HASLINE WHEREBETWEEN "e"
ASSERT LAST_N == 1
SYS HASLINE WHEREBETWEEN "b"
ASSERT LAST_N == 0
SYS HASLINE WHEREBETWEEN "c"
ASSERT LAST_N == 0

# TO sugar + swap when lo>hi
WHEREBETWEEN Cell energy 20 TO 5
ASSERT WHEREBETWEEN_N == 3
ASSERT WHEREBETWEEN_LO == 5
ASSERT WHEREBETWEEN_HI == 20

# WHERERANGE alias
WHERERANGE Cell energy 10 30
ASSERT WHERERANGE_N == 3 "a e c"

# OF sugar
WHEREBETWEEN OF Counter n 10 30
ASSERT WHEREBETWEEN_N == 2 "k3 k4"
SYS HASLINE WHEREBETWEEN "k3"
ASSERT LAST_N == 1
SYS HASLINE WHEREBETWEEN "k4"
ASSERT LAST_N == 1

# bare field
WHEREBETWEEN n 0 10
ASSERT WHEREBETWEEN_N == 1 "k1 only"
SYS HASLINE LAST "k1"
ASSERT LAST_N == 1

# empty soft
WHEREBETWEEN Cell energy 100 200
ASSERT OK == 1
ASSERT WHEREBETWEEN_N == 0

# COUNTBETWEEN — tally no bag
COUNTBETWEEN Cell energy 5 20
ASSERT OK == 1
ASSERT COUNTBETWEEN_N == 3
ASSERT LAST_N == 3
ASSERT LAST == "3"

COUNTBAND OF Counter n 15 50
ASSERT COUNTBAND_N == 3 "k2 k3 k4"

# HASBETWEEN — soft 0|1 + first name
HASBETWEEN Cell energy 25 35
ASSERT OK == 1
ASSERT HASBETWEEN_N == 1
ASSERT LAST_N == 1
ASSERT LAST == "c"

ANYBETWEEN Cell energy 100 200
ASSERT OK == 1
ASSERT ANYBETWEEN_N == 0
ASSERT LAST_N == 0

# note: free-standing INRANGE is numeric (996); OOP soft probe is HASBETWEEN
HASBETWEEN Counter n 40 60
ASSERT HASBETWEEN_N == 1
ASSERT LAST == "k2"

# inclusive edges
WHEREBETWEEN Cell energy 0 0
ASSERT WHEREBETWEEN_N == 1 "b"
SYS HASLINE LAST "b"
ASSERT LAST_N == 1

WHEREBETWEEN Cell energy 30 30
ASSERT WHEREBETWEEN_N == 1
SYS HASLINE LAST "c"
ASSERT LAST_N == 1

PRINT "oop_wherebetween ok"
