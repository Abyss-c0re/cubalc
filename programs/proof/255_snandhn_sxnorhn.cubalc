# Proof 255 — digit-3 stack inverted high-n mask: SNANDHN SNORHN SXNORHN
HOLD_FLASH 1
SCIENCE LOAD

# SNANDHN — ~(TOS & high-n mask)
CLEARSTACK
PUSH -1
SNANDHN 8
POP x
# ~(-1 & 0xFF00..00) = 0x00FF..FF
ASSERT x == 0x00FFFFFFFFFFFFFF

CLEARSTACK
PUSH 0xFF00000000000000
STACKNANDHN 16
POP x
ASSERT x == 0x00FFFFFFFFFFFFFF

# NANDHN n=0 → ~0 = -1
CLEARSTACK
PUSH 5
NANDHN 0
POP x
ASSERT x == -1

# SNORHN — ~(TOS | high-n mask)
CLEARSTACK
PUSH 0
SNORHN 8
POP x
# ~(0 | hm8) = 0x00FF..FF
ASSERT x == 0x00FFFFFFFFFFFFFF

CLEARSTACK
PUSH 1
STACKNORHN 8
POP x
ASSERT x == 0x00FFFFFFFFFFFFFE

# NORHN on full lows
CLEARSTACK
PUSH 0x0000FFFFFFFFFFFF
NORHN 16
POP x
ASSERT x == 0

# SXNORHN — ~(TOS ^ high-n mask)
CLEARSTACK
PUSH 0
SXNORHN 8
POP x
# ~(0 ^ hm8) = ~hm8 = 0x00FF..FF
ASSERT x == 0x00FFFFFFFFFFFFFF

CLEARSTACK
PUSH -1
STACKXNORHN 8
POP x
# ~(-1 ^ hm8) = ~(~hm8) = hm8
ASSERT x == 0xFF00000000000000

# XNORHN / EQUIVHN alias
CLEARSTACK
PUSH 0
XNORHN 16
POP x
ASSERT x == 0x0000FFFFFFFFFFFF

CLEARSTACK
PUSH 0xFF00000000000000
EQUIVHN 8
POP x
# ~(0xFF00.. ^ 0xFF00..) = ~0 = -1
ASSERT x == -1

# soft fails
CLEARSTACK
SNANDHN 4
ASSERT OK == 0
CLEARSTACK
SNORHN 4
ASSERT OK == 0
CLEARSTACK
SXNORHN 4
ASSERT OK == 0

HOLD_FLASH 1
