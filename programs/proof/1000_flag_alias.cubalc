# Flag name aliases — short flags without dual HASFLAG glue
# GETFLAGN workers|w OR 4 · BOOLFLAG verbose|v · GETFLAG out|o

HOLD_FLASH 1

# --- short -w hits workers|w ---
SYS ENV SET CUBALC_ARG0 "-w"
SYS ENV SET CUBALC_ARG1 "8"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGN workers|w|jobs OR 4
ASSERT LAST_N == 8
ASSERT GETFLAGN_HIT == 1
SYS EQS FLAG_HIT_NAME "w"
ASSERT LAST_N == 1

# long --workers preferred when present first in scan order of aliases
SYS ENV SET CUBALC_ARG0 "--workers=16"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN workers|w OR 4
ASSERT LAST_N == 16
SYS EQS FLAG_HIT_NAME "workers"
ASSERT LAST_N == 1

# comma aliases + default when miss
SYS ENV SET CUBALC_ARG0 "--other=1"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN workers, w, jobs OR 4
ASSERT LAST_N == 4
ASSERT GETFLAGN_HIT == 0
SYS EMPTY FLAG_HIT_NAME
ASSERT LAST_N == 1

# BOOLFLAG short -v
SYS ENV SET CUBALC_ARG0 "-v"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG verbose|v
ASSERT LAST_N == 1
ASSERT BOOLFLAG_HIT == 1
SYS EQS FLAG_HIT_NAME "v"
ASSERT LAST_N == 1

# BOOLFLAG long false still hit presence with truthy 0
SYS ENV SET CUBALC_ARG0 "--verbose=false"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG verbose|v
ASSERT LAST_N == 0
ASSERT BOOLFLAG_HIT == 1
SYS EQS FLAG_HIT_NAME "verbose"
ASSERT LAST_N == 1

# GETFLAG out|o short -o path
SYS ENV SET CUBALC_ARG0 "-o"
SYS ENV SET CUBALC_ARG1 "plate.json"
SYS ENV SET CUBALC_ARGC "2"
GETFLAG out|o OR "-"
SYS EQS LAST "plate.json"
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "o"
ASSERT LAST_N == 1

# HASFLAG force|f
SYS ENV SET CUBALC_ARG0 "--force"
SYS ENV SET CUBALC_ARGC "1"
HASFLAG force|f
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "force"
ASSERT LAST_N == 1

SYS ENV SET CUBALC_ARG0 "-f"
SYS ENV SET CUBALC_ARGC "1"
HASFLAG force|f
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "f"
ASSERT LAST_N == 1

# GETFLAGMS timeout|t
SYS ENV SET CUBALC_ARG0 "-t"
SYS ENV SET CUBALC_ARG1 "5s"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGMS timeout|t OR "30s"
ASSERT LAST_N == 5000
ASSERT GETFLAGMS_HIT == 1
SYS EQS FLAG_HIT_NAME "t"
ASSERT LAST_N == 1

# REQUIRE FLAG config|c
SYS ENV SET CUBALC_ARG0 "-c"
SYS ENV SET CUBALC_ARG1 "cfg.ini"
SYS ENV SET CUBALC_ARGC "2"
REQUIRE FLAG config|c
SYS EQS LAST "cfg.ini"
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "c"
ASSERT LAST_N == 1

# single-name still works (reg)
SYS ENV SET CUBALC_ARG0 "--port=9000"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN port OR 8080
ASSERT LAST_N == 9000
SYS EQS FLAG_HIT_NAME "port"
ASSERT LAST_N == 1

PRINT "flag_alias ok"
