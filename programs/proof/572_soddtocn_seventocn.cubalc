# Proof 572 — digit-1 pure-imm cell parity TOC: SODDTOCN SEVENTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SODDTOCN: odd → 1
CELLSET 1 3
SODDTOCN 1
POP x
ASSERT x == 1
ASSERT CELL(1) == 1

# even → 0
CLEARSTACK
CELLSET 2 4
SISODDTOCN 2
POP x
ASSERT x == 0
ASSERT CELL(2) == 0

# zero even → 0
CLEARSTACK
CELLSET 3 0
ODDTOCN 3
POP x
ASSERT x == 0
ASSERT CELL(3) == 0

# SODDATN / SCELLODDN
CLEARSTACK
CELLSET 4 7
SODDATN 4
POP x
ASSERT x == 1
ASSERT CELL(4) == 1

CLEARSTACK
CELLSET 5 8
SCELLODDN 5
POP x
ASSERT x == 0
ASSERT CELL(5) == 0

# SEVENTOCN: even → 1
CLEARSTACK
CELLSET 6 2
SEVENTOCN 6
POP x
ASSERT x == 1
ASSERT CELL(6) == 1

# odd → 0
CLEARSTACK
CELLSET 7 9
SISEVENTOCN 7
POP x
ASSERT x == 0
ASSERT CELL(7) == 0

# zero even → 1
CLEARSTACK
CELLSET 8 0
EVENTOCN 8
POP x
ASSERT x == 1
ASSERT CELL(8) == 1

# SEVENATN / SCELLEVENN
CLEARSTACK
CELLSET 9 10
SEVENATN 9
POP x
ASSERT x == 1
ASSERT CELL(9) == 1

CLEARSTACK
CELLSET 10 11
SCELLEVENN 10
POP x
ASSERT x == 0
ASSERT CELL(10) == 0

# SPARITY1TOCN / SPARITY0TOCN
CLEARSTACK
CELLSET 11 1
SPARITY1TOCN 11
POP x
ASSERT x == 1
ASSERT CELL(11) == 1

CLEARSTACK
CELLSET 12 6
SPARITY0TOCN 12
POP x
ASSERT x == 1
ASSERT CELL(12) == 1

HOLD_FLASH 0
