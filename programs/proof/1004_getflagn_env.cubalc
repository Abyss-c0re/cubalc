# GETFLAGN OR ENV — CLI flag > environment > literal default

HOLD_FLASH 1

# clear args
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"

# pure default (no env)
SYS ENV UNSET WORKERS
SYS ENV UNSET CUBALC_WORKERS
GETFLAGN workers|w OR ENV WORKERS OR 4
ASSERT LAST_N == 4
ASSERT GETFLAGN_HIT == 0
SYS EQS GETFLAGN_SRC "default"
ASSERT LAST_N == 1

# env fills when no CLI
SYS ENV SET WORKERS "12"
GETFLAGN workers|w OR ENV WORKERS OR 4
ASSERT LAST_N == 12
ASSERT GETFLAGN_HIT == 0
SYS EQS GETFLAGN_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "WORKERS"
ASSERT LAST_N == 1

# first non-empty ENV wins among chain
SYS ENV UNSET WORKERS
SYS ENV SET CUBALC_WORKERS "7"
GETFLAGN workers OR ENV WORKERS OR ENV CUBALC_WORKERS OR 4
ASSERT LAST_N == 7
SYS EQS GETFLAGN_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "CUBALC_WORKERS"
ASSERT LAST_N == 1

# CLI beats env
SYS ENV SET WORKERS "99"
SYS ENV SET CUBALC_ARG0 "--workers=3"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN workers|w OR ENV WORKERS OR 4
ASSERT LAST_N == 3
ASSERT GETFLAGN_HIT == 1
SYS EQS GETFLAGN_SRC "cli"
ASSERT LAST_N == 1
SYS EMPTY FLAG_ENV
ASSERT LAST_N == 1

# short -w still wins over env
SYS ENV SET WORKERS "50"
SYS ENV SET CUBALC_ARG0 "-w"
SYS ENV SET CUBALC_ARG1 "8"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGN workers|w OR ENV WORKERS OR 4
ASSERT LAST_N == 8
SYS EQS GETFLAGN_SRC "cli"
ASSERT LAST_N == 1

# empty env falls through to next / default
SYS ENV SET WORKERS ""
SYS ENV UNSET CUBALC_WORKERS
SYS ENV SET CUBALC_ARGC "0"
GETFLAGN workers OR ENV WORKERS OR ENV CUBALC_WORKERS OR 4
ASSERT LAST_N == 4
SYS EQS GETFLAGN_SRC "default"
ASSERT LAST_N == 1

# reg: plain OR still works
GETFLAGN port OR 8080
ASSERT LAST_N == 8080
SYS EQS GETFLAGN_SRC "default"
ASSERT LAST_N == 1

PRINT "getflagn_env ok"
