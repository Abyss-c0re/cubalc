# Proof 402 — digit-7 stack dual LE halfword field TOC: SWORDTOC SSET16TOC SCLR16TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSET16TOC: build 0x00020001 = 131073
CELLSET 1 0
PUSH 1
PUSH 1
PUSH 0
SSET16TOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
PUSH 2
PUSH 1
SSET16TOC
ASSERT LAST_N == 131073
ASSERT CELL(1) == 131073
POP

# SWORDTOC extract halfword 1 → 2
CELLSET 2 131073
PUSH 2
PUSH 1
SWORDTOC
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# WORDTOC alias: halfword 0 of 0x12345678 = 305419896 → 0x5678 = 22136
CELLSET 3 305419896
PUSH 3
PUSH 0
WORDTOC
ASSERT LAST_N == 22136
ASSERT CELL(3) == 22136
POP

# SCLR16TOC clear halfword 0 of 0x00010002 = 65538 → 0x00010000 = 65536
CELLSET 4 65538
PUSH 4
PUSH 0
SCLR16TOC
ASSERT LAST_N == 65536
ASSERT CELL(4) == 65536
POP

# CLR16TOC clear halfword 1 then extract is 0
CELLSET 5 131073
PUSH 5
PUSH 1
CLR16TOC
POP
PUSH 5
PUSH 1
SWORDTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft short stack OK=0
CLEARSTACK
SWORDTOC
ASSERT OK == 0
PUSH 1
SSET16TOC
ASSERT OK == 0

PRINT "402_swordtoc_sclr16toc OK"
