# SYS WRITEENV / SAVENV / DUMPENVFILE — persist process env as KEY=VAL plate
# Usability: agent config handoff without shell env > file; round-trip DOTENV

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS JOIN td "writeenv_mi.env"
LET p = LAST

# plant known keys
SYS SETENV "CUBALC_WRITEENV_MI_A" "alpha"
ASSERT OK == 1
SYS SETENV "CUBALC_WRITEENV_MI_B" "beta gamma"
ASSERT OK == 1
SYS SETENV "CUBALC_WRITEENV_MI_C" "3"
ASSERT OK == 1

# write prefix-filtered plate
SYS WRITEENV p "CUBALC_WRITEENV_MI_"
ASSERT OK == 1
ASSERT LAST_N == 3
ASSERT WRITEENV_N == 3
ASSERT WRITEENV_BYTES > 10
SYS EQS LAST p
ASSERT LAST_N == 1
SYS EQS WRITEENV_PATH p
ASSERT LAST_N == 1
SYS EQS WRITEENV_PREFIX "CUBALC_WRITEENV_MI_"
ASSERT LAST_N == 1

# plate content
SYS READ p
SYS HASLINE LAST "CUBALC_WRITEENV_MI_A=alpha"
ASSERT LAST_N == 1
SYS READ p
SYS HASLINE LAST "CUBALC_WRITEENV_MI_B=beta gamma"
ASSERT LAST_N == 1
SYS READ p
SYS HASLINE LAST "CUBALC_WRITEENV_MI_C=3"
ASSERT LAST_N == 1
SYS READ p
SYS LINES LAST
ASSERT LAST_N == 3

# round-trip: clear keys, DOTENV reload
SYS UNSETENV "CUBALC_WRITEENV_MI_A"
SYS UNSETENV "CUBALC_WRITEENV_MI_B"
SYS UNSETENV "CUBALC_WRITEENV_MI_C"
SYS ENV "CUBALC_WRITEENV_MI_A" OR ""
SYS EMPTY LAST
ASSERT LAST_N == 1

SYS DOTENV p
ASSERT OK == 1
ASSERT DOTENV_N == 3
SYS ENV "CUBALC_WRITEENV_MI_A"
SYS EQS LAST "alpha"
ASSERT LAST_N == 1
SYS ENV "CUBALC_WRITEENV_MI_B"
SYS EQS LAST "beta gamma"
ASSERT LAST_N == 1

# aliases
SYS SAVENV p "CUBALC_WRITEENV_MI_"
ASSERT OK == 1
ASSERT SAVENV_N == 3
SYS DUMPENVFILE p "CUBALC_WRITEENV_MI_"
ASSERT OK == 1
ASSERT DUMPENVFILE_N == 3

# soft miss empty path
SYS WRITEENV ""
ASSERT OK == 0
ASSERT LAST_N == 0
SYS LEN LAST_ERR
ASSERT LAST_N >= 5

# empty match still writes empty plate (ok)
SYS JOIN td "writeenv_mi_empty.env"
LET pe = LAST
SYS WRITEENV pe "CUBALC_WRITEENV_NO_SUCH_ZZZ_"
ASSERT OK == 1
ASSERT LAST_N == 0
SYS SIZE pe
ASSERT LAST_N == 0

# cleanup
SYS UNSETENV "CUBALC_WRITEENV_MI_A"
SYS UNSETENV "CUBALC_WRITEENV_MI_B"
SYS UNSETENV "CUBALC_WRITEENV_MI_C"
SYS RM p
SYS RM pe

PRINT "sys_writeenv ok"
