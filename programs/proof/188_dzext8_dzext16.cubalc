# Proof 188 — digit-9 dual-stack data-path: DZEXT8 DZEXT16
HOLD_FLASH 1
SCIENCE LOAD

# DZEXT8: mask low 8
CLEARSTACK
PUSH 300
PUSH 511
DZEXT8
POP y
POP x
ASSERT x == 44
ASSERT y == 255

# 2ZEXT8 negative pattern → low 8
CLEARSTACK
PUSH -1
PUSH -2
2ZEXT8
POP y
POP x
ASSERT x == 255
ASSERT y == 254

# PAIRZEXT8 / DZEXTB
CLEARSTACK
PUSH 0
PUSH 256
PAIRZEXT8
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 128
PUSH 127
DZEXTB
POP y
POP x
ASSERT x == 128
ASSERT y == 127

# DZEXT16
CLEARSTACK
PUSH 70000
PUSH 65535
DZEXT16
POP y
POP x
ASSERT x == 4464
ASSERT y == 65535

# 2ZEXT16
CLEARSTACK
PUSH -1
PUSH 65536
2ZEXT16
POP y
POP x
ASSERT x == 65535
ASSERT y == 0

# PAIRZEXT16 / DZEXTW
CLEARSTACK
PUSH 0x12345678
PUSH 0xABCD
PAIRZEXT16
POP y
POP x
ASSERT x == 0x5678
ASSERT y == 0xABCD

CLEARSTACK
PUSH 0xFFFF0001
PUSH 1
DZEXTW
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# S2ZEXT8 / STACK2ZEXT16 aliases
CLEARSTACK
PUSH 0x1FF
PUSH 0x100
S2ZEXT8
POP y
POP x
ASSERT x == 255
ASSERT y == 0

CLEARSTACK
PUSH 0x1FFFF
PUSH 0x10000
STACK2ZEXT16
POP y
POP x
ASSERT x == 65535
ASSERT y == 0

# contrast with DSEXT8 (sign vs zero)
CLEARSTACK
PUSH 0x80
PUSH 0x80
DSEXT8
POP y
POP x
ASSERT x == -128
ASSERT y == -128
CLEARSTACK
PUSH 0x80
PUSH 0x80
DZEXT8
POP y
POP x
ASSERT x == 128
ASSERT y == 128

# soft fail underflow
CLEARSTACK
PUSH 1
DZEXT8
ASSERT OK == 0
CLEARSTACK
DZEXT16
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof188_dzext8_dzext16" LAST_N SP
