# Proof 370 — digit-4 stack↔cell modular accumulate TOC: SADDMODTOC SSUBMODTOC SMULMODTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SADDMODTOC: (10+7) mod 12 = 5
CELLSET 1 10
PUSH 1
PUSH 7
PUSH 12
SADDMODTOC
ASSERT LAST_N == 5
ASSERT CELL(1) == 5
POP a
ASSERT a == 5

# ADDMODTOC: (11+1) mod 10 = 2
CELLSET 2 11
PUSH 2
PUSH 1
PUSH 10
ADDMODTOC
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# soft m<=0 → 0
CELLSET 3 9
PUSH 3
PUSH 1
PUSH 0
SADDMODTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SSUBMODTOC: (3-5) mod 12 = 10
CELLSET 4 3
PUSH 4
PUSH 5
PUSH 12
SSUBMODTOC
ASSERT LAST_N == 10
ASSERT CELL(4) == 10
POP

# SUBMODTOC: (0-1) mod 7 = 6
CELLSET 5 0
PUSH 5
PUSH 1
PUSH 7
SUBMODTOC
ASSERT LAST_N == 6
ASSERT CELL(5) == 6
POP

# SMULMODTOC: (7*8) mod 11 = 1
CELLSET 6 7
PUSH 6
PUSH 8
PUSH 11
SMULMODTOC
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# MULMODTOC: (6*7) mod 13 = 3
CELLSET 7 6
PUSH 7
PUSH 7
PUSH 13
MULMODTOC
ASSERT LAST_N == 3
ASSERT CELL(7) == 3
POP

# SACCUMMODTOC: (5+5) mod 7 = 3
CELLSET 8 5
PUSH 8
PUSH 5
PUSH 7
SACCUMMODTOC
ASSERT LAST_N == 3
ASSERT CELL(8) == 3
POP

# soft shallow OK=0
CLEARSTACK
PUSH 1
PUSH 2
SADDMODTOC
ASSERT OK == 0

PRINT "370_saddmodtoc_smulmodtoc OK"
