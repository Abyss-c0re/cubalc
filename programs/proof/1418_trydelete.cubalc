# TRYDELETE / DELETEOBJ SOFT — explicit soft free with TRYDELETE_N

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 10 0
NEW Cell b 1 5 0
NEW Cell c 1 3 0

# hard DELETEOBJ still works
DELETEOBJ a
ASSERT OK == 1
ASSERT DELETEOBJ_N == 1
HASOBJ a
ASSERT LAST_N == 0

# TRYDELETE success
TRYDELETE b
ASSERT OK == 1
ASSERT TRYDELETE_N == 1
ASSERT DELETEOBJ_N == 1
HASOBJ b
ASSERT LAST_N == 0

# soft miss
TRYDELETE missing_zz
ASSERT OK == 0
ASSERT TRYDELETE_N == 0
SYS HASI LAST_ERR "unknown"
ASSERT LAST_N == 1
CLEAR_ERR

# DELETEOBJ SOFT keyword success
DELETEOBJ SOFT c
ASSERT OK == 1
ASSERT TRYDELETE_N == 1
HASOBJ c
ASSERT LAST_N == 0

# SOFTDELETE alias miss
SOFTDELETE ghost
ASSERT OK == 0
CLEAR_ERR

# recreate and FREE SOFT? FREEOBJ SOFT via soft_try path — FREEOBJ SOFT name
NEW Cell d 1 1 0
FREEOBJ SOFT d
ASSERT OK == 1
HASOBJ d
ASSERT LAST_N == 0

# hard DELETEOBJ miss remains soft (historical)
DELETEOBJ missing2
ASSERT OK == 0

HASFORM "TRYDELETE"
ASSERT LAST_N == 1
HASFORM "DELETEOBJ"
ASSERT LAST_N == 1

PRINT "1418_trydelete ok"
PASS
