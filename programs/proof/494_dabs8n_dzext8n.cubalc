# Proof 494 — digit-5 dual-stack imm 8-bit field abs+extend: DABS8N DSEXT8N DZEXT8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DABS8N: 0xFE (-2)→2 ; 0x05→5
PUSH 0xFE
PUSH 0x05
DABS8N 0
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# min int8 -128 stays 0x80
CLEARSTACK
PUSH 0x80
PUSH 0x80
PAIRABS8N 0
POP y
POP x
ASSERT x == 128
ASSERT y == 128

# high preserved abs
CLEARSTACK
PUSH 0x11223344556677FE
PUSH 0x99AABBCCDDEEFFFD
DABS8N 0
POP y
POP x
ASSERT x == 0x1122334455667702
ASSERT y == 0x99AABBCCDDEEFF03

# S2ABS8N n1: 0xD000 byte1=D0=-48 → abs 48 → 0x3000
CLEARSTACK
PUSH 0xD000
PUSH 0xE000
S2ABS8N 1
POP y
POP x
ASSERT x == 0x3000
ASSERT y == 0x2000

# DSEXT8N: 0x7F→127 ; 0xFE→-2 ; 0x80→-128
CLEARSTACK
PUSH 0x7F
PUSH 0xFE
DSEXT8N 0
POP y
POP x
ASSERT x == 127
ASSERT y == -2

CLEARSTACK
PUSH 0x80
PUSH 0x0
PAIRSEXT8N 0
POP y
POP x
ASSERT x == -128
ASSERT y == 0

# S2SEXT8N n1: 0xA000 byte1=A0=-96
CLEARSTACK
PUSH 0xA000
PUSH 0xC000
S2SEXT8N 1
POP y
POP x
ASSERT x == -96
ASSERT y == -64

# high ignored: 0x1FF → -1
CLEARSTACK
PUSH 0x1FF
PUSH 0xFF
DSEXT8N 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DZEXT8N: extract byte
CLEARSTACK
PUSH 0xABCD
PUSH 0x12EF
DZEXT8N 0
POP y
POP x
ASSERT x == 0xCD
ASSERT y == 0xEF

CLEARSTACK
PUSH 0xABCD
PUSH 0x12EF
PAIRZEXT8N 1
POP y
POP x
ASSERT x == 0xAB
ASSERT y == 0x12

# STACK2ZEXT8N n2 of 0x123456: byte2=0x12
CLEARSTACK
PUSH 0x123456
PUSH 0xABCDEF
STACK2ZEXT8N 2
POP y
POP x
ASSERT x == 0x12
ASSERT y == 0xAB

# aliases
CLEARSTACK
PUSH 0xFC
PUSH 0x09
DIABS8N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 9

CLEARSTACK
PUSH 0xFC
PUSH 0x09
DBYTESEXTN 0
POP y
POP x
ASSERT x == -4
ASSERT y == 9

CLEARSTACK
PUSH 0xFF00
PUSH 0x00FF
DBYTEZEXTN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 255

HOLD_FLASH 0
