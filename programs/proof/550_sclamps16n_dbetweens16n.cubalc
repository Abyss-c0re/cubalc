# Proof 550 — digit-7 stack+dual imm 16-bit signed clamp+between: SCLAMPS16N SBETWEENS16N DCLAMPS16N DBETWEENS16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLAMPS16N: clamp -5=0xFFFB into [-1, 3] → -1
PUSH 0xFFFB
SCLAMPS16N 0xFFFF 0x3 0
POP x
ASSERT x == 0xFFFF

# clamp 10 into [-1, 3] → 3
CLEARSTACK
PUSH 0xA
CLAMPS16N 0xFFFF 0x3 0
POP x
ASSERT x == 3

# in range stays
CLEARSTACK
PUSH 0x1
SCLAMPSIGN16N 0xFFFF 0x3 0
POP x
ASSERT x == 1

# swap lo/hi
CLEARSTACK
PUSH 0x0
SCLAMPS16N 0x3 0xFFFF 0
POP x
ASSERT x == 0

# INT16_MIN clamp to [0, 10] → 0
CLEARSTACK
PUSH 0x8000
SCLAMPS16N 0x0 0xA 0
POP x
ASSERT x == 0

# high halfword preserved: low FFFF clamp [0,5] → 0 low
CLEARSTACK
PUSH 0x1122FFFF
SCLAMPS16N 0x0 0x5 0
POP x
ASSERT x == 0x11220000

# STACKCLAMPS16N n1: high FFFE (-2) clamp [-1,1] → FFFF
CLEARSTACK
PUSH 0xFFFE0000
STACKCLAMPS16N 0xFFFF 0x1 1
POP x
ASSERT x == 0xFFFF0000

# SBETWEENS16N: -1 in [-2, 0] → 1
CLEARSTACK
PUSH 0xFFFF
SBETWEENS16N 0xFFFE 0x0 0
POP x
ASSERT x == 1

# 5 not in [-1, 3] → 0
CLEARSTACK
PUSH 0x5
BETWEENS16N 0xFFFF 0x3 0
POP x
ASSERT x == 0

# INT16_MIN not in [0, 10]
CLEARSTACK
PUSH 0x8000
SINRANGES16N 0x0 0xA 0
POP x
ASSERT x == 0

# 0xFFFF signed -1 in [-5, 5]
CLEARSTACK
PUSH 0xFFFF
SBETWEENS16N 0xFFFB 0x5 0
POP x
ASSERT x == 1

# high preserved between
CLEARSTACK
PUSH 0xAABB0002
SBETWEENS16N 0x0 0x3 0
POP x
ASSERT x == 0xAABB0001

# STACKBETWEENS16N n1
CLEARSTACK
PUSH 0xFFFF0000
STACKBETWEENS16N 0xFFFE 0x0 1
POP x
ASSERT x == 0x00010000

# DCLAMPS16N: -5 and 10 clamp [-1,3]
CLEARSTACK
PUSH 0xFFFB
PUSH 0xA
DCLAMPS16N 0xFFFF 0x3 0
POP y
POP x
ASSERT x == 0xFFFF
ASSERT y == 3

# both in range
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRCLAMPS16N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# high preserve dual
CLEARSTACK
PUSH 0x1111FFFF
PUSH 0x2222000A
S2CLAMPS16N 0x0 0x5 0
POP y
POP x
ASSERT x == 0x11110000
ASSERT y == 0x22220005

# STACK2CLAMPS16N n1
CLEARSTACK
PUSH 0xFFFE0000
PUSH 0x000A0000
STACK2CLAMPS16N 0xFFFF 0x1 1
POP y
POP x
ASSERT x == 0xFFFF0000
ASSERT y == 0x00010000

# DBETWEENS16N
CLEARSTACK
PUSH 0xFFFF
PUSH 0x5
DBETWEENS16N 0xFFFE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# both in
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRBETWEENS16N 0x0 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DINRANGESIGN16N
CLEARSTACK
PUSH 0x8000
PUSH 0xFFFF
DINRANGESIGN16N 0xFFFE 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK2BETWEENS16N n1
CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x00050000
STACK2BETWEENS16N 0xFFFE 0x0 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

HOLD_FLASH 0
