# SYS MEDIANKV / P50KV — integer median of key:val numeric values
# Usability: outlier-robust typical FREQ count without VALS+MEDIAN (vs AVGKV)

HOLD_FLASH 1

# odd count: 1,3,9 → mid 3
LET hist = "error:9\nwarn:1\ninfo:3"
SYS MEDIANKV hist
ASSERT OK == 1
ASSERT LAST_N == 3
ASSERT MEDIANKV_N == 3
ASSERT MEDIANKV_KEYS == 3
SYS EQS LAST "3"
ASSERT LAST_N == 1

# even count: 1,2,8,9 → lower mid index (4-1)/2=1 → 2
SYS MEDIANKV "a:9\nb:1\nc:8\nd:2"
ASSERT LAST_N == 2
ASSERT MEDIANKV_N == 4

# single
SYS MEDIANKV "only:7"
ASSERT LAST_N == 7
ASSERT MEDIANKV_N == 1

# empty
SYS MEDIANKV ""
ASSERT LAST_N == 0
ASSERT MEDIANKV_N == 0

# outlier: mean would be pulled high; median stable
# values 1,2,3,100 → sorted mid lower of even → index 1 → 2
SYS MEDIANKV "a:1\nb:2\nc:3\nd:100"
ASSERT LAST_N == 2
SYS AVGKV "a:1\nb:2\nc:3\nd:100"
# sum 106 / 4 = 26
ASSERT LAST_N == 26

# custom sep
SYS MEDIANKV "x=5\ny=1\nz=9" "="
ASSERT LAST_N == 5
ASSERT MEDIANKV_N == 3

# aliases
SYS P50KV hist
ASSERT P50KV_N == 3
ASSERT LAST_N == 3
SYS MIDKV hist
ASSERT MIDKV_N == 3
SYS KVMEDIAN hist
ASSERT MEDIANKV_N == 3

# agent: FREQ with outlier then robust mid load
LET log = "ERROR\nERROR\nERROR\nERROR\nERROR\nWARN\nINFO\nINFO"
SYS FREQ log
# ERROR:5 WARN:1 INFO:2 → sorted 1,2,5 → mid 2
SYS MEDIANKV LAST
ASSERT LAST_N == 2
ASSERT MEDIANKV_N == 3
SYS AVGKV "ERROR:5\nWARN:1\nINFO:2"
# 8/3 = 2
ASSERT LAST_N == 2

PRINT "sys_mediankv ok"
