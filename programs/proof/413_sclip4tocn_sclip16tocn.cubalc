# Proof 413 — digit-4 imm dual fixed clip TOC: SCLIP4TOCN SCLIP8TOCN SCLIP16TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLIP4TOCN: 20 → 15
CELLSET 1 20
PUSH 1
SCLIP4TOCN
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP

# CLIP4TOCN: 7 stays
CELLSET 2 7
PUSH 2
CLIP4TOCN
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SCLIPNTOCN: negative via sext4 then clip → 0
CELLSET 3 15
PUSH 3
SSEXT4TOC
POP
PUSH 3
SCLIPNTOCN
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SCLIP8TOCN: 300 → 255
CELLSET 4 300
PUSH 4
SCLIP8TOCN
ASSERT LAST_N == 255
ASSERT CELL(4) == 255
POP

# CLIP8TOCN: 100 stays
CELLSET 5 100
PUSH 5
CLIP8TOCN
ASSERT LAST_N == 100
ASSERT CELL(5) == 100
POP

# SCLIP16TOCN: 70000 → 65535
CELLSET 6 70000
PUSH 6
SCLIP16TOCN
ASSERT LAST_N == 65535
ASSERT CELL(6) == 65535
POP

# CLIP16TOCN: 1000 stays
CELLSET 7 1000
PUSH 7
CLIP16TOCN
ASSERT LAST_N == 1000
ASSERT CELL(7) == 1000
POP

# soft short stack OK=0
CLEARSTACK
SCLIP4TOCN
ASSERT OK == 0
SCLIP8TOCN
ASSERT OK == 0
SCLIP16TOCN
ASSERT OK == 0

PRINT "413_sclip4tocn_sclip16tocn OK"
