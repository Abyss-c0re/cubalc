# fn_guard via native HASFNS/NEEDFNS (no N× HASFN soup on ALL path)

HOLD_FLASH 1

FN add a b
  RET a + b
END

FN ping
  RET 1
END

FN greet name
  RET name
END

DEFAULT NEED_FNALL = ""
DEFAULT NEED_FNANY = ""
DEFAULT FN_GUARD_SOFT = 0
INCLUDE fn_guard
ASSERT FN_GUARD_OK == 1
ASSERT FN_GUARD_ALL_OK == 1
ASSERT FN_GUARD_ANY_OK == 1

LET NEED_FNALL = "add\nping"
LET FN_GUARD_SOFT = 1
INCLUDE fn_guard
ASSERT FN_GUARD_ALL_OK == 1
ASSERT FN_GUARD_OK == 1
ASSERT FNHAVE_N >= 2
ASSERT FNMISS_N == 0

LET NEED_FNALL = "add\nghost_fn"
LET NEED_FNANY = ""
LET FN_GUARD_SOFT = 1
INCLUDE fn_guard
ASSERT FN_GUARD_ALL_OK == 0
ASSERT FN_GUARD_OK == 0
ASSERT FNMISS_N >= 1
SYS HASI FNMISS "ghost_fn"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_FNALL = ""
LET NEED_FNANY = "ghost\nping"
LET FN_GUARD_SOFT = 1
INCLUDE fn_guard
ASSERT FN_GUARD_ANY_OK == 1
ASSERT FN_GUARD_OK == 1
SYS HASI FNHAVE "ping"
ASSERT LAST_N == 1

LET NEED_FNANY = "ghostA\nghostB"
LET FN_GUARD_SOFT = 1
INCLUDE fn_guard
ASSERT FN_GUARD_ANY_OK == 0
ASSERT FN_GUARD_OK == 0
CLEAR_ERR

# hard ALL via NEEDFNS
LET NEED_FNALL = "add\nping\ngreet"
LET NEED_FNANY = ""
LET FN_GUARD_SOFT = 0
INCLUDE fn_guard
ASSERT FN_GUARD_OK == 1

# hard ANY hit
LET NEED_FNALL = ""
LET NEED_FNANY = "ghost_z\nadd"
LET FN_GUARD_SOFT = 0
INCLUDE fn_guard
ASSERT FN_GUARD_ANY_OK == 1
ASSERT FN_GUARD_OK == 1

# combined soft
LET NEED_FNALL = "add"
LET NEED_FNANY = "ping\nghost_z"
LET FN_GUARD_SOFT = 1
INCLUDE fn_guard
ASSERT FN_GUARD_ALL_OK == 1
ASSERT FN_GUARD_ANY_OK == 1
ASSERT FN_GUARD_OK == 1

HASFNS add ping
ASSERT LAST_N == 1
HASFORM "HASFNS"
ASSERT LAST_N == 1
HASLIB fn_guard
ASSERT LAST_N == 1

PRINT "1432_fn_guard_native ok"
PASS
