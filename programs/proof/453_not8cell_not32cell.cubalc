# Proof 453 — digit-5 cell fixed-width unary NOT: NOT8CELL NOT16CELL NOT32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NOT8CELL: ~0x0F as u8 = 240; ~0 as u8 = 255; ~0xFF = 0
CELLSET 0 15
CELLSET 1 0
CELLSET 2 255
NOT8CELL 0 2
ASSERT CELL(0) == 240
ASSERT CELL(1) == 255
ASSERT CELL(2) == 0
ASSERT LAST_N == 3

# NOT16CELL: ~0x00FF as u16 = 65280; ~0 = 65535
CELLSET 3 255
CELLSET 4 0
NOT16CELL 3 4
ASSERT CELL(3) == 65280
ASSERT CELL(4) == 65535
ASSERT LAST_N == 2

# NOT32CELL: ~15 as u32 = 4294967280; ~0 = 4294967295
CELLSET 5 15
CELLSET 6 0
NOT32CELL 5 6
ASSERT CELL(5) == 4294967280
ASSERT CELL(6) == 4294967295
ASSERT LAST_N == 2

# high bits ignored for 8/16
CELLSET 7 271
NOT8CELL 7 7
ASSERT CELL(7) == 240

CELLSET 8 65791
NOT16CELL 8 8
ASSERT CELL(8) == 65280

# NOT32RANGE alias: ~0xFFFFFFFF = 0
CELLSET 9 4294967295
NOT32RANGE 9 9
ASSERT CELL(9) == 0

# double NOT8 restores low8
CELLSET 10 0xA5
NOT8CELL 10 10
NOT8CELL 10 10
ASSERT CELL(10) == 165

# INV32CELL alias
CELLSET 11 1
INV32CELL 11 11
ASSERT CELL(11) == 4294967294

HOLD_FLASH 0
