# Proof 457 — digit-2 cell fixed-width 4 nibble signed/metrics: SEXT4CELL ABS4CELL POPCNT4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SEXT4CELL: 0x7 → 7; 0x8 → -8; 0xF → -1
CELLSET 0 7
CELLSET 1 8
CELLSET 2 15
SEXT4CELL 0 2
ASSERT CELL(0) == 7
ASSERT CELL(1) == -8
ASSERT CELL(2) == -1
ASSERT LAST_N == 3

# high bits ignored: 0x18 → low4 0x8 → -8
CELLSET 3 24
SEXT4RANGE 3 3
ASSERT CELL(3) == -8

# ABS4CELL: 0xE (-2) → 2; 0x5 → 5; min 0x8 stays 8
CELLSET 4 14
CELLSET 5 5
CELLSET 6 8
ABS4CELL 4 6
ASSERT CELL(4) == 2
ASSERT CELL(5) == 5
ASSERT CELL(6) == 8
ASSERT LAST_N == 3

# ABS4RANGE: 0xF (-1) → 1
CELLSET 7 15
ABS4RANGE 7 7
ASSERT CELL(7) == 1

# POPCNT4CELL: 0x0 → 0; 0xF → 4; 0x5 → 2
CELLSET 8 0
CELLSET 9 15
CELLSET 10 5
POPCNT4CELL 8 10
ASSERT CELL(8) == 0
ASSERT CELL(9) == 4
ASSERT CELL(10) == 2
ASSERT LAST_N == 3

# high bits ignored: 0x15 → low4 0x5 → pop 2
CELLSET 11 21
POPCNT4RANGE 11 11
ASSERT CELL(11) == 2

# SEXTNIBCELL alias: 0xA → -6
CELLSET 12 10
SEXTNIBCELL 12 12
ASSERT CELL(12) == -6

# CELLABS4: 0xC (-4) → 4
CELLSET 13 12
CELLABS4 13 13
ASSERT CELL(13) == 4

# PCNT4CELL: 0x7 → 3
CELLSET 14 7
PCNT4CELL 14 14
ASSERT CELL(14) == 3

# double SEXT is idempotent on already-extended positive
CELLSET 15 3
SEXT4CELL 15 15
SEXT4CELL 15 15
ASSERT CELL(15) == 3

HOLD_FLASH 0
