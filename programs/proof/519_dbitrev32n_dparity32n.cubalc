# Proof 519 — digit-8 dual-stack imm 32-bit field metrics: DBITREV32N DPOPCNT32N DPARITY32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DBITREV32N: 0x1 → 0x80000000 ; 0x3 → 0xC0000000
PUSH 0x00000001
PUSH 0x00000003
DBITREV32N 0
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 3221225472

# 0xFF → 0xFF000000 ; 0x0F0F0F0F → 0xF0F0F0F0
CLEARSTACK
PUSH 0x000000FF
PUSH 0x0F0F0F0F
PAIRBITREV32N 0
POP y
POP x
ASSERT x == 0xFF000000
ASSERT y == 0xF0F0F0F0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
PUSH 0x99AABBCCDDEEFF05
DBITREV32N 0
DBITREV32N 0
POP y
POP x
ASSERT x == 0x112233445566778A
ASSERT y == 0x99AABBCCDDEEFF05

# S2BITREV32N n1: high 1 → 0x80000000 high
CLEARSTACK
PUSH 0x0000000100000000
PUSH 0x0000000F00000000
S2BITREV32N 1
POP y
POP x
ASSERT x == 0x8000000000000000
ASSERT y == 0xF000000000000000

# DBREV32N alias
CLEARSTACK
PUSH 0x00000001
PUSH 0x00000001
DBREV32N 0
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 2147483648

# DPOPCNT32N: 0→0 ; FFFFFFFF→32
CLEARSTACK
PUSH 0x0
PUSH 0xFFFFFFFF
DPOPCNT32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 32

# high preserved: low 0x55555555 → 16 ; low 7 → 3
CLEARSTACK
PUSH 0x1122334455555555
PUSH 0x99AABBCC00000007
PAIRPOPCNT32N 0
POP y
POP x
ASSERT x == 0x1122334400000010
ASSERT y == 0x99AABBCC00000003

# STACK2POPCNT32N n1: high FFFFFFFF→32
CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x0000000700000000
STACK2POPCNT32N 1
POP y
POP x
ASSERT x == 0x0000002000000000
ASSERT y == 0x0000000300000000

# DPCNT32N alias
CLEARSTACK
PUSH 0xAAAAAAAA
PUSH 0x00000003
DPCNT32N 0
POP y
POP x
ASSERT x == 16
ASSERT y == 2

# DPARITY32N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DPARITY32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x3
PUSH 0x7
PAIRPARITY32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# high parity n1: 0x90000000 even; 0xB0000000 odd
CLEARSTACK
PUSH 0x9000000000000000
PUSH 0xB000000000000000
S2PARITY32N 1
POP y
POP x
ASSERT x == 0x0000000000000000
ASSERT y == 0x0000000100000000

# DXORRED32N: FFFFFFFF even; FFFFFFFE odd
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFE
DXORRED32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DBITREVDWN: 0x80000000 → 1 ; 0x40000000 → 2
CLEARSTACK
PUSH 0x80000000
PUSH 0x40000000
DBITREVDWN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2

HOLD_FLASH 0
