# Proof 292 — digit-1 stack imm sat ALU: SSATADDN SSATSUBN SSATMULN
HOLD_FLASH 1
SCIENCE LOAD

# SSATADDN n — normal
CLEARSTACK
PUSH 10
SSATADDN 20
POP x
ASSERT x == 30

CLEARSTACK
PUSH -5
SATADDN -3
POP x
ASSERT x == -8

# SSATADDN — saturate +
CLEARSTACK
PUSH 9223372036854775807
SSATADDN 1
POP x
ASSERT x == 9223372036854775807

CLEARSTACK
PUSH 9223372036854775800
SADDSATN 100
POP x
ASSERT x == 9223372036854775807

# SSATADDN — saturate - (avoid bare LONG_MIN literal in ASSERT)
CLEARSTACK
PUSH -9223372036854775807
SSATADDN -2
POP x
ASSERT x < -9223372036854775807

# SSATSUBN n
CLEARSTACK
PUSH 10
SSATSUBN 3
POP x
ASSERT x == 7

CLEARSTACK
PUSH -9223372036854775807
SATSUBN 2
POP x
ASSERT x < -9223372036854775807

CLEARSTACK
PUSH 9223372036854775807
SSUBSATN -1
POP x
ASSERT x == 9223372036854775807

CLEARSTACK
PUSH 0
SSATSUBIMM 0
POP x
ASSERT x == 0

# SSATMULN n
CLEARSTACK
PUSH 6
SSATMULN 7
POP x
ASSERT x == 42

CLEARSTACK
PUSH 0
SATMULN 999
POP x
ASSERT x == 0

CLEARSTACK
PUSH 3037000500
SMULSATN 3037000500
POP x
ASSERT x == 9223372036854775807

CLEARSTACK
PUSH -3037000500
STACKSATMULN 3037000500
POP x
ASSERT x < 0
ASSERT x < -9000000000000000000

CLEARSTACK
PUSH 9223372036854775807
SSATMULN 2
POP x
ASSERT x == 9223372036854775807

# soft fails
CLEARSTACK
SSATADDN 1
ASSERT OK == 0
CLEARSTACK
SSATSUBN 1
ASSERT OK == 0
CLEARSTACK
SSATMULN 1
ASSERT OK == 0

HOLD_FLASH 1
