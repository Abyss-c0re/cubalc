# INCLUDE oop_session - class+method+field catalog combined contract

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  FIELD status
  METHOD ping
    LET LAST = "pong"
  END
  METHOD init
    LET id = 1
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

DEFAULT NEED_CLASSES = ""
