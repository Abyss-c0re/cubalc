# GETFLAGMS / FLAGMS — CLI duration flags to milliseconds

HOLD_FLASH 1

# missing + OR duration default
SYS ENV UNSET CUBALC_ARG0
SYS ENV SET CUBALC_ARGC "0"
GETFLAGMS timeout OR "30s"
ASSERT LAST_N == 30000
ASSERT GETFLAGMS_HIT == 0
SYS EQS LAST "30000"
ASSERT LAST_N == 1

# --timeout=5s
SYS ENV SET CUBALC_ARG0 "--timeout=5s"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS timeout OR "30s"
ASSERT LAST_N == 5000
ASSERT GETFLAGMS_HIT == 1
ASSERT GETFLAGMS_N == 5000

# compound duration
SYS ENV SET CUBALC_ARG0 "--wait=1m30s"
SYS ENV SET CUBALC_ARGC "1"
FLAGMS wait OR "1s"
ASSERT LAST_N == 90000

# bare number = ms
SYS ENV SET CUBALC_ARG0 "--ms=250"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS ms OR 0
ASSERT LAST_N == 250

# 250ms unit
SYS ENV SET CUBALC_ARG0 "--poll=250ms"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS poll OR "1s"
ASSERT LAST_N == 250

# bare flag -> 1 ms
SYS ENV SET CUBALC_ARG0 "--tick"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS tick OR 100
ASSERT LAST_N == 1
ASSERT GETFLAGMS_HIT == 1

# OR numeric ms default
SYS ENV SET CUBALC_ARGC "0"
GETFLAGMS delay OR 1500
ASSERT LAST_N == 1500
ASSERT GETFLAGMS_HIT == 0

# bad duration soft
SYS ENV SET CUBALC_ARG0 "--t=notime"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS t OR "5s"
ASSERT GETFLAGMS_HIT == 1
ASSERT LAST_N == 0
ASSERT GETFLAGMS_OK == 0

# FLAGDUR alias
SYS ENV SET CUBALC_ARG0 "--ttl=2h"
SYS ENV SET CUBALC_ARGC "1"
FLAGDUR ttl OR "1h"
ASSERT LAST_N == 7200000

PRINT "getflagms ok"
