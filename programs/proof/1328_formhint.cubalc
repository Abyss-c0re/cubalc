# FORMHINT / DESCRIBEFORM — HELP one-line peel

FORMHINT SORTLIBS
ASSERT OK == 1
ASSERT LAST_N > 10
ASSERT FORM == "SORTLIBS"
ASSERT FORM_HINT != ""
SYS HAS "SORTLIBS"
ASSERT LAST_N == 1

DESCRIBEFORM LIBAGE
ASSERT OK == 1
ASSERT FORM == "LIBAGE"
ASSERT FORM_HINT != ""

FORMHINT "REQUIRE FN"
ASSERT OK == 1
ASSERT FORM_HINT != ""

# soft miss
FORMHINT NO_SUCH_FORM_XYZ_ZZZ
ASSERT OK == 0
ASSERT LAST_N == 0
CLEAR_ERR

# HASFORM then FORMHINT same name
HASFORM FRESHLIBS
ASSERT LAST_N == 1
FORMHINT FRESHLIBS
ASSERT OK == 1
ASSERT LAST_N > 5

PASS
PRINT "1328_formhint: PASS"
