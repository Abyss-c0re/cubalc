# Proof 243 — digit-5 dual-stack low-n field reverse/rotate: DBREVN DROLBN DRORBN
HOLD_FLASH 1
SCIENCE LOAD

# DBREVN — reverse low n bits
CLEARSTACK
PUSH 0x0B
PUSH 0x13
DBREVN 4
POP y
POP x
# 0xB=1011 → 1101=0xD; 0x3=0011 → 1100=0xC so 0x1C
ASSERT x == 0x0D
ASSERT y == 0x1C

CLEARSTACK
PUSH 0xF0AB
PUSH 0x00CD
2BREVN 8
POP y
POP x
# 0xAB=10101011 → 11010101=0xD5 → 0xF0D5
# 0xCD=11001101 → 10110011=0xB3
ASSERT x == 0xF0D5
ASSERT y == 0xB3

# n=0 noop
CLEARSTACK
PUSH 0x55
PUSH 0xAA
DBREVN 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0xAA

# DROLBN — rotl1 within low n
CLEARSTACK
PUSH 0x09
PUSH 0x05
DROLBN 4
POP y
POP x
# 1001 → 0011=3; 0101 → 1010=0xA
ASSERT x == 0x03
ASSERT y == 0x0A

CLEARSTACK
PUSH 0xF081
PUSH 0x0042
2ROLBN 8
POP y
POP x
# 0x81=10000001 → 00000011=0x03 → 0xF003
# 0x42=01000010 → 10000100=0x84
ASSERT x == 0xF003
ASSERT y == 0x84

# DRORBN — rotr1 within low n
CLEARSTACK
PUSH 0x09
PUSH 0x05
DRORBN 4
POP y
POP x
# 1001 → 1100=0xC; 0101 → 1010=0xA
ASSERT x == 0x0C
ASSERT y == 0x0A

CLEARSTACK
PUSH 0xF081
PUSH 0x0042
2RORBN 8
POP y
POP x
# 0x81=10000001 → 11000000=0xC0 → 0xF0C0
# 0x42=01000010 → 00100001=0x21
ASSERT x == 0xF0C0
ASSERT y == 0x21

# round-trip: rol then ror
CLEARSTACK
PUSH 0xA5
PUSH 0x5A
DROLBN 8
DRORBN 8
POP y
POP x
ASSERT x == 0xA5
ASSERT y == 0x5A

# soft fails
CLEARSTACK
DBREVN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DROLBN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DRORBN 4
ASSERT OK == 0

HOLD_FLASH 1
