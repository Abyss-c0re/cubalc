# IFFORTYONEP - plate exactly-forty-one key diagnostic branch
# Continues ladder after IFFORTYP. Soft twin HENTETRACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET forty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40}"
LET fortyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41}"
LET fortytwo = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42}"
LET empty = "{}"

IFFORTYONEP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFORTYONEP_N == 1
ASSERT FORTYONEP_N == 1
ASSERT IFFORTYONEP_LEN == 41
ASSERT IFHENTETRACONTAP_N == 1
ASSERT IFFORTYONEKEYP_N == 1

IFHENTETRACONTAP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYONEKEYP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYONEP forty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYONEP_N == 0
ASSERT IFFORTYONEP_LEN == 40

IFFORTYONEP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYONEP_LEN == 42

IFFORTYONEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFORTYONEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFORTYONEP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENHENTETRACONTAP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFORTYONEKEYP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffortyonep_ok" IFFORTYONEP_N IFFORTYONEP_LEN
PASS
