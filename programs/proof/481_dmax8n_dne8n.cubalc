# Proof 481 — digit-7 dual-stack imm 8-bit field max+eq: DMAX8N DEQ8N DNE8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DMAX8N
PUSH 0x10
PUSH 0xC0
DMAX8N 0x40 0
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0xC0

# keeps larger
CLEARSTACK
PUSH 0xF0
PUSH 0xE0
PAIRMAX8N 0x20 0
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0xE0

# high preserved max
CLEARSTACK
PUSH 0x1122334455667711
PUSH 0x99AABBCCDDEEFF22
DMAX8N 0x80 0
POP y
POP x
ASSERT x == 0x1122334455667780
ASSERT y == 0x99AABBCCDDEEFF80

# S2MAX8N n1
CLEARSTACK
PUSH 0x2000
PUSH 0x1000
S2MAX8N 0x90 1
POP y
POP x
ASSERT x == 0x9000
ASSERT y == 0x9000

# DGE8N alias
CLEARSTACK
PUSH 0x55
PUSH 0x55
DGE8N 0x55 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0x55

# DEQ8N equal → 1
CLEARSTACK
PUSH 0xAB
PUSH 0xAB
DEQ8N 0xAB 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# mixed eq
CLEARSTACK
PUSH 0xAB
PUSH 0xAC
PAIREQ8N 0xAB 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# high preserved eq
CLEARSTACK
PUSH 0x1122334455667742
PUSH 0x99AABBCCDDEEFF42
DEQ8N 0x42 0
POP y
POP x
ASSERT x == 0x1122334455667701
ASSERT y == 0x99AABBCCDDEEFF01

# STACK2EQ8N n1
CLEARSTACK
PUSH 0x7700
PUSH 0x7800
STACK2EQ8N 0x77 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

# DNE8N
CLEARSTACK
PUSH 0x10
PUSH 0x11
DNE8N 0x10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# equal → 0 both
CLEARSTACK
PUSH 0x10
PUSH 0x10
PAIRNE8N 0x10 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved ne
CLEARSTACK
PUSH 0x11223344556677FF
PUSH 0x99AABBCCDDEEFF00
DNE8N 0 0
POP y
POP x
ASSERT x == 0x1122334455667701
ASSERT y == 0x99AABBCCDDEEFF00

# S2NE8N n1
CLEARSTACK
PUSH 0x5500
PUSH 0x5600
S2NE8N 0x55 1
POP y
POP x
ASSERT x == 0x0000
ASSERT y == 0x0100

# DCMPEQ8N / DCMPNE8N
CLEARSTACK
PUSH 0xFF
PUSH 0x00
DCMPEQ8N 0xFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x00
PUSH 0x01
DCMPNE8N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

HOLD_FLASH 0
