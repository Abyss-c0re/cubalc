# Proof 406 — digit-5 imm dual sign/zero extend TOC: SSEXTTOCN SZEXTTOCN SSEXT16TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SZEXTTOCN: zero-extend low 4 of 0xFF → 0xF
CELLSET 1 255
PUSH 1
SZEXTTOCN 4
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP

# ZEXTTOCN alias: low 8 of 0xABCD=43981 → 0xCD=205
CELLSET 2 43981
PUSH 2
ZEXTTOCN 8
ASSERT LAST_N == 205
ASSERT CELL(2) == 205
POP

# SSEXTTOCN: sign-extend low 4 of 0x0F → -1
CELLSET 3 15
PUSH 3
SSEXTTOCN 4
ASSERT LAST_N == -1
ASSERT CELL(3) == -1
POP

# SEXTTOCN alias: low 8 of 0x80 → -128
CELLSET 4 128
PUSH 4
SEXTTOCN 8
ASSERT LAST_N == -128
ASSERT CELL(4) == -128
POP

# SSEXTTOCN positive: low 4 of 7 → 7
CELLSET 5 7
PUSH 5
SSEXTTOCN 4
ASSERT LAST_N == 7
ASSERT CELL(5) == 7
POP

# SSEXT16TOCN: 0xFFFF → -1
CELLSET 6 65535
PUSH 6
SSEXT16TOCN
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# SEXT16TOCN alias: 0x8000 → -32768
CELLSET 7 32768
PUSH 7
SEXT16TOCN
ASSERT LAST_N == -32768
ASSERT CELL(7) == -32768
POP

# SSEXTWTOCN: 0x7FFF → 32767
CELLSET 8 32767
PUSH 8
SSEXTWTOCN
ASSERT LAST_N == 32767
ASSERT CELL(8) == 32767
POP

# w=0 → 0
CELLSET 9 99
PUSH 9
SZEXTTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft short stack OK=0
CLEARSTACK
SSEXTTOCN 4
ASSERT OK == 0
SZEXTTOCN 8
ASSERT OK == 0
SSEXT16TOCN
ASSERT OK == 0

PRINT "406_ssexttocn_szexttocn OK"
