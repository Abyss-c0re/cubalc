# Proof 350 — digit-8 imm shift TOC: SSHLTOCN SSHRTOCN SSARTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSHLTOCN: 3 << 2 → 12
CELLSET 1 3
PUSH 1
SSHLTOCN 2
ASSERT LAST_N == 12
ASSERT CELL(1) == 12
POP a
ASSERT a == 12

# SHLTOCN by 0 identity
CELLSET 2 7
PUSH 2
SHLTOCN 0
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SSHLATN clamp high
CELLSET 3 1
PUSH 3
SSHLATN 3
ASSERT LAST_N == 8
ASSERT CELL(3) == 8
POP

# SSHRTOCN: 16 >> 2 → 4 logical
CELLSET 4 16
PUSH 4
SSHRTOCN 2
ASSERT LAST_N == 4
ASSERT CELL(4) == 4
POP

# SHRTOCN negative as unsigned (all bits)
PUSH 5
PUSH (-8)
SSETCELL
POP
PUSH 5
SHRTOCN 1
# (-8) as u64 >> 1 is 0x7ffffffffffffffc = 9223372036854775804
ASSERT LAST_N == 9223372036854775804
ASSERT CELL(5) == 9223372036854775804
POP

# SSARTOCN: -8 >> 1 → -4 arithmetic
PUSH 6
PUSH (-8)
SSETCELL
POP
PUSH 6
SSARTOCN 1
ASSERT LAST_N == (-4)
ASSERT CELL(6) == (-4)
POP

# SARTOCN positive
CELLSET 7 20
PUSH 7
SARTOCN 2
ASSERT LAST_N == 5
ASSERT CELL(7) == 5
POP

# SSARATN zero shift
CELLSET 8 (-1)
PUSH 8
SSARATN 0
ASSERT LAST_N == (-1)
ASSERT CELL(8) == (-1)
POP

# soft fails empty stack
CLEARSTACK
SSHLTOCN 1
ASSERT OK == 0
SSHRTOCN 1
ASSERT OK == 0
SSARTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof350_sshltocn_ssartocn" LAST_N SP
HOLD_FLASH 1
