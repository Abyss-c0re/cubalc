# Proof 67 — digit-1 SETCELL/INCCELL/DECCELL/XCHGCELL + stack mem control
HOLD_FLASH 1
SCIENCE LOAD

# clear workspace
CLEARCELLS

# SETCELL / STORE / POKE / PUTCELL
ASSERT SETCELL(0, 42) == 42
ASSERT CELL(0) == 42
ASSERT STORE(1, 7) == 7
ASSERT CELL(1) == 7
ASSERT POKE(2, 99) == 99
ASSERT PUTCELL(3, -5) == -5
ASSERT CELL(3) == -5

# INCCELL / DECCELL
ASSERT SETCELL(4, 10) == 10
ASSERT INCCELL(4) == 11
ASSERT INCCELL(4, 5) == 16
ASSERT DECCELL(4) == 15
ASSERT DECCELL(4, 3) == 12
ASSERT CELL(4) == 12
ASSERT INCELL(5) == 1
ASSERT DECELL(5) == 0

# XCHGCELL / EXCHCELL
ASSERT SETCELL(6, 100) == 100
ASSERT XCHGCELL(6, 200) == 100
ASSERT CELL(6) == 200
ASSERT EXCHCELL(6, 300) == 200
ASSERT CELL(6) == 300
ASSERT SWAPC(6, 0) == 300
ASSERT CELL(6) == 0

# compose with SELECT / control-ish
ASSERT SELECT(EQ(CELL(0), 42), 1, 0) == 1
ASSERT SETCELL(7, INCCELL(0)) == 43
ASSERT CELL(0) == 43
ASSERT CELL(7) == 43
ASSERT LAND(NEZ(CELL(1)), EQ(CELL(1), 7)) == 1

# loop-friendly pattern via expressions
ASSERT SETCELL(8, 0) == 0
ASSERT INCCELL(8) == 1
ASSERT INCCELL(8) == 2
ASSERT CELL(8) == 2

# stack SSETCELL
CLEARSTACK
PUSH 9
PUSH 55
SSETCELL
ASSERT LAST_N == 55
ASSERT CELL(9) == 55

# stack SINCCELL SDECCELL
CLEARSTACK
PUSH 9
SINCCELL
ASSERT LAST_N == 56
ASSERT CELL(9) == 56
CLEARSTACK
PUSH 9
SDECCELL
ASSERT LAST_N == 55
ASSERT CELL(9) == 55

# stack SXCHGCELL
CLEARSTACK
PUSH 9
PUSH 1
SXCHGCELL
ASSERT LAST_N == 55
ASSERT CELL(9) == 1

# underflow
CLEARSTACK
SSETCELL
ASSERT OK == 0
CLEARSTACK
SINCCELL
ASSERT OK == 0
CLEARSTACK
SXCHGCELL
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof67_mem_set_inc_xchg" LAST_N SP
