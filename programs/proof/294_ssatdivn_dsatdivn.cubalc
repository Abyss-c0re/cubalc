# Proof 294 — digit-6 imm sat div: SATDIV SSATDIVN DSATDIVN
HOLD_FLASH 1
SCIENCE LOAD

# SATDIV(a,b) function
ASSERT SATDIV(20, 4) == 5
ASSERT SATDIV(7, 2) == 3
ASSERT SATDIV(-7, 2) == -3
ASSERT SATDIV(10, 0) == 0
ASSERT SATDIV(-9223372036854775808, -1) == 9223372036854775807

# SSATDIVN n — normal
CLEARSTACK
PUSH 42
SSATDIVN 6
POP x
ASSERT x == 7

CLEARSTACK
PUSH 100
SATDIVN 7
POP x
ASSERT x == 14

CLEARSTACK
PUSH -15
SDIVSATN 4
POP x
ASSERT x == -3

# SSATDIVN — /0 → 0
CLEARSTACK
PUSH 99
SSATDIVIMM 0
POP x
ASSERT x == 0

# SSATDIVN — LONG_MIN / -1 → LONG_MAX
CLEARSTACK
PUSH -9223372036854775808
STACKSATDIVN -1
POP x
ASSERT x == 9223372036854775807

# DSATDIVN n — normal
CLEARSTACK
PUSH 20
PUSH 35
DSATDIVN 5
POP y
POP x
ASSERT x == 4
ASSERT y == 7

CLEARSTACK
PUSH -16
PUSH 9
PAIRSATDIVN 4
POP y
POP x
ASSERT x == -4
ASSERT y == 2

# DSATDIVN — /0 → 0,0
CLEARSTACK
PUSH 8
PUSH 9
DDIVSATN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DSATDIVN — LONG_MIN/-1 saturate both
CLEARSTACK
PUSH -9223372036854775808
PUSH -9223372036854775808
DSATDIVIMM -1
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 9223372036854775807

# mixed: one saturates, one normal
CLEARSTACK
PUSH -9223372036854775808
PUSH 100
PAIRDIVSATN -1
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == -100

# soft fails
CLEARSTACK
SSATDIVN 2
ASSERT OK == 0
CLEARSTACK
DSATDIVN 2
ASSERT OK == 0
CLEARSTACK
PUSH 1
PAIRSATDIVN 2
ASSERT OK == 0

HOLD_FLASH 1
