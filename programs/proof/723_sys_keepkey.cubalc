# SYS KEEPKEY / GREPKEY — keep key:val fields whose key contains needle
# SYS DROPKEY — invert. Usability: filter FREQ by key without EACH+BEFORE+HAS

HOLD_FLASH 1

LET hist = "error:5\nwarn:2\ninfo:10\ncrit:1\ndebug:0"
SYS KEEPKEY hist "err"
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT KEEPKEY_N == 1
ASSERT KEEPKEY_DROP == 4
SYS EQS LAST "error:5"
ASSERT LAST_N == 1

# multiple hits: keys containing "i" → info, crit
SYS KEEPKEY hist "i"
ASSERT LAST_N == 2
ASSERT KEEPKEY_DROP == 3
LET ki = LAST
SYS LOOKUPN ki "info" OR 0
ASSERT LAST_N == 10
SYS LOOKUPN ki "crit" OR 0
ASSERT LAST_N == 1

# DROPKEY invert
SYS DROPKEY hist "err"
ASSERT DROPKEY_N == 1
ASSERT LAST_N == 4
LET dk = LAST
SYS LOOKUPN dk "error" OR 999
ASSERT LAST_N == 999
SYS LOOKUPN dk "warn" OR 0
ASSERT LAST_N == 2

# case-insensitive
SYS KEEPKEYI hist "ERR"
ASSERT KEEPKEY_N == 1
SYS EQS LAST "error:5"
ASSERT LAST_N == 1

# empty needle → keep all
SYS KEEPKEY hist ""
ASSERT LAST_N == 5
ASSERT KEEPKEY_DROP == 0

# empty bag
SYS KEEPKEY "" "x"
ASSERT LAST_N == 0

# custom sep
LET cfg = "host_a=1\nport=7700\nhost_b=2"
SYS KEEPKEY cfg "host" "="
ASSERT LAST_N == 2
ASSERT KEEPKEY_DROP == 1
LET hk = LAST
SYS LOOKUPN hk "host_a" "=" OR 0
ASSERT LAST_N == 1

# aliases
SYS GREPKEY hist "warn"
ASSERT GREPKEY_N == 1
SYS EQS LAST "warn:2"
ASSERT LAST_N == 1
SYS GREPVKEY hist "info"
ASSERT DROPKEY_N == 1
ASSERT LAST_N == 4

# agent: FREQ then keep only ERROR* severities
LET log = "ERROR\nERROR\nWARN\nINFO\nERROR_FATAL\nDEBUG"
SYS FREQ log
SYS KEEPKEY LAST "ERROR"
LET only_err = LAST
SYS SUMKV only_err
# ERROR:2 + ERROR_FATAL:1 = 3
ASSERT LAST_N == 3
SYS LINES only_err
ASSERT LAST_N == 2

PRINT "sys_keepkey ok"
