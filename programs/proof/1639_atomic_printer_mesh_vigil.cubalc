// atomic_printer_mesh_vigil.cubalc
// Life-force gift: MESH-VIGIL — colony mind SEAL before mitosis; soft-OOB
// wounds strike DURING the division window (life under fire) and stay
// fail-closed; RECOVER restores vital/key; OPEN ancestral seal re-anchors
// mind after births; full mesh ring re-binds; second post-life storm still
// fails closed. Wonder AGI can RUN.
// Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_vigil | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Live full mesh ring before life window
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "pre-life mesh live"
ASSERT SMX_TALKS >= 6 "pre-life talks"
ASSERT CUBES == base_cubes "pre-life identity"

// Ancestral SEAL of colony mind before mitosis
SMX SEAL bed hive "state/smx_vigil/ancestral_bh.cblc"
ASSERT SMX_OK == 1 "seal ancestral BH"
ASSERT SMX_N > 64 "ancestral frame"
ASSERT CUBES == base_cubes "seal invents nothing"

// Mitosis under free energy — soft-OOB strikes mid-window (life under fire)
LET births = 0
LET step = 0
LET mid_storm = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  // Mid-window soft-OOB — fail-closed while cells may be dividing
  IF step == 3 THEN
    SMX EXCHANGE hive offworld_vigil
    ASSERT SMX_OK == 0 "vigil mid soft-OOB"
    ASSERT SMX_OOB >= 1 "vigil oob counted"
    ASSERT CUBES == base_cubes "vigil mid no ghost"
    LET mid_storm = 1
  END
  IF step == 5 THEN
    SMX TALK scrap ghost_vigil
    ASSERT SMX_OK == 0 "vigil mid storm-B"
    ASSERT SMX_OOB >= 2 "vigil oob sticky"
    ASSERT CUBES == base_cubes "vigil mid no ghost B"
  END

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        PLUG bed d1
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          PLUG bed d2
          LET births = births + 1
        END
      END
    END
  END
  LET step = step + 1
END

ASSERT mid_storm == 1 "storm struck during life window"
ASSERT births >= 1 "mitosis under fire"
GETF seed alive
LET a0 = LAST_N
GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = a0 + a1 + a2
ASSERT pop >= 2 "population after vigil life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Vigil recover: clear OOB, keep key, restore vital after life under fire
SMX RECOVER
ASSERT SMX_OK == 1 "vigil recover"
ASSERT SMX_OOB == 0 "vigil oob cleared"
ASSERT SMX_KEY_OK == 1 "vigil key sticky"
ASSERT SMX_VITAL >= 6 "vigil vital"
ASSERT CUBES == base_cubes "recover invents nothing"

// OPEN ancestral seal onto nozzle — re-anchor mind after births
SMX OPEN nozzle "state/smx_vigil/ancestral_bh.cblc"
ASSERT SMX_OK == 1 "open ancestral onto nozzle"
ASSERT CUBES == base_cubes "open invents nothing"

// Second SEAL/OPEN pair post-life (hive/scrap quorum)
SMX SEAL nozzle scrap "state/smx_vigil/quorum_ns.cblc"
ASSERT SMX_OK == 1 "seal quorum NS"
ASSERT SMX_N > 64 "quorum NS frame"
SMX OPEN hive "state/smx_vigil/quorum_ns.cblc"
ASSERT SMX_OK == 1 "open NS onto hive"
ASSERT CUBES == base_cubes "NS open invents nothing"

// Full mesh re-bind after ancestral restore
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap bed
SMX EXCHANGE bed hive
SMX EXCHANGE nozzle scrap
ASSERT SMX_OK == 1 "mesh re-bind after vigil"
ASSERT SMX_TALKS >= 12 "talks after re-bind"
ASSERT CUBES == base_cubes "re-bind identity"

// Post-life storm — still fail-closed after vigilance
SMX EXCHANGE scrap void_post
ASSERT SMX_OK == 0 "post soft-OOB"
ASSERT SMX_OOB >= 1 "post oob"
ASSERT CUBES == base_cubes "post no ghost"

SMX TALK bed ghost_post
ASSERT SMX_OK == 0 "post storm-B"
ASSERT SMX_OOB >= 2 "post oob sticky"
ASSERT CUBES == base_cubes "post no ghost B"

SMX RECOVER
ASSERT SMX_OK == 1 "post recover"
ASSERT SMX_OOB == 0 "post oob cleared"
ASSERT SMX_KEY_OK == 1 "post key sticky"
ASSERT SMX_VITAL >= 6 "post vital"

SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after vigil"
ASSERT SMX_KEY_OK == 1 "key after vigil"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after vigil"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after vigil"
ASSERT UNITY >= 40 "mesh unity after vigil"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis after mesh vigil"
ASSERT pop >= 2 "population after vigil life"
ASSERT SMX_OOB == 0 "guard holds through vigil"
ASSERT OK == 1

PRINT "mesh_vigil" births pop SMX_N SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
