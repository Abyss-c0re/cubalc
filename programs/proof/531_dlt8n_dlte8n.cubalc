# Proof 531 — digit-3 dual-stack imm 8-bit field ordered-cmp: DLT8N DGT8N DLTE8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLT8N: 0x10 < 0xC0 → 1 ; 0xF0 < 0xC0 → 0
PUSH 0x10
PUSH 0xF0
DLT8N 0xC0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0xC0
PUSH 0xC0
PAIRLT8N 0xC0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# other bytes preserved
CLEARSTACK
PUSH 0xAABBCC10
PUSH 0xDDEEFF30
DLT8N 0x20 0
POP y
POP x
ASSERT x == 0xAABBCC01
ASSERT y == 0xDDEEFF00

# S2LT8N n1
CLEARSTACK
PUSH 0x00001000
PUSH 0x00003000
S2LT8N 0x20 1
POP y
POP x
ASSERT x == 0x00000100
ASSERT y == 0x00000000

# n2
CLEARSTACK
PUSH 0x00100000
PUSH 0x00050000
DLT8N 0x20 2
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00010000

# DGT8N
CLEARSTACK
PUSH 0xF0
PUSH 0x10
DGT8N 0x20 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0x55
PUSH 0x55
PAIRGT8N 0x55 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved gt
CLEARSTACK
PUSH 0x99AA0080
PUSH 0x11220005
DGT8N 0x10 0
POP y
POP x
ASSERT x == 0x99AA0001
ASSERT y == 0x11220000

# S2GT8N n1
CLEARSTACK
PUSH 0x00009000
PUSH 0x00000500
S2GT8N 0x10 1
POP y
POP x
ASSERT x == 0x00000100
ASSERT y == 0x00000000

# DLTE8N less/eq
CLEARSTACK
PUSH 0x10
PUSH 0xC0
DLTE8N 0xC0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0xFF
PUSH 0xFE
DLEQ8N 0xFE 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# preserved lte
CLEARSTACK
PUSH 0x11227742
PUSH 0x99AA0043
DLTE8N 0x42 0
POP y
POP x
ASSERT x == 0x11227701
ASSERT y == 0x99AA0000

# S2LTE8N n1
CLEARSTACK
PUSH 0x00005500
PUSH 0x00005400
S2LTE8N 0x54 1
POP y
POP x
ASSERT x == 0x00000000
ASSERT y == 0x00000100

# aliases + unsigned
CLEARSTACK
PUSH 1
PUSH 3
DCMPLT8N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH 1
DCMPGT8N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 2
DCMPLE8N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x80
PUSH 0x7F
DGT8N 0x7F 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

HOLD_FLASH 0
