# IFTWENTYNINEP - plate exactly-twenty-nine key diagnostic branch
# Continues ladder after IFTWENTYEIGHTP. Soft twin ENNEAICOSAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET twentyeight = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28}"
LET twentynine = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29}"
LET thirty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30}"
LET empty = "{}"

IFTWENTYNINEP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFTWENTYNINEP_N == 1
ASSERT TWENTYNINEP_N == 1
ASSERT IFTWENTYNINEP_LEN == 29
ASSERT IFENNEAICOSAP_N == 1
ASSERT IFTWENTYNINEKEYP_N == 1

IFENNEAICOSAP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYNINEKEYP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYNINEP twentyeight
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYNINEP_N == 0
ASSERT IFTWENTYNINEP_LEN == 28

IFTWENTYNINEP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYNINEP_LEN == 30

IFTWENTYNINEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFTWENTYNINEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENTWENTYNINEP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENENNEAICOSAP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTWENTYNINEKEYP twentynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iftwentyninep_ok" IFTWENTYNINEP_N IFTWENTYNINEP_LEN
PASS
