# Proof 250 — digit-8 dual-stack word unpack: DUNPACK32
HOLD_FLASH 1
SCIENCE LOAD

# pack then unpack round-trip
# hi a=0xAABBCCDD lo c=0x11223344 → word x
# hi b=0x55667788 lo d=0x99AABBCC → word y
CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x55667788
PUSH 0x11223344
PUSH 0x99AABBCC
DPACK32
POP y
POP x
# unpack
PUSH x
PUSH y
DUNPACK32
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0xAABBCCDD
ASSERT hb == 0x55667788
ASSERT la == 0x11223344
ASSERT lb == 0x99AABBCC

# 2UNPACK32 alias
CLEARSTACK
PUSH 0x0000000100000002
PUSH 0x0000000300000004
2UNPACK32
POP lb
POP la
POP hb
POP ha
ASSERT ha == 1
ASSERT hb == 3
ASSERT la == 2
ASSERT lb == 4

# DWORDSPLIT / PAIRUNPACK32
CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x00000000FFFFFFFF
PAIRUNPACK32
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0xFFFFFFFF
ASSERT hb == 0
ASSERT la == 0
ASSERT lb == 0xFFFFFFFF

# soft fails
CLEARSTACK
DUNPACK32
ASSERT OK == 0
CLEARSTACK
PUSH 1
DUNPACK32
ASSERT OK == 0

HOLD_FLASH 1
