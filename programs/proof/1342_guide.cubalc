# GUIDE / PLAYGUIDE — full discovery playbook plate

GUIDE cap
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"
ASSERT GUIDE_RELATED_N >= 3
ASSERT GUIDE_TIPS_N >= 2
ASSERT GUIDE_FORMS_N >= 3
SYS HASI "HASFORM"
ASSERT LAST_N == 1
# plate JSON schema
GUIDE cap
SYS HASI "cubalc.guide.v1"
ASSERT LAST_N == 1
SYS HASI "HASFORM"
ASSERT LAST_N == 1

# bags
GUIDE plate
ASSERT OK == 1
ASSERT TOPIC_NAME == "plate"
SYS HASI "SETP"
ASSERT LAST_N == 1
ASSERT GUIDE_RELATED_N >= 3
ASSERT GUIDE_TIPS_N >= 1

# alias + synonym
PLAYGUIDE forms
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"

GUIDE mesh
ASSERT OK == 1
ASSERT TOPIC_NAME == "p2p"
SYS HASI "protect"
ASSERT LAST_N == 1

# default general
GUIDE
ASSERT OK == 1
ASSERT TOPIC_NAME == "general"
SYS HASI "VERSION"
ASSERT LAST_N == 1

# chain after FORMTOPICS
FORMTOPICS HASFORM
SYS NTH 0
GUIDE LAST
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"

# miss soft
GUIDE zzz_nope
ASSERT OK == 0
CLEAR_ERR

# EACH + GUIDE
EACH TOPIC AS t
  GUIDE t
  ASSERT OK == 1
  ASSERT GUIDE_RELATED_N >= 3
END

PASS
PRINT "1342_guide: PASS"
