# Proof 524 — digit-6 stack imm 32-bit field max+eq: SMAX32N SEQ32N SNE32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMAX32N: max(0x10000000, 0xC0000000) → 0xC0000000
PUSH 0x10000000
SMAX32N 0xC0000000 0
POP x
ASSERT x == 0xC0000000

# keeps larger
CLEARSTACK
PUSH 0xF0000000
MAX32N 0x20000000 0
POP x
ASSERT x == 0xF0000000

# high preserved: low 0x7711 max 0x8000 → 0x8000 low
CLEARSTACK
PUSH 0x1122334400007711
SMAX32N 0x8000 0
POP x
ASSERT x == 0x1122334400008000

# STACKMAX32N n1: high 0x20000000 max 0x90000000 → high 0x90000000
CLEARSTACK
PUSH 0x2000000000000000
STACKMAX32N 0x90000000 1
POP x
ASSERT x == 0x9000000000000000

# SGE32N alias max equal
CLEARSTACK
PUSH 0x55555555
SGE32N 0x55555555 0
POP x
ASSERT x == 0x55555555

# SEQ32N: equal → 1
CLEARSTACK
PUSH 0xABCD1234
SEQ32N 0xABCD1234 0
POP x
ASSERT x == 1

# unequal → 0
CLEARSTACK
PUSH 0xABCD1234
EQ32N 0xABCD1235 0
POP x
ASSERT x == 0

# high preserved eq: low 0x7742 == 0x7742 → low 1
CLEARSTACK
PUSH 0x1122334400007742
SEQ32N 0x7742 0
POP x
ASSERT x == 0x1122334400000001

# STACKEQ32N n1: high 0x77777777 == 0x77777777 → high 1
CLEARSTACK
PUSH 0x7777777700000000
STACKEQ32N 0x77777777 1
POP x
ASSERT x == 0x0000000100000000

# SNE32N: unequal → 1
CLEARSTACK
PUSH 0x10000000
SNE32N 0x10000001 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0x10000000
NE32N 0x10000000 0
POP x
ASSERT x == 0

# high preserved ne: low 0x77FF != 0 → low 1
CLEARSTACK
PUSH 0x11223344000077FF
SNE32N 0 0
POP x
ASSERT x == 0x1122334400000001

# STACKNE32N n1: high 0x55555555 != 0x55555555 → 0
CLEARSTACK
PUSH 0x5555555500000000
STACKNE32N 0x55555555 1
POP x
ASSERT x == 0x0000000000000000

# SCMPEQ32N / SCMPNE32N aliases
CLEARSTACK
PUSH 0xFFFFFFFF
SCMPEQ32N 0xFFFFFFFF 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0xFFFFFFFF
SCMPNE32N 0xFFFFFFFE 0
POP x
ASSERT x == 1

HOLD_FLASH 0
