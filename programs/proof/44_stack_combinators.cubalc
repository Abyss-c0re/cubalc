# Proof 44 — stack combinators digit-4: QDUP NDUP SREVERSE
HOLD_FLASH 1
SCIENCE LOAD

# QDUP nonzero
CLEARSTACK
PUSH 7
QDUP
ASSERT SP == 2
ASSERT LAST_N == 7

# QDUP zero — no dup
CLEARSTACK
PUSH 0
QDUP
ASSERT SP == 1
ASSERT LAST_N == 0

# DUPNZ alias
CLEARSTACK
PUSH 3
DUPNZ
ASSERT SP == 2

# NDUP 3
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
NDUP 3
ASSERT SP == 6
ASSERT LAST_N == 3
DROP
PEEK
ASSERT LAST_N == 2
DROP
PEEK
ASSERT LAST_N == 1
DROP
PEEK
ASSERT LAST_N == 3

# NDUP under-depth
CLEARSTACK
PUSH 1
NDUP 3
ASSERT OK == 0

# SREVERSE whole stack
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
SREVERSE
ASSERT SP == 4
ASSERT LAST_N == 1
DROP
PEEK
ASSERT LAST_N == 2
DROP
PEEK
ASSERT LAST_N == 3
DROP
PEEK
ASSERT LAST_N == 4

# SREVERSE n — top 2 only
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
SREVERSE 2
ASSERT SP == 3
ASSERT LAST_N == 20
DROP
PEEK
ASSERT LAST_N == 30
DROP
PEEK
ASSERT LAST_N == 10

# empty reverse ok
CLEARSTACK
SREVERSE
ASSERT OK == 1
ASSERT SP == 0

# compose: reverse then fold sum
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
SREVERSE
SSUM
ASSERT LAST_N == 6

# compose QDUP with select
CLEARSTACK
PUSH 5
QDUP
# stack 5 5; use as else then? need cond
PUSH 1
SSEL
ASSERT LAST_N == 5

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof44_stack_combinators" LAST_N SP
