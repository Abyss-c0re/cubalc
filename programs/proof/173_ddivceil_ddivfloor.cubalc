# Proof 173 — digit-2 dual-stack div modes: DDIVCEIL DDIVFLOOR
HOLD_FLASH 1
SCIENCE LOAD

# DDIVCEIL — positive
CLEARSTACK
PUSH 10
PUSH 7
PUSH 3
PUSH 2
DDIVCEIL
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# exact
CLEARSTACK
PUSH 9
PUSH 8
PUSH 3
PUSH 4
2DIVCEIL
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# /0 → 0
CLEARSTACK
PUSH 5
PUSH 5
PUSH 0
PUSH 2
PAIRDIVCEIL
POP y
POP x
ASSERT x == 0
ASSERT y == 3

# mixed signs (match SDIVCEIL: trunc toward zero when signs differ)
CLEARSTACK
PUSH -7
PUSH 7
PUSH 3
PUSH -3
DCEILDIV
POP y
POP x
ASSERT x == -2
ASSERT y == -2

# DDIVFLOOR — positive
CLEARSTACK
PUSH 10
PUSH 7
PUSH 3
PUSH 2
DDIVFLOOR
POP y
POP x
ASSERT x == 3
ASSERT y == 3

# floor toward -inf for negatives
CLEARSTACK
PUSH -7
PUSH -5
PUSH 3
PUSH 2
2DIVFLOOR
POP y
POP x
ASSERT x == -3
ASSERT y == -3

# exact
CLEARSTACK
PUSH -8
PUSH 9
PUSH 4
PUSH 3
PAIRDIVFLOOR
POP y
POP x
ASSERT x == -2
ASSERT y == 3

# /0 → 0
CLEARSTACK
PUSH 1
PUSH 1
PUSH 0
PUSH 0
DFLOORDIV
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fails
CLEARSTACK
DDIVCEIL
ASSERT OK == 0
CLEARSTACK
DDIVFLOOR
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2DIVCEIL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof173_ddivceil_ddivfloor" LAST_N SP
