# Proof 490 — digit-1 dual-stack imm 8-bit field unary+rotate: DNOT8N DROL8N DROR8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DNOT8N n0: 0x00 → 0xFF ; 0x0F → 0xF0
PUSH 0x00
PUSH 0x0F
DNOT8N 0
POP y
POP x
ASSERT x == 255
ASSERT y == 240

# high preserved not
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNOT8N 0
POP y
POP x
ASSERT x == 0x1122334455667777
ASSERT y == 0x99AABBCCDDEEFFFF

# S2NOT8N n1: byte1 of 0x..AA88 is AA → ~AA=55 → 0x..5588
CLEARSTACK
PUSH 0xAA88
PUSH 0x5500
S2NOT8N 1
POP y
POP x
ASSERT x == 0x5588
ASSERT y == 0xAA00

# DINV8N alias: 0xFF → 0
CLEARSTACK
PUSH 0xFF
PUSH 0x80
DINV8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 127

# DROL8N k=1 n0: 0x81 → 0x03 ; 0x01 → 0x02
CLEARSTACK
PUSH 0x81
PUSH 0x01
DROL8N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved rol
CLEARSTACK
PUSH 0x1122334455667781
PUSH 0x99AABBCCDDEEFF80
PAIRROL8N 1 0
POP y
POP x
ASSERT x == 0x1122334455667703
ASSERT y == 0x99AABBCCDDEEFF01

# S2ROL8N n1: byte1 of 0x..0180 is 01 rotl1 → 02 → 0x..0280
CLEARSTACK
PUSH 0x0180
PUSH 0x8100
S2ROL8N 1 1
POP y
POP x
ASSERT x == 0x0280
ASSERT y == 0x0300

# DROR8N k=1 n0: 0x02 → 0x01 ; 0x01 → 0x80
CLEARSTACK
PUSH 0x02
PUSH 0x01
DROR8N 1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 128

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA5
PUSH 0x3C
DROL8N 3 0
DROR8N 3 0
POP y
POP x
ASSERT x == 0xA5
ASSERT y == 0x3C

# k masked: k=9 → k&7=1
CLEARSTACK
PUSH 0x01
PUSH 0x80
PAIRROR8N 9 0
POP y
POP x
ASSERT x == 128
ASSERT y == 64

# STACK2ROR8N n1: byte1 of 0x..0200 is 02 → rotr1 → 01 → 0x..0100
CLEARSTACK
PUSH 0x0200
PUSH 0x0400
STACK2ROR8N 1 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0200

# DROTL8N alias
CLEARSTACK
PUSH 0x10
PUSH 0x10
DROTL8N 1 0
POP y
POP x
ASSERT x == 32
ASSERT y == 32

HOLD_FLASH 0
