# Proof 95 — digit-2 math: MOBIUS + RADICAL + ISSQUAREFREE
HOLD_FLASH 1
SCIENCE LOAD

# MOBIUS
ASSERT MOBIUS(1) == 1
ASSERT MOBIUS(2) == -1
ASSERT MOBIUS(3) == -1
ASSERT MOBIUS(6) == 1
ASSERT MOBIUS(30) == -1
ASSERT MOBIUS(4) == 0
ASSERT MOBIUS(12) == 0
ASSERT MOBIUS(0) == 0
ASSERT MU(6) == 1

# RADICAL
ASSERT RADICAL(1) == 1
ASSERT RADICAL(12) == 6
ASSERT RADICAL(18) == 6
ASSERT RADICAL(30) == 30
ASSERT RADICAL(8) == 2
ASSERT RAD(12) == 6

# ISSQUAREFREE
ASSERT ISSQUAREFREE(1) == 1
ASSERT ISSQUAREFREE(6) == 1
ASSERT ISSQUAREFREE(30) == 1
ASSERT ISSQUAREFREE(12) == 0
ASSERT ISSQUAREFREE(4) == 0
ASSERT SQFREE(10) == 1
ASSERT SQFREE(0) == 0

# stack duals
PUSH 30
SMOBIUS
ASSERT LAST_N == -1
PUSH 12
SRAD
ASSERT LAST_N == 6
PUSH 10
SISSQFREE
ASSERT LAST_N == 1
PUSH 12
SSQFREE
ASSERT LAST_N == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof95_mobius_radical" LAST_N
