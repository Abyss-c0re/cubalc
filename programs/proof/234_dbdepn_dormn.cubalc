# Proof 234 — digit-6 dual-stack data-path imm deposit + low-n or/xor: DBDEPN DORMN DXORMN
HOLD_FLASH 1
SCIENCE LOAD

# DBDEPN — deposit field into both lanes
CLEARSTACK
PUSH 0
PUSH 0
DBDEPN 0xAB 8
POP y
POP x
ASSERT x == 0xAB00
ASSERT y == 0xAB00

CLEARSTACK
PUSH 0xFFFF
PUSH 0x0000
2BDEPN 0x12 0
POP y
POP x
ASSERT x == 0xFF12
ASSERT y == 0x0012

# PAIRBDEPN mid-word deposit
CLEARSTACK
PUSH 0xFF00FF00
PUSH 0x00FF00FF
PAIRBDEPN 0xA5 8
POP y
POP x
ASSERT x == 0xFF00A500
ASSERT y == 0x00FFA5FF

# round-trip with DBEXTN
CLEARSTACK
PUSH 0
PUSH 0
DBDEPN 0x5A 4
POP y
POP x
CLEARSTACK
PUSH x
PUSH y
DBEXTN 4 8
POP ey
POP ex
ASSERT ex == 0x5A
ASSERT ey == 0x5A

# DORMN — set low n bits
CLEARSTACK
PUSH 0xF0
PUSH 0x00
DORMN 4
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0x0F

CLEARSTACK
PUSH 0x1000
PUSH 0x2000
2ORMN 8
POP y
POP x
ASSERT x == 0x10FF
ASSERT y == 0x20FF

# DSETLN alias / n=0 noop / n=64 all-ones
CLEARSTACK
PUSH 0x55
PUSH 0xAA
DSETLN 0
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0xAA

CLEARSTACK
PUSH 0
PUSH 1
DORMN 64
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DXORMN — toggle low n bits
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
DXORMN 4
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0x00

CLEARSTACK
PUSH 0x00
PUSH 0xFF
2XORMN 8
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0x00

# DFLIPLN alias / double-toggle identity
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
DFLIPLN 12
POP y
POP x
CLEARSTACK
PUSH x
PUSH y
DXORMN 12
POP y2
POP x2
ASSERT x2 == 0x1234
ASSERT y2 == 0xABCD

# soft fails
CLEARSTACK
DBDEPN 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DORMN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DXORMN 4
ASSERT OK == 0

HOLD_FLASH 1
