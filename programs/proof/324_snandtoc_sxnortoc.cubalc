# Proof 324 — digit-6 inverted bitwise TOC: SNANDTOC SNORTOC SXNORTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SNANDTOC: ~(15 & 6) = ~(6) = ~6
CELLSET 1 15
PUSH 1
PUSH 6
SNANDTOC
ASSERT LAST_N == -7
ASSERT CELL(1) == -7
POP a
ASSERT a == -7

# SNANDTOCELL alias: ~(0 & 1) = ~0 = -1
CELLSET 2 0
PUSH 2
PUSH 1
SNANDTOCELL
ASSERT LAST_N == -1
ASSERT CELL(2) == -1
POP

# SNORTOC: ~(1 | 2) = ~(3) = -4
CELLSET 3 1
PUSH 3
PUSH 2
SNORTOC
ASSERT LAST_N == -4
ASSERT CELL(3) == -4
POP

# BNORTOC alias
CELLSET 4 0
PUSH 4
PUSH 0
BNORTOC
ASSERT LAST_N == -1
ASSERT CELL(4) == -1
POP

# SXNORTOC: ~(15 ^ 7) = ~(8) = -9
CELLSET 5 15
PUSH 5
PUSH 7
SXNORTOC
ASSERT LAST_N == -9
ASSERT CELL(5) == -9
POP

# SEQUIVTOC alias: ~(255 ^ 255) = ~0 = -1
CELLSET 6 255
PUSH 6
PUSH 255
SEQUIVTOC
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# soft fails
CLEARSTACK
SNANDTOC
ASSERT OK == 0
SNORTOC
ASSERT OK == 0
SXNORTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof324_snandtoc_sxnortoc" LAST_N SP
HOLD_FLASH 1
