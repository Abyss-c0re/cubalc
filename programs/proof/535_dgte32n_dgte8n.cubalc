# Proof 535 — digit-0 dual-stack imm field GTE: DGTE32N DGTE16N DGTE8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DGTE32N: greater → 1 ; less → 0
PUSH 0xC0000000
PUSH 0x10000000
DGTE32N 0x10000000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# equal → 1
CLEARSTACK
PUSH 0xABCD1234
PUSH 0xABCD1234
PAIRGTE32N 0xABCD1234 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# less only
CLEARSTACK
PUSH 0x10000000
PUSH 0x0
DGTE32N 0xC0000000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved: low 0x8000 >= 0x1000 → 1
CLEARSTACK
PUSH 0x1122334400008000
PUSH 0x99AABBCC00000500
DGTE32N 0x1000 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000000

# S2GTE32N n1
CLEARSTACK
PUSH 0x9000000000000000
PUSH 0x0500000000000000
S2GTE32N 0x10000000 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# DCMPGE32N / DGEQ32N aliases
CLEARSTACK
PUSH 2
PUSH 1
DCMPGE32N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 3
DGEQ32N 2 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# unsigned high bit: 0x80000000 >= 0x7FFFFFFF → 1
CLEARSTACK
PUSH 0x80000000
PUSH 0x7FFFFFFF
DGTE32N 0x7FFFFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DGTE16N
CLEARSTACK
PUSH 0xF000
PUSH 0x2000
DGTE16N 0x2000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x5555
PUSH 0x5555
PAIRGTE16N 0x5555 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x10
PUSH 0x05
DGTE16N 0x20 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved half
CLEARSTACK
PUSH 0xAABB8000
PUSH 0x11221000
DGTE16N 0x1000 0
POP y
POP x
ASSERT x == 0xAABB0001
ASSERT y == 0x11220001

# STACK2GTE16N n1
CLEARSTACK
PUSH 0x90000000
PUSH 0x05000000
S2GTE16N 0x1000 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

# DGTE8N
CLEARSTACK
PUSH 0xF0
PUSH 0x20
DGTE8N 0x20 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x55
PUSH 0x55
PAIRGTE8N 0x55 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x10
PUSH 0x05
DGTE8N 0x20 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved byte
CLEARSTACK
PUSH 0x99AA0080
PUSH 0x11220010
DGTE8N 0x10 0
POP y
POP x
ASSERT x == 0x99AA0001
ASSERT y == 0x11220001

# STACK2GTE8N n1
CLEARSTACK
PUSH 0x00009000
PUSH 0x00000500
S2GTE8N 0x10 1
POP y
POP x
ASSERT x == 0x00000100
ASSERT y == 0x00000000

# DCMPGE8N
CLEARSTACK
PUSH 2
PUSH 1
DCMPGE8N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# unsigned: 0x80 >= 0x7F → 1
CLEARSTACK
PUSH 0x80
PUSH 0x7F
DGTE8N 0x7F 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

HOLD_FLASH 0
