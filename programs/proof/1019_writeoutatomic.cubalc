# WRITEOUTATOMIC / SAFEWRITEOUT — ENSUREPARENT + temp+rename write
# Crash-safer nested plate updates without DIRNAME + WRITEATOMIC glue.

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS PID
SYS STR LAST_N
LET pid = LAST
SYS JOIN td "mi_woa_"
SYS CAT LAST pid
LET root = LAST
SYS MKDIR root
ASSERT OK == 1

# nested missing parents
SYS JOIN root "a/b/c/status.json"
LET f = LAST
WRITEOUTATOMIC f "{\"ok\":1}"
ASSERT OK == 1
ASSERT WRITEOUTATOMIC_CREATED == 1
ASSERT LAST_N > 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "status.json"
ASSERT LAST_N == 1
SYS ENDS WRITEOUTATOMIC_PARENT "c"
ASSERT LAST_N == 1
SYS ISFILE LAST
ASSERT LAST_N == 1
# no leftover temp
SYS PATHGLOB root "*.cubalc-tmp.*"
ASSERT LAST_N == 0
SYS READ f
SYS HAS LAST "ok"
ASSERT LAST_N == 1

# overwrite atomically — CREATED=0
WRITEOUTATOMIC f "{\"v\":2}"
ASSERT OK == 1
ASSERT WRITEOUTATOMIC_CREATED == 0
SYS READ f
SYS HAS LAST "v"
ASSERT LAST_N == 1
SYS HAS LAST "ok"
ASSERT LAST_N == 0

# SAFEWRITEOUT alias + numeric
SYS JOIN root "x/y/n.json"
LET npath = LAST
SAFEWRITEOUT npath 7
ASSERT OK == 1
ASSERT WRITEOUTATOMIC_CREATED == 1
SYS READ LAST
SYS EQS LAST "7"
ASSERT LAST_N == 1

# SYS form
SYS JOIN root "sys/deep/plate.json"
LET sp = LAST
SYS WRITEOUTATOMIC sp "{\"sys\":1}"
ASSERT OK == 1
SYS ENDS LAST "plate.json"
ASSERT LAST_N == 1
SYS READ sp
SYS HAS LAST "sys"
ASSERT LAST_N == 1

# empty path soft
WRITEOUTATOMIC "" "x"
ASSERT OK == 0
LET e = LAST_ERR
SYS HAS e "empty"
ASSERT LAST_N == 1

# cleanup
SYS WALK root
SYS RMALL LAST
SYS RM root

PRINT "writeoutatomic ok"
