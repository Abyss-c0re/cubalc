# TOPIC — one plate triad (TIPS + FORMSFOR + SNIP)

TOPIC
ASSERT OK == 1
ASSERT TOPIC_NAME == "general"
ASSERT TOPIC_TIPS_N >= 3
ASSERT TOPIC_FORMS_N >= 3
ASSERT TOPIC_SNIP_N >= 3
SYS HASI "cubalc.topic.v1"
ASSERT LAST_N == 1
SYS HASI "VERSION"
ASSERT LAST_N == 1

TOPIC cap
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"
ASSERT TOPIC_TIPS_N >= 3
ASSERT TOPIC_FORMS_N >= 5
SYS HASI "HASFORM"
ASSERT LAST_N == 1
# bags set
SYS HASI "INCLUDE cap_boot"
ASSERT LAST_N == 1
SYS EMPTY TOPIC_SNIP
ASSERT LAST_N == 0

TOPICCARD plate
ASSERT OK == 1
ASSERT TOPIC_NAME == "plate"
SYS HASI "SETP"
ASSERT LAST_N == 1
SYS HASI "NEEDP"
ASSERT LAST_N == 1

TOPIC lib
ASSERT OK == 1
SYS HASI "LISTLIBS"
ASSERT LAST_N == 1
SYS HASI "RECIPE"
ASSERT LAST_N == 1

# alias forms → cap
TOPIC forms
ASSERT OK == 1
ASSERT TOPIC_NAME == "cap"

# soft miss
TOPIC zzz_nope
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1333_topic: PASS"
