// 2117_life_cell_stream.cubalc
// Proof 2117: life_cell stream - collective NC chain-stream after MIGRATE.
// Pay min(n,atp,reserve) -> heat+n reserve-n; age/energy/pmf/thr/sp/pcr held.
// Continuum after migrate. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 24 0
ENTITY poor OF Cell 1 20 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 16 0
ENTITY twin OF Cell 1 18 0
ENTITY ceil OF Cell 1 20 0
ENTITY starved OF Cell 1 30 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND ceil set_threshold 10
SEND starved set_threshold 10
SEND gate pulse 6
SEND gate photosynth 14
SEND gate glycolyse 12
SEND gate pump 10
SEND gate photophos 10
GETF gate age
ASSERT LAST_N == 6 "str a6"
GETF gate atp
ASSERT LAST_N >= 20 "str atp"
GETF gate heat
LET hbase = LAST_N
GETF gate energy
LET ebase = LAST_N
GETF gate reserve
LET rbase = LAST_N
GETF gate threshold
ASSERT LAST_N == 10 "str thr10"
GETF gate setpoint
ASSERT LAST_N == 10 "str sp10"
GETF gate pcr
ASSERT LAST_N == 0 "str pcr0"

SEND gate converge 4
ASSERT LAST_N == 4 "str prece4"
SEND gate extend 2
ASSERT LAST_N == 2 "str preext2"
SEND gate fold 2
ASSERT LAST_N == 2 "str prefold2"
SEND gate zip 2
ASSERT LAST_N == 2 "str prezip2"
SEND gate crest 2
ASSERT LAST_N == 2 "str precrest2"
SEND gate migrate 2
ASSERT LAST_N == 2 "str premig2"
GETF gate energy
LET e1 = LAST_N
GETF gate heat
LET h1 = LAST_N
GETF gate atp
LET at1 = LAST_N
GETF gate pmf
LET p1 = LAST_N
GETF gate reserve
LET r1 = LAST_N
GETF gate threshold
LET t1 = LAST_N
GETF gate setpoint
LET s1 = LAST_N
GETF gate pcr
LET c1 = LAST_N
GETF gate age
LET a1 = LAST_N
ASSERT at1 >= 3 "str atp3"
ASSERT r1 >= 3 "str r3"

SEND gate stream 3
ASSERT LAST_N == 3 "str 3"
GETF gate heat
ASSERT LAST_N == h1 + 3 "str h+3"
GETF gate reserve
ASSERT LAST_N == r1 - 3 "str r-3"
GETF gate energy
ASSERT LAST_N == e1 "str e held"
GETF gate atp
ASSERT LAST_N == at1 - 3 "str atp-3"
GETF gate threshold
ASSERT LAST_N == t1 "str thr held"
GETF gate setpoint
ASSERT LAST_N == s1 "str sp held"
GETF gate age
ASSERT LAST_N == a1 "str age held"
GETF gate pmf
ASSERT LAST_N == p1 "str pmf held"
GETF gate pcr
ASSERT LAST_N == c1 "str pcr held"

SEND gate photosynth 6
SEND gate glycolyse 4
SEND gate pump 4
SEND gate photophos 4
SEND gate converge 3
GETF gate atp
LET at2 = LAST_N
GETF gate heat
LET h2 = LAST_N
GETF gate reserve
LET r2 = LAST_N
GETF gate energy
LET e2 = LAST_N
ASSERT at2 >= 2 "str atp2"
ASSERT r2 >= 2 "str r2b"
SEND gate stream 2
ASSERT LAST_N == 2 "str 2b"
GETF gate heat
ASSERT LAST_N == h2 + 2 "str h+2b"
GETF gate reserve
ASSERT LAST_N == r2 - 2 "str r-2b"
GETF gate energy
ASSERT LAST_N == e2 "str e2 held"
GETF gate atp
ASSERT LAST_N == at2 - 2 "str atp-2b"

SEND ceil pulse 4
SEND ceil photosynth 8
SEND ceil glycolyse 4
SEND ceil pump 4
SEND ceil photophos 4
SEND ceil converge 2
GETF ceil reserve
LET cr = LAST_N
ASSERT cr >= 2 "ceil r>=2"
GETF ceil atp
LET ca = LAST_N
ASSERT ca >= 5 "ceil atp"
GETF ceil heat
LET ch = LAST_N
// clamp take to min(5,atp,reserve)=reserve if reserve < 5 and atp ok
LET want = cr
IF want > 5 THEN
  LET want = 5
END
IF want > ca THEN
  LET want = ca
END
SEND ceil stream 5
ASSERT LAST_N == want "ceil str clamp"
GETF ceil reserve
ASSERT LAST_N == cr - want "ceil r after"
GETF ceil heat
ASSERT LAST_N == ch + want "ceil h+want"
GETF ceil atp
ASSERT LAST_N == ca - want "ceil atp-want"

SEND dead stream 3
ASSERT LAST_N == 0 "dead str0"
GETF dead heat
ASSERT LAST_N == 0 "dead h0"
GETF dead energy
ASSERT LAST_N == 20 "dead e20"
GETF dead reserve
ASSERT LAST_N == 0 "dead r0"

SEND poor pulse 4
SEND poor photosynth 8
SEND poor glycolyse 6
SEND poor pump 4
SEND poor photophos 4
GETF poor atp
LET pa0 = LAST_N
GETF poor heat
LET ph0 = LAST_N
GETF poor reserve
LET pr0 = LAST_N
SEND poor stream 0
ASSERT LAST_N == 0 "n0 str"
SEND poor stream -3
ASSERT LAST_N == 0 "neg str"
GETF poor atp
ASSERT LAST_N == pa0 "poor atp held"
GETF poor heat
ASSERT LAST_N == ph0 "poor h held"
GETF poor reserve
ASSERT LAST_N == pr0 "poor r held"

SEND starved pulse 3
SEND starved photosynth 4
SEND starved converge 2
GETF starved reserve
LET sr_pre = LAST_N
ASSERT sr_pre >= 2 "star r pre"
GETF starved atp
LET sa = LAST_N
IF sa > 0 THEN
  SEND starved migrate sa
END
GETF starved atp
ASSERT LAST_N == 0 "star atp0"
GETF starved energy
LET se = LAST_N
GETF starved heat
LET sh0 = LAST_N
GETF starved reserve
LET sr0 = LAST_N
GETF starved setpoint
LET ss0 = LAST_N
SEND starved stream 2
ASSERT LAST_N == 0 "star no atp"
GETF starved energy
ASSERT LAST_N == se "star e held"
GETF starved heat
ASSERT LAST_N == sh0 "star h held"
GETF starved reserve
ASSERT LAST_N == sr0 "star r held"
GETF starved setpoint
ASSERT LAST_N == ss0 "star sp held"

SEND g0 pulse 5
SEND g0 photosynth 10
SEND g0 glycolyse 8
SEND g0 pump 6
SEND g0 photophos 6
SEND g0 converge 3
SEND g0 quiesce 1
GETF g0 quiescent
ASSERT LAST_N == 1 "g0 q1"
GETF g0 atp
LET ga = LAST_N
GETF g0 reserve
LET gr = LAST_N
GETF g0 heat
LET gh = LAST_N
GETF g0 energy
LET ge = LAST_N
ASSERT ga >= 2 "g0 atp"
ASSERT gr >= 2 "g0 r"
SEND g0 stream 2
ASSERT LAST_N == 2 "g0 str2"
GETF g0 ready
ASSERT LAST_N == 0 "g0 ready0"
GETF g0 heat
ASSERT LAST_N == gh + 2 "g0 h+2"
GETF g0 reserve
ASSERT LAST_N == gr - 2 "g0 r-2"
GETF g0 energy
ASSERT LAST_N == ge "g0 e held"
GETF g0 atp
ASSERT LAST_N == ga - 2 "g0 atp-2"

SEND twin pulse 5
SEND twin photosynth 12
SEND twin glycolyse 10
SEND twin pump 8
SEND twin photophos 8
SEND twin set_threshold 10
SEND twin set_setpoint 10
SEND twin converge 3
SEND twin extend 1
SEND twin fold 1
SEND twin zip 1
SEND twin crest 1
SEND twin migrate 1
GETF twin setpoint
LET ts = LAST_N
GETF twin threshold
LET tt = LAST_N
GETF twin reserve
LET tr = LAST_N
GETF twin heat
LET th = LAST_N
GETF twin energy
LET te = LAST_N
GETF twin atp
LET ta = LAST_N
GETF twin pmf
LET tp = LAST_N
GETF twin pcr
LET tc = LAST_N
GETF twin age
LET tage = LAST_N
ASSERT tr >= 2 "twin r"
SEND twin stream 2
ASSERT LAST_N == 2 "twin str2"
GETF twin heat
ASSERT LAST_N == th + 2 "twin h+2"
GETF twin reserve
ASSERT LAST_N == tr - 2 "twin r-2"
GETF twin setpoint
ASSERT LAST_N == ts "twin sp held"
GETF twin threshold
ASSERT LAST_N == tt "twin thr held"
GETF twin energy
ASSERT LAST_N == te "twin e held"
GETF twin atp
ASSERT LAST_N == ta - 2 "twin atp-2"
GETF twin pmf
ASSERT LAST_N == tp "twin pmf held"
GETF twin pcr
ASSERT LAST_N == tc "twin pcr held"
GETF twin age
ASSERT LAST_N == tage "twin age held"

SEND gate set_threshold 10
GETF gate energy
LET ge2 = LAST_N
GETF gate ready
LET grd = LAST_N
GETF gate threshold
LET gt = LAST_N
IF ge2 >= gt THEN
  ASSERT grd == 1 "ready1 when e>=thr"
END

ASSERT 1 == 1 "stream proof sealed"
