# Proof 174 — digit-8 stack depth: 2RROT + 6DUP + 6DROP
HOLD_FLASH 1
SCIENCE LOAD

# 2RROT: a b c d e f → e f a b c d
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
2RROT
ASSERT SP == 6
POP f
ASSERT f == 4
POP e
ASSERT e == 3
POP d
ASSERT d == 2
POP c
ASSERT c == 1
POP b
ASSERT b == 6
POP a
ASSERT a == 5

# DRROT alias — inverse of 2ROT on same triple of pairs
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
PUSH 50
PUSH 60
2ROT
2RROT
POP p0
ASSERT p0 == 60
POP p1
ASSERT p1 == 50
POP p2
ASSERT p2 == 40
POP p3
ASSERT p3 == 30
POP p4
ASSERT p4 == 20
POP p5
ASSERT p5 == 10

# RROT2 alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
RROT2
POP x
ASSERT x == 4
POP y
ASSERT y == 3
POP z
ASSERT z == 2
POP u
ASSERT u == 1
POP v
ASSERT v == 6
POP w
ASSERT w == 5

# 6DUP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6DUP
ASSERT SP == 12
POP a
ASSERT a == 6
POP b
ASSERT b == 5
POP c
ASSERT c == 4
POP d
ASSERT d == 3
POP e
ASSERT e == 2
POP f
ASSERT f == 1
POP g
ASSERT g == 6
POP h
ASSERT h == 5
POP i
ASSERT i == 4
POP j
ASSERT j == 3
POP k
ASSERT k == 2
POP l
ASSERT l == 1

# HDUP alias
CLEARSTACK
PUSH 7
PUSH 8
PUSH 9
PUSH 10
PUSH 11
PUSH 12
HDUP
ASSERT SP == 12

# 6DROP
CLEARSTACK
PUSH 100
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6DROP
ASSERT SP == 1
PEEK
ASSERT LAST_N == 100

# DROP6 alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
DROP6
ASSERT SP == 1
PEEK
ASSERT LAST_N == 1

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
2RROT
ASSERT OK == 0
CLEARSTACK
PUSH 1
6DUP
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
6DROP
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof174_2rrot_6dup" LAST_N SP
