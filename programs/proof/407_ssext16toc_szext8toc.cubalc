# Proof 407 — digit-9 stack dual fixed-width extend TOC: SSEXT16TOC SSEXT32TOC SZEXT8TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SZEXT8TOC: zero-extend low 8 of 0xABCD=43981 → 0xCD=205
CELLSET 1 43981
PUSH 1
SZEXT8TOC
ASSERT LAST_N == 205
ASSERT CELL(1) == 205
POP

# ZEXT8TOC alias: 0xFF → 255
CELLSET 2 255
PUSH 2
ZEXT8TOC
ASSERT LAST_N == 255
ASSERT CELL(2) == 255
POP

# SSEXT16TOC: 0xFFFF → -1
CELLSET 3 65535
PUSH 3
SSEXT16TOC
ASSERT LAST_N == -1
ASSERT CELL(3) == -1
POP

# SEXT16TOC alias: 0x8000 → -32768
CELLSET 4 32768
PUSH 4
SEXT16TOC
ASSERT LAST_N == -32768
ASSERT CELL(4) == -32768
POP

# SSEXTWTOC: 0x7FFF → 32767
CELLSET 5 32767
PUSH 5
SSEXTWTOC
ASSERT LAST_N == 32767
ASSERT CELL(5) == 32767
POP

# SSEXT32TOC: 0xFFFFFFFF → -1
CELLSET 6 4294967295
PUSH 6
SSEXT32TOC
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# SEXT32TOC: 0x80000000 → -2147483648
CELLSET 7 2147483648
PUSH 7
SEXT32TOC
ASSERT LAST_N == -2147483648
ASSERT CELL(7) == -2147483648
POP

# SSEXTLTOC: 0x7FFFFFFF → 2147483647
CELLSET 8 2147483647
PUSH 8
SSEXTLTOC
ASSERT LAST_N == 2147483647
ASSERT CELL(8) == 2147483647
POP

# soft short stack OK=0
CLEARSTACK
SSEXT16TOC
ASSERT OK == 0
SSEXT32TOC
ASSERT OK == 0
SZEXT8TOC
ASSERT OK == 0

PRINT "407_ssext16toc_szext8toc OK"
