# Proof 340 — digit-7 unary mutator TOC: SINCTOC SDECTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SINCTOC
CELLSET 1 10
PUSH 1
SINCTOC
ASSERT LAST_N == 11
ASSERT CELL(1) == 11
POP a
ASSERT a == 11

# INCTOC from zero
CELLSET 2 0
PUSH 2
INCTOC
ASSERT LAST_N == 1
ASSERT CELL(2) == 1
POP

# SINCAT chain
CELLSET 3 5
PUSH 3
SINCAT
ASSERT LAST_N == 6
POP
PUSH 3
SINCTOC
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# SDECTOC
CELLSET 4 10
PUSH 4
SDECTOC
ASSERT LAST_N == 9
ASSERT CELL(4) == 9
POP

# DECTOC from 1 → 0
CELLSET 5 1
PUSH 5
DECTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SDECAT negative
PUSH 6
PUSH (-2)
SSETCELL
POP
PUSH 6
SDECAT
ASSERT LAST_N == (-3)
ASSERT CELL(6) == (-3)
POP

# soft fails
CLEARSTACK
SINCTOC
ASSERT OK == 0
SDECTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof340_sinctoc_sdectoc" LAST_N SP
HOLD_FLASH 1
