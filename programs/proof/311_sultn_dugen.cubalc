# Proof 311 — digit-3 imm unsigned compare: SULTN SUGTN SULEN SUGEN DULTN DUGTN DULEN DUGEN
HOLD_FLASH 1
SCIENCE LOAD

# SULTN — unsigned: high bit is large
CLEARSTACK
PUSH -1
SULTN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0
ULTN -1
POP x
ASSERT x == 1

CLEARSTACK
PUSH 5
SULTN 10
POP x
ASSERT x == 1

# SUGTN
CLEARSTACK
PUSH -1
SUGTN 5
POP x
ASSERT x == 1

CLEARSTACK
PUSH 3
UGTN 3
POP x
ASSERT x == 0

# SULEN
CLEARSTACK
PUSH 5
SULEN 5
POP x
ASSERT x == 1

CLEARSTACK
PUSH -2
ULEN -1
POP x
ASSERT x == 1

# SUGEN
CLEARSTACK
PUSH -1
SUGEN 100
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0
UGEN 1
POP x
ASSERT x == 0

# soft empty
CLEARSTACK
SULTN 1
ASSERT OK == 0
CLEARSTACK
SUGEN 1
ASSERT OK == 0

# DULTN
CLEARSTACK
PUSH 0
PUSH -1
DULTN 5
POP y
POP x
# 0 <u 5 → 1; -1 (maxu) <u 5 → 0
ASSERT x == 1
ASSERT y == 0

# DUGTN
CLEARSTACK
PUSH -1
PUSH 2
DUGTN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DULEN
CLEARSTACK
PUSH 5
PUSH 6
PAIRULEN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DUGEN
CLEARSTACK
PUSH 0
PUSH -1
DUGEN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 2ULTN alias
CLEARSTACK
PUSH 1
PUSH 10
2ULTN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# dual soft
CLEARSTACK
DULTN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DUGEN 1
ASSERT OK == 0

# signed sibling contrast: -1 < 0 signed, but not unsigned
CLEARSTACK
PUSH -1
SLTN 0
POP x
ASSERT x == 1
CLEARSTACK
PUSH -1
SULTN 0
POP x
ASSERT x == 0

HOLD_FLASH 1
