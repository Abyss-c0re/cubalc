# JSONEMPTY / JEMPTY · JSONNONEMPTY / HASKEYS — soft empty/nonempty plate probes
# IF without JSONLEN + CMP glue. LAST kept as plate. Soft on non-object.

HOLD_FLASH 1

# empty object
SYS JSONEMPTY "{}"
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT JSONEMPTY_N == 1
ASSERT JSONEMPTY_LEN == 0

# nonempty
SYS JSONOBJ "a" 1 "b" 2
LET plate = LAST
SYS JSONEMPTY plate
ASSERT LAST_N == 0
ASSERT JSONEMPTY_LEN == 2
SYS JSONNONEMPTY plate
ASSERT LAST_N == 1
ASSERT JSONEMPTY_LEN == 2

# non-object treated empty
SYS JSONEMPTY "not-json"
ASSERT LAST_N == 1
ASSERT OK == 1
SYS JSONEMPTY "[1,2]"
ASSERT LAST_N == 1
SYS JSONNONEMPTY "not-json"
ASSERT LAST_N == 0

# bare on LAST + chain
SYS JSONOBJ "x" 9
SYS JSONEMPTY
ASSERT LAST_N == 0
# LAST still plate
SYS JSONN "x" FROM LAST
ASSERT LAST_N == 9

SYS JSONOBJ "y" 1
SYS JSONNONEMPTY
ASSERT LAST_N == 1

# aliases
SYS JSONEMPTY "{}"
ASSERT LAST_N == 1
SYS JEMPTY "{}"
ASSERT LAST_N == 1
SYS ISEMPTYJSON "{}"
ASSERT LAST_N == 1
SYS HASKEYS plate
ASSERT LAST_N == 1
SYS JNONEMPTY plate
ASSERT LAST_N == 1
SYS JSONHASKEYS plate
ASSERT LAST_N == 1

# IF pattern
SYS JSONEMPTY "{}"
IF LAST_N THEN
  PASS "empty branch"
END
ASSERT OK == 1
SYS JSONNONEMPTY plate
IF LAST_N THEN
  PASS "nonempty branch"
END
ASSERT OK == 1

# after DEL to empty
SYS JSONOBJ "k" 1
LET p1 = LAST
SYS JSONDEL p1 "k"
LET p1 = LAST
SYS JSONEMPTY p1
ASSERT LAST_N == 1
SYS JSONNONEMPTY p1
ASSERT LAST_N == 0

# matches JSONLEN==0
SYS JSONOBJ "a" 1
SYS JSONLEN LAST
ASSERT LAST_N == 1
SYS JSONEMPTY LAST
ASSERT LAST_N == 0
SYS JSONLEN "{}"
ASSERT LAST_N == 0
SYS JSONEMPTY LAST
ASSERT LAST_N == 1

PRINT "jsonempty ok"
ASSERT OK == 1
