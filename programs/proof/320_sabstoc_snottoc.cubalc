# Proof 320 — digit-7 stack↔cell unary: SABSTOC SNEGTOC SNOTTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# set cell 1 = -7 via SSETCELL
PUSH 1
PUSH 7
NEGATE
SSETCELL
POP
ASSERT CELL(1) == -7

# SABSTOC
PUSH 1
SABSTOC
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP a
ASSERT a == 7

# SCELLABS alias on positive
CELLSET 2 5
PUSH 2
SCELLABS
ASSERT LAST_N == 5
ASSERT CELL(2) == 5
POP

# SNEGTOC
CELLSET 3 9
PUSH 3
SNEGTOC
ASSERT LAST_N == -9
ASSERT CELL(3) == -9
POP
PUSH 3
SNEGCELL
ASSERT LAST_N == 9
ASSERT CELL(3) == 9
POP

# SNOTTOC: ~0 == -1
CELLSET 4 0
PUSH 4
SNOTTOC
ASSERT LAST_N == -1
ASSERT CELL(4) == -1
POP

# BINVTOC then SNOTTOCELL restores
CELLSET 5 42
PUSH 5
BINVTOC
POP
PUSH 5
SNOTTOCELL
ASSERT LAST_N == 42
ASSERT CELL(5) == 42
POP

# soft fails
CLEARSTACK
SABSTOC
ASSERT OK == 0
SNEGTOC
ASSERT OK == 0
SNOTTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof320_sabstoc_snottoc" LAST_N SP
HOLD_FLASH 1
