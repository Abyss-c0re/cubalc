# Proof 222 — digit-8 stack depth-6: 6SWAP 6NIP
HOLD_FLASH 1
SCIENCE LOAD

# 6SWAP reverse top 6
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6SWAP
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 6
ASSERT b == 5
ASSERT c == 4
ASSERT d == 3
ASSERT e == 2
ASSERT f == 1

# SWAP6 / HSWAP aliases
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
PUSH 50
PUSH 60
SWAP6
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 60
ASSERT b == 50
ASSERT c == 40
ASSERT d == 30
ASSERT e == 20
ASSERT f == 10

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
HSWAP
6SWAP
POP f
ASSERT f == 6
POP e
ASSERT e == 5
POP d
ASSERT d == 4
POP c
ASSERT c == 3
POP b
ASSERT b == 2
POP a
ASSERT a == 1

# 6NIP keep ends
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6NIP
ASSERT SP == 2
POP y
POP x
ASSERT x == 1
ASSERT y == 6

# NIP6 / HNIP
CLEARSTACK
PUSH 7
PUSH 8
PUSH 9
PUSH 10
PUSH 11
PUSH 12
NIP6
POP y
POP x
ASSERT x == 7
ASSERT y == 12

CLEARSTACK
PUSH 0
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
HNIP
POP y
POP x
ASSERT x == 0
ASSERT y == 5

# 6SWAP then 6NIP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6SWAP
6NIP
POP y
POP x
ASSERT x == 6
ASSERT y == 1
