# Proof 203 — digit-9 dual-stack nibble data-path: DCLIP4 DSEXT4 DZEXT4
HOLD_FLASH 1
SCIENCE LOAD

# DCLIP4: clamp to [0,15]
CLEARSTACK
PUSH -3
PUSH 20
DCLIP4
POP y
POP x
ASSERT x == 0
ASSERT y == 15

# interior
CLEARSTACK
PUSH 0
PUSH 15
2CLIP4
POP y
POP x
ASSERT x == 0
ASSERT y == 15

# PAIRCLIP4 / DCLIPN
CLEARSTACK
PUSH 7
PUSH 8
PAIRCLIP4
POP y
POP x
ASSERT x == 7
ASSERT y == 8

CLEARSTACK
PUSH 100
PUSH -1
DCLIPN
POP y
POP x
ASSERT x == 15
ASSERT y == 0

# DSEXT4: sign-extend nibble
CLEARSTACK
PUSH 0x7
PUSH 0x8
DSEXT4
POP y
POP x
ASSERT x == 7
ASSERT y == -8

# 0xF → -1
CLEARSTACK
PUSH 0xF
PUSH 0x0
2SEXT4
POP y
POP x
ASSERT x == -1
ASSERT y == 0

# PAIRSEXT4 / DSEXTN with high garbage
CLEARSTACK
PUSH 0xAB
PUSH 0xC5
PAIRSEXT4
POP y
POP x
ASSERT x == -5
ASSERT y == 5

CLEARSTACK
PUSH 0x18
PUSH 0x19
DSEXTN
POP y
POP x
ASSERT x == -8
ASSERT y == -7

# DZEXT4: mask low nibble
CLEARSTACK
PUSH 0xAB
PUSH 0xC5
DZEXT4
POP y
POP x
ASSERT x == 0xB
ASSERT y == 0x5

# 2ZEXT4 / PAIRZEXT4 / DZEXTN
CLEARSTACK
PUSH -1
PUSH 0x10
2ZEXT4
POP y
POP x
ASSERT x == 0xF
ASSERT y == 0

CLEARSTACK
PUSH 0x21
PUSH 0x33
PAIRZEXT4
POP y
POP x
ASSERT x == 1
ASSERT y == 3

CLEARSTACK
PUSH 0xF0
PUSH 0x0E
DZEXTN
POP y
POP x
ASSERT x == 0
ASSERT y == 0xE
