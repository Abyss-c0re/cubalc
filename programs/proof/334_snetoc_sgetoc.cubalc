# Proof 334 — digit-6 energy compare bounds TOC: SNETOC SLETOC SGETOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SNETOC unequal
CELLSET 1 5
PUSH 1
PUSH 6
SNETOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# CMPNETOC equal → 0
CELLSET 2 7
PUSH 2
PUSH 7
CMPNETOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SLETOC true: 3 <= 3
CELLSET 3 3
PUSH 3
PUSH 3
SLETOC
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# CMPLETOC false: 10 <= 3
CELLSET 4 10
PUSH 4
PUSH 3
CMPLETOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SGETOC true: 9 >= 2
CELLSET 5 9
PUSH 5
PUSH 2
SGETOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# CMPGETOC equal ≥
CELLSET 6 4
PUSH 6
PUSH 4
CMPGETOC
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# SGEAT false: 1 >= 5
CELLSET 7 1
PUSH 7
PUSH 5
SGEAT
ASSERT LAST_N == 0
ASSERT CELL(7) == 0
POP

# soft fails
CLEARSTACK
SNETOC
ASSERT OK == 0
SLETOC
ASSERT OK == 0
SGETOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof334_snetoc_sgetoc" LAST_N SP
HOLD_FLASH 1
