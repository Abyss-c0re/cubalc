# Proof 79 — digit-8 COP matrix↔word: WORDFROM/WORDTO + EXTRACT/DEPOSIT
HOLD_FLASH 1
SCIENCE LOAD

CUBE m ROLE matrix PROTON 1
CLEARBITS m

# WORDTO deposits low bits of integer
WORDTO m 0x2B
# 0x2B = 43 = bits 0,1,3,5
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 0
GETBIT m 3
ASSERT LAST_N == 1
GETBIT m 5
ASSERT LAST_N == 1
ONES m
ASSERT LAST_N == 4

WORDFROM m
ASSERT LAST_N == 43
MAT2WORD m
ASSERT LAST_N == 43

# EXTRACTBITS lo..hi inclusive
EXTRACTBITS m 0 3
ASSERT LAST_N == 11
GETBITS m 4 7
ASSERT LAST_N == 2
SLICEBITS m 1 5
ASSERT LAST_N == 21

# DEPOSITBITS overwrites a field
DEPOSITBITS m 8 11 0xA
EXTRACTBITS m 8 11
ASSERT LAST_N == 10
# low word bits still 43
EXTRACTBITS m 0 7
ASSERT LAST_N == 43

# PUTBITS alias
PUTBITS m 16 19 5
EXTRACTBITS m 16 19
ASSERT LAST_N == 5

# round-trip WORDTO / WORDFROM with larger value
WORDTO m 0x7F01
WORDFROM m
ASSERT LAST_N == 32513
ONES m
ASSERT LAST_N == 8

# BITFIELD zero range soft
CLEARBITS m
SETBIT m 0 1
EXTRACTBITS m 10 12
ASSERT LAST_N == 0

# soft fail missing cube
WORDFROM nosuch
ASSERT OK == 0
EXTRACTBITS nosuch 0 3
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof79_word_bits_bridge" LAST_N SET
