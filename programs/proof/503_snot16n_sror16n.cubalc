# Proof 503 — digit-1 stack imm 16-bit field unary+rotate: SNOT16N SROL16N SROR16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SNOT16N n0: 0x0000 → 0xFFFF ; 0x00FF → 0xFF00
PUSH 0x0000
SNOT16N 0
POP x
ASSERT x == 65535

CLEARSTACK
PUSH 0x00FF
NOT16N 0
POP x
ASSERT x == 65280

# high preserved not
CLEARSTACK
PUSH 0x1122334455667788
SNOT16N 0
POP x
ASSERT x == 0x1122334455668877

# STACKNOT16N n1: half1 of 0xAAAA0001 is AAAA → ~ = 5555 → 0x55550001
CLEARSTACK
PUSH 0xAAAA0001
STACKNOT16N 1
POP x
ASSERT x == 0x55550001

# SINV16N alias: 0xFFFF → 0
CLEARSTACK
PUSH 0xFFFF
SINV16N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x8000
SINVERT16N 0
POP x
ASSERT x == 32767

# SROL16N k=1 n0: 0x8001 → 0x0003 ; 0x0001 → 0x0002
CLEARSTACK
PUSH 0x8001
SROL16N 1 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x0001
ROL16N 1 0
POP x
ASSERT x == 2

# high preserved rol
CLEARSTACK
PUSH 0x112233448001
SROL16N 1 0
POP x
ASSERT x == 0x112233440003

# STACKROL16N n1: half1 of 0x00010002 is 0001 rotl1 → 0002 → 0x00020002
CLEARSTACK
PUSH 0x00010002
STACKROL16N 1 1
POP x
ASSERT x == 0x00020002

# SROR16N k=1 n0: 0x0002 → 0x0001 ; 0x0001 → 0x8000
CLEARSTACK
PUSH 0x0002
SROR16N 1 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x0001
ROR16N 1 0
POP x
ASSERT x == 32768

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA55A
SROL16N 5 0
SROR16N 5 0
POP x
ASSERT x == 0xA55A

# k masked: k=17 → k&15=1
CLEARSTACK
PUSH 0x0001
SROR16N 17 0
POP x
ASSERT x == 32768

# STACKROR16N n1: half1 of 0x00020000 is 0002 → rotr1 → 0001 → 0x00010000
CLEARSTACK
PUSH 0x00020000
STACKROR16N 1 1
POP x
ASSERT x == 0x00010000

# SROTL16N alias
CLEARSTACK
PUSH 0x1000
SROTL16N 1 0
POP x
ASSERT x == 0x2000

# SNOTWORDN alias
CLEARSTACK
PUSH 0x00FF
SNOTWORDN 0
POP x
ASSERT x == 65280

HOLD_FLASH 0
