# Proof 391 — digit-5 imm high-n metric TOC: SPOPHNTOCN SANYHNTOCN SALLHNTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOPHNTOCN: high-4 all set → popcount 4
CELLSET 1 0
PUSH 1
SHMASKTOCN 4
POP
PUSH 1
SPOPHNTOCN 4
ASSERT LAST_N == 4
ASSERT CELL(1) == 4
POP a
ASSERT a == 4

# POPHNTOCN n=0 → 0
CELLSET 2 255
PUSH 2
POPHNTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SANYHNTOCN: high-1 of 0 → 0; of MSB → 1
CELLSET 3 0
PUSH 3
SANYHNTOCN 1
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP
CELLSET 4 0
PUSH 4
SHMASKTOCN 1
POP
PUSH 4
ANYHNTOCN 1
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# SALLHNTOCN: high-4 of full high-4 mask → 1
CELLSET 5 0
PUSH 5
SHMASKTOCN 4
POP
PUSH 5
SALLHNTOCN 4
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP
# high-1 only is not all high-4
CELLSET 6 0
PUSH 6
SHMASKTOCN 1
POP
PUSH 6
ALLHNTOCN 4
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# n=0 vacuous all → 1
CELLSET 7 0
PUSH 7
SALLHNTOCN 0
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# soft empty OK=0
CLEARSTACK
SPOPHNTOCN 3
ASSERT OK == 0

PRINT "391_spophntocn_sallhntocn OK"
