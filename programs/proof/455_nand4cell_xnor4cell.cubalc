# Proof 455 — digit-5 cell fixed-width 4 nibble inverted bitwise: NAND4CELL NOR4CELL XNOR4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NAND4CELL: 15 & 15 → ~15 as u4 = 0
CELLSET 0 15
NAND4CELL 0 0 15
ASSERT CELL(0) == 0
ASSERT LAST_N == 1

# NAND4CELL: 15 & 0 → ~0 as u4 = 15
CELLSET 1 15
NAND4CELL 1 1 0
ASSERT CELL(1) == 15
ASSERT LAST_N == 1

# NOR4CELL: 15 | 0 → ~15 as u4 = 0
CELLSET 2 15
NOR4CELL 2 2 0
ASSERT CELL(2) == 0
ASSERT LAST_N == 1

# NOR4CELL: 0 | 0 → ~0 as u4 = 15
CELLSET 3 0
NOR4CELL 3 3 0
ASSERT CELL(3) == 15

# XNOR4CELL: 15 ^ 0 → ~15 as u4 = 0
CELLSET 4 15
XNOR4CELL 4 4 0
ASSERT CELL(4) == 0
ASSERT LAST_N == 1

# XNOR4CELL: self-xnor → 15
CELLSET 5 10
XNOR4CELL 5 5 10
ASSERT CELL(5) == 15

# range NAND: 0xF with mask 0x3 → ~(0x3) = 0xC = 12
CELLSET 6 15
CELLSET 7 15
NAND4CELL 6 7 3
ASSERT CELL(6) == 12
ASSERT CELL(7) == 12
ASSERT LAST_N == 2

# high bits above 4 ignored: 0x1F nand 0xF → ~0xF = 0
CELLSET 8 31
NAND4CELL 8 8 15
ASSERT CELL(8) == 0

# NOR4RANGE: 0 | 0x5 → ~0x5 = 0xA = 10
CELLSET 9 0
NOR4RANGE 9 9 5
ASSERT CELL(9) == 10

# XNOR4RANGE: 0xA ^ 0x5 → ~0xF = 0
CELLSET 10 10
XNOR4RANGE 10 10 5
ASSERT CELL(10) == 0

# CELLNOR4 alias: 0x3 | 0xC → ~0xF = 0
CELLSET 11 3
CELLNOR4 11 11 12
ASSERT CELL(11) == 0

# BNAND4CELL: 0 mask 0 → 15
CELLSET 12 0
BNAND4CELL 12 12 0
ASSERT CELL(12) == 15

# NANDNIBCELL alias: 0x5 & 0x3 → ~0x1 = 0xE = 14
CELLSET 13 5
NANDNIBCELL 13 13 3
ASSERT CELL(13) == 14

HOLD_FLASH 0
