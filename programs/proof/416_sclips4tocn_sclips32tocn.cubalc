PUSH 9
PUSH 0
PUSH 3000000000
SUB
SSETCELL
POP
PUSH 9
SCLIPS32TOCN
ASSERT LAST_N == -2147483648
ASSERT CELL(9) == -2147483648
POP

# soft short stack OK=0
CLEARSTACK
SCLIPS4TOCN
ASSERT OK == 0

CLEARSTACK
SCLIPS16TOCN
ASSERT OK == 0

CLEARSTACK
SCLIPS32TOCN
