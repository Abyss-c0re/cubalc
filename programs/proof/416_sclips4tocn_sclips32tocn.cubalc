# Proof 416 — digit-4 imm dual signed clip: SCLIPS4TOCN SCLIPS16TOCN SCLIPS32TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLIPS4TOCN: 20 → 7 (i replaced)
CELLSET 1 20
PUSH 1
SCLIPS4TOCN
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP

# CLIPS4TOCN: -20 → -8
CELLSET 2 4294967276
PUSH 2
SSEXT32TOC
POP
PUSH 2
CLIPS4TOCN
