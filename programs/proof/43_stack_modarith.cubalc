# Proof 43 — stack modular/fact digit-2: SMULMOD SPOWMOD SMODINV SFACT SILOG2
HOLD_FLASH 1
SCIENCE LOAD

# SFACT
CLEARSTACK
PUSH 5
SFACT
ASSERT LAST_N == 120
CLEARSTACK
PUSH 0
SFACT
ASSERT LAST_N == 1
CLEARSTACK
PUSH -1
SFACT
ASSERT LAST_N == 0

# SILOG2
CLEARSTACK
PUSH 1
SILOG2
ASSERT LAST_N == 0
CLEARSTACK
PUSH 1024
SILOG2
ASSERT LAST_N == 10
CLEARSTACK
PUSH 0
SLOG2
ASSERT LAST_N == -1

# SMULMOD: 7*8 mod 10 = 6
CLEARSTACK
PUSH 7
PUSH 8
PUSH 10
SMULMOD
ASSERT LAST_N == 6

# SPOWMOD: 2^10 mod 1000 = 24
CLEARSTACK
PUSH 2
PUSH 10
PUSH 1000
SPOWMOD
ASSERT LAST_N == 24

# SPOWMOD 3^5 mod 13 = 243%13 = 9
CLEARSTACK
PUSH 3
PUSH 5
PUSH 13
SPOWMOD
ASSERT LAST_N == 9

# SMODINV: 3^{-1} mod 11 = 4 because 3*4=12≡1
CLEARSTACK
PUSH 3
PUSH 11
SMODINV
ASSERT LAST_N == 4
PUSH 3
PUSH 11
SMULMOD
ASSERT LAST_N == 1

# non-invertible
CLEARSTACK
PUSH 2
PUSH 4
SMODINV
ASSERT LAST_N == 0

# underflow
CLEARSTACK
SMULMOD
ASSERT OK == 0
CLEARSTACK
SFACT
ASSERT OK == 0

# compose: powmod then ilog2
CLEARSTACK
PUSH 2
PUSH 8
PUSH 1000
SPOWMOD
# 256
SILOG2
ASSERT LAST_N == 8

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof43_stack_modarith" LAST_N SP
