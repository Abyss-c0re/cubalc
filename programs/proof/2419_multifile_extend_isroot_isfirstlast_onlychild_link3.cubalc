# Proof 2419 — MULTIFILE_EXTEND_ISROOT_ISFIRSTLAST_ONLYCHILD_LINK3
# Multi-file CLASS EXTEND + ISROOT + ISFIRSTCHILD/ISLASTCHILD + ONLYCHILD.
# Complements CHILDRANK + NEXT/PREVSIBLING + ISLEAF + ROOTOF.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

# Peer lattice (same as 2418): Greeter kids = TagGreeter, TwinGreet
# TagGreeter kids = LoudTag, SoftTag ; SoftTag kid = DeepLeaf ; Solo root
CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

CLASS DeepLeaf EXTEND SoftTag
  FIELD deep 1
  METHOD z
    RET 1
  END
END
HASCLASS DeepLeaf
ASSERT LAST_N == 1

# ---- ISROOT ----
ISROOT Greeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISROOT_N == 1
ASSERT ISROOT == 1

ISROOT Solo
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISROOT_N == 1

ISROOT TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ISROOT_N == 0

ISROOT TwinGreet
ASSERT LAST_N == 0
ASSERT ISROOT_N == 0

ISROOT LoudTag
ASSERT LAST_N == 0
ASSERT ISROOT_N == 0

ISROOT SoftTag
ASSERT LAST_N == 0
ASSERT ISROOT_N == 0

ISROOT DeepLeaf
ASSERT LAST_N == 0
ASSERT ISROOT_N == 0

IS_ROOT Greeter
ASSERT LAST_N == 1
TOPCLASS Solo
ASSERT LAST_N == 1
NOROOTPARENT TagGreeter
ASSERT LAST_N == 0

# ---- ISFIRSTCHILD (decl order among parent kids) ----
# Greeter children: TagGreeter (0), TwinGreet (1)
ISFIRSTCHILD TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISFIRSTCHILD_N == 1
ASSERT ISFIRSTCHILD == 1

ISFIRSTCHILD TwinGreet
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ISFIRSTCHILD_N == 0

# TagGreeter children: LoudTag (0), SoftTag (1)
ISFIRSTCHILD LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISFIRSTCHILD_N == 1

ISFIRSTCHILD SoftTag
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ISFIRSTCHILD_N == 0

# SoftTag only child DeepLeaf
ISFIRSTCHILD DeepLeaf
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISFIRSTCHILD_N == 1

# roots soft 0
ISFIRSTCHILD Greeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ISFIRSTCHILD_N == 0

ISFIRSTCHILD Solo
ASSERT LAST_N == 0

ISELDERCHILD TagGreeter
ASSERT LAST_N == 1
ISFIRSTKID LoudTag
ASSERT LAST_N == 1

# ---- ISLASTCHILD ----
ISLASTCHILD TwinGreet
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISLASTCHILD_N == 1
ASSERT ISLASTCHILD == 1

ISLASTCHILD TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ISLASTCHILD_N == 0

ISLASTCHILD SoftTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISLASTCHILD_N == 1

ISLASTCHILD LoudTag
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ISLASTCHILD_N == 0

ISLASTCHILD DeepLeaf
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISLASTCHILD_N == 1

ISLASTCHILD Greeter
ASSERT LAST_N == 0
ASSERT ISLASTCHILD_N == 0

ISLASTCHILD Solo
ASSERT LAST_N == 0

ISYOUNGCHILD SoftTag
ASSERT LAST_N == 1
ISLASTKID TwinGreet
ASSERT LAST_N == 1

# ---- ONLYCHILD (exactly one kid under parent) ----
ONLYCHILD DeepLeaf
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ONLYCHILD_N == 1
ASSERT ONLYCHILD == 1

ONLYCHILD TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ONLYCHILD_N == 0

ONLYCHILD TwinGreet
ASSERT LAST_N == 0
ASSERT ONLYCHILD_N == 0

ONLYCHILD LoudTag
ASSERT LAST_N == 0
ASSERT ONLYCHILD_N == 0

ONLYCHILD SoftTag
ASSERT LAST_N == 0
ASSERT ONLYCHILD_N == 0

# roots are not children → soft 0
ONLYCHILD Greeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ONLYCHILD_N == 0

ONLYCHILD Solo
ASSERT LAST_N == 0
ASSERT ONLYCHILD_N == 0

ISONLYCHILD DeepLeaf
ASSERT LAST_N == 1
SOLECHILD DeepLeaf
ASSERT LAST_N == 1
HASNOSIB DeepLeaf
ASSERT LAST_N == 1

# aliases bundle
IS_FIRST_CHILD TagGreeter
ASSERT LAST_N == 1
IS_LAST_CHILD TwinGreet
ASSERT LAST_N == 1
IS_ONLY_CHILD DeepLeaf
ASSERT LAST_N == 1

# CHILDRANK coherence with first/last
CHILDRANK TagGreeter
ASSERT CHILDRANK_N == 0
CHILDRANK TwinGreet
ASSERT CHILDRANK_N == 1
CHILDRANK LoudTag
ASSERT CHILDRANK_N == 0
CHILDRANK SoftTag
ASSERT CHILDRANK_N == 1
CHILDRANK DeepLeaf
ASSERT CHILDRANK_N == 0

# first+last both true only when only-child
ISFIRSTCHILD DeepLeaf
ASSERT LAST_N == 1
ISLASTCHILD DeepLeaf
ASSERT LAST_N == 1
ONLYCHILD DeepLeaf
ASSERT LAST_N == 1

PRINT "MI2419_ISROOT_ISFIRSTLAST_ONLYCHILD_PASS"
