# Proof 421 — digit-5 dual-stack shift32: DSHL32 DSHR32 DSAR32
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# DSHL32: 1≪4=16 ; 3≪1=6
PUSH 1
PUSH 3
PUSH 4
PUSH 1
DSHL32
ASSERT LAST_N == 6
SWAP
ASSERT LAST_N == 16
POP
POP

# 2SHR32: 0x80 ≫ 4 = 8 ; 0x100 ≫ 1 = 0x80
CLEARSTACK
PUSH 128
PUSH 256
PUSH 4
PUSH 1
2SHR32
ASSERT LAST_N == 128
SWAP
ASSERT LAST_N == 8
POP
POP

# DSAR32: 0x80000000 (neg) ≫ 1 = 0xC0000000 signed → -1073741824
# 0xFFFFFFF0 (-16) ≫ 2 = -4
CLEARSTACK
PUSH 2147483648
PUSH 4294967280
PUSH 1
PUSH 2
DSAR32
ASSERT LAST_N == -4
SWAP
ASSERT LAST_N == -1073741824
POP
POP

# 2SAR32 zero amt passthrough low32
CLEARSTACK
PUSH 42
PUSH 99
PUSH 0
PUSH 0
2SAR32
ASSERT LAST_N == 99
SWAP
ASSERT LAST_N == 42
POP
POP

# DSHL32 k>=32 → 0
CLEARSTACK
PUSH 7
PUSH 9
PUSH 32
PUSH 40
DSHL32
ASSERT LAST_N == 0
SWAP
ASSERT LAST_N == 0
POP
POP

# soft short
CLEARSTACK
DSHL32
ASSERT OK == 0

CLEARSTACK
PUSH 1
PUSH 2
DSHR32
ASSERT OK == 0

CLEARSTACK
DSAR32
ASSERT OK == 0

HOLD_FLASH 0
