# Proof 514 — digit-3 stack imm 32-bit field zeros+signed: SCLZ32N SCTZ32N SNEG32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLZ32N: 0→32 ; 1→31
PUSH 0x0
SCLZ32N 0
POP x
ASSERT x == 32

CLEARSTACK
PUSH 0x1
CLZ32N 0
POP x
ASSERT x == 31

# 0x80000000→0 ; 0x00000002→30
CLEARSTACK
PUSH 0x80000000
SCLZ32N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x00000002
SNLZ32N 0
POP x
ASSERT x == 30

# high preserved clz0→32
CLEARSTACK
PUSH 0x1122334400000000
SCLZ32N 0
POP x
ASSERT x == 0x1122334400000020

# STACKCLZ32N n1: 0x4000000000000000 high=0x40000000 clz1 → 0x0000000100000000
CLEARSTACK
PUSH 0x4000000000000000
STACKCLZ32N 1
POP x
ASSERT x == 0x0000000100000000

# SCTZ32N: 0→32 ; 1→0 ; 0x80000000→31 ; 0x00000006→1
CLEARSTACK
PUSH 0x0
SCTZ32N 0
POP x
ASSERT x == 32

CLEARSTACK
PUSH 0x1
CTZ32N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x80000000
SCTZ32N 0
POP x
ASSERT x == 31

CLEARSTACK
PUSH 0x00000006
SNTZ32N 0
POP x
ASSERT x == 1

# STACKCTZ32N n1: 0xC000000000000000 high=C0000000 ctz30 → 0x0000001E00000000
CLEARSTACK
PUSH 0xC000000000000000
STACKCTZ32N 1
POP x
ASSERT x == 0x0000001E00000000

# SNEG32N: 3→0xFFFFFFFD ; 0xFFFFFFFE (-2)→2 ; min 0x80000000 stays
CLEARSTACK
PUSH 0x3
SNEG32N 0
POP x
ASSERT x == 4294967293

CLEARSTACK
PUSH 0xFFFFFFFE
SNEG32N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x80000000
NEG32N 0
POP x
ASSERT x == 2147483648

CLEARSTACK
PUSH 0x1
SDWNEGN 0
POP x
ASSERT x == 4294967295

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455555555
SNEG32N 0
POP x
ASSERT x == 0x11223344AAAAAAAB

CLEARSTACK
PUSH 0x11223344AAAAAAAB
SNEG32N 0
POP x
ASSERT x == 0x1122334455555555

# STACKNEG32N n1: 0x3000000000000000 high=0x30000000 → - = 0xD0000000
CLEARSTACK
PUSH 0x3000000000000000
STACKNEG32N 1
POP x
ASSERT x == 0xD000000000000000

# aliases
CLEARSTACK
PUSH 0x10000000
SDWCLZN 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x10000000
SDWCTZN 0
POP x
ASSERT x == 28

CLEARSTACK
PUSH 0x2
SINEG32N 0
POP x
ASSERT x == 4294967294

HOLD_FLASH 0
