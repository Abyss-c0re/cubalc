# Proof 275 — digit-9 stack imm inverted 4-bit field: SNAND4N SNOR4N SXNOR4N
HOLD_FLASH 1
SCIENCE LOAD

# SNAND4N field n — nibble = ~(nibble & field) & 0xF
CLEARSTACK
PUSH 0x1122334455667788
SNAND4N 0x3 0
POP x
ASSERT x == 0x112233445566778F
CLEARSTACK
PUSH 0x1122334455667788
STACKNAND4N 0x3 1
POP x
ASSERT x == 0x11223344556677F8
CLEARSTACK
PUSH -1
NAND4N 0xF 0
POP x
ASSERT x == -16

# SNOR4N field n — nibble = ~(nibble | field) & 0xF
CLEARSTACK
PUSH 0x1122334455667788
SNOR4N 0xC 0
POP x
ASSERT x == 0x1122334455667783
CLEARSTACK
PUSH 0x1122334455667788
STACKNOR4N 0x1 2
POP x
ASSERT x == 0x1122334455667888
CLEARSTACK
PUSH 0
NOR4N 0x0 0
POP x
ASSERT x == 0xF
CLEARSTACK
PUSH 0
SINVERTOR4N 0xA 3
POP x
ASSERT x == 0x5000

# SXNOR4N field n — nibble = ~(nibble ^ field) & 0xF
CLEARSTACK
PUSH 0x1122334455667788
SXNOR4N 0x1 0
POP x
ASSERT x == 0x1122334455667786
CLEARSTACK
PUSH 0x1122334455667788
STACKXNOR4N 0x1 15
POP x
ASSERT x == 0xF122334455667788
CLEARSTACK
PUSH 0
XNOR4N 0xA 1
POP x
ASSERT x == 0x50
CLEARSTACK
PUSH -1
SEQUIV4N 0x0 0
POP x
ASSERT x == -16
CLEARSTACK
PUSH -1
SXNOR4N 0xF 0
POP x
ASSERT x == -1

# soft fails
CLEARSTACK
SNAND4N 1 0
ASSERT OK == 0
CLEARSTACK
SNOR4N 1 0
ASSERT OK == 0
CLEARSTACK
SXNOR4N 1 0
ASSERT OK == 0

HOLD_FLASH 1
