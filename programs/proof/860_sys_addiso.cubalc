# SYS ADDISO / SHIFTISO — shift ISO stamp by seconds or human duration
# Usability: plate schedules without PARSEISO + ADDTIME + FROMTIME glue

HOLD_FLASH 1

# known epoch: 2020-01-01T00:00:00Z = 1577836800
LET base = "2020-01-01T00:00:00Z"

SYS ADDISO base 3600
ASSERT OK == 1
SYS EQS LAST "2020-01-01T01:00:00Z"
ASSERT LAST_N == 1
ASSERT ADDISO_N == 1577836800 + 3600
ASSERT ADDISO_SECS == 3600

# duration string offset
SYS ADDISO base "1h"
ASSERT OK == 1
SYS EQS LAST "2020-01-01T01:00:00Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == 3600

SYS ADDISO base "30s"
ASSERT OK == 1
SYS EQS LAST "2020-01-01T00:00:30Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == 30

SYS ADDISO base "1d"
ASSERT OK == 1
SYS EQS LAST "2020-01-02T00:00:00Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == 86400

# compound duration
SYS ADDISO base "1h30m"
ASSERT OK == 1
SYS EQS LAST "2020-01-01T01:30:00Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == 5400

# chain: DATE-like LAST + one-arg duration
SYS FROMTIME 1577836800
SYS EQS LAST "2020-01-01T00:00:00Z"
ASSERT LAST_N == 1
SYS ADDISO "2h"
ASSERT OK == 1
SYS EQS LAST "2020-01-01T02:00:00Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == 7200

# one-arg numeric secs on prior LAST ISO
SYS FROMTIME 1577836800
SYS ADDISO 90
ASSERT OK == 1
SYS EQS LAST "2020-01-01T00:01:30Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == 90

# negative offset
SYS ADDISO base -60
ASSERT OK == 1
# 2019-12-31T23:59:00Z
SYS EQS LAST "2019-12-31T23:59:00Z"
ASSERT LAST_N == 1
ASSERT ADDISO_SECS == -60

# aliases
SYS SHIFTISO base "1m"
ASSERT OK == 1
SYS EQS LAST "2020-01-01T00:01:00Z"
ASSERT LAST_N == 1

SYS ISOADD base 0
ASSERT OK == 1
SYS EQS LAST "2020-01-01T00:00:00Z"
ASSERT LAST_N == 1

# soft-fail bad
SYS ADDISO "not-a-date" 10
ASSERT OK == 0

SYS FROMTIME 1577836800
SYS ADDISO "nope"
ASSERT OK == 0

PRINT "sys_addiso ok"
