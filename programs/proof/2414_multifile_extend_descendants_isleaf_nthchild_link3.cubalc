# Proof 2414 — MULTIFILE_EXTEND_DESCENDANTS_ISLEAF_NTHCHILD_LINK3
# Multi-file CLASS EXTEND + DESCENDANTS bag + ISLEAF/HASCHILDREN
# + FIRSTCHILD/LASTCHILD/NTHCHILD. Complements CHILDREN/HASCHILD/HASDESCENDANT.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

# --- HASCHILDREN / ISLEAF ---
HASCHILDREN Greeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT HASCHILDREN_N == 1

HASCHILDREN TagGreeter
ASSERT LAST_N == 1

ISLEAF LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ISLEAF_N == 1

ISLEAF SoftTag
ASSERT LAST_N == 1

ISLEAF Solo
ASSERT LAST_N == 1

ISLEAF Greeter
ASSERT LAST_N == 0

HASCHILDREN Solo
ASSERT LAST_N == 0

HASCHILDREN LoudTag
ASSERT LAST_N == 0

HASKIDS Greeter
ASSERT LAST_N == 1
NOCHILDREN LoudTag
ASSERT LAST_N == 1
LEAFCLASS SoftTag
ASSERT LAST_N == 1

# --- FIRSTCHILD / LASTCHILD / NTHCHILD ---
CHILDREN Greeter
ASSERT OK == 1
ASSERT CHILDREN_N == 2

FIRSTCHILD Greeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "TagGreeter"
LET FC = LAST

LASTCHILD Greeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "TwinGreet"
LET LC = LAST

NTHCHILD Greeter 0
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT NTHCHILD_N == 1
ASSERT LAST == "TagGreeter"

NTHCHILD Greeter 1
ASSERT LAST_N == 1
ASSERT LAST == "TwinGreet"

NTHCHILD Greeter 9
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT NTHCHILD_N == 0

FIRSTCHILD TagGreeter
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag" OR LAST == "SoftTag"

LASTCHILD TagGreeter
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag" OR LAST == "SoftTag"

CHILDREN TagGreeter
ASSERT CHILDREN_N == 2

FIRSTCHILD LoudTag
ASSERT OK == 1
ASSERT LAST_N == 0

NTHCHILD Solo 0
ASSERT LAST_N == 0

# --- DESCENDANTS bag (any depth, BFS, excludes self) ---
DESCENDANTS Greeter
ASSERT OK == 1
ASSERT DESCENDANTS_N >= 4
ASSERT LAST_N >= 4

HASDESCENDANT Greeter LoudTag
ASSERT LAST_N == 1
HASDESCENDANT Greeter SoftTag
ASSERT LAST_N == 1
HASDESCENDANT Greeter TwinGreet
ASSERT LAST_N == 1

DESCENDANTS TagGreeter
ASSERT OK == 1
ASSERT DESCENDANTS_N >= 2
ASSERT LAST_N >= 2

DESCENDANTS LoudTag
ASSERT OK == 1
ASSERT DESCENDANTS_N == 0
ASSERT LAST_N == 0

DESCENDANTS Solo
ASSERT DESCENDANTS_N == 0

PROGENY Greeter
ASSERT OK == 1
ASSERT PROGENY_N >= 4

LISTDESCENDANTS TagGreeter
ASSERT LAST_N >= 2

ALLSUBS Greeter
ASSERT LAST_N >= 4

ISLEAF TwinGreet
ASSERT LAST_N == 1
HASCHILDREN TwinGreet
ASSERT LAST_N == 0

PRINT "MI2414_DESCENDANTS_ISLEAF_NTHCHILD_PASS"
