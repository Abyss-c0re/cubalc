# SYS PARSESIZE / FROMHUMAN / TOBYTES / PARSEBYTES
# — parse human size labels → byte counts (1024-base)
# Usability: reverse of HUMANSIZE for agent config knobs

HOLD_FLASH 1

# bare number = bytes
SYS PARSESIZE "512"
ASSERT OK == 1
ASSERT PARSESIZE_N == 512
ASSERT LAST_N == 512
SYS EQS LAST "512"
ASSERT LAST_N == 1

SYS PARSESIZE "0"
ASSERT OK == 1
ASSERT PARSESIZE_N == 0

# units
SYS PARSESIZE "1K"
ASSERT OK == 1
ASSERT PARSESIZE_N == 1024

SYS PARSESIZE "2M"
ASSERT OK == 1
ASSERT PARSESIZE_N == 2097152

SYS PARSESIZE "1G"
ASSERT OK == 1
ASSERT PARSESIZE_N == 1073741824

# optional B / case
SYS PARSESIZE "512B"
ASSERT PARSESIZE_N == 512
SYS PARSESIZE "1k"
ASSERT PARSESIZE_N == 1024
SYS PARSESIZE "1KB"
ASSERT PARSESIZE_N == 1024

# whitespace
SYS PARSESIZE "  3K  "
ASSERT PARSESIZE_N == 3072

# aliases
SYS FROMHUMAN "4K"
ASSERT PARSESIZE_N == 4096
SYS TOBYTES "1M"
ASSERT PARSESIZE_N == 1048576

# round-trip with HUMANSIZE
SYS HUMANSIZE 2048
LET lab = LAST
SYS PARSESIZE lab
ASSERT PARSESIZE_N == 2048

SYS HUMANSIZE 1048576
SYS PARSESIZE LAST
ASSERT PARSESIZE_N == 1048576

# soft fail
SYS PARSESIZE ""
ASSERT OK == 0
ASSERT PARSESIZE_N == 0

SYS PARSESIZE "nope"
ASSERT OK == 0

SYS PARSESIZE "1X"
ASSERT OK == 0

# agent: config default max plate size
DEFAULT max_plate = "2M"
SYS PARSESIZE max_plate
LET max_b = LAST_N
ASSERT max_b == 2097152
SYS SIZE "/dev/null"
# just ensure compare form works
SYS CMP max_b 0
ASSERT LAST_N == 1

PRINT "sys_parsesize ok"
