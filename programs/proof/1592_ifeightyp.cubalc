# IFEIGHTYP - plate exactly-eighty key diagnostic branch
# Continues ladder after IFSEVENTYNINEP. Soft twin OCTACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET seventynine = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51,\"P\":52,\"Q\":53,\"R\":54,\"S\":55,\"T\":56,\"U\":57,\"V\":58,\"W\":59,\"X\":60,\"Y\":61,\"Z\":62,\"_\":63,\"$\":64,\"#\":65,\"@\":66,\"%\":67,\"!\":68,\"^\":69,\"~\":70,\"+\":71,\"=\":72,\"-\":73,\"*\":74,\"/\":75,\"&\":76,\"|\":77,\"?\":78,\".\":79}"
LET eighty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51,\"P\":52,\"Q\":53,\"R\":54,\"S\":55,\"T\":56,\"U\":57,\"V\":58,\"W\":59,\"X\":60,\"Y\":61,\"Z\":62,\"_\":63,\"$\":64,\"#\":65,\"@\":66,\"%\":67,\"!\":68,\"^\":69,\"~\":70,\"+\":71,\"=\":72,\"-\":73,\"*\":74,\"/\":75,\"&\":76,\"|\":77,\"?\":78,\".\":79,\",\":80}"
LET eightyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51,\"P\":52,\"Q\":53,\"R\":54,\"S\":55,\"T\":56,\"U\":57,\"V\":58,\"W\":59,\"X\":60,\"Y\":61,\"Z\":62,\"_\":63,\"$\":64,\"#\":65,\"@\":66,\"%\":67,\"!\":68,\"^\":69,\"~\":70,\"+\":71,\"=\":72,\"-\":73,\"*\":74,\"/\":75,\"&\":76,\"|\":77,\"?\":78,\".\":79,\",\":80,\";\":81}"
LET empty = "{}"

IFEIGHTYP eighty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFEIGHTYP_N == 1
ASSERT EIGHTYP_N == 1
ASSERT IFEIGHTYP_LEN == 80
ASSERT IFOCTACONTAP_N == 1
ASSERT IFEIGHTYKEYP_N == 1

IFOCTACONTAP eighty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFEIGHTYKEYP eighty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENEIGHTYP eighty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENOCTACONTAP eighty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENEIGHTYKEYP eighty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFEIGHTYP seventynine
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFEIGHTYP_N == 0
ASSERT IFEIGHTYP_LEN == 79

IFEIGHTYP eightyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFEIGHTYP_LEN == 81

IFEIGHTYP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFEIGHTYP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

PRINT "ifeightyp_ok" IFEIGHTYP_N IFEIGHTYP_LEN
PASS
