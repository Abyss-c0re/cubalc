# Proof 52 — digit-6 fold ext: SMEAN / SCOUNTNZ
HOLD_FLASH 1
SCIENCE LOAD

# SMEAN whole stack
CLEARSTACK
PUSH 2
PUSH 4
PUSH 6
SMEAN
ASSERT SP == 1
ASSERT LAST_N == 4

# SMEAN n (top 2 only)
CLEARSTACK
PUSH 100
PUSH 10
PUSH 20
SMEAN 2
ASSERT SP == 2
ASSERT LAST_N == 15
DROP
PEEK
ASSERT LAST_N == 100

# aliases
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
SFOLDAVG
ASSERT LAST_N == 2
CLEARSTACK
PUSH 8
PUSH 12
STACKMEAN
ASSERT LAST_N == 10
CLEARSTACK
PUSH 5
PUSH 15
SAVGALL
ASSERT LAST_N == 10

# empty mean → OK=0
CLEARSTACK
SMEAN
ASSERT OK == 0

# SCOUNTNZ whole stack
CLEARSTACK
PUSH 0
PUSH 1
PUSH 0
PUSH 3
SCOUNTNZ
ASSERT SP == 1
ASSERT LAST_N == 2

# SCOUNTNZ n
CLEARSTACK
PUSH 9
PUSH 0
PUSH 5
PUSH 0
SCOUNTNZ 3
ASSERT SP == 2
ASSERT LAST_N == 1
DROP
PEEK
ASSERT LAST_N == 9

# aliases + empty
CLEARSTACK
PUSH 0
PUSH 0
SCNTNZ
ASSERT LAST_N == 0
CLEARSTACK
SCOUNTNZ
ASSERT LAST_N == 0
ASSERT OK == 1

# compose mean of non-zero count path
CLEARSTACK
PUSH 3
PUSH 0
PUSH 6
PUSH 9
SCOUNTNZ
ASSERT LAST_N == 3
CLEARSTACK
PUSH 3
PUSH 6
PUSH 9
SMEAN
ASSERT LAST_N == 6

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof52_stack_fold_mean" LAST_N SP
