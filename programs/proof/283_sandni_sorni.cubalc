# Proof 283 — digit-7 stack imm ANDN plane: SANDNI SORNI SXORNI
HOLD_FLASH 1
SCIENCE LOAD

# SANDNI n — TOS &= ~n
CLEARSTACK
PUSH 0x1122334455667788
SANDNI 0x0F
POP x
ASSERT x == 0x1122334455667780

CLEARSTACK
PUSH 0xABCD
SBICI 0xFF
POP x
ASSERT x == 0xAB00

CLEARSTACK
PUSH -1
ANDNI 0xF0
POP x
ASSERT x == -241

# SORNI n — TOS |= ~n
CLEARSTACK
PUSH 0
SORNI 0
POP x
ASSERT x == -1

CLEARSTACK
PUSH 0
ORNI 0xFF
POP x
ASSERT x == -256

CLEARSTACK
PUSH 0x1122334455667788
STACKORNI 0x0F
POP x
ASSERT x == -8

# SXORNI n — TOS ^= ~n (equiv SXNORI)
CLEARSTACK
PUSH 0x1122334455667788
SXORNI 0x0F
POP x
ASSERT x == 0xEEDDCCBBAA998878

CLEARSTACK
PUSH -1
XORNI 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH -1
SXORNOTI 0xF
POP x
ASSERT x == 15

CLEARSTACK
PUSH 0x1122334455667788
SXNORI 0x0F
POP y
CLEARSTACK
PUSH 0x1122334455667788
SXORNI 0x0F
POP x
ASSERT x == y

# soft fails
CLEARSTACK
SANDNI 1
ASSERT OK == 0
CLEARSTACK
SORNI 1
ASSERT OK == 0
CLEARSTACK
SXORNI 1
ASSERT OK == 0

HOLD_FLASH 1
