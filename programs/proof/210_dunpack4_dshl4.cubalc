# Proof 210 — digit-3 dual-stack nibble unpack + shift: DUNPACK4 DSHL4 DSHR4 DSAR4
HOLD_FLASH 1
SCIENCE LOAD

# DUNPACK4 inverse of DPACK4
CLEARSTACK
PUSH 0xA
PUSH 0xB
PUSH 0xC
PUSH 0xD
DPACK4
POP y
POP x
ASSERT x == 0xAC
ASSERT y == 0xBD

CLEARSTACK
PUSH 0xAC
PUSH 0xBD
DUNPACK4
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0xA
ASSERT hb == 0xB
ASSERT la == 0xC
ASSERT lb == 0xD

# round-trip
CLEARSTACK
PUSH 0x12
PUSH 0x34
2UNPACK4
DPACK4
POP y
POP x
ASSERT x == 0x12
ASSERT y == 0x34

# PAIRUNPACK4 / DNIBSPLIT
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PAIRUNPACK4
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0xF
ASSERT hb == 0
ASSERT la == 0
ASSERT lb == 0xF

# DSHL4
CLEARSTACK
PUSH 0x1
PUSH 0x3
PUSH 1
PUSH 2
DSHL4
POP y
POP x
ASSERT x == 0x2
ASSERT y == 0xC

# shift out → 0
CLEARSTACK
PUSH 0x8
PUSH 0xF
PUSH 1
PUSH 4
2SHL4
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DSHR4
CLEARSTACK
PUSH 0x8
PUSH 0xC
PUSH 1
PUSH 2
DSHR4
POP y
POP x
ASSERT x == 0x4
ASSERT y == 0x3

# DSAR4: 0x8 → -8; >>1 → -4
CLEARSTACK
PUSH 0x8
PUSH 0xE
PUSH 1
PUSH 1
DSAR4
POP y
POP x
ASSERT x == -4
ASSERT y == -1

# PAIRSAR4 positive
CLEARSTACK
PUSH 0x4
PUSH 0x7
PUSH 1
PUSH 0
PAIRSAR4
POP y
POP x
ASSERT x == 0x2
ASSERT y == 0x7

# PAIRSHL4 amount 0 identity (low 4)
CLEARSTACK
PUSH 0xA
PUSH 0x5
PUSH 0
PUSH 0
PAIRSHL4
POP y
POP x
ASSERT x == 0xA
ASSERT y == 0x5
