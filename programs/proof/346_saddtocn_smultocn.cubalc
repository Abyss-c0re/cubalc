# Proof 346 — digit-4 imm accumulate TOC: SADDTOCN SSUBTOCN SMULTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SADDTOCN: 10 + 5 → 15
CELLSET 1 10
PUSH 1
SADDTOCN 5
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP a
ASSERT a == 15

# ADDTOCN negative imm
CELLSET 2 3
PUSH 2
ADDTOCN (-1)
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# SADDATN zero
CELLSET 3 7
PUSH 3
SADDATN 0
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# SSUBTOCN: 20 - 8 → 12
CELLSET 4 20
PUSH 4
SSUBTOCN 8
ASSERT LAST_N == 12
ASSERT CELL(4) == 12
POP

# SUBTOCN to zero
CELLSET 5 9
PUSH 5
SUBTOCN 9
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SSUBATN
CELLSET 6 1
PUSH 6
SSUBATN (-4)
ASSERT LAST_N == 5
ASSERT CELL(6) == 5
POP

# SMULTOCN: 6 * 7 → 42
CELLSET 7 6
PUSH 7
SMULTOCN 7
ASSERT LAST_N == 42
ASSERT CELL(7) == 42
POP

# MULTOCN by 0
CELLSET 8 99
PUSH 8
MULTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# SMULATN by 1 identity
CELLSET 9 13
PUSH 9
SMULATN 1
ASSERT LAST_N == 13
ASSERT CELL(9) == 13
POP

# soft fails empty stack
CLEARSTACK
SADDTOCN 1
ASSERT OK == 0
SSUBTOCN 1
ASSERT OK == 0
SMULTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof346_saddtocn_smultocn" LAST_N SP
HOLD_FLASH 1
