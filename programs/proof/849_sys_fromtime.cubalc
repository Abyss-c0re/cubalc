# SYS FROMTIME / EPOCHISO — epoch seconds → UTC ISO stamp
# Usability: MTIME/plate epochs as human stamps without shell date -d @

HOLD_FLASH 1

# epoch 0 → Unix epoch stamp
SYS FROMTIME 0
ASSERT OK == 1
SYS EQS LAST "1970-01-01T00:00:00Z"
ASSERT LAST_N == 1
ASSERT FROMTIME_N == 0
ASSERT TIME == 0

# known fixed epoch: 2000-01-01 00:00:00 UTC = 946684800
SYS FROMTIME 946684800
ASSERT OK == 1
SYS EQS LAST "2000-01-01T00:00:00Z"
ASSERT LAST_N == 1
ASSERT FROMTIME_N == 946684800
ASSERT TIME == 946684800

# non-midnight
SYS FROMTIME 946684861
ASSERT OK == 1
SYS EQS LAST "2000-01-01T00:01:01Z"
ASSERT LAST_N == 1

# aliases
SYS EPOCHISO 0
ASSERT OK == 1
SYS EQS LAST "1970-01-01T00:00:00Z"
ASSERT LAST_N == 1
SYS TOISO 946684800
ASSERT OK == 1
SYS EQS LAST "2000-01-01T00:00:00Z"
ASSERT LAST_N == 1

# default LAST_N (e.g. after SYS TIME / MTIME)
LET ep = 1000000000
SYS FROMTIME ep
ASSERT OK == 1
# 2001-09-09T01:46:40Z
SYS EQS LAST "2001-09-09T01:46:40Z"
ASSERT LAST_N == 1
ASSERT FROMTIME_N == 1000000000

# negative clamps to 0
SYS FROMTIME -5
ASSERT OK == 1
SYS EQS LAST "1970-01-01T00:00:00Z"
ASSERT LAST_N == 1
ASSERT FROMTIME_N == 0

# after SYS TIME: format "now" is consistent length
SYS TIME
LET now_ep = LAST_N
SYS FROMTIME now_ep
ASSERT OK == 1
SYS LEN LAST
ASSERT LAST_N == 20
SYS ENDS LAST "Z"
ASSERT LAST_N == 1
SYS STARTS LAST "20"
ASSERT LAST_N == 1

# ISO var mirror
SYS FROMTIME 0
SYS EQS ISO "1970-01-01T00:00:00Z"
ASSERT LAST_N == 1
SYS EQS FROMTIME "1970-01-01T00:00:00Z"
ASSERT LAST_N == 1

PRINT "sys_fromtime ok"
