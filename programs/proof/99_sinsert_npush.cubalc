# Proof 99 — digit-1 data: SINSERT/UNROLL + RROT + NPUSH + SADDTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
CLEARCELLS

# SINSERT 2: 10 20 30 99 → 10 99 20 30
PUSH 10
PUSH 20
PUSH 30
PUSH 99
SINSERT 2
ASSERT SP == 4
POP a
ASSERT a == 30
POP b
ASSERT b == 20
POP c
ASSERT c == 99
POP d
ASSERT d == 10

# SINSERT 1 ≡ SWAP
CLEARSTACK
PUSH 1
PUSH 2
SINSERT 1
POP x
ASSERT x == 1
POP y
ASSERT y == 2

# UNROLL alias ≡ SINSERT
CLEARSTACK
PUSH 5
PUSH 6
PUSH 7
UNROLL 2
# 5 6 7 → 7 5 6
POP u0
ASSERT u0 == 6
POP u1
ASSERT u1 == 5
POP u2
ASSERT u2 == 7

# RROT: a b c → c a b
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
RROT
POP r0
ASSERT r0 == 2
POP r1
ASSERT r1 == 1
POP r2
ASSERT r2 == 3

# NPUSH v n
CLEARSTACK
NPUSH 42 3
ASSERT SP == 3
POP p0
ASSERT p0 == 42
POP p1
ASSERT p1 == 42
POP p2
ASSERT p2 == 42
ASSERT SP == 0

# NPUSH 0 is no-op
NPUSH 9 0
ASSERT SP == 0
ASSERT OK == 1

# SADDTOC: i v → cells[i]+=v leave sum
CLEARCELLS
CELLSET 2 10
PUSH 2
PUSH 5
SADDTOC
ASSERT LAST_N == 15
ASSERT SP == 1
ASSERT CELL(2) == 15
POP s
ASSERT s == 15
# second accumulate
PUSH 2
PUSH 7
SCELLADD
ASSERT LAST_N == 22
ASSERT CELL(2) == 22

# soft fail OOR
CLEARSTACK
PUSH 1
SINSERT 5
ASSERT OK == 0
CLEARSTACK
RROT
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof99_sinsert_npush" LAST_N SP
