# Proof 139 — digit-7 dual-stack pair ALU: DDIV DMOD DMIN DMAX
HOLD_FLASH 1
SCIENCE LOAD

# DDIV — a b c d → (a/c) (b/d)
CLEARSTACK
PUSH 20
PUSH 30
PUSH 4
PUSH 5
DDIV
ASSERT SP == 2
POP y
POP x
ASSERT x == 5
ASSERT y == 6

# 2DIV alias + zero-safe
CLEARSTACK
PUSH 10
PUSH 8
PUSH 0
PUSH 2
2DIV
POP y
POP x
ASSERT x == 0
ASSERT y == 4

# DMOD
CLEARSTACK
PUSH 17
PUSH 23
PUSH 5
PUSH 7
DMOD
POP y
POP x
ASSERT x == 2
ASSERT y == 2

# DREM alias
CLEARSTACK
PUSH 9
PUSH 11
PUSH 4
PUSH 3
DREM
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# DMIN
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 2
DMIN
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# DMAX
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 2
DMAX
POP y
POP x
ASSERT x == 5
ASSERT y == 9

# PAIRMIN / PAIRMAX aliases
CLEARSTACK
PUSH 1
PUSH 100
PUSH 50
PUSH 10
PAIRMIN
POP y
POP x
ASSERT x == 1
ASSERT y == 10

CLEARSTACK
PUSH 1
PUSH 100
PUSH 50
PUSH 10
PAIRMAX
POP y
POP x
ASSERT x == 50
ASSERT y == 100

# soft fails
CLEARSTACK
DDIV
ASSERT OK == 0
DMOD
ASSERT OK == 0
DMIN
ASSERT OK == 0
DMAX
ASSERT OK == 0
PUSH 1
PUSH 2
PUSH 3
DDIV
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof139_ddiv_dmin" LAST_N SP
