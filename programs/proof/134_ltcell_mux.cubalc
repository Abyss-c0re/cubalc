# Proof 134 — digit-5 cell compare/mux: LTCELL GTCELL LECELL GECELL MUXCELL + stack
HOLD_FLASH 1
SCIENCE LOAD

# LTCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 5
CELLSET 2 3
LTCELL 0 2 4
ASSERT LAST_N == 2
ASSERT CELL(0) == 1
ASSERT CELL(1) == 0
ASSERT CELL(2) == 1

# GTCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 5
CELLSET 2 3
GTCELL 0 2 3
ASSERT LAST_N == 1
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1
ASSERT CELL(2) == 0

# LECELL / GECELL
CLEARCELLS
CELLSET 0 2
CELLSET 1 3
CELLSET 2 4
LECELL 0 2 3
ASSERT LAST_N == 2
ASSERT CELL(0) == 1
ASSERT CELL(1) == 1
ASSERT CELL(2) == 0

CLEARCELLS
CELLSET 0 2
CELLSET 1 3
CELLSET 2 4
GECELL 0 2 3
ASSERT LAST_N == 2
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1
ASSERT CELL(2) == 1

# aliases CELLLT CELLGE
CLEARCELLS
CELLSET 0 0
CELLSET 1 9
CELLLT 0 1 1
ASSERT CELL(0) == 1
ASSERT CELL(1) == 0

# MUXCELL dst a b mask n — mask?a:b
CLEARCELLS
CELLSET 0 10
CELLSET 1 20
CELLSET 2 30
CELLSET 3 40
# a at 0..1 = 10,20  b at 2..3 = 30,40  mask at 4..5
CELLSET 4 1
CELLSET 5 0
# dst at 6
MUXCELL 6 0 2 4 2
ASSERT LAST_N == 2
ASSERT CELL(6) == 10
ASSERT CELL(7) == 40

# stack SLTCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 8
CELLSET 2 4
CLEARSTACK
PUSH 0
PUSH 2
PUSH 5
SLTCELL
ASSERT LAST_N == 2
ASSERT CELL(0) == 1
ASSERT CELL(1) == 0
ASSERT CELL(2) == 1

# stack SGTCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 8
CLEARSTACK
PUSH 0
PUSH 1
PUSH 5
SGTCELL
ASSERT LAST_N == 1
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1

# stack SLECELL / SGECELL
CLEARCELLS
CELLSET 0 5
CELLSET 1 5
CELLSET 2 6
CLEARSTACK
PUSH 0
PUSH 2
PUSH 5
SLECELL
ASSERT LAST_N == 2
ASSERT CELL(0) == 1
ASSERT CELL(1) == 1
ASSERT CELL(2) == 0

CLEARCELLS
CELLSET 0 4
CELLSET 1 5
CLEARSTACK
PUSH 0
PUSH 1
PUSH 5
SGECELL
ASSERT LAST_N == 1
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1

# SMUXCELL dlo alo blo mlo n
CLEARCELLS
CELLSET 0 100
CELLSET 1 200
CELLSET 2 300
CELLSET 3 400
CELLSET 4 0
CELLSET 5 1
CLEARSTACK
PUSH 6
PUSH 0
PUSH 2
PUSH 4
PUSH 2
SMUXCELL
ASSERT LAST_N == 2
ASSERT CELL(6) == 300
ASSERT CELL(7) == 200

# soft fails
CLEARSTACK
SLTCELL
ASSERT OK == 0
SGTCELL
ASSERT OK == 0
SMUXCELL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof134_ltcell_mux" LAST_N SP
