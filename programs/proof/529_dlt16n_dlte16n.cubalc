# Proof 529 — digit-3 dual-stack imm 16-bit field ordered-cmp: DLT16N DGT16N DLTE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLT16N: 0x1000 < 0xC000 → 1 ; 0xF000 < 0xC000 → 0
PUSH 0x1000
PUSH 0xF000
DLT16N 0xC000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0xC000
PUSH 0xC000
PAIRLT16N 0xC000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high half preserved: half0 lt; half1 untouched
CLEARSTACK
PUSH 0xAABB0010
PUSH 0xCCDD0030
DLT16N 0x0020 0
POP y
POP x
ASSERT x == 0xAABB0001
ASSERT y == 0xCCDD0000

# S2LT16N n1
CLEARSTACK
PUSH 0x10000000
PUSH 0x30000000
S2LT16N 0x2000 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

# n2
CLEARSTACK
PUSH 0x0000100000000000
PUSH 0x0000050000000000
DLT16N 0x2000 2
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000100000000

# DGT16N
CLEARSTACK
PUSH 0xF000
PUSH 0x1000
DGT16N 0x2000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0x5555
PUSH 0x5555
PAIRGT16N 0x5555 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved gt
CLEARSTACK
PUSH 0x99AA8000
PUSH 0x11220500
DGT16N 0x1000 0
POP y
POP x
ASSERT x == 0x99AA0001
ASSERT y == 0x11220000

# S2GT16N n1
CLEARSTACK
PUSH 0x90000000
PUSH 0x05000000
S2GT16N 0x1000 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

# DLTE16N less/eq/gt
CLEARSTACK
PUSH 0x1000
PUSH 0xC000
DLTE16N 0xC000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0xFFFF
PUSH 0xFFFE
DLEQ16N 0xFFFE 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# high preserved lte
CLEARSTACK
PUSH 0x11227742
PUSH 0x99AA7743
DLTE16N 0x7742 0
POP y
POP x
ASSERT x == 0x11220001
ASSERT y == 0x99AA0000

# S2LTE16N n1
CLEARSTACK
PUSH 0x55550000
PUSH 0x55540000
S2LTE16N 0x5554 1
POP y
POP x
ASSERT x == 0x00000000
ASSERT y == 0x00010000

# aliases + unsigned
CLEARSTACK
PUSH 1
PUSH 3
DCMPLT16N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH 1
DCMPGT16N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 2
DCMPLE16N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x8000
PUSH 0x7FFF
DGT16N 0x7FFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

HOLD_FLASH 0
