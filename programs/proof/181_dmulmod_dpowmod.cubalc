# Proof 181 — digit-2 dual-stack modular: DMULMOD DPOWMOD
HOLD_FLASH 1
SCIENCE LOAD

# DMULMOD: a b c d ma mb → (a*c)%ma (b*d)%mb
CLEARSTACK
PUSH 7
PUSH 5
PUSH 6
PUSH 4
PUSH 10
PUSH 9
DMULMOD
POP y
POP x
ASSERT x == 2
ASSERT y == 2

# 2MULMOD
CLEARSTACK
PUSH 3
PUSH 8
PUSH 4
PUSH 3
PUSH 5
PUSH 7
2MULMOD
POP y
POP x
ASSERT x == 2
ASSERT y == 3

# m<=0 → 0
CLEARSTACK
PUSH 9
PUSH 9
PUSH 2
PUSH 2
PUSH 0
PUSH 0
PAIRMULMOD
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DPOWMOD: a b c d ma mb → (a^c)%ma (b^d)%mb
CLEARSTACK
PUSH 3
PUSH 2
PUSH 4
PUSH 5
PUSH 7
PUSH 13
DPOWMOD
POP y
POP x
ASSERT x == 4
ASSERT y == 6

# 2POWMOD identity exp0 → 1
CLEARSTACK
PUSH 9
PUSH 11
PUSH 0
PUSH 0
PUSH 5
PUSH 7
2POWMOD
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# neg exp → 0
CLEARSTACK
PUSH 2
PUSH 3
PUSH -1
PUSH 2
PUSH 5
PUSH 7
PAIRPOWMOD
POP y
POP x
ASSERT x == 0
ASSERT y == 2

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DMULMOD
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
DPOWMOD
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof181_dmulmod_dpowmod" LAST_N SP
