# Proof 511 — digit-0 stack imm 32-bit field shift: SSHL32N SSHR32N SSAR32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSHL32N: 1<<2=4
PUSH 0x1
SSHL32N 2 0
POP x
ASSERT x == 4

# overflow: 0x80000000 << 1 → 0; high word preserved when n=0
CLEARSTACK
PUSH 0x1122334480000000
SSHL32N 1 0
POP x
ASSERT x == 0x1122334400000000

# k>=32 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
SHL32N 32 0
POP x
ASSERT x == 0

# STACKSHL32N n1: high word of 0x0000000300000001 is 3 <<1 → 6 → 0x0000000600000001
CLEARSTACK
PUSH 0x0000000300000001
STACKSHL32N 1 1
POP x
ASSERT x == 0x0000000600000001

# SSHR32N logical: 0x80000000>>1=0x40000000 ; 0xFFFFFFFF>>1=0x7FFFFFFF
CLEARSTACK
PUSH 0x80000000
SSHR32N 1 0
POP x
ASSERT x == 1073741824

CLEARSTACK
PUSH 0xFFFFFFFF
SHR32N 1 0
POP x
ASSERT x == 2147483647

# high preserved shr word0: 0x11223344FFFFFFFC >>2 → 0x112233443FFFFFFF
CLEARSTACK
PUSH 0x11223344FFFFFFFC
SSHR32N 2 0
POP x
ASSERT x == 0x112233443FFFFFFF

# STACKSHR32N n1: 0x8000000000000000 high=80000000>>1=40000000
CLEARSTACK
PUSH 0x8000000000000000
STACKSHR32N 1 1
POP x
ASSERT x == 0x4000000000000000

# SSAR32N: 0xFFFFFFFE (-2)>>1 → 0xFFFFFFFF ; 0x80000000 (-2^31)>>1 → 0xC0000000
CLEARSTACK
PUSH 0xFFFFFFFE
SSAR32N 1 0
POP x
ASSERT x == 4294967295

CLEARSTACK
PUSH 0x80000000
SAR32N 1 0
POP x
ASSERT x == 3221225472

# k>=32 all sign: neg → FFFFFFFF, pos → 0
CLEARSTACK
PUSH 0x80000000
SSAR32N 32 0
POP x
ASSERT x == 4294967295

CLEARSTACK
PUSH 0x7FFFFFFF
SSAR32N 32 0
POP x
ASSERT x == 0

# positive SAR: 0x00000006>>1=3
CLEARSTACK
PUSH 0x00000006
SSAR32N 1 0
POP x
ASSERT x == 3

# high preserved SAR word1: 0xFFFFFFFE00000000 half high=FFFE → FFFF
CLEARSTACK
PUSH 0xFFFFFFFE00000000
STACKSAR32N 1 1
POP x
ASSERT x == 0xFFFFFFFF00000000

# SLSH32N / SASHR32N aliases
CLEARSTACK
PUSH 0x00000003
SLSH32N 1 0
POP x
ASSERT x == 6

CLEARSTACK
PUSH 0xFFFFFFFE
SASHR32N 1 0
POP x
ASSERT x == 4294967295

# SSHLDWN alias
CLEARSTACK
PUSH 0x40000000
SSHLDWN 1 0
POP x
ASSERT x == 0x80000000

HOLD_FLASH 0
