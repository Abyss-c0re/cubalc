# DIVFLOORN / FLOORDIVN — integer floor division twin of DIVCEILN

HOLD_FLASH 1

# exact
DIVFLOORN 100 10
ASSERT LAST_N == 10
ASSERT DIVFLOORN_OK == 1

# floor remainder
DIVFLOORN 100 16
ASSERT LAST_N == 6
ASSERT DIVFLOORN_A == 100
ASSERT DIVFLOORN_B == 16

# smaller than size → 0 tiles
DIVFLOORN 3 16
ASSERT LAST_N == 0

# zero total
DIVFLOORN 0 16
ASSERT LAST_N == 0

# divide by zero soft
DIVFLOORN 10 0
ASSERT LAST_N == 0
ASSERT DIVFLOORN_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

# negative true floor toward -inf: -7/3 = -3 (not C trunc -2)
DIVFLOORN -7 3
ASSERT LAST_N == -3

# FLOORDIVN / TILECOUNT aliases
FLOORDIVN 50 20
ASSERT LAST_N == 2
TILECOUNT 1 1
ASSERT LAST_N == 1

# optional BY
DIVFLOORN 25 BY 10
ASSERT LAST_N == 2

# pipeline after GETFLAGN + contrast DIVCEILN
SYS ENV SET CUBALC_ARG0 "--total=100"
SYS ENV SET CUBALC_ARG1 "--size=16"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGN total OR 0
LET total = LAST_N
GETFLAGN size OR 1
LET size = LAST_N
FLOORN size 1
LET size = LAST_N
DIVFLOORN total size
ASSERT LAST_N == 6
DIVCEILN total size
ASSERT LAST_N == 7

# var subjects
LET a 17
LET b 5
DIVFLOORN a b
ASSERT LAST_N == 3

# LAST decimal
DIVFLOORN 9 4
SYS EQS LAST "2"
ASSERT LAST_N == 1

PRINT "divfloorn ok"
