# Proof 322 — digit-6 sat energy: SSATMULTOC SCLAMPTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSATMULTOC
CELLSET 1 6
PUSH 1
PUSH 7
SSATMULTOC
ASSERT LAST_N == 42
ASSERT CELL(1) == 42
POP a
ASSERT a == 42

# SCELLSATMUL alias
CELLSET 2 5
PUSH 2
PUSH 0
SCELLSATMUL
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SCLAMPTOC mid
CELLSET 3 50
PUSH 3
PUSH 0
PUSH 100
SCLAMPTOC
ASSERT LAST_N == 50
ASSERT CELL(3) == 50
POP

# clamp below lo
CELLSET 4 5
PUSH 4
PUSH 10
PUSH 20
SBOUNDTOC
ASSERT LAST_N == 10
ASSERT CELL(4) == 10
POP

# clamp above hi
CELLSET 5 99
PUSH 5
PUSH 0
PUSH 50
SCELLCLAMP
ASSERT LAST_N == 50
ASSERT CELL(5) == 50
POP

# soft fails
CLEARSTACK
SSATMULTOC
ASSERT OK == 0
SCLAMPTOC
ASSERT OK == 0
PUSH 1
SCLAMPTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof322_ssatmultoc_sclamptoc" LAST_N SP
HOLD_FLASH 1
