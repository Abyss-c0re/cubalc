# GETFLAGDIR / MKFLAGDIR — path flag peel + ABSPATH + mkdir -p
# Usability: --out state/run without GETFLAGPATH + SYS MKDIR glue.

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET MI_OUTDIR

SYS TMP
LET td = LAST
SYS PID
SYS STR LAST_N
LET pid = LAST
SYS JOIN td "mi_gfd_"
SYS CAT LAST pid
LET root = LAST
SYS MKDIR root
ASSERT OK == 1

# nested default that does not exist yet
SYS JOIN root "fresh_out"
LET fresh = LAST
SYS EXIST fresh
ASSERT LAST_N == 0

# default relative/absolute → create
GETFLAGDIR out|o OR ENV MI_OUTDIR OR fresh
ASSERT OK == 1
SYS EQS GETFLAGDIR_SRC "default"
ASSERT LAST_N == 1
ASSERT GETFLAGDIR_HIT == 0
ASSERT GETFLAGDIR_CREATED == 1
ASSERT GETFLAGDIR_EXIST == 1
ASSERT ISDIR == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ISDIR LAST
ASSERT LAST_N == 1
LET abs_fresh = LAST
SYS EQS FLAGDIR abs_fresh
ASSERT LAST_N == 1

# second call: already exists → CREATED=0
GETFLAGDIR out OR fresh
ASSERT OK == 1
ASSERT GETFLAGDIR_CREATED == 0
ASSERT GETFLAGDIR_EXIST == 1
SYS EQS LAST abs_fresh
ASSERT LAST_N == 1

# ENV wins over default
SYS JOIN root "from_env"
LET envp = LAST
SYS ENV SET MI_OUTDIR envp
GETFLAGDIR out OR ENV MI_OUTDIR OR fresh
SYS EQS GETFLAGDIR_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "MI_OUTDIR"
ASSERT LAST_N == 1
ASSERT GETFLAGDIR_CREATED == 1
SYS ISDIR LAST
ASSERT LAST_N == 1
SYS ENDS LAST "from_env"
ASSERT LAST_N == 1

# CLI beats ENV
SYS JOIN root "from_cli"
LET clip = LAST
SYS ENV SET MI_OUTDIR envp
SYS ENV SET CUBALC_ARG0 "--out"
SYS ENV SET CUBALC_ARG1 clip
SYS ENV SET CUBALC_ARGC "2"
GETFLAGDIR out|o OR ENV MI_OUTDIR OR fresh
ASSERT GETFLAGDIR_HIT == 1
SYS EQS GETFLAGDIR_SRC "cli"
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "out"
ASSERT LAST_N == 1
ASSERT GETFLAGDIR_CREATED == 1
SYS ENDS LAST "from_cli"
ASSERT LAST_N == 1
SYS ISDIR LAST
ASSERT LAST_N == 1

# short -o
SYS JOIN root "short_o"
LET shortp = LAST
SYS ENV SET CUBALC_ARG0 "-o"
SYS ENV SET CUBALC_ARG1 shortp
SYS ENV SET CUBALC_ARGC "2"
MKFLAGDIR out|o OR "none"
ASSERT GETFLAGDIR_HIT == 1
SYS EQS FLAG_HIT_NAME "o"
ASSERT LAST_N == 1
SYS ENDS LAST "short_o"
ASSERT LAST_N == 1
SYS ISDIR LAST
ASSERT LAST_N == 1

# empty soft miss
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET MI_OUTDIR
GETFLAGDIR out
ASSERT OK == 0
ASSERT GETFLAGDIR_EXIST == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0
SYS HAS e "empty"
ASSERT LAST_N == 1

# cleanup (best-effort; TMP fixture)
SYS WALK root
SYS RMALL LAST
SYS RM root

PRINT "getflagdir ok"
