# Proof 434 — digit-1 cell fixed-width 16: ROR16CELL SHL16CELL SHR16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# ROR16CELL: 0x0010 rotr 4 → 0x0001; 1 rotr 1 → 0x8000
CELLSET 0 16
CELLSET 1 1
ROR16CELL 0 1 4
ASSERT CELL(0) == 1
# 1 rotr 4 = 0x1000
ASSERT CELL(1) == 4096
ASSERT LAST_N == 2

# ROR16RANGE: 0x8000 rotr 1 → 0x4000
CELLSET 2 32768
ROR16RANGE 2 2 1
ASSERT CELL(2) == 16384
ASSERT LAST_N == 1

# SHL16CELL: [1,2] << 4 → [16,32]
CELLSET 3 1
CELLSET 4 2
SHL16CELL 3 4 4
ASSERT CELL(3) == 16
ASSERT CELL(4) == 32
ASSERT LAST_N == 2

# SHL16RANGE: 0x8000 << 1 → 0 (uint16 overflow)
CELLSET 5 32768
SHL16RANGE 5 5 1
ASSERT CELL(5) == 0

# SHR16CELL: 0x8000 >> 1 → 0x4000; 255 >> 4 → 15
CELLSET 6 32768
CELLSET 7 255
SHR16CELL 6 7 1
ASSERT CELL(6) == 16384
ASSERT CELL(7) == 127
ASSERT LAST_N == 2

# SHR16RANGE k>=16 → 0
CELLSET 8 255
SHR16RANGE 8 8 16
ASSERT CELL(8) == 0

# round-trip ROR after ROL
CELLSET 9 0xA5
ROL16CELL 9 9 5
ROR16CELL 9 9 5
ASSERT CELL(9) == 165

HOLD_FLASH 0
