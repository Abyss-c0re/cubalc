# ARGMAP / ARGKV — raw argv i=value bag (FLAGMAP twin for full CUBALC_ARGn)

HOLD_FLASH 1

# empty
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
ARGMAP
ASSERT LAST_N == 0
ASSERT ARGMAP_N == 0
ASSERT ARGC == 0
ASSERT OK == 1

# mixed flags + positionals
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "--out=hi.txt"
SYS ENV SET CUBALC_ARG2 "a.txt"
SYS ENV SET CUBALC_ARG3 "b.txt"
SYS ENV SET CUBALC_ARGC "4"
ARGMAP
ASSERT LAST_N == 4
ASSERT ARGMAP_N == 4
SYS HASLINE LAST "0=--verbose"
ASSERT LAST_N == 1
SYS HASLINE LAST "1=--out=hi.txt"
ASSERT LAST_N == 1
SYS HASLINE LAST "2=a.txt"
ASSERT LAST_N == 1
SYS HASLINE LAST "3=b.txt"
ASSERT LAST_N == 1

# LOOKUP by index
SYS LOOKUP ARGMAP "2" "="
ASSERT OK == 1
SYS EQS LAST "a.txt"
ASSERT LAST_N == 1

# alias
ARGKV
ASSERT ARGMAP_N == 4

# FLAGMAP coexists (flags only)
FLAGMAP
ASSERT FLAGMAP_N == 2

# discoverable
HASFORM "ARGMAP"
ASSERT LAST_N == 1
HASFORM "ARGKV"
ASSERT LAST_N == 1

RELATED "ARGMAP"
SYS HASLINE LAST "FLAGMAP"
ASSERT LAST_N == 1

PRINT "argmap ok"
PASS
