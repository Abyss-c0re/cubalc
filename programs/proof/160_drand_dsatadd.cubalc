# Proof 160 — digit-6 dual-stack RNG + sat: DRAND DSATADD DSATSUB
HOLD_FLASH 1
SCIENCE LOAD

# DRAND — seeded pair rand in [0,max)
SEED 42
CLEARSTACK
PUSH 100
PUSH 50
DRAND
POP y
POP x
ASSERT x >= 0
ASSERT x < 100
ASSERT y >= 0
ASSERT y < 50

SEED 1
CLEARSTACK
PUSH 0
PUSH -3
2RAND
POP y
POP x
# max<=0 → 10
ASSERT x >= 0
ASSERT x < 10
ASSERT y >= 0
ASSERT y < 10

# DSATADD — normal
CLEARSTACK
PUSH 10
PUSH 20
PUSH 5
PUSH 7
DSATADD
POP y
POP x
ASSERT x == 15
ASSERT y == 27

# DSATADD — saturate high (5e18+5e18 overflows signed 64)
CLEARSTACK
PUSH 5000000000000000000
PUSH 100
PUSH 5000000000000000000
PUSH 0
2SATADD
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 100

# DSATSUB — normal
CLEARSTACK
PUSH 10
PUSH 3
PUSH 4
PUSH 8
DSATSUB
POP y
POP x
ASSERT x == 6
ASSERT y == -5

# DSATSUB — saturate low (-5e18 - 5e18 underflows)
CLEARSTACK
PUSH -5000000000000000000
PUSH 5
PUSH 5000000000000000000
PUSH 1
2SATSUB
POP y
POP x
# result is LONG_MIN; compare via LE (avoid parsing LONG_MIN literal issues)
ASSERT x < -9000000000000000000
ASSERT y == 4

# aliases
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PAIRSATADD
POP y
POP x
ASSERT x == 4
ASSERT y == 6

CLEARSTACK
PUSH 9
PUSH 1
PUSH 2
PUSH 3
PAIRSATSUB
POP y
POP x
ASSERT x == 7
ASSERT y == -2

# soft fails
CLEARSTACK
DRAND
ASSERT OK == 0
CLEARSTACK
DSATADD
ASSERT OK == 0
CLEARSTACK
DSATSUB
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2SATADD
ASSERT OK == 0
CLEARSTACK
PUSH 1
2RAND
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof160_drand_dsatadd" LAST_N SP
