# Proof 412 — digit-3 stack dual fixed clip TOC: SCLIP4TOC SCLIP16TOC SCLIP32TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLIP4TOC: 20 → 15
CELLSET 1 20
PUSH 1
SCLIP4TOC
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP

# CLIP4TOC alias: 7 stays 7
CELLSET 2 7
PUSH 2
CLIP4TOC
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SCLIPNTOC: negative via sext4 of 15 → -1 then clip4 → 0
CELLSET 3 15
PUSH 3
SSEXT4TOC
POP
PUSH 3
SCLIPNTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SCLIP16TOC: 70000 → 65535
CELLSET 4 70000
PUSH 4
SCLIP16TOC
ASSERT LAST_N == 65535
ASSERT CELL(4) == 65535
POP

# CLIP16TOC: 1000 stays
CELLSET 5 1000
PUSH 5
CLIP16TOC
ASSERT LAST_N == 1000
ASSERT CELL(5) == 1000
POP

# SCLIP32TOC: negative → 0
CELLSET 6 15
PUSH 6
SSEXT4TOC
POP
PUSH 6
SCLIP32TOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# CLIP32TOC: 100 stays 100
CELLSET 7 100
PUSH 7
CLIP32TOC
ASSERT LAST_N == 100
ASSERT CELL(7) == 100
POP

# soft short stack OK=0
CLEARSTACK
SCLIP4TOC
ASSERT OK == 0
SCLIP16TOC
ASSERT OK == 0
SCLIP32TOC
ASSERT OK == 0

PRINT "412_sclip4toc_sclip32toc OK"
