# Proof 492 — digit-0 dual-stack imm 8-bit field metrics: DBITREV8N DPOPCNT8N DPARITY8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DBITREV8N: 0x01 → 0x80 ; 0x03 → 0xC0
PUSH 0x01
PUSH 0x03
DBITREV8N 0
POP y
POP x
ASSERT x == 128
ASSERT y == 192

# 0xA5 → 0xA5 (palindrome bits); 0x0F → 0xF0
CLEARSTACK
PUSH 0xA5
PUSH 0x0F
PAIRBITREV8N 0
POP y
POP x
ASSERT x == 0xA5
ASSERT y == 0xF0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
PUSH 0x99AABBCCDDEEFF05
DBITREV8N 0
DBITREV8N 0
POP y
POP x
ASSERT x == 0x112233445566778A
ASSERT y == 0x99AABBCCDDEEFF05

# S2BITREV8N n1: byte1 of 0x..0180 is 01 → 80 → 0x..8080
CLEARSTACK
PUSH 0x0180
PUSH 0x0F00
S2BITREV8N 1
POP y
POP x
ASSERT x == 0x8080
ASSERT y == 0xF000

# DBREV8N alias
CLEARSTACK
PUSH 0x01
PUSH 0x01
DBREV8N 0
POP y
POP x
ASSERT x == 128
ASSERT y == 128

# DPOPCNT8N: 0→0 ; FF→8
CLEARSTACK
PUSH 0x0
PUSH 0xFF
DPOPCNT8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 8

# high preserved: 0x...55 → pop 4
CLEARSTACK
PUSH 0x1122334455667755
PUSH 0x99AABBCCDDEEFF07
PAIRPOPCNT8N 0
POP y
POP x
ASSERT x == 0x1122334455667704
ASSERT y == 0x99AABBCCDDEEFF03

# STACK2POPCNT8N n1: 0x..FF00 byte1=FF→8 → 0x..0800
CLEARSTACK
PUSH 0xFF00
PUSH 0x0700
STACK2POPCNT8N 1
POP y
POP x
ASSERT x == 0x0800
ASSERT y == 0x0300

# DPCNT8N alias: 0xAA→4 ; 0x03→2
CLEARSTACK
PUSH 0xAA
PUSH 0x03
DPCNT8N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 2

# DPARITY8N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DPARITY8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x3
PUSH 0x7
PAIRPARITY8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# high preserved parity byte1: 0x..9000 byte1=90=10010000 → 0; 0x..B000=10110000 → 1
CLEARSTACK
PUSH 0x9000
PUSH 0xB000
S2PARITY8N 1
POP y
POP x
ASSERT x == 0x0000
ASSERT y == 0x0100

# DXORRED8N alias: FF even→0 ; FE odd→1
CLEARSTACK
PUSH 0xFF
PUSH 0xFE
DXORRED8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

HOLD_FLASH 0
