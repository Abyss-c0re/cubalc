# GETFLAGCSV / FLAGCSV — multi-occurrence + comma-split flag bags

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET TAGS

# miss → empty
GETFLAGCSV tags
ASSERT LAST_N == 0
ASSERT GETFLAGCSV_HIT == 0
SYS EQS GETFLAGCSV_SRC "none"
ASSERT LAST_N == 1

# OR default CSV
GETFLAGCSV tags OR "a,b"
ASSERT LAST_N == 2
SYS EQS GETFLAGCSV_SRC "default"
ASSERT LAST_N == 1
SYS NTH 0
SYS EQS LAST "a"
ASSERT LAST_N == 1
GETFLAGCSV tags OR "a,b"
SYS NTH 1
SYS EQS LAST "b"
ASSERT LAST_N == 1

# ENV CSV
SYS ENV SET TAGS "x, y, z"
GETFLAGCSV tags OR ENV TAGS OR ""
ASSERT LAST_N == 3
SYS EQS GETFLAGCSV_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "TAGS"
ASSERT LAST_N == 1
SYS NTH 1
SYS EQS LAST "y"
ASSERT LAST_N == 1

# single --tags=a,b,c
SYS ENV SET CUBALC_ARG0 "--tags=a,b,c"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGCSV tags|t OR ENV TAGS OR ""
ASSERT LAST_N == 3
ASSERT GETFLAGCSV_HIT == 1
SYS EQS GETFLAGCSV_SRC "cli"
ASSERT LAST_N == 1
SYS NTH 2
SYS EQS LAST "c"
ASSERT LAST_N == 1

# multi: --tag a --tag b,c  → a\nb\nc
SYS ENV SET CUBALC_ARG0 "--tag"
SYS ENV SET CUBALC_ARG1 "a"
SYS ENV SET CUBALC_ARG2 "--tag"
SYS ENV SET CUBALC_ARG3 "b,c"
SYS ENV SET CUBALC_ARGC "4"
FLAGCSV tag
ASSERT LAST_N == 3
ASSERT GETFLAGCSV_HIT == 1
SYS NTH 0
SYS EQS LAST "a"
ASSERT LAST_N == 1
FLAGCSV tag
SYS NTH 2
SYS EQS LAST "c"
ASSERT LAST_N == 1

# short -t + spaces around commas
SYS ENV SET CUBALC_ARG0 "-t"
SYS ENV SET CUBALC_ARG1 "one, two ,three"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGCSV tags|t
ASSERT LAST_N == 3
SYS NTH 1
SYS EQS LAST "two"
ASSERT LAST_N == 1

# CLI beats ENV
SYS ENV SET TAGS "envonly"
SYS ENV SET CUBALC_ARG0 "--tags=cli"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGCSV tags OR ENV TAGS OR "def"
ASSERT LAST_N == 1
SYS NTH 0
SYS EQS LAST "cli"
ASSERT LAST_N == 1
SYS EQS GETFLAGCSV_SRC "cli"
ASSERT LAST_N == 1

PRINT "getflagcsv ok"
