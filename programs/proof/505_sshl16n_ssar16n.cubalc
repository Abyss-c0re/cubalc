# Proof 505 — digit-8 stack imm 16-bit field shift: SSHL16N SSHR16N SSAR16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSHL16N: 1<<2=4
PUSH 0x1
SSHL16N 2 0
POP x
ASSERT x == 4

# overflow: 0x8000 << 1 → 0; preserve high
CLEARSTACK
PUSH 0x112233448000
SSHL16N 1 0
POP x
ASSERT x == 0x112233440000

# k>=16 → 0
CLEARSTACK
PUSH 0xFFFF
SHL16N 16 0
POP x
ASSERT x == 0

# STACKSHL16N n1: half1 of 0x00030001 is 0003 <<1 → 0006 → 0x00060001
CLEARSTACK
PUSH 0x00030001
STACKSHL16N 1 1
POP x
ASSERT x == 0x00060001

# SSHR16N logical: 0x8000>>1=0x4000 ; 0xFFFF>>1=0x7FFF
CLEARSTACK
PUSH 0x8000
SSHR16N 1 0
POP x
ASSERT x == 16384

CLEARSTACK
PUSH 0xFFFF
SHR16N 1 0
POP x
ASSERT x == 32767

# high preserved shr
CLEARSTACK
PUSH 0x11223344FFFC
SSHR16N 2 0
POP x
ASSERT x == 0x112233443FFF

# STACKSHR16N n1: 0x80000000 half1=8000>>1=4000 → 0x40000000
CLEARSTACK
PUSH 0x80000000
STACKSHR16N 1 1
POP x
ASSERT x == 0x40000000

# SSAR16N: 0xFFFE (-2)>>1 → 0xFFFF ; 0x8000 (-32768)>>1 → 0xC000
CLEARSTACK
PUSH 0xFFFE
SSAR16N 1 0
POP x
ASSERT x == 65535

CLEARSTACK
PUSH 0x8000
SAR16N 1 0
POP x
ASSERT x == 49152

# k>=16 all sign: neg → FFFF, pos → 0
CLEARSTACK
PUSH 0x8000
SSAR16N 16 0
POP x
ASSERT x == 65535

CLEARSTACK
PUSH 0x7FFF
SSAR16N 16 0
POP x
ASSERT x == 0

# positive SAR: 0x0006>>1=3
CLEARSTACK
PUSH 0x0006
SSAR16N 1 0
POP x
ASSERT x == 3

# high preserved SAR half1: 0x..FFFE0000 half1=FFFE → FFFF
CLEARSTACK
PUSH 0x11223344FFFE0000
STACKSAR16N 1 1
POP x
ASSERT x == 0x11223344FFFF0000

# SLSH16N / SASHR16N aliases
CLEARSTACK
PUSH 0x0003
SLSH16N 1 0
POP x
ASSERT x == 6

CLEARSTACK
PUSH 0xFFFE
SASHR16N 1 0
POP x
ASSERT x == 65535

# SSHLWORDN alias
CLEARSTACK
PUSH 0x4000
SSHLWORDN 1 0
POP x
ASSERT x == 0x8000

HOLD_FLASH 0
