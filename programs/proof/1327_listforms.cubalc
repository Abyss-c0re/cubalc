# LISTFORMS / COUNTFORMS — in-lang dual of cubalc forms

LISTFORMS SORT
ASSERT OK == 1
ASSERT LAST_N >= 3
ASSERT LISTFORMS_N >= 3
ASSERT LISTFORMS_FILTER == "SORT"
SYS HASLINE LAST "SORTLIBS"
ASSERT LAST_N == 1

LISTFORMS LIB
ASSERT OK == 1
ASSERT LISTFORMS_N >= 5
SYS HASLINE LAST "LIBAGE"
ASSERT LAST_N == 1

COUNTFORMS FORM
ASSERT OK == 1
ASSERT LAST_N >= 5
ASSERT COUNTFORMS_N >= 5

COUNTFORMS
ASSERT OK == 1
ASSERT LAST_N >= 100

LISTFORMS ZZZNOMATCH_XYZ
ASSERT OK == 1
ASSERT LAST_N == 0

LISTFORMS HASFORM
SYS HASLINE LAST "HASFORM"
ASSERT LAST_N == 1
HASFORM HASFORM
ASSERT LAST_N == 1

PASS
PRINT "1327_listforms: PASS"
