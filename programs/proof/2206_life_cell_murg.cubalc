ASSERT LAST_N == sa2 - 7 "starved murg atp-7"
GETF starved energy
ASSERT LAST_N == se2 - 7 "starved murg e-7"
GETF starved heat
ASSERT LAST_N == sh2 + 7 "starved murg h+7"

