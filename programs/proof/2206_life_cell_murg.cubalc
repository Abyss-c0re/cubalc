LET a0 = LAST_N
GETF gate pcr
LET c0 = LAST_N
GETF gate reserve
LET r0 = LAST_N
GETF gate age
LET age0 = LAST_N
GETF gate pmf
LET pmf0 = LAST_N
SEND gate murg 4
ASSERT LAST_N == 4 "gate murg4"
GETF gate heat
ASSERT LAST_N == h0 + 4 "gate murg h+4"
GETF gate energy
ASSERT LAST_N == e0 - 4 "gate murg e-4"
GETF gate atp
ASSERT LAST_N == a0 - 4 "gate murg atp-4"
GETF gate pcr
ASSERT LAST_N == c0 "gate murg pcr held"
GETF gate reserve
ASSERT LAST_N == r0 "gate murg r held"
GETF gate age
ASSERT LAST_N == age0 "gate murg age held"
GETF gate pmf
ASSERT LAST_N == pmf0 "gate murg pmf held"

