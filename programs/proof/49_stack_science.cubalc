# Proof 49 — digit-8 stack science duals: SAVG SPCT SHYP SHAM SDIST + DIST
HOLD_FLASH 1
SCIENCE LOAD

# expr DIST / ABSDIFF
ASSERT DIST(10, 3) == 7
ASSERT DIST(3, 10) == 7
ASSERT ABSDIFF(-5, 2) == 7
ASSERT DIST(0, 0) == 0

# SAVG
CLEARSTACK
PUSH 10
PUSH 20
SAVG
ASSERT LAST_N == 15
CLEARSTACK
PUSH 7
PUSH 8
STACKAVG
ASSERT LAST_N == 7

# SPCT — a is what % of b
CLEARSTACK
PUSH 25
PUSH 100
SPCT
ASSERT LAST_N == 25
CLEARSTACK
PUSH 1
PUSH 4
SPERCENT
ASSERT LAST_N == 25
CLEARSTACK
PUSH 5
PUSH 0
SPCT
ASSERT LAST_N == 0

# SHYP — integer hypotenuse
CLEARSTACK
PUSH 3
PUSH 4
SHYP
ASSERT LAST_N == 5
CLEARSTACK
PUSH 5
PUSH 12
STACKHYP
ASSERT LAST_N == 13
CLEARSTACK
PUSH 0
PUSH 0
SHYPOT
ASSERT LAST_N == 0

# SHAM / SHAMMING — Hamming distance (popcount of XOR)
CLEARSTACK
PUSH 0x0F
PUSH 0x00
SHAM
ASSERT LAST_N == 4
CLEARSTACK
PUSH 0xAA
PUSH 0xAA
SHAMMING
ASSERT LAST_N == 0
CLEARSTACK
PUSH 1
PUSH 2
STACKHAMMING
ASSERT LAST_N == 2

# SDIST
CLEARSTACK
PUSH 10
PUSH 3
SDIST
ASSERT LAST_N == 7
CLEARSTACK
PUSH -5
PUSH 2
SABSDIFF
ASSERT LAST_N == 7

# compose: hyp of avg/dist path
CLEARSTACK
PUSH 6
PUSH 8
SHYP
PUSH 5
SDIST
ASSERT LAST_N == 5

# underflow
CLEARSTACK
SAVG
ASSERT OK == 0
CLEARSTACK
SPCT
ASSERT OK == 0
CLEARSTACK
SHYP
ASSERT OK == 0
CLEARSTACK
SHAM
ASSERT OK == 0
CLEARSTACK
SDIST
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof49_stack_science" LAST_N SP
