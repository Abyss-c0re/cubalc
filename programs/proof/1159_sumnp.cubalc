# SUMNP / MAXNP / MINNP / AVGNP / TOPKEYP / BOTKEYP — multi-plate numeric aggregates
# Usability: duals of SYS JSONSUMN/JSONMAXN/JSONTOPKEY without VALS+SUM glue.

HOLD_FLASH 1

LET PLATE = "{\"a\":10,\"b\":2,\"c\":8,\"label\":\"x\"}"
LET PEER = "{\"warn\":3,\"error\":9,\"info\":1}"
LET empty = "{}"

# sum on conventional PLATE (strings skipped)
SUMNP
ASSERT OK == 1
ASSERT LAST_N == 20
ASSERT SUMNP_N == 20
ASSERT SUMNP_FROM == 0

SUMNP FROM PEER
ASSERT SUMNP_FROM == 1
ASSERT SUMNP_N == 13

# max/min
MAXNP
ASSERT LAST_N == 10
ASSERT MAXNP_N == 10
MINNP
ASSERT LAST_N == 2
ASSERT MINNP_N == 2

MAXNP FROM PEER
ASSERT LAST_N == 9
MINNP FROM PEER
ASSERT LAST_N == 1

# integer mean
AVGNP
ASSERT AVGNP_N == 6
ASSERT LAST_N == 6
AVGNP FROM PEER
ASSERT LAST_N == 4

# top/bot key by value
TOPKEYP
SYS EQS LAST "a"
ASSERT LAST_N == 1
ASSERT TOPKEYP_N == 10
ASSERT TOPKEYP_V == 10

BOTKEYP
SYS EQS LAST "b"
ASSERT LAST_N == 1
ASSERT BOTKEYP_N == 2

TOPKEYP FROM PEER
SYS EQS LAST "error"
ASSERT LAST_N == 1
ASSERT TOPKEYP_N == 9

BOTKEYP FROM PEER
SYS EQS LAST "info"
ASSERT LAST_N == 1
ASSERT BOTKEYP_N == 1

# empty soft
SUMNP FROM empty
ASSERT SUMNP_N == 0
TOPKEYP FROM empty
SYS EMPTY LAST
ASSERT LAST_N == 1

# aliases
TOTALP FROM PEER
ASSERT SUMNP_N == 13
MAXKEYP FROM PEER
SYS EQS LAST "error"
ASSERT LAST_N == 1
MINKEYP FROM PEER
SYS EQS LAST "info"
ASSERT LAST_N == 1
MEANP
ASSERT AVGNP_N == 6

PRINT "sumnp soft ok"
