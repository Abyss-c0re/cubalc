# Proof 337 — digit-7 unary control TOC: SSIGNTOC SEQZTOC SNEZTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSIGNTOC positive → 1
CELLSET 1 42
PUSH 1
SSIGNTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# SGNTOC zero → 0
CELLSET 2 0
PUSH 2
SGNTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SSIGNAT negative → -1
PUSH 3
PUSH (-5)
SSETCELL
POP
PUSH 3
SSIGNAT
ASSERT LAST_N == (-1)
ASSERT CELL(3) == (-1)
POP

# SEQZTOC true
CELLSET 4 0
PUSH 4
SEQZTOC
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# EQZTOC false (nonzero)
CELLSET 5 9
PUSH 5
EQZTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SEQZAT alias
CELLSET 6 0
PUSH 6
SEQZAT
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# SNEZTOC true
CELLSET 7 3
PUSH 7
SNEZTOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# NEZTOC false
CELLSET 8 0
PUSH 8
NEZTOC
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# SNEZAT after negative cell
PUSH 9
PUSH (-1)
SSETCELL
POP
PUSH 9
SNEZAT
ASSERT LAST_N == 1
ASSERT CELL(9) == 1
POP

# soft fails
CLEARSTACK
SSIGNTOC
ASSERT OK == 0
SEQZTOC
ASSERT OK == 0
SNEZTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof337_ssigntoc_snez" LAST_N SP
HOLD_FLASH 1
