# Proof 447 — digit-3 cell fixed-width 32 bitwise: AND32CELL OR32CELL XOR32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# AND32CELL: 0xFF & 0x0F → 0x0F; high bits cleared by low32
CELLSET 0 255
CELLSET 1 4294967295
AND32CELL 0 1 15
ASSERT CELL(0) == 15
ASSERT CELL(1) == 15
ASSERT LAST_N == 2

# OR32CELL: 0x0F | 0xF0 → 0xFF
CELLSET 2 15
OR32CELL 2 2 240
ASSERT CELL(2) == 255
ASSERT LAST_N == 1

# XOR32CELL: 0xFF ^ 0x0F → 0xF0
CELLSET 3 255
XOR32CELL 3 3 15
ASSERT CELL(3) == 240
ASSERT LAST_N == 1

# high bits above 32 ignored on both sides
# 2^32+1 (4294967297) & 0xFF → 1
CELLSET 4 4294967297
AND32CELL 4 4 255
ASSERT CELL(4) == 1

# 0x100000001 | 2 → low32: 1|2 = 3
CELLSET 5 4294967297
OR32CELL 5 5 2
ASSERT CELL(5) == 3

# XOR self → 0 (low32)
CELLSET 6 4294967295
XOR32CELL 6 6 4294967295
ASSERT CELL(6) == 0

# AND32RANGE alias
CELLSET 7 0xABCD1234
AND32RANGE 7 7 0xFF
ASSERT CELL(7) == 0x34

# range OR: two cells
CELLSET 8 1
CELLSET 9 2
OR32CELL 8 9 4
ASSERT CELL(8) == 5
ASSERT CELL(9) == 6
ASSERT LAST_N == 2

# XOR32RANGE single: 0xA5A5A5A5 ^ 0xFFFFFFFF → ~0xA5A5A5A5 low32
CELLSET 10 0xA5A5A5A5
XOR32RANGE 10 10 4294967295
ASSERT CELL(10) == 1515870810

HOLD_FLASH 0
