# Proof 405 — digit-8 stack dual sign/zero extend TOC: SSEXTTOC SZEXTTOC SSEXT8TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SZEXTTOC: zero-extend low 4 of 0xFF → 0xF
CELLSET 1 255
PUSH 1
PUSH 4
SZEXTTOC
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP

# ZEXTTOC alias: low 8 of 0xABCD → 0xCD
CELLSET 2 43981
PUSH 2
PUSH 8
ZEXTTOC
ASSERT LAST_N == 205
ASSERT CELL(2) == 205
POP

# SSEXTTOC: sign-extend low 4 of 0x0F → -1
CELLSET 3 15
PUSH 3
PUSH 4
SSEXTTOC
ASSERT LAST_N == -1
ASSERT CELL(3) == -1
POP

# SEXTTOC alias: low 8 of 0x80 → -128
CELLSET 4 128
PUSH 4
PUSH 8
SEXTTOC
ASSERT LAST_N == -128
ASSERT CELL(4) == -128
POP

# SSEXTTOC positive: low 4 of 0x07 → 7
CELLSET 5 7
PUSH 5
PUSH 4
SSEXTTOC
ASSERT LAST_N == 7
ASSERT CELL(5) == 7
POP

# SSEXT8TOC: fixed 8-bit sign-extend of 0xFF → -1
CELLSET 6 255
PUSH 6
SSEXT8TOC
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# SEXT8TOC alias: 0x7F → 127
CELLSET 7 127
PUSH 7
SEXT8TOC
ASSERT LAST_N == 127
ASSERT CELL(7) == 127
POP

# SSEXTBTOC: 0x80 → -128
CELLSET 8 128
PUSH 8
SSEXTBTOC
ASSERT LAST_N == -128
ASSERT CELL(8) == -128
POP

# w=0 → 0
CELLSET 9 99
PUSH 9
PUSH 0
SZEXTTOC
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft short stack OK=0
CLEARSTACK
SSEXTTOC
ASSERT OK == 0
PUSH 1
SZEXTTOC
ASSERT OK == 0
CLEARSTACK
SSEXT8TOC
ASSERT OK == 0

PRINT "405_ssexttoc_szexttoc OK"
