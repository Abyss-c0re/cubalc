# Proof 409 — digit-1 imm dual fixed nibble/byte extend: SSEXT8TOCN SSEXT4TOCN SZEXT4TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSEXT8TOCN: 0xFF → -1
CELLSET 1 255
PUSH 1
SSEXT8TOCN
ASSERT LAST_N == -1
ASSERT CELL(1) == -1
POP

# SEXT8TOCN alias: 0x80 → -128
CELLSET 2 128
PUSH 2
SEXT8TOCN
ASSERT LAST_N == -128
ASSERT CELL(2) == -128
POP

# SSEXTBTOCN: 0x7F → 127
CELLSET 3 127
PUSH 3
SSEXTBTOCN
ASSERT LAST_N == 127
ASSERT CELL(3) == 127
POP

# SSEXT4TOCN: 0x0F → -1
CELLSET 4 15
PUSH 4
SSEXT4TOCN
ASSERT LAST_N == -1
ASSERT CELL(4) == -1
POP

# SEXT4TOCN: 0x07 → 7
CELLSET 5 7
PUSH 5
SEXT4TOCN
ASSERT LAST_N == 7
ASSERT CELL(5) == 7
POP

# SSEXTNTOCN: 0xF8=248 → -8
CELLSET 6 248
PUSH 6
SSEXTNTOCN
ASSERT LAST_N == -8
ASSERT CELL(6) == -8
POP

# SZEXT4TOCN: 0xAB=171 → 0xB=11
CELLSET 7 171
PUSH 7
SZEXT4TOCN
ASSERT LAST_N == 11
ASSERT CELL(7) == 11
POP

# ZEXT4TOCN alias: 0xFF → 15
CELLSET 8 255
PUSH 8
ZEXT4TOCN
ASSERT LAST_N == 15
ASSERT CELL(8) == 15
POP

# soft short stack OK=0
CLEARSTACK
SSEXT8TOCN
ASSERT OK == 0
SSEXT4TOCN
ASSERT OK == 0
SZEXT4TOCN
ASSERT OK == 0

PRINT "409_ssext8tocn_szext4tocn OK"
