# Proof 378 — digit-1 imm byte field TOC: SBYTETOCN SSETBYTETOCN SCLRBYTETOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSETBYTETOCN: build 0x04030201 = 67305985
CELLSET 1 0
PUSH 1
SSETBYTETOCN 1 0
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
SSETBYTETOCN 2 1
ASSERT LAST_N == 513
ASSERT CELL(1) == 513
POP
PUSH 1
SSETBYTETOCN 3 2
ASSERT CELL(1) == 197121
POP
PUSH 1
SSETBYTETOCN 4 3
ASSERT LAST_N == 67305985
ASSERT CELL(1) == 67305985
POP

# SBYTETOCN extract byte 1 of 0x04030201 → 2
CELLSET 2 67305985
PUSH 2
SBYTETOCN 1
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# BYTETOCN alias: byte 0 of 0x1234=4660 → 0x34=52
CELLSET 3 4660
PUSH 3
BYTETOCN 0
ASSERT LAST_N == 52
ASSERT CELL(3) == 52
POP

# SCLRBYTETOCN clear byte 0 of 0x01020304=16909060 → 0x01020300=16909056
CELLSET 4 16909060
PUSH 4
SCLRBYTETOCN 0
ASSERT LAST_N == 16909056
ASSERT CELL(4) == 16909056
POP

# CLRBYTETOCN clear byte 2 then extract must be 0
CELLSET 5 2864434397
PUSH 5
CLRBYTETOCN 2
POP
PUSH 5
SBYTETOCN 2
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft empty OK=0
CLEARSTACK
SBYTETOCN 0
ASSERT OK == 0

PRINT "378_sbytetocn_sclrbytetocn OK"
