# ILOG2N / BITWIDTHN — floor log2 + bit length usability
# Twin of stack SILOG2. Usability: shift = ILOG2N pagesz; width = BITWIDTHN n.

HOLD_FLASH 1

ILOG2N 1
ASSERT LAST_N == 0
ASSERT ILOG2N_OK == 1
ASSERT ILOG2N_X == 1

ILOG2N 8
ASSERT LAST_N == 3
ASSERT ILOG2N == 3

ILOG2N 16
ASSERT LAST_N == 4

BITWIDTHN 1
ASSERT LAST_N == 1
ASSERT BITWIDTHN_OK == 1

BITWIDTHN 8
ASSERT LAST_N == 4

BITWIDTHN 16
ASSERT LAST_N == 5

ILOG2N 9
ASSERT LAST_N == 3
ASSERT ILOG2N_OK == 1

ILOG2N 15
ASSERT LAST_N == 3

ILOG2N 100
ASSERT LAST_N == 6

BITWIDTHN 9
ASSERT LAST_N == 4

BITWIDTHN 15
ASSERT LAST_N == 4

BITWIDTHN 100
ASSERT LAST_N == 7

ILOG2N 0
ASSERT LAST_N == 0
ASSERT ILOG2N_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

ILOG2N -5
ASSERT LAST_N == 0
ASSERT ILOG2N_OK == 0

BITWIDTHN 0
ASSERT LAST_N == 0
ASSERT BITWIDTHN_OK == 1

BITWIDTHN -3
ASSERT LAST_N == 0
ASSERT BITWIDTHN_OK == 0

FLOORLOG2N 32
ASSERT LAST_N == 5
LOG2N 7
ASSERT LAST_N == 2
NBITSN 7
ASSERT LAST_N == 3
BITLENN 255
ASSERT LAST_N == 8
WIDTHN 256
ASSERT LAST_N == 9

LET n 100
NEXTPOW2N n
ASSERT LAST_N == 128
ILOG2N LAST_N
ASSERT LAST_N == 7
BITWIDTHN 128
ASSERT LAST_N == 8

SYS ENV SET CUBALC_ARG0 "--pagesz=100"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN pagesz OR 64
ASSERT LAST_N == 100
NEXTPOW2N LAST_N
ASSERT LAST_N == 128
ILOG2N LAST_N
ASSERT LAST_N == 7

PRINT "ilog2n_bitwidthn ok"
