# Proof 541 — digit-9 stack imm 16-bit signed ordered-cmp: SLTS16N SGTS16N SLTES16N SGTES16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SLTS16N: int16(-1=0xFFFF) < 1 → 1
PUSH 0xFFFF
SLTS16N 0x1 0
POP x
ASSERT x == 1

# unsigned SLT: 0xFFFF < 0x1 → 0
CLEARSTACK
PUSH 0xFFFF
SLT16N 0x1 0
POP x
ASSERT x == 0

# equal → 0 for LT
CLEARSTACK
PUSH 0x8000
LTS16N 0x8000 0
POP x
ASSERT x == 0

# positive less: 2 < 3 → 1
CLEARSTACK
PUSH 0x2
SLTS16N 0x3 0
POP x
ASSERT x == 1

# 1 < -1 → 0
CLEARSTACK
PUSH 0x1
SLTS16N 0xFFFF 0
POP x
ASSERT x == 0

# preserved high half
CLEARSTACK
PUSH 0xAABBFFFF
SLTS16N 0x1 0
POP x
ASSERT x == 0xAABB0001

# STACKLTS16N n1: half1 0xFFFF < 0 → 1
CLEARSTACK
PUSH 0xFFFF0000
STACKLTS16N 0x0 1
POP x
ASSERT x == 0x00010000

# SGTS16N: 1 > -1 → 1
CLEARSTACK
PUSH 0x1
SGTS16N 0xFFFF 0
POP x
ASSERT x == 1

# 0xFFFF > 0x1 signed → 0
CLEARSTACK
PUSH 0xFFFF
GTS16N 0x1 0
POP x
ASSERT x == 0

# equal → 0
CLEARSTACK
PUSH 0x5555
SGTS16N 0x5555 0
POP x
ASSERT x == 0

# 0x8000 (-32768) > 0x7FFF (32767) → 0
CLEARSTACK
PUSH 0x8000
SGTS16N 0x7FFF 0
POP x
ASSERT x == 0

# preserved gt
CLEARSTACK
PUSH 0xAB0001
SGTS16N 0xFFFF 0
POP x
ASSERT x == 0xAB0001

# SLTES16N equal → 1
CLEARSTACK
PUSH 0x8000
SLTES16N 0x8000 0
POP x
ASSERT x == 1

# -1 <= 0 → 1
CLEARSTACK
PUSH 0xFFFF
LTES16N 0x0 0
POP x
ASSERT x == 1

# 1 <= -1 → 0
CLEARSTACK
PUSH 0x1
SLTES16N 0xFFFF 0
POP x
ASSERT x == 0

# SLEQS16N alias
CLEARSTACK
PUSH 0x2
SLEQS16N 0x3 0
POP x
ASSERT x == 1

# SGTES16N equal → 1
CLEARSTACK
PUSH 0x5555
SGTES16N 0x5555 0
POP x
ASSERT x == 1

# 1 >= -1 → 1
CLEARSTACK
PUSH 0x1
GTES16N 0xFFFF 0
POP x
ASSERT x == 1

# -32768 >= 32767 → 0
CLEARSTACK
PUSH 0x8000
SGTES16N 0x7FFF 0
POP x
ASSERT x == 0

# SGEQS16N: -1 >= -2 (0xFFFE) → 1
CLEARSTACK
PUSH 0xFFFF
SGEQS16N 0xFFFE 0
POP x
ASSERT x == 1

# SCMPLTS16N / SCMPGES16N
CLEARSTACK
PUSH 0xFFFE
SCMPLTS16N 0xFFFF 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0xFFFF
SCMPGES16N 0xFFFE 0
POP x
ASSERT x == 1

# n2 signed
CLEARSTACK
PUSH 0xFFFF00000000
SLTS16N 0x0 2
POP x
ASSERT x == 0x000100000000

HOLD_FLASH 0
