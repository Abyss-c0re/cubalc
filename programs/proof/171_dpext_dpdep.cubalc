# Proof 171 — digit-3 dual-stack parallel extract/deposit: DPEXT DPDEP
HOLD_FLASH 1
SCIENCE LOAD

# DPEXT — gather bits under mask into low positions
# 0b1010 with mask 0b0101 → 0b00 (bits 0,2 of src are 0,0? wait)
# src=0b1110 (14), mask=0b0101 (5) → bit0=0, bit2=1 → 0b10 = 2
CLEARSTACK
PUSH 14
PUSH 15
PUSH 5
PUSH 5
DPEXT
POP y
POP x
ASSERT x == 2
ASSERT y == 3

# src=0xFF mask=0x0F → 0xF; src=0xAA mask=0xAA → all set bits packed → 0x0F
CLEARSTACK
PUSH 255
PUSH 170
PUSH 15
PUSH 170
2PEXT
POP y
POP x
ASSERT x == 15
ASSERT y == 15

# DPDEP — scatter low bits into mask positions
# src=0b11 (3), mask=0b0101 → put bits into pos 0 and 2 → 0b0101 = 5
CLEARSTACK
PUSH 3
PUSH 1
PUSH 5
PUSH 5
DPDEP
POP y
POP x
ASSERT x == 5
ASSERT y == 1

# round-trip: deposit then extract recovers low bits
CLEARSTACK
PUSH 0xAB
PUSH 0x0C
PUSH 0x0F0F
PUSH 0x00FF
DPDEP
POP y
POP x
CLEARSTACK
PUSH x
PUSH y
PUSH 0x0F0F
PUSH 0x00FF
DPEXT
POP ey
POP ex
ASSERT ex == 0xAB
ASSERT ey == 0x0C

# aliases
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0xFF
PUSH 0xFF
PAIRPEXT
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0x0F

# soft fails
CLEARSTACK
DPEXT
ASSERT OK == 0
CLEARSTACK
DPDEP
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2PEXT
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof171_dpext_dpdep" LAST_N SP
