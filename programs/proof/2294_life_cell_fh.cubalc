REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_FH — fumarate hydratase FH after SDHA on BA continuum
# Continuum ...->pcca->mcee->mut->suclg1->sdha->fh (fumarate hydrated to L-malate for TCA)
# Gift: FH opens TCA progression gate under ASSERT after Complex II fumarate.
# Domain: post-SDHA fumarate hydratase (FH) malate TCA-progression gate.
# Cube is SoT. Free energy must flow. Not a dual ladder.

ENTITY mito OF Cell 1 44 0
ENTITY peri OF Cell 1 28 0
ENTITY ash OF Cell 0 18 0
ENTITY starve OF Cell 1 0 0
ENTITY nest OF Cell 1 52 0

SEND mito set_threshold 10
SEND peri set_threshold 12
SEND nest set_threshold 8
SEND starve set_threshold 10

SEND mito pulse 5
SEND mito photosynth 42
SEND mito glycolyse 34
SEND mito pump 26
SEND mito photophos 24
SEND mito charge 38
SEND mito feed 36
GETF mito age
ASSERT LAST_N == 5 "mito age5"
GETF mito atp
ASSERT LAST_N >= 18 "mito atp"
GETF mito energy
ASSERT LAST_N >= 18 "mito energy"
GETF mito pmf
ASSERT LAST_N >= 4 "mito pmf"

SEND mito amacr 2
ASSERT LAST_N == 2 "mito amacr"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito acox2 2
ASSERT LAST_N == 2 "mito acox2"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito hsd17b4 2
ASSERT LAST_N == 2 "mito hsd17b4"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito scp2 2
ASSERT LAST_N == 2 "mito scp2"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito acot8 2
ASSERT LAST_N == 2 "mito acot8"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito pcca 2
ASSERT LAST_N == 2 "mito pcca carboxylase"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito mcee 2
ASSERT LAST_N == 2 "mito mcee epimerase"
SEND mito photosynth 14
SEND mito charge 14
SEND mito feed 12
SEND mito mut 2
ASSERT LAST_N == 2 "mito mut mutase to succinyl-CoA"
SEND mito photosynth 12
SEND mito charge 12
SEND mito feed 10
SEND mito suclg1 2
ASSERT LAST_N == 2 "mito suclg1 ligase to succinate"
SEND mito photosynth 12
SEND mito charge 12
SEND mito feed 10
SEND mito sdha 2
ASSERT LAST_N == 2 "mito sdha Complex-II to fumarate"
SEND mito photosynth 16
SEND mito charge 16
SEND mito feed 14

GETF mito heat
LET f_h = LAST_N
GETF mito energy
LET f_e = LAST_N
GETF mito atp
LET f_a = LAST_N
GETF mito age
LET f_age = LAST_N
GETF mito pcr
LET f_pcr = LAST_N
GETF mito reserve
LET f_rsv = LAST_N
GETF mito pmf
LET f_pmf = LAST_N
GETF mito threshold
LET f_thr = LAST_N
SEND mito fh 3
ASSERT LAST_N == 3 "mito FH fumarase 3"
GETF mito heat
ASSERT LAST_N == f_h + 3 "mito fh heat+3"
GETF mito energy
ASSERT LAST_N == f_e - 3 "mito fh energy-3"
GETF mito atp
ASSERT LAST_N == f_a - 3 "mito fh atp-3"
GETF mito age
ASSERT LAST_N == f_age "mito fh age held"
GETF mito pcr
ASSERT LAST_N == f_pcr "mito fh pcr held"
GETF mito reserve
ASSERT LAST_N == f_rsv "mito fh reserve held"
GETF mito pmf
ASSERT LAST_N == f_pmf "mito fh pmf held"
GETF mito threshold
ASSERT LAST_N == f_thr "mito fh thr held"
GETF mito alive
ASSERT LAST_N == 1 "mito alive post-fh"

SEND mito fh 0
ASSERT LAST_N == 0 "mito fh n0"

SEND mito photosynth 20
SEND mito charge 18
SEND mito feed 16
GETF mito heat
LET f2_h = LAST_N
GETF mito energy
LET f2_e = LAST_N
GETF mito atp
LET f2_a = LAST_N
SEND mito fh 4
ASSERT LAST_N == 4 "mito fh 4"
GETF mito heat
ASSERT LAST_N == f2_h + 4 "mito fh heat+4"
GETF mito energy
ASSERT LAST_N == f2_e - 4 "mito fh energy-4"
GETF mito atp
ASSERT LAST_N == f2_a - 4 "mito fh atp-4"
GETF mito alive
ASSERT LAST_N == 1 "mito alive post-fh-4"

SEND mito photosynth 10
SEND mito charge 10
SEND mito feed 8
GETF mito atp
LET fc_a = LAST_N
GETF mito energy
LET fc_e = LAST_N
GETF mito heat
LET fc_h = LAST_N
GETF mito age
LET fc_age = LAST_N
SEND mito fh 100
GETF mito atp
LET fc_a2 = LAST_N
GETF mito energy
LET fc_e2 = LAST_N
GETF mito heat
LET fc_h2 = LAST_N
ASSERT fc_a2 >= 0 "mito fh clamp atp>=0"
ASSERT fc_e2 >= 0 "mito fh clamp energy>=0"
ASSERT fc_h2 >= fc_h "mito fh clamp heat+="
ASSERT fc_a2 <= fc_a "mito fh clamp atp down"
ASSERT fc_e2 <= fc_e "mito fh clamp energy down"
GETF mito age
ASSERT LAST_N == fc_age "mito fh clamp age held"
GETF mito alive
ASSERT LAST_N == 1 "mito alive post-fh clamp"

SEND ash fh 5
ASSERT LAST_N == 0 "ash fh refused"
GETF ash alive
ASSERT LAST_N == 0 "ash stays dead"

SEND starve fh 3
ASSERT LAST_N == 0 "starve fh refused no fuel"
GETF starve alive
ASSERT LAST_N == 1 "starve stays alive"

SEND peri photosynth 16
SEND peri charge 16
SEND peri feed 10
SEND peri suclg1 1
ASSERT LAST_N == 1 "peri suclg1 open"
SEND peri photosynth 10
SEND peri charge 10
SEND peri feed 8
GETF peri heat
LET q_h = LAST_N
GETF peri energy
LET q_e = LAST_N
GETF peri atp
LET q_a = LAST_N
GETF peri age
LET q_age = LAST_N
GETF peri pcr
LET q_pcr = LAST_N
GETF peri reserve
LET q_rsv = LAST_N
GETF peri pmf
LET q_pmf = LAST_N
GETF peri threshold
LET q_thr = LAST_N
SEND peri fh 2
ASSERT LAST_N == 2 "peri fh 2"
GETF peri heat
ASSERT LAST_N == q_h + 2 "peri fh h+2"
GETF peri energy
ASSERT LAST_N == q_e - 2 "peri fh e-2"
GETF peri atp
ASSERT LAST_N == q_a - 2 "peri fh a-2"
GETF peri age
ASSERT LAST_N == q_age "peri fh age held"
GETF peri pcr
ASSERT LAST_N == q_pcr "peri fh pcr held"
GETF peri reserve
ASSERT LAST_N == q_rsv "peri fh reserve held"
GETF peri pmf
ASSERT LAST_N == q_pmf "peri fh pmf held"
GETF peri threshold
ASSERT LAST_N == q_thr "peri fh thr held"
GETF peri alive
ASSERT LAST_N == 1 "peri alive post-fh"

SEND nest photosynth 16
SEND nest charge 16
SEND nest feed 12
SEND nest suclg1 1
ASSERT LAST_N == 1 "nest suclg1 open"
SEND nest photosynth 10
SEND nest charge 10
SEND nest feed 8
GETF nest heat
LET b_h = LAST_N
GETF nest energy
LET b_e = LAST_N
GETF nest atp
LET b_a = LAST_N
GETF nest age
LET b_age = LAST_N
GETF nest pcr
LET b_pcr = LAST_N
GETF nest reserve
LET b_rsv = LAST_N
GETF nest pmf
LET b_pmf = LAST_N
GETF nest threshold
LET b_thr = LAST_N
SEND nest fh 2
ASSERT LAST_N == 2 "nest fh 2"
GETF nest heat
ASSERT LAST_N == b_h + 2 "nest fh h+2"
GETF nest energy
ASSERT LAST_N == b_e - 2 "nest fh e-2"
GETF nest atp
ASSERT LAST_N == b_a - 2 "nest fh a-2"
GETF nest age
ASSERT LAST_N == b_age "nest fh age held"
GETF nest pcr
ASSERT LAST_N == b_pcr "nest fh pcr held"
GETF nest reserve
ASSERT LAST_N == b_rsv "nest fh reserve held"
GETF nest pmf
ASSERT LAST_N == b_pmf "nest fh pmf held"
GETF nest threshold
ASSERT LAST_N == b_thr "nest fh thr held"
GETF nest alive
ASSERT LAST_N == 1 "nest alive post-fh"

SEND mito photosynth 6
SEND mito charge 6
SEND mito feed 4
GETF mito atp
LET p_a = LAST_N
GETF mito energy
LET p_e = LAST_N
SEND mito fh 1
ASSERT LAST_N == 1 "mito fh partial prep"
GETF mito atp
LET p_a2 = LAST_N
GETF mito energy
LET p_e2 = LAST_N
ASSERT p_a2 == p_a - 1 "mito fh prep atp-1"
ASSERT p_e2 == p_e - 1 "mito fh prep energy-1"

GETF mito alive
ASSERT LAST_N == 1 "mito sealed alive for TCA"
GETF peri alive
ASSERT LAST_N == 1 "peri sealed alive for TCA"
ASSERT 1 == 1 "LIFE_CELL_FH fumarase PASS"
