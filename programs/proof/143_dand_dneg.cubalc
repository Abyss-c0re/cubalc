# Proof 143 — digit-7 dual-stack bitwise/unary: DAND DOR DXOR DNEG DABS
HOLD_FLASH 1
SCIENCE LOAD

# DAND — a b c d → (a&c) (b&d)
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0xFF
PUSH 0x33
DAND
POP y
POP x
ASSERT x == 240
ASSERT y == 3

# DOR
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0x0F
PUSH 0xF0
DOR
POP y
POP x
ASSERT x == 255
ASSERT y == 255

# DXOR
CLEARSTACK
PUSH 0xFF
PUSH 0xAA
PUSH 0x0F
PUSH 0x55
DXOR
POP y
POP x
ASSERT x == 240
ASSERT y == 255

# 2AND / PAIRXOR aliases
CLEARSTACK
PUSH 12
PUSH 10
PUSH 5
PUSH 6
2AND
POP y
POP x
ASSERT x == 4
ASSERT y == 2

CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
PUSH 3
PAIRXOR
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DNEG
CLEARSTACK
PUSH 3
PUSH -7
DNEG
POP y
POP x
ASSERT x == -3
ASSERT y == 7

# DABS
CLEARSTACK
PUSH -5
PUSH 9
DABS
POP y
POP x
ASSERT x == 5
ASSERT y == 9

CLEARSTACK
PUSH -1
PUSH -2
2ABS
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# soft fails
CLEARSTACK
DAND
ASSERT OK == 0
DOR
ASSERT OK == 0
DXOR
ASSERT OK == 0
DNEG
ASSERT OK == 0
DABS
ASSERT OK == 0
PUSH 1
DAND
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof143_dand_dneg" LAST_N SP
