# Proof 521 — digit-8 dual-stack imm 32-bit field arith: DADD32N DSUB32N DMUL32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DADD32N: word0 of pair + 0x02000000
PUSH 0x10000000
PUSH 0x03000000
DADD32N 0x2000000 0
POP y
POP x
ASSERT x == 0x12000000
ASSERT y == 0x05000000

# wrap add: 0xFFFFFFFF + 2 → 1 both
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFF
PAIRADD32N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# high word preserved: low + 0x55
CLEARSTACK
PUSH 0x1122334400001000
PUSH 0x99AABBCC00002000
DADD32N 0x55 0
POP y
POP x
ASSERT x == 0x1122334400001055
ASSERT y == 0x99AABBCC00002055

# S2ADD32N n1: high of each + 0x30
CLEARSTACK
PUSH 0x0000000200000000
PUSH 0x0000000400000000
S2ADD32N 0x30 1
POP y
POP x
ASSERT x == 0x0000003200000000
ASSERT y == 0x0000003400000000

# DINC32N alias
CLEARSTACK
PUSH 0xFFFFFFFE
PUSH 0x00000001
DINC32N 1 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 2

# DSUB32N
CLEARSTACK
PUSH 0x05000000
PUSH 0x04000000
DSUB32N 0x1000000 0
POP y
POP x
ASSERT x == 0x04000000
ASSERT y == 0x03000000

# wrap borrow
CLEARSTACK
PUSH 0x00000001
PUSH 0x00000000
PAIRSUB32N 2 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 4294967294

# STACK2SUB32N n1
CLEARSTACK
PUSH 0x5000000000000000
PUSH 0x3000000000000000
STACK2SUB32N 0x10000000 1
POP y
POP x
ASSERT x == 0x4000000000000000
ASSERT y == 0x2000000000000000

# DDEC32N alias
CLEARSTACK
PUSH 0x0
PUSH 0x5
DDEC32N 1 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 4

# DMUL32N
CLEARSTACK
PUSH 0x10
PUSH 0x20
DMUL32N 0x10 0
POP y
POP x
ASSERT x == 0x100
ASSERT y == 0x200

# wrap mul: 0x10000 * 0x10000 → 0
CLEARSTACK
PUSH 0x10000
PUSH 0x10000
PAIRMUL32N 0x10000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# zero annihilator
CLEARSTACK
PUSH 0xABCD1234
PUSH 0x11111111
DMUL32N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved mul
CLEARSTACK
PUSH 0x1122334400000003
PUSH 0x99AABBCC00000004
DMUL32N 5 0
POP y
POP x
ASSERT x == 0x112233440000000F
ASSERT y == 0x99AABBCC00000014

# DTIMES32N alias
CLEARSTACK
PUSH 0x7
PUSH 0x3
DTIMES32N 3 0
POP y
POP x
ASSERT x == 0x15
ASSERT y == 0x9

HOLD_FLASH 0
