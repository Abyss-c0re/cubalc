# Proof 327 — digit-7 stack↔cell unary scale: SDBLTOC SHALFTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SDBLTOC: 21 * 2 = 42
CELLSET 1 21
PUSH 1
SDBLTOC
ASSERT LAST_N == 42
ASSERT CELL(1) == 42
POP a
ASSERT a == 42

# SCELLDBL alias
CELLSET 2 7
PUSH 2
SCELLDBL
ASSERT LAST_N == 14
ASSERT CELL(2) == 14
POP

# DBLTOC alias
CELLSET 3 0
PUSH 3
DBLTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SHALFTOC: 42 / 2 = 21
CELLSET 4 42
PUSH 4
SHALFTOC
ASSERT LAST_N == 21
ASSERT CELL(4) == 21
POP

# SCELLHALF toward zero: -9 / 2 = -4
PUSH 5
PUSH 9
NEGATE
SSETCELL
POP
ASSERT CELL(5) == -9
PUSH 5
SCELLHALF
ASSERT LAST_N == -4
ASSERT CELL(5) == -4
POP

# HALFTOC alias: 1 / 2 = 0
CELLSET 6 1
PUSH 6
HALFTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# round-trip-ish: half then dbl of even
CELLSET 7 100
PUSH 7
SHALFTOC
POP
PUSH 7
SDBLTOC
ASSERT LAST_N == 100
ASSERT CELL(7) == 100
POP

# soft fails
CLEARSTACK
SDBLTOC
ASSERT OK == 0
SHALFTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof327_sdbltoc_shalftoc" LAST_N SP
HOLD_FLASH 1
