# GETFLAG / GETFLAGMS / BOOLFLAG OR ENV — complete flag family env fallbacks

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"

# --- GETFLAG string ---
SYS ENV UNSET OUT
GETFLAG out|o OR ENV OUT OR "-"
SYS EQS LAST "-"
ASSERT LAST_N == 1
SYS EQS GETFLAG_SRC "default"
ASSERT LAST_N == 1

SYS ENV SET OUT "/tmp/plate.json"
GETFLAG out|o OR ENV OUT OR "-"
SYS EQS LAST "/tmp/plate.json"
ASSERT LAST_N == 1
SYS EQS GETFLAG_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "OUT"
ASSERT LAST_N == 1

SYS ENV SET CUBALC_ARG0 "--out=cli.json"
SYS ENV SET CUBALC_ARGC "1"
GETFLAG out|o OR ENV OUT OR "-"
SYS EQS LAST "cli.json"
ASSERT LAST_N == 1
SYS EQS GETFLAG_SRC "cli"
ASSERT LAST_N == 1

# --- GETFLAGMS duration ---
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET TIMEOUT
GETFLAGMS timeout|t OR ENV TIMEOUT OR "30s"
ASSERT LAST_N == 30000
SYS EQS GETFLAGMS_SRC "default"
ASSERT LAST_N == 1

SYS ENV SET TIMEOUT "5s"
GETFLAGMS timeout|t OR ENV TIMEOUT OR "30s"
ASSERT LAST_N == 5000
SYS EQS GETFLAGMS_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "TIMEOUT"
ASSERT LAST_N == 1

SYS ENV SET CUBALC_ARG0 "--timeout=2s"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS timeout|t OR ENV TIMEOUT OR "30s"
ASSERT LAST_N == 2000
SYS EQS GETFLAGMS_SRC "cli"
ASSERT LAST_N == 1

# --- BOOLFLAG ---
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET FORCE
BOOLFLAG force|f OR ENV FORCE OR 0
ASSERT LAST_N == 0
SYS EQS BOOLFLAG_SRC "default"
ASSERT LAST_N == 1

SYS ENV SET FORCE "yes"
BOOLFLAG force|f OR ENV FORCE OR 0
ASSERT LAST_N == 1
SYS EQS BOOLFLAG_SRC "env"
ASSERT LAST_N == 1

SYS ENV SET FORCE "yes"
SYS ENV SET CUBALC_ARG0 "--force=false"
SYS ENV SET CUBALC_ARGC "1"
BOOLFLAG force|f OR ENV FORCE OR 0
ASSERT LAST_N == 0
ASSERT BOOLFLAG_HIT == 1
SYS EQS BOOLFLAG_SRC "cli"
ASSERT LAST_N == 1

# GETFLAGN still works (reg of prior item)
SYS ENV SET CUBALC_ARGC "0"
SYS ENV SET WORKERS "9"
GETFLAGN workers OR ENV WORKERS OR 4
ASSERT LAST_N == 9
SYS EQS GETFLAGN_SRC "env"
ASSERT LAST_N == 1

PRINT "flag_or_env ok"
