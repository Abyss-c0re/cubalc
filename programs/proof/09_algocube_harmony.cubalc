# Proof 09 — algocube compare + harmony (CS free-flow law)
HOLD_FLASH 1
GENESIS "NEXUS_COORD v1 | from=proof | type=algocube_harmony | hold_flash=1 |"

CUBE a ROLE peer PROTON 1
CUBE b ROLE peer PROTON 1
CUBE hive ROLE nanobot_hive PROTON 1

FOLDBITS a "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS b "1111000011110000111100001111000011110000111100001111000011110000"

PLUG a b
FLOW 2

COMPARE a b
ASSERT HAMMING == 0
ASSERT AGREE == 64
ASSERT UNITY >= 99
ASSERT DIGIT >= 0
ASSERT DIGIT <= 9

SETBIT b 0 0
COMPARE a b
ASSERT HAMMING >= 1
ASSERT UNITY < 100
ASSERT AGREE < 64

HARMONY hive
ASSERT HARMONY >= 0
ASSERT DIGIT(hive) >= 0
ASSERT DIGIT(hive) <= 9
ASSERT HIVE_N >= 1

DECIDE a
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

PRINT "proof09" UNITY HAMMING HARMONY DECIDE AGREE
