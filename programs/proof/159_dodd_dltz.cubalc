# Proof 159 — digit-1 dual-stack predicates: DODD DEVEN DLTZ DGTZ DLEZ DGEZ
HOLD_FLASH 1
SCIENCE LOAD

# DODD / DEVEN
CLEARSTACK
PUSH 3
PUSH 4
DODD
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0
PUSH -1
2EVEN
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 7
PAIRODD
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DLTZ / DGTZ
CLEARSTACK
PUSH -5
PUSH 0
DLTZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH -1
2GTZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DLEZ / DGEZ
CLEARSTACK
PUSH 0
PUSH 3
DLEZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -2
PUSH 0
2GEZ
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 5
PUSH -3
PAIRGEZ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fails
CLEARSTACK
DODD
ASSERT OK == 0
CLEARSTACK
DEVEN
ASSERT OK == 0
CLEARSTACK
DLTZ
ASSERT OK == 0
CLEARSTACK
DGTZ
ASSERT OK == 0
CLEARSTACK
PUSH 1
2LEZ
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof159_dodd_dltz" LAST_N SP
