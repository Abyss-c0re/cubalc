SEND gate pepn 4
ASSERT LAST_N == 4 "gate pepn4"
GETF gate heat
ASSERT LAST_N == h0 + 4 "gate pepn h+4"
GETF gate energy
ASSERT LAST_N == e0 - 4 "gate pepn e-4"
GETF gate atp
ASSERT LAST_N == a0 - 4 "gate pepn atp-4"
GETF gate pcr
ASSERT LAST_N == c0 "gate pepn pcr held"
GETF gate reserve
ASSERT LAST_N == r0 "gate pepn r held"
GETF gate age
ASSERT LAST_N == age0 "gate pepn age held"
GETF gate pmf
ASSERT LAST_N == pmf0 "gate pepn pmf held"

