ASSERT LAST_N == gateeq - 2 "pepe gate e"
GETF gate atp
ASSERT LAST_N == gateaq - 2 "pepe gate a"

GETF gate energy
LET e_fin = LAST_N
GETF gate threshold
LET thr_fin = LAST_N
GETF gate ready
LET rd_fin = LAST_N
IF e_fin >= thr_fin THEN
  ASSERT rd_fin == 1 "ready when e>=thr"
END
IF e_fin < thr_fin THEN
  ASSERT rd_fin == 0 "unready when e<thr"
END

