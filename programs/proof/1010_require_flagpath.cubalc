# REQUIRE FLAGPATH / FLAGFILE / FLAGDIR — fail-fast path flag gate
# Twin of soft GETFLAGPATH: peel + ABSPATH + host exist/kind without glue.

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CONFIG
SYS ENV UNSET OUTDIR

# default relative plate that exists → abs path
REQUIRE FLAGPATH conf|c OR ENV CONFIG OR "state/MEANINGFUL_ITER.json"
ASSERT OK == 1
SYS EQS GETFLAGPATH_SRC "default"
ASSERT LAST_N == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "MEANINGFUL_ITER.json"
ASSERT LAST_N == 1
SYS EQS REQUIRE_FLAGPATH LAST
ASSERT LAST_N == 1
ASSERT GETFLAGPATH_HIT == 0
ASSERT GETFLAGPATH_EXIST == 1

# ENV wins over default
SYS ENV SET CONFIG "include/cubalc_law.h"
REQUIRE FLAGPATH conf OR ENV CONFIG OR "missing.xyz"
SYS EQS GETFLAGPATH_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "CONFIG"
ASSERT LAST_N == 1
SYS ENDS LAST "cubalc_law.h"
ASSERT LAST_N == 1
ASSERT GETFLAGPATH_HIT == 0

# CLI beats ENV
SYS ENV SET CONFIG "include/cubalc_law.h"
SYS ENV SET CUBALC_ARG0 "--conf"
SYS ENV SET CUBALC_ARG1 "docs/MEANINGFUL_ITER.md"
SYS ENV SET CUBALC_ARGC "2"
REQUIRE FLAGPATH conf|c OR ENV CONFIG OR "x"
ASSERT GETFLAGPATH_HIT == 1
SYS EQS GETFLAGPATH_SRC "cli"
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "conf"
ASSERT LAST_N == 1
SYS ENDS LAST "MEANINGFUL_ITER.md"
ASSERT LAST_N == 1

# short -c
SYS ENV SET CUBALC_ARG0 "-c"
SYS ENV SET CUBALC_ARG1 "Makefile"
SYS ENV SET CUBALC_ARGC "2"
REQUIRE FLAGPATH conf|c OR "none"
SYS EQS FLAG_HIT_NAME "c"
ASSERT LAST_N == 1
SYS ENDS LAST "Makefile"
ASSERT LAST_N == 1

# FLAGFILE — must be regular file
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CONFIG
REQUIRE FLAGFILE conf OR "include/cubalc_law.h"
ASSERT ISFILE == 1
SYS ENDS LAST "cubalc_law.h"
ASSERT LAST_N == 1
SYS EQS REQUIRE_FLAGFILE LAST
ASSERT LAST_N == 1

# FLAGDIR — must be directory
REQUIRE FLAGDIR out OR "include"
ASSERT ISDIR == 1
SYS ENDS LAST "include"
ASSERT LAST_N == 1
SYS EQS REQUIRE_FLAGDIR LAST
ASSERT LAST_N == 1

# CLI file flag for FLAGFILE
SYS ENV SET CUBALC_ARG0 "--file=Makefile"
SYS ENV SET CUBALC_ARGC "1"
REQUIRE FLAGFILE file|f OR "x"
SYS EQS GETFLAGPATH_SRC "cli"
ASSERT LAST_N == 1
ASSERT ISFILE == 1
SYS ENDS LAST "Makefile"
ASSERT LAST_N == 1

# soft twin still peels missing without fatal
SYS ENV SET CUBALC_ARGC "0"
GETFLAGPATH conf OR "no/such/file_xyz_req.cubalc"
ASSERT GETFLAGPATH_EXIST == 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1

PRINT "require_flagpath ok"
