# Proof 148 — digit-6 dual-stack bound/select: DSIGN DCLAMP DSEL DMUX
HOLD_FLASH 1
SCIENCE LOAD

# DSIGN
CLEARSTACK
PUSH -5
PUSH 0
DSIGN
POP y
POP x
ASSERT x == -1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH -2
2SIGN
POP y
POP x
ASSERT x == 1
ASSERT y == -1

# DCLAMP shared bounds
CLEARSTACK
PUSH -10
PUSH 50
PUSH 0
PUSH 10
DCLAMP
POP y
POP x
ASSERT x == 0
ASSERT y == 10

# inverted lo/hi
CLEARSTACK
PUSH 5
PUSH 15
PUSH 20
PUSH 0
2CLAMP
POP y
POP x
ASSERT x == 5
ASSERT y == 15

# DSEL shared cond
CLEARSTACK
PUSH 1
PUSH 2
PUSH 10
PUSH 20
PUSH 1
DSEL
POP y
POP x
ASSERT x == 10
ASSERT y == 20

CLEARSTACK
PUSH 1
PUSH 2
PUSH 10
PUSH 20
PUSH 0
DMUX
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# PAIRCLAMP alias
CLEARSTACK
PUSH 100
PUSH -100
PUSH -5
PUSH 5
PAIRCLAMP
POP y
POP x
ASSERT x == 5
ASSERT y == -5

# soft fails
CLEARSTACK
DSIGN
ASSERT OK == 0
CLEARSTACK
DCLAMP
ASSERT OK == 0
CLEARSTACK
DSEL
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSIGN
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2CLAMP
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2MUX
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof148_dclamp_dsel" LAST_N SP
