# Proof 246 — digit-0 stack high-n field reverse/rotate: SBREVHN SROLHN SRORHN
HOLD_FLASH 1
SCIENCE LOAD

# SBREVHN — reverse high n; low kept
CLEARSTACK
PUSH 0xB00000000000000F
SBREVHN 4
POP x
# high nibble 1011 → 1101; low 0xF kept
ASSERT x == 0xD00000000000000F

CLEARSTACK
PUSH 0xAB00000000000011
STACKBREVHN 8
POP x
# 0xAB → 0xD5
ASSERT x == 0xD500000000000011

# BREVHNS alias + n=0 noop
CLEARSTACK
PUSH 0x55
BREVHNS 0
POP x
ASSERT x == 0x55

# SROLHN — rotl1 within high n
CLEARSTACK
PUSH 0x9000000000000007
SROLHN 4
POP x
# 1001 → 0011; low 7 kept
ASSERT x == 0x3000000000000007

CLEARSTACK
PUSH 0x81000000000000F0
STACKROLHN 8
POP x
# 0x81 → 0x03
ASSERT x == 0x03000000000000F0

# SRORHN — rotr1 within high n
CLEARSTACK
PUSH 0x9000000000000007
SRORHN 4
POP x
# 1001 → 1100
ASSERT x == 0xC000000000000007

CLEARSTACK
PUSH 0x81000000000000F0
STACKRORHN 8
POP x
# 0x81 → 0xC0
ASSERT x == 0xC0000000000000F0

# round-trip
CLEARSTACK
PUSH 0xA5000000000000FF
SROLHN 8
RORHNS 8
POP x
ASSERT x == 0xA5000000000000FF

# soft fails
CLEARSTACK
SBREVHN 4
ASSERT OK == 0
CLEARSTACK
SROLHN 4
ASSERT OK == 0
CLEARSTACK
SRORHN 4
ASSERT OK == 0

HOLD_FLASH 1
