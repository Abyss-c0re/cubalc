# Proof 312 — digit-0 imm unsigned min/max: SUMINN SUMAXN DUMINN DUMAXN
HOLD_FLASH 1
SCIENCE LOAD

# SUMINN — normal
CLEARSTACK
PUSH 5
SUMINN 10
POP x
ASSERT x == 5

CLEARSTACK
PUSH 12
UMINN 7
POP x
ASSERT x == 7

# SUMINN — unsigned: -1 is max, min with 5 stays 5
CLEARSTACK
PUSH -1
SUMINN 5
POP x
ASSERT x == 5

# SUMAXN — unsigned: -1 wins over positive
CLEARSTACK
PUSH -1
SUMAXN 100
POP x
ASSERT x == -1

CLEARSTACK
PUSH 3
UMAXN 9
POP x
ASSERT x == 9

CLEARSTACK
PUSH 20
STACKUMAXN 4
POP x
ASSERT x == 20

# signed contrast: signed min(-1,5)=-1; unsigned min picks 5
CLEARSTACK
PUSH -1
SMINN 5
POP x
ASSERT x == -1
CLEARSTACK
PUSH -1
SUMINN 5
POP x
ASSERT x == 5

# soft empty
CLEARSTACK
SUMINN 1
ASSERT OK == 0
CLEARSTACK
SUMAXN 1
ASSERT OK == 0

# DUMINN
CLEARSTACK
PUSH 10
PUSH -1
DUMINN 5
POP y
POP x
ASSERT x == 5
ASSERT y == 5

CLEARSTACK
PUSH 2
PUSH 8
PAIRUMINN 5
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# DUMAXN
CLEARSTACK
PUSH 1
PUSH -1
DUMAXN 5
POP y
POP x
ASSERT x == 5
ASSERT y == -1

CLEARSTACK
PUSH 9
PUSH 3
2UMAXN 4
POP y
POP x
ASSERT x == 9
ASSERT y == 4

# dual soft
CLEARSTACK
DUMINN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DUMAXN 1
ASSERT OK == 0

HOLD_FLASH 1
