PUSH 20
SCLIP4
ASSERT LAST_N == 15
POP

# UCLIP4: negative → 0
PUSH 0
PUSH 5
SUB
UCLIP4
ASSERT LAST_N == 0
POP

# SCLIP4 mid: 7 stays
PUSH 7
SCLIP4
