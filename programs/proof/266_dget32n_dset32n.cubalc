# Proof 266 — digit-8 dual-stack imm 32-bit field: DGET32N DSET32N DCLR32N
HOLD_FLASH 1
SCIENCE LOAD

# DGET32N n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DGET32N 0
POP y
POP x
ASSERT x == 0x55667788
ASSERT y == 0xDDEEFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRGET32N 1
POP y
POP x
ASSERT x == 0x11223344
ASSERT y == 0x99AABBCC

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
PUSH 0x1234567890ABCDEF
DWORD32N 0
POP y
POP x
ASSERT x == 0xEEFF0011
ASSERT y == 0x90ABCDEF

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
PUSH 0x1234567890ABCDEF
S2GET32N 1
POP y
POP x
ASSERT x == 0xAABBCCDD
ASSERT y == 0x12345678

# clamp
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DGET32N 99
POP y
POP x
ASSERT x == 0x11223344
ASSERT y == 0x99AABBCC

# DSET32N field n
CLEARSTACK
PUSH 0
PUSH -1
DSET32N 0xAABBCCDD 0
POP y
POP x
ASSERT x == 0xAABBCCDD
# -1 with low32=AABBCCDD
ASSERT y == -1430532899

CLEARSTACK
PUSH 0
PUSH 0
PAIRSET32N 0x12345678 1
POP y
POP x
ASSERT x == 0x1234567800000000
ASSERT y == 0x1234567800000000

CLEARSTACK
PUSH -1
PUSH -1
DPUT32N 0 0
POP y
POP x
ASSERT x == -4294967296
ASSERT y == -4294967296

CLEARSTACK
PUSH -1
PUSH -1
DSETWORD32N 0 1
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 4294967295

# DCLR32N n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DCLR32N 0
POP y
POP x
ASSERT x == 0x1122334400000000
ASSERT y == 0x99AABBCC00000000

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRCLR32N 1
POP y
POP x
ASSERT x == 0x55667788
ASSERT y == 0xDDEEFF00

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
PUSH 0x1234567890ABCDEF
DZAP32N 0
POP y
POP x
ASSERT x == 0xAABBCCDD00000000
ASSERT y == 0x1234567800000000

CLEARSTACK
PUSH 0xAABBCCDDEEFF0011
PUSH 0x1234567890ABCDEF
DCLRWORD32N 1
POP y
POP x
ASSERT x == 0xEEFF0011
ASSERT y == 0x90ABCDEF

# soft fails
CLEARSTACK
DGET32N 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSET32N 2 0
ASSERT OK == 0
CLEARSTACK
DCLR32N 0
ASSERT OK == 0

HOLD_FLASH 1
