# Proof 478 — digit-0 dual-stack imm 16-bit field max+eq: DMAX16N DEQ16N DNE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DMAX16N: max both with field
PUSH 0x1000
PUSH 0xC000
DMAX16N 0x4000 0
POP y
POP x
ASSERT x == 0x4000
ASSERT y == 0xC000

# keeps larger both
CLEARSTACK
PUSH 0xF000
PUSH 0xE000
PAIRMAX16N 0x2000 0
POP y
POP x
ASSERT x == 0xF000
ASSERT y == 0xE000

# high preserved max
CLEARSTACK
PUSH 0x1122334400007711
PUSH 0x99AABBCC00002222
DMAX16N 0x8000 0
POP y
POP x
ASSERT x == 0x1122334400008000
ASSERT y == 0x99AABBCC00008000

# S2MAX16N n1
CLEARSTACK
PUSH 0x20000000
PUSH 0x10000000
S2MAX16N 0x9000 1
POP y
POP x
ASSERT x == 0x90000000
ASSERT y == 0x90000000

# DGE16N alias max equal
CLEARSTACK
PUSH 0x5555
PUSH 0x5555
DGE16N 0x5555 0
POP y
POP x
ASSERT x == 0x5555
ASSERT y == 0x5555

# DEQ16N: equal → 1
CLEARSTACK
PUSH 0xABCD
PUSH 0xABCD
DEQ16N 0xABCD 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# unequal → 0
CLEARSTACK
PUSH 0xABCD
PUSH 0xABCE
PAIREQ16N 0xABCD 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# high preserved eq
CLEARSTACK
PUSH 0x1122334400007742
PUSH 0x99AABBCC00007742
DEQ16N 0x7742 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000001

# STACK2EQ16N n1
CLEARSTACK
PUSH 0x77770000
PUSH 0x77780000
STACK2EQ16N 0x7777 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

# DNE16N: unequal → 1
CLEARSTACK
PUSH 0x1000
PUSH 0x1001
DNE16N 0x1000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# equal → 0 both
CLEARSTACK
PUSH 0x1000
PUSH 0x1000
PAIRNE16N 0x1000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved ne
CLEARSTACK
PUSH 0x11223344000077FF
PUSH 0x99AABBCC00000000
DNE16N 0 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000000

# S2NE16N n1
CLEARSTACK
PUSH 0x55550000
PUSH 0x55560000
S2NE16N 0x5555 1
POP y
POP x
ASSERT x == 0x00000000
ASSERT y == 0x00010000

# DCMPEQ16N / DCMPNE16N aliases
CLEARSTACK
PUSH 0xFFFF
PUSH 0x0000
DCMPEQ16N 0xFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0000
PUSH 0x0001
DCMPNE16N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

HOLD_FLASH 0
