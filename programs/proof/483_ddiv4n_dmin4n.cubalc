# Proof 483 — digit-4 dual-stack imm 4-bit field div/mod/min: DDIV4N DMOD4N DMIN4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DDIV4N: 12/3=4 ; 9/3=3
PUSH 0xC
PUSH 0x9
DDIV4N 3 0
POP y
POP x
ASSERT x == 4
ASSERT y == 3

# floor both
CLEARSTACK
PUSH 0xB
PUSH 0xA
PAIRDIV4N 3 0
POP y
POP x
ASSERT x == 3
ASSERT y == 3

# div0 → 0
CLEARSTACK
PUSH 0xF
PUSH 0x5
DDIV4N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved: nibble0 / 2
CLEARSTACK
PUSH 0x112233445566770C
PUSH 0x99AABBCCDDEEFF08
DDIV4N 2 0
POP y
POP x
ASSERT x == 0x1122334455667706
ASSERT y == 0x99AABBCCDDEEFF04

# S2DIV4N n1
CLEARSTACK
PUSH 0xC0
PUSH 0x90
S2DIV4N 3 1
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0x30

# DQUO4N alias
CLEARSTACK
PUSH 0xE
PUSH 0xA
DQUO4N 2 0
POP y
POP x
ASSERT x == 7
ASSERT y == 5

# DMOD4N
CLEARSTACK
PUSH 0xB
PUSH 0xA
DMOD4N 3 0
POP y
POP x
ASSERT x == 2
ASSERT y == 1

# exact both
CLEARSTACK
PUSH 0xC
PUSH 0x9
PAIRMOD4N 3 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mod0 → 0
CLEARSTACK
PUSH 0xA
PUSH 0xB
DREM4N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# STACK2MOD4N n1
CLEARSTACK
PUSH 0xB0
PUSH 0xA0
STACK2MOD4N 3 1
POP y
POP x
ASSERT x == 0x20
ASSERT y == 0x10

# DMIN4N
CLEARSTACK
PUSH 0xC
PUSH 0x2
DMIN4N 0x5 0
POP y
POP x
ASSERT x == 0x5
ASSERT y == 0x2

# keeps smaller
CLEARSTACK
PUSH 0x1
PUSH 0x3
PAIRMIN4N 0x9 0
POP y
POP x
ASSERT x == 0x1
ASSERT y == 0x3

# high preserved min
CLEARSTACK
PUSH 0x112233445566770E
PUSH 0x99AABBCCDDEEFF0A
DMIN4N 0x4 0
POP y
POP x
ASSERT x == 0x1122334455667704
ASSERT y == 0x99AABBCCDDEEFF04

# S2MIN4N n1
CLEARSTACK
PUSH 0xF0
PUSH 0x20
S2MIN4N 0x3 1
POP y
POP x
ASSERT x == 0x30
ASSERT y == 0x20

# DLE4N alias min equal
CLEARSTACK
PUSH 0x5
PUSH 0x5
DLE4N 0x5 0
POP y
POP x
ASSERT x == 0x5
ASSERT y == 0x5

HOLD_FLASH 0
