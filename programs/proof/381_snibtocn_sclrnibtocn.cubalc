# Proof 381 — digit-4 imm nibble field TOC: SNIBTOCN SSETNIBTOCN SCLRNIBTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSETNIBTOCN: build 0x21 = 33 (nibble0=1, nibble1=2)
CELLSET 1 0
PUSH 1
SSETNIBTOCN 1 0
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
SSETNIBTOCN 2 1
ASSERT LAST_N == 33
ASSERT CELL(1) == 33
POP

# SNIBTOCN extract nibble 1 → 2
CELLSET 2 33
PUSH 2
SNIBTOCN 1
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# NIBTOCN alias: nibble 0 of 0xAB = 171 → 0xB = 11
CELLSET 3 171
PUSH 3
NIBTOCN 0
ASSERT LAST_N == 11
ASSERT CELL(3) == 11
POP

# SCLRNIBTOCN clear nibble 0 of 0xF5=245 → 0xF0=240
CELLSET 4 245
PUSH 4
SCLRNIBTOCN 0
ASSERT LAST_N == 240
ASSERT CELL(4) == 240
POP

# CLRNIBTOCN clear nibble 1 then extract is 0
CELLSET 5 33
PUSH 5
CLRNIBTOCN 1
POP
PUSH 5
SNIBTOCN 1
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft empty OK=0
CLEARSTACK
SNIBTOCN 0
ASSERT OK == 0

PRINT "381_snibtocn_sclrnibtocn OK"
