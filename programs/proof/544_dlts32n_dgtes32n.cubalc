# Proof 544 — digit-7 dual-stack imm 32-bit signed ordered-cmp: DLTS32N DGTS32N DLTES32N DGTES32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLTS32N: -1 < 1 → 1 ; 1 < 1 → 0
PUSH 0xFFFFFFFF
PUSH 0x1
DLTS32N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# unsigned DLT: 0xFFFFFFFF < 0x1 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x1
DLT32N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# equal signed → 0 for LT
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
PAIRLTS32N 0x80000000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mixed: 2 < 3 → 1; 4 < 3 → 0
CLEARSTACK
PUSH 0x2
PUSH 0x4
DLTS32N 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 1 < -1 → 0 both
CLEARSTACK
PUSH 0x1
PUSH 0x2
S2LTS32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved high word
CLEARSTACK
PUSH 0x11223344FFFFFFFF
PUSH 0xAABBCCDD00000000
DLTS32N 0x1 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0xAABBCCDD00000001

# STACK2LTS32N n1
CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x0000000100000000
STACK2LTS32N 0x0 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# DGTS32N: 1 > -1 → 1 ; -1 > -1 → 0
CLEARSTACK
PUSH 0x1
PUSH 0xFFFFFFFF
DGTS32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 0xFFFFFFFF > 0x1 signed → 0 both
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFE
PAIRGTS32N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# INT_MIN > INT_MAX → 0
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
DGTS32N 0x7FFFFFFF 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DLTES32N equal → 1
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
DLTES32N 0x80000000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# -1 <= 0 → 1; 1 <= 0 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x1
DLEQS32N 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DGTES32N equal → 1
CLEARSTACK
PUSH 0x55555555
PUSH 0x55555555
DGTES32N 0x55555555 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 1 >= -1 → 1; INT_MIN >= INT_MAX → 0
CLEARSTACK
PUSH 0x1
PUSH 0x80000000
DGEQS32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DCMPLTS32N / DCMPGES32N
CLEARSTACK
PUSH 0xFFFFFFFE
PUSH 0x0
DCMPLTS32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFE
DCMPGES32N 0xFFFFFFFE 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

HOLD_FLASH 0
