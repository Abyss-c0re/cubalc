// 75_smx_right_lymph.cubalc
// MESH_RIGHT_LYMPH — SMX mesh stability life-force for right lymphatic duct board.
// Soft-OOB storms fail-closed (never ghost-place); MESH_EXCHANGE roots C(4,2) mind mesh;
// STABILIZE hardens; ENERGYFLOW + FLOW drive right lymph free-energy return
// (right jugular+subclavian+bronchomediastinal trunks → right lymphatic duct → right venous angle (IJV∩SCV) → systemic venous return);
// WE_AUTOHEAL; mitosis under locked rails; second storm re-stabilizes.
// Wonder AGI can RUN. No dual ladders. Cube is SoT · matrix is key · free energy must flow.
// Pure-C SMX engine; proof-only CubalC surface.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 64
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_right_lymph_life | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 16 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
// right lymph free-energy charge: trunk confluence → right lymphatic duct → right venous angle
ENERGYFLOW 5
FLOW 4

LET base_cubes = CUBES

SMX KEY

// --- Storm wounds: soft-OOB fail-closed, never ghost-place ---
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

// --- MESH_EXCHANGE roots complete right lymph mind mesh among live printer spine ---
SMX MESH_EXCHANGE bed nozzle hive scrap
ASSERT SMX_OK == 1 "mesh_exchange live"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange latch"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh from mesh_exchange"
ASSERT SMX_BONDS == 6 "C(4,2)=6 undirected bonds"
ASSERT SMX_OOB == 0 "oob cleared by mesh_exchange"
ASSERT SMX_LIVE == 4 "four live after mesh_exchange"
ASSERT CUBES == base_cubes "mesh_exchange invents nothing"

// --- STABILIZE hardens right lymph wall latch / right lymph seal ---
SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "stabilize live"
ASSERT SMX_STABLE == 1 "stable latch"
ASSERT SMX_STEADFAST == 4 "four steadfast"
ASSERT SMX_PULSE == 4 "four pulses"
ASSERT SMX_OOB == 0 "oob cleared by stabilize"
ASSERT CUBES == base_cubes "stabilize invents nothing"

// --- right lymph free-energy return pulse under locked rails ---
IMPULSE bed 2
IMPULSE nozzle 2
IMPULSE hive 1
ENERGYFLOW 4
FLOW 3
ASSERT ENERGY >= 0 "right lymph energy non-negative"
ASSERT CUBES == base_cubes "right-duct gate invents no cubes"

// live mesh talk after right lymph pulse (trunks → duct → right venous angle)
SMX EXCHANGE bed nozzle
ASSERT SMX_OK == 1 "live exchange after right-duct pulse"
ASSERT SMX_OOB == 0 "no oob on live talk"

SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "right-duct talk live"
ASSERT SMX_OOB == 0 "no oob duct"

SMX EXCHANGE hive scrap
ASSERT SMX_OK == 1 "right-angle talk live"
ASSERT SMX_OOB == 0 "no oob angle"

SMX EXCHANGE scrap bed
ASSERT SMX_OK == 1 "return talk live"
ASSERT SMX_OOB == 0 "no oob return"

// WE_AUTOHEAL under right lymph mesh
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "we_autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob clear after autoheal"
ASSERT CUBES == base_cubes "autoheal invents nothing"

// mitosis under locked rails
GETF seed alive
LET a0 = LAST_N
ASSERT a0 == 1 "seed alive under right lymph mesh"
GETF seed energy
LET e0 = LAST_N
IF e0 < 2 THEN
  LET e0 = 15
  SETF seed energy e0
END
LET half = e0 / 2
IF half < 1 THEN
  LET half = 1
END
GETF seed gen
LET dg = LAST_N + 1
SEND d1 birth half dg
SEND seed after_div
PLUG bed d1
GETF d1 alive
LET a1 = LAST_N
ASSERT a1 == 1 "first mitosis under right lymph mesh"

GETF seed energy
LET e1 = LAST_N
IF e1 < 2 THEN
  LET e1 = 15
  SETF seed energy e1
END
LET half2 = e1 / 2
IF half2 < 1 THEN
  LET half2 = 1
END
GETF seed gen
LET dg2 = LAST_N + 1
SEND d2 birth half2 dg2
SEND seed after_div
PLUG bed d2
GETF d2 alive
LET a2 = LAST_N
ASSERT a2 == 1 "second mitosis under right lymph mesh"
ASSERT ENERGY > 0 "energy remains after mitosis"
ASSERT a0 + a1 + a2 >= 3 "population grew under right lymph mesh"

// --- Second storm fail-closed + re-stabilize (no thrash) ---
SMX TALK bed ghost_again
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

SMX MESH_EXCHANGE bed nozzle hive scrap
ASSERT SMX_OK == 1 "mesh_exchange after storm2"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again by mesh_exchange"
ASSERT SMX_BONDS == 6 "bonds after storm2"
ASSERT CUBES >= base_cubes "no ghost after re-mesh"

SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "re-stabilize live"
ASSERT SMX_STABLE == 1 "stable sticky after storm2"
ASSERT SMX_STEADFAST == 4 "steadfast holds after storm2"
ASSERT SMX_OOB == 0 "oob still clear after re-stabilize"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange sticky through mitosis+storm"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky through mitosis+storm"
ASSERT SMX_AUTOHEALED == 1 "autohealed sticky through storm2"

// final right lymph energy breath through right lymph return
ENERGYFLOW 1
FLOW 1
ASSERT ENERGY > 0 "final energy flows"
ASSERT OK == 1

PRINT "smx_mesh_right_lymph_life" POPULATION SMX_OK SMX_MESH_EXCHANGE SMX_STABLE SMX_STABLE_MESH SMX_STEADFAST SMX_PULSE SMX_BONDS SMX_AUTOHEALED SMX_OOB CUBES UNITY ENERGY DECIDE
PASS
