# Proof 301 — digit-9 reverse unsigned imm: SUDIVFROMN SUMODFROMN DUDIVFROMN DUMODFROMN
HOLD_FLASH 1
SCIENCE LOAD

# SUDIVFROMN n — n /u TOS
CLEARSTACK
PUSH 4
SUDIVFROMN 20
POP x
ASSERT x == 5

CLEARSTACK
PUSH 2
UDIVFROMN -1
POP x
ASSERT x == 9223372036854775807

# SUDIVFROMN — /0 soft
CLEARSTACK
PUSH 0
SUDIVFROMIMM 10
POP x
ASSERT x == 0

# SUMODFROMN n — n %u TOS
CLEARSTACK
PUSH 5
SUMODFROMN 17
POP x
ASSERT x == 2

CLEARSTACK
PUSH 10
UMODFROMN -1
POP x
ASSERT x == 5

# SUMODFROMN — %0 soft
CLEARSTACK
PUSH 0
UREMFROMN 7
POP x
ASSERT x == 0

# DUDIVFROMN
CLEARSTACK
PUSH 4
PUSH 5
DUDIVFROMN 20
POP y
POP x
ASSERT x == 5
ASSERT y == 4

CLEARSTACK
PUSH 0
PUSH 2
PAIRUDIVFROMN 10
POP y
POP x
ASSERT x == 0
ASSERT y == 5

# DUMODFROMN
CLEARSTACK
PUSH 5
PUSH 7
DUMODFROMN 23
POP y
POP x
ASSERT x == 3
ASSERT y == 2

CLEARSTACK
PUSH 10
PUSH 0
PAIRUMODFROMN -1
POP y
POP x
ASSERT x == 5
ASSERT y == 0

# soft fails
CLEARSTACK
SUDIVFROMN 1
ASSERT OK == 0
CLEARSTACK
SUMODFROMN 1
ASSERT OK == 0
CLEARSTACK
DUDIVFROMN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DUMODFROMN 1
ASSERT OK == 0

HOLD_FLASH 1
