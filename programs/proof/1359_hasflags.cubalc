# HASFLAGS / HASFLAGC — soft flag-count probe (LISTFLAGS twin without bag clobber)

HOLD_FLASH 1

# empty — no flags
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
HASFLAGS
ASSERT LAST_N == 0
HASFLAGS 1
ASSERT LAST_N == 0
ASSERT LISTFLAGS_N == 0

# positionals only — not flags
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARG1 "b.txt"
SYS ENV SET CUBALC_ARGC "2"
HASFLAGS 1
ASSERT LAST_N == 0
HASRESTARGS 2
ASSERT LAST_N == 1

# one flag
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARGC "2"
HASFLAGS
ASSERT LAST_N == 1
HASFLAGS 1
ASSERT LAST_N == 1
HASFLAGS 2
ASSERT LAST_N == 0
ASSERT LISTFLAGS_N == 1

# two flags (name=value + bare)
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "--verbose"
SYS ENV SET CUBALC_ARG2 "out.txt"
SYS ENV SET CUBALC_ARGC "3"
HASFLAGS 2
ASSERT LAST_N == 1
HASFLAGS 3
ASSERT LAST_N == 0
ASSERT LISTFLAGS_N == 2

# --name value form counts as one flag
SYS ENV SET CUBALC_ARG0 "--out"
SYS ENV SET CUBALC_ARG1 "hi.txt"
SYS ENV SET CUBALC_ARG2 "-n"
SYS ENV SET CUBALC_ARG3 "3"
SYS ENV SET CUBALC_ARGC "4"
HASFLAGC 2
ASSERT LAST_N == 1
ASSERT LISTFLAGS_N == 2

# bare -- ends flags
SYS ENV SET CUBALC_ARG0 "--dry"
SYS ENV SET CUBALC_ARG1 "--"
SYS ENV SET CUBALC_ARG2 "--notflag"
SYS ENV SET CUBALC_ARGC "3"
HASFLAGS 1
ASSERT LAST_N == 1
HASFLAGS 2
ASSERT LAST_N == 0
ASSERT LISTFLAGS_N == 1

# branch without LISTFLAGS bag soup
SYS ENV SET CUBALC_ARG0 "--mode=x"
SYS ENV SET CUBALC_ARGC "1"
HASFLAGS 1
IF LAST_N == 1
  LET style "flagged"
ELSE
  LET style "plain"
END
SYS EQS style "flagged"
ASSERT LAST_N == 1

# pairs with LISTFLAGS
LISTFLAGS
ASSERT LAST_N == 1
SYS HASLINE LAST "mode"
ASSERT LAST_N == 1

PRINT "hasflags ok"
PASS
