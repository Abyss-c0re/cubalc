# Proof 450 — digit-0 cell fixed-width 8 inverted bitwise: NAND8CELL NOR8CELL XNOR8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NAND8CELL: 15 & 15 → ~15 as u8 = 240
CELLSET 0 15
NAND8CELL 0 0 15
ASSERT CELL(0) == 240
ASSERT LAST_N == 1

# NOR8CELL: 15 | 0 → ~15 as u8 = 240
CELLSET 1 15
NOR8CELL 1 1 0
ASSERT CELL(1) == 240
ASSERT LAST_N == 1

# XNOR8CELL: 15 ^ 0 → ~15 as u8 = 240
CELLSET 2 15
XNOR8CELL 2 2 0
ASSERT CELL(2) == 240
ASSERT LAST_N == 1

# range NAND: 255 with mask 15 → ~15 = 240
CELLSET 3 255
CELLSET 4 255
NAND8CELL 3 4 15
ASSERT CELL(3) == 240
ASSERT CELL(4) == 240
ASSERT LAST_N == 2

# CELLNOR8: 0 | 0 → ~0 = 255
CELLSET 5 0
CELLNOR8 5 5 0
ASSERT CELL(5) == 255

# CELLXNOR8: 170 ^ 170 → ~0 = 255
CELLSET 6 170
CELLXNOR8 6 6 170
ASSERT CELL(6) == 255

# high bits ignored: 256+15 nand 15 → ~15 = 240
CELLSET 7 271
NAND8CELL 7 7 15
ASSERT CELL(7) == 240

# NOR8RANGE: 0 | 0xF → ~0xF = 240
CELLSET 8 0
NOR8RANGE 8 8 15
ASSERT CELL(8) == 240

# XNOR8RANGE: self-xnor → 255
CELLSET 9 0xA5
XNOR8RANGE 9 9 0xA5
ASSERT CELL(9) == 255

# BNAND8CELL: 0 mask 0 → 255
CELLSET 10 0
BNAND8CELL 10 10 0
ASSERT CELL(10) == 255

HOLD_FLASH 0
