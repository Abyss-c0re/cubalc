# Proof 88 — digit-1 data: ROTRANGE + SHLRANGE/SHRRANGE (local range)
HOLD_FLASH 1
SCIENCE LOAD

CUBE m ROLE matrix PROTON 1
CLEARBITS m
# pattern in [0..3]: 1,1,0,1  and sentinel outside at bit 5
SETBIT m 0 1
SETBIT m 1 1
SETBIT m 2 0
SETBIT m 3 1
SETBIT m 5 1

# SHLRANGE 1: 1,1,0,1 → 0,1,1,0  (bit0 zero-filled; bit3 drops)
SHLRANGE m 0 3 1
GETBIT m 0
ASSERT LAST_N == 0
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 0
# sentinel untouched
GETBIT m 5
ASSERT LAST_N == 1

# SHRRANGE 1: 0,1,1,0 → 1,1,0,0
SHRRANGE m 0 3 1
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 0
GETBIT m 3
ASSERT LAST_N == 0
GETBIT m 5
ASSERT LAST_N == 1

# rebuild 1,1,0,1 for rotate
CLEARBITS m
SETBIT m 0 1
SETBIT m 1 1
SETBIT m 2 0
SETBIT m 3 1
SETBIT m 7 1
# ROTRANGE left 1: bit i → i+1 wrap → 1,1,1,0
ROTRANGE m 0 3 1
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 0
GETBIT m 7
ASSERT LAST_N == 1

# RORRANGE 1 restores 1,1,0,1
RORRANGE m 0 3 1
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 0
GETBIT m 3
ASSERT LAST_N == 1

# full rotate by len is identity
ROTRANGE m 0 3 4
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 1

# SHIFTRANGE alias = SHL: 1,1,0,1 → 0,0,1,1
SHIFTRANGE m 0 3 2
GETBIT m 0
ASSERT LAST_N == 0
GETBIT m 1
ASSERT LAST_N == 0
GETBIT m 2
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 1

# inverted lo/hi: bits [2..5]=1,1,0,1 → ROL1 → 1,1,1,0
CLEARBITS m
SETBIT m 2 1
SETBIT m 3 1
SETBIT m 4 0
SETBIT m 5 1
ROTRANGE m 5 2 1
GETBIT m 2
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 1
GETBIT m 4
ASSERT LAST_N == 1
GETBIT m 5
ASSERT LAST_N == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof88_rotrange_shift" LAST_N SET
