# Proof 513 — digit-8 dual-stack imm 32-bit field shift: DSHL32N DSHR32N DSAR32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DSHL32N: 1<<2=4 both
PUSH 0x1
PUSH 0x1
DSHL32N 2 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# overflow: 0x80000000 << 1 → 0; high preserved when n=0
CLEARSTACK
PUSH 0x1122334480000000
PUSH 0x99AABBCC40000000
PAIRSHL32N 1 0
POP y
POP x
ASSERT x == 0x1122334400000000
ASSERT y == 0x99AABBCC80000000

# k>=32 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xABCD
DSHL32N 32 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# S2SHL32N n1: high word of 0x0000000300000001 is 3 <<1 → 6
CLEARSTACK
PUSH 0x0000000300000001
PUSH 0x0000000200000000
S2SHL32N 1 1
POP y
POP x
ASSERT x == 0x0000000600000001
ASSERT y == 0x0000000400000000

# DSHR32N logical: 0x80000000>>1=0x40000000 ; 0xFFFFFFFF>>1=0x7FFFFFFF
CLEARSTACK
PUSH 0x80000000
PUSH 0xFFFFFFFF
DSHR32N 1 0
POP y
POP x
ASSERT x == 1073741824
ASSERT y == 2147483647

# high preserved shr
CLEARSTACK
PUSH 0x11223344FFFFFFFC
PUSH 0x99AABBCC0000000C
PAIRSHR32N 2 0
POP y
POP x
ASSERT x == 0x112233443FFFFFFF
ASSERT y == 0x99AABBCC00000003

# STACK2SHR32N n1: 0x8000000000000000 high>>1
CLEARSTACK
PUSH 0x8000000000000000
PUSH 0xA000000000000000
STACK2SHR32N 1 1
POP y
POP x
ASSERT x == 0x4000000000000000
ASSERT y == 0x5000000000000000

# DSAR32N: 0xFFFFFFFE (-2)>>1 → FFFFFFFF ; 0x80000000 (-2^31)>>1 → C0000000
CLEARSTACK
PUSH 0xFFFFFFFE
PUSH 0x80000000
DSAR32N 1 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 3221225472

# k>=32 all sign: neg → FFFFFFFF, pos → 0
CLEARSTACK
PUSH 0x80000000
PUSH 0x7FFFFFFF
PAIRSAR32N 32 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 0

# positive SAR: 6>>1=3 ; 4>>1=2
CLEARSTACK
PUSH 0x00000006
PUSH 0x00000004
DSAR32N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved SAR word1
CLEARSTACK
PUSH 0xFFFFFFFE00000000
PUSH 0x8000000000000000
S2SAR32N 1 1
POP y
POP x
ASSERT x == 0xFFFFFFFF00000000
ASSERT y == 0xC000000000000000

# DLSH32N / DASHR32N aliases
CLEARSTACK
PUSH 0x00000003
PUSH 0x00000003
DLSH32N 1 0
POP y
POP x
ASSERT x == 6
ASSERT y == 6

CLEARSTACK
PUSH 0xFFFFFFFE
PUSH 0xFFFFFFFE
DASHR32N 1 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 4294967295

HOLD_FLASH 0
