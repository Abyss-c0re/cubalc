# Proof 262 — digit-7 dual-stack imm nibble field: DNIBN DSETNIBN DCLRNIBN
HOLD_FLASH 1
SCIENCE LOAD

# DNIBN n
CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
DNIBN 0
POP y
POP x
ASSERT x == 0xD
ASSERT y == 0x4

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
2NIBN 1
POP y
POP x
ASSERT x == 0xC
ASSERT y == 0x3

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
PAIRNIBN 2
POP y
POP x
ASSERT x == 0xB
ASSERT y == 0x2

# DSETNIBN field n
CLEARSTACK
PUSH 0
PUSH -1
DSETNIBN 0xA 0
POP y
POP x
ASSERT x == 0xA
# -1 with nibble0=A → 0xFFFFFFFFFFFFFFFA = -6
ASSERT y == -6

CLEARSTACK
PUSH 0
PUSH 0
2SETNIBN 0xB 1
POP y
POP x
ASSERT x == 0xB0
ASSERT y == 0xB0

CLEARSTACK
PUSH -1
PUSH -1
PAIRSETNIBN 0 2
POP y
POP x
# clear nibble 2 (bits 8..11): -1 & ~0xF00 = -3841
ASSERT x == -3841
ASSERT y == -3841

# DCLRNIBN n
CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
DCLRNIBN 0
POP y
POP x
ASSERT x == 0xABC0
ASSERT y == 0x1230

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
2CLRNIBN 1
POP y
POP x
ASSERT x == 0xAB0D
ASSERT y == 0x1204

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
PAIRCLRNIBN 2
POP y
POP x
ASSERT x == 0xA0CD
ASSERT y == 0x1034

# soft fails
CLEARSTACK
DNIBN 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSETNIBN 2 0
ASSERT OK == 0
CLEARSTACK
DCLRNIBN 0
ASSERT OK == 0

HOLD_FLASH 1
