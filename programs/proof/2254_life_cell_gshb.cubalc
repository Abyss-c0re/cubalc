ASSERT LAST_N == bgs_h + 5 "bed gshb h+5"
GETF bed energy
ASSERT LAST_N == bgs_e - 5 "bed gshb e-5"
GETF bed atp
ASSERT LAST_N == bgs_a - 5 "bed gshb a-5"
GETF bed energy
LET e_fin = LAST_N
GETF bed threshold
LET thr_fin = LAST_N
GETF bed ready
LET rd = LAST_N
IF e_fin >= thr_fin THEN
  ASSERT rd == 1 "bed ready when e>=thr"
END
IF e_fin < thr_fin THEN
  ASSERT rd == 0 "bed unready when e<thr"
END

SEND founder photosynth 16
SEND founder charge 12
SEND founder feed 10
GETF founder atp
LET sa = LAST_N
GETF founder energy
LET se = LAST_N
IF sa > 3 THEN
  SEND founder gshb 2
  ASSERT LAST_N == 2 "drain gshb2"
END
GETF founder atp
LET sa2 = LAST_N
GETF founder energy
LET se2 = LAST_N
ASSERT sa2 <= sa "drain atp not up"
ASSERT se2 <= se "drain energy not up"

GETF founder alive
ASSERT LAST_N == 1 "founder alive post-gshb"

SEND founder gshb 0
ASSERT LAST_N == 0 "founder gshb n0"

ASSERT 1 == 1 "LIFE_CELL_GSHB continuum PASS"
