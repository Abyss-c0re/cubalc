# SORTBYFWHERE / ORDERWHERE — rank matching objects by numeric field
# Usability: no WHEREOBJ bag + SORTBYF glue

HOLD_FLASH 1

INCLUDE life_cell

NEW Cell a 1 30 0
NEW Cell b 1 10 0
NEW Cell c 1 20 0
NEW Cell d 1 10 0
NEW Cell e 1 50 0
NEW Cell f 1 5 0
SETF a age 1
SETF b age 0
SETF c age 1
SETF d age 0
SETF e age 1
SETF f age 0

# age==1 energies: a30 c20 e50 → ASC: c a e
SORTBYFWHERE Cell energy age 1
ASSERT OK == 1
ASSERT SORTBYFWHERE_N == 3
ASSERT LAST_N == 3
ASSERT SORTBYFWHERE_DESC == 0
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "c"
ASSERT LAST_N == 1
SYS NTH 1 SORTBYFWHERE
SYS EQS LAST "a"
ASSERT LAST_N == 1
SYS NTH 2 SORTBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1
# age==0 not included
SYS HASLINE SORTBYFWHERE "b"
ASSERT LAST_N == 0

# DESC: e a c
SORTBYFWHERE Cell energy age 1 DESC
ASSERT SORTBYFWHERE_DESC == 1
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1
SYS NTH 1 SORTBYFWHERE
SYS EQS LAST "a"
ASSERT LAST_N == 1
SYS NTH 2 SORTBYFWHERE
SYS EQS LAST "c"
ASSERT LAST_N == 1

# age==0 ASC: f5 b10 d10 (ties first-seen b before d)
SORTBYFWHERE Cell energy age 0 ASC
ASSERT SORTBYFWHERE_N == 3
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "f"
ASSERT LAST_N == 1
SYS NTH 1 SORTBYFWHERE
SYS EQS LAST "b"
ASSERT LAST_N == 1
SYS NTH 2 SORTBYFWHERE
SYS EQS LAST "d"
ASSERT LAST_N == 1

# WHERE sugar
SORTBYFWHERE Cell energy WHERE age 1 DESC
ASSERT SORTBYFWHERE_N == 3
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1

# OF sugar
SORTBYFWHERE OF Cell energy age 0 ASC
ASSERT SORTBYFWHERE_N == 3
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "f"
ASSERT LAST_N == 1

# aliases
ORDERWHERE Cell energy age 1 ASC
ASSERT ORDERWHERE_N == 3
SYS NTH 0 ORDERWHERE
SYS EQS LAST "c"
ASSERT LAST_N == 1
RANKWHERE Cell energy age 1 DESC
ASSERT RANKWHERE_N == 3
SYS NTH 0 RANKWHERE
SYS EQS LAST "e"
ASSERT LAST_N == 1
SORTIF Cell energy age 0 ASC
ASSERT SORTBYFWHERE_N == 3

# string match · open tickets by retries ASC
CLASS Ticket
  FIELD status "new"
  FIELD retries 0
  METHOD init s r
    SETF THIS status s
    SETF THIS retries r
  END
END
NEW Ticket t1 "open" 7
NEW Ticket t2 "closed" 1
NEW Ticket t3 "open" 2
NEW Ticket t4 "open" 7
SORTBYFWHERE Ticket retries status "open" ASC
ASSERT OK == 1
ASSERT SORTBYFWHERE_N == 3
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "t3"
ASSERT LAST_N == 1
SYS NTH 1 SORTBYFWHERE
SYS EQS LAST "t1"
ASSERT LAST_N == 1
SYS NTH 2 SORTBYFWHERE
SYS EQS LAST "t4"
ASSERT LAST_N == 1
SYS HASLINE SORTBYFWHERE "t2"
ASSERT LAST_N == 0 "closed excluded"

SORTBYFWHERE Ticket retries status "open" DESC
SYS NTH 0 SORTBYFWHERE
SYS EQS LAST "t1"
ASSERT LAST_N == 1 "first max on ties"

# no match → empty
SORTBYFWHERE Ticket retries status "missing"
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT SORTBYFWHERE_N == 0
SYS EQS LAST ""
ASSERT LAST_N == 1

PRINT "proof919_oop_sortbyfwhere" 1
ASSERT OK == 1
