# Proof 154 — digit-7 dual-stack bit-position: DFFS DFLS DBWIDTH
HOLD_FLASH 1
SCIENCE LOAD

# DFFS — 1-based lowest set bit; 0 if zero
CLEARSTACK
PUSH 8
PUSH 0
DFFS
POP y
POP x
ASSERT x == 4
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 12
DFFS
POP y
POP x
ASSERT x == 1
ASSERT y == 3

# DFLS — 1-based highest set bit
CLEARSTACK
PUSH 8
PUSH 1
DFLS
POP y
POP x
ASSERT x == 4
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH 0x80000000
2FLS
POP y
POP x
ASSERT x == 0
ASSERT y == 32

# DBWIDTH — same as FLS for nonzero unsigned
CLEARSTACK
PUSH 255
PUSH 256
DBWIDTH
POP y
POP x
ASSERT x == 8
ASSERT y == 9

CLEARSTACK
PUSH 0
PUSH 7
2BWIDTH
POP y
POP x
ASSERT x == 0
ASSERT y == 3

# aliases
CLEARSTACK
PUSH 16
PUSH 6
2FFS
POP y
POP x
ASSERT x == 5
ASSERT y == 2

CLEARSTACK
PUSH 0xF0
PUSH 0x01
PAIRFLS
POP y
POP x
ASSERT x == 8
ASSERT y == 1

CLEARSTACK
PUSH 1024
PUSH 0
PAIRBWIDTH
POP y
POP x
ASSERT x == 11
ASSERT y == 0

# soft fails
CLEARSTACK
DFFS
ASSERT OK == 0
CLEARSTACK
DFLS
ASSERT OK == 0
CLEARSTACK
DBWIDTH
ASSERT OK == 0
CLEARSTACK
PUSH 1
2FFS
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof154_dffs_dbwidth" LAST_N SP
