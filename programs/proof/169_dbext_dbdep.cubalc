# Proof 169 — digit-5 dual-stack field extract/deposit: DBEXT DBDEP
HOLD_FLASH 1
SCIENCE LOAD

# DBEXT — a b pos width → field field
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
PUSH 4
PUSH 8
DBEXT
POP y
POP x
ASSERT x == 0x23
ASSERT y == 0xBC

CLEARSTACK
PUSH 0xFF00
PUSH 0x00FF
PUSH 8
PUSH 8
2BEXT
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0

CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0
PUSH 4
PAIRBEXT
POP y
POP x
ASSERT x == 0
ASSERT y == 0xF

# DBDEP — a b fa fb pos → deposit 8-bit fields
CLEARSTACK
PUSH 0
PUSH 0
PUSH 0xAB
PUSH 0xCD
PUSH 8
DBDEP
POP y
POP x
ASSERT x == 0xAB00
ASSERT y == 0xCD00

CLEARSTACK
PUSH 0xFFFF
PUSH 0x0000
PUSH 0x12
PUSH 0x34
PUSH 0
2BDEP
POP y
POP x
ASSERT x == 0xFF12
ASSERT y == 0x0034

# round-trip: deposit then extract
CLEARSTACK
PUSH 0
PUSH 0
PUSH 0x5A
PUSH 0xA5
PUSH 4
DBDEP
POP y
POP x
CLEARSTACK
PUSH x
PUSH y
PUSH 4
PUSH 8
DBEXT
POP ey
POP ex
ASSERT ex == 0x5A
ASSERT ey == 0xA5

# soft fails
CLEARSTACK
DBEXT
ASSERT OK == 0
CLEARSTACK
DBDEP
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2BEXT
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2BDEP
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof169_dbext_dbdep" LAST_N SP
