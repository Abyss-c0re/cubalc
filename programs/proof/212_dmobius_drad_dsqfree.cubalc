# Proof 212 — digit-2 dual-stack numthy: DMOBIUS DRAD DSQFREE
HOLD_FLASH 1
SCIENCE LOAD

# DMOBIUS
CLEARSTACK
PUSH 1
PUSH 2
DMOBIUS
POP y
POP x
ASSERT x == 1
ASSERT y == -1

# two distinct primes → +1; square → 0
CLEARSTACK
PUSH 6
PUSH 4
2MOBIUS
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# PAIRMOBIUS / DMU
CLEARSTACK
PUSH 30
PUSH 0
PAIRMOBIUS
POP y
POP x
ASSERT x == -1
ASSERT y == 0

CLEARSTACK
PUSH -3
PUSH 1
DMU
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DRAD radical
CLEARSTACK
PUSH 1
PUSH 12
DRAD
POP y
POP x
ASSERT x == 1
ASSERT y == 6

CLEARSTACK
PUSH 8
PUSH 30
2RAD
POP y
POP x
ASSERT x == 2
ASSERT y == 30

# PAIRRAD / DRADICAL
CLEARSTACK
PUSH 0
PUSH 100
PAIRRAD
POP y
POP x
ASSERT x == 0
ASSERT y == 10

CLEARSTACK
PUSH 7
PUSH 49
DRADICAL
POP y
POP x
ASSERT x == 7
ASSERT y == 7

# DSQFREE
CLEARSTACK
PUSH 1
PUSH 6
DSQFREE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 12
PUSH 4
2SQFREE
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRSQFREE / DISSQFREE
CLEARSTACK
PUSH 30
PUSH 0
PAIRSQFREE
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -5
PUSH 15
DISSQFREE
POP y
POP x
ASSERT x == 0
ASSERT y == 1
