# Proof 109 — digit-7 stack immediate ALU: SDIVN SMODN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 20
SDIVN 4
ASSERT LAST_N == 5
SMODN 3
ASSERT LAST_N == 2
POP a
ASSERT a == 2

# aliases
CLEARSTACK
PUSH 42
DIVN 6
ASSERT LAST_N == 7
MODN 5
ASSERT LAST_N == 2

# QUOTN / REMN
CLEARSTACK
PUSH 100
QUOTN 7
ASSERT LAST_N == 14
PUSH 100
REMN 7
ASSERT LAST_N == 2

# div/mod by zero soft → 0
CLEARSTACK
PUSH 9
SDIVN 0
ASSERT LAST_N == 0
ASSERT OK == 1
PUSH 9
SMODN 0
ASSERT LAST_N == 0
ASSERT OK == 1

# chain with SMULN / SADDN
CLEARSTACK
PUSH 3
SMULN 10
SADDN 5
SDIVN 5
ASSERT LAST_N == 7
SMODN 4
ASSERT LAST_N == 3

# soft fail empty
CLEARSTACK
SDIVN 2
ASSERT OK == 0
SMODN 3
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof109_sdivn_smodn" LAST_N SP
