# Proof 65 — digit-1 ROTL8/16 SHL32/SHR32 SEXT32/ZEXT32 + stack
HOLD_FLASH 1
SCIENCE LOAD

# ROTL8 / ROTR8
ASSERT ROTL8(0x81, 1) == 0x03
ASSERT ROTR8(0x81, 1) == 0xC0
ASSERT ROL8(0x12, 4) == 0x21
ASSERT ROR8(0x12, 4) == 0x21
ASSERT ROTL8(0xAB, 0) == 0xAB
ASSERT ROTL8(ROTR8(0x5A, 3), 3) == 0x5A

# ROTL16 / ROTR16
ASSERT ROTL16(0x8001, 1) == 0x0003
ASSERT ROTR16(0x8001, 1) == 0xC000
ASSERT ROL16(0x1234, 4) == 0x2341
ASSERT ROR16(0x1234, 4) == 0x4123
ASSERT ROTL16(ROTR16(0xABCD, 7), 7) == 0xABCD

# SHL32 / SHR32
ASSERT SHL32(1, 8) == 0x100
ASSERT SHR32(0x100, 8) == 1
ASSERT SHL32(0x80000000, 1) == 0
ASSERT SHR32(0x80000000, 1) == 0x40000000
ASSERT SHL32(7, 32) == 0
ASSERT SHR32(7, 32) == 0
ASSERT SHL32(0xFF, 4) == 0xFF0

# SEXT32 / ZEXT32
ASSERT ZEXT32(-1) == 0xFFFFFFFF
ASSERT SEXT32(0xFFFFFFFF) == -1
ASSERT SEXTL(0x7FFFFFFF) == 0x7FFFFFFF
ASSERT ZEXTL(0x80000000) == 0x80000000
ASSERT SEXT32(0x80000000) < 0
ASSERT ZEXT32(0x80000000) > 0

# compose
ASSERT ROTL8(ZEXT32(0x81), 1) == 0x03
ASSERT SHR32(SHL32(0xAB, 8), 8) == 0xAB
ASSERT SEXT32(ROTL16(0x8000, 1)) == 1

# stack SROTL8 SROTR8 SROTL16
CLEARSTACK
PUSH 0x81
PUSH 1
SROTL8
ASSERT LAST_N == 0x03
CLEARSTACK
PUSH 0x81
PUSH 1
SROTR8
ASSERT LAST_N == 0xC0
CLEARSTACK
PUSH 0x8001
PUSH 1
SROTL16
ASSERT LAST_N == 0x0003
CLEARSTACK
PUSH 0x1234
PUSH 4
SROTR16
ASSERT LAST_N == 0x4123

# stack SSHL32 SSHR32
CLEARSTACK
PUSH 1
PUSH 8
SSHL32
ASSERT LAST_N == 0x100
CLEARSTACK
PUSH 0x80000000
PUSH 1
SSHR32
ASSERT LAST_N == 0x40000000

# stack SSEXT32 SZEXT32
CLEARSTACK
PUSH 0xFFFFFFFF
SSEXT32
ASSERT LAST_N == -1
CLEARSTACK
PUSH -1
SZEXT32
ASSERT LAST_N == 0xFFFFFFFF
CLEARSTACK
PUSH 0x80000000
SSEXTL
ASSERT LAST_N < 0
CLEARSTACK
PUSH 0x80000000
SZEXTL
ASSERT LAST_N > 0

# underflow
CLEARSTACK
SROTL8
ASSERT OK == 0
CLEARSTACK
SSHL32
ASSERT OK == 0
CLEARSTACK
SSEXT32
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof65_rotate_shift_extend" LAST_N SP
