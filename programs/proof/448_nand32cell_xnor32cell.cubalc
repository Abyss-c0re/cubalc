# Proof 448 — digit-4 cell fixed-width 32 inverted bitwise: NAND32CELL NOR32CELL XNOR32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NAND32CELL: 15 & 15 → ~(15) as u32 = 4294967280
CELLSET 0 15
NAND32CELL 0 0 15
ASSERT CELL(0) == 4294967280
ASSERT LAST_N == 1

# NOR32CELL: 15 | 0 → ~15 as u32
CELLSET 1 15
NOR32CELL 1 1 0
ASSERT CELL(1) == 4294967280
ASSERT LAST_N == 1

# XNOR32CELL: 15 ^ 0 → ~15 as u32
CELLSET 2 15
XNOR32CELL 2 2 0
ASSERT CELL(2) == 4294967280
ASSERT LAST_N == 1

# range NAND: 255 with mask 15 → ~15
CELLSET 3 255
CELLSET 4 255
NAND32CELL 3 4 15
ASSERT CELL(3) == 4294967280
ASSERT CELL(4) == 4294967280
ASSERT LAST_N == 2

# CELLNOR alias: 0 | 0 → ~0 = 4294967295
CELLSET 5 0
CELLNOR32 5 5 0
ASSERT CELL(5) == 4294967295

# CELLXNOR: 170 ^ 170 → ~0
CELLSET 6 170
CELLXNOR32 6 6 170
ASSERT CELL(6) == 4294967295

# high bits ignored: 2^32+15 nand 15 → ~15
CELLSET 7 4294967311
NAND32CELL 7 7 15
ASSERT CELL(7) == 4294967280

# NOR32RANGE single: 0 | 0xF → ~0xF
CELLSET 8 0
NOR32RANGE 8 8 15
ASSERT CELL(8) == 4294967280

# XNOR32RANGE: self-xnor → all ones low32
CELLSET 9 0xA5A5A5A5
XNOR32RANGE 9 9 0xA5A5A5A5
ASSERT CELL(9) == 4294967295

# BNAND32CELL: 0 mask 0 → all ones
CELLSET 10 0
BNAND32CELL 10 10 0
ASSERT CELL(10) == 4294967295

HOLD_FLASH 0
