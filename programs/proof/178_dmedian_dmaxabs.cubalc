# Proof 178 — digit-1 dual-stack select: DMEDIAN DMAXABS DMINABS
HOLD_FLASH 1
SCIENCE LOAD

# DMEDIAN: a b c d e f → med(a,c,e) med(b,d,f)
CLEARSTACK
PUSH 1
PUSH 9
PUSH 5
PUSH 2
PUSH 3
PUSH 7
DMEDIAN
POP y
POP x
ASSERT x == 3
ASSERT y == 7

# 2MED alias — sorted mid
CLEARSTACK
PUSH 10
PUSH 0
PUSH 0
PUSH 5
PUSH 20
PUSH -1
2MED
POP y
POP x
ASSERT x == 10
ASSERT y == 0

# DMID3
CLEARSTACK
PUSH -5
PUSH 8
PUSH 0
PUSH 8
PUSH 5
PUSH 1
DMID3
POP y
POP x
ASSERT x == 0
ASSERT y == 8

# DMAXABS: a b c d → max(|a|,|c|) max(|b|,|d|)
CLEARSTACK
PUSH -7
PUSH 3
PUSH 4
PUSH -9
DMAXABS
POP y
POP x
ASSERT x == 7
ASSERT y == 9

# 2ABSMAX alias
CLEARSTACK
PUSH 2
PUSH -5
PUSH -2
PUSH 5
2ABSMAX
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# DMINABS
CLEARSTACK
PUSH -7
PUSH 3
PUSH 4
PUSH -9
DMINABS
POP y
POP x
ASSERT x == 4
ASSERT y == 3

# 2ABSMIN
CLEARSTACK
PUSH 0
PUSH -1
PUSH 5
PUSH 1
2ABSMIN
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DMEDIAN
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
DMAXABS
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof178_dmedian_dmaxabs" LAST_N SP
