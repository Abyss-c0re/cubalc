# Proof 547 — digit-2 stack+dual imm 8-bit signed min/max: SMINS8N SMAXS8N DMINS8N DMAXS8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMINS8N: signed min(-1=0xFF, 1) → -1
PUSH 0xFF
SMINS8N 0x1 0
POP x
ASSERT x == 0xFF

# unsigned SMIN: min(0xFF, 1) → 1
CLEARSTACK
PUSH 0xFF
SMIN8N 0x1 0
POP x
ASSERT x == 1

# positive: min(2, 3) → 2
CLEARSTACK
PUSH 0x2
SMINS8N 0x3 0
POP x
ASSERT x == 2

# field smaller: min(5, -2) → -2
CLEARSTACK
PUSH 0x5
MINS8N 0xFE 0
POP x
ASSERT x == 0xFE

# INT8_MIN vs INT8_MAX → INT8_MIN
CLEARSTACK
PUSH 0x80
SMINSIGN8N 0x7F 0
POP x
ASSERT x == 0x80

# equal
CLEARSTACK
PUSH 0x80
SMINS8N 0x80 0
POP x
ASSERT x == 0x80

# preserved high byte: low -1 min 0 → low -1
CLEARSTACK
PUSH 0x11FF
SMINS8N 0x0 0
POP x
ASSERT x == 0x11FF

# STACKMINS8N n1: byte1 of 0xFF01 is FF → min 0 stays FF
CLEARSTACK
PUSH 0xFF01
STACKMINS8N 0x0 1
POP x
ASSERT x == 0xFF01

# n2: 0xFE0000 min 0 → 0xFE0000
CLEARSTACK
PUSH 0x00FE0000
SMINS8N 0x0 2
POP x
ASSERT x == 0x00FE0000

# SMAXS8N: signed max(-1, 1) → 1
CLEARSTACK
PUSH 0xFF
SMAXS8N 0x1 0
POP x
ASSERT x == 1

# unsigned SMAX: max(0xFF, 1) → 0xFF
CLEARSTACK
PUSH 0xFF
SMAX8N 0x1 0
POP x
ASSERT x == 0xFF

# max(2, -3) → 2
CLEARSTACK
PUSH 0x2
MAXS8N 0xFD 0
POP x
ASSERT x == 2

# INT8_MIN max INT8_MAX → INT8_MAX
CLEARSTACK
PUSH 0x80
SMAXSIGN8N 0x7F 0
POP x
ASSERT x == 0x7F

# equal
CLEARSTACK
PUSH 0x55
SMAXS8N 0x55 0
POP x
ASSERT x == 0x55

# preserved high: low 1 max -1 → low 1
CLEARSTACK
PUSH 0xAA01
SMAXS8N 0xFF 0
POP x
ASSERT x == 0xAA01

# STACKMAXS8N n1
CLEARSTACK
PUSH 0x0200
STACKMAXS8N 0xFF 1
POP x
ASSERT x == 0x0200

# DMINS8N: -1 min 0 → -1; 1 min 0 → 0
CLEARSTACK
PUSH 0xFF
PUSH 0x1
DMINS8N 0x0 0
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0

# unsigned dual contrast
CLEARSTACK
PUSH 0xFF
PUSH 0xFF
DMIN8N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# mixed
CLEARSTACK
PUSH 0x2
PUSH 0xFE
PAIRMINS8N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFE

# preserved high dual
CLEARSTACK
PUSH 0x11FF
PUSH 0xAA05
S2MINS8N 0x1 0
POP y
POP x
ASSERT x == 0x11FF
ASSERT y == 0xAA01

# STACK2MINS8N n1
CLEARSTACK
PUSH 0xFF00
PUSH 0x0200
STACK2MINS8N 0x0 1
POP y
POP x
ASSERT x == 0xFF00
ASSERT y == 0x0000

# DMAXS8N: -1 max 0 → 0; 1 max 0 → 1
CLEARSTACK
PUSH 0xFF
PUSH 0x1
DMAXS8N 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# INT8_MIN max INT8_MAX field
CLEARSTACK
PUSH 0x80
PUSH 0x80
PAIRMAXS8N 0x7F 0
POP y
POP x
ASSERT x == 0x7F
ASSERT y == 0x7F

# unsigned dual max contrast
CLEARSTACK
PUSH 0xFF
PUSH 0x2
DMAX8N 0x1 0
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 2

# DMAXSIGN8N
CLEARSTACK
PUSH 0xFE
PUSH 0x3
DMAXSIGN8N 0xFF 0
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 3

# STACK2MAXS8N n1
CLEARSTACK
PUSH 0xFE00
PUSH 0x0100
STACK2MAXS8N 0x0 1
POP y
POP x
ASSERT x == 0x0000
ASSERT y == 0x0100

HOLD_FLASH 0
