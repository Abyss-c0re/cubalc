# Proof 24 — stack combinators + FILLCELL (digit 4 data plane)
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
# stack: 1 2 3
DUP
ASSERT SP == 4
PEEK
ASSERT LAST_N == 3
DROP
ASSERT SP == 3
SWAP
# was 1 2 3 → 1 3 2
PEEK
ASSERT LAST_N == 2
POP a
ASSERT a == 2
PEEK
ASSERT LAST_N == 3
POP b
ASSERT b == 3
POP c
ASSERT c == 1
ASSERT SP == 0

# OVER: a b → a b a
CLEARSTACK
PUSH 10
PUSH 20
OVER
ASSERT SP == 3
POP x
ASSERT x == 10
POP y
ASSERT y == 20
POP z
ASSERT z == 10

# ROT: a b c → b c a
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
ROT
POP r0
ASSERT r0 == 1
POP r1
ASSERT r1 == 3
POP r2
ASSERT r2 == 2
ASSERT SP == 0

# PICK: copy under top
CLEARSTACK
PUSH 7
PUSH 8
PUSH 9
PICK 2
PEEK
ASSERT LAST_N == 7
ASSERT SP == 4
PICK 0
PEEK
ASSERT LAST_N == 7
ASSERT SP == 5
CLEARSTACK
ASSERT SP == 0

# empty guards
DUP
ASSERT OK == 0
DROP
ASSERT OK == 0
SWAP
ASSERT OK == 0
OVER
ASSERT OK == 0
ROT
ASSERT OK == 0

# FILLCELL
CLEARCELLS
FILLCELL 0 4 42
ASSERT CELL(0) == 42
ASSERT CELL(4) == 42
ASSERT CELL(5) == 0
FILLCELL 2 2 99
ASSERT CELL(2) == 99
ASSERT SUMCELL(0,4) == 42+42+99+42+42

CUBE s ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof24_stack_ops" SP CELL(2) SUMCELL(0,4)
