# Proof 388 — digit-8 imm clear + high-mask TOC: SCLRMNTOCN SCLRHNTOCN SHMASKTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLRMNTOCN: clear low 4 of 255 → 240 (0xF0)
CELLSET 1 255
PUSH 1
SCLRMNTOCN 4
ASSERT LAST_N == 240
ASSERT CELL(1) == 240
POP a
ASSERT a == 240

# CLRMNTOCN n=0: no-op leave 99
CELLSET 2 99
PUSH 2
CLRMNTOCN 0
ASSERT LAST_N == 99
ASSERT CELL(2) == 99
POP

# SCLRHNTOCN: all-ones clear high-1 → positive (MSB cleared)
CELLSET 3 0
PUSH 3
SORMNTOCN 64
POP
PUSH 3
SCLRHNTOCN 1
ASSERT LAST_N > 0
ASSERT CELL(3) > 0
POP

# CLRHNTOCN n=0: no-op leave 7
CELLSET 4 7
PUSH 4
CLRHNTOCN 0
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
POP

# SHMASKTOCN: high-1 → MSB only (negative)
CELLSET 5 0
PUSH 5
SHMASKTOCN 1
ASSERT LAST_N < 0
ASSERT CELL(5) < 0
POP

# HMASKTOCN n=0 → 0
CELLSET 6 42
PUSH 6
HMASKTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# soft empty OK=0
CLEARSTACK
SCLRMNTOCN 3
ASSERT OK == 0

PRINT "388_sclrmntocn_shmasktocn OK"
