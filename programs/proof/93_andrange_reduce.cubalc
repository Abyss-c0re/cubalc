# Proof 93 — digit-3 COP: ANDRANGE/ORRANGE/XORRANGE + ANDREDUCE/ORREDUCE
HOLD_FLASH 1
SCIENCE LOAD

CUBE a ROLE matrix PROTON 1
CUBE b ROLE matrix PROTON 1
CLEARBITS a
CLEARBITS b
SETBIT a 0 1
SETBIT a 1 1
SETBIT a 2 0
SETBIT a 3 1
SETBIT b 0 1
SETBIT b 1 0
SETBIT b 2 1
SETBIT b 3 1
SETBIT a 5 1
SETBIT b 5 0

ANDRANGE a b 0 3
GETBIT a 0
ASSERT LAST_N == 1
GETBIT a 1
ASSERT LAST_N == 0
GETBIT a 2
ASSERT LAST_N == 0
GETBIT a 3
ASSERT LAST_N == 1
GETBIT a 5
ASSERT LAST_N == 1

CLEARBITS a
SETBIT a 0 1
SETBIT a 1 1
SETBIT a 2 0
SETBIT a 3 1
SETBIT a 5 1
ORRANGE a b 0 3
GETBIT a 0
ASSERT LAST_N == 1
GETBIT a 1
ASSERT LAST_N == 1
GETBIT a 2
ASSERT LAST_N == 1
GETBIT a 3
ASSERT LAST_N == 1
GETBIT a 5
ASSERT LAST_N == 1

CLEARBITS a
SETBIT a 0 1
SETBIT a 1 1
SETBIT a 2 0
SETBIT a 3 1
XORRANGE a b 0 3
GETBIT a 0
ASSERT LAST_N == 0
GETBIT a 1
ASSERT LAST_N == 1
GETBIT a 2
ASSERT LAST_N == 1
GETBIT a 3
ASSERT LAST_N == 0

CLEARBITS a
FILLRANGE a 0 3
ANDREDUCE a 0 3
ASSERT LAST_N == 1
ALLRANGE a 0 3
ASSERT LAST_N == 1
SETBIT a 2 0
ANDREDUCE a 0 3
ASSERT LAST_N == 0
ORREDUCE a 0 3
ASSERT LAST_N == 1
ANYRANGE a 0 3
ASSERT LAST_N == 1
CLEARBITS a
ORREDUCE a 0 3
ASSERT LAST_N == 0
ANDREDUCE a 100 110
ASSERT LAST_N == 1

ANDREDUCE nosuch 0 3
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof93_andrange_reduce" LAST_N SET
