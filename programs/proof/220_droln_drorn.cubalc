# Proof 220 — digit-3 dual-stack immediate rotate: DROLN DRORN
HOLD_FLASH 1
SCIENCE LOAD

# DROLN — 0x12 <<rot 4 → 0x120; same on both lanes
CLEARSTACK
PUSH 0x12
PUSH 0x12
DROLN 4
POP y
POP x
ASSERT x == 0x120
ASSERT y == 0x120

# different values, shared n
CLEARSTACK
PUSH 1
PUSH 3
2ROLN 1
POP y
POP x
ASSERT x == 2
ASSERT y == 6

# PAIRROLN / DROTLN n=0 no-op
CLEARSTACK
PUSH 7
PUSH 8
PAIRROLN 0
POP y
POP x
ASSERT x == 7
ASSERT y == 8

CLEARSTACK
PUSH 0x80
PUSH 0x01
DROTLN 1
POP y
POP x
ASSERT x == 0x100
ASSERT y == 2

# wrap: 1<<63 rotl 1 → 1 (bit 63 to 0)
CLEARSTACK
PUSH 1
SSHLN 63
PUSH 1
SSHLN 63
DROLN 1
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DRORN
CLEARSTACK
PUSH 0x120
PUSH 0x120
DRORN 4
POP y
POP x
ASSERT x == 0x12
ASSERT y == 0x12

CLEARSTACK
PUSH 8
PUSH 4
2RORN 1
POP y
POP x
ASSERT x == 4
ASSERT y == 2

# PAIRRORN / DROTRN
CLEARSTACK
PUSH 2
PUSH 6
PAIRRORN 1
POP y
POP x
ASSERT x == 1
ASSERT y == 3

CLEARSTACK
PUSH 1
PUSH 1
DROTRN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# round-trip DROLN then DRORN
CLEARSTACK
PUSH 0xABCDEF
PUSH 0x123456
DROLN 7
DRORN 7
POP y
POP x
ASSERT x == 0xABCDEF
ASSERT y == 0x123456
