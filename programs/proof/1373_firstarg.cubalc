# FIRSTARG / LASTARG — peel first/last CUBALC_ARGi raw (NTHARG ends, no ARGC glue)

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"

# empty + fallback
FIRSTARG OR "help"
ASSERT FIRSTARG_HIT == 0
ASSERT LAST_N == 0
SYS EQS LAST "help"
ASSERT LAST_N == 1

LASTARG OR "none"
ASSERT LASTARG_HIT == 0
SYS EQS LAST "none"
ASSERT LAST_N == 1

# miss without fallback
FIRSTARG
ASSERT FIRSTARG_HIT == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# three raw args (flag + file + trailing)
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "mid.txt"
SYS ENV SET CUBALC_ARG2 "tail.bin"
SYS ENV SET CUBALC_ARGC "3"

FIRSTARG
ASSERT FIRSTARG_HIT == 1
ASSERT LAST_N == 1
ASSERT FIRSTARG_N == 0
SYS EQS LAST "--verbose"
ASSERT LAST_N == 1

LASTARG
ASSERT LASTARG_HIT == 1
ASSERT LAST_N == 1
ASSERT LASTARG_N == 2
SYS EQS LAST "tail.bin"
ASSERT LAST_N == 1

# HEADARG / TAILARG aliases
HEADARG
SYS EQS LAST "--verbose"
ASSERT LAST_N == 1
TAILARG
SYS EQS LAST "tail.bin"
ASSERT LAST_N == 1

# single arg is both first and last
SYS ENV SET CUBALC_ARG0 "only"
SYS ENV SET CUBALC_ARGC "1"
FIRSTARG
SYS EQS LAST "only"
ASSERT LAST_N == 1
LASTARG
SYS EQS LAST "only"
ASSERT LAST_N == 1
ASSERT LASTARG_N == 0

# NTHARG 0 matches FIRSTARG
SYS ENV SET CUBALC_ARG0 "a"
SYS ENV SET CUBALC_ARG1 "b"
SYS ENV SET CUBALC_ARGC "2"
FIRSTARG
NTHARG 0
SYS EQS LAST "a"
ASSERT LAST_N == 1

# discoverable
HASFORM "FIRSTARG"
ASSERT LAST_N == 1
HASFORM "LASTARG"
ASSERT LAST_N == 1

RELATED "FIRSTARG"
SYS HASLINE LAST "LASTARG"
ASSERT LAST_N == 1

PRINT "firstarg ok"
PASS
