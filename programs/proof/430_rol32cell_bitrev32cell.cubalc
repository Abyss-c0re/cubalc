# Proof 430 — digit-4 cell rotate32 + bitrev: ROL32CELL ROR32CELL BITREV32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# ROL32CELL: [1,2] rotl 4 → [16,32]
CELLSET 0 1
CELLSET 1 2
ROL32CELL 0 1 4
ASSERT CELL(0) == 16
ASSERT CELL(1) == 32
ASSERT LAST_N == 2

# ROL32RANGE: 0x80000000 rotl 1 → 1
CELLSET 2 2147483648
ROL32RANGE 2 2 1
ASSERT CELL(2) == 1
ASSERT LAST_N == 1

# ROR32CELL: 16 rotr 4 → 1; 1 rotr 1 → 0x80000000
CELLSET 3 16
CELLSET 4 1
ROR32CELL 3 4 4
ASSERT CELL(3) == 1
# wait: both rotated by 4 — cell4 1 rotr 4 = 0x10000000
ASSERT CELL(4) == 268435456
ASSERT LAST_N == 2

# ROR32RANGE identity k=0
CELLSET 5 42
ROR32RANGE 5 5 0
ASSERT CELL(5) == 42

# BITREV32CELL: 1 → 0x80000000; 0x80000000 → 1
CELLSET 6 1
CELLSET 7 2147483648
BITREV32CELL 6 7
ASSERT CELL(6) == 2147483648
ASSERT CELL(7) == 1
ASSERT LAST_N == 2

# BREV32CELL alias: 0 → 0
CELLSET 8 0
BREV32CELL 8 8
ASSERT CELL(8) == 0
ASSERT LAST_N == 1

# round-trip ROL then ROR
CELLSET 9 0xA5
ROL32CELL 9 9 8
ROR32CELL 9 9 8
ASSERT CELL(9) == 165

HOLD_FLASH 0
