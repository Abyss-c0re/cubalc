# Proof 556 — digit-7 stack+dual signed field signum 8/4: SSIGN8N SSIGN4N DSIGN8N DSIGN4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSIGN8N: +5 → 1
PUSH 0x5
SSIGN8N 0
POP x
ASSERT x == 1

# 0 → 0
CLEARSTACK
PUSH 0x0
SIGN8N 0
POP x
ASSERT x == 0

# -1=0xFF → 0xFF
CLEARSTACK
PUSH 0xFF
SSIGNUM8N 0
POP x
ASSERT x == 0xFF

# INT8_MIN=0x80 → 0xFF
CLEARSTACK
PUSH 0x80
SGN8N 0
POP x
ASSERT x == 0xFF

# high preserve
CLEARSTACK
PUSH 0xAA03
SSIGN8N 0
POP x
ASSERT x == 0xAA01

# STACKSIGN8N n1: high -2=0xFE → high 0xFF
CLEARSTACK
PUSH 0xFE00
STACKSIGN8N 1
POP x
ASSERT x == 0xFF00

# SSIGN4N: +3 → 1
CLEARSTACK
PUSH 0x3
SSIGN4N 0
POP x
ASSERT x == 1

# 0 → 0
CLEARSTACK
PUSH 0x0
SIGN4N 0
POP x
ASSERT x == 0

# -1=0xF → 0xF
CLEARSTACK
PUSH 0xF
SSIGNUM4N 0
POP x
ASSERT x == 0xF

# INT4_MIN=0x8 → 0xF
CLEARSTACK
PUSH 0x8
SGN4N 0
POP x
ASSERT x == 0xF

# high nibble preserve: low -3=0xD → 0xF; high 1 stays
CLEARSTACK
PUSH 0x1D
SSIGN4N 0
POP x
ASSERT x == 0x1F

# STACKSIGN4N n1: high +2 → +1; low 0
CLEARSTACK
PUSH 0x20
STACKSIGN4N 1
POP x
ASSERT x == 0x10

# DSIGN8N
CLEARSTACK
PUSH 0x5
PUSH 0xFE
DSIGN8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0xFF

CLEARSTACK
PUSH 0x0
PUSH 0x80
PAIRSIGN8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFF

# STACK2SIGN8N n1
CLEARSTACK
PUSH 0x0300
PUSH 0xFD00
STACK2SIGN8N 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0xFF00

# DSIGN4N
CLEARSTACK
PUSH 0x3
PUSH 0xE
DSIGN4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0xF

CLEARSTACK
PUSH 0x0
PUSH 0x8
PAIRSIGN4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xF

# STACK2SIGN4N n1
CLEARSTACK
PUSH 0x30
PUSH 0xD0
STACK2SIGN4N 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0xF0

HOLD_FLASH 0
