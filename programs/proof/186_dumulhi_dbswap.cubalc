# Proof 186 — digit-0 dual-stack: DUMULHI DBSWAP16 DBSWAP64
HOLD_FLASH 1
SCIENCE LOAD

# DUMULHI: a b c d → high64(ua*uc) high64(ub*ud)
# 2^32 * 2^32 = 2^64 → high 1
CLEARSTACK
PUSH 4294967296
PUSH 4294967296
PUSH 4294967296
PUSH 4294967296
DUMULHI
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 2UMULHI small product high=0
CLEARSTACK
PUSH 7
PUSH 9
PUSH 3
PUSH 5
2UMULHI
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRUMULH: (-1u)*(-1u) high = 2^64-2 as signed = -2
CLEARSTACK
PUSH -1
PUSH -1
PUSH -1
PUSH -1
PAIRUMULH
POP y
POP x
ASSERT x == -2
ASSERT y == -2

# DUMULH alias zero * anything
CLEARSTACK
PUSH 0
PUSH 99
PUSH 123
PUSH 456
DUMULH
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DBSWAP16: 0x1234 → 0x3412
CLEARSTACK
PUSH 4660
PUSH 43981
DBSWAP16
POP y
POP x
ASSERT x == 13330
ASSERT y == 52651

# 2BSWAP16
CLEARSTACK
PUSH 256
PUSH 1
2BSWAP16
POP y
POP x
ASSERT x == 1
ASSERT y == 256

# PAIRBSWAP16 mask low 16
CLEARSTACK
PUSH 65535
PUSH 0
PAIRBSWAP16
POP y
POP x
ASSERT x == 65535
ASSERT y == 0

# DBSWAP64: 0x0102030405060708 → 0x0807060504030201
CLEARSTACK
PUSH 72623859790382856
PUSH 0
DBSWAP64
POP y
POP x
ASSERT x == 578437695752307201
ASSERT y == 0

# 2BSWAP64 identity on 0
CLEARSTACK
PUSH 0
PUSH 1
2BSWAP64
POP y
POP x
ASSERT x == 0
ASSERT y == 72057594037927936

# S2UMULHI / STACK2BSWAP16 aliases
CLEARSTACK
PUSH 1
PUSH 1
PUSH 1
PUSH 1
S2UMULHI
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 512
PUSH 1024
STACK2BSWAP16
POP y
POP x
ASSERT x == 2
ASSERT y == 4

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
DUMULHI
ASSERT OK == 0
CLEARSTACK
PUSH 1
DBSWAP16
ASSERT OK == 0
CLEARSTACK
DBSWAP64
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof186_dumulhi_dbswap" LAST_N SP
