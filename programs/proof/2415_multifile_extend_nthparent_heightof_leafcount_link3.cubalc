# Proof 2415 — MULTIFILE_EXTEND_NTHPARENT_HEIGHTOF_LEAFCOUNT_LINK3
# Multi-file CLASS EXTEND + NTHPARENT/PARENTAT + HEIGHTOF + LEAFCOUNT.
# Complements PARENTS/DEPTHOF + NTHCHILD + DESCENDANTS/ISLEAF.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

CLASS DeepLeaf EXTEND SoftTag
  FIELD deep 1
  METHOD z
    RET 1
  END
END
HASCLASS DeepLeaf
ASSERT LAST_N == 1

# --- NTHPARENT / PARENTAT (0 = immediate) ---
NTHPARENT TagGreeter 0
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT NTHPARENT_N == 1
ASSERT LAST == "Greeter"

NTHPARENT LoudTag 0
ASSERT LAST_N == 1
ASSERT LAST == "TagGreeter"

NTHPARENT LoudTag 1
ASSERT LAST_N == 1
ASSERT LAST == "Greeter"

NTHPARENT DeepLeaf 0
ASSERT LAST == "SoftTag"
NTHPARENT DeepLeaf 1
ASSERT LAST == "TagGreeter"
NTHPARENT DeepLeaf 2
ASSERT LAST == "Greeter"

NTHPARENT DeepLeaf 9
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT NTHPARENT_N == 0

NTHPARENT Greeter 0
ASSERT LAST_N == 0

NTHPARENT Solo 0
ASSERT LAST_N == 0

PARENTAT SoftTag 0
ASSERT LAST_N == 1
ASSERT LAST == "TagGreeter"

ANCESTORAT DeepLeaf 1
ASSERT LAST == "TagGreeter"

# --- HEIGHTOF (longest downward path; leaf = 0) ---
HEIGHTOF LoudTag
ASSERT OK == 1
ASSERT HEIGHTOF_N == 0
ASSERT LAST_N == 0

HEIGHTOF TwinGreet
ASSERT HEIGHTOF_N == 0

HEIGHTOF Solo
ASSERT HEIGHTOF_N == 0

HEIGHTOF SoftTag
ASSERT OK == 1
ASSERT HEIGHTOF_N == 1

HEIGHTOF TagGreeter
ASSERT OK == 1
ASSERT HEIGHTOF_N == 2

HEIGHTOF Greeter
ASSERT OK == 1
ASSERT HEIGHTOF_N >= 2
ASSERT HEIGHTOF_N == 3

TREEHEIGHT Greeter
ASSERT LAST_N == 3

HEIGHT_OF DeepLeaf
ASSERT HEIGHTOF_N == 0

# --- LEAFCOUNT (leaves in subtree; self if leaf) ---
LEAFCOUNT LoudTag
ASSERT OK == 1
ASSERT LEAFCOUNT_N == 1
ASSERT LAST_N == 1

LEAFCOUNT TwinGreet
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT Solo
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT SoftTag
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT DeepLeaf
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT TagGreeter
ASSERT OK == 1
ASSERT LEAFCOUNT_N == 2

LEAFCOUNT Greeter
ASSERT OK == 1
ASSERT LEAFCOUNT_N >= 3
ASSERT LEAFCOUNT_N == 3

COUNTLEAVES Greeter
ASSERT LAST_N == 3

NLEAVES TagGreeter
ASSERT LEAFCOUNT_N == 2

# Cross-check with ISLEAF / DESCENDANTS
ISLEAF DeepLeaf
ASSERT LAST_N == 1
ISLEAF SoftTag
ASSERT LAST_N == 0
HASCHILDREN Greeter
ASSERT LAST_N == 1

DESCENDANTS Greeter
ASSERT DESCENDANTS_N >= 5

PRINT "MI2415_NTHPARENT_HEIGHTOF_LEAFCOUNT_PASS"
