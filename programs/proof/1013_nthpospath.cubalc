# NTHPOSPATH / POSNPATH — Nth non-flag positional as absolute path
# Usability: first input file without NTHPOS + SYS REALPATH glue.

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"

# empty + fallback → abs path of default
NTHPOSPATH 0 OR "Makefile"
ASSERT LAST_N == 1
ASSERT NTHPOSPATH_HIT == 0
ASSERT NTHPOSPATH_EXIST == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "Makefile"
ASSERT LAST_N == 1
SYS EQS NTHPOSPATH_RAW "Makefile"
ASSERT LAST_N == 1
ASSERT PATH_EXIST == 1

# empty no fallback
NTHPOSPATH 0
ASSERT LAST_N == 0
ASSERT OK == 0
ASSERT NTHPOSPATH_EXIST == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# flags + two existing files
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "Makefile"
SYS ENV SET CUBALC_ARG2 "include/cubalc_law.h"
SYS ENV SET CUBALC_ARGC "3"
NTHPOSPATH 0
ASSERT LAST_N == 1
ASSERT NTHPOSPATH_HIT == 1
ASSERT NTHPOSPATH_EXIST == 1
ASSERT NTHPOSPATH_N == 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "Makefile"
ASSERT LAST_N == 1
SYS EQS NTHPOSPATH_RAW "Makefile"
ASSERT LAST_N == 1

POSNPATH 1
ASSERT LAST_N == 1
ASSERT NTHPOSPATH_HIT == 1
ASSERT NTHPOSPATH_N == 1
SYS ENDS LAST "cubalc_law.h"
ASSERT LAST_N == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS EQS NTHPOSPATH_RAW "include/cubalc_law.h"
ASSERT LAST_N == 1

# out of range uses fallback abs
NTHPOSPATH 9 OR "docs/MEANINGFUL_ITER.md"
ASSERT NTHPOSPATH_HIT == 0
ASSERT LAST_N == 1
ASSERT NTHPOSPATH_EXIST == 1
SYS ENDS LAST "MEANINGFUL_ITER.md"
ASSERT LAST_N == 1

# missing path still absolute, EXIST=0
SYS ENV SET CUBALC_ARG0 "no/such/nthpospath_xyz.cubalc"
SYS ENV SET CUBALC_ARGC "1"
NTHPOSPATH 0
ASSERT NTHPOSPATH_HIT == 1
ASSERT NTHPOSPATH_EXIST == 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS HAS LAST "no/such/nthpospath_xyz.cubalc"
ASSERT LAST_N == 1
SYS EQS NTHPOSPATH_RAW "no/such/nthpospath_xyz.cubalc"
ASSERT LAST_N == 1

# pure positional
SYS ENV SET CUBALC_ARG0 "include"
SYS ENV SET CUBALC_ARGC "1"
PATHPOS 0
ASSERT NTHPOSPATH_EXIST == 1
SYS ENDS LAST "include"
ASSERT LAST_N == 1
SYS ISDIR LAST
ASSERT LAST_N == 1

PRINT "nthpospath ok"
