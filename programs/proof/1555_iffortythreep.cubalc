# IFFORTYTHREEP - plate exactly-forty-three key diagnostic branch
# Continues ladder after IFFORTYTWOP. Soft twin TRITETRACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET fortytwo = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42}"
LET fortythree = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43}"
LET fortyfour = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44}"
LET empty = "{}"

IFFORTYTHREEP fortythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFORTYTHREEP_N == 1
ASSERT FORTYTHREEP_N == 1
ASSERT IFFORTYTHREEP_LEN == 43
ASSERT IFTRITETRACONTAP_N == 1
ASSERT IFFORTYTHREEKEYP_N == 1

IFTRITETRACONTAP fortythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYTHREEKEYP fortythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYTHREEP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYTHREEP_N == 0
ASSERT IFFORTYTHREEP_LEN == 42

IFFORTYTHREEP fortyfour
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYTHREEP_LEN == 44

IFFORTYTHREEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFORTYTHREEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFORTYTHREEP fortythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTRITETRACONTAP fortythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFORTYTHREEKEYP fortythree
  LET q = 1
ELSE
  LET q = 0
END
