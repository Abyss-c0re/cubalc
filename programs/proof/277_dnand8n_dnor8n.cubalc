# Proof 277 — digit-5 dual-stack imm inverted 8-bit field: DNAND8N DNOR8N DXNOR8N
HOLD_FLASH 1
SCIENCE LOAD

# DNAND8N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNAND8N 0x0F 0
POP y
POP x
ASSERT x == 0x11223344556677F7
ASSERT y == 0x99AABBCCDDEEFFFF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNAND8N 0x0F 1
POP y
POP x
ASSERT x == 0x112233445566F888
ASSERT y == 0x99AABBCCDDEEF000

CLEARSTACK
PUSH -1
PUSH -1
DINVERTAND8N 0xFF 0
POP y
POP x
ASSERT x == -256
ASSERT y == -256

# DNOR8N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNOR8N 0xF0 0
POP y
POP x
ASSERT x == 0x1122334455667707
ASSERT y == 0x99AABBCCDDEEFF0F

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNOR8N 0xF0 2
POP y
POP x
ASSERT x == 0x1122334455097788
ASSERT y == 0x99AABBCCDD01FF00

CLEARSTACK
PUSH 0
PUSH 0
DINVERTOR8N 0xAB 3
POP y
POP x
ASSERT x == 0x54000000
ASSERT y == 0x54000000

# DXNOR8N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNOR8N 0x0F 0
POP y
POP x
ASSERT x == 0x1122334455667778
ASSERT y == 0x99AABBCCDDEEFFF0

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXNOR8N 0x0F 7
POP y
POP x
ASSERT x == 0xE122334455667788
ASSERT y == 0x69AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DEQUIV8N 0x00 0
POP y
POP x
ASSERT x == -256
ASSERT y == -256

CLEARSTACK
PUSH -1
PUSH -1
DXNOR8N 0xFF 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# soft fails
CLEARSTACK
DNAND8N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DNOR8N 1 0
ASSERT OK == 0
CLEARSTACK
DXNOR8N 1 0
ASSERT OK == 0

HOLD_FLASH 1
