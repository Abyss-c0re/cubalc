# Proof 382 — digit-7 imm 32-bit field TOC: SGET32TOCN SSET32TOCN SCLR32TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSET32TOCN: deposit lo32=1, hi32=2 → value = 2<<32 | 1
CELLSET 1 0
PUSH 1
SSET32TOCN 1 0
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
SSET32TOCN 2 1
# 2*2^32 + 1 = 8589934593
ASSERT LAST_N == 8589934593
ASSERT CELL(1) == 8589934593
POP

# SGET32TOCN extract word 1 → 2
CELLSET 2 8589934593
PUSH 2
SGET32TOCN 1
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# GET32TOCN alias: word 0 of 0x00000000DEADBEEF
# 0xDEADBEEF = 3735928559
CELLSET 3 3735928559
PUSH 3
GET32TOCN 0
ASSERT LAST_N == 3735928559
ASSERT CELL(3) == 3735928559
POP

# SCLR32TOCN clear word 0 of (2<<32|1) → 2<<32
CELLSET 4 8589934593
PUSH 4
SCLR32TOCN 0
ASSERT LAST_N == 8589934592
ASSERT CELL(4) == 8589934592
POP

# CLR32TOCN clear word 1 then extract is 0
CELLSET 5 8589934593
PUSH 5
CLR32TOCN 1
POP
PUSH 5
SGET32TOCN 1
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft empty OK=0
CLEARSTACK
SGET32TOCN 0
ASSERT OK == 0

PRINT "382_sget32tocn_sclr32tocn OK"
