# LENP / EMPTYP / NONEMPTYP / VALSP — multi-plate size/empty/value probes
# Usability: duals of SYS JSONLEN/JSONEMPTY/JSONVALUES without KEYSP bag glue.

HOLD_FLASH 1

LET PLATE = "{\"n\":1,\"host\":\"cubeA\",\"role\":\"worker\"}"
LET PEER = "{\"a\":9,\"b\":2}"
LET empty = "{}"

# key count on conventional PLATE
LENP
ASSERT OK == 1
ASSERT LAST_N == 3
ASSERT LENP_N == 3
ASSERT LENP_FROM == 0

# FROM PEER
LENP FROM PEER
ASSERT LENP_N == 2
ASSERT LENP_FROM == 1
SYS EQS LENP_SRC "PEER"
ASSERT LAST_N == 1

# empty plate
LENP FROM empty
ASSERT LENP_N == 0

# EMPTYP soft probe
EMPTYP FROM empty
ASSERT LAST_N == 1
ASSERT EMPTYP_N == 1
EMPTYP
ASSERT LAST_N == 0
EMPTYP FROM PEER
ASSERT LAST_N == 0

# NONEMPTYP / HASKEYSP
NONEMPTYP
ASSERT LAST_N == 1
NONEMPTYP FROM empty
ASSERT LAST_N == 0
HASKEYSP FROM PEER
ASSERT LAST_N == 1

# VALSP twin of KEYSP
VALSP
ASSERT OK == 1
ASSERT VALSP_N == 3
ASSERT VALSP_FROM == 0
SYS HASLINE LAST "1"
ASSERT LAST_N == 1
SYS HASLINE VALSP "cubeA"
ASSERT LAST_N == 1
SYS HASLINE VALSP "worker"
ASSERT LAST_N == 1

VALSP FROM PEER
ASSERT VALSP_N == 2
ASSERT VALSP_FROM == 1
SYS HASLINE LAST "9"
ASSERT LAST_N == 1
SYS HASLINE VALSP "2"
ASSERT LAST_N == 1

VALSP FROM empty
ASSERT VALSP_N == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# aliases
NKEYSP FROM PEER
ASSERT LENP_N == 2
VALUEP FROM PEER
ASSERT VALSP_N == 2

# count matches KEYSP
KEYSP FROM PEER
ASSERT KEYSP_N == 2
LENP FROM PEER
ASSERT LENP_N == 2

PRINT "lenp soft ok"
