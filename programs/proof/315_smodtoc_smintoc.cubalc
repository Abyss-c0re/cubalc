# Proof 315 — digit-1 stack↔cell: SMODTOC SMINTOC SMAXTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SMODTOC
CELLSET 1 17
PUSH 1
PUSH 5
SMODTOC
ASSERT LAST_N == 2
ASSERT CELL(1) == 2
POP a
ASSERT a == 2

# SMODTOC by zero → 0
CELLSET 2 9
PUSH 2
PUSH 0
SCELLMOD
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SMINTOC
CELLSET 3 10
PUSH 3
PUSH 4
SMINTOC
ASSERT LAST_N == 4
ASSERT CELL(3) == 4
POP
CELLSET 3 2
PUSH 3
PUSH 8
SCELLMIN
ASSERT LAST_N == 2
ASSERT CELL(3) == 2
POP

# SMAXTOC
CELLSET 4 3
PUSH 4
PUSH 9
SMAXTOC
ASSERT LAST_N == 9
ASSERT CELL(4) == 9
POP
CELLSET 4 12
PUSH 4
PUSH 5
SCELLMAX
ASSERT LAST_N == 12
ASSERT CELL(4) == 12
POP

# aliases SMODCELL SMINCELL SMAXCELL
CLEARCELLS
CELLSET 0 25
PUSH 0
PUSH 7
SMODCELL
POP
ASSERT CELL(0) == 4
CELLSET 0 4
PUSH 0
PUSH 6
SMINCELL
POP
ASSERT CELL(0) == 4
PUSH 0
PUSH 11
SMAXCELL
POP
ASSERT CELL(0) == 11

# soft fails
CLEARSTACK
SMODTOC
ASSERT OK == 0
SMINTOC
ASSERT OK == 0
SMAXTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof315_smodtoc_smintoc" LAST_N SP
HOLD_FLASH 1
