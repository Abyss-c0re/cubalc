# LIBDEFAULTS / LIBKNOBS — DEFAULT knobs from a lib recipe

LIBDEFAULTS plate_tick
ASSERT OK == 1
ASSERT LAST_N == 4
ASSERT LIB_STEM == "plate_tick"
ASSERT LIB_PATH != ""
SYS HASLINE LAST "PLATE_PATH=state/agent_plate.json"
ASSERT LAST_N == 1
LIBDEFAULTS plate_tick
SYS HASLINE LAST "PLATE_TICK_KEY=n"
ASSERT LAST_N == 1
LIBDEFAULTS plate_tick
SYS HAS LAST "PLATE_SEED="
ASSERT LAST_N == 1

LIBKNOBS time_guard
ASSERT OK == 1
ASSERT LAST_N == 2
SYS HASLINE LAST "NEED_TIME=100"
ASSERT LAST_N == 1
LIBKNOBS time_guard
SYS HASLINE LAST "TIME_GUARD_SOFT=0"
ASSERT LAST_N == 1

# fat_session knobs
LIBDEFAULTS fat_session
ASSERT OK == 1
ASSERT LAST_N >= 1
SYS HASLINE LAST "NEED_VARROOM=48"
ASSERT LAST_N == 1

# leaf without DEFAULT body lines
LIBDEFAULTS agent_boot
ASSERT OK == 1
ASSERT LAST_N == 0

# soft miss
LIBDEFAULTS no_such_lib_xyz_zzz
ASSERT OK == 0
ASSERT LAST_N == 0
CLEAR_ERR

PASS
PRINT "1295_libdefaults: PASS"
