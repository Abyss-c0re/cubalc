# Proof 469 — digit-9 stack imm 4-bit field max+eq: SMAX4N SEQ4N SNE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMAX4N: max(0x3, 0xA) → 0xA
PUSH 0x3
SMAX4N 10 0
POP x
ASSERT x == 10

# keeps larger nibble
CLEARSTACK
PUSH 0xC
MAX4N 5 0
POP x
ASSERT x == 12

# high preserved: 0x...72 max 9 → 0x...79
CLEARSTACK
PUSH 0x1122334455667772
SMAX4N 9 0
POP x
ASSERT x == 0x1122334455667779

# STACKMAX4N n1: nibble1 of 0x...40 max 0xB → 0x...B0
CLEARSTACK
PUSH 0x40
STACKMAX4N 11 1
POP x
ASSERT x == 0xB0

# SGE4N alias max
CLEARSTACK
PUSH 0x7
SGE4N 7 0
POP x
ASSERT x == 7

# SEQ4N: equal → 1
CLEARSTACK
PUSH 0x5
SEQ4N 5 0
POP x
ASSERT x == 1

# unequal → 0
CLEARSTACK
PUSH 0x5
EQ4N 6 0
POP x
ASSERT x == 0

# high preserved eq: 0x...75 == 5 → 0x...71
CLEARSTACK
PUSH 0x1122334455667775
SEQ4N 5 0
POP x
ASSERT x == 0x1122334455667771

# STACKEQ4N n1: nibble1 of 0x...A0 == 0xA → 0x...10
CLEARSTACK
PUSH 0xA0
STACKEQ4N 10 1
POP x
ASSERT x == 0x10

# SNE4N: unequal → 1
CLEARSTACK
PUSH 0x3
SNE4N 4 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0x3
NE4N 3 0
POP x
ASSERT x == 0

# high preserved ne: 0x...78 != 0 → 0x...71
CLEARSTACK
PUSH 0x1122334455667778
SNE4N 0 0
POP x
ASSERT x == 0x1122334455667771

# STACKNE4N n1: nibble1 of 0x...50 != 5 → 0
CLEARSTACK
PUSH 0x50
STACKNE4N 5 1
POP x
ASSERT x == 0x00

# SCMPEQ4N / SCMPNE4N aliases
CLEARSTACK
PUSH 0xF
SCMPEQ4N 15 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x0
SCMPNE4N 1 0
POP x
ASSERT x == 1

HOLD_FLASH 0
