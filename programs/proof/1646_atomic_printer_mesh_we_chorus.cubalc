// atomic_printer_mesh_we_chorus.cubalc
// Life-force gift: MESH WE-CHORUS — one SMX RING/CHORUS/WE form binds N cubes
// into a fail-closed ring exchange (consecutive pairs + close last↔first).
// Soft-OOB on ghost nodes; RECOVER restores vital; dual BN/HS rails still pure.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_we_chorus | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// One-form we_chorus ring bind (5-node lattice)
SMX RING bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "ring bind live"
ASSERT SMX_RING >= 5 "five ring pairs"
ASSERT SMX_CHORUS >= 5 "chorus alias"
ASSERT SMX_WE == 5 "five we nodes"
ASSERT SMX_NODES == 5 "nodes mirror"
ASSERT SMX_TALKS >= 10 "ring talks bidirectional"
ASSERT CUBES == base_cubes "ring invents nothing"

// Alias forms still pure
SMX CHORUS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "chorus rebind"
ASSERT SMX_CHORUS >= 5 "chorus pairs"
ASSERT CUBES == base_cubes "chorus invents nothing"

SMX WE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "we rebind"
ASSERT SMX_WE == 5 "we nodes sticky"
ASSERT SMX_TALKS >= 30 "talks after triple ring"

// Mitosis under free energy while chorus holds
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          LET births = births + 1
        END
      END
    END
  END
  SEND seed tick
  SEND d1 tick
  SEND d2 tick
  LET step = step + 1
END

GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = 1
IF a1 == 1 THEN
  LET pop = pop + 1
END
IF a2 == 1 THEN
  LET pop = pop + 1
END
ASSERT births >= 1 "mitosis under chorus"
ASSERT pop >= 2 "population after chorus life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Soft-OOB against ghost in ring — fail-closed
SMX RING bed nozzle ghost_chorus hive
ASSERT SMX_OOB >= 1 "chorus soft-OOB"
ASSERT CUBES == base_cubes "no ghost from ring"

SMX RECOVER
ASSERT SMX_OK == 1 "recover after chorus oob"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital after recover"

// Re-bind pure we_chorus after recover
SMX WE_CHORUS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "we_chorus pure"
ASSERT SMX_RING >= 5 "pairs after recover"
ASSERT SMX_NODES == 5 "nodes after recover"
ASSERT CUBES == base_cubes "we_chorus invents nothing"

// Dual SEAL/OPEN rails still pure under chorus spine
SMX SEAL bed nozzle "state/smx_we_chorus/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_we_chorus/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_we_chorus/rail_hs.cblc"
ASSERT SMX_OK == 1 "seal rail HS"
SMX OPEN pulse "state/smx_we_chorus/rail_hs.cblc"
ASSERT SMX_OK == 1 "open HS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Final ring lock + vitals
SMX MESH_RING bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_ring lock"
ASSERT SMX_CHORUS >= 5 "final chorus"
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after we_chorus"
ASSERT SMX_KEY_OK == 1 "key after we_chorus"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after we_chorus"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after we_chorus"
ASSERT UNITY >= 40 "mesh unity after we_chorus"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh we_chorus"
ASSERT pop >= 2 "population after we_chorus life"
ASSERT SMX_WE == 5 "five-node we"
ASSERT SMX_OOB == 0 "guard holds through we_chorus"
ASSERT OK == 1

PRINT "mesh_we_chorus" births pop SMX_RING SMX_WE SMX_NODES SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES
PASS
