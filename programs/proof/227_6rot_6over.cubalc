# Proof 227 — digit-8 depth-6 rotate/over: 6ROT 6RROT 6OVER
HOLD_FLASH 1
SCIENCE LOAD

# 6ROT: a b c d e f → b c d e f a
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6ROT
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 2
ASSERT b == 3
ASSERT c == 4
ASSERT d == 5
ASSERT e == 6
ASSERT f == 1

# ROT6 alias
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
PUSH 50
PUSH 60
ROT6
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 20
ASSERT b == 30
ASSERT c == 40
ASSERT d == 50
ASSERT e == 60
ASSERT f == 10

