PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
6RROT
POP f
POP e
POP d
POP c
POP b
POP a
ASSERT a == 6
ASSERT b == 1
ASSERT c == 2
ASSERT d == 3
ASSERT e == 4
ASSERT f == 5

