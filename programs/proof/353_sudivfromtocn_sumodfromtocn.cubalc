# Proof 353 — digit-9 reverse unsigned imm TOC: SUDIVFROMTOCN SUMODFROMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SUDIVFROMTOCN: (u)20 / (u)4 → 5
CELLSET 1 4
PUSH 1
SUDIVFROMTOCN 20
ASSERT LAST_N == 5
ASSERT CELL(1) == 5
POP a
ASSERT a == 5

# RUDIVTOCN cell0 soft → 0
CELLSET 2 0
PUSH 2
RUDIVTOCN 99
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SUDIVFROMATN: high unsigned  (-1 as u-max) / 2
# u-max / 2 = 9223372036854775807
CELLSET 3 2
PUSH 3
SUDIVFROMATN (-1)
ASSERT LAST_N == 9223372036854775807
ASSERT CELL(3) == 9223372036854775807
POP

# SUMODFROMTOCN: (u)17 % (u)5 → 2
CELLSET 4 5
PUSH 4
SUMODFROMTOCN 17
ASSERT LAST_N == 2
ASSERT CELL(4) == 2
POP

# RUMODTOCN cell0 soft → 0
CELLSET 5 0
PUSH 5
RUMODTOCN 11
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SUMODFROMATN exact
CELLSET 6 5
PUSH 6
SUMODFROMATN 15
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# unsigned vs signed: -1 as divisor of 5 → 5 / u-max = 0
CELLSET 7 (-1)
PUSH 7
SUDIVFROMTOCN 5
ASSERT LAST_N == 0
ASSERT CELL(7) == 0
POP

# soft fails empty stack
CLEARSTACK
SUDIVFROMTOCN 1
ASSERT OK == 0
SUMODFROMTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof353_sudivfromtocn_sumodfromtocn" LAST_N SP
HOLD_FLASH 1
