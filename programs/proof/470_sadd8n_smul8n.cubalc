# Proof 470 — digit-0 stack imm 8-bit field arith merge: SADD8N SSUB8N SMUL8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SADD8N: 0x10 + 0x20 → 0x30
PUSH 0x10
SADD8N 0x20 0
POP x
ASSERT x == 0x30

# wrap: 0xFF + 2 → 0x01
CLEARSTACK
PUSH 0xFF
ADD8N 2 0
POP x
ASSERT x == 1

# high bytes preserved: 0x1122334455667700 + 0x11 → 0x...7711
CLEARSTACK
PUSH 0x1122334455667700
SADD8N 0x11 0
POP x
ASSERT x == 0x1122334455667711

# STACKADD8N n1: byte1 of 0x...0200 + 0x30 → 0x...3200
CLEARSTACK
PUSH 0x0200
STACKADD8N 0x30 1
POP x
ASSERT x == 0x3200

# SSUB8N: 0x50 - 0x20 → 0x30
CLEARSTACK
PUSH 0x50
SSUB8N 0x20 0
POP x
ASSERT x == 0x30

# wrap borrow: 0x01 - 0x02 → 0xFF
CLEARSTACK
PUSH 0x01
SUB8N 2 0
POP x
ASSERT x == 255

# STACKSUB8N n1: byte1 of 0x...5000 - 0x10 → 0x...4000
CLEARSTACK
PUSH 0x5000
STACKSUB8N 0x10 1
POP x
ASSERT x == 0x4000

# SMUL8N: 0x0C * 0x0A → 0x78
CLEARSTACK
PUSH 0x0C
SMUL8N 10 0
POP x
ASSERT x == 0x78

# wrap mul: 0x10 * 0x10 → 0x100 & 0xFF = 0
CLEARSTACK
PUSH 0x10
MUL8N 0x10 0
POP x
ASSERT x == 0

# zero annihilator
CLEARSTACK
PUSH 0xAB
SMUL8N 0 0
POP x
ASSERT x == 0

# high preserved mul: 0x...7703 * 5 → 0x...770F
CLEARSTACK
PUSH 0x1122334455667703
SMUL8N 5 0
POP x
ASSERT x == 0x112233445566770F

# STACKMUL8N n1: byte1 of 0x...0400 * 3 → 0x...0C00
CLEARSTACK
PUSH 0x0400
STACKMUL8N 3 1
POP x
ASSERT x == 0x0C00

# SINC8N / SDEC8N aliases
CLEARSTACK
PUSH 0xFE
SINC8N 1 0
POP x
ASSERT x == 255

CLEARSTACK
PUSH 0x00
SDEC8N 1 0
POP x
ASSERT x == 255

# round-trip add then sub
CLEARSTACK
PUSH 0xA5
SADD8N 0x11 0
SSUB8N 0x11 0
POP x
ASSERT x == 0xA5

HOLD_FLASH 0
