# Proof 167 — digit-6 dual-stack: DSATDIV DRANDBITS
HOLD_FLASH 1
SCIENCE LOAD

# DSATDIV — normal
CLEARSTACK
PUSH 20
PUSH 15
PUSH 4
PUSH 3
DSATDIV
POP y
POP x
ASSERT x == 5
ASSERT y == 5

# DSATDIV — /0 → 0
CLEARSTACK
PUSH 10
PUSH 7
PUSH 0
PUSH 2
2SATDIV
POP y
POP x
ASSERT x == 0
ASSERT y == 3

# DSATDIV — LONG_MIN / -1 → LONG_MAX
CLEARSTACK
PUSH -9223372036854775808
PUSH 100
PUSH -1
PUSH 4
PAIRSATDIV
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 25

# DSATDIV — negative trunc toward zero
CLEARSTACK
PUSH -20
PUSH -15
PUSH 3
PUSH 4
DSATDIV
POP y
POP x
ASSERT x == -6
ASSERT y == -3

# DRANDBITS — width 0 → 0
SEED 1
CLEARSTACK
PUSH 0
PUSH 0
DRANDBITS
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DRANDBITS — n-bit range
SEED 42
CLEARSTACK
PUSH 4
PUSH 3
2RANDBITS
POP y
POP x
ASSERT x >= 0
ASSERT x < 16
ASSERT y >= 0
ASSERT y < 8

SEED 7
CLEARSTACK
PUSH 1
PUSH 8
PAIRRANDBITS
POP y
POP x
ASSERT x >= 0
ASSERT x < 2
ASSERT y >= 0
ASSERT y < 256

# soft fails
CLEARSTACK
DSATDIV
ASSERT OK == 0
CLEARSTACK
DRANDBITS
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2SATDIV
ASSERT OK == 0
CLEARSTACK
PUSH 1
2RANDBITS
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof167_dsatdiv_drandbits" LAST_N SP
