// 2047_life_cell_boost.cubalc
// Proof: life_cell boost — PCr → energy (phosphagen mitosis shortcut).
// Bypasses ATP; yield conserved. Arms ready past threshold. Distinct from
// discharge (pcr→atp) and oxidize (atp→energy). Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY seed OF Cell 1 12 0
ENTITY ally OF Cell 1 8 0
ENTITY dead OF Cell 0 0 0
ENTITY quiet OF Cell 1 6 0

// Baseline spark
GETF seed energy
ASSERT LAST_N == 12 "spark 12"
SEND seed charged
ASSERT LAST_N == 0 "atp empty"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr empty"
SEND seed yield
ASSERT LAST_N == 12 "yield 12"

// Charge ATP, load phosphagen, boost into active energy
SEND seed charge 6
ASSERT LAST_N == 6 "charge 6"
GETF seed energy
ASSERT LAST_N == 6 "active 6"
SEND seed charged
ASSERT LAST_N == 6 "atp 6"

SEND seed charge_pcr 4
ASSERT LAST_N == 4 "charge_pcr 4"
SEND seed charged
ASSERT LAST_N == 2 "atp 2"
SEND seed phosphagen
ASSERT LAST_N == 4 "pcr 4"
SEND seed yield
ASSERT LAST_N == 12 "yield with pcr"

SEND seed boost 3
ASSERT LAST_N == 3 "boost 3"
SEND seed phosphagen
ASSERT LAST_N == 1 "pcr 1"
GETF seed energy
ASSERT LAST_N == 9 "active 9"
SEND seed charged
ASSERT LAST_N == 2 "atp untouched"
SEND seed yield
ASSERT LAST_N == 12 "yield conserved boost"

// Drain remaining buffer → energy crosses thr
SEND seed boost 9
ASSERT LAST_N == 1 "boost drains 1"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr empty"
GETF seed energy
ASSERT LAST_N == 10 "active 10"
GETF seed ready
ASSERT LAST_N == 1 "ready at thr"
SEND seed yield
ASSERT LAST_N == 12 "yield 10e+2atp"

// Empty buffer boost is noop
SEND seed boost 2
ASSERT LAST_N == 0 "empty boost 0"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr still 0"

// Dead / zero / neg
SEND dead boost 3
ASSERT LAST_N == 0 "dead boost 0"
SEND dead phosphagen
ASSERT LAST_N == 0 "dead pcr 0"
SEND seed boost 0
ASSERT LAST_N == 0 "zero boost"
SEND seed boost -4
ASSERT LAST_N == 0 "neg boost"

// Isolation: boost leaves ATP/pmf/heat alone
// seed: e=10 atp=2 pcr=0 heat=0 pmf=0
SEND seed charge 4
ASSERT LAST_N == 4 "charge 4"
// e=6 atp=6
SEND seed pump 2
ASSERT LAST_N == 2 "pump 2"
// e=4 atp=6 pmf=2
SEND seed charge_pcr 3
ASSERT LAST_N == 3 "pcr load 3"
// e=4 atp=3 pmf=2 pcr=3
SEND seed charged
ASSERT LAST_N == 3 "atp after pcr"
SEND seed gradient
ASSERT LAST_N == 2 "pmf 2"
SEND seed warmth
ASSERT LAST_N == 0 "warmth empty"
SEND seed boost 2
ASSERT LAST_N == 2 "boost 2"
// e=6 atp=3 pmf=2 pcr=1
SEND seed charged
ASSERT LAST_N == 3 "atp held"
SEND seed gradient
ASSERT LAST_N == 2 "pmf held"
SEND seed warmth
ASSERT LAST_N == 0 "heat untouched"
SEND seed phosphagen
ASSERT LAST_N == 1 "pcr left 1"
GETF seed energy
ASSERT LAST_N == 6 "energy +2 from boost"
SEND seed yield
ASSERT LAST_N == 12 "yield held 6e+3a+2p+1c"

// Quiescent: boost still moves PCr→energy but ready stays 0
SEND quiet photophos 5
ASSERT LAST_N == 5 "quiet solar"
// quiet: e=6 atp=5 (photophos mints ATP)
SEND quiet charge_pcr 4
ASSERT LAST_N == 4 "quiet charge_pcr"
SEND quiet quiesce
ASSERT LAST_N == 1 "quiet G0"
SEND quiet boost 3
ASSERT LAST_N == 3 "quiet boost"
SEND quiet phosphagen
ASSERT LAST_N == 1 "quiet pcr 1"
GETF quiet energy
ASSERT LAST_N == 9 "quiet active 9"
GETF quiet ready
ASSERT LAST_N == 0 "quiet not ready"

// Ally: boost raises energy from phosphagen store toward mitosis
SEND ally charge 4
ASSERT LAST_N == 4 "ally charge"
// ally e=4 atp=4
SEND ally charge_pcr 4
ASSERT LAST_N == 4 "ally pcr"
GETF ally energy
ASSERT LAST_N == 4 "ally active 4"
GETF ally ready
ASSERT LAST_N == 0 "ally not ready"
SEND ally boost 4
ASSERT LAST_N == 4 "ally boost 4"
GETF ally energy
ASSERT LAST_N == 8 "ally active 8"
GETF ally ready
ASSERT LAST_N == 0 "ally still below thr"
SEND ally feed 2
ASSERT LAST_N == 10 "ally fed 10"
GETF ally ready
ASSERT LAST_N == 1 "ally ready"

// Distinct from discharge: discharge raises ATP, boost does not
// seed currently e=6 atp=3 pmf=2 pcr=1
SEND seed discharge 1
ASSERT LAST_N == 1 "discharge 1"
SEND seed charged
ASSERT LAST_N == 4 "discharge raised atp"
SEND seed charge_pcr 1
ASSERT LAST_N == 1 "reload 1 pcr"
SEND seed charged
ASSERT LAST_N == 3 "atp after reload"
SEND seed boost 1
ASSERT LAST_N == 1 "boost spends pcr"
SEND seed charged
ASSERT LAST_N == 3 "atp unchanged by boost"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr spent by boost"
