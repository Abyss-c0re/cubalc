# Proof 487 — digit-0 dual-stack imm 4-bit field metrics: DBITREV4N DPOPCNT4N DPARITY4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DBITREV4N: 1→8 ; 3→C
PUSH 0x1
PUSH 0x3
DBITREV4N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 12

# 5→A ; 0→0
CLEARSTACK
PUSH 0x5
PUSH 0x0
PAIRBITREV4N 0
POP y
POP x
ASSERT x == 10
ASSERT y == 0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
PUSH 0x99AABBCCDDEEFF05
DBITREV4N 0
DBITREV4N 0
POP y
POP x
ASSERT x == 0x112233445566778A
ASSERT y == 0x99AABBCCDDEEFF05

# S2BITREV4N n1: nibble1 of 0x..31 is 3→C → 0x..C1; 0x..15 n1=1→8 → 0x..85
CLEARSTACK
PUSH 0x31
PUSH 0x15
S2BITREV4N 1
POP y
POP x
ASSERT x == 0xC1
ASSERT y == 0x85

# DBREV4N alias
CLEARSTACK
PUSH 0x1
PUSH 0x1
DBREV4N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 8

# DPOPCNT4N: 0→0 ; F→4
CLEARSTACK
PUSH 0x0
PUSH 0xF
DPOPCNT4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 4

# high preserved: 0x...55 → pop 2
CLEARSTACK
PUSH 0x1122334455667755
PUSH 0x99AABBCCDDEEFF07
PAIRPOPCNT4N 0
POP y
POP x
ASSERT x == 0x1122334455667752
ASSERT y == 0x99AABBCCDDEEFF03

# STACK2POPCNT4N n1: 0x..F0 n1=F→4 → 0x..40
CLEARSTACK
PUSH 0xF0
PUSH 0x70
STACK2POPCNT4N 1
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0x30

# DPCNT4N alias
CLEARSTACK
PUSH 0xA
PUSH 0x3
DPCNT4N 0
POP y
POP x
ASSERT x == 2
ASSERT y == 2

# DPARITY4N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DPARITY4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x3
PUSH 0x7
PAIRPARITY4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# high preserved parity n1: 0x90 n1=9=1001→0; 0xA0 n1=A=1010→0; 0xB0 n1=B=1011→1
CLEARSTACK
PUSH 0x90
PUSH 0xB0
S2PARITY4N 1
POP y
POP x
ASSERT x == 0x00
ASSERT y == 0x10

# DXORRED4N alias
CLEARSTACK
PUSH 0xF
PUSH 0xE
DXORRED4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

HOLD_FLASH 0
