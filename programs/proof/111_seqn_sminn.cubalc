# Proof 111 — digit-1 stack immediate compare + min/max-with-constant
HOLD_FLASH 1
SCIENCE LOAD

# SEQN
CLEARSTACK
PUSH 7
SEQN 7
ASSERT LAST_N == 1
CLEARSTACK
PUSH 7
EQN 3
ASSERT LAST_N == 0

# SNEN
CLEARSTACK
PUSH 7
SNEN 3
ASSERT LAST_N == 1
CLEARSTACK
PUSH 7
NEN 7
ASSERT LAST_N == 0

# SLTN / SGTN
CLEARSTACK
PUSH 5
SLTN 10
ASSERT LAST_N == 1
CLEARSTACK
PUSH 5
LTN 5
ASSERT LAST_N == 0
CLEARSTACK
PUSH 9
SGTN 3
ASSERT LAST_N == 1
CLEARSTACK
PUSH 2
GTN 2
ASSERT LAST_N == 0

# SLENN / SGENN
CLEARSTACK
PUSH 5
SLENN 5
ASSERT LAST_N == 1
CLEARSTACK
PUSH 6
SLEQN 5
ASSERT LAST_N == 0
CLEARSTACK
PUSH 5
SGENN 5
ASSERT LAST_N == 1
CLEARSTACK
PUSH 4
SGEQN 5
ASSERT LAST_N == 0

# SMINN / SMAXN
CLEARSTACK
PUSH 10
SMINN 3
ASSERT LAST_N == 3
CLEARSTACK
PUSH 2
MINN 8
ASSERT LAST_N == 2
CLEARSTACK
PUSH 3
SMAXN 9
ASSERT LAST_N == 9
CLEARSTACK
PUSH 12
MAXN 4
ASSERT LAST_N == 12

# chain with SADDN
CLEARSTACK
PUSH 4
SADDN 1
SEQN 5
ASSERT LAST_N == 1
CLEARSTACK
PUSH 100
SMINN 50
SMAXN 10
ASSERT LAST_N == 50

# soft fail empty
CLEARSTACK
SEQN 1
ASSERT OK == 0
SNEN 1
ASSERT OK == 0
SLTN 1
ASSERT OK == 0
SGTN 1
ASSERT OK == 0
SLENN 1
ASSERT OK == 0
SGENN 1
ASSERT OK == 0
SMINN 1
ASSERT OK == 0
SMAXN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof111_seqn_sminn" LAST_N SP
