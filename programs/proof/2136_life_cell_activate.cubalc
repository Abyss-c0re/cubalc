// 2136_life_cell_activate.cubalc
// Proof 2136: life_cell activate - post-recruit LE lumen zymogen activation.
// Pay min(n,atp,energy,reserve) -> heat+n energy-n reserve-n thr-n; age/pmf/sp/pcr held.
// Continuum after recruit. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 40 0
ENTITY poor OF Cell 1 0 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 24 0
ENTITY twin OF Cell 1 30 0
ENTITY ceil OF Cell 1 28 0
ENTITY starved OF Cell 1 36 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND ceil set_threshold 10
SEND starved set_threshold 10
SEND gate pulse 6
SEND gate photosynth 40
SEND gate glycolyse 36
SEND gate pump 28
SEND gate photophos 28
SEND gate photosynth 36
SEND gate glycolyse 30
SEND gate pump 20
SEND gate charge 40
SEND gate feed 40
GETF gate age
ASSERT LAST_N == 6 "af a6"
GETF gate atp
ASSERT LAST_N >= 20 "af atp"
GETF gate heat
LET hbase = LAST_N
GETF gate energy
LET ebase = LAST_N
GETF gate reserve
LET rbase = LAST_N
GETF gate pmf
LET pbase = LAST_N
ASSERT pbase >= 5 "af pmf base"
GETF gate threshold
ASSERT LAST_N == 10 "af thr10"
GETF gate setpoint
ASSERT LAST_N == 10 "af sp10"
GETF gate pcr
ASSERT LAST_N == 0 "af pcr0"

SEND gate converge 3
ASSERT LAST_N == 3 "af prece3"
SEND gate extend 1
ASSERT LAST_N == 1 "af prext1"
SEND gate fold 1
ASSERT LAST_N == 1 "af prefd1"
SEND gate zip 1
ASSERT LAST_N == 1 "af prez1"
SEND gate crest 1
ASSERT LAST_N == 1 "af prec1"
