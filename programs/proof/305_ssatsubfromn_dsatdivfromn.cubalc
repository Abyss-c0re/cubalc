# Proof 305 — digit-6 reverse imm sat: SSATSUBFROMN SSATDIVFROMN DSATSUBFROMN DSATDIVFROMN
HOLD_FLASH 1
SCIENCE LOAD

# SSATSUBFROMN n — TOS = sat(n - TOS)
CLEARSTACK
PUSH 3
SSATSUBFROMN 10
POP x
ASSERT x == 7

CLEARSTACK
PUSH 10
SSRSUBN 3
POP x
ASSERT x == -7

CLEARSTACK
PUSH -5
SATSUBFROMN 0
POP x
ASSERT x == 5

# SSATSUBFROMN — saturate down (n - large_pos underflows)
CLEARSTACK
PUSH 9223372036854775807
SSATSUBFROMN -9223372036854775807
POP x
ASSERT x < -9223372036854775807

# SSATSUBFROMN — saturate up (n - large_neg overflows)
CLEARSTACK
PUSH -9223372036854775807
SSATSUBFROMN 9223372036854775807
POP x
ASSERT x == 9223372036854775807

# SSATDIVFROMN n — TOS = sat(n / TOS)
CLEARSTACK
PUSH 5
SSATDIVFROMN 20
POP x
ASSERT x == 4

CLEARSTACK
PUSH 3
SSRDIVN 10
POP x
ASSERT x == 3

CLEARSTACK
PUSH -2
SATDIVFROMN 10
POP x
ASSERT x == -5

# /0 soft → 0
CLEARSTACK
PUSH 0
SSATDIVFROMN 99
POP x
ASSERT x == 0

# finite reverse div of LONG_MAX
CLEARSTACK
PUSH -1
SSATDIVFROMN 9223372036854775807
POP x
ASSERT x == -9223372036854775807

# soft fails
CLEARSTACK
SSATSUBFROMN 1
ASSERT OK == 0
CLEARSTACK
SSATDIVFROMN 1
ASSERT OK == 0

# DSATSUBFROMN n — a b → sat(n-a) sat(n-b)
CLEARSTACK
PUSH 3
PUSH 7
DSATSUBFROMN 10
POP y
POP x
ASSERT x == 7
ASSERT y == 3

CLEARSTACK
PUSH 10
PUSH 0
PAIRSATSUBFROMN 3
POP y
POP x
ASSERT x == -7
ASSERT y == 3

# dual saturate up: n=LONG_MAX, a=b=-1 → LONG_MAX (overflow)
CLEARSTACK
PUSH -1
PUSH -1
DSATSUBFROMN 9223372036854775807
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 9223372036854775807

# DSATDIVFROMN n — a b → sat(n/a) sat(n/b)
CLEARSTACK
PUSH 5
PUSH 4
DSATDIVFROMN 20
POP y
POP x
ASSERT x == 4
ASSERT y == 5

CLEARSTACK
PUSH 3
PUSH -2
PAIRSATDIVFROMN 10
POP y
POP x
ASSERT x == 3
ASSERT y == -5

# dual soft zero lanes
CLEARSTACK
PUSH 0
PUSH 5
DSATDIVFROMN 100
POP y
POP x
ASSERT x == 0
ASSERT y == 20

# dual soft fail
CLEARSTACK
DSATSUBFROMN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSATDIVFROMN 1
ASSERT OK == 0

HOLD_FLASH 1
