# Proof 182 — digit-6 dual-stack energy: DSCALE DCLIP100
HOLD_FLASH 1
SCIENCE LOAD

# DSCALE: a b sa sb → a*sa/100 b*sb/100
CLEARSTACK
PUSH 50
PUSH 80
PUSH 50
PUSH 25
DSCALE
POP y
POP x
ASSERT x == 25
ASSERT y == 20

# 2SCALE identity 100
CLEARSTACK
PUSH 7
PUSH 9
PUSH 100
PUSH 100
2SCALE
POP y
POP x
ASSERT x == 7
ASSERT y == 9

# DSCL double
CLEARSTACK
PUSH 10
PUSH 15
PUSH 200
PUSH 200
DSCL
POP y
POP x
ASSERT x == 20
ASSERT y == 30

# DCLIP100
CLEARSTACK
PUSH -5
PUSH 150
DCLIP100
POP y
POP x
ASSERT x == 0
ASSERT y == 100

# in-range unchanged
CLEARSTACK
PUSH 0
PUSH 100
2CLIP100
POP y
POP x
ASSERT x == 0
ASSERT y == 100

CLEARSTACK
PUSH 42
PUSH 99
DENCLIP
POP y
POP x
ASSERT x == 42
ASSERT y == 99

# DCLIPPCT alias
CLEARSTACK
PUSH -1
PUSH 101
DCLIPPCT
POP y
POP x
ASSERT x == 0
ASSERT y == 100

# soft fail underflow
CLEARSTACK
PUSH 1
DSCALE
ASSERT OK == 0
CLEARSTACK
PUSH 1
# need two for clip — one fails
CLEARSTACK
# empty
DCLIP100
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof182_dscale_dclip100" LAST_N SP
