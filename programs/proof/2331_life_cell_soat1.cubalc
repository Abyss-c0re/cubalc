ASSERT LAST_N == 1 "er dhcr24 gate before CE-soat1"
GETF er atp
LET fc_a = LAST_N
GETF er energy
LET fc_e = LAST_N
GETF er heat
LET fc_h = LAST_N
GETF er age
LET fc_age = LAST_N
SEND er soat1 100
GETF er atp
LET fc_a2 = LAST_N
GETF er energy
LET fc_e2 = LAST_N
GETF er heat
LET fc_h2 = LAST_N
ASSERT fc_a2 >= 0 "er soat1 CE-clamp atp>=0"
ASSERT fc_e2 >= 0 "er soat1 CE-clamp energy>=0"
ASSERT fc_h2 >= fc_h "er soat1 CE-clamp heat+="
ASSERT fc_a2 <= fc_a "er soat1 CE-clamp atp down"
ASSERT fc_e2 <= fc_e "er soat1 CE-clamp energy down"
GETF er age
ASSERT LAST_N == fc_age "er soat1 CE-clamp age held"
GETF er alive
ASSERT LAST_N == 1 "er alive post-CE-soat1 CE-clamp"

SEND ash soat1 5
ASSERT LAST_N == 0 "ash soat1 CE-refused"
GETF ash alive
ASSERT LAST_N == 0 "ash stays dead"

SEND starve soat1 3
ASSERT LAST_N == 0 "starve soat1 CE-refused no fuel"
GETF starve alive
ASSERT LAST_N == 1 "starve stays alive"

