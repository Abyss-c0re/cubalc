// atomic_printer_mesh_crystal.cubalc
// Life-force gift: MESH-CRYSTAL — complete facets + directed prism ring + hub nucleus root after soft-OOB storms.
// SMX CRYSTAL|GEODE|PRISM|FACET|NUCLEUS|QUARTZ|NUCLEUS|MESH_CRYSTAL|RAISE_CRYSTAL clears thrash, every live pair exchanges
// both ways (C(n,2)), then prism ring settles so lattice raises a crystal; latches SMX_CRYSTALLED|SMX_PRISM|SMX_FACETS.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is crystaled;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+HS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_crystal | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then TIDAL latch — five live nodes root as complete mesh + breath
SMX CRYSTAL bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "crystal live"
ASSERT SMX_CRYSTALLED == 1 "crystaled latch on"
ASSERT SMX_PRISM == 1 "prism latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected facets (C(5,2))"
ASSERT SMX_FACETS == 10 "ten facets"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_NUCLEUS == 5 "five nuclei"
ASSERT SMX_PRISMS == 5 "prism ring sticky"
ASSERT SMX_PRISMS == 5 "five prism ring steps"
ASSERT SMX_CRYSTAL == 20 "crystal bonds+prisms+nuclei"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+prisms+nuclei"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by crystal"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after crystal (mesh + prisms + nucleus)"
ASSERT SMX_VITAL >= 14 "vital after crystal"
ASSERT CUBES == base_cubes "crystal invents nothing"

// Alias MARSH form still pure
SMX PRISM bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "prism rebind"
ASSERT SMX_CRYSTALLED == 1 "crystaled sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_NUCLEUS == 5 "nuclei sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"

// Alias SPARTINA form
SMX FACET bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "prisms rebind"
ASSERT SMX_CRYSTALLED == 1 "prisms crystaled"
ASSERT SMX_PRISMS == 5 "prisms sticky"

// Mitosis under free energy while the mesh is crystaled
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          LET births = births + 1
        END
      END
    END
  END
  SEND seed tick
  SEND d1 tick
  SEND d2 tick
  LET step = step + 1
END

GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = 1
IF a1 == 1 THEN
  LET pop = pop + 1
END
IF a2 == 1 THEN
  LET pop = pop + 1
END
ASSERT births >= 1 "mitosis under crystal"
ASSERT pop >= 2 "population after crystaled life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Soft-OOB ghost in crystal — fail-closed, no thrash place
SMX CRYSTAL bed nozzle ghost_x hive scrap
ASSERT SMX_OOB >= 1 "crystal soft-OOB"
ASSERT SMX_BREATH == 4 "four live of five named"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds among live"
ASSERT SMX_TONE == 4 "four tones among live"
ASSERT SMX_CRYSTALLED == 0 "ghost blocks full crystal (partial ok)"
ASSERT SMX_MESH == 0 "mesh zero when not full"
ASSERT SMX_NUCLEUS == 0 "nuclei zero when not full"
ASSERT SMX_BONDS == 6 "six bonds among live"
ASSERT SMX_OK == 1 "partial still ok"
ASSERT CUBES == base_cubes "no ghost from crystal"

SMX RECOVER
ASSERT SMX_OK == 1 "recover after crystal oob"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital after recover"

// Pure mesh bind after recover
SMX MESH_CRYSTAL bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_crystal pure"
ASSERT SMX_CRYSTALLED == 1 "crystaled after recover"
ASSERT SMX_BONDS == 10 "bonds after recover"
ASSERT SMX_NUCLEUS == 5 "nuclei after recover"
ASSERT SMX_BONDS == 10 "bonds after recover"
ASSERT SMX_PRISMS == 5 "prism after recover"
ASSERT SMX_PRISMS == 5 "prisms after recover"
ASSERT SMX_MESH == 5 "mesh after recover"
ASSERT SMX_TONE == 5 "tone after recover"
ASSERT CUBES == base_cubes "bind invents nothing"

// Dual SEAL/OPEN rails under crystaled spine
SMX SEAL bed nozzle "state/smx_crystal/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_crystal/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_crystal/rail_hs.cblc"
ASSERT SMX_OK == 1 "seal rail HS"
SMX OPEN pulse "state/smx_crystal/rail_hs.cblc"
ASSERT SMX_OK == 1 "open HS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Final crystal lock + vitals
SMX CRYSTAL bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "final crystal lock"
ASSERT SMX_CRYSTALLED == 1 "final crystaled"
ASSERT SMX_BONDS == 10 "final bonds"
ASSERT SMX_MESH == 5 "final mesh"
ASSERT SMX_NUCLEUS == 5 "final nuclei"
ASSERT SMX_BONDS == 10 "final bonds"
ASSERT SMX_PRISMS == 5 "final prisms"
ASSERT SMX_PRISMS == 5 "final prism"
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after crystal"
ASSERT SMX_KEY_OK == 1 "key after crystal"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after crystal"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

// Second storm fail-closed
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"
SMX NUCLEUS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "nucleus after storm"
ASSERT SMX_OOB == 0 "storm cleared by crystal"
ASSERT SMX_BREATH == 5 "crystaled holds after storm"
ASSERT SMX_CRYSTALLED == 1 "crystaled after storm"
ASSERT SMX_BONDS == 10 "bonds after storm"
ASSERT SMX_MESH == 5 "mesh after storm"
ASSERT SMX_NUCLEUS == 5 "nuclei after storm"
ASSERT SMX_BONDS == 10 "bonds after storm"
ASSERT SMX_PRISMS == 5 "prisms after storm"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after crystal"
ASSERT UNITY >= 40 "mesh unity after crystal"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh crystal"
ASSERT pop >= 2 "population after crystaled life"
ASSERT SMX_CRYSTALLED == 1 "crystaled latch holds"
ASSERT SMX_BREATH == 5 "five-node tone"
ASSERT SMX_MESH == 5 "five mesh holds"
ASSERT SMX_NUCLEUS == 5 "five nuclei hold"
ASSERT SMX_OOB == 0 "guard holds through crystal"
ASSERT OK == 1

PRINT "mesh_crystal" births pop SMX_CRYSTALLED SMX_MESH SMX_NUCLEUS SMX_BONDS SMX_PRISMS SMX_CRYSTAL SMX_PRISMS SMX_PRISM SMX_BONDS SMX_FUSE SMX_BIND SMX_TONE SMX_PULSE SMX_BREATH SMX_NODES SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES

PASS
