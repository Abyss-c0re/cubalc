# RELATEDTOPIC / SEETOPICS — related discovery topic bag (RELATED twin for topics)

RELATEDTOPIC cap
ASSERT OK == 1
ASSERT RELATEDTOPIC_OF == "cap"
ASSERT RELATEDTOPIC_N >= 3
ASSERT LAST_N >= 3
SYS HASI "general"
ASSERT LAST_N == 1
SYS HASI "run"
ASSERT LAST_N == 1
SYS HASI "lib"
ASSERT LAST_N == 1
SYS HASI "fat"
ASSERT LAST_N == 1

# alias + forms synonym
SEETOPICS forms
ASSERT OK == 1
ASSERT RELATEDTOPIC_OF == "cap"
SYS HASI "general"
ASSERT LAST_N == 1

RELATEDTOPIC plate
ASSERT OK == 1
ASSERT RELATEDTOPIC_OF == "plate"
SYS HASI "fat"
ASSERT LAST_N == 1
SYS HASI "run"
ASSERT LAST_N == 1

RELATEDTOPIC p2p
ASSERT OK == 1
SYS HASI "protect"
ASSERT LAST_N == 1

RELATEDTOPIC protect
ASSERT OK == 1
SYS HASI "p2p"
ASSERT LAST_N == 1

# chain with TOPICHINT on first neighbor
RELATEDTOPIC lib
ASSERT OK == 1
SYS NTH 0
TOPICHINT LAST
ASSERT OK == 1
ASSERT LAST_N >= 5

# EACH TOPIC + RELATEDTOPIC
EACH TOPIC AS t
  RELATEDTOPIC t
  ASSERT OK == 1
  ASSERT RELATEDTOPIC_N >= 3
END

# miss soft
RELATEDTOPIC zzz_nope
ASSERT OK == 0
CLEAR_ERR

# need name
RELATEDTOPIC
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1340_relatedtopic: PASS"
