# Proof 333 — digit-4 stack↔cell compare: SEQTOC SLTTOC SGTTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SEQTOC equal
CELLSET 1 42
PUSH 1
PUSH 42
SEQTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# CMPEQTOC unequal
CELLSET 2 5
PUSH 2
PUSH 6
CMPEQTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SLTTOC true: 3 < 10
CELLSET 3 3
PUSH 3
PUSH 10
SLTTOC
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# CMPLTTOC false: 10 < 3
CELLSET 4 10
PUSH 4
PUSH 3
CMPLTTOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SGTTOC true: 9 > 2
CELLSET 5 9
PUSH 5
PUSH 2
SGTTOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# CMPGTTOC false: 2 > 9
CELLSET 6 2
PUSH 6
PUSH 9
CMPGTTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# soft fails
CLEARSTACK
SEQTOC
ASSERT OK == 0
SLTTOC
ASSERT OK == 0
SGTTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof333_seqtoc_sgttoc" LAST_N SP
HOLD_FLASH 1
