# Proof 25 — cell memory plane (digit 5): COPY/MOVE/FIND/COUNT/REV
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
# seed: [10,20,30,40,50, 0,0,...]
CELLSET 0 10
CELLSET 1 20
CELLSET 2 30
CELLSET 3 40
CELLSET 4 50

# COPYCELL src dst n
COPYCELL 0 8 5
ASSERT CELL(8) == 10
ASSERT CELL(9) == 20
ASSERT CELL(12) == 50
ASSERT LAST_N == 5
ASSERT CELL(0) == 10

# overlap-safe: shift right by 1 inside bank
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CELLSET 3 4
COPYCELL 0 1 3
ASSERT CELL(0) == 1
ASSERT CELL(1) == 1
ASSERT CELL(2) == 2
ASSERT CELL(3) == 3

# FINDCELL / COUNTCELL
CLEARCELLS
FILLCELL 0 9 0
CELLSET 2 7
CELLSET 5 7
CELLSET 8 7
FINDCELL 7
ASSERT LAST_N == 2
ASSERT OK == 1
FINDCELL 7 3 9
ASSERT LAST_N == 5
COUNTCELL 7
ASSERT LAST_N == 3
COUNTCELL 7 0 4
ASSERT LAST_N == 1
FINDCELL 99
ASSERT LAST_N == -1
ASSERT OK == 0
ASSERT FINDCELL(7,0,9) == 2
ASSERT COUNTCELL(7,0,9) == 3

# REVCELL
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CELLSET 3 4
REVCELL 0 3
ASSERT CELL(0) == 4
ASSERT CELL(1) == 3
ASSERT CELL(2) == 2
ASSERT CELL(3) == 1
ASSERT LAST_N == 4

# MOVECELL: copy then clear source outside dest
CLEARCELLS
CELLSET 0 11
CELLSET 1 22
CELLSET 2 33
MOVECELL 0 10 3
ASSERT CELL(10) == 11
ASSERT CELL(11) == 22
ASSERT CELL(12) == 33
ASSERT CELL(0) == 0
ASSERT CELL(1) == 0
ASSERT CELL(2) == 0
ASSERT LAST_N == 3

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof25_cell_mem" FINDCELL(11,0,20) COUNTCELL(0,0,15) CELL(10)
