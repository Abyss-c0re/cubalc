# Proof 147 — digit-2 dual-stack numthy: DSQR DISQRT DCOPRIME
HOLD_FLASH 1
SCIENCE LOAD

# DSQR — a b → a² b²
CLEARSTACK
PUSH 5
PUSH -3
DSQR
POP y
POP x
ASSERT x == 25
ASSERT y == 9

# DISQRT
CLEARSTACK
PUSH 100
PUSH 50
DISQRT
POP y
POP x
ASSERT x == 10
ASSERT y == 7

# neg isqrt → 0
CLEARSTACK
PUSH -9
PUSH 16
2ISQRT
POP y
POP x
ASSERT x == 0
ASSERT y == 4

# DCOPRIME — pairwise gcd==1
CLEARSTACK
PUSH 8
PUSH 9
PUSH 4
PUSH 14
DCOPRIME
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# 2SQR / PAIRCOPRIME aliases
CLEARSTACK
PUSH 4
PUSH 6
2SQR
POP y
POP x
ASSERT x == 16
ASSERT y == 36

CLEARSTACK
PUSH 7
PUSH 10
PUSH 12
PUSH 9
PAIRCOPRIME
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# soft fails
CLEARSTACK
DSQR
ASSERT OK == 0
CLEARSTACK
DISQRT
ASSERT OK == 0
CLEARSTACK
DCOPRIME
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSQR
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2COPRIME
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof147_dsqr_dcoprime" LAST_N SP
