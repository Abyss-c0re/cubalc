# Proof 70 — digit-2 multiword arith: ADDC/SUBB/DIVMOD + stack SADDC/SDIVMOD
HOLD_FLASH 1
SCIENCE LOAD

# ADDC without cin
ASSERT ADDC(10, 20) == 30
ASSERT CARRY == 0

# ADDC with cin
ASSERT ADDC(10, 20, 1) == 31
ASSERT CARRY == 0

# wrap-around carry (all-ones + 1)
LET all1 = 0 - 1
ASSERT ADDC(all1, 1) == 0
ASSERT CARRY == 1
ASSERT ADDC(all1, 0, 1) == 0
ASSERT CARRY == 1
ASSERT ADDC(5, 0, 0) == 5
ASSERT CARRY == 0

# multi-limb add: lo then hi
LET lo1 = all1
LET lo2 = 5
LET hi1 = 1
LET hi2 = 2
LET lo = ADDC(lo1, lo2)
LET cy = CARRY
LET hi = ADDC(hi1, hi2, cy)
ASSERT lo == 4
ASSERT cy == 1
ASSERT hi == 4

# SUBB
ASSERT SUBB(10, 3) == 7
ASSERT BORROW == 0
ASSERT SUBB(3, 10) == (0 - 7)
ASSERT BORROW == 1
ASSERT SUBB(10, 3, 1) == 6
ASSERT BORROW == 0
ASSERT SUBB(0, 0, 1) == all1
ASSERT BORROW == 1

# DIVMOD
ASSERT DIVMOD(17, 5) == 3
ASSERT QUOT == 3
ASSERT REM == 2
ASSERT DIVMOD(-17, 5) == -3
ASSERT REM == -2
ASSERT DIVMOD(10, 0) == 0
ASSERT OK == 0

# stack SADDC (uses CARRY)
CLEARSTACK
LET CARRY = 0
PUSH 100
PUSH 23
SADDC
ASSERT LAST_N == 123
ASSERT CARRY == 0

CLEARSTACK
LET CARRY = 0
PUSH all1
PUSH 1
SADDC
ASSERT LAST_N == 0
ASSERT CARRY == 1
CLEARSTACK
PUSH 0
PUSH 0
SADDC
ASSERT LAST_N == 1
ASSERT CARRY == 0

# stack SSUBB
CLEARSTACK
LET BORROW = 0
PUSH 50
PUSH 8
SSUBB
ASSERT LAST_N == 42
ASSERT BORROW == 0

CLEARSTACK
LET BORROW = 0
PUSH 5
PUSH 8
SSUBB
ASSERT BORROW == 1

# stack SDIVMOD → rem under, quot TOS
CLEARSTACK
PUSH 17
PUSH 5
SDIVMOD
ASSERT LAST_N == 3
POP
ASSERT LAST_N == 3
POP
ASSERT LAST_N == 2
ASSERT QUOT == 3
ASSERT REM == 2

CLEARSTACK
SDIVMOD
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof70_addc_divmod" lo hi CARRY BORROW QUOT REM
