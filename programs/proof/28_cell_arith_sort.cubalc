# Proof 28 — cell fold digit-9: ADDCELL MULCELL IOTA SORTCELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
# IOTA default: start=0 step=1 → 0,1,2,3,4
IOTA 0 4
ASSERT CELL(0) == 0
ASSERT CELL(1) == 1
ASSERT CELL(4) == 4
ASSERT LAST_N == 5

# IOTA with start/step
CLEARCELLS
IOTA 0 3 10 5
ASSERT CELL(0) == 10
ASSERT CELL(1) == 15
ASSERT CELL(2) == 20
ASSERT CELL(3) == 25

# ADDCELL
ADDCELL 0 3 1
ASSERT CELL(0) == 11
ASSERT CELL(3) == 26
ASSERT SUMCELL(0,3) == 11+16+21+26

# MULCELL
CLEARCELLS
IOTA 0 3 1 1
MULCELL 0 3 3
ASSERT CELL(0) == 3
ASSERT CELL(1) == 6
ASSERT CELL(2) == 9
ASSERT CELL(3) == 12
ASSERT SUMCELL(0,3) == 30

# SORTCELL ascending
CLEARCELLS
CELLSET 0 40
CELLSET 1 10
CELLSET 2 30
CELLSET 3 20
SORTCELL 0 3
ASSERT CELL(0) == 10
ASSERT CELL(1) == 20
ASSERT CELL(2) == 30
ASSERT CELL(3) == 40

# SORTCELL descending (use DESC — bare -1 would parse as hi-1)
SORTCELL 0 3 DESC
ASSERT CELL(0) == 40
ASSERT CELL(1) == 30
ASSERT CELL(2) == 20
ASSERT CELL(3) == 10
ASSERT LAST_N == 4
# also accept parenthesized dir
SORTCELL 0 3 (1)
ASSERT CELL(0) == 10
ASSERT CELL(3) == 40

# compose with FINDCELL after asc sort [10,20,30,40]
ASSERT FINDCELL(20,0,3) == 1
ASSERT COUNTCELL(40,0,3) == 1

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof28_cell_arith" SUMCELL(0,3) CELL(0)
