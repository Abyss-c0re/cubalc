# ALIGNUPN / ALIGNDOWNN — ceil/floor align to step (twin of SNAPN nearest)
# Usability: pad sizes up, snap bases down without shell arithmetic glue.

HOLD_FLASH 1

# exact multiple stays
ALIGNUPN 64 64
ASSERT LAST_N == 64
ASSERT ALIGNUPN_CHANGED == 0
ASSERT ALIGNUPN_OK == 1

ALIGNDOWNN 64 64
ASSERT LAST_N == 64
ASSERT ALIGNDOWNN_CHANGED == 0

# raise / lower positive
ALIGNUPN 65 64
ASSERT LAST_N == 128
ASSERT ALIGNUPN_X == 65
ASSERT ALIGNUPN_STEP == 64
ASSERT ALIGNUPN_CHANGED == 1

ALIGNDOWNN 65 64
ASSERT LAST_N == 64
ASSERT ALIGNDOWNN_CHANGED == 1

# zero
ALIGNUPN 0 16
ASSERT LAST_N == 0
ALIGNDOWNN 0 16
ASSERT LAST_N == 0

# small positive
ALIGNUPN 1 8
ASSERT LAST_N == 8
ALIGNDOWNN 1 8
ASSERT LAST_N == 0

# negative: up toward +inf, down toward -inf
ALIGNUPN -17 8
ASSERT LAST_N == -16
ASSERT ALIGNUPN_CHANGED == 1

ALIGNDOWNN -17 8
ASSERT LAST_N == -24
ASSERT ALIGNDOWNN_CHANGED == 1

# exact negative multiple
ALIGNUPN -16 8
ASSERT LAST_N == -16
ALIGNDOWNN -16 8
ASSERT LAST_N == -16

# aliases
CEILALIGNN 10 4
ASSERT LAST_N == 12
SNAPUPN 10 4
ASSERT LAST_N == 12
FLOORALIGNN 10 4
ASSERT LAST_N == 8
SNAPDOWNN 10 4
ASSERT LAST_N == 8

# optional TO / BY
ALIGNUPN 20 TO 16
ASSERT LAST_N == 32
ALIGNDOWNN 20 BY 16
ASSERT LAST_N == 16

# step zero soft
ALIGNUPN 10 0
ASSERT LAST_N == 10
ASSERT ALIGNUPN_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

ALIGNDOWNN 10 0
ASSERT LAST_N == 10
ASSERT ALIGNDOWNN_OK == 0

# negative step treated as abs
ALIGNUPN 10 -8
ASSERT LAST_N == 16
ALIGNDOWNN 10 -8
ASSERT LAST_N == 8

# var subjects + pipeline after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--size=100"
SYS ENV SET CUBALC_ARG1 "--align=64"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGN size OR 0
LET size = LAST_N
GETFLAGN align OR 1
LET align = LAST_N
FLOORN align 1
LET align = LAST_N
ALIGNUPN size align
ASSERT LAST_N == 128

LET addr = 5000
LET page = 4096
ALIGNDOWNN addr page
ASSERT LAST_N == 4096

# LAST decimal
ALIGNUPN 7 4
SYS EQS LAST "8"
ASSERT LAST_N == 1

PRINT "alignupn_aligndownn ok"
