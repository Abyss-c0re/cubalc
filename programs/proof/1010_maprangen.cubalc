# MAPRANGEN / REMAPN — affine map x from [a,b] into [c,d] after GETFLAGN

HOLD_FLASH 1

# identity scale 0..100 → 0..100
MAPRANGEN 50 0 100 0 100
ASSERT LAST_N == 50
ASSERT MAPRANGEN_OK == 1
ASSERT REMAPN == 50

# percent → byte
MAPRANGEN 50 0 100 0 255
ASSERT LAST_N == 127
ASSERT MAPRANGEN_X == 50
ASSERT MAPRANGEN_A == 0
ASSERT MAPRANGEN_B == 100
ASSERT MAPRANGEN_C == 0
ASSERT MAPRANGEN_D == 255

# low edge
MAPRANGEN 0 0 100 10 20
ASSERT LAST_N == 10

# high edge
MAPRANGEN 100 0 100 10 20
ASSERT LAST_N == 20

# mid reverse dest
MAPRANGEN 25 0 100 100 0
ASSERT LAST_N == 75

# exact quarter
MAPRANGEN 25 0 100 0 8
ASSERT LAST_N == 2

# empty source soft-fail
MAPRANGEN 5 3 3 0 10
ASSERT LAST_N == 0
ASSERT MAPRANGEN_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

# aliases
REMAPN 10 0 20 0 100
ASSERT LAST_N == 50
SCALERANGEN 2 0 10 0 5
ASSERT LAST_N == 1

# optional FROM/TO/INTO glue
MAPRANGEN 5 FROM 0 TO 10 INTO 0 TO 100
ASSERT LAST_N == 50

# pipeline after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--pct=75"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN pct OR 0
ASSERT LAST_N == 75
MAPRANGEN LAST_N 0 100 0 255
ASSERT LAST_N == 191

# var subjects
LET x = 40
LET a = 0
LET b = 80
LET c = 0
LET d = 20
MAPRANGEN x a b c d
ASSERT LAST_N == 10

# LAST decimal
MAPRANGEN 1 0 2 0 10
SYS EQS LAST "5"
ASSERT LAST_N == 1

# negative source via LET (atom-safe)
LET lo = 0
LET hi = 0
LET lo = lo - 10
LET hi = 10
MAPRANGEN 0 lo hi 0 100
ASSERT LAST_N == 50
ASSERT MAPRANGEN_OK == 1

PRINT "maprangen ok"
