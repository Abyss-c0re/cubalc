# Proof 510 — digit-1 stack imm 32-bit field unary+rotate: SNOT32N SROL32N SROR32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SNOT32N n0: 0 → FFFFFFFF ; 0x00FF → FFFFFF00
PUSH 0x0
SNOT32N 0
POP x
ASSERT x == 4294967295

CLEARSTACK
PUSH 0x00FF
NOT32N 0
POP x
ASSERT x == 4294967040

# high preserved not: word0 only flips low 32
CLEARSTACK
PUSH 0x1122334455667788
SNOT32N 0
POP x
ASSERT x == 0x11223344AA998877

# STACKNOT32N n1: high word of 0xAAAA000100000001 → ~AAAA0001 = 5555FFFE → 0x5555FFFE00000001
CLEARSTACK
PUSH 0xAAAA000100000001
STACKNOT32N 1
POP x
ASSERT x == 0x5555FFFE00000001

# SINV32N alias: FFFFFFFF → 0
CLEARSTACK
PUSH 0xFFFFFFFF
SINV32N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x80000000
SINVERT32N 0
POP x
ASSERT x == 2147483647

# SROL32N k=1 n0: 0x80000001 → 0x00000003 ; 0x00000001 → 0x00000002
CLEARSTACK
PUSH 0x80000001
SROL32N 1 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x00000001
ROL32N 1 0
POP x
ASSERT x == 2

# high preserved rol word0
CLEARSTACK
PUSH 0x1122334480000001
SROL32N 1 0
POP x
ASSERT x == 0x1122334400000003

# STACKROL32N n1: high word of 0x0000000100000002 is 1 rotl1 → 2 → 0x0000000200000002
CLEARSTACK
PUSH 0x0000000100000002
STACKROL32N 1 1
POP x
ASSERT x == 0x0000000200000002

# SROR32N k=1 n0: 0x00000002 → 0x00000001 ; 0x00000001 → 0x80000000
CLEARSTACK
PUSH 0x00000002
SROR32N 1 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x00000001
ROR32N 1 0
POP x
ASSERT x == 2147483648

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA55A0033
SROL32N 7 0
SROR32N 7 0
POP x
ASSERT x == 0xA55A0033

# k masked: k=33 → k&31=1
CLEARSTACK
PUSH 0x00000001
SROR32N 33 0
POP x
ASSERT x == 2147483648

# STACKROR32N n1: high word of 0x0000000200000000 is 2 → rotr1 → 1 → 0x0000000100000000
CLEARSTACK
PUSH 0x0000000200000000
STACKROR32N 1 1
POP x
ASSERT x == 0x0000000100000000

# SROTL32N alias
CLEARSTACK
PUSH 0x10000000
SROTL32N 1 0
POP x
ASSERT x == 0x20000000

# SNOTDWN alias
CLEARSTACK
PUSH 0x00FF
SNOTDWN 0
POP x
ASSERT x == 4294967040

HOLD_FLASH 0
