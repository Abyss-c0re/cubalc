# Proof 29 — cell fold digit-9: MINIDX/MAXIDX ROTCELL SHIFTCELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
# [50, 10, 40, 20, 30]
CELLSET 0 50
CELLSET 1 10
CELLSET 2 40
CELLSET 3 20
CELLSET 4 30

MINIDX 0 4
ASSERT LAST_N == 1
MAXIDX 0 4
ASSERT LAST_N == 0
ASSERT MINIDX(0,4) == 1
ASSERT MAXIDX(0,4) == 0
ASSERT ARGMIN(1,4) == 1
ASSERT ARGMAX(1,4) == 2

# ties: first index wins
CLEARCELLS
CELLSET 0 7
CELLSET 1 3
CELLSET 2 3
CELLSET 3 9
MINIDX 0 3
ASSERT LAST_N == 1
MAXIDX 0 3
ASSERT LAST_N == 3

# ROTCELL left by 1: [1,2,3,4] → [2,3,4,1]
CLEARCELLS
IOTA 0 3 1 1
ROTCELL 0 3 1
ASSERT CELL(0) == 2
ASSERT CELL(1) == 3
ASSERT CELL(2) == 4
ASSERT CELL(3) == 1

# ROTCELL right by 1 (k=-1): [2,3,4,1] → [1,2,3,4]
ROTCELL 0 3 (-1)
ASSERT CELL(0) == 1
ASSERT CELL(1) == 2
ASSERT CELL(2) == 3
ASSERT CELL(3) == 4

# SHIFTCELL left by 1: [1,2,3,4] → [2,3,4,0]
SHIFTCELL 0 3 1
ASSERT CELL(0) == 2
ASSERT CELL(1) == 3
ASSERT CELL(2) == 4
ASSERT CELL(3) == 0

# SHIFTCELL right by 2: [2,3,4,0] → [0,0,2,3]
SHIFTCELL 0 3 (-2)
ASSERT CELL(0) == 0
ASSERT CELL(1) == 0
ASSERT CELL(2) == 2
ASSERT CELL(3) == 3

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof29_cell_argmin" MINIDX(0,3) MAXIDX(0,3) CELL(2)
