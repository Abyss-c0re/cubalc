# Proof 295 — digit-2 multiword imm: SADDCN SSUBBN DADDCN DSUBBN
HOLD_FLASH 1
SCIENCE LOAD

# SADDCN n — no cin
CLEARSTACK
LET CARRY = 0
PUSH 10
SADDCN 5
POP x
ASSERT x == 15
ASSERT CARRY == 0

# SADDCN — with cin
CLEARSTACK
LET CARRY = 1
PUSH 10
ADDCN 5
POP x
ASSERT x == 16
ASSERT CARRY == 0

# SADDCN — cout
CLEARSTACK
LET CARRY = 0
PUSH -1
SADCIMM 1
POP x
ASSERT x == 0
ASSERT CARRY == 1

# SADDCN — max + 0 + cin → 0 cout
CLEARSTACK
LET CARRY = 1
PUSH -1
SADDCIMM 0
POP x
ASSERT x == 0
ASSERT CY == 1

# SSUBBN n — no bin
CLEARSTACK
LET BORROW = 0
LET CARRY = 0
PUSH 10
SSUBBN 3
POP x
ASSERT x == 7
ASSERT BORROW == 0

# SSUBBN — with bin
CLEARSTACK
LET BORROW = 1
PUSH 10
SUBBN 3
POP x
ASSERT x == 6
ASSERT BORROW == 0

# SSUBBN — bout
CLEARSTACK
LET BORROW = 0
PUSH 0
SSBBIMM 1
POP x
ASSERT x == -1
ASSERT BORROW == 1
ASSERT CARRY == 1

# DADDCN n — no cin
CLEARSTACK
LET CARRY = 0
PUSH 10
PUSH 20
DADDCN 5
POP y
POP x
ASSERT x == 15
ASSERT y == 25
ASSERT CARRY == 0

# DADDCN — with cin both lanes
CLEARSTACK
LET CARRY = 1
PUSH 10
PUSH 20
PAIRADDCN 5
POP y
POP x
ASSERT x == 16
ASSERT y == 26
ASSERT CARRY == 0

# DADDCN — one lane cout
CLEARSTACK
LET CARRY = 0
PUSH -1
PUSH 1
DADDCIMM 1
POP y
POP x
ASSERT x == 0
ASSERT y == 2
ASSERT CARRY == 1

# DSUBBN n
CLEARSTACK
LET BORROW = 0
LET CARRY = 0
PUSH 10
PUSH 20
DSUBBN 3
POP y
POP x
ASSERT x == 7
ASSERT y == 17
ASSERT BORROW == 0

# DSUBBN — with bin
CLEARSTACK
LET BORROW = 1
PUSH 10
PUSH 0
PAIRSUBBN 1
POP y
POP x
ASSERT x == 8
ASSERT y == -2
ASSERT BORROW == 1
ASSERT CARRY == 1

# soft fails
CLEARSTACK
SADDCN 1
ASSERT OK == 0
CLEARSTACK
SSUBBN 1
ASSERT OK == 0
CLEARSTACK
DADDCN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSUBBN 1
ASSERT OK == 0

HOLD_FLASH 1
