# INCLUDE cli_guard — multi flag ALL + ANY + rest contract (form_guard twin for CLI)

HOLD_FLASH 1

# --- skip all gates when defaults empty ---
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
DEFAULT NEED_FLAGS = ""
DEFAULT NEED_FLAG_ANY = ""
DEFAULT NEED_REST_N = 0
DEFAULT CLI_GUARD_SOFT = 0
INCLUDE cli_guard
ASSERT CLI_GUARD_OK == 1
ASSERT CLI_GUARD_FLAGS_OK == 1
ASSERT CLI_GUARD_FLAG_ANY_OK == 1
ASSERT CLI_GUARD_REST_OK == 1

# --- soft ALL miss ---
SYS ENV SET CUBALC_ARGC "0"
LET NEED_FLAGS = "out"
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 0
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_OK == 0
ASSERT CLI_GUARD_FLAGS_OK == 0
ASSERT FLAGMISS_N >= 1
SYS HASLINE FLAGMISS "out"
ASSERT LAST_N == 1
CLEAR_ERR

# --- soft ALL hit ---
SYS ENV SET CUBALC_ARG0 "--out=x"
SYS ENV SET CUBALC_ARG1 "--verbose"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = "out\nverbose"
LET NEED_FLAG_ANY = ""
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_FLAGS_OK == 1
ASSERT CLI_GUARD_OK == 1

# --- soft ANY miss ---
SYS ENV SET CUBALC_ARG0 "--only"
SYS ENV SET CUBALC_ARGC "1"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = "json\nyaml"
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_FLAG_ANY_OK == 0
ASSERT CLI_GUARD_OK == 0
ASSERT FLAGMISS_N >= 1
CLEAR_ERR

# --- soft ANY hit with one ---
SYS ENV SET CUBALC_ARG0 "--json"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = "json\nyaml"
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_FLAG_ANY_OK == 1
ASSERT CLI_GUARD_OK == 1
SYS HASLINE FLAGHAVE "json"
ASSERT LAST_N == 1
CLEAR_ERR

# --- rest min miss soft ---
SYS ENV SET CUBALC_ARG0 "--mode=dry"
SYS ENV SET CUBALC_ARGC "1"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 1
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_REST_OK == 0
ASSERT CLI_GUARD_OK == 0
CLEAR_ERR

# --- rest min hit ---
SYS ENV SET CUBALC_ARG0 "--mode=dry"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 1
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_REST_OK == 1
ASSERT CLI_GUARD_OK == 1

# --- hard NEEDFLAGS path (must pass) ---
SYS ENV SET CUBALC_ARG0 "--out=y"
SYS ENV SET CUBALC_ARGC "1"
LET NEED_FLAGS = "out"
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 0
LET CLI_GUARD_SOFT = 0
INCLUDE cli_guard
ASSERT CLI_GUARD_OK == 1

# --- hard NEEDFLAGANY path ---
SYS ENV SET CUBALC_ARG0 "--yaml"
SYS ENV SET CUBALC_ARGC "1"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = "json\nyaml"
LET NEED_REST_N = 0
LET CLI_GUARD_SOFT = 0
INCLUDE cli_guard
ASSERT CLI_GUARD_FLAG_ANY_OK == 1
ASSERT CLI_GUARD_OK == 1

# --- hard RESTARGS path ---
SYS ENV SET CUBALC_ARG0 "only.txt"
SYS ENV SET CUBALC_ARGC "1"
LET NEED_FLAGS = ""
LET NEED_FLAG_ANY = ""
LET NEED_REST_N = 1
LET CLI_GUARD_SOFT = 0
INCLUDE cli_guard
ASSERT CLI_GUARD_REST_OK == 1
ASSERT CLI_GUARD_OK == 1

# --- combined ALL + ANY soft ---
SYS ENV SET CUBALC_ARG0 "--out=z"
SYS ENV SET CUBALC_ARG1 "--json"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = "out"
LET NEED_FLAG_ANY = "json\nyaml"
LET NEED_REST_N = 0
LET CLI_GUARD_SOFT = 1
INCLUDE cli_guard
ASSERT CLI_GUARD_FLAGS_OK == 1
ASSERT CLI_GUARD_FLAG_ANY_OK == 1
ASSERT CLI_GUARD_OK == 1

# chain with cli_boot
INCLUDE cli_boot
ASSERT OK == 1

# discoverable
HASLIB cli_guard
ASSERT LAST_N == 1
HASFORM HASFLAGANY
ASSERT LAST_N == 1
HASFORM NEEDFLAGANY
ASSERT LAST_N == 1

PRINT "1387_cli_guard_any ok"
PASS
