// 2058_life_cell_harness.cubalc
// Proof: life_cell harness — heat to pmf waste-heat salvage to proton gradient.
// Distinct from thaw reclaim capture cool. Yield restored into pmf.
// energy reserve atp pcr ready untouched. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY seed OF Cell 1 12 0
ENTITY ally OF Cell 1 8 0
ENTITY dead OF Cell 0 0 0
ENTITY quiet OF Cell 1 14 0
ENTITY iso OF Cell 1 20 0

GETF seed energy
ASSERT LAST_N == 12 "spark 12"
SEND seed warmth
ASSERT LAST_N == 0 "warmth empty"
SEND seed gradient
ASSERT LAST_N == 0 "pmf empty"
SEND seed harness 3
ASSERT LAST_N == 0 "empty harness 0"
SEND seed yield
ASSERT LAST_N == 12 "yield 12"

SEND seed shiver 6
ASSERT LAST_N == 6 "shiver 6"
GETF seed energy
ASSERT LAST_N == 6 "active 6"
SEND seed warmth
ASSERT LAST_N == 6 "warmth 6"
SEND seed yield
ASSERT LAST_N == 6 "yield sheds on shiver"

SEND seed harness 4
ASSERT LAST_N == 4 "harness 4"
SEND seed warmth
ASSERT LAST_N == 2 "warmth 2"
SEND seed gradient
ASSERT LAST_N == 4 "pmf 4 after harness"
GETF seed energy
ASSERT LAST_N == 6 "energy untouched by harness"
SEND seed charged
ASSERT LAST_N == 0 "atp untouched"
SEND seed stores
ASSERT LAST_N == 0 "reserve untouched"
SEND seed yield
ASSERT LAST_N == 10 "yield energy+pmf 6+4"

SEND seed harness 9
ASSERT LAST_N == 2 "harness drains 2"
SEND seed warmth
ASSERT LAST_N == 0 "warmth empty"
SEND seed gradient
ASSERT LAST_N == 6 "pmf 6 total"
GETF seed energy
ASSERT LAST_N == 6 "energy still 6"
SEND seed harness 1
ASSERT LAST_N == 0 "empty harness 0"
SEND seed yield
ASSERT LAST_N == 12 "yield full 6+6"

SEND dead harness 2
ASSERT LAST_N == 0 "dead harness 0"

SEND seed shiver 3
ASSERT LAST_N == 3 "shiver 3"
SEND seed harness 0
ASSERT LAST_N == 0 "zero harness 0"
SEND seed harness -1
ASSERT LAST_N == 0 "neg harness 0"
SEND seed warmth
ASSERT LAST_N == 3 "warmth held 3"
SEND seed cool 3
ASSERT LAST_N == 3 "clear residual heat"
SEND seed warmth
ASSERT LAST_N == 0 "warmth clear"

SEND seed feed 9
ASSERT LAST_N == 12 "fed back to 12"
SEND seed pump 4
ASSERT LAST_N == 4 "pump 4"
GETF seed energy
LET e0 = LAST_N
ASSERT e0 == 8 "e0 8"
SEND seed gradient
LET p0 = LAST_N
ASSERT p0 == 10 "pmf 10"
SEND seed uncouple 3
ASSERT LAST_N == 3 "uncouple 3"
SEND seed gradient
ASSERT LAST_N == 7 "pmf 7 after uncouple"
SEND seed warmth
ASSERT LAST_N == 3 "warmth 3 from uncouple"
SEND seed harness 3
ASSERT LAST_N == 3 "harness recovers 3"
SEND seed gradient
ASSERT LAST_N == 10 "pmf restored 10"
SEND seed warmth
ASSERT LAST_N == 0 "warmth empty"
GETF seed energy
ASSERT LAST_N == 8 "energy held 8"
SEND seed charged
ASSERT LAST_N == 0 "atp still 0"
SEND seed yield
ASSERT LAST_N == 18 "yield e+pmf 8+10"

SEND quiet quiesce
ASSERT LAST_N == 1 "quiet G0"
SEND quiet feed 20
GETF quiet energy
ASSERT LAST_N >= 20 "quiet energy high"
SEND quiet shiver 5
SEND quiet harness 5
SEND quiet gradient
ASSERT LAST_N == 5 "quiet pmf 5"
GETF quiet ready
ASSERT LAST_N == 0 "quiescent never ready"
SEND quiet wake
SEND quiet gradient
ASSERT LAST_N == 5 "pmf held across wake"

SEND iso shiver 8
ASSERT LAST_N == 8 "iso shiver 8"
SEND iso capture 3
ASSERT LAST_N == 3 "iso capture 3"
SEND iso harness 3
ASSERT LAST_N == 3 "iso harness 3"
SEND iso charged
ASSERT LAST_N == 3 "iso atp 3"
SEND iso gradient
ASSERT LAST_N == 3 "iso pmf 3"
SEND iso warmth
ASSERT LAST_N == 2 "iso warmth 2"
SEND iso yield
ASSERT LAST_N == 18 "iso yield 18"

SEND seed synthase 2
ASSERT LAST_N == 2 "synthase 2 from harnessed pmf"
SEND seed gradient
ASSERT LAST_N == 8 "pmf 8 after synthase"
SEND seed charged
ASSERT LAST_N == 2 "atp 2 from synthase"
GETF seed energy
ASSERT LAST_N == 8 "energy still 8"

SEND ally shiver 4
ASSERT LAST_N == 4 "ally shiver 4"
SEND ally harness 100
ASSERT LAST_N == 4 "ally clamp harness 4"
SEND ally gradient
ASSERT LAST_N == 4 "ally pmf 4"
SEND ally warmth
ASSERT LAST_N == 0 "ally warmth 0"

SEND seed vitality
ASSERT LAST_N > 0 "vitality live"

ASSERT 1 == 1 "harness proof complete"

