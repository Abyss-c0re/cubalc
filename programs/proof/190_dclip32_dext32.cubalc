# Proof 190 — digit-9 dual-stack 32-bit data-path: DCLIP32 DSEXT32 DZEXT32
HOLD_FLASH 1
SCIENCE LOAD

# DCLIP32
CLEARSTACK
PUSH -5
PUSH 100
DCLIP32
POP y
POP x
ASSERT x == 0
ASSERT y == 100

# overflow clamp
CLEARSTACK
LET big = 5000000000
PUSH big
PUSH 4294967295
2CLIP32
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 4294967295

# PAIRCLIP32 identity
CLEARSTACK
PUSH 1
PUSH 2
PAIRCLIP32
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# DSEXT32: bit31 set → negative
CLEARSTACK
PUSH 2147483648
PUSH 1
DSEXT32
POP y
POP x
ASSERT x == -2147483648
ASSERT y == 1

# 2SEXT32 / DSEXTD
CLEARSTACK
PUSH 4294967295
PUSH 2147483647
2SEXT32
POP y
POP x
ASSERT x == -1
ASSERT y == 2147483647

CLEARSTACK
PUSH 0x80000000
PUSH 0x7FFFFFFF
DSEXTD
POP y
POP x
ASSERT x == -2147483648
ASSERT y == 2147483647

# DZEXT32
CLEARSTACK
PUSH -1
PUSH 4294967296
DZEXT32
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 0

# 2ZEXT32 / DZEXTD
CLEARSTACK
PUSH 0x1FFFFFFFF
PUSH 0x100000000
2ZEXT32
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 0

CLEARSTACK
PUSH 0xABCDEF12
PUSH 0
DZEXTD
POP y
POP x
ASSERT x == 0xABCDEF12
ASSERT y == 0

# contrast sext vs zext on high bit
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
DSEXT32
POP y
POP x
ASSERT x == -2147483648
ASSERT y == -2147483648
CLEARSTACK
PUSH 0x80000000
PUSH 0x80000000
DZEXT32
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 2147483648

# S2CLIP32 / STACK2ZEXT32 aliases
CLEARSTACK
PUSH -1
PUSH 10
S2CLIP32
POP y
POP x
ASSERT x == 0
ASSERT y == 10

CLEARSTACK
PUSH -1
PUSH 1
STACK2ZEXT32
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 1

# soft fail
CLEARSTACK
PUSH 1
DCLIP32
ASSERT OK == 0
CLEARSTACK
DSEXT32
ASSERT OK == 0
CLEARSTACK
PUSH 1
DZEXT32
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof190_dclip32_dext32" LAST_N SP
