# Proof 424 — digit-9 inverted cell logic: NANDCELL NORCELL XNORCELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# setup cells 0..2
CELLSET 0 15
CELLSET 1 15
CELLSET 2 15

# NANDCELL 0 0 0xF → ~(15 & 15) = ~15
NANDCELL 0 0 15
ASSERT CELL(0) == -16
ASSERT LAST_N == 1

# NORCELL 1 1 0 → ~(15 | 0) = ~15 = -16
CELLSET 1 15
NORCELL 1 1 0
ASSERT CELL(1) == -16
ASSERT LAST_N == 1

# XNORCELL 2 2 0 → ~(15 ^ 0) = ~15 = -16
CELLSET 2 15
XNORCELL 2 2 0
ASSERT CELL(2) == -16
ASSERT LAST_N == 1

# range NAND: cells 3,4 = 0xFF with mask 0x0F → ~(0xFF&0x0F)= ~0x0F = -16
CELLSET 3 255
CELLSET 4 255
NANDCELL 3 4 15
ASSERT CELL(3) == -16
ASSERT CELL(4) == -16
ASSERT LAST_N == 2

# CELLNOR alias: 5 = 0, mask 0 → ~(0|0)= ~0 = -1
CELLSET 5 0
CELLNOR 5 5 0
ASSERT CELL(5) == -1

# CELLXNOR: 6 = 0xAA (170), mask 0xAA → ~(0)= -1
CELLSET 6 170
CELLXNOR 6 6 170
ASSERT CELL(6) == -1

# BNANDCELL: value 0 mask 0 → ~(0 & 0)= ~0 = -1
CELLSET 7 0
BNANDCELL 7 7 0
ASSERT CELL(7) == -1
ASSERT LAST_N == 1

HOLD_FLASH 0
