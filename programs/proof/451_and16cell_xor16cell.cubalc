# Proof 451 — digit-9 cell fixed-width 16 bitwise: AND16CELL OR16CELL XOR16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# AND16CELL: 0xFFFF & 0x00FF → 0x00FF; high bits ignored
CELLSET 0 65535
CELLSET 1 131071
AND16CELL 0 1 255
ASSERT CELL(0) == 255
ASSERT CELL(1) == 255
ASSERT LAST_N == 2

# OR16CELL: 0x00FF | 0xFF00 → 0xFFFF
CELLSET 2 255
OR16CELL 2 2 65280
ASSERT CELL(2) == 65535
ASSERT LAST_N == 1

# XOR16CELL: 0xFFFF ^ 0x00FF → 0xFF00 = 65280
CELLSET 3 65535
XOR16CELL 3 3 255
ASSERT CELL(3) == 65280
ASSERT LAST_N == 1

# high bits above 16 ignored
# 65536+1 (65537) & 0xFFFF → 1
CELLSET 4 65537
AND16CELL 4 4 65535
ASSERT CELL(4) == 1

# 65537 | 2 → 1|2 = 3
CELLSET 5 65537
OR16CELL 5 5 2
ASSERT CELL(5) == 3

# XOR self → 0 (low16)
CELLSET 6 65535
XOR16CELL 6 6 65535
ASSERT CELL(6) == 0

# AND16RANGE alias: 0xABCD & 0x0FFF → 0x0BCD = 3021
CELLSET 7 0xABCD
AND16RANGE 7 7 0x0FFF
ASSERT CELL(7) == 3021

# range OR: two cells
CELLSET 8 1
CELLSET 9 2
OR16CELL 8 9 4
ASSERT CELL(8) == 5
ASSERT CELL(9) == 6
ASSERT LAST_N == 2

# XOR16RANGE: 0xA5A5 ^ 0xFFFF → 0x5A5A = 23130
CELLSET 10 0xA5A5
XOR16RANGE 10 10 65535
ASSERT CELL(10) == 23130

HOLD_FLASH 0
