# class_guard via native HASCLASS (no LISTCLASSES+HASLINE soup)

HOLD_FLASH 1

CLASS Ticket
  FIELD id
END

CLASS Order
  FIELD n
END

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_ANY_OK == 1

LET NEED_CLASSES = "Ticket\nOrder"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASSHAVE_N >= 2
ASSERT CLASSMISS_N == 0

LET NEED_CLASSES = "Ticket\nGhost"
LET NEED_CLASS_ANY = ""
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 0
ASSERT CLASS_GUARD_OK == 0
ASSERT CLASSMISS_N >= 1
SYS HASI CLASSMISS "Ghost"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_CLASSES = ""
LET NEED_CLASS_ANY = "Ghost\nOrder"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1
SYS HASI CLASSHAVE "Order"
ASSERT LAST_N == 1

LET NEED_CLASS_ANY = "GhostA\nGhostB"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 0
ASSERT CLASS_GUARD_OK == 0
CLEAR_ERR

HASCLASS Ticket
ASSERT LAST_N == 1
HASCLASSES Ticket Order
ASSERT LAST_N == 1
HASCLASSANY Ghost Ticket
ASSERT LAST_N == 1

PRINT "1431_class_guard_native ok"
PASS
