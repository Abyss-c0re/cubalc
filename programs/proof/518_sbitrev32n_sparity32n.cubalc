# Proof 518 — digit-5 stack imm 32-bit field metrics: SBITREV32N SPOPCNT32N SPARITY32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SBITREV32N: 0x00000001 → 0x80000000 ; 0x00000003 → 0xC0000000
PUSH 0x00000001
SBITREV32N 0
POP x
ASSERT x == 2147483648

CLEARSTACK
PUSH 0x00000003
BITREV32N 0
POP x
ASSERT x == 3221225472

# 0x000000FF → 0xFF000000 ; 0x0F0F0F0F → 0xF0F0F0F0
CLEARSTACK
PUSH 0x000000FF
SBITREV32N 0
POP x
ASSERT x == 0xFF000000

CLEARSTACK
PUSH 0x0F0F0F0F
SBREV32N 0
POP x
ASSERT x == 0xF0F0F0F0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
SBITREV32N 0
SBITREV32N 0
POP x
ASSERT x == 0x112233445566778A

# STACKBITREV32N n1: high of 0x0000000100000000 is 1 → 0x80000000 high
CLEARSTACK
PUSH 0x0000000100000000
STACKBITREV32N 1
POP x
ASSERT x == 0x8000000000000000

# SPOPCNT32N: 0→0 ; FFFFFFFF→32
CLEARSTACK
PUSH 0x0
SPOPCNT32N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xFFFFFFFF
SPOPCNT32N 0
POP x
ASSERT x == 32

# high preserved: low 0x55555555 → pop 16
CLEARSTACK
PUSH 0x1122334455555555
POPCNT32N 0
POP x
ASSERT x == 0x1122334400000010

# STACKPOPCNT32N n1: high FFFFFFFF→32 → 0x00000020 high
CLEARSTACK
PUSH 0xFFFFFFFF00000000
STACKPOPCNT32N 1
POP x
ASSERT x == 0x0000002000000000

# SPCNT32N alias: 0xAAAAAAAA→16
CLEARSTACK
PUSH 0xAAAAAAAA
SPCNT32N 0
POP x
ASSERT x == 16

# SPARITY32N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
SPARITY32N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x1
SPARITY32N 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x3
PARITY32N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x7
SXORRED32N 0
POP x
ASSERT x == 1

# high preserved parity n1: high 0x90000000 even→0; high 0xB0000000 odd→1
CLEARSTACK
PUSH 0x9000000000000000
SPARITY32N 1
POP x
ASSERT x == 0x0000000000000000

CLEARSTACK
PUSH 0xB000000000000000
STACKPARITY32N 1
POP x
ASSERT x == 0x0000000100000000

# FFFFFFFF even→0 ; FFFFFFFE odd→1
CLEARSTACK
PUSH 0xFFFFFFFF
SDWPARN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xFFFFFFFE
SPARITYDWN 0
POP x
ASSERT x == 1

# SBITREVDWN alias: 0x80000000 → 0x00000001
CLEARSTACK
PUSH 0x80000000
SBITREVDWN 0
POP x
ASSERT x == 1

HOLD_FLASH 0
