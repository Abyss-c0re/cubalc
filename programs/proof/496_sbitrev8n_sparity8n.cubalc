# Proof 496 — digit-4 stack imm 8-bit field metrics: SBITREV8N SPOPCNT8N SPARITY8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SBITREV8N: 0x01 → 0x80 ; 0x03 → 0xC0
PUSH 0x01
SBITREV8N 0
POP x
ASSERT x == 128

CLEARSTACK
PUSH 0x03
BITREV8N 0
POP x
ASSERT x == 192

# 0xA5 palindrome; 0x0F → 0xF0
CLEARSTACK
PUSH 0xA5
SBITREV8N 0
POP x
ASSERT x == 0xA5

CLEARSTACK
PUSH 0x0F
SBREV8N 0
POP x
ASSERT x == 0xF0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
SBITREV8N 0
SBITREV8N 0
POP x
ASSERT x == 0x112233445566778A

# STACKBITREV8N n1: byte1 of 0x0180 is 01 → 80 → 0x8080
CLEARSTACK
PUSH 0x0180
STACKBITREV8N 1
POP x
ASSERT x == 0x8080

# SPOPCNT8N: 0→0 ; FF→8
CLEARSTACK
PUSH 0x0
SPOPCNT8N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xFF
SPOPCNT8N 0
POP x
ASSERT x == 8

# high preserved: 0x...55 → pop 4
CLEARSTACK
PUSH 0x1122334455667755
POPCNT8N 0
POP x
ASSERT x == 0x1122334455667704

# STACKPOPCNT8N n1: 0xFF00 byte1=FF→8 → 0x0800
CLEARSTACK
PUSH 0xFF00
STACKPOPCNT8N 1
POP x
ASSERT x == 0x0800

# SPCNT8N alias: 0xAA→4
CLEARSTACK
PUSH 0xAA
SPCNT8N 0
POP x
ASSERT x == 4

# SPARITY8N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
SPARITY8N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x1
SPARITY8N 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x3
PARITY8N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x7
SXORRED8N 0
POP x
ASSERT x == 1

# high preserved parity byte1: 0x9000 byte1=90 → 0; 0xB000 → 1
CLEARSTACK
PUSH 0x9000
SPARITY8N 1
POP x
ASSERT x == 0x0000

CLEARSTACK
PUSH 0xB000
STACKPARITY8N 1
POP x
ASSERT x == 0x0100

# FF even→0 ; FE odd→1
CLEARSTACK
PUSH 0xFF
SBYTEPARN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xFE
SPARITYBYTEN 0
POP x
ASSERT x == 1

HOLD_FLASH 0
