# Proof 211 — digit-6 dual-stack energy: DCLIP01 DCOMP100 DSUMSQ
HOLD_FLASH 1
SCIENCE LOAD

# DCLIP01 unit clamp
CLEARSTACK
PUSH -1
PUSH 2
DCLIP01
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH 1
2CLIP01
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# PAIRCLIP01 / DUNIT interior
CLEARSTACK
PUSH 1
PUSH 0
PAIRCLIP01
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 5
PUSH -3
DUNIT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DCOMP100 energy complement
CLEARSTACK
PUSH 0
PUSH 100
DCOMP100
POP y
POP x
ASSERT x == 100
ASSERT y == 0

CLEARSTACK
PUSH 40
PUSH 25
2COMP100
POP y
POP x
ASSERT x == 60
ASSERT y == 75

# DENCOMP / DINV100
CLEARSTACK
PUSH 10
PUSH -10
DENCOMP
POP y
POP x
ASSERT x == 90
ASSERT y == 110

CLEARSTACK
PUSH 50
PUSH 50
DINV100
POP y
POP x
ASSERT x == 50
ASSERT y == 50

# DSUMSQ
CLEARSTACK
PUSH 3
PUSH 0
PUSH 4
PUSH 0
DSUMSQ
POP y
POP x
ASSERT x == 25
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 2
PUSH 2
PUSH 3
2SUMSQ
POP y
POP x
ASSERT x == 5
ASSERT y == 13

# PAIRSUMSQ / DSSQ negatives square
CLEARSTACK
PUSH -3
PUSH 5
PUSH 4
PUSH -12
PAIRSUMSQ
POP y
POP x
ASSERT x == 25
ASSERT y == 169

CLEARSTACK
PUSH 6
PUSH 8
PUSH 8
PUSH 6
DSSQ
POP y
POP x
ASSERT x == 100
ASSERT y == 100
