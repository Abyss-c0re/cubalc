# Proof 497 — digit-9 stack imm 8-bit field zeros+signed: SCLZ8N SCTZ8N SNEG8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLZ8N: 0→8 ; 1→7
PUSH 0x0
SCLZ8N 0
POP x
ASSERT x == 8

CLEARSTACK
PUSH 0x1
CLZ8N 0
POP x
ASSERT x == 7

# 0x80→0 ; 0x02→6
CLEARSTACK
PUSH 0x80
SCLZ8N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x02
SNLZ8N 0
POP x
ASSERT x == 6

# high preserved clz0→8
CLEARSTACK
PUSH 0x1122334455667700
SCLZ8N 0
POP x
ASSERT x == 0x1122334455667708

# STACKCLZ8N n1: 0x4000 byte1=0x40 clz1 → 0x0100
CLEARSTACK
PUSH 0x4000
STACKCLZ8N 1
POP x
ASSERT x == 0x0100

# SCTZ8N: 0→8 ; 1→0 ; 0x80→7 ; 0x06→1
CLEARSTACK
PUSH 0x0
SCTZ8N 0
POP x
ASSERT x == 8

CLEARSTACK
PUSH 0x1
CTZ8N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x80
SCTZ8N 0
POP x
ASSERT x == 7

CLEARSTACK
PUSH 0x06
SNTZ8N 0
POP x
ASSERT x == 1

# STACKCTZ8N n1: 0xC000 byte1=C0 ctz6 → 0x0600
CLEARSTACK
PUSH 0xC000
STACKCTZ8N 1
POP x
ASSERT x == 0x0600

# SNEG8N: 3→0xFD ; 0xFE (-2)→2 ; min 0x80 stays 0x80
CLEARSTACK
PUSH 0x3
SNEG8N 0
POP x
ASSERT x == 253

CLEARSTACK
PUSH 0xFE
SNEG8N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x80
NEG8N 0
POP x
ASSERT x == 128

CLEARSTACK
PUSH 0x1
SBYTENEGN 0
POP x
ASSERT x == 255

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455667755
SNEG8N 0
POP x
ASSERT x == 0x11223344556677AB

CLEARSTACK
PUSH 0x11223344556677AB
SNEG8N 0
POP x
ASSERT x == 0x1122334455667755

# STACKNEG8N n1: 0x3000 byte1=0x30 → -0x30 = 0xD0 → 0xD000
CLEARSTACK
PUSH 0x3000
STACKNEG8N 1
POP x
ASSERT x == 0xD000

# aliases
CLEARSTACK
PUSH 0x10
SBYTECLZN 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x10
SBYTECTZN 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0x2
SINEG8N 0
POP x
ASSERT x == 254

HOLD_FLASH 0
