# Proof 400 — digit-3 stack dual high-n reverse/rotate TOC: SBREVHNTOC SROLHNTOC SRORHNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SHMASKTOC 4 sets high-4; reverse high-4 of 0b1111 is same (negative)
CELLSET 1 0
PUSH 1
PUSH 4
SHMASKTOC
POP
PUSH 1
PUSH 4
SBREVHNTOC
ASSERT LAST_N < 0
ASSERT CELL(1) < 0
POP a
ASSERT a < 0

# n=0: no-op leave 7
CELLSET 2 7
PUSH 2
PUSH 0
SBREVHNTOC
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SROLHNTOC: high-1 only, rotl within high-4 → nonzero
CELLSET 3 0
PUSH 3
PUSH 1
SHMASKTOC
POP
PUSH 3
PUSH 4
SROLHNTOC
ASSERT LAST_N != 0
ASSERT CELL(3) != 0
POP

# SROLHNTOC n=1: width 1 no-op
CELLSET 4 5
PUSH 4
PUSH 1
SROLHNTOC
ASSERT LAST_N == 5
ASSERT CELL(4) == 5
POP

# SRORHNTOC: high-1 (MSB) rotr within high-4 → nonzero
CELLSET 5 0
PUSH 5
PUSH 1
SHMASKTOC
POP
PUSH 5
PUSH 4
SRORHNTOC
ASSERT LAST_N != 0
ASSERT CELL(5) != 0
POP

# SRORHNTOC n=0 no-op leave 9
CELLSET 6 9
PUSH 6
PUSH 0
SRORHNTOC
ASSERT LAST_N == 9
ASSERT CELL(6) == 9
POP

# soft short stack OK=0
CLEARSTACK
SBREVHNTOC
ASSERT OK == 0
PUSH 1
SROLHNTOC
ASSERT OK == 0

PRINT "400_sbrevhntoc_srorhntoc OK"
