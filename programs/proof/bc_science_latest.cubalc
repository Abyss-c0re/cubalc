# BrainCube science→algocube contribution (auto, every 12m)
# Sciences connect state matrices; algocube digit=7
# Tick 29781117 · top pair hive_out-smx
HOLD_FLASH 1
GENESIS "NEXUS_COORD v1 | from=braincube_science | type=algocube_digit | digit=7 |"

CUBE sci ROLE peer PROTON 1
CUBE peer ROLE peer PROTON 1
CUBE hive ROLE nanobot_hive PROTON 1

FOLDBITS sci "0110001000010001000100101001000101101101000000000100010000001001"
FOLDBITS peer "0110001000010001000100101001000101101101000000000100010000001001"

PLUG sci peer
FLOW 1
COMPARE sci peer
ASSERT HAMMING == 0
ASSERT DIGIT >= 0
ASSERT DIGIT <= 9
ASSERT 7 >= 0
ASSERT 7 <= 9

HARMONY hive
ASSERT HARMONY >= 0
ASSERT DIGIT(hive) >= 0
ASSERT DIGIT(hive) <= 9

DECIDE sci
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

PRINT "bc_science" DIGIT DECIDE HARMONY
PASS
