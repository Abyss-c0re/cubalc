# Proof 349 — digit-9 reverse imm TOC: SSUBFROMTOCN SDIVFROMTOCN SMODFROMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSUBFROMTOCN: 10 - 3 → 7
CELLSET 1 3
PUSH 1
SSUBFROMTOCN 10
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP a
ASSERT a == 7

# RSUBTOCN: 5 - 8 → -3
CELLSET 2 8
PUSH 2
RSUBTOCN 5
ASSERT LAST_N == (-3)
ASSERT CELL(2) == (-3)
POP

# SSUBFROMATN: 0 - 0 → 0
CELLSET 3 0
PUSH 3
SSUBFROMATN 0
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SDIVFROMTOCN: 20 / 4 → 5
CELLSET 4 4
PUSH 4
SDIVFROMTOCN 20
ASSERT LAST_N == 5
ASSERT CELL(4) == 5
POP

# RDIVTOCN cell0 soft → 0
CELLSET 5 0
PUSH 5
RDIVTOCN 99
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SDIVFROMATN: 7 / 2 → 3
CELLSET 6 2
PUSH 6
SDIVFROMATN 7
ASSERT LAST_N == 3
ASSERT CELL(6) == 3
POP

# SMODFROMTOCN: 17 % 5 → 2  (n=17, cell=5)
CELLSET 7 5
PUSH 7
SMODFROMTOCN 17
ASSERT LAST_N == 2
ASSERT CELL(7) == 2
POP

# RMODTOCN cell0 soft → 0
CELLSET 8 0
PUSH 8
RMODTOCN 11
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# SMODFROMATN exact
CELLSET 9 5
PUSH 9
SMODFROMATN 15
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft fails empty stack
CLEARSTACK
SSUBFROMTOCN 1
ASSERT OK == 0
SDIVFROMTOCN 1
ASSERT OK == 0
SMODFROMTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof349_ssubfromtocn_smodfromtocn" LAST_N SP
HOLD_FLASH 1
