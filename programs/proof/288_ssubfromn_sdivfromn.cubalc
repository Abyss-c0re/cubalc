# Proof 288 — digit-9 stack imm reverse ALU: SSUBFROMN SDIVFROMN SMODFROMN
HOLD_FLASH 1
SCIENCE LOAD

# SSUBFROMN n — TOS = n - TOS
CLEARSTACK
PUSH 3
SSUBFROMN 10
POP x
ASSERT x == 7

CLEARSTACK
PUSH 10
SRSUBN 3
POP x
ASSERT x == -7

CLEARSTACK
PUSH -5
RSUBN 0
POP x
ASSERT x == 5

CLEARSTACK
PUSH 0
NSUBN 42
POP x
ASSERT x == 42

# SDIVFROMN n — TOS = n / TOS
CLEARSTACK
PUSH 5
SDIVFROMN 20
POP x
ASSERT x == 4

CLEARSTACK
PUSH 3
SRDIVN 10
POP x
ASSERT x == 3

CLEARSTACK
PUSH -2
RDIVN 10
POP x
ASSERT x == -5

CLEARSTACK
PUSH 0
SDIVFROMN 99
POP x
ASSERT x == 0

# SMODFROMN n — TOS = n % TOS
CLEARSTACK
PUSH 3
SMODFROMN 10
POP x
ASSERT x == 1

CLEARSTACK
PUSH 7
SRMODN 23
POP x
ASSERT x == 2

CLEARSTACK
PUSH 5
REMFROMN 17
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0
SMODFROMN 100
POP x
ASSERT x == 0

# soft fails
CLEARSTACK
SSUBFROMN 1
ASSERT OK == 0
CLEARSTACK
SDIVFROMN 1
ASSERT OK == 0
CLEARSTACK
SMODFROMN 1
ASSERT OK == 0

HOLD_FLASH 1
