# Proof 163 — digit-6 dual-stack: DSATMUL DRANDRANGE
HOLD_FLASH 1
SCIENCE LOAD

# DSATMUL — normal
CLEARSTACK
PUSH 6
PUSH 7
PUSH 5
PUSH 4
DSATMUL
POP y
POP x
ASSERT x == 30
ASSERT y == 28

# DSATMUL — saturate high
CLEARSTACK
PUSH 5000000000000000000
PUSH 3
PUSH 3
PUSH 2
2SATMUL
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 6

# DSATMUL — zero
CLEARSTACK
PUSH 0
PUSH 9
PUSH 100
PUSH 0
PAIRSATMUL
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DRANDRANGE — inclusive ranges
SEED 99
CLEARSTACK
PUSH 10
PUSH 0
PUSH 20
PUSH 5
DRANDRANGE
POP y
POP x
ASSERT x >= 10
ASSERT x <= 20
ASSERT y >= 0
ASSERT y <= 5

SEED 7
CLEARSTACK
PUSH 100
PUSH 50
PUSH 100
PUSH 50
2RANDRANGE
POP y
POP x
ASSERT x == 100
ASSERT y == 50

# inverted ends ok
SEED 1
CLEARSTACK
PUSH 20
PUSH 5
PUSH 10
PUSH 0
DRANDIN
POP y
POP x
ASSERT x >= 10
ASSERT x <= 20
ASSERT y >= 0
ASSERT y <= 5

# soft fails
CLEARSTACK
DSATMUL
ASSERT OK == 0
CLEARSTACK
DRANDRANGE
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2SATMUL
ASSERT OK == 0
CLEARSTACK
PUSH 1
2RANDRANGE
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof163_dsatmul_drandrange" LAST_N SP
