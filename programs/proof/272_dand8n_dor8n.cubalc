# Proof 272 — digit-3 dual-stack imm 8-bit field bitwise: DAND8N DOR8N DXOR8N
HOLD_FLASH 1
SCIENCE LOAD

# DAND8N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DAND8N 0x0F 0
POP y
POP x
ASSERT x == 0x1122334455667708
ASSERT y == 0x99AABBCCDDEEFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRAND8N 0x0F 1
POP y
POP x
ASSERT x == 0x1122334455660788
ASSERT y == 0x99AABBCCDDEE0F00

CLEARSTACK
PUSH -1
PUSH -1
DKEEP8N 0xAB 0
POP y
POP x
ASSERT x == -85
ASSERT y == -85

# DOR8N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DOR8N 0xF0 0
POP y
POP x
ASSERT x == 0x11223344556677F8
ASSERT y == 0x99AABBCCDDEEFFF0

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIROR8N 0xF0 2
POP y
POP x
ASSERT x == 0x1122334455F67788
ASSERT y == 0x99AABBCCDDFEFF00

CLEARSTACK
PUSH 0
PUSH 0
DSETOR8N 0xAB 3
POP y
POP x
ASSERT x == 0xAB000000
ASSERT y == 0xAB000000

# DXOR8N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXOR8N 0xFF 0
POP y
POP x
ASSERT x == 0x1122334455667777
ASSERT y == 0x99AABBCCDDEEFFFF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXOR8N 0x0F 7
POP y
POP x
ASSERT x == 0x1E22334455667788
ASSERT y == 0x96AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DFLIP8N 0xFF 0
POP y
POP x
ASSERT x == -256
ASSERT y == -256

# soft fails
CLEARSTACK
DAND8N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DOR8N 1 0
ASSERT OK == 0
CLEARSTACK
DXOR8N 1 0
ASSERT OK == 0

HOLD_FLASH 1
