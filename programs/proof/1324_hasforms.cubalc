# HASFORMS / NEEDFORMS multi form gates + form_guard lib

HASFORMS SORTLIBS LIBAGE FRESHLIBS
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT FORMMISS_N == 0
ASSERT HASFORMS_N == 3
ASSERT FORMS_N == 3

# soft miss bag
HASFORMS SORTLIBS NO_SUCH_FORM_XYZ_ZZZ LIBAGE
ASSERT OK == 0
ASSERT LAST_N == 0
ASSERT FORMMISS_N == 1
SYS HASLINE FORMMISS "NO_SUCH_FORM_XYZ_ZZZ"
ASSERT LAST_N == 1
CLEAR_ERR

# bag string
HASFORMS "HASFORM,NEEDFORM,HASFORMS"
ASSERT OK == 1
ASSERT LAST_N == 1

# NEEDFORMS hard pass
NEEDFORMS HASFORM SORTLIBS
ASSERT OK == 1
ASSERT LAST_N == 1

# form_guard default NEED_FORMS
INCLUDE form_guard
ASSERT OK == 1

# soft multi miss without re-INCLUDE defaults
HASFORMS "SORTLIBS\nNO_SUCH_FORM_XYZ_ZZZ"
ASSERT OK == 0
ASSERT FORMMISS_N >= 1
CLEAR_ERR

# soft form_guard: force knobs (DEFAULT is set-if-unset)
LET FORM_GUARD_SOFT = 1
LET NEED_FORMS = "SORTLIBS\nNO_SUCH_FORM_XYZ_ZZZ"
INCLUDE form_guard
ASSERT OK == 0
ASSERT FORMMISS_N >= 1
CLEAR_ERR

PASS
PRINT "1324_hasforms: PASS"
