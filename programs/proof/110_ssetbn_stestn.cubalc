# Proof 110 — digit-5 stack immediate bitfield: SSETBN SCLRBN SFLIPBN SBTESTN SSHLN SSHRN
HOLD_FLASH 1
SCIENCE LOAD

# SSETBN
CLEARSTACK
PUSH 0
SSETBN 3
ASSERT LAST_N == 8
SSETBN 0
ASSERT LAST_N == 9

# SCLRBN
CLEARSTACK
PUSH 15
SCLRBN 0
ASSERT LAST_N == 14
CLRBN 1
ASSERT LAST_N == 12

# SFLIPBN
CLEARSTACK
PUSH 15
SFLIPBN 0
ASSERT LAST_N == 14
FLIPBN 0
ASSERT LAST_N == 15

# SBTESTN
CLEARSTACK
PUSH 10
SBTESTN 1
ASSERT LAST_N == 1
CLEARSTACK
PUSH 10
TESTBITN 2
ASSERT LAST_N == 0
CLEARSTACK
PUSH 10
SBITN 3
ASSERT LAST_N == 1

# SSHLN / SSHRN
CLEARSTACK
PUSH 3
SSHLN 2
ASSERT LAST_N == 12
SHLN 1
ASSERT LAST_N == 24
SSHRN 3
ASSERT LAST_N == 3
SHRN 1
ASSERT LAST_N == 1

# chain with SADDN
CLEARSTACK
PUSH 1
SSETBN 4
ASSERT LAST_N == 17
SADDN 1
ASSERT LAST_N == 18
SBTESTN 4
ASSERT LAST_N == 1

# soft fail empty
CLEARSTACK
SSETBN 1
ASSERT OK == 0
SCLRBN 1
ASSERT OK == 0
SFLIPBN 1
ASSERT OK == 0
SBTESTN 0
ASSERT OK == 0
SSHLN 1
ASSERT OK == 0
SSHRN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof110_ssetbn_stestn" LAST_N SP
