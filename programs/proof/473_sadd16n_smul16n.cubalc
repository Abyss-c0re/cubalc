# Proof 473 — digit-3 stack imm 16-bit field arith merge: SADD16N SSUB16N SMUL16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SADD16N: 0x1000 + 0x0200 → 0x1200
PUSH 0x1000
SADD16N 0x200 0
POP x
ASSERT x == 0x1200

# wrap: 0xFFFF + 2 → 0x0001
CLEARSTACK
PUSH 0xFFFF
ADD16N 2 0
POP x
ASSERT x == 1

# high halfword preserved: 0x1122334400001000 + 0x55 → 0x1122334400001055
CLEARSTACK
PUSH 0x1122334400001000
SADD16N 0x55 0
POP x
ASSERT x == 0x1122334400001055

# STACKADD16N n1: half1 of 0x00020000 is 2 + 0x30 → 0x00320000
CLEARSTACK
PUSH 0x00020000
STACKADD16N 0x30 1
POP x
ASSERT x == 0x00320000

# SSUB16N: 0x0500 - 0x0100 → 0x0400
CLEARSTACK
PUSH 0x0500
SSUB16N 0x100 0
POP x
ASSERT x == 0x0400

# wrap borrow: 0x0001 - 0x0002 → 0xFFFF
CLEARSTACK
PUSH 0x0001
SUB16N 2 0
POP x
ASSERT x == 65535

# STACKSUB16N n1: half1 of 0x50000000 is 0x5000 - 0x1000 → 0x40000000
CLEARSTACK
PUSH 0x50000000
STACKSUB16N 0x1000 1
POP x
ASSERT x == 0x40000000

# SMUL16N: 0x0010 * 0x0010 → 0x0100
CLEARSTACK
PUSH 0x0010
SMUL16N 0x10 0
POP x
ASSERT x == 0x0100

# wrap mul: 0x0100 * 0x0100 → 0x10000 & 0xFFFF = 0
CLEARSTACK
PUSH 0x0100
MUL16N 0x100 0
POP x
ASSERT x == 0

# zero annihilator
CLEARSTACK
PUSH 0xABCD
SMUL16N 0 0
POP x
ASSERT x == 0

# high preserved mul: 0x1122334400000003 * 5 → 0x112233440000000F
CLEARSTACK
PUSH 0x1122334400000003
SMUL16N 5 0
POP x
ASSERT x == 0x112233440000000F

# STACKMUL16N n1: half1 of 0x00040000 * 3 → 0x000C0000
CLEARSTACK
PUSH 0x00040000
STACKMUL16N 3 1
POP x
ASSERT x == 0x000C0000

# SINC16N / SDEC16N aliases
CLEARSTACK
PUSH 0xFFFE
SINC16N 1 0
POP x
ASSERT x == 65535

CLEARSTACK
PUSH 0x0000
SDEC16N 1 0
POP x
ASSERT x == 65535

# round-trip add then sub
CLEARSTACK
PUSH 0xA55A
SADD16N 0x11 0
SSUB16N 0x11 0
POP x
ASSERT x == 0xA55A

HOLD_FLASH 0
