# Proof 233 — digit-9 dual-stack data-path imm mask/extract: DMASKN DANDMN DBEXTN
HOLD_FLASH 1
SCIENCE LOAD

# DMASKN — both become low-n mask
CLEARSTACK
PUSH 99
PUSH 88
DMASKN 4
POP y
POP x
ASSERT x == 15
ASSERT y == 15

CLEARSTACK
PUSH 1
PUSH 2
2MASKN 8
POP y
POP x
ASSERT x == 255
ASSERT y == 255

# PAIRMASKN / n=0 / n=64 all-ones
CLEARSTACK
PUSH 7
PUSH 7
PAIRMASKN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 0
PUSH 0
DMASKN 64
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DANDMN — keep low n bits
CLEARSTACK
PUSH 0xFF
PUSH 0xAB
DANDMN 4
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0x0B

CLEARSTACK
PUSH 0x1234
PUSH 0x5678
2ANDMN 8
POP y
POP x
ASSERT x == 0x34
ASSERT y == 0x78

# DKEEPLN alias
CLEARSTACK
PUSH 0xFFFF
PUSH 0x00FF
DKEEPLN 12
POP y
POP x
ASSERT x == 0x0FFF
ASSERT y == 0x00FF

# DBEXTN pos width
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
DBEXTN 4 4
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
2BEXTN 0 8
POP y
POP x
ASSERT x == 0xCD
ASSERT y == 0x34

# PAIRBEXTN mid field
CLEARSTACK
PUSH 0x00FF00
PUSH 0xFF0000
PAIRBEXTN 8 8
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0

# chain mask then and
CLEARSTACK
PUSH 0x123456
PUSH 0xABCDEF
DANDMN 16
POP y
POP x
ASSERT x == 0x3456
ASSERT y == 0xCDEF

# soft empty
CLEARSTACK
DMASKN 4
ASSERT OK == 0
