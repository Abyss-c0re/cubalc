# Proof 116 — digit-7 dual-stack pair ALU: DADD DSUB DMUL
HOLD_FLASH 1
SCIENCE LOAD

# DADD — (1,2)+(3,4) → (4,6)
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
DADD
ASSERT SP == 2
ASSERT LAST_N == 6
POP y
POP x
ASSERT x == 4
ASSERT y == 6

# 2ADD alias
CLEARSTACK
PUSH 10
PUSH 20
PUSH 1
PUSH 2
2ADD
POP y
POP x
ASSERT x == 11
ASSERT y == 22

# DSUB — (10,20)-(3,5) → (7,15)
CLEARSTACK
PUSH 10
PUSH 20
PUSH 3
PUSH 5
DSUB
POP y
POP x
ASSERT x == 7
ASSERT y == 15

# DMUL — (2,3)*(4,5) → (8,15)
CLEARSTACK
PUSH 2
PUSH 3
PUSH 4
PUSH 5
DMUL
POP y
POP x
ASSERT x == 8
ASSERT y == 15

# PAIRMUL / S2MUL aliases + negatives
CLEARSTACK
PUSH -2
PUSH 7
PUSH 3
PUSH -1
PAIRMUL
POP y
POP x
ASSERT x == -6
ASSERT y == -7

# chain: add then mul
CLEARSTACK
PUSH 1
PUSH 1
PUSH 2
PUSH 3
DADD
PUSH 2
PUSH 2
DMUL
POP y
POP x
ASSERT x == 6
ASSERT y == 8

# soft fail underfull
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DADD
ASSERT OK == 0
DSUB
ASSERT OK == 0
DMUL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof116_dadd_dmul" LAST_N SP
