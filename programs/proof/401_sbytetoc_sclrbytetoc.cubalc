# Proof 401 — digit-7 stack dual LE byte-field TOC: SBYTETOC SSETBYTETOC SCLRBYTETOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSETBYTETOC: build 0x04030201 = 67305985
CELLSET 1 0
PUSH 1
PUSH 1
PUSH 0
SSETBYTETOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
PUSH 2
PUSH 1
SSETBYTETOC
ASSERT LAST_N == 513
ASSERT CELL(1) == 513
POP
PUSH 1
PUSH 3
PUSH 2
SSETBYTETOC
ASSERT CELL(1) == 197121
POP
PUSH 1
PUSH 4
PUSH 3
SETBYTETOC
ASSERT LAST_N == 67305985
ASSERT CELL(1) == 67305985
POP

# SBYTETOC extract byte 1 of 0x04030201 → 2
CELLSET 2 67305985
PUSH 2
PUSH 1
SBYTETOC
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# BYTETOC alias: byte 0 of 0x1234=4660 → 0x34=52
CELLSET 3 4660
PUSH 3
PUSH 0
BYTETOC
ASSERT LAST_N == 52
ASSERT CELL(3) == 52
POP

# SCLRBYTETOC clear byte 0 of 0x01020304=16909060 → 0x01020300=16909056
CELLSET 4 16909060
PUSH 4
PUSH 0
SCLRBYTETOC
ASSERT LAST_N == 16909056
ASSERT CELL(4) == 16909056
POP

# CLRBYTETOC then extract byte 2 → 0
CELLSET 5 2864434397
PUSH 5
PUSH 2
CLRBYTETOC
POP
PUSH 5
PUSH 2
SBYTETOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft short stack OK=0
CLEARSTACK
SBYTETOC
ASSERT OK == 0
PUSH 1
SSETBYTETOC
ASSERT OK == 0

PRINT "401_sbytetoc_sclrbytetoc OK"
