# Proof 396 — digit-6 stack dual high-n mask TOC: SANDHNTOC SORHNTOC SXORHNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# all-ones via SORMNTOC 64
CELLSET 1 0
PUSH 1
PUSH 64
SORMNTOC
POP
# SANDHNTOC: keep high 4 of all-ones → signed negative
PUSH 1
PUSH 4
SANDHNTOC
ASSERT LAST_N < 0
ASSERT CELL(1) < 0
POP a
ASSERT a < 0

# ANDHNTOC n=0 → 0
CELLSET 2 99
PUSH 2
PUSH 0
ANDHNTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SORHNTOC: set high 1 bit of 0 → MSB only (signed negative)
CELLSET 3 0
PUSH 3
PUSH 1
SORHNTOC
ASSERT LAST_N < 0
ASSERT CELL(3) < 0
POP

# ORHNTOC n=0: no-op leave 7
CELLSET 4 7
PUSH 4
PUSH 0
ORHNTOC
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
POP

# SXORHNTOC: 0 ^ high-2 → two high bits; toggle again → 0
CELLSET 5 0
PUSH 5
PUSH 2
SXORHNTOC
ASSERT LAST_N < 0
ASSERT CELL(5) < 0
POP
PUSH 5
PUSH 2
XORHNTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft short stack OK=0
CLEARSTACK
SANDHNTOC
ASSERT OK == 0
PUSH 1
SORHNTOC
ASSERT OK == 0

PRINT "396_sandhntoc_sxorhntoc OK"
