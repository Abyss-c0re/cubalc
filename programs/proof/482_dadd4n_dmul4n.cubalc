# Proof 482 — digit-2 dual-stack imm 4-bit field arith: DADD4N DSUB4N DMUL4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DADD4N: nibble0 + 2
PUSH 0x3
PUSH 0x5
DADD4N 2 0
POP y
POP x
ASSERT x == 0x5
ASSERT y == 0x7

# wrap: 0xF + 2 → 0x1 both
CLEARSTACK
PUSH 0xF
PUSH 0xE
PAIRADD4N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# high preserved: nibble0 + 1
CLEARSTACK
PUSH 0x1122334455667703
PUSH 0x99AABBCCDDEEFF07
DADD4N 1 0
POP y
POP x
ASSERT x == 0x1122334455667704
ASSERT y == 0x99AABBCCDDEEFF08

# S2ADD4N n1: nibble1 of each + 3
CLEARSTACK
PUSH 0x20
PUSH 0x40
S2ADD4N 3 1
POP y
POP x
ASSERT x == 0x50
ASSERT y == 0x70

# DINC4N alias
CLEARSTACK
PUSH 0xE
PUSH 0x1
DINC4N 1 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 0x2

# DSUB4N
CLEARSTACK
PUSH 0x8
PUSH 0x5
DSUB4N 2 0
POP y
POP x
ASSERT x == 0x6
ASSERT y == 0x3

# wrap borrow: 0x1 - 2 → 0xF
CLEARSTACK
PUSH 0x1
PUSH 0x0
PAIRSUB4N 2 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 0xE

# STACK2SUB4N n1
CLEARSTACK
PUSH 0x50
PUSH 0x30
STACK2SUB4N 1 1
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0x20

# DDEC4N alias
CLEARSTACK
PUSH 0x0
PUSH 0x5
DDEC4N 1 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 0x4

# DMUL4N wrap: 0x8 * 0x3 = 0x18 & 0xF = 0x8
CLEARSTACK
PUSH 0x8
PUSH 0x4
DMUL4N 3 0
POP y
POP x
ASSERT x == 0x8
ASSERT y == 0xC

# small mul
CLEARSTACK
PUSH 0x3
PUSH 0x4
PAIRMUL4N 2 0
POP y
POP x
ASSERT x == 0x6
ASSERT y == 0x8

# zero annihilator
CLEARSTACK
PUSH 0xA
PUSH 0xB
DMUL4N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved mul: nibble0 * 2
CLEARSTACK
PUSH 0x1122334455667703
PUSH 0x99AABBCCDDEEFF05
DMUL4N 2 0
POP y
POP x
ASSERT x == 0x1122334455667706
ASSERT y == 0x99AABBCCDDEEFF0A

# S2MUL4N n1: nibble1 * 2
CLEARSTACK
PUSH 0x40
PUSH 0x50
S2MUL4N 2 1
POP y
POP x
ASSERT x == 0x80
ASSERT y == 0xA0

# DTIMES4N alias
CLEARSTACK
PUSH 0x3
PUSH 0x2
DTIMES4N 3 0
POP y
POP x
ASSERT x == 0x9
ASSERT y == 0x6

# round-trip add then sub
CLEARSTACK
PUSH 0xA
PUSH 0x3
DADD4N 2 0
DSUB4N 2 0
POP y
POP x
ASSERT x == 0xA
ASSERT y == 0x3

HOLD_FLASH 0
