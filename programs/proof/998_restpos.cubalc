# REQUIRE RESTPOS / HASRESTPOS — files after subcommand

HOLD_FLASH 1

# empty
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
HASRESTPOS
ASSERT LAST_N == 0
ASSERT RESTPOS_N == 0

# only subcommand -> 0 files
SYS ENV SET CUBALC_ARG0 "seal"
SYS ENV SET CUBALC_ARGC "1"
HASRESTPOS 1
ASSERT LAST_N == 0
ASSERT RESTPOS_N == 0
HASRESTPOS 0
ASSERT LAST_N == 1

# subcommand + 2 files
SYS ENV SET CUBALC_ARG0 "parse"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARG2 "b.txt"
SYS ENV SET CUBALC_ARGC "3"
HASRESTPOS 1
ASSERT LAST_N == 1
HASRESTPOS 2
ASSERT LAST_N == 1
HASRESTPOS 3
ASSERT LAST_N == 0
ASSERT RESTPOS_N == 2

# REQUIRE success
REQUIRE RESTPOS 2
ASSERT LAST_N == 2
SYS HASLINE LAST "a.txt"
ASSERT LAST_N == 1
SYS HASLINE RESTPOS "b.txt"
ASSERT LAST_N == 1

# flags do not inflate (prefer --name=val)
SYS ENV SET CUBALC_ARG0 "--verbose=1"
SYS ENV SET CUBALC_ARG1 "seal"
SYS ENV SET CUBALC_ARG2 "out.bin"
SYS ENV SET CUBALC_ARGC "3"
HASRESTPOS 1
ASSERT LAST_N == 1
REQUIRE RESTPOS 1
SYS EQS LAST "out.bin"
ASSERT LAST_N == 1

# TAILPOS alias require
SYS ENV SET CUBALC_ARG0 "list"
SYS ENV SET CUBALC_ARG1 "x"
SYS ENV SET CUBALC_ARGC "2"
REQUIRE TAILPOS 1
ASSERT RESTPOS_N == 1

# full CLI pattern with SUBCMD
SYS ENV SET CUBALC_ARG0 "parse"
SYS ENV SET CUBALC_ARG1 "in.cubalc"
SYS ENV SET CUBALC_ARGC "2"
SUBCMD OR "help"
REQUIRE ONEOF LAST "list", "seal", "parse", "help"
REQUIRE RESTPOS 1
ASSERT OK == 1
ASSERT RESTPOS_N == 1

PRINT "restpos ok"
