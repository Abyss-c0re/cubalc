# ERRGUIDE — ERRTIPS classify + GUIDE playbook one-shot (ERRRUN twin)

ERRGUIDE
ASSERT OK == 1
ASSERT ERRGUIDE_TOPIC == "general"
ASSERT ERRTIPS_N >= 1
ASSERT GUIDE_RELATED_N >= 3
SYS HASI "cubalc.errguide.v1"
ASSERT LAST_N == 1

FAIL "INCLUDE missing hold_seed"
ERRGUIDE
ASSERT ERRGUIDE_TOPIC == "lib"
ASSERT ERRTIPS_TOPIC == "lib"
ASSERT ERRTIPS_N >= 1
ASSERT GUIDE_RELATED_N >= 3
SYS HASI "LISTLIBS"
ASSERT LAST_N == 1
CLEAR_ERR

FAIL "unknown form ZZZ did you mean"
ERRGUIDE
ASSERT ERRGUIDE_TOPIC == "cap"
ASSERT GUIDE_FORMS_N >= 2
SYS HASI "HASFORM"
ASSERT LAST_N == 1
CLEAR_ERR

ERRGUIDE "SMX DIAL timeout"
ASSERT ERRGUIDE_TOPIC == "p2p"
SYS HASI "protect"
ASSERT LAST_N == 1

ERRGUIDE "ASSERT is false"
ASSERT ERRGUIDE_TOPIC == "run"
SYS HASI "WHY"
ASSERT LAST_N == 1

# alias
RECOVERGUIDE "VARROOM NEEDVARROOM"
ASSERT ERRGUIDE_TOPIC == "fat"
ASSERT GUIDE_RELATED_N >= 3

ERRGUIDE "NEEDP missing key"
ASSERT ERRGUIDE_TOPIC == "plate"
SYS HASI "SETP"
ASSERT LAST_N == 1

PASS
PRINT "1343_errguide: PASS"
