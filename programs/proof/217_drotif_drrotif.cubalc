# Proof 217 — digit-1 dual-stack control rotate conditionals: DROTIF DRROTIF
HOLD_FLASH 1
SCIENCE LOAD

# DROTIF true → ROT (a b c → b c a)
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 1
DROTIF
POP z
POP y
POP x
ASSERT x == 2
ASSERT y == 3
ASSERT z == 1

# false → leave a b c
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 0
2ROTIF
POP z
POP y
POP x
ASSERT x == 10
ASSERT y == 20
ASSERT z == 30

# PAIRROTIF / DQROT
CLEARSTACK
PUSH 4
PUSH 5
PUSH 6
PUSH -1
PAIRROTIF
POP z
POP y
POP x
ASSERT x == 5
ASSERT y == 6
ASSERT z == 4

CLEARSTACK
PUSH 7
PUSH 8
PUSH 9
PUSH 0
DQROT
POP z
POP y
POP x
ASSERT x == 7
ASSERT y == 8
ASSERT z == 9

# DROTWHEN alias
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 1
DROTWHEN
POP z
POP y
POP x
ASSERT x == 2
ASSERT y == 3
ASSERT z == 1

# DRROTIF true → RROT (a b c → c a b)
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 1
DRROTIF
POP z
POP y
POP x
ASSERT x == 3
ASSERT y == 1
ASSERT z == 2

# false → leave
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 0
2RROTIF
POP z
POP y
POP x
ASSERT x == 10
ASSERT y == 20
ASSERT z == 30

# PAIRRROTIF / DQRROT / DNROTIF
CLEARSTACK
PUSH 4
PUSH 5
PUSH 6
PUSH 1
PAIRRROTIF
POP z
POP y
POP x
ASSERT x == 6
ASSERT y == 4
ASSERT z == 5

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 0
DQRROT
POP z
POP y
POP x
ASSERT x == 1
ASSERT y == 2
ASSERT z == 3

CLEARSTACK
PUSH 9
PUSH 8
PUSH 7
PUSH 1
DNROTIF
POP z
POP y
POP x
ASSERT x == 7
ASSERT y == 9
ASSERT z == 8

# DRROTWHEN alias
CLEARSTACK
PUSH 0
PUSH 1
PUSH 2
PUSH 1
DRROTWHEN
POP z
POP y
POP x
ASSERT x == 2
ASSERT y == 0
ASSERT z == 1
