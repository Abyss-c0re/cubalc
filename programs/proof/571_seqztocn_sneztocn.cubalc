# Proof 571 — digit-3 pure-imm cell zero-eq/ne TOC: SEQZTOCN SNEZTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SEQZTOCN: zero → 1
CELLSET 1 0
SEQZTOCN 1
POP x
ASSERT x == 1
ASSERT CELL(1) == 1

# nonzero → 0
CLEARSTACK
CELLSET 2 5
S0EQTOCN 2
POP x
ASSERT x == 0
ASSERT CELL(2) == 0

# negative nonzero → 0
CLEARSTACK
CELLSET 3 (-4)
SISZEROTOCN 3
POP x
ASSERT x == 0
ASSERT CELL(3) == 0

# S0EQATN alias zero
CLEARSTACK
CELLSET 4 0
S0EQATN 4
POP x
ASSERT x == 1
ASSERT CELL(4) == 1

# SZTOCN / EQZTOCN
CLEARSTACK
CELLSET 5 7
SZTOCN 5
POP x
ASSERT x == 0
ASSERT CELL(5) == 0

CLEARSTACK
CELLSET 6 0
EQZTOCN 6
POP x
ASSERT x == 1
ASSERT CELL(6) == 1

# SNEZTOCN: zero → 0
CLEARSTACK
CELLSET 7 0
SNEZTOCN 7
POP x
ASSERT x == 0
ASSERT CELL(7) == 0

# nonzero positive → 1
CLEARSTACK
CELLSET 8 3
S0NETOCN 8
POP x
ASSERT x == 1
ASSERT CELL(8) == 1

# nonzero negative → 1
CLEARSTACK
CELLSET 9 (-1)
SISNZTOCN 9
POP x
ASSERT x == 1
ASSERT CELL(9) == 1

# S0NEATN / SNZTOCN / SNONZEROTOCN
CLEARSTACK
CELLSET 10 0
S0NEATN 10
POP x
ASSERT x == 0
ASSERT CELL(10) == 0

CLEARSTACK
CELLSET 11 2
SNZTOCN 11
POP x
ASSERT x == 1
ASSERT CELL(11) == 1

CLEARSTACK
CELLSET 12 (-9)
SNONZEROTOCN 12
POP x
ASSERT x == 1
ASSERT CELL(12) == 1

# SCELLEQZN / SCELLNEZN
CLEARSTACK
CELLSET 13 0
SCELLEQZN 13
POP x
ASSERT x == 1
ASSERT CELL(13) == 1

CLEARSTACK
CELLSET 14 1
SCELLNEZN 14
POP x
ASSERT x == 1
ASSERT CELL(14) == 1

HOLD_FLASH 0
