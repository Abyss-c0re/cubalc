# Proof 42 — stack double-cell digit-8: 2OVER 2ROT 2NIP
HOLD_FLASH 1
SCIENCE LOAD

# 2OVER: a b c d → a b c d a b
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2OVER
ASSERT SP == 6
ASSERT LAST_N == 2
DROP
PEEK
ASSERT LAST_N == 1
DROP
PEEK
ASSERT LAST_N == 4

# aliases OVER2
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
OVER2
ASSERT SP == 6
PEEK
ASSERT LAST_N == 20

# 2ROT: a b c d e f → c d e f a b
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
2ROT
ASSERT SP == 6
ASSERT LAST_N == 2
DROP
PEEK
ASSERT LAST_N == 1
DROP
PEEK
ASSERT LAST_N == 6
DROP
PEEK
ASSERT LAST_N == 5
DROP
PEEK
ASSERT LAST_N == 4
DROP
PEEK
ASSERT LAST_N == 3

# 2NIP: a b c d → a b d
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2NIP
ASSERT SP == 3
ASSERT LAST_N == 4
DROP
PEEK
ASSERT LAST_N == 2
DROP
PEEK
ASSERT LAST_N == 1

# underflow
CLEARSTACK
PUSH 1
PUSH 2
2OVER
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2ROT
ASSERT OK == 0
CLEARSTACK
2NIP
ASSERT OK == 0

# compose: 2OVER then 2SWAP on top pairs
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2OVER
2SWAP
ASSERT SP == 6
PEEK
ASSERT LAST_N == 4

# 2DUP compose
CLEARSTACK
PUSH 7
PUSH 8
2DUP
ASSERT SP == 4
2OVER
ASSERT SP == 6
ASSERT LAST_N == 8

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof42_stack_double" LAST_N SP
