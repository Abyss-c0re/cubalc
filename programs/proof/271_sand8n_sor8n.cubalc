# Proof 271 — digit-8 stack imm 8-bit field bitwise: SAND8N SOR8N SXOR8N
HOLD_FLASH 1
SCIENCE LOAD

# SAND8N field n
CLEARSTACK
PUSH 0x1122334455667788
SAND8N 0x0F 0
POP x
ASSERT x == 0x1122334455667708

CLEARSTACK
PUSH 0x1122334455667788
STACKAND8N 0x0F 1
POP x
ASSERT x == 0x1122334455660788

CLEARSTACK
PUSH -1
AND8N 0xAB 0
POP x
ASSERT x == -85

# SOR8N field n
CLEARSTACK
PUSH 0x1122334455667788
SOR8N 0xF0 0
POP x
ASSERT x == 0x11223344556677F8

CLEARSTACK
PUSH 0x1122334455667788
STACKOR8N 0xF0 2
POP x
ASSERT x == 0x1122334455F67788

CLEARSTACK
PUSH 0
OR8N 0xCD 0
POP x
ASSERT x == 0xCD

CLEARSTACK
PUSH 0
SSETOR8N 0xAB 3
POP x
ASSERT x == 0xAB000000

# SXOR8N field n
CLEARSTACK
PUSH 0x1122334455667788
SXOR8N 0xFF 0
POP x
ASSERT x == 0x1122334455667777

CLEARSTACK
PUSH 0x1122334455667788
STACKXOR8N 0x0F 7
POP x
ASSERT x == 0x1E22334455667788

CLEARSTACK
PUSH 0
XOR8N 0xAB 1
POP x
ASSERT x == 0xAB00

CLEARSTACK
PUSH -1
SFLIP8N 0xFF 0
POP x
ASSERT x == -256

# clamp n
CLEARSTACK
PUSH 0x1122334455667788
SAND8N 0x0F 99
POP x
ASSERT x == 0x0122334455667788

# soft fails
CLEARSTACK
SAND8N 1 0
ASSERT OK == 0
CLEARSTACK
SOR8N 1 0
ASSERT OK == 0
CLEARSTACK
SXOR8N 1 0
ASSERT OK == 0

HOLD_FLASH 1
