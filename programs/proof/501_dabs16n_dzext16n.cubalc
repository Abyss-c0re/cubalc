# Proof 501 — digit-5 dual-stack imm 16-bit field abs+extend: DABS16N DSEXT16N DZEXT16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DABS16N: 0xFFFE (-2)→2 ; 0x0005→5
PUSH 0xFFFE
PUSH 0x0005
DABS16N 0
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# min int16 -32768 stays 0x8000
CLEARSTACK
PUSH 0x8000
PUSH 0x8000
PAIRABS16N 0
POP y
POP x
ASSERT x == 32768
ASSERT y == 32768

# high preserved abs: 0xFFFE→2; 0xFFFD→3
CLEARSTACK
PUSH 0x11223344FFFE
PUSH 0x99AABBCCFFFD
DABS16N 0
POP y
POP x
ASSERT x == 0x112233440002
ASSERT y == 0x99AABBCC0003

# S2ABS16N n1: 0xFFFE0001 half1=FFFE=-2 → abs 2 → 0x00020001
CLEARSTACK
PUSH 0xFFFE0001
PUSH 0xFFFC0002
S2ABS16N 1
POP y
POP x
ASSERT x == 0x00020001
ASSERT y == 0x00040002

# DSEXT16N: 0x7FFF→32767 ; 0xFFFE→-2 ; 0x8000→-32768
CLEARSTACK
PUSH 0x7FFF
PUSH 0xFFFE
DSEXT16N 0
POP y
POP x
ASSERT x == 32767
ASSERT y == -2

CLEARSTACK
PUSH 0x8000
PUSH 0x0
PAIRSEXT16N 0
POP y
POP x
ASSERT x == -32768
ASSERT y == 0

# S2SEXT16N n1: 0xA0000001 half1=A000=-24576
CLEARSTACK
PUSH 0xA0000001
PUSH 0xC0000002
S2SEXT16N 1
POP y
POP x
ASSERT x == -24576
ASSERT y == -16384

# high ignored: 0x1FFFF → -1
CLEARSTACK
PUSH 0x1FFFF
PUSH 0xFFFF
DSEXT16N 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DZEXT16N: extract halfword
CLEARSTACK
PUSH 0xABCD1234
PUSH 0x5678EF01
DZEXT16N 0
POP y
POP x
ASSERT x == 0x1234
ASSERT y == 0xEF01

CLEARSTACK
PUSH 0xABCD1234
PUSH 0x5678EF01
PAIRZEXT16N 1
POP y
POP x
ASSERT x == 0xABCD
ASSERT y == 0x5678

# STACK2ZEXT16N n2 of 0x112233445566: half2=0x1122
CLEARSTACK
PUSH 0x112233445566
PUSH 0xAABBCCDDEEFF
STACK2ZEXT16N 2
POP y
POP x
ASSERT x == 0x1122
ASSERT y == 0xAABB

# aliases
CLEARSTACK
PUSH 0xFFFC
PUSH 0x0009
DIABS16N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 9

CLEARSTACK
PUSH 0xFFFC
PUSH 0x0009
DWORDSEXTN 0
POP y
POP x
ASSERT x == -4
ASSERT y == 9

CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x0000FFFF
DWORDZEXTN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 65535

HOLD_FLASH 0
