# Proof 512 — digit-1 dual-stack imm 32-bit field unary+rotate: DNOT32N DROL32N DROR32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DNOT32N n0: 0 → FFFFFFFF ; 0x00FF → FFFFFF00
PUSH 0x0
PUSH 0x00FF
DNOT32N 0
POP y
POP x
ASSERT x == 4294967295
ASSERT y == 4294967040

# high preserved not word0
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNOT32N 0
POP y
POP x
ASSERT x == 0x11223344AA998877
ASSERT y == 0x99AABBCC221100FF

# S2NOT32N n1: high word
CLEARSTACK
PUSH 0xAAAA000100000001
PUSH 0x5555000200000002
S2NOT32N 1
POP y
POP x
ASSERT x == 0x5555FFFE00000001
ASSERT y == 0xAAAAFFFD00000002

# DINV32N alias: FFFFFFFF → 0 both
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFF
DINV32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DROL32N k=1 n0: 0x80000001 → 3 ; 0x00000001 → 2
CLEARSTACK
PUSH 0x80000001
PUSH 0x00000001
DROL32N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved rol
CLEARSTACK
PUSH 0x1122334480000001
PUSH 0x99AABBCC00000001
PAIRROL32N 1 0
POP y
POP x
ASSERT x == 0x1122334400000003
ASSERT y == 0x99AABBCC00000002

# STACK2ROL32N n1
CLEARSTACK
PUSH 0x0000000100000002
PUSH 0x0000000300000004
STACK2ROL32N 1 1
POP y
POP x
ASSERT x == 0x0000000200000002
ASSERT y == 0x0000000600000004

# DROR32N k=1 n0: 2→1 ; 1→80000000
CLEARSTACK
PUSH 0x00000002
PUSH 0x00000001
DROR32N 1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2147483648

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA55A0033
PUSH 0x12345678
DROL32N 7 0
DROR32N 7 0
POP y
POP x
ASSERT x == 0xA55A0033
ASSERT y == 0x12345678

# k masked: k=33 → k&31=1
CLEARSTACK
PUSH 0x00000001
PUSH 0x00000001
DROR32N 33 0
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 2147483648

# STACK2ROR32N n1
CLEARSTACK
PUSH 0x0000000200000000
PUSH 0x0000000400000000
STACK2ROR32N 1 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000200000000

# DROTL32N alias
CLEARSTACK
PUSH 0x10000000
PUSH 0x20000000
DROTL32N 1 0
POP y
POP x
ASSERT x == 0x20000000
ASSERT y == 0x40000000

# DNOTDWN alias
CLEARSTACK
PUSH 0x00FF
PUSH 0x00FF
DNOTDWN 0
POP y
POP x
ASSERT x == 4294967040
ASSERT y == 4294967040

HOLD_FLASH 0
