# Proof 296 — digit-4 dual-stack zero/sign preds: D0EQ D0NE D0LT D0GT
HOLD_FLASH 1
SCIENCE LOAD

# D0EQ / DZ — zero test pair
CLEARSTACK
PUSH 0
PUSH 5
D0EQ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0
PUSH 0
PAIR0EQ
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 3
PUSH -1
DZ
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# D0NE / DNZ — nonzero test pair
CLEARSTACK
PUSH 0
PUSH 7
D0NE
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -2
PUSH 0
PAIR0NE
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 2
DNZ
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# D0LT — negative test pair
CLEARSTACK
PUSH -5
PUSH 0
D0LT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH -9
PAIR0LT
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# D0GT / DPOS — positive test pair
CLEARSTACK
PUSH 4
PUSH -1
D0GT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0
PUSH 8
PAIR0GT
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 1
PUSH 2
DPOS
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# chain with DSIGN (sibling)
CLEARSTACK
PUSH -3
PUSH 5
DSIGN
POP y
POP x
ASSERT x == -1
ASSERT y == 1

# soft fails
CLEARSTACK
D0EQ
ASSERT OK == 0
CLEARSTACK
PUSH 1
D0NE
ASSERT OK == 0
CLEARSTACK
D0LT
ASSERT OK == 0
CLEARSTACK
PUSH 0
D0GT
ASSERT OK == 0

HOLD_FLASH 1
