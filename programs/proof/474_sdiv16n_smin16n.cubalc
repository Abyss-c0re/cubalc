# Proof 474 — digit-7 stack imm 16-bit field div/mod/min: SDIV16N SMOD16N SMIN16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SDIV16N: 0x0064 / 0x000A → 0x000A
PUSH 0x0064
SDIV16N 10 0
POP x
ASSERT x == 10

# floor: 0x0017 / 5 → 4
CLEARSTACK
PUSH 0x0017
DIV16N 5 0
POP x
ASSERT x == 4

# div by zero → 0
CLEARSTACK
PUSH 0xFFFF
SDIV16N 0 0
POP x
ASSERT x == 0

# high preserved: 0x11223344000000C8 / 4 → 0x1122334400000032
CLEARSTACK
PUSH 0x11223344000000C8
SDIV16N 4 0
POP x
ASSERT x == 0x1122334400000032

# STACKDIV16N n1: half1 of 0x00640000 / 10 → 0x000A0000
CLEARSTACK
PUSH 0x00640000
STACKDIV16N 10 1
POP x
ASSERT x == 0x000A0000

# SMOD16N: 0x0017 % 5 → 3 (23%5)
CLEARSTACK
PUSH 0x0017
SMOD16N 5 0
POP x
ASSERT x == 3

# exact: 0x0064 % 10 → 0
CLEARSTACK
PUSH 0x0064
MOD16N 10 0
POP x
ASSERT x == 0

# mod by zero → 0
CLEARSTACK
PUSH 0xABCD
SREM16N 0 0
POP x
ASSERT x == 0

# STACKMOD16N n1: half1 of 0x00170000 % 5 → 0x00030000
CLEARSTACK
PUSH 0x00170000
STACKMOD16N 5 1
POP x
ASSERT x == 0x00030000

# SMIN16N: min(0xC000, 0x4000) → 0x4000
CLEARSTACK
PUSH 0xC000
SMIN16N 0x4000 0
POP x
ASSERT x == 0x4000

# keeps smaller
CLEARSTACK
PUSH 0x0010
MIN16N 0x9000 0
POP x
ASSERT x == 0x0010

# high preserved min: 0x112233440000FFFE min 0x20 → 0x1122334400000020
CLEARSTACK
PUSH 0x112233440000FFFE
SMIN16N 0x20 0
POP x
ASSERT x == 0x1122334400000020

# STACKMIN16N n1: half1 of 0xFFFF0000 min 0x0011 → 0x00110000
CLEARSTACK
PUSH 0xFFFF0000
STACKMIN16N 0x11 1
POP x
ASSERT x == 0x00110000

# SLE16N alias min equal
CLEARSTACK
PUSH 0x5555
SLE16N 0x5555 0
POP x
ASSERT x == 0x5555

# SQUO16N alias div
CLEARSTACK
PUSH 0x001E
SQUO16N 6 0
POP x
ASSERT x == 5

HOLD_FLASH 0
