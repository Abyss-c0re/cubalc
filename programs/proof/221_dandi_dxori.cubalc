# Proof 221 — digit-0 dual-stack immediate bitwise mask: DANDI DORI DXORI
HOLD_FLASH 1
SCIENCE LOAD

# DANDI
CLEARSTACK
PUSH 0xFF
PUSH 0xF0
DANDI 0x0F
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0

CLEARSTACK
PUSH 0xAA
PUSH 0x55
2ANDI 0x0F
POP y
POP x
ASSERT x == 0x0A
ASSERT y == 0x05

# PAIRANDI / DANDIMM
CLEARSTACK
PUSH 0xFFFF
PUSH 0x00FF
PAIRANDI 0xF0
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0xF0

CLEARSTACK
PUSH 7
PUSH 15
DANDIMM 3
POP y
POP x
ASSERT x == 3
ASSERT y == 3

# DORI
CLEARSTACK
PUSH 0x0F
PUSH 0x00
DORI 0xF0
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0xF0

CLEARSTACK
PUSH 1
PUSH 2
2ORI 4
POP y
POP x
ASSERT x == 5
ASSERT y == 6

# PAIRORI
CLEARSTACK
PUSH 0
PUSH 0
PAIRORI 0xAA
POP y
POP x
ASSERT x == 0xAA
ASSERT y == 0xAA

# DXORI
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
DXORI 0x0F
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0

CLEARSTACK
PUSH 0xAA
PUSH 0x55
2XORI 0xFF
POP y
POP x
ASSERT x == 0x55
ASSERT y == 0xAA

# PAIRXORI / DXORIMM
CLEARSTACK
PUSH 1
PUSH 3
PAIRXORI 1
POP y
POP x
ASSERT x == 0
ASSERT y == 2

CLEARSTACK
PUSH 0xF0
PUSH 0x0F
DXORIMM 0xFF
POP y
POP x
ASSERT x == 0x0F
ASSERT y == 0xF0

# chain AND then OR
CLEARSTACK
PUSH 0xFF
PUSH 0xAA
DANDI 0x0F
DORI 0xF0
POP y
POP x
ASSERT x == 0xFF
ASSERT y == 0xFA
