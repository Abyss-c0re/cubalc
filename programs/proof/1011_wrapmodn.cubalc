# WRAPMODN / POSMODN — positive remainder x mod m in [0, m)

HOLD_FLASH 1

WRAPMODN 7 5
ASSERT LAST_N == 2
ASSERT WRAPMODN_OK == 1
ASSERT POSMODN == 2

WRAPMODN 10 5
ASSERT LAST_N == 0

WRAPMODN 0 8
ASSERT LAST_N == 0

WRAPMODN -1 5
ASSERT LAST_N == 4
WRAPMODN -7 5
ASSERT LAST_N == 3
WRAPMODN -5 5
ASSERT LAST_N == 0

WRAPMODN 3 8
ASSERT LAST_N == 3

POSMODN 12 10
ASSERT LAST_N == 2
WMODN 15 7
ASSERT LAST_N == 1
RINGMODN -3 4
ASSERT LAST_N == 1
CIRCMODN 9 4
ASSERT LAST_N == 1

WRAPMODN 11 BY 4
ASSERT LAST_N == 3
WRAPMODN 14 MOD 6
ASSERT LAST_N == 2

WRAPMODN 5 0
ASSERT LAST_N == 0
ASSERT WRAPMODN_OK == 0
LET e = LAST_ERR
SYS LEN e
ASSERT LAST_N > 0

LET mneg = 0
LET mneg = mneg - 3
WRAPMODN 5 mneg
ASSERT LAST_N == 0
ASSERT WRAPMODN_OK == 0

LET x = 0
LET x = x - 8
LET m = 5
WRAPMODN x m
ASSERT LAST_N == 2

WRAPMODN 7 3
SYS EQS LAST "1"
ASSERT LAST_N == 1

WRAPMODN 100 7
ASSERT LAST_N == 2

PRINT "wrapmodn ok"
