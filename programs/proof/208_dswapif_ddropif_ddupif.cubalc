# Proof 208 — digit-1 dual-stack conditionals: DSWAPIF DDROPIF DDUPIF
HOLD_FLASH 1
SCIENCE LOAD

# DSWAPIF true → swap
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
DSWAPIF
POP y
POP x
ASSERT x == 2
ASSERT y == 1

# false → keep order
CLEARSTACK
PUSH 10
PUSH 20
PUSH 0
2SWAPIF
POP y
POP x
ASSERT x == 10
ASSERT y == 20

# PAIRSWAPIF / DQSWAP nonzero flag
CLEARSTACK
PUSH 7
PUSH 8
PUSH -1
PAIRSWAPIF
POP y
POP x
ASSERT x == 8
ASSERT y == 7

CLEARSTACK
PUSH 3
PUSH 4
PUSH 0
DQSWAP
POP y
POP x
ASSERT x == 3
ASSERT y == 4

# DDROPIF true → drop pair
CLEARSTACK
PUSH 99
PUSH 1
PUSH 2
PUSH 1
DDROPIF
POP spv
ASSERT spv == 99

# false → keep pair
CLEARSTACK
PUSH 5
PUSH 6
PUSH 0
2DROPIF
POP y
POP x
ASSERT x == 5
ASSERT y == 6

# PAIRDROPIF drop
CLEARSTACK
PUSH 0
PUSH 11
PUSH 22
PUSH 1
PAIRDROPIF
POP spv
ASSERT spv == 0

# DQDROP keep
CLEARSTACK
PUSH 30
PUSH 40
PUSH 0
DQDROP
POP y
POP x
ASSERT x == 30
ASSERT y == 40

# DDUPIF true → pair-dup
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
DDUPIF
POP d
POP c
POP b
POP a
ASSERT a == 1
ASSERT b == 2
ASSERT c == 1
ASSERT d == 2

# false → no dup
CLEARSTACK
PUSH 9
PUSH 8
PUSH 0
2DUPIF
POP y
POP x
ASSERT x == 9
ASSERT y == 8

# PAIRDUPIF
CLEARSTACK
PUSH 4
PUSH 5
PUSH 1
PAIRDUPIF
POP d
POP c
POP b
POP a
ASSERT a == 4
ASSERT b == 5
ASSERT c == 4
ASSERT d == 5

# D2QDUP false
CLEARSTACK
PUSH 6
PUSH 7
PUSH 0
D2QDUP
POP y
POP x
ASSERT x == 6
ASSERT y == 7
