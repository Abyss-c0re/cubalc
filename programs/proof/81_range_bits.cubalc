# Proof 81 — digit-3 COP matrix range: FILL/CLEAR/FLIP/COUNT RANGE
HOLD_FLASH 1
SCIENCE LOAD

CUBE m ROLE matrix PROTON 1
CLEARBITS m
ONES m
ASSERT LAST_N == 0

# FILLRANGE 0..3 → 4 ones
FILLRANGE m 0 3
ONES m
ASSERT LAST_N == 4
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 1
GETBIT m 4
ASSERT LAST_N == 0

COUNTRANGE m 0 3
ASSERT LAST_N == 4
COUNTRANGE m 2 5
ASSERT LAST_N == 2
POPRANGE m 4 7
ASSERT LAST_N == 0

# CLEARRANGE middle
CLEARRANGE m 1 2
GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 0
GETBIT m 2
ASSERT LAST_N == 0
GETBIT m 3
ASSERT LAST_N == 1
COUNTRANGE m 0 3
ASSERT LAST_N == 2

# FLIPRANGE
FLIPRANGE m 0 3
GETBIT m 0
ASSERT LAST_N == 0
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 1
GETBIT m 3
ASSERT LAST_N == 0

# FILLRANGE with val 0 = clear
FILLRANGE m 8 11 0
COUNTRANGE m 8 11
ASSERT LAST_N == 0
SETRANGE m 8 11 1
COUNTRANGE m 8 11
ASSERT LAST_N == 4

# inverted lo/hi still works
CLEARBITS m
FILLRANGE m 5 2
COUNTRANGE m 2 5
ASSERT LAST_N == 4

# NOTRANGE alias
NOTRANGE m 2 5
COUNTRANGE m 2 5
ASSERT LAST_N == 0

# soft fail count missing
COUNTRANGE nosuch 0 3
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof81_range_bits" LAST_N SET
