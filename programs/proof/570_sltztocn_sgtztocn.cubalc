# Proof 570 — digit-1 pure-imm cell zero-rel LT0/GT0 TOC: SLTZTOCN SGTZTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SLTZTOCN: zero → 0
CELLSET 1 0
SLTZTOCN 1
POP x
ASSERT x == 0
ASSERT CELL(1) == 0

# positive → 0
CLEARSTACK
CELLSET 2 5
S0LTTOCN 2
POP x
ASSERT x == 0
ASSERT CELL(2) == 0

# negative → 1
CLEARSTACK
CELLSET 3 (-4)
SISNEGTOCN 3
POP x
ASSERT x == 1
ASSERT CELL(3) == 1

# S0LTATN alias
CLEARSTACK
CELLSET 4 (-1)
S0LTATN 4
POP x
ASSERT x == 1
ASSERT CELL(4) == 1

# LTZTOCN zero
CLEARSTACK
CELLSET 5 0
LTZTOCN 5
POP x
ASSERT x == 0
ASSERT CELL(5) == 0

# SGTZTOCN: zero → 0
