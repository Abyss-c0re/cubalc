# Proof 361 — digit-2 reverse imm modular: SSUBMODFROMN SPOWMODFROMN SMODDIVFROMN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSUBMODFROMN: (10 - 3) mod 12 = 7
PUSH 3
SSUBMODFROMN 10 12
POP x
ASSERT x == 7

# RSUBMODN: (3 - 5) mod 12 = 10
PUSH 5
RSUBMODN 3 12
POP x
ASSERT x == 10

# SUBMODFROMN: (0 - 1) mod 5 = 4
PUSH 1
SUBMODFROMN 0 5
POP x
ASSERT x == 4

# soft m<=0 → 0
PUSH 9
SSUBMODFROMN 1 0
POP x
ASSERT x == 0

# SPOWMODFROMN: 2^10 mod 1000 = 24
PUSH 10
SPOWMODFROMN 2 1000
POP x
ASSERT x == 24

# RPOWMODN: 3^5 mod 13 = 9
PUSH 5
RPOWMODN 3 13
POP x
ASSERT x == 9

# POWMODFROMN: 5^0 mod 7 = 1
PUSH 0
POWMODFROMN 5 7
POP x
ASSERT x == 1

# SBASEPOWMODN: 2^FIB(5)=2^5=32 mod 100
PUSH 5
SBASEPOWMODN 2 100
POP x
ASSERT x == 32

# SMODDIVFROMN: a * inv(TOS) mod m — 10 * inv(3) mod 7
# inv(3) mod 7 = 5 because 3*5=15≡1; 10%7=3; 3*5=15≡1
PUSH 3
SMODDIVFROMN 10 7
POP x
ASSERT x == 1

# RMODDIVN: 1 * inv(2) mod 5 = 3 (2*3=6≡1)
PUSH 2
RMODDIVN 1 5
POP x
ASSERT x == 3

# MODDIVFROMN no inverse → 0
PUSH 2
MODDIVFROMN 1 4
POP x
ASSERT x == 0

# soft empty OK=0
CLEARSTACK
SSUBMODFROMN 1 5
ASSERT OK == 0

PRINT "361_ssubmodfromn_smoddivfromn OK"
