# Proof 472 — digit-3 stack imm 8-bit field max+eq: SMAX8N SEQ8N SNE8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMAX8N: max(0x10, 0xC0) → 0xC0
PUSH 0x10
SMAX8N 0xC0 0
POP x
ASSERT x == 0xC0

# keeps larger
CLEARSTACK
PUSH 0xF0
MAX8N 0x20 0
POP x
ASSERT x == 0xF0

# high preserved: 0x...7711 max 0x80 → 0x...7780
CLEARSTACK
PUSH 0x1122334455667711
SMAX8N 0x80 0
POP x
ASSERT x == 0x1122334455667780

# STACKMAX8N n1: byte1 of 0x...2000 max 0x90 → 0x...9000
CLEARSTACK
PUSH 0x2000
STACKMAX8N 0x90 1
POP x
ASSERT x == 0x9000

# SGE8N alias max equal
CLEARSTACK
PUSH 0x55
SGE8N 0x55 0
POP x
ASSERT x == 0x55

# SEQ8N: equal → 1
CLEARSTACK
PUSH 0xAB
SEQ8N 0xAB 0
POP x
ASSERT x == 1

# unequal → 0
CLEARSTACK
PUSH 0xAB
EQ8N 0xAC 0
POP x
ASSERT x == 0

# high preserved eq: 0x...7742 == 0x42 → 0x...7701
CLEARSTACK
PUSH 0x1122334455667742
SEQ8N 0x42 0
POP x
ASSERT x == 0x1122334455667701

# STACKEQ8N n1: byte1 of 0x...7700 == 0x77 → 0x...0100
CLEARSTACK
PUSH 0x7700
STACKEQ8N 0x77 1
POP x
ASSERT x == 0x0100

# SNE8N: unequal → 1
CLEARSTACK
PUSH 0x10
SNE8N 0x11 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0x10
NE8N 0x10 0
POP x
ASSERT x == 0

# high preserved ne: 0x...77FF != 0 → 0x...7701
CLEARSTACK
PUSH 0x11223344556677FF
SNE8N 0 0
POP x
ASSERT x == 0x1122334455667701

# STACKNE8N n1: byte1 of 0x...5500 != 0x55 → 0
CLEARSTACK
PUSH 0x5500
STACKNE8N 0x55 1
POP x
ASSERT x == 0x0000

# SCMPEQ8N / SCMPNE8N aliases
CLEARSTACK
PUSH 0xFF
SCMPEQ8N 0xFF 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x00
SCMPNE8N 1 0
POP x
ASSERT x == 1

HOLD_FLASH 0
