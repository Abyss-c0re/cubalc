# Proof 282 — digit-0 dual-stack imm inverted 32-bit field: DNAND32N DNOR32N DXNOR32N
HOLD_FLASH 1
SCIENCE LOAD

# DNAND32N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNAND32N 0x0000FFFF 0
POP y
POP x
ASSERT x == 0x11223344FFFF8877
ASSERT y == 0x99AABBCCFFFF00FF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNAND32N 0x0000FFFF 1
POP y
POP x
ASSERT x == 0xFFFFCCBB55667788
ASSERT y == 0xFFFF4433DDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DINVERTAND32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == -4294967296
ASSERT y == -4294967296

# DNOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNOR32N 0xFFFF0000 0
POP y
POP x
ASSERT x == 0x1122334400008877
ASSERT y == 0x99AABBCC000000FF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNOR32N 0xFFFF0000 1
POP y
POP x
ASSERT x == 0x0000CCBB55667788
ASSERT y == 0x00004433DDEEFF00

CLEARSTACK
PUSH 0
PUSH 0
DINVERTOR32N 0xABCD1234 1
POP y
POP x
ASSERT x == 0x5432EDCB00000000
ASSERT y == 0x5432EDCB00000000

# DXNOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNOR32N 0x0000FFFF 0
POP y
POP x
ASSERT x == 0x11223344AA997788
ASSERT y == 0x99AABBCC2211FF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXNOR32N 0x0000FFFF 1
POP y
POP x
ASSERT x == 0xEEDD334455667788
ASSERT y == 0x6655BBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DEQUIV32N 0x00000000 0
POP y
POP x
ASSERT x == -4294967296
ASSERT y == -4294967296

CLEARSTACK
PUSH -1
PUSH -1
DXNOR32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# soft fails
CLEARSTACK
DNAND32N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DNOR32N 1 0
ASSERT OK == 0
CLEARSTACK
DXNOR32N 1 0
ASSERT OK == 0

HOLD_FLASH 1
