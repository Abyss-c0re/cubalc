# Proof 185 — digit-6 dual-stack energy: DINV DNORM100
HOLD_FLASH 1
SCIENCE LOAD

# DINV: a b → 1/a 1/b  (/0→0)
CLEARSTACK
PUSH 5
PUSH 2
DINV
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# exact inverses
CLEARSTACK
PUSH 1
PUSH -1
DRECIP
POP y
POP x
ASSERT x == 1
ASSERT y == -1

# 2INV
CLEARSTACK
PUSH 10
PUSH 1
2INV
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# zero guard
CLEARSTACK
PUSH 0
PUSH 4
PAIRINV
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DNORM100: peak maps to ±100
CLEARSTACK
PUSH 50
PUSH 25
DNORM100
POP y
POP x
ASSERT x == 100
ASSERT y == 50

# 2NORM100 equal
CLEARSTACK
PUSH 7
PUSH 7
2NORM100
POP y
POP x
ASSERT x == 100
ASSERT y == 100

# DENORM negative peak
CLEARSTACK
PUSH -80
PUSH 40
DENORM
POP y
POP x
ASSERT x == -100
ASSERT y == 50

# both zero
CLEARSTACK
PUSH 0
PUSH 0
PAIRNORM100
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# b is peak
CLEARSTACK
PUSH 10
PUSH -40
2ENORM
POP y
POP x
ASSERT x == 25
ASSERT y == -100

# S2INV / STACK2NORM100 aliases
CLEARSTACK
PUSH 1
PUSH 1
S2INV
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 3
PUSH 6
STACK2NORM100
POP y
POP x
ASSERT x == 50
ASSERT y == 100

# soft fail underflow
CLEARSTACK
PUSH 1
DINV
ASSERT OK == 0
CLEARSTACK
# empty
DNORM100
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof185_dinv_dnorm100" LAST_N SP
