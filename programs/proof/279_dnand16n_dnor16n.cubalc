# Proof 279 — digit-2 dual-stack imm inverted 16-bit field: DNAND16N DNOR16N DXNOR16N
HOLD_FLASH 1
SCIENCE LOAD

# DNAND16N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNAND16N 0x00FF 0
POP y
POP x
ASSERT x == 0x112233445566FF77
ASSERT y == 0x99AABBCCDDEEFFFF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNAND16N 0x00FF 1
POP y
POP x
ASSERT x == 0x11223344FF997788
ASSERT y == 0x99AABBCCFF11FF00

CLEARSTACK
PUSH -1
PUSH -1
DINVERTAND16N 0xFFFF 0
POP y
POP x
ASSERT x == -65536
ASSERT y == -65536

# DNOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNOR16N 0xFF00 0
POP y
POP x
ASSERT x == 0x1122334455660077
ASSERT y == 0x99AABBCCDDEE00FF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNOR16N 0xFF00 2
POP y
POP x
ASSERT x == 0x112200BB55667788
ASSERT y == 0x99AA0033DDEEFF00

CLEARSTACK
PUSH 0
PUSH 0
DINVERTOR16N 0xABCD 3
POP y
POP x
ASSERT x == 0x5432000000000000
ASSERT y == 0x5432000000000000

# DXNOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNOR16N 0x00FF 0
POP y
POP x
ASSERT x == 0x1122334455668888
ASSERT y == 0x99AABBCCDDEE0000

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXNOR16N 0x00FF 3
POP y
POP x
ASSERT x == 0xEE22334455667788
ASSERT y == 0x66AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DEQUIV16N 0x0000 0
POP y
POP x
ASSERT x == -65536
ASSERT y == -65536

CLEARSTACK
PUSH -1
PUSH -1
DXNOR16N 0xFFFF 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# soft fails
CLEARSTACK
DNAND16N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DNOR16N 1 0
ASSERT OK == 0
CLEARSTACK
DXNOR16N 1 0
ASSERT OK == 0

HOLD_FLASH 1
