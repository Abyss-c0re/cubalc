# Proof 403 — digit-0 stack dual LE 32-bit field TOC: SGET32TOC SSET32TOC SCLR32TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSET32TOC: deposit lo32=1, hi32=2 → 2<<32|1 = 8589934593
CELLSET 1 0
PUSH 1
PUSH 1
PUSH 0
SSET32TOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
PUSH 2
PUSH 1
SSET32TOC
ASSERT LAST_N == 8589934593
ASSERT CELL(1) == 8589934593
POP

# SGET32TOC extract word 1 → 2
CELLSET 2 8589934593
PUSH 2
PUSH 1
SGET32TOC
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# GET32TOC alias: word 0 of 0xDEADBEEF = 3735928559
CELLSET 3 3735928559
PUSH 3
PUSH 0
GET32TOC
ASSERT LAST_N == 3735928559
ASSERT CELL(3) == 3735928559
POP

# SCLR32TOC clear word 0 of (2<<32|1) → 2<<32
CELLSET 4 8589934593
PUSH 4
PUSH 0
SCLR32TOC
ASSERT LAST_N == 8589934592
ASSERT CELL(4) == 8589934592
POP

# CLR32TOC clear word 1 then extract is 0
CELLSET 5 8589934593
PUSH 5
PUSH 1
CLR32TOC
POP
PUSH 5
PUSH 1
SGET32TOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft short stack OK=0
CLEARSTACK
SGET32TOC
ASSERT OK == 0
PUSH 1
SSET32TOC
ASSERT OK == 0

PRINT "403_sget32toc_sclr32toc OK"
