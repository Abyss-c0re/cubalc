# Proof 543 — digit-6 stack imm 32-bit signed ordered-cmp: SLTS32N SGTS32N SLTES32N SGTES32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SLTS32N: int32(-1=0xFFFFFFFF) < 1 → 1
PUSH 0xFFFFFFFF
SLTS32N 0x1 0
POP x
ASSERT x == 1

# unsigned SLT: 0xFFFFFFFF < 0x1 → 0
CLEARSTACK
PUSH 0xFFFFFFFF
SLT32N 0x1 0
POP x
ASSERT x == 0

# equal → 0 for LT
CLEARSTACK
PUSH 0x80000000
LTS32N 0x80000000 0
POP x
ASSERT x == 0

# positive less: 2 < 3 → 1
CLEARSTACK
PUSH 0x2
SLTS32N 0x3 0
POP x
ASSERT x == 1

# 1 < -1 → 0
CLEARSTACK
PUSH 0x1
SLTS32N 0xFFFFFFFF 0
POP x
ASSERT x == 0

# preserved high word
CLEARSTACK
PUSH 0x11223344FFFFFFFF
SLTS32N 0x1 0
POP x
ASSERT x == 0x1122334400000001

# STACKLTS32N n1: high word 0xFFFFFFFF < 0 → 1
CLEARSTACK
PUSH 0xFFFFFFFF00000000
STACKLTS32N 0x0 1
POP x
ASSERT x == 0x0000000100000000

# SGTS32N: 1 > -1 → 1
CLEARSTACK
PUSH 0x1
SGTS32N 0xFFFFFFFF 0
POP x
ASSERT x == 1

# 0xFFFFFFFF > 0x1 signed → 0
CLEARSTACK
PUSH 0xFFFFFFFF
GTS32N 0x1 0
POP x
ASSERT x == 0

# equal → 0
CLEARSTACK
PUSH 0x55555555
SGTS32N 0x55555555 0
POP x
ASSERT x == 0

# 0x80000000 (INT_MIN) > 0x7FFFFFFF (INT_MAX) → 0
CLEARSTACK
PUSH 0x80000000
SGTS32N 0x7FFFFFFF 0
POP x
ASSERT x == 0

# preserved gt
CLEARSTACK
PUSH 0xAABBCCDD00000001
SGTS32N 0xFFFFFFFF 0
POP x
ASSERT x == 0xAABBCCDD00000001

# SLTES32N equal → 1
CLEARSTACK
PUSH 0x80000000
SLTES32N 0x80000000 0
POP x
ASSERT x == 1

# -1 <= 0 → 1
CLEARSTACK
PUSH 0xFFFFFFFF
LTES32N 0x0 0
POP x
ASSERT x == 1

# 1 <= -1 → 0
CLEARSTACK
PUSH 0x1
SLTES32N 0xFFFFFFFF 0
POP x
ASSERT x == 0

# SLEQS32N alias
CLEARSTACK
PUSH 0x2
SLEQS32N 0x3 0
POP x
ASSERT x == 1

# SGTES32N equal → 1
CLEARSTACK
PUSH 0x55555555
SGTES32N 0x55555555 0
POP x
ASSERT x == 1

# 1 >= -1 → 1
CLEARSTACK
PUSH 0x1
GTES32N 0xFFFFFFFF 0
POP x
ASSERT x == 1

# INT_MIN >= INT_MAX → 0
CLEARSTACK
PUSH 0x80000000
SGTES32N 0x7FFFFFFF 0
POP x
ASSERT x == 0

# SGEQS32N: -1 >= -2 (0xFFFFFFFE) → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SGEQS32N 0xFFFFFFFE 0
POP x
ASSERT x == 1

# SCMPLTS32N / SCMPGES32N
CLEARSTACK
PUSH 0xFFFFFFFE
SCMPLTS32N 0xFFFFFFFF 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0xFFFFFFFF
SCMPGES32N 0xFFFFFFFE 0
POP x
ASSERT x == 1

HOLD_FLASH 0
