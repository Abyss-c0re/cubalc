# Proof 168 — digit-3 dual-stack bitfield pos: DBTEST DSETB DCLRB DFLIPB
HOLD_FLASH 1
SCIENCE LOAD

# DBTEST — a b na nb → bit(a,na) bit(b,nb)
CLEARSTACK
PUSH 0x0A
PUSH 0x05
PUSH 1
PUSH 0
DBTEST
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x0A
PUSH 0x05
PUSH 0
PUSH 1
2BTEST
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DSETB
CLEARSTACK
PUSH 0
PUSH 0
PUSH 3
PUSH 1
DSETB
POP y
POP x
ASSERT x == 8
ASSERT y == 2

CLEARSTACK
PUSH 1
PUSH 2
PUSH 0
PUSH 2
2SETB
POP y
POP x
ASSERT x == 1
ASSERT y == 6

# DCLRB
CLEARSTACK
PUSH 15
PUSH 7
PUSH 0
PUSH 1
DCLRB
POP y
POP x
ASSERT x == 14
ASSERT y == 5

CLEARSTACK
PUSH 0xFF
PUSH 0x0F
PUSH 4
PUSH 3
2CLRB
POP y
POP x
ASSERT x == 239
ASSERT y == 7

# DFLIPB
CLEARSTACK
PUSH 0
PUSH 15
PUSH 2
PUSH 0
DFLIPB
POP y
POP x
ASSERT x == 4
ASSERT y == 14

CLEARSTACK
PUSH 5
PUSH 5
PUSH 0
PUSH 2
PAIRFLIPB
POP y
POP x
ASSERT x == 4
ASSERT y == 1

# soft fails
CLEARSTACK
DBTEST
ASSERT OK == 0
CLEARSTACK
DSETB
ASSERT OK == 0
CLEARSTACK
DCLRB
ASSERT OK == 0
CLEARSTACK
DFLIPB
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2BTEST
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof168_dbtest_dsetb" LAST_N SP
