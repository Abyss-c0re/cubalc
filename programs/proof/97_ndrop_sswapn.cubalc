# Proof 97 — digit-0 stack: NDROP + SEMPTY/SFULL + SSWAPN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
SEMPTY
ASSERT LAST_N == 1
SFULL
ASSERT LAST_N == 0

PUSH 10
PUSH 20
PUSH 30
PUSH 40
# stack: 10 20 30 40 (TOS=40)
SEMPTY
ASSERT LAST_N == 0

# SSWAPN 2: swap 40 with 20 → 10 40 30 20
SSWAPN 2
ASSERT LAST_N == 20
POP
ASSERT LAST_N == 20
POP
ASSERT LAST_N == 30
POP
ASSERT LAST_N == 40
POP
ASSERT LAST_N == 10

# NDROP
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
NDROP 3
# left 1 2
ASSERT SP == 2
POP
ASSERT LAST_N == 2
POP
ASSERT LAST_N == 1
SEMPTY
ASSERT LAST_N == 1

# NDROP more than sp clamps
PUSH 7
PUSH 8
NDROP 10
SEMPTY
ASSERT LAST_N == 1
ASSERT SP == 0

# SSWAPN 0 is identity
PUSH 9
SSWAPN 0
ASSERT LAST_N == 9
ASSERT SP == 1

# soft fail SSWAPN out of range
SSWAPN 5
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof97_ndrop_sswapn" LAST_N SP
