# Proof 281 — digit-1 stack imm inverted 32-bit field: SNAND32N SNOR32N SXNOR32N
HOLD_FLASH 1
SCIENCE LOAD

# SNAND32N field n
CLEARSTACK
PUSH 0x1122334455667788
SNAND32N 0x0000FFFF 0
POP x
ASSERT x == 0x11223344FFFF8877

CLEARSTACK
PUSH 0x1122334455667788
STACKNAND32N 0x0000FFFF 1
POP x
ASSERT x == 0xFFFFCCBB55667788

CLEARSTACK
PUSH -1
NAND32N 0xFFFFFFFF 0
POP x
ASSERT x == -4294967296

# SNOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
SNOR32N 0xFFFF0000 0
POP x
ASSERT x == 0x1122334400008877

CLEARSTACK
PUSH 0x1122334455667788
STACKNOR32N 0xFFFF0000 1
POP x
ASSERT x == 0x0000CCBB55667788

CLEARSTACK
PUSH 0
NOR32N 0x00000000 0
POP x
ASSERT x == 0xFFFFFFFF

CLEARSTACK
PUSH 0
SINVERTOR32N 0xABCD1234 1
POP x
ASSERT x == 0x5432EDCB00000000

# SXNOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
SXNOR32N 0x0000FFFF 0
POP x
ASSERT x == 0x11223344AA997788

CLEARSTACK
PUSH 0x1122334455667788
STACKXNOR32N 0x0000FFFF 1
POP x
ASSERT x == 0xEEDD334455667788

CLEARSTACK
PUSH 0
XNOR32N 0xABCD1234 1
POP x
ASSERT x == 0x5432EDCB00000000

CLEARSTACK
PUSH -1
SEQUIV32N 0x00000000 0
POP x
ASSERT x == -4294967296

CLEARSTACK
PUSH -1
SXNOR32N 0xFFFFFFFF 0
POP x
ASSERT x == -1

# soft fails
CLEARSTACK
SNAND32N 1 0
ASSERT OK == 0
CLEARSTACK
SNOR32N 1 0
ASSERT OK == 0
CLEARSTACK
SXNOR32N 1 0
ASSERT OK == 0

HOLD_FLASH 1
