# Proof 557 — digit-4 stack+dual field zero-eq 32/16: S0EQ32N S0EQ16N D0EQ32N D0EQ16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0EQ32N: 0 → 1
PUSH 0x0
S0EQ32N 0
POP x
ASSERT x == 1

# non-zero → 0
CLEARSTACK
PUSH 0x5
SZ32N 0
POP x
ASSERT x == 0

# -1 field not zero
CLEARSTACK
PUSH 0xFFFFFFFF
SEQZ32N 0
POP x
ASSERT x == 0

# high preserve: low 0 → 1
CLEARSTACK
PUSH 0xAABBCCDD00000000
SISZERO32N 0
POP x
ASSERT x == 0xAABBCCDD00000001

# STACK0EQ32N n1: high 0 → high 1; low stays 7
CLEARSTACK
PUSH 0x0000000000000007
STACK0EQ32N 1
POP x
ASSERT x == 0x0000000100000007

# high non-zero → 0
CLEARSTACK
PUSH 0x0000000200000000
STACK0EQ32N 1
POP x
ASSERT x == 0x0000000000000000

# S0EQ16N: 0 → 1
CLEARSTACK
PUSH 0x0
S0EQ16N 0
POP x
ASSERT x == 1

# non-zero
CLEARSTACK
PUSH 0x1
SZ16N 0
POP x
ASSERT x == 0

# high halfword zero: n1 of 0x0000_0005 → high 1
CLEARSTACK
PUSH 0x00000005
STACK0EQ16N 1
POP x
ASSERT x == 0x00010005

# high preserve around low zero-eq of 0
CLEARSTACK
PUSH 0xABCD0000
S0EQ16N 0
POP x
ASSERT x == 0xABCD0001

# D0EQ32N
CLEARSTACK
PUSH 0x0
PUSH 0x3
D0EQ32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x0
PAIR0EQ32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK20EQ32N n1
CLEARSTACK
PUSH 0x0000000000000001
PUSH 0x0000000500000000
STACK20EQ32N 1
POP y
POP x
ASSERT x == 0x0000000100000001
ASSERT y == 0x0000000000000000

# D0EQ16N
CLEARSTACK
PUSH 0x0
PUSH 0x7
D0EQ16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFF
PUSH 0x0
PAIR0EQ16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK20EQ16N n1
CLEARSTACK
PUSH 0x00000003
PUSH 0x00050000
STACK20EQ16N 1
POP y
POP x
ASSERT x == 0x00010003
ASSERT y == 0x00000000

HOLD_FLASH 0
