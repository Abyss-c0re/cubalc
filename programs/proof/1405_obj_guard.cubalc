# INCLUDE obj_guard - live OOP instance catalog ALL + ANY contract

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
END

CLASS Order
  FIELD n
  METHOD pay
    LET n = 1
  END
END

NEW Ticket t1
NEW Order order1

DEFAULT NEED_OBJS = ""
DEFAULT NEED_OBJ_ANY = ""
DEFAULT OBJ_GUARD_SOFT = 0
INCLUDE obj_guard
ASSERT OBJ_GUARD_OK == 1
ASSERT OBJ_GUARD_ALL_OK == 1
ASSERT OBJ_GUARD_ANY_OK == 1

LET NEED_OBJS = "t1\nnosuch_cubalc_obj_all"
LET NEED_OBJ_ANY = ""
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_OK == 0
ASSERT OBJ_GUARD_ALL_OK == 0
ASSERT OBJMISS_N >= 1
SYS HASLINE OBJMISS "nosuch_cubalc_obj_all"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_OBJS = "t1\norder1"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 1
ASSERT OBJ_GUARD_OK == 1
ASSERT OBJHAVE_N >= 2

LET NEED_OBJS = ""
LET NEED_OBJ_ANY = "nosuch_a\nnosuch_b"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ANY_OK == 0
ASSERT OBJ_GUARD_OK == 0
CLEAR_ERR

LET NEED_OBJ_ANY = "nosuch_a\nt1"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 1
CLEAR_ERR

LET NEED_OBJS = "t1\norder1"
LET NEED_OBJ_ANY = ""
LET OBJ_GUARD_SOFT = 0
INCLUDE obj_guard
ASSERT OBJ_GUARD_OK == 1

LET NEED_OBJS = ""
LET NEED_OBJ_ANY = "nosuch_z\nt1"
LET OBJ_GUARD_SOFT = 0
INCLUDE obj_guard
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 1

LET NEED_OBJS = "t1"
LET NEED_OBJ_ANY = "order1\nnosuch_z"
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 1
ASSERT OBJ_GUARD_ANY_OK == 1
ASSERT OBJ_GUARD_OK == 1

# missing instance counts as miss
LET NEED_OBJS = "ghost_obj"
LET NEED_OBJ_ANY = ""
LET OBJ_GUARD_SOFT = 1
INCLUDE obj_guard
ASSERT OBJ_GUARD_ALL_OK == 0
SYS HASLINE OBJMISS "ghost_obj"
ASSERT LAST_N == 1
CLEAR_ERR

HASFORM "HASOBJ"
ASSERT LAST_N == 1
HASLIB obj_guard
ASSERT LAST_N == 1

PRINT "1405_obj_guard: PASS"
PASS
