# Proof 329 — digit-2 stack↔cell math: SSQRTOC SISQRTTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSQRTOC: 7^2 = 49
CELLSET 1 7
PUSH 1
SSQRTOC
ASSERT LAST_N == 49
ASSERT CELL(1) == 49
POP a
ASSERT a == 49

# SCELLSQR alias: (-3)^2 = 9
PUSH 2
PUSH 3
NEGATE
SSETCELL
POP
ASSERT CELL(2) == -3
PUSH 2
SCELLSQR
ASSERT LAST_N == 9
ASSERT CELL(2) == 9
POP

# SQRTOC alias: 0^2 = 0
CELLSET 3 0
PUSH 3
SQRTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SISQRTTOC: isqrt(49) = 7
CELLSET 4 49
PUSH 4
SISQRTTOC
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
POP

# SCELLISQRT: isqrt(10) = 3
CELLSET 5 10
PUSH 5
SCELLISQRT
ASSERT LAST_N == 3
ASSERT CELL(5) == 3
POP

# ISQRTTOC: neg → 0
PUSH 6
PUSH 5
NEGATE
SSETCELL
POP
ASSERT CELL(6) == -5
PUSH 6
ISQRTTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# round-trip: sqr then isqrt of positive
CELLSET 7 12
PUSH 7
SSQRTOC
POP
ASSERT CELL(7) == 144
PUSH 7
SISQRTTOC
ASSERT LAST_N == 12
ASSERT CELL(7) == 12
POP

# soft fails
CLEARSTACK
SSQRTOC
ASSERT OK == 0
SISQRTTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof329_ssqrtoc_sisqrtoc" LAST_N SP
HOLD_FLASH 1
