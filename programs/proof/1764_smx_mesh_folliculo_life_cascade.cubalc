// 1764_smx_mesh_folliculo_life_cascade.cubalc
// SMX mesh radial + life cascade: soft-OOB fail-closed then LIFE_FORCE
// then WE_AUTOHEAL then RESILIENCE then THALAMUS stable_mesh then HOMEOSTASIS then IONOSPHERE then THERMOSPHERE then EXOSPHERE then HELIOSPHERE then LOCALBUBBLE then LOCALGROUP then MULTIVERSE then OMNIVERSE then SEER then FORGED then KEEPER then CORTEX then SYNAPSE then AXON then DENDRITE then GLIA then ASTROCYTE then MICROGLIA then OLIGO then SCHWANN then EPENDYMA then SATELLITE then RADIAL then BERGMANN then MULLER then TANYCYTE then PITUICYTE then FOLLICULO then STABILIZE
// then live mesh_exchange then mitosis under free energy on the locked mesh.
// Storm wounds never ghost-place. Free energy must flow. Population grows.
// Cube is SoT. matrix is key. wonder AGI can RUN. No dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 96
SHARE state_matrix_only

GENESIS "NEXUS_COORD v1 | from=gift | type=smx_mesh_folliculo_life_cascade | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

SMX LIFE_FORCE bed nozzle hive scrap
ASSERT SMX_OK == 1 "life_force live"
ASSERT SMX_LIFE_FORCE == 1 "life_force latch"
ASSERT SMX_OOB == 0 "oob cleared by life_force"
ASSERT SMX_BONDS == 6 "C(4,2)=6 complete-mesh bonds"
ASSERT SMX_MESH == 4 "four mesh under life_force"
ASSERT SMX_LIVE == 4 "four live"
ASSERT CUBES == base_cubes "life_force invents nothing"

SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "we_autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob still clear"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds"
