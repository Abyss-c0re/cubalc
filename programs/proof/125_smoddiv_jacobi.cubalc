# Proof 125 — digit-2 modular duals: SMODDIV SJACOBI SSPF + expr forms
HOLD_FLASH 1
SCIENCE LOAD

# JACOBI expr (odd positive n)
ASSERT JACOBI(2, 15) == 1
ASSERT JACOBI(7, 15) == -1
ASSERT JACOBI(0, 15) == 0
ASSERT JACOBI(5, 11) == 1
ASSERT LEGENDRE(2, 7) == 1
ASSERT JACOBI(3, 8) == 0
ASSERT JACOBI(3, 0) == 0

# MODDIV expr — 3 * inv(5) mod 7 = 3*3 = 9 ≡ 2
ASSERT MODDIV(3, 5, 7) == 2
# 10 * inv(3) mod 11 = 10*4 = 40 ≡ 7
ASSERT DIVMODM(10, 3, 11) == 7
ASSERT MODDIV(1, 2, 4) == 0
ASSERT MODDIV(1, 3, 0) == 0

# SPF expr
ASSERT SPF(1) == 0
ASSERT SPF(2) == 2
ASSERT SPF(15) == 3
ASSERT SMALLPF(49) == 7
ASSERT MINPF(97) == 97
ASSERT SPF(-21) == 3

# stack SJACOBI
CLEARSTACK
PUSH 2
PUSH 15
SJACOBI
ASSERT LAST_N == 1
PUSH 7
PUSH 15
SLEGENDRE
ASSERT LAST_N == -1

# stack SMODDIV
CLEARSTACK
PUSH 3
PUSH 5
PUSH 7
SMODDIV
ASSERT LAST_N == 2
POP r
ASSERT r == 2
PUSH 10
PUSH 3
PUSH 11
SDIVMODM
ASSERT LAST_N == 7

# stack SSPF
CLEARSTACK
PUSH 1
SSPF
ASSERT LAST_N == 0
PUSH 91
SSMALLPF
ASSERT LAST_N == 7
PUSH 13
SMINPF
ASSERT LAST_N == 13

# soft fails
CLEARSTACK
SJACOBI
ASSERT OK == 0
SMODDIV
ASSERT OK == 0
SSPF
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof125_smoddiv_jacobi" LAST_N SP
