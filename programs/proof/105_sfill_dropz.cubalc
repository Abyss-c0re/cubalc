# Proof 105 — digit-4 stack: SFILL + DROPZ + DROPNZ
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
SFILL 3 9
ASSERT SP == 4
POP a
ASSERT a == 9
POP b
ASSERT b == 9
POP c
ASSERT c == 9
POP d
ASSERT d == 1

CLEARSTACK
PUSH 5
SFILL 0 7
ASSERT SP == 1
PEEK
ASSERT LAST_N == 5

CLEARSTACK
PUSH 1
PUSH 0
DROPZ
ASSERT SP == 1
PEEK
ASSERT LAST_N == 1
PUSH 0
SDROPZ
ASSERT SP == 1
PUSH 3
DROPIF0
ASSERT SP == 2
PEEK
ASSERT LAST_N == 3

CLEARSTACK
PUSH 0
PUSH 5
DROPNZ
ASSERT SP == 1
PEEK
ASSERT LAST_N == 0
PUSH 0
DROPIF
ASSERT SP == 2
PEEK
ASSERT LAST_N == 0

CLEARSTACK
SFILL 2 1
ASSERT OK == 0
DROPZ
ASSERT OK == 0
DROPNZ
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof105_sfill_dropz" LAST_N SP
