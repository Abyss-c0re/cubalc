# Proof 2416 — MULTIFILE_EXTEND_LISTLEAVES_FIRSTLEAF_NTHLEAF_LINK3
# Multi-file CLASS EXTEND + LISTLEAVES bag + FIRSTLEAF/LASTLEAF/NTHLEAF.
# Complements LEAFCOUNT + ISLEAF + DESCENDANTS + NTHCHILD.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

CLASS DeepLeaf EXTEND SoftTag
  FIELD deep 1
  METHOD z
    RET 1
  END
END
HASCLASS DeepLeaf
ASSERT LAST_N == 1

# --- baseline leaf topology ---
LEAFCOUNT LoudTag
ASSERT OK == 1
ASSERT LEAFCOUNT_N == 1
ASSERT LAST_N == 1

LEAFCOUNT TwinGreet
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT Solo
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT SoftTag
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT DeepLeaf
ASSERT LEAFCOUNT_N == 1

LEAFCOUNT TagGreeter
ASSERT OK == 1
ASSERT LEAFCOUNT_N == 2

LEAFCOUNT Greeter
ASSERT OK == 1
ASSERT LEAFCOUNT_N == 3

ISLEAF DeepLeaf
ASSERT LAST_N == 1
ISLEAF SoftTag
ASSERT LAST_N == 0
ISLEAF LoudTag
ASSERT LAST_N == 1
ISLEAF TwinGreet
ASSERT LAST_N == 1
ISLEAF Solo
ASSERT LAST_N == 1
ISLEAF Greeter
ASSERT LAST_N == 0

# --- LISTLEAVES bag (BFS leaf order: TwinGreet, LoudTag, DeepLeaf under Greeter) ---
LISTLEAVES LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LISTLEAVES_N == 1
ASSERT LAST == "LoudTag"

LISTLEAVES TwinGreet
ASSERT LAST_N == 1
ASSERT LAST == "TwinGreet"

LISTLEAVES Solo
ASSERT LAST_N == 1
ASSERT LAST == "Solo"

LISTLEAVES DeepLeaf
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

LISTLEAVES SoftTag
ASSERT OK == 1
ASSERT LISTLEAVES_N == 1
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

LISTLEAVES TagGreeter
ASSERT OK == 1
ASSERT LISTLEAVES_N == 2
ASSERT LAST_N == 2

LISTLEAVES Greeter
ASSERT OK == 1
ASSERT LISTLEAVES_N == 3
ASSERT LAST_N == 3
ASSERT LAST == "TwinGreet\nLoudTag\nDeepLeaf"

LEAVESBAG Greeter
ASSERT LEAVESBAG_N == 3

LEAFNAMES TagGreeter
ASSERT LEAFNAMES_N == 2

GETLEAVES SoftTag
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

# --- FIRSTLEAF / LASTLEAF ---
FIRSTLEAF LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT FIRSTLEAF_N == 1
ASSERT LAST == "LoudTag"

LASTLEAF LoudTag
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"

FIRSTLEAF SoftTag
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

LASTLEAF SoftTag
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

FIRSTLEAF Greeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "TwinGreet"

LASTLEAF Greeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

FIRSTLEAF TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"

LASTLEAF TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

ELDERLEAF Solo
ASSERT LAST == "Solo"
YOUNGLEAF TwinGreet
ASSERT LAST == "TwinGreet"

# --- NTHLEAF / LEAFAT (0-based; soft empty OOB) ---
NTHLEAF LoudTag 0
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT NTHLEAF_N == 1
ASSERT LAST == "LoudTag"

NTHLEAF LoudTag 1
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT NTHLEAF_N == 0

NTHLEAF SoftTag 0
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

NTHLEAF SoftTag 9
ASSERT LAST_N == 0

NTHLEAF TagGreeter 0
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"

NTHLEAF TagGreeter 1
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

NTHLEAF TagGreeter 2
ASSERT LAST_N == 0

NTHLEAF Greeter 0
ASSERT LAST_N == 1
ASSERT LAST == "TwinGreet"
NTHLEAF Greeter 1
ASSERT LAST_N == 1
ASSERT LAST == "LoudTag"
NTHLEAF Greeter 2
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"
NTHLEAF Greeter 3
ASSERT LAST_N == 0

LEAFAT Greeter 0
ASSERT LAST_N == 1
ASSERT LAST == "TwinGreet"
NTH_LEAF Greeter 2
ASSERT LAST_N == 1
ASSERT LAST == "DeepLeaf"

NTHLEAF DeepLeaf 0
ASSERT LAST == "DeepLeaf"

# Cross-check counts
LISTLEAVES Greeter
ASSERT LISTLEAVES_N == 3
ASSERT LEAFCOUNT_N == 3

LISTLEAVES TagGreeter
ASSERT LISTLEAVES_N == 2

PRINT "MI2416_LISTLEAVES_FIRSTLEAF_NTHLEAF_PASS"
