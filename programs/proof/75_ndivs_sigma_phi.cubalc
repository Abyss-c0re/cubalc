# Proof 75 — digit-2 divisor arithmetic: NDIVS SIGMA PHI + stack
HOLD_FLASH 1
SCIENCE LOAD

# NDIVS τ(n)
ASSERT NDIVS(1) == 1
ASSERT NDIVS(6) == 4
ASSERT NDIVS(12) == 6
ASSERT NDIVS(7) == 2
ASSERT NDIVS(0) == 0
ASSERT NDIVS(-5) == 0
ASSERT NUMDIV(28) == 6
ASSERT TAUD(9) == 3

# SIGMA σ(n)
ASSERT SIGMA(1) == 1
ASSERT SIGMA(6) == 12
ASSERT SIGMA(12) == 28
ASSERT SIGMA(28) == 56
ASSERT DIVSUM(10) == 18
ASSERT SIGMA(0) == 0

# PHI φ(n)
ASSERT PHI(1) == 1
ASSERT PHI(2) == 1
ASSERT PHI(5) == 4
ASSERT PHI(6) == 2
ASSERT PHI(7) == 6
ASSERT PHI(9) == 6
ASSERT PHI(10) == 4
ASSERT TOTIENT(12) == 4
ASSERT EULERPHI(1) == 1
ASSERT PHI(0) == 0

# identities: perfect number 6 is sum of proper divisors = n
ASSERT SIGMA(6) - 6 == 6
ASSERT NDIVS(6) == 4

# stack
CLEARSTACK
PUSH 12
SNDIVS
ASSERT LAST_N == 6
CLEARSTACK
PUSH 12
SSIGMA
ASSERT LAST_N == 28
CLEARSTACK
PUSH 10
SPHI
ASSERT LAST_N == 4
CLEARSTACK
SNDIVS
ASSERT OK == 0

# compose with ISPRIME / control
ASSERT ISPRIME(7) == 1
ASSERT NDIVS(7) == 2
ASSERT PHI(NEXTPRIME(20)) == 22
ASSERT NEXTPRIME(20) == 23

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof75_ndivs_sigma_phi" LAST_N
