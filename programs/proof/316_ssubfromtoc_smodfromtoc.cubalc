# Proof 316 — digit-9 reverse stack↔cell: SSUBFROMTOC SDIVFROMTOC SMODFROMTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSUBFROMTOC: i v → cells[i] = v - cells[i]
CELLSET 1 3
PUSH 1
PUSH 10
SSUBFROMTOC
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP a
ASSERT a == 7

# SCELLSUBFROM alias
CELLSET 2 4
PUSH 2
PUSH 1
SCELLSUBFROM
ASSERT LAST_N == -3
ASSERT CELL(2) == -3
POP

# SDIVFROMTOC: i v → cells[i] = v / cells[i]
CELLSET 3 5
PUSH 3
PUSH 20
SDIVFROMTOC
ASSERT LAST_N == 4
ASSERT CELL(3) == 4
POP

# SDIVFROMTOC cell 0 → 0
CELLSET 4 0
PUSH 4
PUSH 9
SCELLDIVFROM
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SMODFROMTOC: i v → cells[i] = v % cells[i]
CELLSET 5 7
PUSH 5
PUSH 23
SMODFROMTOC
ASSERT LAST_N == 2
ASSERT CELL(5) == 2
POP

# SCELLMODFROM alias + zero cell
CELLSET 6 0
PUSH 6
PUSH 11
SCELLMODFROM
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# chain: reverse then forward
CLEARCELLS
CELLSET 0 3
PUSH 0
PUSH 15
SSUBFROMTOC
POP
ASSERT CELL(0) == 12
PUSH 0
PUSH 5
SMODTOC
POP
ASSERT CELL(0) == 2

# soft fails
CLEARSTACK
SSUBFROMTOC
ASSERT OK == 0
SDIVFROMTOC
ASSERT OK == 0
SMODFROMTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof316_ssubfromtoc_smodfromtoc" LAST_N SP
HOLD_FLASH 1
