# AFTERARG / NEXTARG — peel raw argv following exact token (FINDARG+NTHARG one-shot)

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV UNSET CUBALC_ARG3
SYS ENV SET CUBALC_ARGC "0"

# miss without fallback
AFTERARG "--out"
ASSERT AFTERARG_HIT == 0
ASSERT LAST_N == 0
ASSERT AFTERARG_FROM == -1
SYS EMPTY LAST
ASSERT LAST_N == 1

# miss with OR fallback
AFTERARG "--out" OR "default.txt"
ASSERT AFTERARG_HIT == 0
ASSERT LAST_N == 0
SYS EQS LAST "default.txt"
ASSERT LAST_N == 1

# flag + value + file
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "--out"
SYS ENV SET CUBALC_ARG2 "report.json"
SYS ENV SET CUBALC_ARG3 "extra.bin"
SYS ENV SET CUBALC_ARGC "4"

AFTERARG "--out"
ASSERT AFTERARG_HIT == 1
ASSERT LAST_N == 1
ASSERT AFTERARG_FROM == 1
ASSERT AFTERARG_N == 2
SYS EQS LAST "report.json"
ASSERT LAST_N == 1

# NEXTARG alias
NEXTARG "--verbose"
ASSERT AFTERARG_HIT == 1
SYS EQS LAST "--out"
ASSERT LAST_N == 1

# token present but no following argv
SYS ENV SET CUBALC_ARG0 "seal"
SYS ENV SET CUBALC_ARGC "1"
AFTERARG "seal" OR "none"
ASSERT AFTERARG_HIT == 0
ASSERT AFTERARG_FROM == 0
SYS EQS LAST "none"
ASSERT LAST_N == 1

# subcommand with flags before: tool --v run script.cubalc
SYS ENV SET CUBALC_ARG0 "--v"
SYS ENV SET CUBALC_ARG1 "run"
SYS ENV SET CUBALC_ARG2 "script.cubalc"
SYS ENV SET CUBALC_ARGC "3"
AFTERARG "run"
ASSERT AFTERARG_HIT == 1
SYS EQS LAST "script.cubalc"
ASSERT LAST_N == 1
ASSERT AFTERARG_FROM == 1
ASSERT AFTERARG_N == 2

# discoverable
HASFORM "AFTERARG"
ASSERT LAST_N == 1
HASFORM "NEXTARG"
ASSERT LAST_N == 1

RELATED "AFTERARG"
SYS HASLINE LAST "FINDARG"
ASSERT LAST_N == 1

PRINT "afterarg ok"
PASS
