# Proof 153 — digit-3 dual-stack bit-path: DORN DBREV DPARITY
HOLD_FLASH 1
SCIENCE LOAD

# DORN — a|~c , b|~d
CLEARSTACK
PUSH 0
PUSH 0
PUSH 0
PUSH 0
DORN
POP y
POP x
ASSERT x == -1
ASSERT y == -1

CLEARSTACK
PUSH 15
PUSH 0
PUSH 240
PUSH 255
DORN
POP y
POP x
ASSERT x == -241
ASSERT y == -256

# DBREV — reverse low 32 bits
CLEARSTACK
PUSH 1
PUSH 0x80000000
DBREV
POP y
POP x
ASSERT x == 2147483648
ASSERT y == 1

# DPARITY
CLEARSTACK
PUSH 7
PUSH 8
DPARITY
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 3
PUSH 4
2PARITY
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# aliases
CLEARSTACK
PUSH 1
PUSH 2
PUSH 0
PUSH 1
2ORN
POP y
POP x
ASSERT x == -1
ASSERT y == -2

CLEARSTACK
PUSH 0xF0
PUSH 0
2BREV
POP y
POP x
ASSERT x == 251658240
ASSERT y == 0

# soft fails
CLEARSTACK
DORN
ASSERT OK == 0
CLEARSTACK
DBREV
ASSERT OK == 0
CLEARSTACK
DPARITY
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2ORN
ASSERT OK == 0
CLEARSTACK
PUSH 1
2PARITY
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof153_dorn_dparity" LAST_N SP
