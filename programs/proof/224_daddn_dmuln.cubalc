# Proof 224 — digit-7 dual-stack immediate ALU: DADDN DSUBN DMULN
HOLD_FLASH 1
SCIENCE LOAD

# DADDN
CLEARSTACK
PUSH 3
PUSH 5
DADDN 2
POP y
POP x
ASSERT x == 5
ASSERT y == 7

CLEARSTACK
PUSH 10
PUSH -1
2ADDN 4
POP y
POP x
ASSERT x == 14
ASSERT y == 3

# PAIRADDN / DADDIMM / zero
CLEARSTACK
PUSH 7
PUSH 8
PAIRADDN 0
POP y
POP x
ASSERT x == 7
ASSERT y == 8

CLEARSTACK
PUSH 1
PUSH 2
DADDIMM -3
POP y
POP x
ASSERT x == -2
ASSERT y == -1

# DSUBN
CLEARSTACK
PUSH 10
PUSH 6
DSUBN 3
POP y
POP x
ASSERT x == 7
ASSERT y == 3

CLEARSTACK
PUSH 0
PUSH 5
2SUBN 5
POP y
POP x
ASSERT x == -5
ASSERT y == 0

# PAIRSUBN / DSUBIMM
CLEARSTACK
PUSH 100
PUSH 50
PAIRSUBN 25
POP y
POP x
ASSERT x == 75
ASSERT y == 25

CLEARSTACK
PUSH -2
PUSH -4
DSUBIMM -1
POP y
POP x
ASSERT x == -1
ASSERT y == -3

# DMULN
CLEARSTACK
PUSH 3
PUSH 4
DMULN 5
POP y
POP x
ASSERT x == 15
ASSERT y == 20

CLEARSTACK
PUSH 7
PUSH -3
2MULN 2
POP y
POP x
ASSERT x == 14
ASSERT y == -6

# PAIRMULN / DMULIMM / *0 / *1
CLEARSTACK
PUSH 9
PUSH 11
PAIRMULN 1
POP y
POP x
ASSERT x == 9
ASSERT y == 11

CLEARSTACK
PUSH 42
PUSH 99
DMULIMM 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# chain ADD then MUL
CLEARSTACK
PUSH 2
PUSH 3
DADDN 1
DMULN 10
POP y
POP x
ASSERT x == 30
ASSERT y == 40

# DPLUSN / DMINUSN / DTIMESN aliases
CLEARSTACK
PUSH 1
PUSH 2
DPLUSN 9
POP y
POP x
ASSERT x == 10
ASSERT y == 11

CLEARSTACK
PUSH 20
PUSH 15
DMINUSN 5
POP y
POP x
ASSERT x == 15
ASSERT y == 10

CLEARSTACK
PUSH 6
PUSH 7
DTIMESN 3
POP y
POP x
ASSERT x == 18
ASSERT y == 21
