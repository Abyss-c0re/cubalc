# Proof 317 — digit-9 reverse sat stack↔cell: SSATSUBFROMTOC SSATDIVFROMTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSATSUBFROMTOC: i v → cells[i] = sat(v - cells[i])
CELLSET 1 3
PUSH 1
PUSH 10
SSATSUBFROMTOC
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP a
ASSERT a == 7

# SCELLSATSUBFROM alias
CELLSET 2 4
PUSH 2
PUSH 1
SCELLSATSUBFROM
ASSERT LAST_N == -3
ASSERT CELL(2) == -3
POP

# v=0, cell=5 → -5
CELLSET 3 5
PUSH 3
PUSH 0
SATSUBFROMTOC
ASSERT LAST_N == -5
ASSERT CELL(3) == -5
POP

# SSATDIVFROMTOC
CELLSET 4 5
PUSH 4
PUSH 20
SSATDIVFROMTOC
ASSERT LAST_N == 4
ASSERT CELL(4) == 4
POP

# cell 0 → 0
CELLSET 5 0
PUSH 5
PUSH 9
SCELLSATDIVFROM
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# div by -1 (set cell via SSETCELL + NEGATE)
CLEARCELLS
PUSH 6
PUSH 1
NEGATE
SSETCELL
POP
ASSERT CELL(6) == -1
PUSH 6
PUSH 15
SSATDIVFROMTOC
ASSERT LAST_N == -15
ASSERT CELL(6) == -15
POP

# soft fails
CLEARSTACK
SSATSUBFROMTOC
ASSERT OK == 0
SSATDIVFROMTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof317_ssatsubfromtoc_ssatdivfromtoc" LAST_N SP
HOLD_FLASH 1
