# Proof 155 — digit-0 dual-stack ones-metrics: DCLO DCTO DISPOW2
HOLD_FLASH 1
SCIENCE LOAD

# DCLO — count leading ones (MSB side of 64-bit)
CLEARSTACK
PUSH -1
PUSH 0
DCLO
POP y
POP x
ASSERT x == 64
ASSERT y == 0

CLEARSTACK
PUSH 0xF000000000000000
PUSH 0x8000000000000000
2CLO
POP y
POP x
ASSERT x == 4
ASSERT y == 1

# DCTO — count trailing ones
CLEARSTACK
PUSH 15
PUSH 0
DCTO
POP y
POP x
ASSERT x == 4
ASSERT y == 0

CLEARSTACK
PUSH -1
PUSH 6
2CTO
POP y
POP x
ASSERT x == 64
ASSERT y == 0

CLEARSTACK
PUSH 7
PUSH 1
PAIRCTO
POP y
POP x
ASSERT x == 3
ASSERT y == 1

# DISPOW2 — single-bit positive powers of two
CLEARSTACK
PUSH 8
PUSH 12
DISPOW2
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 0
2ISPOW2
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1024
PUSH -4
DPOW2P
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 16
PUSH 18
2POW2P
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# aliases
CLEARSTACK
PUSH 0xC000000000000000
PUSH 0xE000000000000000
PAIRCLO
POP y
POP x
ASSERT x == 2
ASSERT y == 3

CLEARSTACK
PUSH 32
PUSH 48
S2ISPOW2
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fails
CLEARSTACK
DCLO
ASSERT OK == 0
CLEARSTACK
DCTO
ASSERT OK == 0
CLEARSTACK
DISPOW2
ASSERT OK == 0
CLEARSTACK
PUSH 1
2CLO
ASSERT OK == 0
CLEARSTACK
PUSH 1
2ISPOW2
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof155_dclo_dispow2" LAST_N SP
