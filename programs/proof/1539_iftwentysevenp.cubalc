WHENHEPTEICOSAP twentyseven
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTWENTYSEVENKEYP twentyseven
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iftwentysevenp_ok" IFTWENTYSEVENP_N IFTWENTYSEVENP_LEN
