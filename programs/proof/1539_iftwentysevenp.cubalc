LET empty = "{}"

IFTWENTYSEVENP twentyseven
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFTWENTYSEVENP_N == 1
ASSERT TWENTYSEVENP_N == 1
ASSERT IFTWENTYSEVENP_LEN == 27
ASSERT IFHEPTEICOSAP_N == 1
ASSERT IFTWENTYSEVENKEYP_N == 1

IFHEPTEICOSAP twentyseven
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYSEVENKEYP twentyseven
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYSEVENP twentysix
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYSEVENP_N == 0
ASSERT IFTWENTYSEVENP_LEN == 26

IFTWENTYSEVENP twentyeight
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYSEVENP_LEN == 28

