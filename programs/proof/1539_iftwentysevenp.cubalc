  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFTWENTYSEVENP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENTWENTYSEVENP twentyseven
  LET q = 1
ELSE
  LET q = 0
END
