# Proof 310 — digit-2 imm coprime/pow: SCOPRIMEN SPOWN DCOPRIMEN DPOWN
HOLD_FLASH 1
SCIENCE LOAD

# SCOPRIMEN
CLEARSTACK
PUSH 8
SCOPRIMEN 15
POP x
ASSERT x == 1

CLEARSTACK
PUSH 12
COPRIMEN 18
POP x
ASSERT x == 0

CLEARSTACK
PUSH 7
SISCOPRIMEN 1
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0
SCOPRIMEN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH -9
SCOPRIMEN 4
POP x
ASSERT x == 1

# SPOWN
CLEARSTACK
PUSH 2
SPOWN 10
POP x
ASSERT x == 1024

CLEARSTACK
PUSH 3
POWN 4
POP x
ASSERT x == 81

CLEARSTACK
PUSH 5
SPOWIMM 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 9
SPOWN -1
POP x
ASSERT x == 0

CLEARSTACK
PUSH -2
SPOWN 3
POP x
ASSERT x == -8

# soft fails
CLEARSTACK
SCOPRIMEN 3
ASSERT OK == 0
CLEARSTACK
SPOWN 2
ASSERT OK == 0

# DCOPRIMEN
CLEARSTACK
PUSH 8
PUSH 12
DCOPRIMEN 15
POP y
POP x
# gcd(8,15)=1; gcd(12,15)=3
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 7
PUSH 11
PAIRCOPRIMEN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0
PUSH 4
2COPRIMEN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DPOWN
CLEARSTACK
PUSH 2
PUSH 3
DPOWN 4
POP y
POP x
ASSERT x == 16
ASSERT y == 81

CLEARSTACK
PUSH 5
PUSH -2
PAIRPOWN 3
POP y
POP x
ASSERT x == 125
ASSERT y == -8

CLEARSTACK
PUSH 9
PUSH 7
2POWN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 2
PUSH 3
DPOWN -1
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# dual soft
CLEARSTACK
DCOPRIMEN 3
ASSERT OK == 0
CLEARSTACK
PUSH 1
DPOWN 2
ASSERT OK == 0

# siblings still work
CLEARSTACK
PUSH 8
PUSH 15
SCOPRIME
POP x
ASSERT x == 1

CLEARSTACK
PUSH 2
PUSH 10
SPOW
POP x
ASSERT x == 1024

HOLD_FLASH 1
