# Proof 293 — digit-3 dual-stack imm sat ALU: DSATADDN DSATSUBN DSATMULN
HOLD_FLASH 1
SCIENCE LOAD

# DSATADDN n — normal
CLEARSTACK
PUSH 10
PUSH 20
DSATADDN 5
POP y
POP x
ASSERT x == 15
ASSERT y == 25

# DSATADDN — saturate +
CLEARSTACK
PUSH 9223372036854775807
PUSH 0
PAIRSATADDN 1
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 1

CLEARSTACK
PUSH 9223372036854775800
PUSH 9223372036854775807
DADDSATN 100
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 9223372036854775807

# DSATADDN — saturate -
CLEARSTACK
PUSH -9223372036854775807
PUSH 5
DSATADDN -2
POP y
POP x
ASSERT x < -9223372036854775807
ASSERT y == 3

# DSATSUBN n
CLEARSTACK
PUSH 10
PUSH -5
DSATSUBN 3
POP y
POP x
ASSERT x == 7
ASSERT y == -8

CLEARSTACK
PUSH -9223372036854775807
PUSH 0
PAIRSATSUBN 2
POP y
POP x
ASSERT x < -9223372036854775807
ASSERT y == -2

CLEARSTACK
PUSH 9223372036854775807
PUSH 1
DSUBSATN -1
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 2

# DSATMULN n
CLEARSTACK
PUSH 6
PUSH 7
DSATMULN 7
POP y
POP x
ASSERT x == 42
ASSERT y == 49

CLEARSTACK
PUSH 0
PUSH 3037000500
PAIRSATMULN 3037000500
POP y
POP x
ASSERT x == 0
ASSERT y == 9223372036854775807

CLEARSTACK
PUSH -3037000500
PUSH 9223372036854775807
DMULSATN 3037000500
POP y
POP x
ASSERT x < 0
ASSERT x < -9000000000000000000
ASSERT y == 9223372036854775807

# soft fails
CLEARSTACK
DSATADDN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSATSUBN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
POP z
DSATMULN 1
ASSERT OK == 0

HOLD_FLASH 1
