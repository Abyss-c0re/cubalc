# Proof 352 — digit-0 imm inverted bitwise TOC: SNANDTOCN SNORTOCN SXNORTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SNANDTOCN: ~(0xFF & 0x0F) = ~0x0F
CELLSET 1 255
PUSH 1
SNANDTOCN 15
# ~15 = -16
ASSERT LAST_N == (-16)
ASSERT CELL(1) == (-16)
POP a
ASSERT a == (-16)

# NANDTOCN: ~(0 & 0) = ~0 = -1
CELLSET 2 0
PUSH 2
NANDTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(2) == (-1)
POP

# SNANDATN: ~(7 & -1) = ~7 = -8
CELLSET 3 7
PUSH 3
SNANDATN (-1)
ASSERT LAST_N == (-8)
ASSERT CELL(3) == (-8)
POP

# SNORTOCN: ~(0 | 0) = -1
CELLSET 4 0
PUSH 4
SNORTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(4) == (-1)
POP

# NORTOCN: ~(8 | 1) = ~9 = -10
CELLSET 5 8
PUSH 5
NORTOCN 1
ASSERT LAST_N == (-10)
ASSERT CELL(5) == (-10)
POP

# SNORATN
CELLSET 6 0
PUSH 6
SNORATN 255
ASSERT LAST_N == (-256)
ASSERT CELL(6) == (-256)
POP

# SXNORTOCN: ~(12 ^ 10) = ~(6) = -7
CELLSET 7 12
PUSH 7
SXNORTOCN 10
ASSERT LAST_N == (-7)
ASSERT CELL(7) == (-7)
POP

# XNORTOCN equal → ~(0) = -1
CELLSET 8 99
PUSH 8
XNORTOCN 99
ASSERT LAST_N == (-1)
ASSERT CELL(8) == (-1)
POP

# SXNORATN identity xnor 0 → ~x
CELLSET 9 0
PUSH 9
SXNORATN 0
ASSERT LAST_N == (-1)
ASSERT CELL(9) == (-1)
POP

# soft fails empty stack
CLEARSTACK
SNANDTOCN 1
ASSERT OK == 0
SNORTOCN 1
ASSERT OK == 0
SXNORTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof352_snandtocn_sxnortocn" LAST_N SP
HOLD_FLASH 1
