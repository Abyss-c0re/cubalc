# Proof 369 — digit-9 reverse modular stack TOC: SSUBMODFROMTOC SPOWMODFROMTOC SMODDIVFROMTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSUBMODFROMTOC: (10-3) mod 12 = 7
CELLSET 1 3
PUSH 1
PUSH 10
PUSH 12
SSUBMODFROMTOC
ASSERT LAST_N == 7
ASSERT CELL(1) == 7
POP a
ASSERT a == 7

# RSUBMODTOC: (3-5) mod 12 = 10
CELLSET 2 5
PUSH 2
PUSH 3
PUSH 12
RSUBMODTOC
ASSERT LAST_N == 10
ASSERT CELL(2) == 10
POP

# soft m<=0 → 0
CELLSET 3 9
PUSH 3
PUSH 1
PUSH 0
SSUBMODFROMTOC
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SPOWMODFROMTOC: 2^10 mod 1000 = 24
CELLSET 4 10
PUSH 4
PUSH 2
PUSH 1000
SPOWMODFROMTOC
ASSERT LAST_N == 24
ASSERT CELL(4) == 24
POP

# RPOWMODTOC: 3^5 mod 13 = 9
CELLSET 5 5
PUSH 5
PUSH 3
PUSH 13
RPOWMODTOC
ASSERT LAST_N == 9
ASSERT CELL(5) == 9
POP

# SBASEPOWMODTOC: 5^0 mod 7 = 1
CELLSET 6 0
PUSH 6
PUSH 5
PUSH 7
SBASEPOWMODTOC
ASSERT LAST_N == 1
ASSERT CELL(6) == 1
POP

# SMODDIVFROMTOC: 10 * inv(3) mod 7 = 1
CELLSET 7 3
PUSH 7
PUSH 10
PUSH 7
SMODDIVFROMTOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# RMODDIVTOC: 1 * inv(2) mod 5 = 3
CELLSET 8 2
PUSH 8
PUSH 1
PUSH 5
RMODDIVTOC
ASSERT LAST_N == 3
ASSERT CELL(8) == 3
POP

# no inverse → 0
CELLSET 9 2
PUSH 9
PUSH 1
PUSH 4
SMODDIVFROMTOC
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft shallow OK=0
CLEARSTACK
PUSH 1
PUSH 2
SSUBMODFROMTOC
ASSERT OK == 0

PRINT "369_ssubmodfromtoc_smoddivfromtoc OK"
