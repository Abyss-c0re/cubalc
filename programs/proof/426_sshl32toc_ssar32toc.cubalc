# Proof 426 — digit-5 fixed-width shift32 TOC: SSHL32TOC SSHR32TOC SSAR32TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSHL32TOC: cell 1 = 1, k=4 → 16
CELLSET 1 1
PUSH 1
PUSH 4
SSHL32TOC
ASSERT LAST_N == 16
ASSERT CELL(1) == 16
POP

# SHL32TOC alias: 0x80000000 << 1 → 0 (uint32 overflow out)
CELLSET 2 2147483648
PUSH 2
PUSH 1
SHL32TOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SSHR32TOC: 0x80000000 >> 1 → 0x40000000
CELLSET 3 2147483648
PUSH 3
PUSH 1
SSHR32TOC
ASSERT LAST_N == 1073741824
ASSERT CELL(3) == 1073741824
POP

# SHR32TOC: k>=32 → 0
CELLSET 4 255
PUSH 4
PUSH 32
SHR32TOC
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SSAR32TOC: -16 >> 2 → -4 (build -16 via NOTCELL ~15)
CELLSET 5 15
NOTCELL 5 5
ASSERT CELL(5) == -16
PUSH 5
PUSH 2
SSAR32TOC
ASSERT LAST_N == -4
ASSERT CELL(5) == -4
POP

# SAR32TOC: 0x80000000 as int32 >> 31 → -1
CELLSET 6 2147483648
PUSH 6
PUSH 31
SAR32TOC
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# soft short
CLEARSTACK
SSHL32TOC
ASSERT OK == 0

CLEARSTACK
PUSH 0
SSHR32TOC
ASSERT OK == 0

CLEARSTACK
SSAR32TOC
ASSERT OK == 0

HOLD_FLASH 0
