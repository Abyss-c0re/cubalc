# Proof 561 — digit-8 stack+dual field signed LT0 32/16: S0LT32N S0LT16N D0LT32N D0LT16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0LT32N: 0 → 0
PUSH 0x0
S0LT32N 0
POP x
ASSERT x == 0

# positive → 0
CLEARSTACK
PUSH 0x5
SLT032N 0
POP x
ASSERT x == 0

# -1 → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SNEGZ32N 0
POP x
ASSERT x == 1

# INT_MIN → 1
CLEARSTACK
PUSH 0x80000000
SISNEG32N 0
POP x
ASSERT x == 1

# high preserve: low -2 → 1
CLEARSTACK
PUSH 0xAABBCCDDFFFFFFFE
S0LT32N 0
POP x
ASSERT x == 0xAABBCCDD00000001

# high preserve: low +3 → 0
CLEARSTACK
PUSH 0x1122334400000003
S0LT32N 0
POP x
ASSERT x == 0x1122334400000000

# STACK0LT32N n1: high negative → 1
CLEARSTACK
PUSH 0xFFFFFFFE00000007
STACK0LT32N 1
POP x
ASSERT x == 0x0000000100000007

# high positive → 0
CLEARSTACK
PUSH 0x0000000200000000
STACK0LT32N 1
POP x
ASSERT x == 0x0000000000000000

# S0LT16N: 0 → 0
CLEARSTACK
PUSH 0x0
S0LT16N 0
POP x
ASSERT x == 0

# positive → 0
CLEARSTACK
PUSH 0x7
SLT016N 0
POP x
ASSERT x == 0

# -1=0xFFFF → 1
CLEARSTACK
PUSH 0xFFFF
SNEGZ16N 0
POP x
ASSERT x == 1

# INT16_MIN=0x8000 → 1
CLEARSTACK
PUSH 0x8000
SISNEG16N 0
POP x
ASSERT x == 1

# high halfword negative: n1 of 0xFFFE_0000 → high 1
CLEARSTACK
PUSH 0xFFFE0000
STACK0LT16N 1
POP x
ASSERT x == 0x00010000

# high preserve: low negative
CLEARSTACK
PUSH 0x1234FFFD
S0LT16N 0
POP x
ASSERT x == 0x12340001

# D0LT32N
CLEARSTACK
PUSH 0x5
PUSH 0xFFFFFFFE
D0LT32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x80000000
PUSH 0x0
PAIR0LT32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LT32N n1
CLEARSTACK
PUSH 0xFFFFFFFD00000000
PUSH 0x0000000300000000
STACK20LT32N 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# D0LT16N
CLEARSTACK
PUSH 0x7
PUSH 0xFFFE
D0LT16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x8000
PUSH 0x0
PAIR0LT16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LT16N n1
CLEARSTACK
PUSH 0xFFFD0000
PUSH 0x00030000
STACK20LT16N 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

HOLD_FLASH 0
