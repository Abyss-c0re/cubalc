# Proof 216 — digit-1 dual-stack control combinators: DOVERIF DTUCKIF
HOLD_FLASH 1
SCIENCE LOAD

# DOVERIF true → OVER (a b → a b a)
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
DOVERIF
POP z
POP y
POP x
ASSERT x == 1
ASSERT y == 2
ASSERT z == 1

# false → leave a b
CLEARSTACK
PUSH 10
PUSH 20
PUSH 0
2OVERIF
POP y
POP x
ASSERT x == 10
ASSERT y == 20

# PAIROVERIF / DQOVER
CLEARSTACK
PUSH 7
PUSH 8
PUSH -1
PAIROVERIF
POP z
POP y
POP x
ASSERT x == 7
ASSERT y == 8
ASSERT z == 7

CLEARSTACK
PUSH 3
PUSH 4
PUSH 0
DQOVER
POP y
POP x
ASSERT x == 3
ASSERT y == 4

# DOVERWHEN alias
CLEARSTACK
PUSH 5
PUSH 6
PUSH 1
DOVERWHEN
POP z
POP y
POP x
ASSERT x == 5
ASSERT y == 6
ASSERT z == 5

# DTUCKIF true → TUCK (a b → b a b)
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
DTUCKIF
POP z
POP y
POP x
ASSERT x == 2
ASSERT y == 1
ASSERT z == 2

# false → leave a b
CLEARSTACK
PUSH 10
PUSH 20
PUSH 0
2TUCKIF
POP y
POP x
ASSERT x == 10
ASSERT y == 20

# PAIRTUCKIF / DQTUCK
CLEARSTACK
PUSH 9
PUSH 8
PUSH 1
PAIRTUCKIF
POP z
POP y
POP x
ASSERT x == 8
ASSERT y == 9
ASSERT z == 8

CLEARSTACK
PUSH 1
PUSH 2
PUSH 0
DQTUCK
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# DTUCKWHEN alias
CLEARSTACK
PUSH 4
PUSH 5
PUSH -3
DTUCKWHEN
POP z
POP y
POP x
ASSERT x == 5
ASSERT y == 4
ASSERT z == 5
