# Proof 438 — digit-8 cell fixed-width 8 rotate/bitrev: ROL8CELL ROR8CELL BITREV8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# ROL8CELL: 0x01 rotl 1 → 0x02; 0x80 rotl 1 → 0x01
CELLSET 0 1
CELLSET 1 128
ROL8CELL 0 1 1
ASSERT CELL(0) == 2
ASSERT CELL(1) == 1
ASSERT LAST_N == 2

# ROL8RANGE: 0x0F rotl 4 → 0xF0
CELLSET 2 15
ROL8RANGE 2 2 4
ASSERT CELL(2) == 240

# ROR8CELL: 0x02 rotr 1 → 0x01; 0x01 rotr 1 → 0x80
CELLSET 3 2
CELLSET 4 1
ROR8CELL 3 4 1
ASSERT CELL(3) == 1
ASSERT CELL(4) == 128
ASSERT LAST_N == 2

# ROR8RANGE: 0xF0 rotr 4 → 0x0F
CELLSET 5 240
ROR8RANGE 5 5 4
ASSERT CELL(5) == 15

# round-trip ROL then ROR
CELLSET 6 0xA5
ROL8CELL 6 6 3
ROR8CELL 6 6 3
ASSERT CELL(6) == 165

# BITREV8CELL: 0x01 → 0x80; 0xF0 → 0x0F; 0xA5 → 0xA5
CELLSET 7 1
CELLSET 8 240
CELLSET 9 165
BITREV8CELL 7 9
ASSERT CELL(7) == 128
ASSERT CELL(8) == 15
ASSERT CELL(9) == 165
ASSERT LAST_N == 3

# BITREV8RANGE involution
CELLSET 10 0x3C
BITREV8RANGE 10 10
BITREV8RANGE 10 10
ASSERT CELL(10) == 60

# high bits above 8 ignored
CELLSET 11 257
ROL8CELL 11 11 1
ASSERT CELL(11) == 2

HOLD_FLASH 0
