// 2083_life_cell_secrete.cubalc
// Proof 2083: life_cell secrete — merocrine/apocrine trophic vesicle (partial bequeath).
// Packs up to n yield as code=de*1000+dr; energy-first to spark=1 then reserve; mother lives.
// Distinct from gift (energy-only amt), lyse (full+die), spore (full spark pack), fission/bud, die.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY mom OF Cell 1 30 0
ENTITY kid OF Cell 1 1 1
ENTITY empty OF Cell 1 0 0
ENTITY broke OF Cell 1 5 0
ENTITY dead OF Cell 0 0 0

GETF mom energy
ASSERT LAST_N == 30 "mom spark 30"
SEND mom set_threshold 10
ASSERT LAST_N == 10 "mom thr 10"
SEND kid set_threshold 10
SEND empty set_threshold 10
SEND broke set_threshold 10

SEND mom bank 10
ASSERT LAST_N == 10 "mom bank 10"
GETF mom energy
ASSERT LAST_N == 20 "mom e 20 after bank"
SEND mom stores
ASSERT LAST_N == 10 "mom r 10"
SEND mom yield
ASSERT LAST_N == 30 "mom yield 30"

SEND mom secrete 7
ASSERT LAST_N == 7000 "secrete code de7"
GETF mom energy
ASSERT LAST_N == 13 "mom e 13 after secrete 7"
SEND mom stores
ASSERT LAST_N == 10 "mom r still 10"
GETF mom alive
ASSERT LAST_N == 1 "mom lives after secrete"
GETF mom ready
ASSERT LAST_N == 1 "mom still ready e13>=10"

SEND kid inherit 7000
ASSERT LAST_N == 7 "kid got 7"
GETF kid energy
ASSERT LAST_N == 8 "kid e 1+7"

// secrete drains energy to spark then reserve
ENTITY gland OF Cell 1 12 0
SEND gland set_threshold 10
SEND gland bank 8
SEND gland yield
ASSERT LAST_N == 12 "gland yield 12"
SEND gland secrete 10
ASSERT LAST_N == 3007 "gland code e3+r7"
GETF gland energy
ASSERT LAST_N == 1 "gland spark 1"
SEND gland stores
ASSERT LAST_N == 1 "gland r 1 left"
GETF gland alive
ASSERT LAST_N == 1 "gland lives"
GETF gland ready
ASSERT LAST_N == 0 "gland not ready e1<10"

ENTITY heir OF Cell 1 0 2
SEND heir set_threshold 10
SEND heir inherit 3007
ASSERT LAST_N == 10 "heir +10"
GETF heir energy
ASSERT LAST_N == 3 "heir e3"
SEND heir stores
ASSERT LAST_N == 7 "heir r7"
GETF heir ready
ASSERT LAST_N == 0 "heir not ready yet"

// secrete more than yield clamps to transferable
ENTITY full OF Cell 1 15 0
SEND full set_threshold 10
SEND full bank 5
SEND full secrete 100
ASSERT LAST_N == 9005 "full pack all transferable"
GETF full energy
ASSERT LAST_N == 1 "full spark"
SEND full stores
ASSERT LAST_N == 0 "full r0"
GETF full alive
ASSERT LAST_N == 1 "full lives"

// gates
SEND empty secrete 5
ASSERT LAST_N == 0 "empty no transfer e0"
SEND dead secrete 5
ASSERT LAST_N == 0 "dead 0"
SEND broke secrete 0
ASSERT LAST_N == 0 "n0 -> 0"

// G0 may still secrete
ENTITY nurse OF Cell 1 20 0
SEND nurse set_threshold 10
SEND nurse bank 6
SEND nurse quiesce
SEND nurse secrete 8
ASSERT LAST_N == 8000 "G0 nurse secrete"
GETF nurse alive
ASSERT LAST_N == 1 "G0 nurse lives"
GETF nurse ready
ASSERT LAST_N == 0 "G0 ready stays 0"
GETF nurse energy
ASSERT LAST_N == 6 "G0 e6 after secrete 8"

// gift contrast
ENTITY donor OF Cell 1 16 0
SEND donor set_threshold 10
SEND donor gift 5
ASSERT LAST_N == 5 "gift gave 5"
GETF donor alive
ASSERT LAST_N == 1 "gift keeps alive"
GETF donor energy
ASSERT LAST_N == 11 "gift e11"
SEND donor secrete 4
ASSERT LAST_N == 4000 "secrete code after gift"
GETF donor energy
ASSERT LAST_N == 7 "secrete e7"
GETF donor alive
ASSERT LAST_N == 1 "secrete keeps alive"

// lyse contrast
ENTITY twin_s OF Cell 1 14 0
ENTITY twin_l OF Cell 1 14 0
SEND twin_s set_threshold 10
SEND twin_l set_threshold 10
SEND twin_s bank 4
SEND twin_l bank 4
SEND twin_s secrete 100
LET sc = LAST_N
ASSERT sc == 9004 "secrete twin full transferable"
GETF twin_s alive
ASSERT LAST_N == 1 "secrete twin lives"
SEND twin_l lyse
LET lc = LAST_N
ASSERT lc == 10004 "lyse twin full e10+r4"
GETF twin_l alive
ASSERT LAST_N == 0 "lyse twin dies"

// spore contrast
ENTITY sp OF Cell 1 24 0
SEND sp set_threshold 10
SEND sp bank 6
SEND sp spore
ASSERT LAST_N == 17006 "spore full de17+r6"
GETF sp energy
ASSERT LAST_N == 1 "spore spark"
GETF sp alive
ASSERT LAST_N == 1 "spore mother lives"
ENTITY sec OF Cell 1 24 0
SEND sec set_threshold 10
SEND sec bank 6
SEND sec secrete 5
ASSERT LAST_N == 5000 "secrete meters 5 energy"
GETF sec energy
ASSERT LAST_N == 13 "secrete mother e13"
SEND sec stores
ASSERT LAST_N == 6 "secrete r held"

// conservation
ENTITY c_d OF Cell 1 25 0
ENTITY c_k OF Cell 1 2 3
SEND c_d set_threshold 10
SEND c_k set_threshold 10
SEND c_d bank 5
SEND c_d yield
LET yd0 = LAST_N
ASSERT yd0 == 25 "c_d yield 25"
SEND c_k yield
LET yk0 = LAST_N
SEND c_d secrete 12
LET cc = LAST_N
ASSERT cc == 12000 "conserv code 12"
SEND c_d yield
LET yd1 = LAST_N
ASSERT yd0 - yd1 == 12 "donor shed 12"
SEND c_k inherit cc
ASSERT LAST_N == 12 "kid absorb 12"
SEND c_k yield
LET yk1 = LAST_N
ASSERT yk1 - yk0 == 12 "kid gain 12"
ASSERT yd1 + yk1 == yd0 + yk0 "pair conservation"

// vitality/sense
SEND c_d vitality
ASSERT LAST_N > 0 "secreting cell vitality >0"
SEND c_d sense
ASSERT LAST_N < 0 "sense below thr after big secrete"

// reserve-only secrete when energy already spark
ENTITY lean OF Cell 1 1 0
SEND lean set_threshold 10
SEND lean feed 9
ASSERT LAST_N == 10 "lean feed total e10"
SEND lean bank 9
SEND lean secrete 4
ASSERT LAST_N == 4 "reserve-only code dr4"
GETF lean energy
ASSERT LAST_N == 1 "lean spark held"
SEND lean stores
ASSERT LAST_N == 5 "lean r5"

// ready recompute
ENTITY hot OF Cell 1 15 0
SEND hot set_threshold 10
GETF hot ready
ASSERT LAST_N == 1 "hot ready"
SEND hot secrete 8
ASSERT LAST_N == 8000 "hot secrete 8"
GETF hot energy
ASSERT LAST_N == 7 "hot e7"
GETF hot ready
ASSERT LAST_N == 0 "hot ready cleared by secrete"

ASSERT 1 == 1 "proof 2083 secrete sealed"
