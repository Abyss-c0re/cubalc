# RUNSNIP MATCH / NTH / LASTMATCH — filter pick + execute curated mini
# Twin of GUIDE MATCH for prove-surface path. needle "p" → cap/plate/p2p/protect

RUNSNIP MATCH p
ASSERT OK == 1
ASSERT RUNSNIP_OK == 1
ASSERT RUNSNIP_TOPIC == "cap"
ASSERT TOPIC_NAME == "cap"
ASSERT RUNSNIP_MATCH_N == 4
ASSERT RUNSNIP_MATCH_I == 0
ASSERT PICKTOPIC == "cap"

# standalone first
RUNSNIPMATCH p
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "cap"
ASSERT RUNSNIPMATCH == "cap"

# NTH pick → plate mini
RUNSNIP NTH 1 p
ASSERT OK == 1
ASSERT RUNSNIP_OK == 1
ASSERT RUNSNIP_TOPIC == "plate"
ASSERT RUNSNIP_MATCH_I == 1

RUNSNIPNTH 2 p
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "p2p"
ASSERT RUNSNIP_OK == 1

# last matching → protect
RUNSNIP LASTMATCH p
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "protect"
ASSERT RUNSNIP_MATCH_I == 3
ASSERT RUNSNIP_OK == 1

RUNSNIPLASTMATCH p
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "protect"

# aliases FIRST / PICK
RUNSNIP FIRST lib
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "lib"
ASSERT RUNSNIP_OK == 1

RUNSNIP PICK mesh
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "p2p"

# synonym filter
RUNSNIPMATCH forms
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "cap"

# OR fallback
RUNSNIP MATCH zzz OR general
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "general"
ASSERT RUNSNIP_OK == 1

RUNSNIPNTH 9 p OR run
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "run"

# soft miss
RUNSNIP MATCH zzz_nope
ASSERT OK == 0
ASSERT RUNSNIP_OK == 0
CLEAR_ERR

RUNSNIPNTH 5 p
ASSERT OK == 0
CLEAR_ERR

RUNSNIP LASTMATCH zzz
ASSERT OK == 0
CLEAR_ERR

RUNSNIPMATCH
ASSERT OK == 0
CLEAR_ERR

# direct RUNSNIP still works
RUNSNIP plate
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "plate"
ASSERT RUNSNIP_OK == 1

# preserve RUNSNIP LAST as use LAST string (set via PICKTOPIC first)
PICKTOPIC lib
RUNSNIP LAST
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "lib"

PASS
PRINT "1351_runsnipmatch: PASS"
