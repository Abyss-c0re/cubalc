# Proof 114 — digit-0 stack immediate inverted bitwise: SNANDI SNORI SXNORI
HOLD_FLASH 1
SCIENCE LOAD

# SNANDI — ~(0xFF & 0x0F) = ~0x0F = ...F0
CLEARSTACK
PUSH 0xFF
SNANDI 0x0F
ASSERT LAST_N == -16

# SNORI — ~(0x00 | 0x00) = ~0 = -1
CLEARSTACK
PUSH 0
SNORI 0
ASSERT LAST_N == -1

# SNORI — ~(0x0F | 0xF0) = ~0xFF = ...00 low byte
CLEARSTACK
PUSH 0x0F
SNORI 0xF0
# ~0xFF == -256 on 64-bit two's complement? 0xFF=255, ~255 = -256
ASSERT LAST_N == -256

# SXNORI — equivalence: ~(a^a) = ~0 = -1
CLEARSTACK
PUSH 0x5A
SXNORI 0x5A
ASSERT LAST_N == -1

# SXNORI — ~(0xFF ^ 0x0F) = ~0xF0
CLEARSTACK
PUSH 0xFF
SXNORI 0x0F
ASSERT LAST_N == -241

# aliases NANDI NORI XNORI
CLEARSTACK
PUSH 0x0F
NANDI 0x0F
ASSERT LAST_N == -16
CLEARSTACK
PUSH 0
NORI 0
ASSERT LAST_N == -1
CLEARSTACK
PUSH 7
XNORI 7
ASSERT LAST_N == -1

# chain: mask then nand-imm recovers invert of masked
CLEARSTACK
PUSH 0xAB
SANDI 0x0F
SNANDI 0x0F
ASSERT LAST_N == -12
# 0xAB&0x0F=0x0B=11; ~(11&15)=~11=-12

# soft fail empty
CLEARSTACK
SNANDI 1
ASSERT OK == 0
SNORI 1
ASSERT OK == 0
SXNORI 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof114_snandi_sxnori" LAST_N SP
