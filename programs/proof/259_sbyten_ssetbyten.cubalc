# Proof 259 — digit-1 stack imm byte field: SBYTEN SSETBYTEN SCLRBYTEN
HOLD_FLASH 1
SCIENCE LOAD

# SBYTEN — extract LE byte
CLEARSTACK
PUSH 0xAABBCCDD
SBYTEN 0
POP x
ASSERT x == 0xDD

CLEARSTACK
PUSH 0xAABBCCDD
STACKBYTEN 1
POP x
ASSERT x == 0xCC

CLEARSTACK
PUSH 0xAABBCCDD
GETBYTEN 2
POP x
ASSERT x == 0xBB

CLEARSTACK
PUSH 0xAABBCCDD
BYTEN 3
POP x
ASSERT x == 0xAA

# clamp index high
CLEARSTACK
PUSH 0x1122334455667788
SBYTEN 99
POP x
ASSERT x == 0x11

# SSETBYTEN field n
CLEARSTACK
PUSH 0x00000000
SSETBYTEN 0xAB 0
POP x
ASSERT x == 0xAB

CLEARSTACK
PUSH 0x00000000
STACKSETBYTEN 0xCD 1
POP x
ASSERT x == 0xCD00

CLEARSTACK
PUSH -1
SETBYTEN 0 2
POP x
# clear LE byte 2 (bits 16..23): -1 & ~0xFF0000
ASSERT x == -16711681

CLEARSTACK
PUSH 0x00
PUTBYTEN 0xFF 3
POP x
ASSERT x == 0xFF000000

# SCLRBYTEN n
CLEARSTACK
PUSH 0xAABBCCDD
SCLRBYTEN 0
POP x
ASSERT x == 0xAABBCC00

CLEARSTACK
PUSH 0xAABBCCDD
STACKCLRBYTEN 1
POP x
ASSERT x == 0xAABB00DD

CLEARSTACK
PUSH 0xAABBCCDD
CLRBYTEN 2
POP x
ASSERT x == 0xAA00CCDD

CLEARSTACK
PUSH 0xAABBCCDD
ZAPBYTEN 3
POP x
ASSERT x == 0x00BBCCDD

# soft fails
CLEARSTACK
SBYTEN 0
ASSERT OK == 0
CLEARSTACK
SSETBYTEN 1 0
ASSERT OK == 0
CLEARSTACK
SCLRBYTEN 0
ASSERT OK == 0

HOLD_FLASH 1
