# Proof 458 — digit-2 cell fixed-width 4 nibble rotate/bitrev: ROL4CELL ROR4CELL BITREV4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# ROL4CELL: 0x1 rotl 1 → 0x2; 0x8 rotl 1 → 0x1
CELLSET 0 1
CELLSET 1 8
ROL4CELL 0 1 1
ASSERT CELL(0) == 2
ASSERT CELL(1) == 1
ASSERT LAST_N == 2

# ROL4RANGE: 0x3 rotl 2 → 0xC
CELLSET 2 3
ROL4RANGE 2 2 2
ASSERT CELL(2) == 12

# ROR4CELL: 0x2 rotr 1 → 0x1; 0x1 rotr 1 → 0x8
CELLSET 3 2
CELLSET 4 1
ROR4CELL 3 4 1
ASSERT CELL(3) == 1
ASSERT CELL(4) == 8
ASSERT LAST_N == 2

# ROR4RANGE: 0xC rotr 2 → 0x3
CELLSET 5 12
ROR4RANGE 5 5 2
ASSERT CELL(5) == 3

# round-trip ROL then ROR
CELLSET 6 0xA
ROL4CELL 6 6 1
ROR4CELL 6 6 1
ASSERT CELL(6) == 10

# BITREV4CELL: 0x1 → 0x8; 0x3 → 0xC; 0x5 → 0xA; 0xF → 0xF
CELLSET 7 1
CELLSET 8 3
CELLSET 9 5
CELLSET 10 15
BITREV4CELL 7 10
ASSERT CELL(7) == 8
ASSERT CELL(8) == 12
ASSERT CELL(9) == 10
ASSERT CELL(10) == 15
ASSERT LAST_N == 4

# BITREV4RANGE involution
CELLSET 11 0x6
BITREV4RANGE 11 11
BITREV4RANGE 11 11
ASSERT CELL(11) == 6

# high bits above 4 ignored
CELLSET 12 17
ROL4CELL 12 12 1
ASSERT CELL(12) == 2

# ROLNIBCELL alias: 0x9 rotl 1 → 0x3
CELLSET 13 9
ROLNIBCELL 13 13 1
ASSERT CELL(13) == 3

# k masked to 2 bits: k=5 → k&3=1
CELLSET 14 1
ROL4CELL 14 14 5
ASSERT CELL(14) == 2

HOLD_FLASH 0
