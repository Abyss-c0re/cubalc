# Proof 498 — digit-7 stack imm 8-bit field unary+rotate: SNOT8N SROL8N SROR8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SNOT8N n0: 0x00 → 0xFF ; 0x0F → 0xF0
PUSH 0x00
SNOT8N 0
POP x
ASSERT x == 255

CLEARSTACK
PUSH 0x0F
NOT8N 0
POP x
ASSERT x == 240

# high preserved not
CLEARSTACK
PUSH 0x1122334455667788
SNOT8N 0
POP x
ASSERT x == 0x1122334455667777

# STACKNOT8N n1: byte1 of 0xAA88 is AA → ~AA=55 → 0x5588
CLEARSTACK
PUSH 0xAA88
STACKNOT8N 1
POP x
ASSERT x == 0x5588

# SINV8N alias: 0xFF → 0
CLEARSTACK
PUSH 0xFF
SINV8N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x80
SINVERT8N 0
POP x
ASSERT x == 127

# SROL8N k=1 n0: 0x81 → 0x03 ; 0x01 → 0x02
CLEARSTACK
PUSH 0x81
SROL8N 1 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x01
ROL8N 1 0
POP x
ASSERT x == 2

# high preserved rol
CLEARSTACK
PUSH 0x1122334455667781
SROL8N 1 0
POP x
ASSERT x == 0x1122334455667703

# STACKROL8N n1: byte1 of 0x0180 is 01 rotl1 → 02 → 0x0280
CLEARSTACK
PUSH 0x0180
STACKROL8N 1 1
POP x
ASSERT x == 0x0280

# SROR8N k=1 n0: 0x02 → 0x01 ; 0x01 → 0x80
CLEARSTACK
PUSH 0x02
SROR8N 1 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x01
ROR8N 1 0
POP x
ASSERT x == 128

# round-trip ROL then ROR
CLEARSTACK
PUSH 0xA5
SROL8N 3 0
SROR8N 3 0
POP x
ASSERT x == 0xA5

# k masked: k=9 → k&7=1
CLEARSTACK
PUSH 0x01
SROR8N 9 0
POP x
ASSERT x == 128

# STACKROR8N n1: byte1 of 0x0200 is 02 → rotr1 → 01 → 0x0100
CLEARSTACK
PUSH 0x0200
STACKROR8N 1 1
POP x
ASSERT x == 0x0100

# SROTL8N alias
CLEARSTACK
PUSH 0x10
SROTL8N 1 0
POP x
ASSERT x == 32

# SNOTBYTEN alias
CLEARSTACK
PUSH 0x0F
SNOTBYTEN 0
POP x
ASSERT x == 240

HOLD_FLASH 0
