# Proof 347 — digit-5 imm bitwise TOC: SANDTOCN SORTOCN SXORTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDTOCN: 0xFF & 0x0F → 0x0F
CELLSET 1 255
PUSH 1
SANDTOCN 15
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP a
ASSERT a == 15

# ANDTOCN clear all
CELLSET 2 42
PUSH 2
ANDTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SANDATN identity
CELLSET 3 7
PUSH 3
SANDATN (-1)
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# SORTOCN: 8 | 1 → 9
CELLSET 4 8
PUSH 4
SORTOCN 1
ASSERT LAST_N == 9
ASSERT CELL(4) == 9
POP

# ORTOCN set bit
CELLSET 5 0
PUSH 5
ORTOCN 16
ASSERT LAST_N == 16
ASSERT CELL(5) == 16
POP

# SORATN no-op or 0
CELLSET 6 5
PUSH 6
SORATN 0
ASSERT LAST_N == 5
ASSERT CELL(6) == 5
POP

# SXORTOCN: 0b1100 ^ 0b1010 → 0b0110 = 6
CELLSET 7 12
PUSH 7
SXORTOCN 10
ASSERT LAST_N == 6
ASSERT CELL(7) == 6
POP

# XORTOCN toggle self → 0
CELLSET 8 99
PUSH 8
XORTOCN 99
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# SXORATN xor 0 identity
CELLSET 9 17
PUSH 9
SXORATN 0
ASSERT LAST_N == 17
ASSERT CELL(9) == 17
POP

# soft fails empty stack
CLEARSTACK
SANDTOCN 1
ASSERT OK == 0
SORTOCN 1
ASSERT OK == 0
SXORTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof347_sandtocn_sxortocn" LAST_N SP
HOLD_FLASH 1
