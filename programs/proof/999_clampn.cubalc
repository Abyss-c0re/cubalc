# CLAMPN / BOUNDN — clamp numeric values after GETFLAGN

HOLD_FLASH 1

# in range unchanged
CLAMPN 50 1 100
ASSERT LAST_N == 50
ASSERT CLAMPN_CHANGED == 0
SYS EQS LAST "50"
ASSERT LAST_N == 1

# below lo
CLAMPN 0 1 100
ASSERT LAST_N == 1
ASSERT CLAMPN_CHANGED == 1
ASSERT CLAMPN_X == 0

# above hi
CLAMPN 200 1 TO 100
ASSERT LAST_N == 100
ASSERT CLAMPN_CHANGED == 1

# swapped bounds
CLAMPN 5 10 1
ASSERT LAST_N == 5
ASSERT CLAMPN_CHANGED == 0

# LAST_N after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--workers=100"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN workers OR 4
ASSERT LAST_N == 100
CLAMPN LAST_N 1 16
ASSERT LAST_N == 16
ASSERT CLAMPN_CHANGED == 1

# GETFLAGMS then clamp to 60s
SYS ENV SET CUBALC_ARG0 "--ttl=2h"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGMS ttl OR "30s"
ASSERT LAST_N == 7200000
CLAMPN LAST_N 1000 60000
ASSERT LAST_N == 60000

# BOUNDN / CLIPN aliases
BOUNDN -5 0 10
ASSERT LAST_N == 0
CLIPN 99 0 10
ASSERT LAST_N == 10

# var subject
LET n 1000
CLAMPN n 0 255
ASSERT LAST_N == 255

PRINT "clampn ok"
