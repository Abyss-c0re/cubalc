# Proof 198 — digit-1 dual-stack control: DSEL2 DMUX2
HOLD_FLASH 1
SCIENCE LOAD

# DSEL2: fa fb ta tb ca cb → (ca?ta:fa) (cb?tb:fb)
CLEARSTACK
PUSH 1
PUSH 2
PUSH 10
PUSH 20
PUSH 1
PUSH 0
DSEL2
POP y
POP x
ASSERT x == 10
ASSERT y == 2

# both true
CLEARSTACK
PUSH 0
PUSH 0
PUSH 7
PUSH 8
PUSH 1
PUSH 1
2SEL2
POP y
POP x
ASSERT x == 7
ASSERT y == 8

# both false
CLEARSTACK
PUSH 3
PUSH 4
PUSH 9
PUSH 11
PUSH 0
PUSH 0
PAIRSEL2
POP y
POP x
ASSERT x == 3
ASSERT y == 4

# DMUX2 alias mixed
CLEARSTACK
PUSH 100
PUSH 200
PUSH 1
PUSH 2
PUSH 0
PUSH 1
DMUX2
POP y
POP x
ASSERT x == 100
ASSERT y == 2

# 2MUX2 nonzero cond is true
CLEARSTACK
PUSH 5
PUSH 6
PUSH 50
PUSH 60
PUSH -1
PUSH 2
2MUX2
POP y
POP x
ASSERT x == 50
ASSERT y == 60

# PAIRMUX2
CLEARSTACK
PUSH -3
PUSH -4
PUSH 30
PUSH 40
PUSH 1
PUSH 0
PAIRMUX2
POP y
POP x
ASSERT x == 30
ASSERT y == -4
