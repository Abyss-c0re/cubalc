# Proof 183 — digit-7 dual-stack unsigned ALU: DUDIV DUMOD
HOLD_FLASH 1
SCIENCE LOAD

# DUDIV: a b c d → ua/uc ub/ud
CLEARSTACK
PUSH 20
PUSH 15
PUSH 3
PUSH 4
DUDIV
POP y
POP x
ASSERT x == 6
ASSERT y == 3

# 2UDIV
CLEARSTACK
PUSH 100
PUSH 50
PUSH 10
PUSH 5
2UDIV
POP y
POP x
ASSERT x == 10
ASSERT y == 10

# /0 → 0
CLEARSTACK
PUSH 7
PUSH 8
PUSH 0
PUSH 2
DUDIVIDE
POP y
POP x
ASSERT x == 0
ASSERT y == 4

# DUMOD
CLEARSTACK
PUSH 20
PUSH 15
PUSH 3
PUSH 4
DUMOD
POP y
POP x
ASSERT x == 2
ASSERT y == 3

# 2UMOD
CLEARSTACK
PUSH 17
PUSH 11
PUSH 5
PUSH 3
2UMOD
POP y
POP x
ASSERT x == 2
ASSERT y == 2

# DUREM %0 → 0
CLEARSTACK
PUSH 9
PUSH 9
PUSH 0
PUSH 0
DUREM
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# large unsigned (negative as unsigned)
# -1 as uint64 is max; /2 → high quot
CLEARSTACK
PUSH -1
PUSH -1
PUSH 2
PUSH 2
PAIRUDIV
POP y
POP x
# (2^64-1)/2 = 2^63-1 = 9223372036854775807 on 64-bit
ASSERT x == 9223372036854775807
ASSERT y == 9223372036854775807

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
DUDIV
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DUMOD
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof183_dudiv_dumod" LAST_N SP
