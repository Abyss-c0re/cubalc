# Proof 559 — digit-1 stack+dual field nonzero 32/16: S0NE32N S0NE16N D0NE32N D0NE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0NE32N: 0 → 0
PUSH 0x0
S0NE32N 0
POP x
ASSERT x == 0

# non-zero → 1
CLEARSTACK
PUSH 0x5
SNZ32N 0
POP x
ASSERT x == 1

# -1 field nonzero
CLEARSTACK
PUSH 0xFFFFFFFF
SNEZ32N 0
POP x
ASSERT x == 1

# high preserve: low 0 → 0
CLEARSTACK
PUSH 0xAABBCCDD00000000
SISNZ32N 0
POP x
ASSERT x == 0xAABBCCDD00000000

# high preserve: low 3 → 1
CLEARSTACK
PUSH 0x1122334400000003
S0NE32N 0
POP x
ASSERT x == 0x1122334400000001

# STACK0NE32N n1: high nonzero → 1; low stays 0
CLEARSTACK
PUSH 0x0000000200000000
STACK0NE32N 1
POP x
ASSERT x == 0x0000000100000000

# high zero → 0
CLEARSTACK
PUSH 0x0000000000000007
STACK0NE32N 1
POP x
ASSERT x == 0x0000000000000007

# S0NE16N: 0 → 0
CLEARSTACK
PUSH 0x0
S0NE16N 0
POP x
ASSERT x == 0

# non-zero → 1
CLEARSTACK
PUSH 0x1
SNZ16N 0
POP x
ASSERT x == 1

# high halfword nonzero: n1 of 0x0005_0000 → high 1
CLEARSTACK
PUSH 0x00050000
STACK0NE16N 1
POP x
ASSERT x == 0x00010000

# high preserve around low nonzero of 0xABCD
CLEARSTACK
PUSH 0x1234ABCD
S0NE16N 0
POP x
ASSERT x == 0x12340001

# D0NE32N
CLEARSTACK
PUSH 0x0
PUSH 0x3
D0NE32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x0
PAIR0NE32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20NE32N n1
CLEARSTACK
PUSH 0x0000000000000001
PUSH 0x0000000500000000
STACK20NE32N 1
POP y
POP x
ASSERT x == 0x0000000000000001
ASSERT y == 0x0000000100000000

# D0NE16N
CLEARSTACK
PUSH 0x0
PUSH 0x7
D0NE16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0xFFFF
PUSH 0x0
PAIR0NE16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20NE16N n1
CLEARSTACK
PUSH 0x00000003
PUSH 0x00050000
STACK20NE16N 1
POP y
POP x
ASSERT x == 0x00000003
ASSERT y == 0x00010000

HOLD_FLASH 0
