# Proof 504 — digit-8 dual-stack imm 16-bit field shift: DSHL16N DSHR16N DSAR16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DSHL16N: 1<<2=4 both
PUSH 0x1
PUSH 0x1
DSHL16N 2 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# overflow: 0x8000 << 1 → 0; preserve high
CLEARSTACK
PUSH 0x112233448000
PUSH 0x99AABBCC4000
PAIRSHL16N 1 0
POP y
POP x
ASSERT x == 0x112233440000
ASSERT y == 0x99AABBCC8000

# k>=16 → 0
CLEARSTACK
PUSH 0xFFFF
PUSH 0xABCD
DSHL16N 16 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# S2SHL16N n1: half1 of 0x00030001 is 0003 <<1 → 0006 → 0x00060001
CLEARSTACK
PUSH 0x00030001
PUSH 0x00020000
S2SHL16N 1 1
POP y
POP x
ASSERT x == 0x00060001
ASSERT y == 0x00040000

# DSHR16N logical: 0x8000>>1=0x4000 ; 0xFFFF>>2=0x3FFF
CLEARSTACK
PUSH 0x8000
PUSH 0xFFFF
DSHR16N 1 0
POP y
POP x
ASSERT x == 16384
ASSERT y == 16383

# high preserved shr
CLEARSTACK
PUSH 0x11223344FFFC
PUSH 0x99AABBCC000C
PAIRSHR16N 2 0
POP y
POP x
ASSERT x == 0x112233443FFF
ASSERT y == 0x99AABBCC0003

# STACK2SHR16N n1: 0x80000000 half1=8000>>1=4000 → 0x40000000
CLEARSTACK
PUSH 0x80000000
PUSH 0xA0000000
STACK2SHR16N 1 1
POP y
POP x
ASSERT x == 0x40000000
ASSERT y == 0x50000000

# DSAR16N: 0xFFFE (-2)>>1 → 0xFFFF ; 0x8000 (-32768)>>1 → 0xC000
CLEARSTACK
PUSH 0xFFFE
PUSH 0x8000
DSAR16N 1 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 49152

# k>=16 all sign: neg → FFFF, pos → 0
CLEARSTACK
PUSH 0x8000
PUSH 0x7FFF
PAIRSAR16N 16 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 0

# positive SAR: 0x0006>>1=3 ; 0x0004>>1=2
CLEARSTACK
PUSH 0x0006
PUSH 0x0004
DSAR16N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved SAR half1: 0x..FFFE0000 half1=FFFE → FFFF
CLEARSTACK
PUSH 0x11223344FFFE0000
PUSH 0x99AABBCC80000000
S2SAR16N 1 1
POP y
POP x
ASSERT x == 0x11223344FFFF0000
ASSERT y == 0x99AABBCCC0000000

# DLSH16N / DASHR16N aliases
CLEARSTACK
PUSH 0x0003
PUSH 0x0003
DLSH16N 1 0
POP y
POP x
ASSERT x == 6
ASSERT y == 6

CLEARSTACK
PUSH 0xFFFE
PUSH 0xFFFE
DASHR16N 1 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 65535

HOLD_FLASH 0
