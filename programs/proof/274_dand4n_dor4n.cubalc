PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DOR4N 0xC 0
POP y
POP x
ASSERT x == 0x112233445566778C
ASSERT y == 0x99AABBCCDDEEFF0C

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIROR4N 0x1 1
POP y
POP x
ASSERT x == 0x1122334455667798
ASSERT y == 0x99AABBCCDDEEFF10

CLEARSTACK
PUSH 0
PUSH 0
DSETOR4N 0xA 3
POP y
POP x
ASSERT x == 0xA000
ASSERT y == 0xA000

# DXOR4N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXOR4N 0xF 0
POP y
POP x
ASSERT x == 0x1122334455667787
ASSERT y == 0x99AABBCCDDEEFF0F

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXOR4N 0x1 15
POP y
POP x
ASSERT x == 0x0122334455667788
ASSERT y == 0x89AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DFLIP4N 0xF 0
POP y
POP x
