# Proof 274 — digit-4 dual-stack imm 4-bit field bitwise: DAND4N DOR4N DXOR4N
HOLD_FLASH 1
SCIENCE LOAD

# DAND4N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DAND4N 0x3 0
POP y
POP x
ASSERT x == 0x1122334455667780
ASSERT y == 0x99AABBCCDDEEFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRAND4N 0x3 1
POP y
POP x
ASSERT x == 0x1122334455667708
ASSERT y == 0x99AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DKEEP4N 0xA 0
POP y
POP x
ASSERT x == -6
ASSERT y == -6

# DOR4N field n
