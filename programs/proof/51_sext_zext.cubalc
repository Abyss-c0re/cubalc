# Proof 51 — digit-8 sign/zero extend: SEXT ZEXT SEXT8/16 + stack duals
HOLD_FLASH 1
SCIENCE LOAD

# ZEXT mask low bits
ASSERT ZEXT(0xFF, 4) == 0xF
ASSERT ZEXT(0xABCD, 8) == 0xCD
ASSERT ZEROEXT(0x1234, 12) == 0x234
ASSERT ZEXT(0xFFFF, 0) == 0

# SEXT sign-extend
ASSERT SEXT(0x0F, 4) == -1
ASSERT SEXT(0x07, 4) == 7
ASSERT SEXT(0x80, 8) == -128
ASSERT SEXT(0x7F, 8) == 127
ASSERT SIGNEXT(0x8000, 16) == -32768
ASSERT SEXT(0x7FFF, 16) == 32767

# fixed-width helpers
ASSERT SEXT8(0xFF) == -1
ASSERT SEXTB(0x80) == -128
ASSERT SEXTB(0x7F) == 127
ASSERT SEXT16(0xFFFF) == -1
ASSERT SEXTW(0x8000) == -32768
ASSERT SEXT16(0x1234) == 0x1234

# stack SZEXT
CLEARSTACK
PUSH 0xABCD
PUSH 8
SZEXT
ASSERT LAST_N == 0xCD

# stack SSEXT
CLEARSTACK
PUSH 0x0F
PUSH 4
SSEXT
ASSERT LAST_N == -1
CLEARSTACK
PUSH 0x80
PUSH 8
SSIGNEXT
ASSERT LAST_N == -128

# unary stack SSEXT8 / SSEXT16
CLEARSTACK
PUSH 0xFF
SSEXT8
ASSERT LAST_N == -1
CLEARSTACK
PUSH 0x80
SSEXTB
ASSERT LAST_N == -128
CLEARSTACK
PUSH 0x8000
SSEXT16
ASSERT LAST_N == -32768
CLEARSTACK
PUSH 0x1234
SSEXTW
ASSERT LAST_N == 0x1234

# compose: nibble then sext
CLEARSTACK
PUSH 0xAB
PUSH 0
SNIB
PUSH 4
SSEXT
ASSERT LAST_N == -5

# underflow
CLEARSTACK
SSEXT
ASSERT OK == 0
CLEARSTACK
SZEXT
ASSERT OK == 0
CLEARSTACK
SSEXT8
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof51_sext_zext" LAST_N SP
