# Proof 256 — digit-3 stack immediate clamp/range: SCLAMPN SBETWEENN SWITHINN
HOLD_FLASH 1
SCIENCE LOAD

# SCLAMPN lo hi
CLEARSTACK
PUSH 5
SCLAMPN 0 10
POP x
ASSERT x == 5

CLEARSTACK
PUSH -3
STACKCLAMPN 0 10
POP x
ASSERT x == 0

CLEARSTACK
PUSH 99
CLAMPN 0 10
POP x
ASSERT x == 10

# lo>hi swap
CLEARSTACK
PUSH 5
SCLAMPN 10 0
POP x
ASSERT x == 5

CLEARSTACK
PUSH 50
BOUNDN 10 0
POP x
ASSERT x == 10

# SBETWEENN inclusive
CLEARSTACK
PUSH 5
SBETWEENN 0 10
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0
SINRANGEN 0 10
POP x
ASSERT x == 1

CLEARSTACK
PUSH 10
BETWEENN 0 10
POP x
ASSERT x == 1

CLEARSTACK
PUSH 11
SBETWEENN 0 10
POP x
ASSERT x == 0

CLEARSTACK
PUSH -1
SBETWEENN 0 10
POP x
ASSERT x == 0

# lo>hi swap for between
CLEARSTACK
PUSH 5
SBETWEENN 10 0
POP x
ASSERT x == 1

# SWITHINN half-open [lo,hi)
CLEARSTACK
PUSH 0
SWITHINN 0 10
POP x
ASSERT x == 1

CLEARSTACK
PUSH 9
STACKWITHINN 0 10
POP x
ASSERT x == 1

CLEARSTACK
PUSH 10
WITHINN 0 10
POP x
ASSERT x == 0

CLEARSTACK
PUSH -1
SWITHINN 0 10
POP x
ASSERT x == 0

# soft fails
CLEARSTACK
SCLAMPN 0 1
ASSERT OK == 0
CLEARSTACK
SBETWEENN 0 1
ASSERT OK == 0
CLEARSTACK
SWITHINN 0 1
ASSERT OK == 0

HOLD_FLASH 1
