# IROOT4N / IQRTN / IFOURTHN — floor integer 4th root usability form

HOLD_FLASH 1

# perfect 4th powers
IROOT4N 16
ASSERT LAST_N == 2
ASSERT IROOT4N_OK == 1
ASSERT IROOT4N_X == 16

IROOT4N 81
ASSERT LAST_N == 3

IROOT4N 1
ASSERT LAST_N == 1

IROOT4N 0
ASSERT LAST_N == 0
ASSERT IROOT4N_OK == 1

IROOT4N 256
ASSERT LAST_N == 4

IROOT4N 625
ASSERT LAST_N == 5

IROOT4N 10000
ASSERT LAST_N == 10

# non-perfect floor
IROOT4N 15
ASSERT LAST_N == 1

IROOT4N 17
ASSERT LAST_N == 2

IROOT4N 80
ASSERT LAST_N == 2

IROOT4N 82
ASSERT LAST_N == 3

IROOT4N 2
ASSERT LAST_N == 1

IROOT4N 255
ASSERT LAST_N == 3

# negative soft-fail
IROOT4N -16
ASSERT LAST_N == 0
ASSERT IROOT4N_OK == 0

IROOT4N -1
ASSERT LAST_N == 0
ASSERT IROOT4N_OK == 0

# aliases
IQRTN 16
ASSERT LAST_N == 2
IFOURTHN 81
ASSERT LAST_N == 3
FLOORROOT4N 100
ASSERT LAST_N == 3
INTROOT4N 2401
ASSERT LAST_N == 7
ROOT4N 50
ASSERT LAST_N == 2
FOURTHROOTN 4096
ASSERT LAST_N == 8

# var subject
LET hv = 65536
IROOT4N hv
ASSERT LAST_N == 16

# pipeline after GETFLAGN
SYS ENV SET CUBALC_ARG0 "--hypervol=10000"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN hypervol OR 0
IROOT4N LAST_N
ASSERT LAST_N == 10

# larger
IROOT4N 100000000
ASSERT LAST_N == 100

PRINT "iroot4n ok"
