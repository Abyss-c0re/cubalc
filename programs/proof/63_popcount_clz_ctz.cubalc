# Proof 63 — digit-1 POPCNT FFS/FLS CLO/CTO BWIDTH + aliases + stack
HOLD_FLASH 1
SCIENCE LOAD

# POPCNT alias of BITCOUNT
ASSERT POPCNT(0) == 0
ASSERT POPCNT(7) == 3
ASSERT POPCOUNT(0xFF) == 8
ASSERT POPCNT(0xF0F0) == BITCOUNT(0xF0F0)

# CTZ / NTZ / CLZ / NLZ (existing + aliases)
ASSERT CTZ(8) == 3
ASSERT NTZ(8) == 3
ASSERT CTZ(0) == 64
ASSERT CLZ(1) == 63
ASSERT NLZ(1) == 63
ASSERT CLZ(0) == 64
ASSERT CTZ(1) == 0

# FFS / FINDLS — 1-based lowest set bit
ASSERT FFS(0) == 0
ASSERT FFS(1) == 1
ASSERT FFS(8) == 4
ASSERT FINDLS(0x10) == 5
ASSERT FFS(6) == 2

# FLS / MSB / FINDMSB — 1-based highest set bit
ASSERT FLS(0) == 0
ASSERT FLS(1) == 1
ASSERT FLS(8) == 4
ASSERT MSB(0x80) == 8
ASSERT FINDMSB(0x0F) == 4
ASSERT FLS(BSET(0, 10)) == 11

# CLO / CTO
ASSERT CLO(0) == 0
ASSERT CLO(-1) == 64
ASSERT CLO(BSET(0, 63)) == 1
ASSERT CTO(0) == 0
ASSERT CTO(7) == 3
ASSERT CTO(-1) == 64
ASSERT CTO(0x0E) == 0

# BWIDTH / BITWIDTH
ASSERT BWIDTH(0) == 0
ASSERT BWIDTH(1) == 1
ASSERT BWIDTH(8) == 4
ASSERT BITWIDTH(255) == 8
ASSERT BWIDTH(0x100) == 9
ASSERT BWIDTH(-1) == 64

# relations: FFS = CTZ+1 when nonzero; BWIDTH = 64-CLZ
ASSERT FFS(12) == CTZ(12) + 1
ASSERT BWIDTH(12) == 64 - CLZ(12)
ASSERT FLS(12) == BWIDTH(12)

# stack SPOPCNT SFFS SFLS SCLO SCTO SBWIDTH
CLEARSTACK
PUSH 7
SPOPCNT
ASSERT LAST_N == 3
CLEARSTACK
PUSH 8
SFFS
ASSERT LAST_N == 4
CLEARSTACK
PUSH 0x80
SFLS
ASSERT LAST_N == 8
CLEARSTACK
PUSH 0
SMSB
ASSERT LAST_N == 0
CLEARSTACK
PUSH 7
SCTO
ASSERT LAST_N == 3
CLEARSTACK
PUSH -1
SCLO
ASSERT LAST_N == 64
CLEARSTACK
PUSH 255
SBWIDTH
ASSERT LAST_N == 8
CLEARSTACK
PUSH 0
SBITWIDTH
ASSERT LAST_N == 0
CLEARSTACK
PUSH 8
SNTZ
ASSERT LAST_N == 3
CLEARSTACK
PUSH 1
SNLZ
ASSERT LAST_N == 63

# underflow
CLEARSTACK
SFFS
ASSERT OK == 0
CLEARSTACK
SBWIDTH
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof63_popcount_clz_ctz" LAST_N SP
