# Proof 35 — stack bitwise ALU digit-3: SAND SOR SXOR SNOT SSHL SSHR
HOLD_FLASH 1
SCIENCE LOAD

# SAND
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
SAND
ASSERT SP == 1
PEEK
ASSERT LAST_N == 0

CLEARSTACK
PUSH 0xCC
PUSH 0xAA
SAND
ASSERT LAST_N == 136
# 0xCC=204 0xAA=170 → 136=0x88

# SOR
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
SOR
ASSERT LAST_N == 255

# SXOR
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
SXOR
ASSERT LAST_N == 240

CLEARSTACK
PUSH 7
PUSH 3
SXOR
ASSERT LAST_N == 4

# SNOT (two's complement invert)
CLEARSTACK
PUSH 0
SNOT
ASSERT LAST_N == -1
SNOT
ASSERT LAST_N == 0

CLEARSTACK
PUSH 1
SNOT
ASSERT LAST_N == -2

# SSHL
CLEARSTACK
PUSH 3
PUSH 2
SSHL
ASSERT LAST_N == 12

CLEARSTACK
PUSH 1
PUSH 8
SSHL
ASSERT LAST_N == 256

# SSHR
CLEARSTACK
PUSH 256
PUSH 8
SSHR
ASSERT LAST_N == 1

CLEARSTACK
PUSH 12
PUSH 2
SSHR
ASSERT LAST_N == 3

# empty / under-depth guards
CLEARSTACK
SAND
ASSERT OK == 0
SOR
ASSERT OK == 0
SXOR
ASSERT OK == 0
SNOT
ASSERT OK == 0
SSHL
ASSERT OK == 0
SSHR
ASSERT OK == 0

# compose with combinators + arithmetic
CLEARSTACK
PUSH 0x0F
PUSH 0xF0
SOR
# 255
PUSH 1
SSHL
# 510
PUSH 0xFF
SAND
ASSERT LAST_N == 254
ASSERT SP == 1

# STACK aliases
CLEARSTACK
PUSH 5
PUSH 3
STACKAND
ASSERT LAST_N == 1
PUSH 2
STACKOR
ASSERT LAST_N == 3
PUSH 1
STACKXOR
ASSERT LAST_N == 2
STACKNOT
ASSERT LAST_N == -3

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof35_stack_bitops" LAST_N SP
