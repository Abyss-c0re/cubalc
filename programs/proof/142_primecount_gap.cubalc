# Proof 142 — digit-2 prime metrics: PRIMECOUNT PRIMEGAP ISCOMPOSITE + stack
HOLD_FLASH 1
SCIENCE LOAD

# PRIMECOUNT / π(n)
ASSERT PRIMECOUNT(1) == 0
ASSERT PRIMECOUNT(2) == 1
ASSERT PRIMEPI(10) == 4
ASSERT PIN(20) == 8
ASSERT COUNTPRIMES(30) == 10
ASSERT PRIMECOUNT(100) == 25

# PRIMEGAP — distance to next prime
ASSERT PRIMEGAP(1) == 1
ASSERT PRIMEGAP(2) == 1
ASSERT PGAP(3) == 2
ASSERT PRIMEGAP(7) == 4
ASSERT NEXTGAP(8) == 3
ASSERT PRIMEGAP(113) == 14

# ISCOMPOSITE
ASSERT ISCOMPOSITE(1) == 0
ASSERT ISCOMPOSITE(2) == 0
ASSERT ISCOMPOSITE(3) == 0
ASSERT COMPOSITEP(4) == 1
ASSERT ISCOMPOSITE(9) == 1
ASSERT COMPP(7) == 0
ASSERT ISCOMPOSITE(15) == 1
ASSERT ISCOMPOSITE(17) == 0

# stack SPRIMECOUNT
CLEARSTACK
PUSH 10
SPRIMECOUNT
ASSERT LAST_N == 4
PUSH 100
SPRIMEPI
ASSERT LAST_N == 25

# stack SPRIMEGAP
CLEARSTACK
PUSH 7
SPRIMEGAP
ASSERT LAST_N == 4
PUSH 2
SPGAP
ASSERT LAST_N == 1

# stack SISCOMPOSITE
CLEARSTACK
PUSH 9
SISCOMPOSITE
ASSERT LAST_N == 1
PUSH 11
SCOMPOSITEP
ASSERT LAST_N == 0
PUSH 4
SCOMPP
ASSERT LAST_N == 1

# soft fails
CLEARSTACK
SPRIMECOUNT
ASSERT OK == 0
SPRIMEGAP
ASSERT OK == 0
SISCOMPOSITE
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof142_primecount_gap" LAST_N SP
