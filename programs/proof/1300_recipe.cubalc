# RECIPE / LIBCARD / CARD — in-lang dual of cubalc recipe

RECIPE fat_session
ASSERT OK == 1
ASSERT LIB_STEM == "fat_session"
ASSERT LIB_PATH != ""
ASSERT LIB_BYTES > 50
ASSERT LIB_LINES >= 5
ASSERT LIB_DEPS_N == 2
ASSERT RECIPE_DEPS_N == 2
ASSERT RECIPE_DEFAULTS_N == 1
ASSERT RECIPE_HEAD_N >= 3
ASSERT LAST_N == 2
SYS HAS LAST "cubalc.recipe.v1"
ASSERT LAST_N == 1
SYS HAS LAST "fat_session"
ASSERT LAST_N == 1
SYS HAS LAST "deps_n"
ASSERT LAST_N == 1
SYS HAS LAST "defaults"
ASSERT LAST_N == 1
SYS HAS LAST "head"
ASSERT LAST_N == 1
SYS HASLINE RECIPE_DEPS "fat_boot"
ASSERT LAST_N == 1
SYS HASLINE RECIPE_DEPS "plate_boot"
ASSERT LAST_N == 1
SYS HAS RECIPE_DEFAULTS "NEED_VARROOM=48"
ASSERT LAST_N == 1
SYS HAS RECIPE_HEAD "INCLUDE fat_session"
ASSERT LAST_N == 1

# alias LIBCARD
LIBCARD plate_tick
ASSERT OK == 1
ASSERT LIB_STEM == "plate_tick"
ASSERT RECIPE_DEFAULTS_N == 4
ASSERT LIB_DEPS_N == 0
SYS HAS LAST "PLATE_PATH="
ASSERT LAST_N == 1

# short CARD
CARD agent_boot
ASSERT OK == 1
ASSERT LIB_STEM == "agent_boot"
ASSERT RECIPE_DEPS_N == 0
ASSERT RECIPE_DEFAULTS_N == 0

# soft miss
RECIPE no_such_lib_xyz_zzz
ASSERT OK == 0
ASSERT LAST_N == 0
CLEAR_ERR

PASS
PRINT "1300_recipe: PASS"
