# Proof 375 — digit-5 bitfield imm TOC: SSETBTOCN SCLRBTOCN SFLPBTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSETBTOCN: set bit 3 on 0 → 8
CELLSET 1 0
PUSH 1
SSETBTOCN 3
ASSERT LAST_N == 8
ASSERT CELL(1) == 8
POP a
ASSERT a == 8

# SSETBTOCN on existing: 8 | (1<<0) = 9
CELLSET 2 8
PUSH 2
SETBTOCN 0
ASSERT LAST_N == 9
ASSERT CELL(2) == 9
POP

# SCLRBTOCN: clear bit 3 from 15 → 7
CELLSET 3 15
PUSH 3
SCLRBTOCN 3
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# SCLRBTOCN no-op clear missing bit: 1 clear bit 1 → 1
CELLSET 4 1
PUSH 4
CLRBTOCN 1
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# SFLPBTOCN: flip bit 1 on 0 → 2; reindex flip → 0
CELLSET 5 0
PUSH 5
SFLPBTOCN 1
ASSERT LAST_N == 2
ASSERT CELL(5) == 2
POP
PUSH 5
SFLPBTOCN 1
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SFLPBTOCN alias FLPBTOCN: 5 (101b) flip bit 0 → 4
CELLSET 6 5
PUSH 6
FLPBTOCN 0
ASSERT LAST_N == 4
ASSERT CELL(6) == 4
POP

# clamp n>63 → bit 63 set (nonzero)
CELLSET 7 0
PUSH 7
SSETBTOCN 100
ASSERT CELL(7) != 0
POP

# soft empty OK=0
CLEARSTACK
SSETBTOCN 1
ASSERT OK == 0

PRINT "375_ssetbtocn_sflpbtocn OK"
