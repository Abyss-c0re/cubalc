# INCLUDE arg_boot — agent_boot + arg_guard program-arg contract

HOLD_FLASH 1

# empty contract (skip gates)
DEFAULT NEED_ARGS = ""
DEFAULT NEED_ARG_ANY = ""
INCLUDE arg_boot
ASSERT OK == 1
ASSERT ARG_GUARD_OK == 1
HASINCLUDE agent_boot
ASSERT LAST_N == 1
HASINCLUDE arg_guard
ASSERT LAST_N == 1
HASINCLUDE arg_boot
ASSERT LAST_N == 1
VERSION
ASSERT LAST != ""

# ALL gate pass via env CUBALC_ARGn
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARG1 "b.txt"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_ARGS = "0\n1"
LET NEED_ARG_ANY = ""
LET ARG_GUARD_SOFT = 0
INCLUDE arg_boot
ASSERT ARG_GUARD_ALL_OK == 1
ASSERT ARG_GUARD_OK == 1

# soft ANY miss then hit
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_AB_X
SYS ENV UNSET CUBALC_AB_Y
LET NEED_ARGS = ""
LET NEED_ARG_ANY = "CUBALC_AB_X\nCUBALC_AB_Y"
LET ARG_GUARD_SOFT = 1
INCLUDE arg_boot
ASSERT ARG_GUARD_ANY_OK == 0
ASSERT ARG_GUARD_OK == 0

SYS ENV SET CUBALC_AB_X "1"
LET NEED_ARG_ANY = "CUBALC_AB_X\nCUBALC_AB_Y"
LET ARG_GUARD_SOFT = 1
INCLUDE arg_boot
ASSERT ARG_GUARD_ANY_OK == 1
ASSERT ARG_GUARD_OK == 1

SYS ENV UNSET CUBALC_AB_X
SYS ENV UNSET CUBALC_AB_Y
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1

PASS
PRINT "1389_arg_boot: PASS"
