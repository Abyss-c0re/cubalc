# Proof 515 — digit-9 stack imm 32-bit field abs+extend: SABS32N SSEXT32N SZEXT32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SABS32N: 0xFFFFFFFE (-2)→2 ; 0x00000005→5
PUSH 0xFFFFFFFE
SABS32N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x00000005
ABS32N 0
POP x
ASSERT x == 5

# min int32 -2147483648 stays 0x80000000
CLEARSTACK
PUSH 0x80000000
SABS32N 0
POP x
ASSERT x == 2147483648

# high preserved abs: low word FFFFFFFE → 2
CLEARSTACK
PUSH 0x11223344FFFFFFFE
SABS32N 0
POP x
ASSERT x == 0x1122334400000002

# STACKABS32N n1: high of 0xFFFFFFFE00000001 is FFFFFFFE=-2 → abs 2
CLEARSTACK
PUSH 0xFFFFFFFE00000001
STACKABS32N 1
POP x
ASSERT x == 0x0000000200000001

# SSEXT32N: 0x7FFFFFFF→2147483647 ; 0xFFFFFFFE→-2 ; 0x80000000→-2147483648
CLEARSTACK
PUSH 0x7FFFFFFF
SSEXT32N 0
POP x
ASSERT x == 2147483647

CLEARSTACK
PUSH 0xFFFFFFFE
SSEXT32N 0
POP x
ASSERT x == -2

CLEARSTACK
PUSH 0x80000000
SEXT32N 0
POP x
ASSERT x == -2147483648

# STACKSEXT32N n1: 0xA000000100000001 high=A0000001=-1610612735
CLEARSTACK
PUSH 0xA000000100000001
STACKSEXT32N 1
POP x
ASSERT x == -1610612735

# high ignored for n0: 0x1FFFFFFFF → -1
CLEARSTACK
PUSH 0x1FFFFFFFF
SSEXT32N 0
POP x
ASSERT x == -1

# SZEXT32N: extract word
CLEARSTACK
PUSH 0xABCD123456789ABC
SZEXT32N 0
POP x
ASSERT x == 0x56789ABC

CLEARSTACK
PUSH 0xABCD123456789ABC
STACKZEXT32N 1
POP x
ASSERT x == 0xABCD1234

# ZEXT32N n1 of 0x1122334455667788 → 0x11223344
CLEARSTACK
PUSH 0x1122334455667788
ZEXT32N 1
POP x
ASSERT x == 0x11223344

# aliases
CLEARSTACK
PUSH 0xFFFFFFFC
SIABS32N 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0xFFFFFFFC
SDWSEXTN 0
POP x
ASSERT x == -4

CLEARSTACK
PUSH 0xFFFFFFFF00000000
SDWZEXTN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x00000000FFFFFFFF
SDWZEXTN 0
POP x
ASSERT x == 4294967295

# SABSDWN n1: 0x8000000000000000 high=min stays 80000000
CLEARSTACK
PUSH 0x8000000000000000
SABSDWN 1
POP x
ASSERT x == 0x8000000000000000

HOLD_FLASH 0
