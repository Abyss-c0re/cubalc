# Proof 144 — digit-1 dual-stack pair compare: DEQ DNE DLT DLE DGT DGE
HOLD_FLASH 1
SCIENCE LOAD

# DEQ — a b c d → (a==c) (b==d)
CLEARSTACK
PUSH 5
PUSH 7
PUSH 5
PUSH 9
DEQ
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DNE
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 2
DNE
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DLT
CLEARSTACK
PUSH 3
PUSH 10
PUSH 5
PUSH 8
DLT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DLE
CLEARSTACK
PUSH 4
PUSH 8
PUSH 4
PUSH 9
DLE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DGT
CLEARSTACK
PUSH 9
PUSH 2
PUSH 3
PUSH 2
DGT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DGE
CLEARSTACK
PUSH 5
PUSH 7
PUSH 5
PUSH 6
DGE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 2EQ / PAIRLT aliases
CLEARSTACK
PUSH 0
PUSH 1
PUSH 0
PUSH 1
2EQ
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 1
PUSH 4
PUSH 2
PUSH 3
PAIRLT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fails
CLEARSTACK
DEQ
ASSERT OK == 0
DLT
ASSERT OK == 0
DGE
ASSERT OK == 0
PUSH 1
PUSH 2
PUSH 3
DNE
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof144_deq_dlt" LAST_N SP
