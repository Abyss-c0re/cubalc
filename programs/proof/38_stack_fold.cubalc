# Proof 38 — stack fold/reduce digit-6: SSUM SPROD SFAND SFOR SFXOR FOLDMIN FOLDMAX
HOLD_FLASH 1
SCIENCE LOAD

# SSUM whole stack
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
SSUM
ASSERT SP == 1
ASSERT LAST_N == 10

# SSUM n (top 2 only); leftover under remains
CLEARSTACK
PUSH 100
PUSH 1
PUSH 2
SSUM 2
ASSERT SP == 2
ASSERT LAST_N == 3
DROP
PEEK
ASSERT LAST_N == 100

# SPROD
CLEARSTACK
PUSH 2
PUSH 3
PUSH 4
SPROD
ASSERT LAST_N == 24

# SFAND / SFOR / SFXOR
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0xFF
SFAND
ASSERT LAST_N == 0

CLEARSTACK
PUSH 0xF0
PUSH 0x0F
SFOR
ASSERT LAST_N == 255

CLEARSTACK
PUSH 7
PUSH 3
PUSH 1
SFXOR
ASSERT LAST_N == 5

# FOLDMIN / FOLDMAX
CLEARSTACK
PUSH 9
PUSH 2
PUSH 7
PUSH 4
FOLDMIN
ASSERT LAST_N == 2
CLEARSTACK
PUSH 9
PUSH 2
PUSH 7
PUSH 4
FOLDMAX
ASSERT LAST_N == 9

# aliases
CLEARSTACK
PUSH 5
PUSH 5
PUSH 5
STACKSUM
ASSERT LAST_N == 15
CLEARSTACK
PUSH 2
PUSH 5
SFOLDMUL
ASSERT LAST_N == 10

# empty identities
CLEARSTACK
SSUM
ASSERT OK == 1
ASSERT LAST_N == 0
CLEARSTACK
SPROD
ASSERT OK == 1
ASSERT LAST_N == 1
CLEARSTACK
SFAND
ASSERT OK == 1
ASSERT LAST_N == -1
CLEARSTACK
FOLDMIN
ASSERT OK == 0

# under-depth with explicit n
CLEARSTACK
PUSH 1
SSUM 3
ASSERT OK == 0

# compose with peer SSEL: if (1+2+3)<10 then 42 else 0
CLEARSTACK
PUSH 0
PUSH 42
PUSH 1
PUSH 2
PUSH 3
SSUM 3
PUSH 10
SLT
SSEL
ASSERT LAST_N == 42

# FOLDOR / FOLDAND
CLEARSTACK
PUSH 1
PUSH 2
PUSH 4
FOLDOR
ASSERT LAST_N == 7
CLEARSTACK
PUSH 15
PUSH 7
FOLDAND
ASSERT LAST_N == 7

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof38_stack_fold" LAST_N SP
