# Proof 491 — digit-0 dual-stack imm 8-bit field shift: DSHL8N DSHR8N DSAR8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DSHL8N: 1<<2=4 both
PUSH 0x1
PUSH 0x1
DSHL8N 2 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# overflow: 0x80 << 1 → 0; preserve high
CLEARSTACK
PUSH 0x1122334455667780
PUSH 0x99AABBCCDDEEFF40
PAIRSHL8N 1 0
POP y
POP x
ASSERT x == 0x1122334455667700
ASSERT y == 0x99AABBCCDDEEFF80

# k>=8 → 0
CLEARSTACK
PUSH 0xFF
PUSH 0xAB
DSHL8N 8 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# S2SHL8N n1: byte1 of 0x..0301 is 03 <<1 → 06 → 0x..0601
CLEARSTACK
PUSH 0x0301
PUSH 0x0200
S2SHL8N 1 1
POP y
POP x
ASSERT x == 0x0601
ASSERT y == 0x0400

# DSHR8N logical: 0x80>>1=0x40 ; 0xFF>>2=0x3F
CLEARSTACK
PUSH 0x80
PUSH 0xFF
DSHR8N 1 0
POP y
POP x
ASSERT x == 64
ASSERT y == 127

# high preserved shr
CLEARSTACK
PUSH 0x11223344556677FC
PUSH 0x99AABBCCDDEEFF0C
PAIRSHR8N 2 0
POP y
POP x
ASSERT x == 0x112233445566773F
ASSERT y == 0x99AABBCCDDEEFF03

# STACK2SHR8N n1: 0x..8000 byte1=80>>1=40 → 0x..4000
CLEARSTACK
PUSH 0x8000
PUSH 0xA000
STACK2SHR8N 1 1
POP y
POP x
ASSERT x == 0x4000
ASSERT y == 0x5000

# DSAR8N: 0xFE (-2)>>1 → 0xFF ; 0x80 (-128)>>1 → 0xC0
CLEARSTACK
PUSH 0xFE
PUSH 0x80
DSAR8N 1 0
POP y
POP x
ASSERT x == 255
ASSERT y == 192

# k>=8 all sign: neg → FF, pos → 0
CLEARSTACK
PUSH 0x80
PUSH 0x7F
PAIRSAR8N 8 0
POP y
POP x
ASSERT x == 255
ASSERT y == 0

# positive SAR: 0x06>>1=3 ; 0x04>>1=2
CLEARSTACK
PUSH 0x06
PUSH 0x04
DSAR8N 1 0
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# high preserved SAR byte1: 0x..FE00 byte1=FE → FF
CLEARSTACK
PUSH 0x112233445566FE00
PUSH 0x99AABBCCDDEE8000
S2SAR8N 1 1
POP y
POP x
ASSERT x == 0x112233445566FF00
ASSERT y == 0x99AABBCCDDEEC000

# DLSH8N / DASHR8N aliases
CLEARSTACK
PUSH 0x03
PUSH 0x03
DLSH8N 1 0
POP y
POP x
ASSERT x == 6
ASSERT y == 6

CLEARSTACK
PUSH 0xFE
PUSH 0xFE
DASHR8N 1 0
POP y
POP x
ASSERT x == 255
ASSERT y == 255

HOLD_FLASH 0
