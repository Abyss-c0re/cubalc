# HASARG / HASARGC — soft CLI arg probes (REQUIRE ARG twin)
# Agents branch without fatal REQUIRE

HOLD_FLASH 1

# empty
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
HASARG 0
ASSERT LAST_N == 0
HASARGC 1
ASSERT LAST_N == 0
HASARGC
ASSERT LAST_N == 0

# seeded
SYS ENV SET CUBALC_ARG0 "peer"
SYS ENV SET CUBALC_ARG1 "job"
SYS ENV SET CUBALC_ARGC "2"
HASARG 0
ASSERT LAST_N == 1
HASARG 1
ASSERT LAST_N == 1
HASARG 2
ASSERT LAST_N == 0
HASARGC 1
ASSERT LAST_N == 1
HASARGC 2
ASSERT LAST_N == 1
HASARGC 3
ASSERT LAST_N == 0
ASSERT ARGC == 2

# branch pattern
HASARG 0
IF LAST_N == 1
  LET mode "cli"
ELSE
  LET mode "default"
END
SYS EQS mode "cli"
ASSERT LAST_N == 1

# REQUIRE still hard
REQUIRE ARG 0
SYS EQS LAST "peer"
ASSERT LAST_N == 1

PRINT "hasarg ok"
