# INCLUDE oop_boot - agent_boot + oop_session one-shot

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
END

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_METHODS = ""
DEFAULT NEED_FIELDS = ""
DEFAULT CLASS_GUARD_SOFT = 0
DEFAULT METHOD_GUARD_SOFT = 0
DEFAULT FIELD_GUARD_SOFT = 0
INCLUDE oop_boot
ASSERT OK == 1
ASSERT OOP_SESSION_OK == 1
HASINCLUDE agent_boot
ASSERT LAST_N == 1
HASINCLUDE oop_session
ASSERT LAST_N == 1
HASINCLUDE oop_boot
ASSERT LAST_N == 1
HASLIB oop_boot
ASSERT LAST_N == 1
VERSION
ASSERT LAST != ""

LET NEED_CLASSES = "nosuch_oop_boot_miss"
LET CLASS_GUARD_SOFT = 1
INCLUDE oop_boot
ASSERT OOP_SESSION_OK == 0
CLEAR_ERR

LET NEED_CLASSES = "Ticket"
LET NEED_METHODS = "Ticket.ping"
LET NEED_FIELDS = "Ticket.id"
LET CLASS_GUARD_SOFT = 0
LET METHOD_GUARD_SOFT = 0
LET FIELD_GUARD_SOFT = 0
INCLUDE oop_boot
ASSERT OOP_SESSION_OK == 1

PRINT "1404_oop_boot: PASS"
PASS
