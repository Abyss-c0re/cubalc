# NTHPOS / POSN — peel 0-based non-flag positional without RESTARGS+NTH

HOLD_FLASH 1

# empty + fallback
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
NTHPOS 0 OR "stdin"
ASSERT LAST_N == 0
SYS EQS LAST "stdin"
ASSERT LAST_N == 1
NTHPOS 0
ASSERT LAST_N == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# flags + two files
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARG2 "b.txt"
SYS ENV SET CUBALC_ARGC "3"
NTHPOS 0
ASSERT LAST_N == 1
SYS EQS LAST "a.txt"
ASSERT LAST_N == 1
NTHPOS 1
SYS EQS LAST "b.txt"
ASSERT LAST_N == 1
NTHPOS 2 OR "none"
ASSERT LAST_N == 0
SYS EQS LAST "none"
ASSERT LAST_N == 1
ASSERT RESTARGS_N == 2

# POSN alias
POSN 0
SYS EQS LAST "a.txt"
ASSERT LAST_N == 1

# pure positionals (no flags)
SYS ENV SET CUBALC_ARG0 "only.bin"
SYS ENV SET CUBALC_ARGC "1"
NTHPOS 0
SYS EQS LAST "only.bin"
ASSERT LAST_N == 1

PRINT "nthpos ok"
