# Proof 46 — stack combinatorics + add/sub mod digit-2/7: SBINOM SPERM SADDMOD SSUBMOD
HOLD_FLASH 1
SCIENCE LOAD

# SBINOM C(10,3)=120
CLEARSTACK
PUSH 10
PUSH 3
SBINOM
ASSERT LAST_N == 120

# SCHOOSE C(5,2)=10
CLEARSTACK
PUSH 5
PUSH 2
SCHOOSE
ASSERT LAST_N == 10

# edge invalid
CLEARSTACK
PUSH 3
PUSH 5
SBINOM
ASSERT LAST_N == 0

# SPERM P(5,2)=20
CLEARSTACK
PUSH 5
PUSH 2
SPERM
ASSERT LAST_N == 20
CLEARSTACK
PUSH 5
PUSH 0
SPNR
ASSERT LAST_N == 1

# SADDMOD 7+8 mod 10 = 5
CLEARSTACK
PUSH 7
PUSH 8
PUSH 10
SADDMOD
ASSERT LAST_N == 5

# SSUBMOD 3-8 mod 10 = 5
CLEARSTACK
PUSH 3
PUSH 8
PUSH 10
SSUBMOD
ASSERT LAST_N == 5

# negative normalize
CLEARSTACK
PUSH -1
PUSH 2
PUSH 7
SADDMOD
ASSERT LAST_N == 1

# underflow
CLEARSTACK
SBINOM
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
SADDMOD
ASSERT OK == 0

# compose: binom then mod add
CLEARSTACK
PUSH 6
PUSH 2
SBINOM
# 15
PUSH 10
PUSH 100
SADDMOD
ASSERT LAST_N == 25

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof46_stack_combin" LAST_N SP
