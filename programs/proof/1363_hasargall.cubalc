# HASARGALL / NEEDARGS — multi program-arg presence gate (HASFLAGALL twin for CUBALC_ARGn)

HOLD_FLASH 1

# clear args
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV UNSET CUBALC_CONFIG
SYS ENV SET CUBALC_ARGC "0"

# empty names soft → 0
HASARGALL
ASSERT LAST_N == 0
ASSERT ARGMISS_N == 0

# missing indices
HASARGALL 0 1 2
ASSERT LAST_N == 0
ASSERT ARGMISS_N == 3
SYS HASLINE ARGMISS "0"
ASSERT LAST_N == 1
SYS HASLINE ARGMISS "2"
ASSERT LAST_N == 1
ASSERT HASARGALL_N == 0
ASSERT NEEDARGS_N == 3

# partial
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARGC "1"
HASARGALL 0 1
ASSERT LAST_N == 0
ASSERT ARGMISS_N == 1
SYS HASLINE ARGMISS "1"
ASSERT LAST_N == 1
SYS HASLINE ARGHAVE "0"
ASSERT LAST_N == 1
ASSERT HASARGALL_N == 1

# all present by index
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARG1 "b.txt"
SYS ENV SET CUBALC_ARG2 "c.txt"
SYS ENV SET CUBALC_ARGC "3"
HASARGALL 0 1 2
ASSERT LAST_N == 1
ASSERT ARGMISS_N == 0
ASSERT HASARGALL_N == 3
ASSERT OK == 1

# string digits + bag/CSV
HASARGALL "0,1,2"
ASSERT LAST_N == 1

# named env (non-CUBALC_ARG)
SYS ENV SET CUBALC_CONFIG "cfg.json"
HASARGALL 0 CUBALC_CONFIG
ASSERT LAST_N == 1
HASARGALL MISSING_ENV_XYZ
ASSERT LAST_N == 0
SYS HASLINE ARGMISS "MISSING_ENV_XYZ"
ASSERT LAST_N == 1

# hard twin passes when present
NEEDARGS 0 1
ASSERT LAST_N == 1
ASSERT OK == 1

# soft miss sticky ERR
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
HASARGALL 0 1
ASSERT LAST_N == 0
ASSERT OK == 0
SYS HASI "HASARGALL miss"
ASSERT LAST_N == 1

# IF without N× HASARG
SYS ENV SET CUBALC_ARG0 "x"
SYS ENV SET CUBALC_ARG1 "y"
SYS ENV SET CUBALC_ARGC "2"
HASARGALL 0 1
IF LAST_N == 1
  LET gate "ok"
ELSE
  LET gate "no"
END
SYS EQS gate "ok"
ASSERT LAST_N == 1

# discoverable
HASFORM HASARGALL
ASSERT LAST_N == 1
HASFORM NEEDARGS
ASSERT LAST_N == 1

PRINT "hasargall ok"
PASS
