# IFTHIRTYONEP - plate exactly-thirty-one key diagnostic branch
# Continues ladder after IFTHIRTYP. Soft twin HENTRIACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET thirty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30}"
LET thirtyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31}"
LET thirtytwo = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32}"
LET empty = "{}"

IFTHIRTYONEP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFTHIRTYONEP_N == 1
ASSERT THIRTYONEP_N == 1
ASSERT IFTHIRTYONEP_LEN == 31
ASSERT IFHENTRIACONTAP_N == 1
ASSERT IFTHIRTYONEKEYP_N == 1

IFHENTRIACONTAP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTHIRTYONEKEYP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTHIRTYONEP thirty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTHIRTYONEP_N == 0
ASSERT IFTHIRTYONEP_LEN == 30

IFTHIRTYONEP thirtytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTHIRTYONEP_LEN == 32

IFTHIRTYONEP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFTHIRTYONEP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENTHIRTYONEP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENHENTRIACONTAP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTHIRTYONEKEYP thirtyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "ifthirtyonep_ok" IFTHIRTYONEP_N IFTHIRTYONEP_LEN
PASS
