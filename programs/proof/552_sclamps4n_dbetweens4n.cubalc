# Proof 552 — digit-1 stack+dual imm 4-bit signed clamp+between: SCLAMPS4N SBETWEENS4N DCLAMPS4N DBETWEENS4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLAMPS4N: clamp -5=0xB into [-1, 3] → -1=0xF
PUSH 0xB
SCLAMPS4N 0xF 0x3 0
POP x
ASSERT x == 0xF

# clamp 5 into [-1, 3] → 3
CLEARSTACK
PUSH 0x5
CLAMPS4N 0xF 0x3 0
POP x
ASSERT x == 3

# in range stays
CLEARSTACK
PUSH 0x1
SCLAMPSIGN4N 0xF 0x3 0
POP x
ASSERT x == 1

# swap lo/hi
CLEARSTACK
PUSH 0x0
SCLAMPS4N 0x3 0xF 0
POP x
ASSERT x == 0

# INT4_MIN(0x8=-8) clamp to [0, 5] → 0
CLEARSTACK
PUSH 0x8
SCLAMPS4N 0x0 0x5 0
POP x
ASSERT x == 0

# high nibble preserved: low F clamp [0,5] → 0 low
CLEARSTACK
PUSH 0x1F
SCLAMPS4N 0x0 0x5 0
POP x
ASSERT x == 0x10

# STACKCLAMPS4N n1: high E (-2) clamp [-1,1] → F
CLEARSTACK
PUSH 0xE0
STACKCLAMPS4N 0xF 0x1 1
POP x
ASSERT x == 0xF0

# SBETWEENS4N: -1 in [-2, 0] → 1
CLEARSTACK
PUSH 0xF
SBETWEENS4N 0xE 0x0 0
POP x
ASSERT x == 1

# 5 not in [-1, 3]
CLEARSTACK
PUSH 0x5
BETWEENS4N 0xF 0x3 0
POP x
ASSERT x == 0

# INT4_MIN not in [0, 5]
CLEARSTACK
PUSH 0x8
SINRANGES4N 0x0 0x5 0
POP x
ASSERT x == 0

# 0xF signed -1 in [-5, 5]
CLEARSTACK
PUSH 0xF
SBETWEENS4N 0xB 0x5 0
POP x
ASSERT x == 1

# high preserved between
CLEARSTACK
PUSH 0xA2
SBETWEENS4N 0x0 0x3 0
POP x
ASSERT x == 0xA1

# STACKBETWEENS4N n1
CLEARSTACK
PUSH 0xF0
STACKBETWEENS4N 0xE 0x0 1
POP x
ASSERT x == 0x10

# DCLAMPS4N
CLEARSTACK
PUSH 0xB
PUSH 0x5
DCLAMPS4N 0xF 0x3 0
POP y
POP x
ASSERT x == 0xF
ASSERT y == 3

# both in range
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRCLAMPS4N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# high preserve dual
CLEARSTACK
PUSH 0x1F
PUSH 0x25
S2CLAMPS4N 0x0 0x5 0
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x25

# STACK2CLAMPS4N n1
CLEARSTACK
PUSH 0xE0
PUSH 0x50
STACK2CLAMPS4N 0xF 0x1 1
POP y
POP x
ASSERT x == 0xF0
ASSERT y == 0x10

# DBETWEENS4N
CLEARSTACK
PUSH 0xF
PUSH 0x5
DBETWEENS4N 0xE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# both in
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRBETWEENS4N 0x0 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DINRANGESIGN4N
CLEARSTACK
PUSH 0x8
PUSH 0xF
DINRANGESIGN4N 0xE 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK2BETWEENS4N n1
CLEARSTACK
PUSH 0xF0
PUSH 0x50
STACK2BETWEENS4N 0xE 0x0 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x00

HOLD_FLASH 0
