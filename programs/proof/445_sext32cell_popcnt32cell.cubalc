# Proof 445 — digit-4 cell fixed-width 32 signed/metrics: SEXT32CELL ABS32CELL POPCNT32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SEXT32CELL: 0xFFFFFFFF → -1; 0x7FFFFFFF → 2147483647; 0x80000000 → -2147483648
CELLSET 0 4294967295
CELLSET 1 2147483647
CELLSET 2 2147483648
SEXT32CELL 0 2
ASSERT CELL(0) == -1
ASSERT CELL(1) == 2147483647
ASSERT CELL(2) == -2147483648
ASSERT LAST_N == 3

# ABS32CELL: -5 via SEXT of 0xFFFFFFFB; 42 → 42; min int32 stays
CELLSET 3 4294967291
SEXT32CELL 3 3
CELLSET 4 42
CELLSET 5 2147483648
ABS32CELL 3 5
ASSERT CELL(3) == 5
ASSERT CELL(4) == 42
ASSERT CELL(5) == -2147483648
ASSERT LAST_N == 3

# POPCNT32CELL: 0x0F → 4; 0xFFFFFFFF → 32; 0 → 0; 0x80000000 → 1
CELLSET 6 15
CELLSET 7 4294967295
CELLSET 8 0
CELLSET 9 2147483648
POPCNT32CELL 6 9
ASSERT CELL(6) == 4
ASSERT CELL(7) == 32
ASSERT CELL(8) == 0
ASSERT CELL(9) == 1
ASSERT LAST_N == 4

# POPCNT32RANGE single
CELLSET 10 0xA5A5A5A5
POPCNT32RANGE 10 10
ASSERT CELL(10) == 16

# round-trip: SEXT then ABS of -100 (0xFFFFFF9C)
CELLSET 11 4294967196
SEXT32CELL 11 11
ABS32CELL 11 11
ASSERT CELL(11) == 100

# high bits above 32 ignored for SEXT (2^32+1 → 1) and POPCNT (only low32)
CELLSET 12 4294967297
SEXT32CELL 12 12
ASSERT CELL(12) == 1
CELLSET 13 4294967297
POPCNT32CELL 13 13
ASSERT CELL(13) == 1

# SEXT32RANGE alias
CELLSET 14 4294967295
SEXT32RANGE 14 14
ASSERT CELL(14) == -1

HOLD_FLASH 0
