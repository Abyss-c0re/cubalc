# Proof 242 — digit-9 dual-stack high-n bitfield metrics: DPOPHN DANYHN DALLHN
HOLD_FLASH 1
SCIENCE LOAD

# DPOPHN — popcount high n
CLEARSTACK
PUSH -1
PUSH 0
DPOPHN 8
POP y
POP x
ASSERT x == 8
ASSERT y == 0

CLEARSTACK
PUSH 0xFF00000000000000
PUSH 0x0F00000000000000
2POPHN 8
POP y
POP x
ASSERT x == 8
ASSERT y == 4

# DONESHN n=0
CLEARSTACK
PUSH -1
PUSH 7
DONESHN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# n=64 full
CLEARSTACK
PUSH -1
PUSH 0
DPOPHN 64
POP y
POP x
ASSERT x == 64
ASSERT y == 0

# DANYHN
CLEARSTACK
PUSH 0x0080000000000000
PUSH 0
DANYHN 8
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 0x8000000000000000
PUSH 0x0100000000000000
2ANYHN 8
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# PAIRANYHN n=0
CLEARSTACK
PUSH 99
PUSH 1
PAIRANYHN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DALLHN
CLEARSTACK
PUSH -1
PUSH 0xFE00000000000000
DALLHN 8
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFF000000000000
PUSH 0xFFFE000000000000
2ALLHN 16
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# PAIRALLHN n=0 vacuous
CLEARSTACK
PUSH 0
PUSH 0
PAIRALLHN 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# n=64
CLEARSTACK
PUSH -1
PUSH 0
DALLHN 64
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fails
CLEARSTACK
DPOPHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DANYHN 4
ASSERT OK == 0
CLEARSTACK
PUSH 1
DALLHN 4
ASSERT OK == 0

HOLD_FLASH 1
