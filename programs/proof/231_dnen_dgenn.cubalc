# Proof 231 — digit-1 dual-stack imm compare ext: DNEN DLENN DGENN
HOLD_FLASH 1
SCIENCE LOAD

# DNEN
CLEARSTACK
PUSH 5
PUSH 7
DNEN 5
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 3
PUSH 3
2NEN 3
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRNEN / DNEQN
CLEARSTACK
PUSH 0
PUSH 1
PAIRNEN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -1
PUSH 0
DNEQN -1
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DLENN / DLEQN
CLEARSTACK
PUSH 2
PUSH 10
DLENN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 5
PUSH 4
2LENN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 6
PUSH 5
DLEQN 5
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# DGENN / DGEQN
CLEARSTACK
PUSH 9
PUSH 1
DGENN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 5
PUSH 6
2GENN 5
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 4
PUSH 5
DGEQN 5
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# complements: EQ vs NE, GT vs LE
CLEARSTACK
PUSH 7
PUSH 3
DEQN 7
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 7
PUSH 3
DNEN 7
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 7
PUSH 3
DGTN 7
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 7
PUSH 3
DLENN 7
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# soft empty
CLEARSTACK
DNEN 1
ASSERT OK == 0
