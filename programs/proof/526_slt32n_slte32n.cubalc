# Proof 526 — digit-1 stack imm 32-bit field ordered-cmp: SLT32N SGT32N SLTE32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SLT32N: 0x10000000 < 0xC0000000 → 1
PUSH 0x10000000
SLT32N 0xC0000000 0
POP x
ASSERT x == 1

# not less: equal → 0
CLEARSTACK
PUSH 0xC0000000
LT32N 0xC0000000 0
POP x
ASSERT x == 0

# not less: greater → 0
CLEARSTACK
PUSH 0xF0000000
SLT32N 0x20000000 0
POP x
ASSERT x == 0

# high preserved: low 0x10 < 0x20 → low 1
CLEARSTACK
PUSH 0x1122334400000010
SLT32N 0x20 0
POP x
ASSERT x == 0x1122334400000001

# STACKLT32N n1: high 0x10000000 < 0x20000000 → high 1
CLEARSTACK
PUSH 0x1000000000000000
STACKLT32N 0x20000000 1
POP x
ASSERT x == 0x0000000100000000

# SGT32N: 0xF0000000 > 0x20000000 → 1
CLEARSTACK
PUSH 0xF0000000
SGT32N 0x20000000 0
POP x
ASSERT x == 1

# not greater: equal → 0
CLEARSTACK
PUSH 0x55555555
GT32N 0x55555555 0
POP x
ASSERT x == 0

# not greater: less → 0
CLEARSTACK
PUSH 0x10
SGT32N 0x20 0
POP x
ASSERT x == 0

# high preserved gt: low 0x8000 > 0x1000 → low 1
CLEARSTACK
PUSH 0x99AABBCC00008000
SGT32N 0x1000 0
POP x
ASSERT x == 0x99AABBCC00000001

# STACKGT32N n1: high 0x90000000 > 0x10000000 → high 1
CLEARSTACK
PUSH 0x9000000000000000
STACKGT32N 0x10000000 1
POP x
ASSERT x == 0x0000000100000000

# SLTE32N: less → 1
CLEARSTACK
PUSH 0x10000000
SLTE32N 0xC0000000 0
POP x
ASSERT x == 1

# equal → 1
CLEARSTACK
PUSH 0xABCD1234
LTE32N 0xABCD1234 0
POP x
ASSERT x == 1

# greater → 0
CLEARSTACK
PUSH 0xFFFFFFFF
SLEQ32N 0xFFFFFFFE 0
POP x
ASSERT x == 0

# high preserved lte: low 0x7742 <= 0x7742 → low 1
CLEARSTACK
PUSH 0x1122334400007742
SLTE32N 0x7742 0
POP x
ASSERT x == 0x1122334400000001

# STACKLTE32N n1: high 0x55555555 <= 0x55555554 → 0
CLEARSTACK
PUSH 0x5555555500000000
STACKLTE32N 0x55555554 1
POP x
ASSERT x == 0x0000000000000000

# SCMPLT32N / SCMPGT32N / SCMPLE32N aliases
CLEARSTACK
PUSH 1
SCMPLT32N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 3
SCMPGT32N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 2
SCMPLE32N 2 0
POP x
ASSERT x == 1

# unsigned: 0x80000000 > 0x7FFFFFFF → 1
CLEARSTACK
PUSH 0x80000000
SGT32N 0x7FFFFFFF 0
POP x
ASSERT x == 1

HOLD_FLASH 0
