# Proof 348 — digit-4 imm accumulate bound TOC: SDIVTOCN SMODTOCN SMINTOCN SMAXTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SDIVTOCN: 20 / 4 → 5
CELLSET 1 20
PUSH 1
SDIVTOCN 4
ASSERT LAST_N == 5
ASSERT CELL(1) == 5
POP a
ASSERT a == 5

# DIVTOCN by 0 soft → 0
CELLSET 2 9
PUSH 2
DIVTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SMODTOCN: 17 % 5 → 2
CELLSET 3 17
PUSH 3
SMODTOCN 5
ASSERT LAST_N == 2
ASSERT CELL(3) == 2
POP

# MODTOCN by 0 soft → 0
CELLSET 4 11
PUSH 4
MODTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SMODATN exact
CELLSET 5 15
PUSH 5
SMODATN 5
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SMINTOCN: min(10, 3) → 3
CELLSET 6 10
PUSH 6
SMINTOCN 3
ASSERT LAST_N == 3
ASSERT CELL(6) == 3
POP

# MINTOCN already smaller
CELLSET 7 2
PUSH 7
MINTOCN 8
ASSERT LAST_N == 2
ASSERT CELL(7) == 2
POP

# SMAXTOCN: max(4, 9) → 9
CELLSET 8 4
PUSH 8
SMAXTOCN 9
ASSERT LAST_N == 9
ASSERT CELL(8) == 9
POP

# MAXTOCN already larger
CELLSET 9 12
PUSH 9
MAXTOCN 5
ASSERT LAST_N == 12
ASSERT CELL(9) == 12
POP

# SMAXATN equal
CELLSET 10 7
PUSH 10
SMAXATN 7
ASSERT LAST_N == 7
ASSERT CELL(10) == 7
POP

# soft fails empty stack
CLEARSTACK
SDIVTOCN 1
ASSERT OK == 0
SMODTOCN 1
ASSERT OK == 0
SMINTOCN 1
ASSERT OK == 0
SMAXTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof348_sdivtocn_smaxtocn" LAST_N SP
HOLD_FLASH 1
