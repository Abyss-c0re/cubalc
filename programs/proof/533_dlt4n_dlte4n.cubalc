# Proof 533 — digit-1 dual-stack imm 4-bit field ordered-cmp: DLT4N DGT4N DLTE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLT4N: 0x1 < 0xC → 1 ; 0xF < 0xC → 0
PUSH 0x1
PUSH 0xF
DLT4N 0xC 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0xC
PUSH 0xC
PAIRLT4N 0xC 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# other nibbles preserved
CLEARSTACK
PUSH 0xABC0
PUSH 0xDEF3
DLT4N 0x2 0
POP y
POP x
ASSERT x == 0xABC1
ASSERT y == 0xDEF0

# S2LT4N n1
CLEARSTACK
PUSH 0x0010
PUSH 0x0030
S2LT4N 0x2 1
POP y
POP x
ASSERT x == 0x0010
ASSERT y == 0x0000

# n2
CLEARSTACK
PUSH 0x0100
PUSH 0x0500
DLT4N 0x2 2
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

# DGT4N
CLEARSTACK
PUSH 0xF
PUSH 0x1
DGT4N 0x2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0x5
PUSH 0x5
PAIRGT4N 0x5 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved gt
CLEARSTACK
PUSH 0x9A8
PUSH 0x120
DGT4N 0x1 0
POP y
POP x
ASSERT x == 0x9A1
ASSERT y == 0x120

# S2GT4N n1
CLEARSTACK
PUSH 0x0090
PUSH 0x0005
S2GT4N 0x1 1
POP y
POP x
ASSERT x == 0x0010
ASSERT y == 0x0005

# DLTE4N less/eq
CLEARSTACK
PUSH 0x1
PUSH 0xC
DLTE4N 0xC 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0xF
PUSH 0xE
DLEQ4N 0xE 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# preserved lte
CLEARSTACK
PUSH 0x124
PUSH 0x995
DLTE4N 0x4 0
POP y
POP x
ASSERT x == 0x121
ASSERT y == 0x990

# S2LTE4N n1
CLEARSTACK
PUSH 0x0050
PUSH 0x0040
S2LTE4N 0x4 1
POP y
POP x
ASSERT x == 0x0000
ASSERT y == 0x0010

# aliases + unsigned
CLEARSTACK
PUSH 1
PUSH 3
DCMPLT4N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH 1
DCMPGT4N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 2
DCMPLE4N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x8
PUSH 0x7
DGT4N 0x7 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

HOLD_FLASH 0
