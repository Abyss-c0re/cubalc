# Proof 165 — digit-3 dual-stack bit isolate/mask: DBLS DBLC DMASK
HOLD_FLASH 1
SCIENCE LOAD

# DBLS — isolate lowest set bit
CLEARSTACK
PUSH 12
PUSH 10
DBLS
POP y
POP x
ASSERT x == 4
ASSERT y == 2

CLEARSTACK
PUSH 0
PUSH 1
2BLS
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0xF0
PUSH 0xA0
PAIRBLS
POP y
POP x
ASSERT x == 16
ASSERT y == 32

# DBLC — clear lowest set bit
CLEARSTACK
PUSH 12
PUSH 10
DBLC
POP y
POP x
ASSERT x == 8
ASSERT y == 8

CLEARSTACK
PUSH 1
PUSH 0
2BLC
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 15
PUSH 7
PAIRBLC
POP y
POP x
ASSERT x == 14
ASSERT y == 6

# DMASK — width → low-n ones
CLEARSTACK
PUSH 4
PUSH 8
DMASK
POP y
POP x
ASSERT x == 15
ASSERT y == 255

CLEARSTACK
PUSH 0
PUSH 1
2MASK
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 64
PUSH 3
PAIRMASK
POP y
POP x
ASSERT x == -1
ASSERT y == 7

# soft fails
CLEARSTACK
DBLS
ASSERT OK == 0
CLEARSTACK
DBLC
ASSERT OK == 0
CLEARSTACK
DMASK
ASSERT OK == 0
CLEARSTACK
PUSH 1
2BLS
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof165_dbls_dmask" LAST_N SP
