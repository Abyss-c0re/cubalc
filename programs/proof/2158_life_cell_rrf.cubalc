// 2158_life_cell_rrf.cubalc
// Proof 2158: life_cell rrf - post-rf3 ribosome recycling factor RRF·EF-G·GTP 70S split.
// Pay min(n,atp,energy,pcr) -> heat+n energy-n atp-n pcr-n reserve+n; age/pmf/sp/thr held.
// Continuum after rf3. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 40 0
ENTITY poor OF Cell 1 0 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 24 0
ENTITY twin OF Cell 1 30 0
ENTITY ceil OF Cell 1 28 0
ENTITY starved OF Cell 1 36 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND ceil set_threshold 10
SEND starved set_threshold 10
SEND gate pulse 6
SEND gate photosynth 40
SEND gate glycolyse 36
SEND gate pump 28
SEND gate photophos 28
SEND gate photosynth 36
SEND gate glycolyse 30
SEND gate pump 20
SEND gate charge 40
SEND gate feed 40
GETF gate age
ASSERT LAST_N == 6 "af a6"
GETF gate atp
ASSERT LAST_N >= 20 "af atp"
GETF gate pmf
LET pbase = LAST_N
ASSERT pbase >= 5 "af pmf"
SEND gate trim 8
ASSERT LAST_N == 8 "pre trim"
SEND gate cnx 4
ASSERT LAST_N == 4 "pre cnx"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 16
SEND gate uggt 4
ASSERT LAST_N == 4 "pre uggt"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate mann 6
ASSERT LAST_N == 6 "pre mann"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate os9 5
ASSERT LAST_N == 5 "pre os9"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate hrd 4
ASSERT LAST_N == 4 "pre hrd"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate vcp 4
ASSERT LAST_N == 4 "pre vcp"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate psm 4
ASSERT LAST_N == 4 "pre psm"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate pepr 4
ASSERT LAST_N == 4 "pre pepr"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate aars 4
ASSERT LAST_N == 4 "pre aars"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 14
SEND gate eftu 4
ASSERT LAST_N == 4 "pre eftu"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate ptc 4
ASSERT LAST_N == 4 "pre ptc"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 14
SEND gate efg 4
ASSERT LAST_N == 4 "pre efg"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate rf1 4
ASSERT LAST_N == 4 "pre rf1"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 14
SEND gate rf3 4
ASSERT LAST_N == 4 "pre rf3"
SEND gate photosynth 24
SEND gate glycolyse 20
SEND gate charge 30
SEND gate feed 20
SEND gate charge_pcr 16

GETF gate heat
LET h0 = LAST_N
GETF gate energy
LET e0 = LAST_N
GETF gate atp
LET a0 = LAST_N
GETF gate pcr
LET c0 = LAST_N
GETF gate reserve
LET r0 = LAST_N
GETF gate age
LET age0 = LAST_N
GETF gate pmf
LET pmf0 = LAST_N
GETF gate setpoint
LET sp0 = LAST_N
GETF gate threshold
LET thr0 = LAST_N

SEND gate rrf 5
ASSERT LAST_N == 5 "rrf take5"

GETF gate heat
ASSERT LAST_N == h0 + 5 "h+5"
GETF gate energy
ASSERT LAST_N == e0 - 5 "e-5"
GETF gate atp
ASSERT LAST_N == a0 - 5 "a-5"
GETF gate pcr
ASSERT LAST_N == c0 - 5 "c-5"
GETF gate reserve
ASSERT LAST_N == r0 + 5 "r+5"
GETF gate age
ASSERT LAST_N == age0 "age held"
GETF gate pmf
ASSERT LAST_N == pmf0 "pmf held"
GETF gate setpoint
ASSERT LAST_N == sp0 "sp held"
GETF gate threshold
ASSERT LAST_N == thr0 "thr held"
GETF gate alive
ASSERT LAST_N == 1 "alive"
GETF gate ready
ASSERT LAST_N == 1 "ready e>=thr"

SEND gate rrf 0
ASSERT LAST_N == 0 "n0"
SEND gate rrf -3
ASSERT LAST_N == 0 "nneg"

SEND dead rrf 4
ASSERT LAST_N == 0 "dead0"

SEND poor pulse 2
SEND poor rrf 3
ASSERT LAST_N == 0 "poor0"

SEND starved set_threshold 10
SEND starved pulse 4
SEND starved photosynth 30
SEND starved glycolyse 24
SEND starved charge 20
SEND starved feed 16
SEND starved charge_pcr 8
GETF starved atp
LET sa = LAST_N
GETF starved energy
LET se = LAST_N
GETF starved pcr
LET sc = LAST_N
SEND starved rrf 100
LET st = LAST_N
ASSERT st >= 1 "starved take>=1"
ASSERT st <= sa "starved <=atp"
ASSERT st <= se "starved <=e"
ASSERT st <= sc "starved <=pcr"


# twin continuum path rf3->rrf
SEND twin pulse 4
SEND twin photosynth 36
SEND twin glycolyse 30
SEND twin charge 28
SEND twin feed 24
SEND twin charge_pcr 16
SEND twin aars 3
ASSERT LAST_N == 3 "twin aars"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 12
SEND twin eftu 3
ASSERT LAST_N == 3 "twin eftu"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin ptc 3
ASSERT LAST_N == 3 "twin ptc"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 12
SEND twin efg 3
ASSERT LAST_N == 3 "twin efg"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin rf1 3
ASSERT LAST_N == 3 "twin rf1"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 12
SEND twin rf3 3
ASSERT LAST_N == 3 "twin rf3"
SEND twin photosynth 24
SEND twin glycolyse 20
SEND twin charge 30
SEND twin feed 20
SEND twin charge_pcr 14
GETF twin reserve
LET tr0 = LAST_N
GETF twin heat
LET th0 = LAST_N
SEND twin rrf 3
ASSERT LAST_N == 3 "twin rrf"
GETF twin reserve
ASSERT LAST_N == tr0 + 3 "twin r+3"
GETF twin heat
ASSERT LAST_N == th0 + 3 "twin h+3"
GETF twin alive
ASSERT LAST_N == 1 "twin alive"

# ceil path with reserve bank after rrf
SEND ceil pulse 5
SEND ceil photosynth 40
SEND ceil glycolyse 32
SEND ceil charge 36
SEND ceil feed 28
SEND ceil charge_pcr 18
SEND ceil aars 4
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 12
SEND ceil eftu 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil ptc 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 12
SEND ceil efg 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil rf1 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 12
SEND ceil rf3 3
SEND ceil photosynth 24
SEND ceil glycolyse 20
SEND ceil charge 30
SEND ceil feed 20
SEND ceil charge_pcr 16
GETF ceil energy
LET ce0 = LAST_N
GETF ceil reserve
LET cr0 = LAST_N
SEND ceil rrf 4
ASSERT LAST_N == 4 "ceil rrf"
GETF ceil energy
ASSERT LAST_N == ce0 - 4 "ceil e-4"
GETF ceil reserve
ASSERT LAST_N == cr0 + 4 "ceil r+4"

# g0 quiescent holds ready 0
SEND g0 set_threshold 10
SEND g0 pulse 3
SEND g0 photosynth 30
SEND g0 glycolyse 24
SEND g0 charge 28
SEND g0 feed 20
SEND g0 charge_pcr 14
SEND g0 quiesce
SEND g0 rrf 2
ASSERT LAST_N == 2 "g0 rrf"
GETF g0 ready
ASSERT LAST_N == 0 "g0 ready0"

ASSERT 1 == 1 "2158_life_cell_rrf sealed"
