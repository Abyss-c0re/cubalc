# Proof 19 — modular + number-theory math (digit 2)
HOLD_FLASH 1
SCIENCE LOAD

# named div/mod
ASSERT IDIV(17, 5) == 3
ASSERT IMOD(17, 5) == 2

# modular add/sub/mul
ASSERT ADDMOD(10, 7, 12) == 5
ASSERT SUBMOD(3, 5, 12) == 10
ASSERT MULMOD(7, 8, 11) == 1
ASSERT MULMOD(6, 7, 13) == 3

# powmod
ASSERT POWMOD(2, 10, 1000) == 24
ASSERT POWMOD(3, 5, 13) == 9
ASSERT POWMOD(5, 0, 7) == 1

# fibonacci
ASSERT FIB(0) == 0
ASSERT FIB(1) == 1
ASSERT FIB(2) == 1
ASSERT FIB(10) == 55
ASSERT FIBONACCI(7) == 13

# primality
ASSERT ISPRIME(2) == 1
ASSERT ISPRIME(17) == 1
ASSERT ISPRIME(1) == 0
ASSERT ISPRIME(15) == 0
ASSERT PRIMEP(97) == 1
ASSERT PRIMEP(100) == 0

# compose with prior universal ops
ASSERT ISEL(ISPRIME(11), ADDMOD(3, 4, 5), 0) == 2
ASSERT POWMOD(2, FIB(5), 100) == 32
ASSERT OK == 1

CUBE m ROLE matrix PROTON 1
FOLDBITS m "1110001110001110001110001110001110001110001110001110001110001110"
ASSERT DIGIT(m) >= 0
ASSERT DIGIT(m) <= 9

PRINT "proof19_math_mod" ADDMOD(10,7,12) POWMOD(2,10,1000) FIB(10) ISPRIME(17) DIGIT(m)
