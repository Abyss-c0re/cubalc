# INCLUDE open_boot — agent_boot + OPEN one-shot

INCLUDE open_boot
ASSERT OK == 1
ASSERT OPEN_N == 8
ASSERT OPEN_FIRST == "general"
ASSERT DISCOVER_FIRST == "general"
ASSERT GUIDE_RELATED_N >= 3
ASSERT GUIDE_TIPS_N >= 2
SYS HASI "cubalc.open.v1"
ASSERT LAST_N == 1
VERSION
ASSERT LAST_N >= 1

RUNSNIP OPEN_FIRST
ASSERT OK == 1
ASSERT RUNSNIP_OK == 1

LET OPEN_NEEDLE = "p"
OPEN OPEN_NEEDLE
ASSERT OK == 1
ASSERT OPEN_FIRST == "cap"
ASSERT OPEN_N == 4

PASS
PRINT "1355_open_boot: PASS"
