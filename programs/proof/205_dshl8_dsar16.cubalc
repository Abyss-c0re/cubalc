# Proof 205 — digit-5 dual-stack fixed-width shift: DSHL8 DSHR8 DSAR8 DSHL16 DSHR16 DSAR16
HOLD_FLASH 1
SCIENCE LOAD

# DSHL8: logical left within byte
CLEARSTACK
PUSH 0x11
PUSH 0x40
PUSH 1
PUSH 1
DSHL8
POP y
POP x
ASSERT x == 0x22
ASSERT y == 0x80

# high bits masked; shift out → 0
CLEARSTACK
PUSH 0xAB81
PUSH 0x80
PUSH 1
PUSH 1
2SHL8
POP y
POP x
ASSERT x == 0x02
ASSERT y == 0

# PAIRSHL8 amount 0 identity (low 8)
CLEARSTACK
PUSH 0x7F
PUSH 0x55
PUSH 0
PUSH 0
PAIRSHL8
POP y
POP x
ASSERT x == 0x7F
ASSERT y == 0x55

# DSHR8 logical right
CLEARSTACK
PUSH 0x80
PUSH 0x03
PUSH 1
PUSH 1
DSHR8
POP y
POP x
ASSERT x == 0x40
ASSERT y == 0x01

# PAIRSHR8 / amount >= 8 → 0
CLEARSTACK
PUSH 0xFF
PUSH 0x01
PUSH 8
PUSH 3
PAIRSHR8
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DSAR8 arithmetic: 0x80 → -128; >>1 → -64
CLEARSTACK
PUSH 0x80
PUSH 0xFE
PUSH 1
PUSH 1
DSAR8
POP y
POP x
ASSERT x == -64
ASSERT y == -1

# 2SAR8 / DASHR8 positive
CLEARSTACK
PUSH 0x40
PUSH 0x7F
PUSH 2
PUSH 1
DASHR8
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x3F

# DSHL16 halfword left
CLEARSTACK
PUSH 0x0001
PUSH 0x4000
PUSH 1
PUSH 1
DSHL16
POP y
POP x
ASSERT x == 0x0002
ASSERT y == 0x8000

# high garbage masked
CLEARSTACK
PUSH 0x1ABCD
PUSH 0x8000
PUSH 1
PUSH 1
2SHL16
POP y
POP x
ASSERT x == 0x579A
ASSERT y == 0

# DSHR16
CLEARSTACK
PUSH 0x8000
PUSH 0x0003
PUSH 1
PUSH 1
DSHR16
POP y
POP x
ASSERT x == 0x4000
ASSERT y == 0x0001

# DSAR16: 0x8000 → -32768; >>1 → -16384
CLEARSTACK
PUSH 0x8000
PUSH 0xFFFE
PUSH 1
PUSH 1
DSAR16
POP y
POP x
ASSERT x == -16384
ASSERT y == -1

# PAIRSAR16 positive + large shift
CLEARSTACK
PUSH 0x4000
PUSH 0xFFFF
PUSH 2
PUSH 16
PAIRSAR16
POP y
POP x
ASSERT x == 0x1000
ASSERT y == -1
