# Proof 444 — digit-3 cell fixed-width 32 math: NEG32CELL ZEXT32CELL CLIP32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NEG32CELL: 100 → -100; min int32 0x80000000 stays
CELLSET 0 100
CELLSET 1 2147483648
NEG32CELL 0 1
ASSERT CELL(0) == -100
ASSERT CELL(1) == -2147483648
ASSERT LAST_N == 2

# NEG of -100 → 100 (via prior cell 0 which is -100)
NEG32CELL 0 0
ASSERT CELL(0) == 100

# ZEXT32CELL: clear high bits — 2^32+1 → 1; max u32 stays
CELLSET 2 4294967297
CELLSET 3 4294967295
ZEXT32CELL 2 3
ASSERT CELL(2) == 1
ASSERT CELL(3) == 4294967295
ASSERT LAST_N == 2

# CLIP32CELL: negative → 0; mid; overshoot → max u32
CELLSET 4 0
SEXT8CELL 4 4
# cell 4 was 0, still 0. Build -5: CELLSET 5 251; SEXT8 → -5
CELLSET 5 251
SEXT8CELL 5 5
CELLSET 6 1000
CELLSET 7 5000000000
CLIP32CELL 5 7
ASSERT CELL(5) == 0
ASSERT CELL(6) == 1000
ASSERT CELL(7) == 4294967295
ASSERT LAST_N == 3

# CLIP32RANGE single
CELLSET 8 42
CLIP32RANGE 8 8
ASSERT CELL(8) == 42

# ZEXT after signed min int32
CELLSET 9 2147483648
NEG32CELL 9 9
ASSERT CELL(9) == -2147483648
ZEXT32CELL 9 9
ASSERT CELL(9) == 2147483648

HOLD_FLASH 0
