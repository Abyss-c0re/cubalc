# Proof 360 — digit-7 reverse imm inverted ANDN TOC: SNANDNFROMTOCN SNORNFROMTOCN SXNORNFROMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SNANDNFROMTOCN: n=15, cell=240 → ~(15 & ~240) = -16
CELLSET 1 240
PUSH 1
SNANDNFROMTOCN 15
ASSERT LAST_N == (-16)
ASSERT CELL(1) == (-16)
POP a
ASSERT a == (-16)

# NANDNFROMTOCN: n=0, cell=5 → -1
CELLSET 2 5
PUSH 2
NANDNFROMTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(2) == (-1)
POP

# SNANDNFROMATN: n=-1, cell=0 → 0
CELLSET 3 0
PUSH 3
SNANDNFROMATN (-1)
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SNORNFROMTOCN: n=15, cell=255 → 240
CELLSET 4 255
PUSH 4
SNORNFROMTOCN 15
ASSERT LAST_N == 240
ASSERT CELL(4) == 240
POP

# NORNFROMTOCN: n=-1, cell=7 → 0
CELLSET 5 7
PUSH 5
NORNFROMTOCN (-1)
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# SNORNFROMATN: n=0, cell=-1 → -1
CELLSET 6 (-1)
PUSH 6
SNORNFROMATN 0
ASSERT LAST_N == (-1)
ASSERT CELL(6) == (-1)
POP

# SXNORNFROMTOCN: n=5, cell=5 → 0
CELLSET 7 5
PUSH 7
SXNORNFROMTOCN 5
ASSERT LAST_N == 0
ASSERT CELL(7) == 0
POP

# XNORNFROMTOCN: n=7, cell=1 → 6
CELLSET 8 1
PUSH 8
XNORNFROMTOCN 7
ASSERT LAST_N == 6
ASSERT CELL(8) == 6
POP

# SXNORNFROMATN: n=0, cell=0 → 0
CELLSET 9 0
PUSH 9
SXNORNFROMATN 0
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft empty OK=0
CLEARSTACK
SNANDNFROMTOCN 1
ASSERT OK == 0

PRINT "360_snandnfromtocn_sxnornfromtocn OK"
