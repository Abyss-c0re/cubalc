# Proof 76 — digit-0/5 COP matrix query: COUNTBITS/ONES/ZEROS/GETBIT + PARITY
HOLD_FLASH 1
SCIENCE LOAD

CUBE m ROLE matrix PROTON 1
CLEARBITS m
COUNTBITS m
ASSERT LAST_N == 0
ZEROS m
ASSERT LAST_N == 64

# set a few bits
SETBIT m 0 1
SETBIT m 1 1
SETBIT m 7 1
ONES m
ASSERT LAST_N == 3
COUNTBITS m
ASSERT LAST_N == 3
ASSERT SET == 3
ZEROS m
ASSERT LAST_N == 61

GETBIT m 0
ASSERT LAST_N == 1
GETBIT m 1
ASSERT LAST_N == 1
GETBIT m 2
ASSERT LAST_N == 0
BITAT m 7
ASSERT LAST_N == 1
READBIT m 3
ASSERT LAST_N == 0

# clear one
SETBIT m 1 0
GETBIT m 1
ASSERT LAST_N == 0
ONES m
ASSERT LAST_N == 2

# FOLDBITS then count
FOLDBITS m "1111000011110000"
ONES m
ASSERT LAST_N == 8
ZEROS m
ASSERT LAST_N == 56

# PARITY of word
ASSERT PARITY(0) == 0
ASSERT PARITY(1) == 1
ASSERT PARITY(3) == 0
ASSERT PARITY(7) == 1
ASSERT EVENPAR(3) == 1
ASSERT ODDPAR(1) == 1

# POPBITS alias
POPBITS m
ASSERT LAST_N == 8

# unknown cube soft
COUNTBITS nosuch
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof76_countbits_getbit" LAST_N SET
