# Proof 285 — digit-9 stack imm inverted ANDN plane: SNANDNI SNORNI SXNORNI
HOLD_FLASH 1
SCIENCE LOAD

# SNANDNI n — TOS = ~(TOS & ~n)
CLEARSTACK
PUSH 0x1122334455667788
SNANDNI 0x0F
POP x
ASSERT x == 0xEEDDCCBBAA99887F

CLEARSTACK
PUSH 0xABCD
NANDNI 0xFF
POP x
ASSERT x == -43777

CLEARSTACK
PUSH -1
SINVERTANDNI 0xF0
POP x
ASSERT x == 240

# SNORNI n — TOS = ~(TOS | ~n)
CLEARSTACK
PUSH 0x1122334455667788
SNORNI 0x0F
POP x
ASSERT x == 7

CLEARSTACK
PUSH 0
NORNI 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0
STACKNORNI 0xFF
POP x
ASSERT x == 255

CLEARSTACK
PUSH -1
SNORNOTI 0xF
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xF0
SNORNOTI 0xFF
POP x
ASSERT x == 15

# SXNORNI n — TOS = ~(TOS ^ ~n) ≡ TOS ^ n
CLEARSTACK
PUSH 0x1122334455667788
SXNORNI 0x0F
POP x
ASSERT x == 0x1122334455667787

CLEARSTACK
PUSH -1
XNORNI 0
POP x
ASSERT x == -1

CLEARSTACK
PUSH -1
SEQUIVNI 0xF
POP x
ASSERT x == -16

CLEARSTACK
PUSH 0x1122334455667788
SXORI 0x0F
POP y
CLEARSTACK
PUSH 0x1122334455667788
SXNORNI 0x0F
POP x
ASSERT x == y

# soft fails
CLEARSTACK
SNANDNI 1
ASSERT OK == 0
CLEARSTACK
SNORNI 1
ASSERT OK == 0
CLEARSTACK
SXNORNI 1
ASSERT OK == 0

HOLD_FLASH 1
