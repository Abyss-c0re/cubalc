# Proof 411 — digit-5 imm dual 32-bit extend + clip8: SZEXT32TOCN SSEXT32TOCN SCLIP8TOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SZEXT32TOCN: low 32 of 0x1FFFFFFFF=8589934591 → 4294967295
CELLSET 1 8589934591
PUSH 1
SZEXT32TOCN
ASSERT LAST_N == 4294967295
ASSERT CELL(1) == 4294967295
POP

# ZEXT32TOCN alias: 0x80000000 stays
CELLSET 2 2147483648
PUSH 2
ZEXT32TOCN
ASSERT LAST_N == 2147483648
ASSERT CELL(2) == 2147483648
POP

# SSEXT32TOCN: 0xFFFFFFFF → -1
CELLSET 3 4294967295
PUSH 3
SSEXT32TOCN
ASSERT LAST_N == -1
ASSERT CELL(3) == -1
POP

# SEXT32TOCN: 0x80000000 → -2147483648
CELLSET 4 2147483648
PUSH 4
SEXT32TOCN
ASSERT LAST_N == -2147483648
ASSERT CELL(4) == -2147483648
POP

# SSEXTLTOCN: 0x7FFFFFFF → 2147483647
CELLSET 5 2147483647
PUSH 5
SSEXTLTOCN
ASSERT LAST_N == 2147483647
ASSERT CELL(5) == 2147483647
POP

# SCLIP8TOC: 300 → 255
CELLSET 6 300
PUSH 6
SCLIP8TOC
ASSERT LAST_N == 255
ASSERT CELL(6) == 255
POP

# CLIP8TOC: 100 stays 100
CELLSET 7 100
PUSH 7
CLIP8TOC
ASSERT LAST_N == 100
ASSERT CELL(7) == 100
POP

# SCLIPBTOC: -5 via sext4 then clip → 0
CELLSET 8 15
PUSH 8
SSEXT4TOC
POP
PUSH 8
SCLIPBTOC
ASSERT LAST_N == 0
ASSERT CELL(8) == 0
POP

# soft short stack OK=0
CLEARSTACK
SZEXT32TOCN
ASSERT OK == 0
SSEXT32TOCN
ASSERT OK == 0
SCLIP8TOC
ASSERT OK == 0

PRINT "411_szext32tocn_sclip8toc OK"
