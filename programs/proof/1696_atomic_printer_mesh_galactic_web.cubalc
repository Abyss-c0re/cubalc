// atomic_printer_mesh_galactic_web.cubalc
// Life-force gift: MESH-GALACTIC-WEB — soft-OOB storms fail-closed on the five-node
// printer spine; STABILIZE clears thrash; full mesh_exchange (C(5,2) undirected
// pairs both ways) + spiral ring EXCHANGE + hub-core returns raise a galactic web
// of mind; RECOVER restores vital/key; dual SEAL/OPEN rails rebind hive; mitosis
// under free energy while the web holds; second storm still fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.
// Sibling of atomic_printer_life_force + smx_mesh_stability — mind-plane galactic web.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_galactic_web | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B/C soft-OOB thrash — no ghost place (fail-closed)
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C storm depth"
ASSERT CUBES == base_cubes "no ghost storm-C"

// STABILIZE latch: clear thrash + circular breath on five-node spine
SMX STABILIZE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "spine stabilize live"
ASSERT SMX_STABLE == 1 "stable latch"
ASSERT SMX_STEADFAST == 5 "five steadfast"
ASSERT SMX_PULSE == 5 "five pulses"
ASSERT SMX_OOB == 0 "oob cleared by stabilize"
ASSERT SMX_TALKS >= 5 "stabilize talks"
ASSERT CUBES == base_cubes "stabilize invents nothing"

// Complete undirected mesh among five live (C(5,2)=10 pairs, both ways)
SMX EXCHANGE bed nozzle
SMX EXCHANGE bed hive
SMX EXCHANGE bed scrap
SMX EXCHANGE bed pulse
SMX EXCHANGE nozzle hive
SMX EXCHANGE nozzle scrap
SMX EXCHANGE nozzle pulse
SMX EXCHANGE hive scrap
SMX EXCHANGE hive pulse
SMX EXCHANGE scrap pulse
ASSERT SMX_OK == 1 "galactic mesh exchange live"
ASSERT SMX_TALKS >= 25 "mesh + stabilize talks"
ASSERT CUBES == base_cubes "mesh invents nothing"

// Spiral-arm ring — free energy self-regulates every edge i→i+1 both ways
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap pulse
SMX EXCHANGE pulse bed
ASSERT SMX_OK == 1 "arm ring live"
ASSERT CUBES == base_cubes "arm ring invents nothing"

// Halo-core hub returns — seed axis from every leaf to root bed
SMX EXCHANGE nozzle bed
SMX EXCHANGE hive bed
SMX EXCHANGE scrap bed
SMX EXCHANGE pulse bed
ASSERT SMX_OK == 1 "core hub live"
ASSERT CUBES == base_cubes "core hub invents nothing"

// Latch vitals after galactic web raise
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after galactic web"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after web"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after galactic web"
ASSERT UNITY >= 40 "mesh unity after galactic web"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

// Mitosis under free energy while the galactic web holds
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          LET births = births + 1
        END
      END
    END
  END
  SEND seed tick
  SEND d1 tick
  SEND d2 tick
  LET step = step + 1
END

GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = 1
IF a1 == 1 THEN
  LET pop = pop + 1
END
IF a2 == 1 THEN
  LET pop = pop + 1
END
ASSERT births >= 1 "mitosis under galactic web"
ASSERT pop >= 2 "population after galactic life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Dual SEAL/OPEN rails BN+HS rebind hive under stable web
SMX SEAL bed nozzle "state/smx_galactic_web/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_galactic_web/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_galactic_web/rail_hs.cblc"
ASSERT SMX_OK == 1 "seal rail HS"
SMX OPEN pulse "state/smx_galactic_web/rail_hs.cblc"
ASSERT SMX_OK == 1 "open HS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Soft-OOB ghost after rails — fail-closed, no thrash place
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"

// RECOVER + re-stabilize + re-mesh after second storm
SMX RECOVER
ASSERT SMX_OK == 1 "recover after storm"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital after recover"

SMX STABILIZE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "restabilize after storm"
ASSERT SMX_STABLE == 1 "stable after storm"
ASSERT SMX_OOB == 0 "oob cleared by restabilize"
ASSERT SMX_STEADFAST == 5 "five steadfast after storm"

SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
SMX EXCHANGE hive scrap
SMX EXCHANGE scrap pulse
SMX EXCHANGE pulse bed
ASSERT SMX_OK == 1 "ring after storm"
ASSERT CUBES == base_cubes "post-storm ring invents nothing"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after restabilize"
ASSERT UNITY >= 40 "mesh unity after restabilize"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh galactic web"
ASSERT pop >= 2 "population after galactic life"
ASSERT SMX_STABLE == 1 "stable latch holds"
ASSERT SMX_OOB == 0 "guard holds through galactic web"
ASSERT OK == 1

PRINT "mesh_galactic_web" births pop SMX_STABLE SMX_STEADFAST SMX_PULSE SMX_BREATH SMX_NODES SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES

PASS
