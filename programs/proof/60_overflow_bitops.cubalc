# Proof 60 — digit-1 ADDOVF/SUBOVF/MULOVF BTEST/BSET/BCLR/BFLIP + stack
HOLD_FLASH 1
SCIENCE LOAD

# overflow predicates — ordinary values no overflow
ASSERT ADDOVF(1, 2) == 0
ASSERT SUBOVF(10, 3) == 0
ASSERT MULOVF(6, 7) == 0
ASSERT ADDOVER(-5, -3) == 0
ASSERT SUBOVER(0, 0) == 0
ASSERT MULOVER(1, -1) == 0

# known overflow: LONG_MAX + 1 style via large positives
# use values that clearly overflow on 64-bit long when available
# LONG_MAX is at least 2^63-1 on LP64; 2^62 * 4 overflows
ASSERT MULOVF(4611686018427387904, 4) == 1
ASSERT MULOVF(100, 100) == 0
ASSERT ADDOVF(9223372036854775807, 1) == 1
ASSERT SUBOVF(-9223372036854775807, 2) == 1
ASSERT SUBOVF(-9223372036854775807, 1) == 0

# BTEST / BITTEST
ASSERT BTEST(5, 0) == 1
ASSERT BTEST(5, 1) == 0
ASSERT BTEST(5, 2) == 1
ASSERT BITTEST(8, 3) == 1
ASSERT BTEST(0, 7) == 0

# BSET / BCLR / BFLIP
ASSERT BSET(0, 3) == 8
ASSERT BCLR(15, 0) == 14
ASSERT BFLIP(0, 1) == 2
ASSERT BITSET(1, 1) == 3
ASSERT BITCLR(7, 1) == 5
ASSERT BITFLIP(5, 0) == 4
ASSERT BTGL(0, 4) == 16

# compose
ASSERT BTEST(BSET(0, 5), 5) == 1
ASSERT BTEST(BCLR(255, 7), 7) == 0
ASSERT SELECT(ADDOVF(1, 1), 0, 1) == 1
ASSERT SELECT(MULOVF(4611686018427387904, 4), 99, 0) == 99

# stack SADDOVF SSUBOVF SMULOVF
CLEARSTACK
PUSH 1
PUSH 2
SADDOVF
ASSERT LAST_N == 0
CLEARSTACK
PUSH 9223372036854775807
PUSH 1
SADDOVER
ASSERT LAST_N == 1
CLEARSTACK
PUSH 10
PUSH 3
SSUBOVF
ASSERT LAST_N == 0
CLEARSTACK
PUSH -9223372036854775807
PUSH 2
SSUBOVER
ASSERT LAST_N == 1
CLEARSTACK
PUSH 6
PUSH 7
SMULOVF
ASSERT LAST_N == 0
CLEARSTACK
PUSH 4611686018427387904
PUSH 4
STACKMULOVF
ASSERT LAST_N == 1

# stack bit ops already exist (SBTEST) — compose with overflow
CLEARSTACK
PUSH 0
PUSH 3
SSETB
ASSERT LAST_N == 8
PUSH 3
SBTEST
ASSERT LAST_N == 1

# underflow
CLEARSTACK
SADDOVF
ASSERT OK == 0
CLEARSTACK
SMULOVF
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof60_overflow_bitops" LAST_N SP
