ASSERT x == 0
ASSERT CELL(8) == 0

# S0GEZATN alias
CLEARSTACK
CELLSET 9 0
S0GEZATN 9
POP x
ASSERT x == 1
ASSERT CELL(9) == 1

# GEZTOCN negative
