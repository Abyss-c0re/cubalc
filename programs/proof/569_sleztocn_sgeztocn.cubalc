# Proof 569 — digit-2 pure-imm cell zero-rel LE0/GE0 TOC: SLEZTOCN SGEZTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SLEZTOCN: zero → 1
CELLSET 1 0
SLEZTOCN 1
POP x
ASSERT x == 1
ASSERT CELL(1) == 1
ASSERT LAST_N == 1

# positive → 0
CLEARSTACK
CELLSET 2 5
S0LETOCN 2
POP x
ASSERT x == 0
ASSERT CELL(2) == 0

# negative → 1
CLEARSTACK
CELLSET 3 (-4)
SNONPOSTOCN 3
POP x
ASSERT x == 1
ASSERT CELL(3) == 1

# S0LEATN alias
CLEARSTACK
CELLSET 4 0
S0LEATN 4
POP x
ASSERT x == 1
ASSERT CELL(4) == 1

# LEZTOCN positive
CLEARSTACK
CELLSET 5 9
LEZTOCN 5
POP x
ASSERT x == 0
ASSERT CELL(5) == 0

# SGEZTOCN: zero → 1
CLEARSTACK
CELLSET 6 0
SGEZTOCN 6
POP x
ASSERT x == 1
ASSERT CELL(6) == 1

# positive → 1
