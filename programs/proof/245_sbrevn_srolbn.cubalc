# Proof 245 — digit-4 stack low-n field reverse/rotate: SBREVN SROLBN SRORBN
HOLD_FLASH 1
SCIENCE LOAD

# SBREVN — reverse low n of TOS
CLEARSTACK
PUSH 0x0B
SBREVN 4
POP x
# 1011 → 1101
ASSERT x == 0x0D

CLEARSTACK
PUSH 0xF0AB
STACKBREVN 8
POP x
# 0xAB → 0xD5
ASSERT x == 0xF0D5

# BREVNS alias
CLEARSTACK
PUSH 0x55
BREVNS 0
POP x
ASSERT x == 0x55

# SROLBN — rotl1 within low n
CLEARSTACK
PUSH 0x09
SROLBN 4
POP x
# 1001 → 0011
ASSERT x == 0x03

CLEARSTACK
PUSH 0xF081
STACKROLBN 8
POP x
# 0x81 → 0x03
ASSERT x == 0xF003

# SRORBN — rotr1 within low n
CLEARSTACK
PUSH 0x09
SRORBN 4
POP x
# 1001 → 1100
ASSERT x == 0x0C

CLEARSTACK
PUSH 0xF081
STACKRORBN 8
POP x
# 0x81 → 0xC0
ASSERT x == 0xF0C0

# RORBNS alias + round-trip
CLEARSTACK
PUSH 0xA5
SROLBN 8
RORBNS 8
POP x
ASSERT x == 0xA5

# high bits preserved under reverse
CLEARSTACK
PUSH 0xABCD
SBREVN 4
POP x
# low nibble 0xD=1101 → 1011=0xB → 0xABCB
ASSERT x == 0xABCB

# soft fails
CLEARSTACK
SBREVN 4
ASSERT OK == 0
CLEARSTACK
SROLBN 4
ASSERT OK == 0
CLEARSTACK
SRORBN 4
ASSERT OK == 0

HOLD_FLASH 1
