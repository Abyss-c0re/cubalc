# CLAIMOUT / CLAIMNEST — ENSUREPARENT + exclusive create
# Nested work-item claims without DIRNAME + MKDIR + CLAIM glue.

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS PID
SYS STR LAST_N
LET pid = LAST
SYS JOIN td "mi_clo_"
SYS CAT LAST pid
LET root = LAST
SYS MKDIR root
ASSERT OK == 1

# nested missing parents
SYS JOIN root "work/deep/item.claim"
LET c = LAST
CLAIMOUT c
ASSERT OK == 1
ASSERT CLAIM_HIT == 1
ASSERT CLAIMOUT_CREATED == 1
ASSERT LAST_N == 1
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "item.claim"
ASSERT LAST_N == 1
SYS ENDS CLAIMOUT_PARENT "deep"
ASSERT LAST_N == 1
SYS ISFILE LAST
ASSERT LAST_N == 1
ASSERT CLAIM_PID > 0

# second claim same path — soft miss held
CLAIMOUT c
ASSERT OK == 0
ASSERT CLAIM_HIT == 0
LET e = LAST_ERR
SYS HAS e "exists"
ASSERT LAST_N == 1

# CLAIMNEST alias + body
SYS JOIN root "jobs/q/run.claim"
LET j = LAST
CLAIMNEST j "mine"
ASSERT OK == 1
ASSERT CLAIM_HIT == 1
ASSERT CLAIMOUT_CREATED == 1
SYS READ j
SYS HAS LAST "mine"
ASSERT LAST_N == 1

# SYS form
SYS JOIN root "sys/deep/x.claim"
LET s = LAST
SYS CLAIMOUT s
ASSERT OK == 1
ASSERT CLAIM_HIT == 1
SYS ENDS LAST "x.claim"
ASSERT LAST_N == 1
SYS CLAIMOUT s
ASSERT OK == 0
ASSERT CLAIM_HIT == 0

# empty path soft
CLAIMOUT ""
ASSERT OK == 0
LET e2 = LAST_ERR
SYS HAS e2 "empty"
ASSERT LAST_N == 1

# release + re-claim
SYS RM c
CLAIMOUT c
ASSERT OK == 1
ASSERT CLAIM_HIT == 1
ASSERT CLAIMOUT_CREATED == 0

# cleanup
SYS WALK root
SYS RMALL LAST
SYS RM root
