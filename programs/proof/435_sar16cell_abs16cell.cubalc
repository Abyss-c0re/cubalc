# Proof 435 — digit-2 cell fixed-width 16 signed: SAR16CELL SEXT16CELL ABS16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SAR16CELL: 0xFFF0 (-16) >> 2 → -4; 0x8000 >> 1 → 0xC000 as int16 (-16384)
CELLSET 0 65520
CELLSET 1 32768
SAR16CELL 0 1 2
ASSERT CELL(0) == -4
# 0x8000 as int16 >> 2 = 0xE000 = -8192
ASSERT CELL(1) == -8192
ASSERT LAST_N == 2

# SAR16RANGE k>=16 → all sign bits
CELLSET 2 32768
SAR16RANGE 2 2 16
ASSERT CELL(2) == -1
CELLSET 3 100
SAR16RANGE 3 3 20
ASSERT CELL(3) == 0

# positive SAR
CELLSET 4 64
SAR16CELL 4 4 3
ASSERT CELL(4) == 8

# SEXT16CELL: 0xFFFF → -1; 0x7FFF → 32767; 0x8000 → -32768
CELLSET 5 65535
CELLSET 6 32767
CELLSET 7 32768
SEXT16CELL 5 7
ASSERT CELL(5) == -1
ASSERT CELL(6) == 32767
ASSERT CELL(7) == -32768
ASSERT LAST_N == 3

# ABS16CELL: -5 → 5; 42 → 42; min int16 0x8000 stays 0x8000
CELLSET 8 65531
CELLSET 9 42
CELLSET 10 32768
ABS16CELL 8 10
ASSERT CELL(8) == 5
ASSERT CELL(9) == 42
ASSERT CELL(10) == 32768
ASSERT LAST_N == 3

# round-trip: SEXT then ABS of -100 (0xFF9C)
CELLSET 11 65436
SEXT16CELL 11 11
ABS16CELL 11 11
ASSERT CELL(11) == 100

HOLD_FLASH 0
