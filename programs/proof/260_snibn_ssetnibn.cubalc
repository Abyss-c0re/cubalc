# Proof 260 — digit-4 stack imm nibble field: SNIBN SSETNIBN SCLRNIBN
HOLD_FLASH 1
SCIENCE LOAD

# SNIBN — extract LE nibble
CLEARSTACK
PUSH 0xABCD
SNIBN 0
POP x
ASSERT x == 0xD

CLEARSTACK
PUSH 0xABCD
STACKNIBN 1
POP x
ASSERT x == 0xC

CLEARSTACK
PUSH 0xABCD
GETNIBN 2
POP x
ASSERT x == 0xB

CLEARSTACK
PUSH 0xABCD
NIBN 3
POP x
ASSERT x == 0xA

# clamp index
CLEARSTACK
PUSH 0x123456789ABCDEF0
SNIBN 99
POP x
ASSERT x == 0x1

# SSETNIBN field n
CLEARSTACK
PUSH 0x0000
SSETNIBN 0xA 0
POP x
ASSERT x == 0xA

CLEARSTACK
PUSH 0x0000
STACKSETNIBN 0xB 1
POP x
ASSERT x == 0xB0

CLEARSTACK
PUSH -1
SETNIBN 0 2
POP x
# clear nibble 2 (bits 8..11): -1 & ~0xF00
ASSERT x == -3841

CLEARSTACK
PUSH 0
PUTNIBN 0xF 3
POP x
ASSERT x == 0xF000

# SCLRNIBN n
CLEARSTACK
PUSH 0xABCD
SCLRNIBN 0
POP x
ASSERT x == 0xABC0

CLEARSTACK
PUSH 0xABCD
STACKCLRNIBN 1
POP x
ASSERT x == 0xAB0D

CLEARSTACK
PUSH 0xABCD
CLRNIBN 2
POP x
ASSERT x == 0xA0CD

CLEARSTACK
PUSH 0xABCD
ZAPNIBN 3
POP x
ASSERT x == 0x0BCD

# soft fails
CLEARSTACK
SNIBN 0
ASSERT OK == 0
CLEARSTACK
SSETNIBN 1 0
ASSERT OK == 0
CLEARSTACK
SCLRNIBN 0
ASSERT OK == 0

HOLD_FLASH 1
