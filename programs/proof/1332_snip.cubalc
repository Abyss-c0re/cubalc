# SNIP — curated mini runnable source by topic

SNIP
ASSERT OK == 1
ASSERT SNIP_TOPIC == "general"
ASSERT SNIP_N >= 3
SYS HASI "VERSION"
ASSERT LAST_N == 1
SYS HASI "STATUS"
ASSERT LAST_N == 1

SNIP cap
ASSERT OK == 1
ASSERT SNIP_TOPIC == "cap"
SYS HASI "HASFORM"
ASSERT LAST_N == 1
SYS HASI "FORMHINT"
ASSERT LAST_N == 1
SYS HASI "RELATED"
ASSERT LAST_N == 1

SNIPPET plate
ASSERT OK == 1
ASSERT SNIP_TOPIC == "plate"
SYS HASI "SETP"
ASSERT LAST_N == 1
SYS HASI "NEEDP"
ASSERT LAST_N == 1

SNIP lib
ASSERT OK == 1
SYS HASI "LISTLIBS"
ASSERT LAST_N == 1
SYS HASI "RECIPE"
ASSERT LAST_N == 1

SNIP fat
ASSERT OK == 1
SYS HASI "VARROOM"
ASSERT LAST_N == 1

# alias forms → cap
SNIP forms
ASSERT OK == 1
ASSERT SNIP_TOPIC == "cap"

# soft miss
SNIP zzz_nope
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1332_snip: PASS"
