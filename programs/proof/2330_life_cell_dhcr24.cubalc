SEND mito dhcr24 100
GETF mito atp
LET fc_a2 = LAST_N
GETF mito energy
LET fc_e2 = LAST_N
GETF mito heat
LET fc_h2 = LAST_N
ASSERT fc_a2 >= 0 "mito dhcr24 clamp atp>=0"
ASSERT fc_e2 >= 0 "mito dhcr24 clamp energy>=0"
ASSERT fc_h2 >= fc_h "mito dhcr24 clamp heat+="
ASSERT fc_a2 <= fc_a "mito dhcr24 clamp atp down"
ASSERT fc_e2 <= fc_e "mito dhcr24 clamp energy down"
GETF mito age
ASSERT LAST_N == fc_age "mito dhcr24 clamp age held"
GETF mito alive
ASSERT LAST_N == 1 "mito alive post-dhcr24 clamp"

SEND ash dhcr24 5
ASSERT LAST_N == 0 "ash dhcr24 refused"
GETF ash alive
ASSERT LAST_N == 0 "ash stays dead"

SEND starve dhcr24 3
ASSERT LAST_N == 0 "starve dhcr24 refused no fuel"
GETF starve alive
ASSERT LAST_N == 1 "starve stays alive"

