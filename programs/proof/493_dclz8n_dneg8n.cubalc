# Proof 493 — digit-3 dual-stack imm 8-bit field zeros+signed: DCLZ8N DCTZ8N DNEG8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DCLZ8N: 0→8 ; 1→7
PUSH 0x0
PUSH 0x1
DCLZ8N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 7

# 0x80→0 ; 0x02→6
CLEARSTACK
PUSH 0x80
PUSH 0x02
PAIRCLZ8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 6

# high preserved clz0→8
CLEARSTACK
PUSH 0x1122334455667700
PUSH 0x99AABBCCDDEEFF01
DCLZ8N 0
POP y
POP x
ASSERT x == 0x1122334455667708
ASSERT y == 0x99AABBCCDDEEFF07

# S2CLZ8N n1: 0x4000 byte1=0x40=01000000 clz1 → 0x0100
CLEARSTACK
PUSH 0x4000
PUSH 0x2000
S2CLZ8N 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0200

# DCTZ8N: 0→8 ; 1→0 ; 0x80→7 ; 0x06→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DCTZ8N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 0

CLEARSTACK
PUSH 0x80
PUSH 0x06
PAIRCTZ8N 0
POP y
POP x
ASSERT x == 7
ASSERT y == 1

# STACK2CTZ8N n1: 0xC000 byte1=C0=11000000 ctz6 → 0x0600
CLEARSTACK
PUSH 0xC000
PUSH 0xA000
STACK2CTZ8N 1
POP y
POP x
ASSERT x == 0x0600
ASSERT y == 0x0500

# DNEG8N: 3→0xFD ; 0xFE (-2)→2 ; min 0x80 stays 0x80
CLEARSTACK
PUSH 0x3
PUSH 0xFE
DNEG8N 0
POP y
POP x
ASSERT x == 253
ASSERT y == 2

CLEARSTACK
PUSH 0x80
PUSH 0x1
PAIRNEG8N 0
POP y
POP x
ASSERT x == 128
ASSERT y == 255

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455667755
PUSH 0x99AABBCCDDEEFF03
DNEG8N 0
POP y
POP x
ASSERT x == 0x11223344556677AB
ASSERT y == 0x99AABBCCDDEEFFFD

CLEARSTACK
PUSH 0x11223344556677AB
PUSH 0x99AABBCCDDEEFFFD
DNEG8N 0
POP y
POP x
ASSERT x == 0x1122334455667755
ASSERT y == 0x99AABBCCDDEEFF03

# S2NEG8N n1: 0x3000 byte1=0x30 → -0x30 = 0xD0 → 0xD000
CLEARSTACK
PUSH 0x3000
PUSH 0x2000
S2NEG8N 1
POP y
POP x
ASSERT x == 0xD000
ASSERT y == 0xE000

# aliases
CLEARSTACK
PUSH 0x10
PUSH 0x10
DNLZ8N 0
POP y
POP x
ASSERT x == 3
ASSERT y == 3

CLEARSTACK
PUSH 0x10
PUSH 0x10
DNTZ8N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 4

CLEARSTACK
PUSH 0x2
PUSH 0x2
DBYTENEGN 0
POP y
POP x
ASSERT x == 254
ASSERT y == 254

HOLD_FLASH 0
