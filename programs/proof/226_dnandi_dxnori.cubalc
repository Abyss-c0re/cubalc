# Proof 226 — digit-0 dual-stack immediate inverted bitwise: DNANDI DNORI DXNORI
HOLD_FLASH 1
SCIENCE LOAD

# DNANDI: ~(a&n)  — 0xFF&0x0F=0x0F → ~0x0F = -16
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
DNANDI 0x0F
POP y
POP x
ASSERT x == -16
ASSERT y == -16

# 0xAA&0x0F=0x0A → ~10 = -11; 0x55&0x0F=5 → ~5 = -6
CLEARSTACK
PUSH 0xAA
PUSH 0x55
2NANDI 0x0F
POP y
POP x
ASSERT x == -11
ASSERT y == -6

# PAIRNANDI / DNANDIMM
CLEARSTACK
PUSH 0xFFFF
PUSH 0x00FF
PAIRNANDI 0xF0
POP y
POP x
ASSERT x == -241
ASSERT y == -241

CLEARSTACK
PUSH 7
PUSH 15
DNANDIMM 3
POP y
POP x
ASSERT x == -4
ASSERT y == -4

# DNORI: ~(a|n)
# 0x0F|0xF0=0xFF → -256; 0|0xF0=0xF0 → -241
CLEARSTACK
PUSH 0x0F
PUSH 0x00
DNORI 0xF0
POP y
POP x
ASSERT x == -256
ASSERT y == -241

# 1|4=5 → -6; 2|4=6 → -7
CLEARSTACK
PUSH 1
PUSH 2
2NORI 4
POP y
POP x
ASSERT x == -6
ASSERT y == -7

# PAIRNORI
CLEARSTACK
PUSH 0
PUSH 0
PAIRNORI 0xAA
POP y
POP x
ASSERT x == -171
ASSERT y == -171

# DXNORI: ~(a^n)  equivalence
# 0xFF^0x0F=0xF0 → -241; 0x0F^0x0F=0 → -1
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
DXNORI 0x0F
POP y
POP x
ASSERT x == -241
ASSERT y == -1

# 0xAA^0xFF=0x55 → -86; 0x55^0xFF=0xAA → -171
CLEARSTACK
PUSH 0xAA
PUSH 0x55
2XNORI 0xFF
POP y
POP x
ASSERT x == -86
ASSERT y == -171

# PAIRXNORI: 1^1=0 → -1; 3^1=2 → -3
CLEARSTACK
PUSH 1
PUSH 3
PAIRXNORI 1
POP y
POP x
ASSERT x == -1
ASSERT y == -3

# DEQUIVI: 0xF0^0xFF=0x0F → -16; 0x0F^0xFF=0xF0 → -241
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
DEQUIVI 0xFF
POP y
POP x
ASSERT x == -16
ASSERT y == -241

# identity: XNORI -1 is double-complement restore (~(x^-1)=~(~x)=x)
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
DXNORI -1
POP y
POP x
ASSERT x == 0x1234
ASSERT y == 0xABCD

# soft empty stack
CLEARSTACK
DNANDI 1
ASSERT OK == 0
