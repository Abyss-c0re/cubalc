# SYS PARSEISO / TOEPOCH — ISO stamp → Unix epoch (dual of FROMTIME)
# Usability: plate DATE stamps → age/compare without shell date -d

HOLD_FLASH 1

# epoch 0
SYS PARSEISO "1970-01-01T00:00:00Z"
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT PARSEISO_N == 0
ASSERT TIME == 0

# Y2K
SYS PARSEISO "2000-01-01T00:00:00Z"
ASSERT OK == 1
ASSERT LAST_N == 946684800

# with time
SYS PARSEISO "2000-01-01T00:01:01Z"
ASSERT OK == 1
ASSERT LAST_N == 946684861

# without Z
SYS PARSEISO "2000-01-01T00:00:00"
ASSERT OK == 1
ASSERT LAST_N == 946684800

# space separator
SYS PARSEISO "2000-01-01 00:00:00"
ASSERT OK == 1
ASSERT LAST_N == 946684800

# date-only → midnight UTC
SYS PARSEISO "2000-01-01"
ASSERT OK == 1
ASSERT LAST_N == 946684800

# aliases
SYS TOEPOCH "1970-01-01T00:00:00Z"
ASSERT OK == 1
ASSERT LAST_N == 0
SYS FROMISO "2001-09-09T01:46:40Z"
ASSERT OK == 1
ASSERT LAST_N == 1000000000

# round-trip with FROMTIME
SYS FROMTIME 1700000000
SYS PARSEISO LAST
ASSERT OK == 1
ASSERT LAST_N == 1700000000

SYS FROMTIME 0
SYS PARSEISO LAST
ASSERT OK == 1
ASSERT LAST_N == 0

SYS FROMTIME 946684861
SYS PARSEISO LAST
ASSERT OK == 1
ASSERT LAST_N == 946684861

# soft fail
SYS PARSEISO ""
ASSERT OK == 0
SYS PARSEISO "not-a-date"
ASSERT OK == 0
SYS PARSEISO "2000-13-01"
ASSERT OK == 0

# var arg
LET stamp = "2000-01-01T00:00:00Z"
SYS PARSEISO stamp
ASSERT OK == 1
ASSERT LAST_N == 946684800

PRINT "sys_parseiso ok"
