# Proof 89 — digit-4 control: EACH CELL / FORCELL + BREAKIF / CONTINUEIF
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CELLSET 0 10
CELLSET 1 20
CELLSET 2 30
CELLSET 3 40
CELLSET 4 50
CELLSET 5 60

LET s = 0
EACH CELL AS v FROM 0 TO 5
  LET s = s + v
END
ASSERT s == 210

LET t = 0
FORCELL 1 3
  LET t = t + VAL
END
ASSERT t == 90

LET u = 0
FORCELL x 0 2
  LET u = u + x
END
ASSERT u == 60

LET e = 0
EACH CELL FROM 0 TO 5
  CONTINUEIF IT % 2 == 1
  LET e = e + VAL
END
ASSERT e == 90

LET k = 0
FORCELL 0 5
  BREAKIF VAL >= 40
  LET k = k + 1
END
ASSERT k == 3

LET n = 0
LOOP 20
  LET n = n + 1
  BREAKIF n == 6
END
ASSERT n == 6

LET c = 0
LOOP 5
  CONTIF IT < 2
  LET c = c + 1
END
ASSERT c == 3

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof89_eachcell_breakif" s t u e k n c
