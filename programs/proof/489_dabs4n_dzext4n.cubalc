# Proof 489 — digit-2 dual-stack imm 4-bit field abs+extend: DABS4N DSEXT4N DZEXT4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DABS4N: E→2 ; 5→5
PUSH 0xE
PUSH 0x5
DABS4N 0
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# min int4 -8 stays 8
CLEARSTACK
PUSH 0x8
PUSH 0x8
PAIRABS4N 0
POP y
POP x
ASSERT x == 8
ASSERT y == 8

# high preserved abs
CLEARSTACK
PUSH 0x112233445566777E
PUSH 0x99AABBCCDDEEFF0D
DABS4N 0
POP y
POP x
ASSERT x == 0x1122334455667772
ASSERT y == 0x99AABBCCDDEEFF03

# S2ABS4N n1: 0xD0 n1=D=-3 → 3 → 0x30
CLEARSTACK
PUSH 0xD0
PUSH 0xE0
S2ABS4N 1
POP y
POP x
ASSERT x == 0x30
ASSERT y == 0x20

# DSEXT4N: 7→7 ; E→-2 ; 8→-8
CLEARSTACK
PUSH 0x7
PUSH 0xE
DSEXT4N 0
POP y
POP x
ASSERT x == 7
ASSERT y == -2

CLEARSTACK
PUSH 0x8
PUSH 0x0
PAIRSEXT4N 0
POP y
POP x
ASSERT x == -8
ASSERT y == 0

# S2SEXT4N n1: 0xA0 n1=A=-6
CLEARSTACK
PUSH 0xA0
PUSH 0xC0
S2SEXT4N 1
POP y
POP x
ASSERT x == -6
ASSERT y == -4

# high ignored: 0xFF → -1
CLEARSTACK
PUSH 0xFF
PUSH 0x1F
DSEXT4N 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# DZEXT4N: extract nibble
CLEARSTACK
PUSH 0xAB
PUSH 0xCD
DZEXT4N 0
POP y
POP x
ASSERT x == 11
ASSERT y == 13

CLEARSTACK
PUSH 0xAB
PUSH 0xCD
PAIRZEXT4N 1
POP y
POP x
ASSERT x == 10
ASSERT y == 12

# STACK2ZEXT4N n2 of 0x123: nibble2=1
CLEARSTACK
PUSH 0x123
PUSH 0x456
STACK2ZEXT4N 2
POP y
POP x
ASSERT x == 1
ASSERT y == 4

# aliases
CLEARSTACK
PUSH 0xC
PUSH 0x9
DIABS4N 0
POP y
POP x
ASSERT x == 4
ASSERT y == 7

CLEARSTACK
PUSH 0xC
PUSH 0x9
DNIBSEXTN 0
POP y
POP x
ASSERT x == -4
ASSERT y == -7

CLEARSTACK
PUSH 0xF0
PUSH 0x0F
DNIBZEXTN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 15

HOLD_FLASH 0
