# Proof 141 — digit-0 depth-5 foundation: 5NIP 5ROT 5RROT 5OVER 5TUCK
HOLD_FLASH 1
SCIENCE LOAD

# 5NIP — a b c d e → a e
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
5NIP
ASSERT SP == 2
ASSERT LAST_N == 5
POP a
POP b
ASSERT b == 1
ASSERT a == 5

# NIP5 alias
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
PUSH 50
NIP5
POP a
POP b
ASSERT b == 10
ASSERT a == 50

# 5ROT — a b c d e → b c d e a
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
5ROT
ASSERT SP == 5
ASSERT LAST_N == 1
POP a
POP b
POP c
POP d
POP e
ASSERT e == 2
ASSERT d == 3
ASSERT c == 4
ASSERT b == 5
ASSERT a == 1

# five 5ROT = identity
CLEARSTACK
PUSH 5
PUSH 6
PUSH 7
PUSH 8
PUSH 9
5ROT
5ROT
5ROT
5ROT
5ROT
POP a
POP b
POP c
POP d
POP e
ASSERT e == 5
ASSERT d == 6
ASSERT c == 7
ASSERT b == 8
ASSERT a == 9

