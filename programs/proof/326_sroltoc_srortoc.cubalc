# Proof 326 — digit-1 stack↔cell rotate: SROLTOC SRORTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SROLTOC: 0x1 <<rot 4 = 0x10 = 16
CELLSET 1 1
PUSH 1
PUSH 4
SROLTOC
ASSERT LAST_N == 16
ASSERT CELL(1) == 16
POP a
ASSERT a == 16

# ROLTOC alias: 0x80 rotl 1 = 0x100 = 256
CELLSET 2 128
PUSH 2
PUSH 1
ROLTOC
ASSERT LAST_N == 256
ASSERT CELL(2) == 256
POP

# rotl 0 leaves value
CELLSET 3 42
PUSH 3
PUSH 0
SCELLROL
ASSERT LAST_N == 42
ASSERT CELL(3) == 42
POP

# SRORTOC: 16 rotr 4 = 1
CELLSET 4 16
PUSH 4
PUSH 4
SRORTOC
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# RORTOC alias: 256 rotr 1 = 128
CELLSET 5 256
PUSH 5
PUSH 1
RORTOC
ASSERT LAST_N == 128
ASSERT CELL(5) == 128
POP

# SCELLROR: 0xF0 rotr 4 = 0x0F = 15 (within low byte path still full 64)
CELLSET 6 240
PUSH 6
PUSH 4
SCELLROR
ASSERT LAST_N == 15
ASSERT CELL(6) == 15
POP

# round-trip: rol 7 then ror 7
CELLSET 7 12345
PUSH 7
PUSH 7
SROLTOC
POP
PUSH 7
PUSH 7
SRORTOC
ASSERT LAST_N == 12345
ASSERT CELL(7) == 12345
POP

# soft fails
CLEARSTACK
SROLTOC
ASSERT OK == 0
SRORTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof326_sroltoc_srortoc" LAST_N SP
HOLD_FLASH 1
