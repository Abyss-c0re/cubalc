# INCLUDE live_boot - agent_boot + live_session one-shot

HOLD_FLASH 1

CLASS Ticket
  FIELD id
  METHOD ping
    LET LAST = "pong"
  END
END
NEW Ticket t1

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_METHODS = ""
DEFAULT NEED_FIELDS = ""
DEFAULT NEED_OBJS = ""
