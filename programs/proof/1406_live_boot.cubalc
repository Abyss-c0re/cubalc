ASSERT OK == 1
ASSERT LIVE_SESSION_OK == 1
HASINCLUDE agent_boot
ASSERT LAST_N == 1
HASINCLUDE live_session
ASSERT LAST_N == 1
HASINCLUDE live_boot
ASSERT LAST_N == 1
HASLIB live_boot
