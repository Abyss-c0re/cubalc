# HASARGANY / NEEDARGANY — multi program-arg any-of gate (HASARGALL twin)

HOLD_FLASH 1

# clear args
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV UNSET CUBALC_CONFIG
SYS ENV SET CUBALC_ARGC "0"

# empty names soft → 0
HASARGANY
ASSERT LAST_N == 0
ASSERT HASARGANY_N == 0

# missing all
HASARGANY 0 1 2
ASSERT LAST_N == 0
ASSERT ARGMISS_N == 3
SYS HASLINE ARGMISS "0"
ASSERT LAST_N == 1
SYS HASLINE ARGMISS "2"
ASSERT LAST_N == 1
ASSERT HASARGANY_N == 0
ASSERT NEEDARGANY_N == 3

# partial hit (any-of succeeds with one)
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARGC "1"
HASARGANY 0 1
ASSERT LAST_N == 1
ASSERT HASARGANY_N == 1
SYS HASLINE ARGHAVE "0"
ASSERT LAST_N == 1
SYS HASLINE ARGMISS "1"
ASSERT LAST_N == 1
ASSERT OK == 1

# all present
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARG1 "b.txt"
SYS ENV SET CUBALC_ARG2 "c.txt"
SYS ENV SET CUBALC_ARGC "3"
HASARGANY 0 1 2
ASSERT LAST_N == 1
ASSERT HASARGANY_N == 3
ASSERT ARGMISS_N == 0
ASSERT OK == 1

# bag / CSV form
HASARGANY "0,1,2"
ASSERT LAST_N == 1

# named env (non-CUBALC_ARG)
SYS ENV SET CUBALC_CONFIG "cfg.json"
HASARGANY 9 CUBALC_CONFIG
ASSERT LAST_N == 1
SYS HASLINE ARGHAVE "CUBALC_CONFIG"
ASSERT LAST_N == 1

# hard twin passes when any present
NEEDARGANY 0 1
ASSERT LAST_N == 1
ASSERT OK == 1

# soft miss sticky ERR
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
HASARGANY 0 1
ASSERT LAST_N == 0
ASSERT OK == 0
SYS HASI "HASARGANY miss"
ASSERT LAST_N == 1

# IF without N× HASARG
SYS ENV SET CUBALC_ARG0 "x"
SYS ENV SET CUBALC_ARGC "1"
HASARGANY 0 1
IF LAST_N == 1
  LET gate "ok"
ELSE
  LET gate "no"
END
SYS EQS gate "ok"
ASSERT LAST_N == 1

# discoverable
HASFORM HASARGANY
ASSERT LAST_N == 1
HASFORM NEEDARGANY
ASSERT LAST_N == 1

PRINT "hasargany ok"
PASS
