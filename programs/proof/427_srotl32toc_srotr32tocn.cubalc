# Proof 427 — digit-0 foundation rotate32 TOC: SROTL32TOC SROTR32TOC SROTL32TOCN SROTR32TOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SROTL32TOC: 0x00000001 rotl 4 → 0x10
CELLSET 1 1
PUSH 1
PUSH 4
SROTL32TOC
ASSERT LAST_N == 16
ASSERT CELL(1) == 16
POP

# ROL32TOC: 0x80000000 rotl 1 → 0x00000001
CELLSET 2 2147483648
PUSH 2
PUSH 1
ROL32TOC
ASSERT LAST_N == 1
ASSERT CELL(2) == 1
POP

# SROTR32TOC: 0x10 rotr 4 → 0x1
CELLSET 3 16
PUSH 3
PUSH 4
SROTR32TOC
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# ROR32TOC: 1 rotr 1 → 0x80000000
CELLSET 4 1
PUSH 4
PUSH 1
ROR32TOC
ASSERT LAST_N == 2147483648
ASSERT CELL(4) == 2147483648
POP

# SROTL32TOCN: imm 8, 0x12 → 0x1200
CELLSET 5 18
PUSH 5
SROTL32TOCN 8
ASSERT LAST_N == 4608
ASSERT CELL(5) == 4608
POP

# SROTR32TOCN: imm 8 back
CELLSET 6 4608
PUSH 6
SROTR32TOCN 8
ASSERT LAST_N == 18
ASSERT CELL(6) == 18
POP

# identity k=0
CELLSET 7 42
PUSH 7
PUSH 0
SROTL32TOC
ASSERT LAST_N == 42
ASSERT CELL(7) == 42
POP

# soft short
CLEARSTACK
SROTL32TOC
ASSERT OK == 0

CLEARSTACK
PUSH 0
SROTR32TOC
ASSERT OK == 0

CLEARSTACK
SROTL32TOCN 1
ASSERT OK == 0

CLEARSTACK
SROTR32TOCN 1
ASSERT OK == 0

HOLD_FLASH 0
