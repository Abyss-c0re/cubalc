# Proof 193 — digit-0 dual-stack overflow: DADDOVF DSUBOVF DMULOVF
HOLD_FLASH 1
SCIENCE LOAD

# DADDOVF no overflow
CLEARSTACK
PUSH 10
PUSH 20
PUSH 3
PUSH 4
DADDOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# max + 1 overflows
CLEARSTACK
LET mx = 9223372036854775807
PUSH mx
PUSH 0
PUSH 1
PUSH 0
2ADDOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# min + (-1) overflows
CLEARSTACK
LET mn = 0 - mx
LET mn = mn - 1
PUSH mn
PUSH 5
PUSH -1
PUSH 1
PAIRADDOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DSUBOVF: min - 1
CLEARSTACK
PUSH mn
PUSH 10
PUSH 1
PUSH 3
DSUBOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# max - (-1)
CLEARSTACK
PUSH mx
PUSH 0
PUSH -1
PUSH 0
2SUBOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# safe sub
CLEARSTACK
PUSH 5
PUSH 5
PUSH 2
PUSH 2
PAIRSUBOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DMULOVF: large * 2
CLEARSTACK
PUSH mx
PUSH 3
PUSH 2
PUSH 1
DMULOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# zero * anything
CLEARSTACK
PUSH 0
PUSH mx
PUSH mx
PUSH 0
2MULOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# safe mul
CLEARSTACK
PUSH 100
PUSH 200
PUSH 3
PUSH 4
PAIRMULOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DADDOVER / DMULOVER aliases
CLEARSTACK
PUSH mx
PUSH mx
PUSH 1
PUSH 1
DADDOVER
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH mx
PUSH 2
PUSH 2
PUSH 2
DMULOVER
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# S2ADDOVF / STACK2MULOVF
CLEARSTACK
PUSH 1
PUSH 1
PUSH 1
PUSH 1
S2ADDOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 2
PUSH 2
PUSH 2
STACK2MULOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fail
CLEARSTACK
PUSH 1
PUSH 2
DADDOVF
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DMULOVF
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof193_daddovf_dmulovf" LAST_N SP
