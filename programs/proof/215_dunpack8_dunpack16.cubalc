# Proof 215 — digit-4 dual-stack control-word unpack: DUNPACK8 DUNPACK16
HOLD_FLASH 1
SCIENCE LOAD

# DUNPACK8 inverse of DPACK8
CLEARSTACK
PUSH 0x12
PUSH 0x34
PUSH 0x56
PUSH 0x78
DPACK8
POP y
POP x
ASSERT x == 0x1256
ASSERT y == 0x3478

CLEARSTACK
PUSH 0x1256
PUSH 0x3478
DUNPACK8
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0x12
ASSERT hb == 0x34
ASSERT la == 0x56
ASSERT lb == 0x78

# round-trip 2UNPACK8 / DPACK8
CLEARSTACK
PUSH 0xABCD
PUSH 0xEF01
2UNPACK8
DPACK8
POP y
POP x
ASSERT x == 0xABCD
ASSERT y == 0xEF01

# PAIRUNPACK8 / DBYTSPLIT
CLEARSTACK
PUSH 0xFF00
PUSH 0x00FF
PAIRUNPACK8
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0xFF
ASSERT hb == 0
ASSERT la == 0
ASSERT lb == 0xFF

CLEARSTACK
PUSH 0x0A0B
PUSH 0x0C0D
DBYTSPLIT
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0x0A
ASSERT hb == 0x0C
ASSERT la == 0x0B
ASSERT lb == 0x0D

# DUNPACK16 inverse of DPACK16
CLEARSTACK
PUSH 0x1111
PUSH 0x2222
PUSH 0x3333
PUSH 0x4444
DPACK16
POP y
POP x
ASSERT x == 0x11113333
ASSERT y == 0x22224444

CLEARSTACK
PUSH 0x11113333
PUSH 0x22224444
DUNPACK16
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0x1111
ASSERT hb == 0x2222
ASSERT la == 0x3333
ASSERT lb == 0x4444

# round-trip 2UNPACK16
CLEARSTACK
PUSH 0xAAAABBBB
PUSH 0xCCCCDDDD
2UNPACK16
DPACK16
POP y
POP x
ASSERT x == 0xAAAABBBB
ASSERT y == 0xCCCCDDDD

# PAIRUNPACK16 / DHALFSPLIT / DUNPACKW
CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x0000FFFF
PAIRUNPACK16
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0xFFFF
ASSERT hb == 0
ASSERT la == 0
ASSERT lb == 0xFFFF

CLEARSTACK
PUSH 0x12345678
PUSH 0x9ABCDEF0
DHALFSPLIT
POP lb
POP la
POP hb
POP ha
ASSERT ha == 0x1234
ASSERT hb == 0x9ABC
ASSERT la == 0x5678
ASSERT lb == 0xDEF0

CLEARSTACK
PUSH 0x00010002
PUSH 0x00030004
DUNPACKW
POP lb
POP la
POP hb
POP ha
ASSERT ha == 1
ASSERT hb == 3
ASSERT la == 2
ASSERT lb == 4
