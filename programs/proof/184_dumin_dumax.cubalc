# Proof 184 — digit-7 dual-stack unsigned min/max: DUMIN DUMAX
HOLD_FLASH 1
SCIENCE LOAD

# DUMIN: a b c d → umin(a,c) umin(b,d)
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 4
DUMIN
POP y
POP x
ASSERT x == 3
ASSERT y == 4

# 2UMIN alias
CLEARSTACK
PUSH 10
PUSH 20
PUSH 7
PUSH 25
2UMIN
POP y
POP x
ASSERT x == 7
ASSERT y == 20

# PAIRUMIN
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
PUSH 2
PAIRUMIN
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# DUMAX
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 4
DUMAX
POP y
POP x
ASSERT x == 5
ASSERT y == 9

# 2UMAX
CLEARSTACK
PUSH 10
PUSH 20
PUSH 7
PUSH 25
2UMAX
POP y
POP x
ASSERT x == 10
ASSERT y == 25

# PAIRUMAX
CLEARSTACK
PUSH 8
PUSH 1
PUSH 8
PUSH 1
PAIRUMAX
POP y
POP x
ASSERT x == 8
ASSERT y == 1

# unsigned: -1 is max; umin(-1,5)→5; umax(-1,5)→-1
CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DUMIN
POP y
POP x
ASSERT x == 5
ASSERT y == 5

CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DUMAX
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# high bit vs positive
CLEARSTACK
PUSH -2
PUSH 100
PUSH 0
PUSH 50
DUMIN
POP y
POP x
ASSERT x == 0
ASSERT y == 50

CLEARSTACK
PUSH -2
PUSH 100
PUSH 0
PUSH 50
DUMAX
POP y
POP x
ASSERT x == -2
ASSERT y == 100

# equal pairs
CLEARSTACK
PUSH 7
PUSH 7
PUSH 7
PUSH 7
DUMIN
POP y
POP x
ASSERT x == 7
ASSERT y == 7

CLEARSTACK
PUSH 7
PUSH 7
PUSH 7
PUSH 7
DUMAX
POP y
POP x
ASSERT x == 7
ASSERT y == 7

# S2UMIN / STACK2UMAX aliases
CLEARSTACK
PUSH 4
PUSH 8
PUSH 9
PUSH 2
S2UMIN
POP y
POP x
ASSERT x == 4
ASSERT y == 2

CLEARSTACK
PUSH 4
PUSH 8
PUSH 9
PUSH 2
STACK2UMAX
POP y
POP x
ASSERT x == 9
ASSERT y == 8

# soft fail underflow
CLEARSTACK
PUSH 1
DUMIN
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DUMAX
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof184_dumin_dumax" LAST_N SP
