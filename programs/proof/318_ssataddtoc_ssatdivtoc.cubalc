# Proof 318 — digit-6 forward sat stack↔cell: SSATADDTOC SSATSUBTOC SSATDIVTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSATADDTOC
CELLSET 1 10
PUSH 1
PUSH 5
SSATADDTOC
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP a
ASSERT a == 15

# SCELLSATADD alias
CELLSET 2 3
PUSH 2
PUSH 7
SCELLSATADD
ASSERT LAST_N == 10
ASSERT CELL(2) == 10
POP

# SSATSUBTOC
CELLSET 3 20
PUSH 3
PUSH 6
SSATSUBTOC
ASSERT LAST_N == 14
ASSERT CELL(3) == 14
POP

# SATSUBTOC alias
CELLSET 4 5
PUSH 4
PUSH 8
SATSUBTOC
ASSERT LAST_N == -3
ASSERT CELL(4) == -3
POP

# SSATDIVTOC
CELLSET 5 100
PUSH 5
PUSH 4
SSATDIVTOC
ASSERT LAST_N == 25
ASSERT CELL(5) == 25
POP

# /0 → 0
CELLSET 6 9
PUSH 6
PUSH 0
SCELLSATDIV
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# soft fails
CLEARSTACK
SSATADDTOC
ASSERT OK == 0
SSATSUBTOC
ASSERT OK == 0
SSATDIVTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof318_ssataddtoc_ssatdivtoc" LAST_N SP
HOLD_FLASH 1
