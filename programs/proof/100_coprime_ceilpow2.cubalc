# Proof 100 — digit-2 math: COPRIME + CEILPOW2 + SEGCD
HOLD_FLASH 1
SCIENCE LOAD

# COPRIME expr
ASSERT COPRIME(14, 15) == 1
ASSERT COPRIME(14, 21) == 0
ASSERT ISCOPRIME(1, 99) == 1
ASSERT COPRIME(0, 1) == 1
ASSERT COPRIME(0, 0) == 0
ASSERT COPRIME(-8, 9) == 1

# CEILPOW2 expr
ASSERT CEILPOW2(1) == 1
ASSERT CEILPOW2(2) == 2
ASSERT CEILPOW2(3) == 4
ASSERT NEXTPOW2(5) == 8
ASSERT CEILPOW2(8) == 8
ASSERT CEILPOW2(0) == 0
ASSERT CEILPOW2(-3) == 0
ASSERT CPOW2(17) == 32

# stack SCOPRIME
CLEARSTACK
PUSH 9
PUSH 28
SCOPRIME
ASSERT LAST_N == 1
POP c0
ASSERT c0 == 1
PUSH 12
PUSH 18
SISCOPRIME
ASSERT LAST_N == 0

# stack SCEILPOW2
CLEARSTACK
PUSH 13
SCEILPOW2
ASSERT LAST_N == 16
POP p
ASSERT p == 16
PUSH 16
SNEXTPOW2
ASSERT LAST_N == 16

# SEGCD: 240 46 → g=2, 240*x + 46*y = 2
CLEARSTACK
PUSH 240
PUSH 46
SEGCD
ASSERT SP == 3
POP y
POP x
POP g
ASSERT g == 2
# verify Bézout: 240*x + 46*y == 2
LET check = 240 * x + 46 * y
ASSERT check == 2

# SEGCD trivial
CLEARSTACK
PUSH 7
PUSH 0
SXGCD
POP y2
POP x2
POP g2
ASSERT g2 == 7
ASSERT x2 == 1
ASSERT y2 == 0

# energy
CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof100_coprime_ceilpow2" LAST_N SP
