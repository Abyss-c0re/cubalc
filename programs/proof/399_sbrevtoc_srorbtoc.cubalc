# Proof 399 — digit-8 stack dual low-n reverse/rotate TOC: SBREVTOC SROLBTOC SRORBTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SBREVTOC: reverse low-4 of 0b1101=13 → 0b1011=11
CELLSET 1 13
PUSH 1
PUSH 4
SBREVTOC
ASSERT LAST_N == 11
ASSERT CELL(1) == 11
POP a
ASSERT a == 11

# BREVTOC n=0: no-op leave 7
CELLSET 2 7
PUSH 2
PUSH 0
BREVTOC
ASSERT LAST_N == 7
ASSERT CELL(2) == 7
POP

# SROLBTOC: rotl-1 low-4 of 0b1001=9 → 0b0011=3
CELLSET 3 9
PUSH 3
PUSH 4
SROLBTOC
ASSERT LAST_N == 3
ASSERT CELL(3) == 3
POP

# ROLBTOC n=1: width 1 is no-op (n < 2)
CELLSET 4 5
PUSH 4
PUSH 1
ROLBTOC
ASSERT LAST_N == 5
ASSERT CELL(4) == 5
POP

# SRORBTOC: rotr-1 low-4 of 0b1001=9 → 0b1100=12
CELLSET 5 9
PUSH 5
PUSH 4
SRORBTOC
ASSERT LAST_N == 12
ASSERT CELL(5) == 12
POP

# RORBTOC high kept: 0x10|0x9=25, rotr low-4 → 0x10|12=28
CELLSET 6 25
PUSH 6
PUSH 4
RORBTOC
ASSERT LAST_N == 28
ASSERT CELL(6) == 28
POP

# soft short stack OK=0
CLEARSTACK
SBREVTOC
ASSERT OK == 0
PUSH 1
SROLBTOC
ASSERT OK == 0

PRINT "399_sbrevtoc_srorbtoc OK"
