# Proof 564 — digit-0 stack+dual field signed GT0 8/4: S0GT8N S0GT4N D0GT8N D0GT4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0GT8N: 0 → 0
PUSH 0x0
S0GT8N 0
POP x
ASSERT x == 0

# positive → 1
CLEARSTACK
PUSH 0x5
SGT08N 0
POP x
ASSERT x == 1

# -1=0xFF → 0
CLEARSTACK
PUSH 0xFF
SPOSZ8N 0
POP x
ASSERT x == 0

# INT8_MIN=0x80 → 0
CLEARSTACK
PUSH 0x80
SISPOS8N 0
POP x
ASSERT x == 0

# high preserve: low +3 → 1
CLEARSTACK
PUSH 0xAA03
S0GT8N 0
POP x
ASSERT x == 0xAA01

# high preserve: low -2 → 0
CLEARSTACK
PUSH 0xAAFE
S0GT8N 0
POP x
ASSERT x == 0xAA00

# STACK0GT8N n1: high positive → 1
CLEARSTACK
PUSH 0x0200
STACK0GT8N 1
POP x
ASSERT x == 0x0100

# high negative → 0
CLEARSTACK
PUSH 0xFE03
STACK0GT8N 1
POP x
ASSERT x == 0x0003

# S0GT4N: 0 → 0
CLEARSTACK
PUSH 0x0
S0GT4N 0
POP x
ASSERT x == 0

# positive → 1
CLEARSTACK
PUSH 0x3
SGT04N 0
POP x
ASSERT x == 1

# -1=0xF → 0
CLEARSTACK
PUSH 0xF
SPOSZ4N 0
POP x
ASSERT x == 0

# INT4_MIN=0x8 → 0
CLEARSTACK
PUSH 0x8
SISPOS4N 0
POP x
ASSERT x == 0

# high nibble preserve: low positive → 1
CLEARSTACK
PUSH 0x13
S0GT4N 0
POP x
ASSERT x == 0x11

# high positive: n1 of 0x20 → 1
CLEARSTACK
PUSH 0x20
STACK0GT4N 1
POP x
ASSERT x == 0x10

# high negative: n1 of 0xD0 → 0
CLEARSTACK
PUSH 0xD0
STACK0GT4N 1
POP x
ASSERT x == 0x00

# D0GT8N
CLEARSTACK
PUSH 0x5
PUSH 0xFE
D0GT8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0GT8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK20GT8N n1
CLEARSTACK
PUSH 0x0300
PUSH 0xFD00
STACK20GT8N 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

# D0GT4N
CLEARSTACK
PUSH 0x3
PUSH 0xE
D0GT4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0x0
PUSH 0x2
PAIR0GT4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK20GT4N n1
CLEARSTACK
PUSH 0x30
PUSH 0xD0
STACK20GT4N 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x00

HOLD_FLASH 0
