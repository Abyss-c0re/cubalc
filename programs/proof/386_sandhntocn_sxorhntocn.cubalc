# Proof 386 — digit-4 imm high-n mask TOC: SANDHNTOCN SORHNTOCN SXORHNTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# all-ones via SORMNTOCN 64
CELLSET 1 0
PUSH 1
SORMNTOCN 64
POP
# SANDHNTOCN: keep high 4 of all-ones → non-zero high nibble
PUSH 1
SANDHNTOCN 4
ASSERT LAST_N < 0
ASSERT CELL(1) < 0
POP a
ASSERT a < 0

# ANDHNTOCN n=0 → 0
CELLSET 2 99
PUSH 2
ANDHNTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SORHNTOCN: set high 1 bit of 0 → MSB only (signed negative)
CELLSET 3 0
PUSH 3
SORHNTOCN 1
ASSERT LAST_N < 0
ASSERT CELL(3) < 0
POP

# ORHNTOCN n=0: no-op leave 7
CELLSET 4 7
PUSH 4
ORHNTOCN 0
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
POP

# SXORHNTOCN: 0 ^ high-2 → two high bits; toggle again → 0
CELLSET 5 0
PUSH 5
SXORHNTOCN 2
ASSERT LAST_N < 0
ASSERT CELL(5) < 0
POP
PUSH 5
XORHNTOCN 2
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft empty OK=0
CLEARSTACK
SANDHNTOCN 3
ASSERT OK == 0

PRINT "386_sandhntocn_sxorhntocn OK"
