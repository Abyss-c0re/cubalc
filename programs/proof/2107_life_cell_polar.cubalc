// 2107_life_cell_polar.cubalc
// Proof 2107: life_cell polar — apical-basal polarity after SEAL.
// Pay n ATP Par3/aPKC/Crumbs trafficking -> heat +n + setpoint +n (polarized homeostat);
// age/energy/pmf/reserve/thr held; ready recomputed. Distinct from seal (thr+ sp held),
// restit (age- thr held), resolve (thr-), fortify (thr+ no heat), set_setpoint (no ATP/heat).
// Continuum after seal. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 12 0
ENTITY poor OF Cell 1 20 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 10 0
ENTITY twin OF Cell 1 12 0
ENTITY mac OF Cell 1 14 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND mac set_threshold 10

SEND gate pulse 5
SEND gate photosynth 5
SEND gate glycolyse 4
SEND gate pump 5
GETF gate age
ASSERT LAST_N == 5 "polar a5"
GETF gate atp
ASSERT LAST_N == 4 "polar atp4"
GETF gate heat
ASSERT LAST_N == 0 "polar h0"
GETF gate pmf
ASSERT LAST_N == 5 "polar pmf5"
GETF gate energy
LET e0 = LAST_N
ASSERT e0 >= 2 "polar energy primed"
GETF gate reserve
LET r0 = LAST_N
GETF gate age
LET a0 = LAST_N
GETF gate atp
LET at0 = LAST_N
GETF gate heat
LET h0 = LAST_N
GETF gate pmf
LET p0 = LAST_N
GETF gate threshold
LET t0 = LAST_N
ASSERT t0 == 10 "polar thr10"
GETF gate setpoint
LET s0 = LAST_N
ASSERT s0 == 10 "polar sp10"

SEND gate polar 2
ASSERT LAST_N == 2 "polar take2"
GETF gate atp
ASSERT LAST_N == at0 - 2 "polar atp-2"
GETF gate age
ASSERT LAST_N == a0 "polar age held"
GETF gate heat
ASSERT LAST_N == h0 + 2 "polar heat+2"
GETF gate energy
ASSERT LAST_N == e0 "polar e held"
GETF gate reserve
ASSERT LAST_N == r0 "polar r held"
GETF gate threshold
ASSERT LAST_N == t0 "polar thr held"
GETF gate setpoint
ASSERT LAST_N == s0 + 2 "polar sp+2"
GETF gate pmf
ASSERT LAST_N == p0 "polar pmf held"
GETF gate alive
ASSERT LAST_N == 1 "polar lives"
GETF gate energy
LET eg = LAST_N
GETF gate threshold
LET tg = LAST_N
GETF gate ready
LET rd = LAST_N
IF eg >= tg THEN
  ASSERT rd == 1 "polar ready if surplus"
ELSE
  ASSERT rd == 0 "polar ready blocked"
END


// Partial take when ATP short
SEND poor pulse 2
SEND poor photosynth 1
SEND poor glycolyse 1
SEND poor pump 1
GETF poor atp
LET pat = LAST_N
ASSERT pat >= 1 "poor atp"
ASSERT pat < 5 "poor atp low"
GETF poor heat
LET ph0 = LAST_N
GETF poor setpoint
LET ps0 = LAST_N
GETF poor threshold
LET pt0 = LAST_N
GETF poor age
LET pa0 = LAST_N
SEND poor polar 9
LET ptake = LAST_N
ASSERT ptake == pat "poor take all"
ASSERT ptake >= 1 "poor took"
GETF poor atp
ASSERT LAST_N == 0 "poor atp0"
GETF poor heat
ASSERT LAST_N == ph0 + ptake "poor heat+"
GETF poor setpoint
ASSERT LAST_N == ps0 + ptake "poor sp+"
GETF poor threshold
ASSERT LAST_N == pt0 "poor thr held"
GETF poor age
ASSERT LAST_N == pa0 "poor age held"

// Dead / n<1 fail-closed
SEND dead polar 3
ASSERT LAST_N == 0 "dead polar0"
SEND gate polar 0
ASSERT LAST_N == 0 "n0 polar0"
SEND gate polar -1
ASSERT LAST_N == 0 "neg polar0"

// Empty ATP fail-closed
SEND twin pulse 1
SEND twin photosynth 1
SEND twin glycolyse 1
SEND twin pump 1
GETF twin atp
LET ta = LAST_N
IF ta >= 1 THEN
  SEND twin seal ta
END
GETF twin atp
ASSERT LAST_N == 0 "twin atp0"
GETF twin setpoint
LET ts0 = LAST_N
GETF twin heat
LET th0 = LAST_N
SEND twin polar 2
ASSERT LAST_N == 0 "empty polar0"
GETF twin setpoint
ASSERT LAST_N == ts0 "empty sp held"
GETF twin heat
ASSERT LAST_N == th0 "empty heat held"

// G0: polar works, ready forced 0
SEND g0 pulse 3
SEND g0 photosynth 3
SEND g0 glycolyse 3
SEND g0 pump 2
SEND g0 quiesce
GETF g0 atp
LET ga0 = LAST_N
ASSERT ga0 >= 2 "g0 atp"
GETF g0 setpoint
LET gs0 = LAST_N
GETF g0 heat
LET gh0 = LAST_N
GETF g0 threshold
LET gt0 = LAST_N
SEND g0 polar 2
ASSERT LAST_N == 2 "g0 take2"
GETF g0 ready
ASSERT LAST_N == 0 "g0 ready0"
GETF g0 setpoint
ASSERT LAST_N == gs0 + 2 "g0 sp+2"
GETF g0 heat
ASSERT LAST_N == gh0 + 2 "g0 heat+2"
GETF g0 threshold
ASSERT LAST_N == gt0 "g0 thr held"
GETF g0 atp
ASSERT LAST_N == ga0 - 2 "g0 atp-2"

// Distinct from seal: polar sp+, seal thr+
SEND mac pulse 4
SEND mac photosynth 4
SEND mac glycolyse 4
SEND mac pump 3
SEND mac set_threshold 10
SEND mac set_setpoint 10
GETF mac atp
LET ma0 = LAST_N
ASSERT ma0 >= 4 "mac atp"
GETF mac threshold
LET mt0 = LAST_N
GETF mac setpoint
LET ms0 = LAST_N
GETF mac heat
LET mh0 = LAST_N
GETF mac age
LET mag0 = LAST_N
SEND mac seal 1
ASSERT LAST_N == 1 "dist seal1"
GETF mac threshold
ASSERT LAST_N == mt0 + 1 "dist thr+seal"
GETF mac setpoint
ASSERT LAST_N == ms0 "dist sp held seal"
GETF mac heat
ASSERT LAST_N == mh0 + 1 "dist heat+seal"
GETF mac threshold
LET mt1 = LAST_N
GETF mac setpoint
LET ms1 = LAST_N
GETF mac heat
LET mh1 = LAST_N
GETF mac age
LET mag1 = LAST_N
GETF mac atp
LET ma1 = LAST_N
SEND mac polar 1
ASSERT LAST_N == 1 "dist polar1"
GETF mac setpoint
ASSERT LAST_N == ms1 + 1 "dist sp+polar"
GETF mac threshold
ASSERT LAST_N == mt1 "dist thr held polar"
GETF mac age
ASSERT LAST_N == mag1 "dist age held polar"
GETF mac heat
ASSERT LAST_N == mh1 + 1 "dist heat+polar"
GETF mac atp
ASSERT LAST_N == ma1 - 1 "dist atp-1"


// Distinct from fortify: polar pairs heat+sp+, fortify thr+ no heat
SEND gate photophos 4
GETF gate atp
LET fa0 = LAST_N
ASSERT fa0 >= 2 "fdist atp"
GETF gate threshold
LET ft0 = LAST_N
GETF gate setpoint
LET fs0 = LAST_N
GETF gate heat
LET fh0 = LAST_N
SEND gate fortify 1
ASSERT LAST_N == 1 "fdist fortify1"
GETF gate threshold
ASSERT LAST_N == ft0 + 1 "fdist thr+fort"
GETF gate heat
ASSERT LAST_N == fh0 "fdist heat held fort"
GETF gate setpoint
ASSERT LAST_N == fs0 "fdist sp held fort"
GETF gate threshold
LET ft1 = LAST_N
GETF gate setpoint
LET fs1 = LAST_N
GETF gate heat
LET fh1 = LAST_N
GETF gate atp
LET fa1 = LAST_N
SEND gate polar 1
ASSERT LAST_N == 1 "fdist polar1"
GETF gate setpoint
ASSERT LAST_N == fs1 + 1 "fdist sp+polar"
GETF gate threshold
ASSERT LAST_N == ft1 "fdist thr held polar"
GETF gate heat
ASSERT LAST_N == fh1 + 1 "fdist heat+polar"

// Continuum seal then polar
SEND gate set_threshold 12
SEND gate set_setpoint 10
SEND gate photophos 6
GETF gate atp
LET ca0 = LAST_N
ASSERT ca0 >= 4 "cont atp"
GETF gate threshold
LET ct0 = LAST_N
GETF gate setpoint
LET cs0 = LAST_N
GETF gate heat
LET ch0 = LAST_N
GETF gate age
LET cag0 = LAST_N
GETF gate energy
LET ce0 = LAST_N
GETF gate pmf
LET cp0 = LAST_N
GETF gate reserve
LET cr0 = LAST_N
SEND gate seal 1
ASSERT LAST_N == 1 "cont seal1"
GETF gate threshold
ASSERT LAST_N == ct0 + 1 "cont thr+seal"
GETF gate setpoint
ASSERT LAST_N == cs0 "cont sp held after seal"
SEND gate polar 2
ASSERT LAST_N == 2 "cont polar2"
GETF gate setpoint
ASSERT LAST_N == cs0 + 2 "cont sp+2"
GETF gate threshold
ASSERT LAST_N == ct0 + 1 "cont thr still +1"
GETF gate heat
ASSERT LAST_N == ch0 + 1 + 2 "cont heat+3"
GETF gate age
ASSERT LAST_N == cag0 "cont age held"
GETF gate energy
ASSERT LAST_N == ce0 "cont e held"
GETF gate pmf
ASSERT LAST_N == cp0 "cont pmf held"
GETF gate reserve
ASSERT LAST_N == cr0 "cont r held"
GETF gate atp
ASSERT LAST_N == ca0 - 3 "cont atp-3"

// Ceiling 1000 on setpoint
SEND gate set_setpoint 998
SEND gate photophos 8
GETF gate atp
LET za0 = LAST_N
ASSERT za0 >= 5 "ceil atp2"
GETF gate heat
LET zh0 = LAST_N
SEND gate polar 5
LET ztake = LAST_N
ASSERT ztake >= 1 "ceil take"
GETF gate setpoint
LET zs1 = LAST_N
ASSERT zs1 == 1000 "ceil sp1000"
GETF gate heat
ASSERT LAST_N == zh0 + ztake "ceil heat+"
GETF gate atp
LET za1 = LAST_N
ASSERT za1 >= 1 "ceil2 atp"
GETF gate heat
LET zh1 = LAST_N
SEND gate polar 3
LET ztake2 = LAST_N
ASSERT ztake2 >= 1 "ceil2 take"
GETF gate setpoint
ASSERT LAST_N == 1000 "ceil2 sp1000"
GETF gate heat
ASSERT LAST_N == zh1 + ztake2 "ceil2 heat+"

// set_setpoint distinct: no ATP/heat
GETF gate atp
LET sa0 = LAST_N
GETF gate heat
LET sh0 = LAST_N
SEND gate set_setpoint 15
ASSERT LAST_N == 15 "ss sp15"
GETF gate atp
ASSERT LAST_N == sa0 "ss atp held"
GETF gate heat
ASSERT LAST_N == sh0 "ss heat held"
GETF gate setpoint
ASSERT LAST_N == 15 "ss sp read"

// vitality still alive after polar
SEND gate vitality
ASSERT LAST_N >= 1 "vital"
