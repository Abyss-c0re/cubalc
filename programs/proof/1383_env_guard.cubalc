# INCLUDE env_guard — multi host-env ALL + ANY contract (cli_guard twin for env)

HOLD_FLASH 1

# --- skip both gates when defaults empty ---
SYS ENV UNSET CUBALC_EG_A
SYS ENV UNSET CUBALC_EG_B
SYS ENV UNSET CUBALC_EG_X
SYS ENV UNSET CUBALC_EG_Y
DEFAULT NEED_ENVS = ""
DEFAULT NEED_ENV_ANY = ""
DEFAULT ENV_GUARD_SOFT = 0
INCLUDE env_guard
ASSERT ENV_GUARD_OK == 1
ASSERT ENV_GUARD_ALL_OK == 1
ASSERT ENV_GUARD_ANY_OK == 1

# --- soft ALL miss ---
LET NEED_ENVS = "CUBALC_EG_A\nCUBALC_EG_B"
LET NEED_ENV_ANY = ""
LET ENV_GUARD_SOFT = 1
INCLUDE env_guard
ASSERT ENV_GUARD_OK == 0
ASSERT ENV_GUARD_ALL_OK == 0
ASSERT ENVMISS_N >= 1
SYS HASLINE ENVMISS "CUBALC_EG_A"
ASSERT LAST_N == 1

# --- soft ALL hit ---
SYS ENV SET CUBALC_EG_A "1"
SYS ENV SET CUBALC_EG_B "2"
LET NEED_ENVS = "CUBALC_EG_A\nCUBALC_EG_B"
LET ENV_GUARD_SOFT = 1
INCLUDE env_guard
ASSERT ENV_GUARD_ALL_OK == 1
ASSERT ENV_GUARD_OK == 1

# --- soft ANY miss ---
LET NEED_ENVS = ""
LET NEED_ENV_ANY = "CUBALC_EG_X\nCUBALC_EG_Y"
LET ENV_GUARD_SOFT = 1
INCLUDE env_guard
ASSERT ENV_GUARD_ANY_OK == 0
ASSERT ENV_GUARD_OK == 0
ASSERT ENVMISS_N >= 1

# --- soft ANY hit with one ---
SYS ENV SET CUBALC_EG_X "x"
LET NEED_ENV_ANY = "CUBALC_EG_X\nCUBALC_EG_Y"
LET ENV_GUARD_SOFT = 1
INCLUDE env_guard
ASSERT ENV_GUARD_ANY_OK == 1
ASSERT ENV_GUARD_OK == 1
SYS HASLINE ENVHAVE "CUBALC_EG_X"
ASSERT LAST_N == 1

# --- hard ALL path (must pass) ---
SYS ENV SET CUBALC_EG_A "a"
SYS ENV SET CUBALC_EG_B "b"
LET NEED_ENVS = "CUBALC_EG_A\nCUBALC_EG_B"
LET NEED_ENV_ANY = ""
LET ENV_GUARD_SOFT = 0
INCLUDE env_guard
ASSERT ENV_GUARD_OK == 1

# --- hard ANY path ---
SYS ENV SET CUBALC_EG_X "x"
LET NEED_ENVS = ""
LET NEED_ENV_ANY = "CUBALC_EG_X\nCUBALC_EG_Y"
LET ENV_GUARD_SOFT = 0
INCLUDE env_guard
ASSERT ENV_GUARD_ANY_OK == 1
ASSERT ENV_GUARD_OK == 1

# --- combined ALL + ANY soft ---
SYS ENV SET CUBALC_EG_A "1"
SYS ENV SET CUBALC_EG_B "2"
SYS ENV SET CUBALC_EG_X "x"
LET NEED_ENVS = "CUBALC_EG_A\nCUBALC_EG_B"
LET NEED_ENV_ANY = "CUBALC_EG_X\nCUBALC_EG_Y"
LET ENV_GUARD_SOFT = 1
INCLUDE env_guard
ASSERT ENV_GUARD_ALL_OK == 1
ASSERT ENV_GUARD_ANY_OK == 1
ASSERT ENV_GUARD_OK == 1

# discoverable
HASFORM HASENVALL
ASSERT LAST_N == 1
HASFORM HASENVANY
ASSERT LAST_N == 1
HASLIB env_guard
ASSERT LAST_N == 1

SYS ENV UNSET CUBALC_EG_A
SYS ENV UNSET CUBALC_EG_B
SYS ENV UNSET CUBALC_EG_X
SYS ENV UNSET CUBALC_EG_Y

PRINT "1383_env_guard ok"
PASS
