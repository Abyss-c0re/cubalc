REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_CETP — CETP cholesteryl ester transfer protein CE-shuttle after LCAT on sterol continuum
# Continuum ...->dhcr7->dhcr24->soat1->nceh1->abca1->abcg1->lcat->cetp (CETP after LCAT)
# Gift: CETP shuttles LCAT-packed cholesteryl ester from HDL onto apoB acceptors under ASSERT so RCT free energy redistributes without hollow HDL-only CE trap.
# Domain: post-LCAT plasma lipoprotein CE-transfer / apoB remodeling CETP ward.
# Science: CETP prefers LCAT-matured CE-rich HDL cores (vs LCAT acyl packing alone);
#   heteroexchange CE out / TG in moves sterol-ester free energy onto VLDL/LDL after LCAT matures HDL.
# Cube is SoT. Free energy must flow. Not a dual ladder. Not a rename of LCAT.

ENTITY er OF Cell 1 46 0
ENTITY drop OF Cell 1 30 0
ENTITY ash OF Cell 0 16 0
ENTITY starve OF Cell 1 0 0
ENTITY nest OF Cell 1 50 0

SEND er set_threshold 11
SEND drop set_threshold 13
SEND nest set_threshold 9
SEND starve set_threshold 11

# CETP CE-shuttle prelude (unique early divergence vs LCAT CE-core proof)
SEND er photosynth 20
SEND er charge 18
SEND er feed 15
SEND er pump 12
GETF er energy
ASSERT LAST_N >= 15 "er CETP-prelude energy"
GETF er atp
ASSERT LAST_N >= 15 "er CETP-prelude atp"
GETF er pmf
ASSERT LAST_N >= 4 "er CETP-prelude pmf"
SEND drop photosynth 12
SEND drop charge 10
SEND drop feed 8
GETF drop alive
ASSERT LAST_N == 1 "drop CETP partner primed"
SEND nest photosynth 12
SEND nest charge 10
SEND nest feed 8
GETF nest alive
ASSERT LAST_N == 1 "nest CETP partner primed"
SEND er glycolyse 8
SEND er photophos 6
GETF er heat
ASSERT LAST_N >= 0 "er heat nonneg prelude"


SEND er pulse 5
SEND er photosynth 42
SEND er glycolyse 34
SEND er pump 26
SEND er photophos 24
SEND er charge 38
SEND er feed 36
GETF er age
ASSERT LAST_N == 5 "er age5"
GETF er atp
ASSERT LAST_N >= 18 "er atp"
GETF er energy
ASSERT LAST_N >= 18 "er energy"
GETF er pmf
ASSERT LAST_N >= 4 "er pmf"

