ASSERT LAST_N == 1 "drop CE-shuttle partner alive"
GETF nest energy
ASSERT LAST_N >= 0 "nest energy nonneg after CE-transfer"

# Distinctive CETP CE-shuttle board (unique vs LCAT CE-core packing ward)
SEND er photosynth 16
SEND er charge 14
SEND er feed 12
SEND er soat1 1
ASSERT LAST_N == 1 "er soat1 pack before CETP CE-shuttle board"
SEND er photosynth 8
SEND er charge 8
SEND er feed 6
SEND er nceh1 1
ASSERT LAST_N == 1 "er nceh1 liberate before CETP CE-shuttle board"
SEND er photosynth 8
SEND er charge 8
SEND er feed 6
SEND er abca1 1
ASSERT LAST_N == 1 "er abca1 seed nascent HDL before CETP path"
SEND er photosynth 8
SEND er charge 8
SEND er feed 6
SEND er abcg1 1
ASSERT LAST_N == 1 "er abcg1 load before CETP distinctive"
SEND er photosynth 8
SEND er charge 8
SEND er feed 6
SEND er lcat 1
ASSERT LAST_N == 1 "er lcat CE-core before CETP distinctive"
GETF er heat
LET g_h = LAST_N
GETF er energy
LET g_e = LAST_N
GETF er atp
LET g_a = LAST_N
GETF er age
LET g_age = LAST_N
GETF er pcr
LET g_pcr = LAST_N
GETF er reserve
LET g_rsv = LAST_N
GETF er pmf
LET g_pmf = LAST_N
GETF er threshold
LET g_thr = LAST_N
SEND er cetp 3
ASSERT LAST_N == 3 "er cetp CE-shuttle load-3"
GETF er heat
ASSERT LAST_N == g_h + 3 "er cetp heat+3"
GETF er energy
ASSERT LAST_N == g_e - 3 "er cetp energy-3"
GETF er atp
ASSERT LAST_N == g_a - 3 "er cetp atp-3"
GETF er age
ASSERT LAST_N == g_age "er cetp age held"
GETF er pcr
ASSERT LAST_N == g_pcr "er cetp pcr held"
GETF er reserve
ASSERT LAST_N == g_rsv "er cetp reserve held"
GETF er pmf
ASSERT LAST_N == g_pmf "er cetp pmf held"
GETF er threshold
ASSERT LAST_N == g_thr "er cetp thr held"
GETF er alive
ASSERT LAST_N == 1 "er alive post CETP CE-core"

# drop partner CETP CE packing
SEND drop photosynth 14
SEND drop charge 12
SEND drop feed 10
SEND drop abca1 1
ASSERT LAST_N == 1 "drop abca1 seed before CETP"
SEND drop photosynth 8
SEND drop charge 8
SEND drop feed 6
SEND drop abcg1 1
SEND drop photosynth 8
SEND drop charge 8
SEND drop feed 6
SEND drop lcat 1
ASSERT LAST_N == 1 "drop lcat CE-core before CETP shuttle"
ASSERT LAST_N == 1 "drop abcg1 load before CETP"
GETF drop heat
LET dg_h = LAST_N
GETF drop energy
LET dg_e = LAST_N
GETF drop atp
LET dg_a = LAST_N
SEND drop cetp 2
ASSERT LAST_N == 2 "drop cetp CE-shuttle load-2"
GETF drop heat
ASSERT LAST_N == dg_h + 2 "drop cetp heat+2"
GETF drop energy
ASSERT LAST_N == dg_e - 2 "drop cetp energy-2"
GETF drop atp
ASSERT LAST_N == dg_a - 2 "drop cetp atp-2"
GETF drop alive
ASSERT LAST_N == 1 "drop alive post CETP"

# nest partner
SEND nest photosynth 14
SEND nest charge 12
SEND nest feed 10
SEND nest abca1 1
ASSERT LAST_N == 1 "nest abca1 seed before CETP"
SEND nest photosynth 8
SEND nest charge 8
SEND nest feed 6
SEND nest abcg1 1
SEND nest photosynth 8
SEND nest charge 8
SEND nest feed 6
SEND nest lcat 1
ASSERT LAST_N == 1 "nest lcat CE-core before CETP shuttle"
ASSERT LAST_N == 1 "nest abcg1 load before CETP"
GETF nest heat
LET ng_h = LAST_N
GETF nest energy
LET ng_e = LAST_N
GETF nest atp
LET ng_a = LAST_N
SEND nest cetp 2
ASSERT LAST_N == 2 "nest cetp CE-shuttle load-2"
GETF nest heat
ASSERT LAST_N == ng_h + 2 "nest cetp heat+2"
GETF nest energy
ASSERT LAST_N == ng_e - 2 "nest cetp energy-2"
GETF nest atp
ASSERT LAST_N == ng_a - 2 "nest cetp atp-2"
GETF nest alive
ASSERT LAST_N == 1 "nest alive post CETP"

# hollow clamps
SEND starve cetp 4
ASSERT LAST_N == 0 "starve cetp no-ATP clamp"
SEND ash cetp 3
ASSERT LAST_N == 0 "ash cetp dead clamp"
SEND er cetp 0
ASSERT LAST_N == 0 "er cetp n0 clamp"

# quad cassette seal: ABCA1 seed + ABCG1 load + LCAT pack + CETP transfer in one mitosis budget
SEND er photosynth 22
SEND er charge 18
SEND er feed 16
GETF er energy
LET dual_e = LAST_N
SEND er abca1 1
ASSERT LAST_N == 1 "er abca1 quad-cassette seed"
SEND er abcg1 1
ASSERT LAST_N == 1 "er abcg1 quad-cassette load"
SEND er lcat 1
ASSERT LAST_N == 1 "er lcat quad-cassette pack"
SEND er cetp 1
ASSERT LAST_N == 1 "er cetp quad-cassette transfer"
GETF er energy
ASSERT LAST_N == dual_e - 4 "er quad cassette energy-4"
GETF er alive
ASSERT LAST_N == 1 "er alive quad cassette RCT"
GETF drop alive
ASSERT LAST_N == 1 "drop sealed quad cassette"
GETF nest alive
ASSERT LAST_N == 1 "nest sealed quad cassette"


# CE-transfer preference board — CETP after LCAT on ABCA1/ABCG1 HDL
SEND er photosynth 20
SEND er charge 16
SEND er feed 14
SEND er abca1 1
ASSERT LAST_N == 1 "er abca1 seed discs before CETP"
SEND er abcg1 1
ASSERT LAST_N == 1 "er abcg1 load before CETP"
SEND er lcat 1
ASSERT LAST_N == 1 "er lcat pack before CETP"
GETF er heat
LET s_h = LAST_N
GETF er energy
LET s_e = LAST_N
GETF er atp
LET s_a = LAST_N
GETF er age
LET s_age = LAST_N
GETF er reserve
LET s_rsv = LAST_N
SEND er cetp 4
ASSERT LAST_N == 4 "er cetp CE-shuttle-HDL pack-4"
GETF er heat
ASSERT LAST_N == s_h + 4 "er cetp CE heat+4"
GETF er energy
ASSERT LAST_N == s_e - 4 "er cetp CE energy-4"
GETF er atp
ASSERT LAST_N == s_a - 4 "er cetp CE atp-4"
GETF er age
ASSERT LAST_N == s_age "er cetp CE age held"
GETF er reserve
ASSERT LAST_N == s_rsv "er cetp CE reserve held"
GETF er alive
ASSERT LAST_N == 1 "er alive CE-core HDL board"
# Energy-aware ready coherence after CETP spend
SEND er photosynth 24
SEND er charge 20
SEND er feed 18
SEND er set_threshold 11
GETF er energy
LET rdy_e = LAST_N
SEND er cetp 1
ASSERT LAST_N == 1 "er cetp ready-coherence spend"
GETF er energy
LET rdy_e2 = LAST_N
ASSERT rdy_e2 == rdy_e - 1 "er cetp ready energy-1"
GETF er threshold
LET rdy_thr = LAST_N
GETF er ready
LET rdy_flag = LAST_N
# ready must match energy>=threshold
GETF er alive
ASSERT LAST_N == 1 "er alive ready-coherence"

# Population seal: three living wards after CETP continuum
GETF er alive
ASSERT LAST_N == 1 "pop er"
GETF drop alive
ASSERT LAST_N == 1 "pop drop"
GETF nest alive
ASSERT LAST_N == 1 "pop nest"
GETF ash alive
ASSERT LAST_N == 0 "pop ash hollow held"
GETF starve atp
ASSERT LAST_N == 0 "pop starve atp hollow held"

ASSERT 1 == 1 "life_cell_lcat PASS"


