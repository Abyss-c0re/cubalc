# OPEN — DISCOVER bag + full GUIDE playbook for first topic one-shot

OPEN
ASSERT OK == 1
ASSERT OPEN_N == 8
ASSERT OPEN_FIRST == "general"
ASSERT DISCOVER_FIRST == "general"
ASSERT GUIDE_RELATED_N >= 3
ASSERT GUIDE_TIPS_N >= 2
ASSERT OPEN_FORMS_N >= 2
SYS HASI "cubalc.open.v1"
ASSERT LAST_N == 1

OPEN p
ASSERT OK == 1
ASSERT OPEN_N == 4
ASSERT OPEN_FIRST == "cap"
ASSERT TOPIC_NAME == "cap"
ASSERT GUIDE_TIPS_N >= 1
SYS HASI "HASFORM"
ASSERT LAST_N == 1
SYS HASLINE OPEN_TOPICS "protect"
ASSERT LAST_N == 1

# chain RUNSNIP from first
RUNSNIP OPEN_FIRST
ASSERT OK == 1
ASSERT RUNSNIP_TOPIC == "cap"
ASSERT RUNSNIP_OK == 1

OPEN mesh
ASSERT OPEN_FIRST == "p2p"
ASSERT OPEN_N == 1

OPENPLAY plate
ASSERT OK == 1
ASSERT OPEN_FIRST == "plate"
ASSERT GUIDE_FORMS_N >= 2

OPEN zzz_nope
ASSERT OK == 0
CLEAR_ERR

PASS
PRINT "1354_open: PASS"
