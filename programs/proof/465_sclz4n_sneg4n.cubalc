# Proof 465 — digit-6 stack imm 4-bit field zeros+signed: SCLZ4N SCTZ4N SNEG4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLZ4N: 0 → 4; 0x1 → 3; 0x8 → 0; 0x2 → 2
PUSH 0x0
SCLZ4N 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0x1
SCLZ4N 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x8
SCLZ4N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x2
CLZ4N 0
POP x
ASSERT x == 2

# high nibble preserved: 0x...70 → clz(0)=4 → 0x...74
CLEARSTACK
PUSH 0x1122334455667700
SCLZ4N 0
POP x
ASSERT x == 0x1122334455667704

# STACKCLZ4N n1: nibble1 of 0x...40 is 4=0100 → clz 1
CLEARSTACK
PUSH 0x40
STACKCLZ4N 1
POP x
ASSERT x == 0x10

# SCTZ4N: 0 → 4; 0x1 → 0; 0x8 → 3; 0x6 → 1
CLEARSTACK
PUSH 0x0
SCTZ4N 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0x1
SCTZ4N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x8
SCTZ4N 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x6
CTZ4N 0
POP x
ASSERT x == 1

# STACKCTZ4N n1: nibble1 of 0x...C0 is C=1100 → ctz 2
CLEARSTACK
PUSH 0xC0
STACKCTZ4N 1
POP x
ASSERT x == 0x20

# SNEG4N: 0x3 → 0xD (-3); 0xE (-2) → 0x2; min 0x8 stays 0x8
CLEARSTACK
PUSH 0x3
SNEG4N 0
POP x
ASSERT x == 13

CLEARSTACK
PUSH 0xE
SNEG4N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x8
NEG4N 0
POP x
ASSERT x == 8

# double-neg on low nibble 0x5 → 0xB → 0x5; high preserved
CLEARSTACK
PUSH 0x1122334455667755
SNEG4N 0
POP x
ASSERT x == 0x112233445566775B
CLEARSTACK
PUSH 0x112233445566775B
SNEG4N 0
POP x
ASSERT x == 0x1122334455667755

# STACKNEG4N n1: nibble1 of 0x...30 is 3 → -3 = D → 0x...D0
CLEARSTACK
PUSH 0x30
STACKNEG4N 1
POP x
ASSERT x == 0xD0

# SNEGNIBN alias: 0x1 → 0xF
CLEARSTACK
PUSH 0x1
SNEGNIBN 0
POP x
ASSERT x == 15

HOLD_FLASH 0
