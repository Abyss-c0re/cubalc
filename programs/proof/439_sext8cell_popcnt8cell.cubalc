# Proof 439 — digit-6 cell fixed-width 8 signed/metrics: SEXT8CELL ABS8CELL POPCNT8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SEXT8CELL: 0xFF → -1; 0x7F → 127; 0x80 → -128
CELLSET 0 255
CELLSET 1 127
CELLSET 2 128
SEXT8CELL 0 2
ASSERT CELL(0) == -1
ASSERT CELL(1) == 127
ASSERT CELL(2) == -128
ASSERT LAST_N == 3

# ABS8CELL: -5 (0xFB) → 5; 42 → 42; min int8 0x80 stays 0x80
CELLSET 3 251
CELLSET 4 42
CELLSET 5 128
ABS8CELL 3 5
ASSERT CELL(3) == 5
ASSERT CELL(4) == 42
ASSERT CELL(5) == 128
ASSERT LAST_N == 3

# POPCNT8CELL: 0x0F → 4; 0xFF → 8; 0 → 0; 0x80 → 1
CELLSET 6 15
CELLSET 7 255
CELLSET 8 0
CELLSET 9 128
POPCNT8CELL 6 9
ASSERT CELL(6) == 4
ASSERT CELL(7) == 8
ASSERT CELL(8) == 0
ASSERT CELL(9) == 1
ASSERT LAST_N == 4

# POPCNT8RANGE single
CELLSET 10 0xA5
POPCNT8RANGE 10 10
ASSERT CELL(10) == 4

# round-trip: SEXT then ABS of -100 (0x9C)
CELLSET 11 156
SEXT8CELL 11 11
ABS8CELL 11 11
ASSERT CELL(11) == 100

# high bits above 8 ignored
CELLSET 12 511
POPCNT8CELL 12 12
ASSERT CELL(12) == 8
CELLSET 13 384
SEXT8CELL 13 13
ASSERT CELL(13) == -128

HOLD_FLASH 0
