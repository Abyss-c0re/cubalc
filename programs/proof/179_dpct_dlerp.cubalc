# Proof 179 — digit-6 dual-stack energy: DPCT DLERP
HOLD_FLASH 1
SCIENCE LOAD

# DPCT: a b c d → (a*100)/c (b*100)/d
CLEARSTACK
PUSH 25
PUSH 50
PUSH 100
PUSH 200
DPCT
POP y
POP x
ASSERT x == 25
ASSERT y == 25

# half / full
CLEARSTACK
PUSH 1
PUSH 3
PUSH 4
PUSH 4
2PCT
POP y
POP x
ASSERT x == 25
ASSERT y == 75

# /0 → 0
CLEARSTACK
PUSH 10
PUSH 10
PUSH 0
PUSH 5
DPERCENT
POP y
POP x
ASSERT x == 0
ASSERT y == 200

# DLERP: a b c d t → a+(c-a)*t/100 , b+(d-b)*t/100
CLEARSTACK
PUSH 0
PUSH 10
PUSH 100
PUSH 50
PUSH 50
DLERP
POP y
POP x
ASSERT x == 50
ASSERT y == 30

# t=0 → start, t=100 → end
CLEARSTACK
PUSH 7
PUSH 8
PUSH 70
PUSH 80
PUSH 0
2LERP
POP y
POP x
ASSERT x == 7
ASSERT y == 8

CLEARSTACK
PUSH 7
PUSH 8
PUSH 70
PUSH 80
PUSH 100
DMIX
POP y
POP x
ASSERT x == 70
ASSERT y == 80

# t clamp >100
CLEARSTACK
PUSH 0
PUSH 0
PUSH 10
PUSH 20
PUSH 200
PAIRLERP
POP y
POP x
ASSERT x == 10
ASSERT y == 20

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
DPCT
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
DLERP
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof179_dpct_dlerp" LAST_N SP
