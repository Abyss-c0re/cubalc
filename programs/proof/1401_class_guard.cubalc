# INCLUDE class_guard - multi CLASS catalog ALL + ANY contract

HOLD_FLASH 1

CLASS Ticket
  FIELD id
END

CLASS Order
  FIELD n
END

DEFAULT NEED_CLASSES = ""
DEFAULT NEED_CLASS_ANY = ""
DEFAULT CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_ANY_OK == 1

LET NEED_CLASSES = "Ticket\nnosuch_cubalc_class_all"
LET NEED_CLASS_ANY = ""
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_OK == 0
ASSERT CLASS_GUARD_ALL_OK == 0
ASSERT CLASSMISS_N >= 1
SYS HASLINE CLASSMISS "nosuch_cubalc_class_all"
ASSERT LAST_N == 1
CLEAR_ERR

LET NEED_CLASSES = "Ticket\nOrder"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_OK == 1
ASSERT CLASSHAVE_N >= 2

LET NEED_CLASSES = ""
LET NEED_CLASS_ANY = "nosuch_a\nnosuch_b"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 0
ASSERT CLASS_GUARD_OK == 0
CLEAR_ERR

LET NEED_CLASS_ANY = "nosuch_a\nTicket"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1
CLEAR_ERR

LET NEED_CLASSES = "Ticket\nOrder"
LET NEED_CLASS_ANY = ""
LET CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_OK == 1

LET NEED_CLASSES = ""
LET NEED_CLASS_ANY = "nosuch_z\nTicket"
LET CLASS_GUARD_SOFT = 0
INCLUDE class_guard
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1

LET NEED_CLASSES = "Ticket"
LET NEED_CLASS_ANY = "Order\nnosuch_z"
LET CLASS_GUARD_SOFT = 1
INCLUDE class_guard
ASSERT CLASS_GUARD_ALL_OK == 1
ASSERT CLASS_GUARD_ANY_OK == 1
ASSERT CLASS_GUARD_OK == 1

HASFORM "LISTCLASSES"
ASSERT LAST_N == 1
HASLIB class_guard
ASSERT LAST_N == 1

PRINT "1401_class_guard ok"
PASS
