# Proof 567 — digit-4 stack+dual field signed LE0 8/4: S0LE8N S0LE4N D0LE8N D0LE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0LE8N: 0 → 1
PUSH 0x0
S0LE8N 0
POP x
ASSERT x == 1

# positive → 0
CLEARSTACK
PUSH 0x5
SLE08N 0
POP x
ASSERT x == 0

# -1=0xFF → 1
CLEARSTACK
PUSH 0xFF
SNONPOS8N 0
POP x
ASSERT x == 1

# INT8_MIN=0x80 → 1
CLEARSTACK
PUSH 0x80
SISNONPOS8N 0
POP x
ASSERT x == 1

# high preserve: low +3 → 0
CLEARSTACK
PUSH 0xAA03
S0LE8N 0
POP x
ASSERT x == 0xAA00

# high preserve: low -2 → 1
CLEARSTACK
PUSH 0xAAFE
S0LE8N 0
POP x
ASSERT x == 0xAA01

# STACK0LE8N n1: high positive → 0
CLEARSTACK
PUSH 0x0200
STACK0LE8N 1
POP x
ASSERT x == 0x0000

# high negative → 1
CLEARSTACK
PUSH 0xFE03
STACK0LE8N 1
POP x
ASSERT x == 0x0103

# high zero → 1
CLEARSTACK
PUSH 0x0003
STACK0LE8N 1
POP x
ASSERT x == 0x0103

# S0LE4N: 0 → 1
CLEARSTACK
PUSH 0x0
S0LE4N 0
POP x
ASSERT x == 1

# positive → 0
CLEARSTACK
PUSH 0x3
SLE04N 0
POP x
ASSERT x == 0

# -1=0xF → 1
CLEARSTACK
PUSH 0xF
SNONPOS4N 0
POP x
ASSERT x == 1

# INT4_MIN=0x8 → 1
CLEARSTACK
PUSH 0x8
SISNONPOS4N 0
POP x
ASSERT x == 1

# high nibble preserve: low positive → 0
CLEARSTACK
PUSH 0x13
S0LE4N 0
POP x
ASSERT x == 0x10

# high nibble preserve: low negative
CLEARSTACK
PUSH 0x1E
S0LE4N 0
POP x
ASSERT x == 0x11

# high positive: n1 of 0x20 → 0
CLEARSTACK
PUSH 0x20
STACK0LE4N 1
POP x
ASSERT x == 0x00

# high negative: n1 of 0xD0 → 1
CLEARSTACK
PUSH 0xD0
STACK0LE4N 1
POP x
ASSERT x == 0x10

# high zero n1
CLEARSTACK
PUSH 0x03
STACK0LE4N 1
POP x
ASSERT x == 0x13

# D0LE8N
CLEARSTACK
PUSH 0x5
PUSH 0xFE
D0LE8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x0
PUSH 0x3
PAIR0LE8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LE8N n1
CLEARSTACK
PUSH 0x0300
PUSH 0xFD00
STACK20LE8N 1
POP y
POP x
ASSERT x == 0x0000
ASSERT y == 0x0100

# D0LE4N
CLEARSTACK
PUSH 0x3
PUSH 0xE
D0LE4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x0
PUSH 0x2
PAIR0LE4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LE4N n1
CLEARSTACK
PUSH 0x30
PUSH 0xD0
STACK20LE4N 1
POP y
POP x
ASSERT x == 0x00
ASSERT y == 0x10

HOLD_FLASH 0
