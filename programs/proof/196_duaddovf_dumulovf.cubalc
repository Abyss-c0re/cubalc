# Proof 196 — digit-0 dual-stack unsigned overflow: DUADDOVF DUSUBOVF DUMULOVF
HOLD_FLASH 1
SCIENCE LOAD

# DUADDOVF: no wrap
CLEARSTACK
PUSH 10
PUSH 20
PUSH 3
PUSH 4
DUADDOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# max ulong + 1 wraps (as signed -1 + 1)
CLEARSTACK
PUSH -1
PUSH 0
PUSH 1
PUSH 0
2UADDOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# PAIRUADDOVF both wrap
CLEARSTACK
PUSH -1
PUSH -2
PUSH 5
PUSH 3
PAIRUADDOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DUSUBOVF: borrow when a < c unsigned
CLEARSTACK
PUSH 3
PUSH 10
PUSH 5
PUSH 2
DUSUBOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# no borrow
CLEARSTACK
PUSH 100
PUSH 50
PUSH 1
PUSH 50
2USUBOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRUSUBOVF both borrow
CLEARSTACK
PUSH 0
PUSH 1
PUSH 1
PUSH 2
PAIRUSUBOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DUMULOVF: large * large
CLEARSTACK
LET hi = 4294967296
PUSH hi
PUSH 2
PUSH hi
PUSH 3
DUMULOVF
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# safe mul
CLEARSTACK
PUSH 7
PUSH 8
PUSH 9
PUSH 10
2UMULOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DUMULOVER zero factor never overflows
CLEARSTACK
PUSH -1
PUSH -1
PUSH 0
PUSH 1
PAIRUMULOVF
POP y
POP x
ASSERT x == 0
ASSERT y == 0
