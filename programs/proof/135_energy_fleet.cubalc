# Proof 135 — digit-6 energy fleet: SWAP SHARE TOTAL AVG MIN MAX + stack duals
HOLD_FLASH 1
SCIENCE LOAD

CUBE a ROLE matrix PROTON 1
CUBE b ROLE matrix PROTON 1
CUBE c ROLE matrix PROTON 1

ENERGYSET a 20
ENERGYSET b 80
ENERGYSET c 40

# ENERGYSWAP
ENERGYSWAP a b
ENERGYGET a
ASSERT LAST_N == 80
ENERGYGET b
ASSERT LAST_N == 20

# ENERGYSHARE — mean of a(80) and b(20) = 50
ENERGYSHARE a b
ENERGYGET a
ASSERT LAST_N == 50
ENERGYGET b
ASSERT LAST_N == 50

# restore known fleet: a=10 b=30 c=50 → total 90 avg 30 min 10 max 50
ENERGYSET a 10
ENERGYSET b 30
ENERGYSET c 50

ENERGYTOTAL
ASSERT LAST_N == 90
ASSERT ENERGY == 90

ENERGYAVG
ASSERT LAST_N == 30

ENERGYMIN
ASSERT LAST_N == 10

ENERGYMAX
ASSERT LAST_N == 50

# aliases
ENERGYSUM
ASSERT LAST_N == 90
MEANENERGY
ASSERT LAST_N == 30
MINENERGY
ASSERT LAST_N == 10
MAXENERGY
ASSERT LAST_N == 50

# stack duals
CLEARSTACK
SENERGYTOTAL
ASSERT LAST_N == 90
ASSERT SP == 1
POP t
ASSERT t == 90

CLEARSTACK
SENERGYAVG
ASSERT LAST_N == 30
POP t
ASSERT t == 30

CLEARSTACK
SENERGYMIN
ASSERT LAST_N == 10
POP t
ASSERT t == 10

CLEARSTACK
SENERGYMAX
ASSERT LAST_N == 50
POP t
ASSERT t == 50

# short aliases SEAVG SEMIN SEMAX SETOTAL
CLEARSTACK
SETOTAL
ASSERT LAST_N == 90
SEAVG
ASSERT LAST_N == 30
SEMIN
ASSERT LAST_N == 10
SEMAX
ASSERT LAST_N == 50
ASSERT SP == 4

# ENERGYSHARE alias ESHAR
ENERGYSET a 0
ENERGYSET b 100
ESHAR a b
ENERGYGET a
ASSERT LAST_N == 50

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof135_energy_fleet" LAST_N SP
