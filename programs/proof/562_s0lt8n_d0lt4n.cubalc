# Proof 562 — digit-7 stack+dual field signed LT0 8/4: S0LT8N S0LT4N D0LT8N D0LT4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0LT8N: 0 → 0
PUSH 0x0
S0LT8N 0
POP x
ASSERT x == 0

# positive → 0
CLEARSTACK
PUSH 0x5
SLT08N 0
POP x
ASSERT x == 0

# -1=0xFF → 1
CLEARSTACK
PUSH 0xFF
SNEGZ8N 0
POP x
ASSERT x == 1

# INT8_MIN=0x80 → 1
CLEARSTACK
PUSH 0x80
SISNEG8N 0
POP x
ASSERT x == 1

# high preserve: low -2=0xFE → 1
CLEARSTACK
PUSH 0xAAFE
S0LT8N 0
POP x
ASSERT x == 0xAA01

# high preserve: low +3 → 0
CLEARSTACK
PUSH 0xAA03
S0LT8N 0
POP x
ASSERT x == 0xAA00

# STACK0LT8N n1: high negative → 1
CLEARSTACK
PUSH 0xFE00
STACK0LT8N 1
POP x
ASSERT x == 0x0100

# high positive → 0
CLEARSTACK
PUSH 0x0203
STACK0LT8N 1
POP x
ASSERT x == 0x0003

# S0LT4N: 0 → 0
CLEARSTACK
PUSH 0x0
S0LT4N 0
POP x
ASSERT x == 0

# positive → 0
CLEARSTACK
PUSH 0x3
SLT04N 0
POP x
ASSERT x == 0

# -1=0xF → 1
CLEARSTACK
PUSH 0xF
SNEGZ4N 0
POP x
ASSERT x == 1

# INT4_MIN=0x8 → 1
CLEARSTACK
PUSH 0x8
SISNEG4N 0
POP x
ASSERT x == 1

# high nibble preserve: low negative E → 1
CLEARSTACK
PUSH 0x1E
S0LT4N 0
POP x
ASSERT x == 0x11

# high positive: n1 of 0x20 → 0
CLEARSTACK
PUSH 0x20
STACK0LT4N 1
POP x
ASSERT x == 0x00

# high negative: n1 of 0xD0 → 1
CLEARSTACK
PUSH 0xD0
STACK0LT4N 1
POP x
ASSERT x == 0x10

# D0LT8N
CLEARSTACK
PUSH 0x5
PUSH 0xFE
D0LT8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x80
PUSH 0x0
PAIR0LT8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LT8N n1
CLEARSTACK
PUSH 0xFD00
PUSH 0x0300
STACK20LT8N 1
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0000

# D0LT4N
CLEARSTACK
PUSH 0x3
PUSH 0xE
D0LT4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 0x8
PUSH 0x0
PAIR0LT4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# STACK20LT4N n1
CLEARSTACK
PUSH 0xD0
PUSH 0x30
STACK20LT4N 1
POP y
POP x
ASSERT x == 0x10
ASSERT y == 0x00

HOLD_FLASH 0
