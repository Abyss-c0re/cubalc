# MATCHTOPICS / PICKTOPIC — topic filter duals of MATCHLIBS / PICKLIB

MATCHTOPICS cap
ASSERT OK == 1
ASSERT MATCHTOPICS_N == 1
SYS HASI "cap"
ASSERT LAST_N == 1

MATCHTOPICS p
ASSERT OK == 1
ASSERT MATCHTOPICS_N >= 2
SYS HASI "plate"
ASSERT LAST_N == 1
SYS HASI "p2p"
ASSERT LAST_N == 1
SYS HASI "protect"
ASSERT LAST_N == 1

MATCHTOPICS mesh
ASSERT OK == 1
ASSERT MATCHTOPICS_N == 1
SYS HASI "p2p"
ASSERT LAST_N == 1

PICKTOPIC plate
ASSERT OK == 1
ASSERT PICKTOPIC == "plate"
ASSERT TOPIC_NAME == "plate"

PICKTOPIC form
ASSERT OK == 1
ASSERT PICKTOPIC == "cap"

PICKTOPIC lib
GUIDE LAST
ASSERT OK == 1
ASSERT GUIDE_RELATED_N >= 3

PICKTOPIC zzz_nope OR general
ASSERT OK == 1
ASSERT PICKTOPIC == "general"

PICKTOPIC zzz_nope
ASSERT OK == 0
CLEAR_ERR

MATCHTOPICS zzz_nope
ASSERT OK == 0
CLEAR_ERR

MATCHTOPICS
ASSERT OK == 0
CLEAR_ERR

FIRSTTOPIC fat
ASSERT OK == 1
ASSERT FIRSTTOPIC == "fat"

PASS
PRINT "1347_matchtopics: PASS"
