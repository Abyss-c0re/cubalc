# Proof 152 — digit-0 dual-stack bit metrics: DPOPCNT DCLZ DCTZ
HOLD_FLASH 1
SCIENCE LOAD

# DPOPCNT
CLEARSTACK
PUSH 0xF
PUSH 0xAA
DPOPCNT
POP y
POP x
ASSERT x == 4
ASSERT y == 4

# DCLZ — 1 has 63 leading zeros on 64-bit
CLEARSTACK
PUSH 1
PUSH 0
DCLZ
POP y
POP x
ASSERT x == 63
ASSERT y == 64

# DCTZ
CLEARSTACK
PUSH 8
PUSH 0
DCTZ
POP y
POP x
ASSERT x == 3
ASSERT y == 64

# aliases
CLEARSTACK
PUSH 0xFF
PUSH 1
2POPCNT
POP y
POP x
ASSERT x == 8
ASSERT y == 1

CLEARSTACK
PUSH 0x8000000000000000
PUSH 2
2CLZ
POP y
POP x
ASSERT x == 0
ASSERT y == 62

CLEARSTACK
PUSH 16
PUSH 12
PAIRCTZ
POP y
POP x
ASSERT x == 4
ASSERT y == 2

# soft fails
CLEARSTACK
DPOPCNT
ASSERT OK == 0
CLEARSTACK
DCLZ
ASSERT OK == 0
CLEARSTACK
DCTZ
ASSERT OK == 0
CLEARSTACK
PUSH 1
2CTZ
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof152_dpopcnt_dclz" LAST_N SP
