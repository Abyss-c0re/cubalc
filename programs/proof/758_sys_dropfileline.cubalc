# SYS DROPFILELINE / FILEDROPLINE — drop single 0-based file line in place
# Usability: remove plate/config row without READ+DROPNTH+WRITE glue
# Completes LINEAT/SET/INSERT family. Soft OOB no write. Soft miss.

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS JOIN td "dropfileline_mi_fixture"
LET fix = LAST
SYS MKDIR fix

SYS JOIN fix "sample.txt"
LET fs = LAST
SYS WRITE fs "L0\nL1\nL2\nL3\nL4"

SYS DROPFILELINE fs 2
ASSERT OK == 1
ASSERT DROPFILELINE_N == 1
ASSERT DROPFILELINE_I == 2
ASSERT DROPFILELINE_TOTAL == 4
SYS EQS LAST "L2"
ASSERT LAST_N == 1

SYS LINEAT fs 0
SYS EQS LAST "L0"
ASSERT LAST_N == 1
SYS LINEAT fs 1
SYS EQS LAST "L1"
ASSERT LAST_N == 1
SYS LINEAT fs 2
SYS EQS LAST "L3"
ASSERT LAST_N == 1
SYS LINEAT fs 3
SYS EQS LAST "L4"
ASSERT LAST_N == 1

# alias drop first
SYS FILEDROPLINE fs 0
ASSERT DROPFILELINE_N == 1
SYS EQS LAST "L0"
ASSERT LAST_N == 1
SYS LINEAT fs 0
SYS EQS LAST "L1"
ASSERT LAST_N == 1
ASSERT DROPFILELINE_TOTAL == 3

# OOB soft
SYS DROPFILELINE fs 99
ASSERT OK == 1
ASSERT DROPFILELINE_N == 0
ASSERT DROPFILELINE_TOTAL == 3
SYS LINEAT fs 0
SYS EQS LAST "L1"
ASSERT LAST_N == 1

# soft miss
SYS DROPFILELINE "no_such_dropfileline_mi.txt" 0
ASSERT OK == 0
ASSERT DROPFILELINE_N == 0

# cleanup
SYS RM fs

PRINT "sys_dropfileline ok"
