// 2109_life_cell_cilia.cubalc
// Proof 2109: life_cell cilia — primary cilia / IFT after LUMEN.
// Pay n ATP IFT-B/kinesin-2/polycystin trafficking -> heat +n + pmf +n (flow-sense chemiosmotic bank);
// age/energy/reserve/thr/sp/pcr held; ready recomputed. Distinct from lumen (pcr+ pmf held),
// polar (sp+), seal (thr+), pump (energy->pmf no heat), harness (heat->pmf).
// Continuum after lumen. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell

ENTITY gate OF Cell 1 12 0
ENTITY poor OF Cell 1 20 0
ENTITY dead OF Cell 0 20 0
ENTITY g0 OF Cell 1 10 0
ENTITY twin OF Cell 1 12 0
ENTITY mac OF Cell 1 14 0
ENTITY ceil OF Cell 1 20 0

SEND gate set_threshold 10
SEND poor set_threshold 10
SEND g0 set_threshold 10
SEND twin set_threshold 10
SEND mac set_threshold 10

SEND gate pulse 5
SEND gate photosynth 5
SEND gate glycolyse 4
SEND gate pump 5
GETF gate age
ASSERT LAST_N == 5 "cilia a5"
GETF gate atp
ASSERT LAST_N == 4 "cilia atp4"
GETF gate heat
ASSERT LAST_N == 0 "cilia h0"
GETF gate pmf
ASSERT LAST_N == 5 "cilia pmf5"
GETF gate energy
LET e0 = LAST_N
ASSERT e0 >= 2 "cilia energy primed"
GETF gate reserve
LET r0 = LAST_N
GETF gate age
LET a0 = LAST_N
GETF gate atp
LET at0 = LAST_N
GETF gate heat
LET h0 = LAST_N
GETF gate pmf
LET p0 = LAST_N
GETF gate threshold
LET t0 = LAST_N
ASSERT t0 == 10 "cilia thr10"
GETF gate setpoint
LET s0 = LAST_N
ASSERT s0 == 10 "cilia sp10"
GETF gate pcr
LET c0 = LAST_N
ASSERT c0 == 0 "cilia pcr0"

SEND gate cilia 2
ASSERT LAST_N == 2 "cilia take2"
GETF gate atp
ASSERT LAST_N == at0 - 2 "cilia atp-2"
GETF gate age
ASSERT LAST_N == a0 "cilia age held"
GETF gate heat
ASSERT LAST_N == h0 + 2 "cilia heat+2"
GETF gate energy
ASSERT LAST_N == e0 "cilia e held"
GETF gate reserve
ASSERT LAST_N == r0 "cilia r held"
GETF gate threshold
ASSERT LAST_N == t0 "cilia thr held"
GETF gate setpoint
ASSERT LAST_N == s0 "cilia sp held"
GETF gate pcr
ASSERT LAST_N == c0 "cilia pcr held"
GETF gate pmf
ASSERT LAST_N == p0 + 2 "cilia pmf+2"
GETF gate alive
ASSERT LAST_N == 1 "cilia lives"
GETF gate energy
LET eg = LAST_N
GETF gate threshold
LET tg = LAST_N
GETF gate ready
LET rd = LAST_N
IF eg >= tg THEN
  ASSERT rd == 1 "cilia ready if surplus"
ELSE
  ASSERT rd == 0 "cilia ready blocked"
END


// Partial take when ATP short
SEND poor pulse 2
SEND poor photosynth 1
SEND poor glycolyse 1
SEND poor pump 1
GETF poor atp
LET pat = LAST_N
ASSERT pat >= 1 "poor atp"
ASSERT pat < 5 "poor atp low"
GETF poor heat
LET ph0 = LAST_N
GETF poor pmf
LET pp0 = LAST_N
GETF poor pcr
LET pc0 = LAST_N
GETF poor setpoint
LET ps0 = LAST_N
GETF poor threshold
LET pt0 = LAST_N
GETF poor age
LET pa0 = LAST_N
SEND poor cilia 9
LET ptake = LAST_N
ASSERT ptake == pat "poor take all"
ASSERT ptake >= 1 "poor took"
GETF poor atp
ASSERT LAST_N == 0 "poor atp0"
GETF poor heat
ASSERT LAST_N == ph0 + ptake "poor heat+"
GETF poor pmf
ASSERT LAST_N == pp0 + ptake "poor pmf+"
GETF poor pcr
ASSERT LAST_N == pc0 "poor pcr held"
GETF poor threshold
ASSERT LAST_N == pt0 "poor thr held"
GETF poor setpoint
ASSERT LAST_N == ps0 "poor sp held"
GETF poor age
ASSERT LAST_N == pa0 "poor age held"

// Dead / n<1 fail-closed
SEND dead cilia 3
ASSERT LAST_N == 0 "dead cilia0"
SEND gate cilia 0
ASSERT LAST_N == 0 "n0 cilia0"
SEND gate cilia -1
ASSERT LAST_N == 0 "neg cilia0"

// Empty ATP fail-closed
SEND twin pulse 1
SEND twin photosynth 1
SEND twin glycolyse 1
SEND twin pump 1
GETF twin atp
LET ta = LAST_N
IF ta >= 1 THEN
  SEND twin seal ta
END
GETF twin atp
ASSERT LAST_N == 0 "twin atp0"
GETF twin pmf
LET tp0 = LAST_N
GETF twin heat
LET th0 = LAST_N
SEND twin cilia 2
ASSERT LAST_N == 0 "empty cilia0"
GETF twin pmf
ASSERT LAST_N == tp0 "empty pmf held"
GETF twin heat
ASSERT LAST_N == th0 "empty heat held"

// G0: cilia works, ready forced 0
SEND g0 pulse 3
SEND g0 photosynth 3
SEND g0 glycolyse 3
SEND g0 pump 2
SEND g0 quiesce
GETF g0 atp
LET ga0 = LAST_N
ASSERT ga0 >= 2 "g0 atp"
GETF g0 pmf
LET gp0 = LAST_N
GETF g0 pcr
LET gc0 = LAST_N
GETF g0 setpoint
LET gs0 = LAST_N
GETF g0 heat
LET gh0 = LAST_N
GETF g0 threshold
LET gt0 = LAST_N
SEND g0 cilia 2
ASSERT LAST_N == 2 "g0 take2"
GETF g0 ready
ASSERT LAST_N == 0 "g0 ready0"
GETF g0 pmf
ASSERT LAST_N == gp0 + 2 "g0 pmf+2"
GETF g0 heat
ASSERT LAST_N == gh0 + 2 "g0 heat+2"
GETF g0 threshold
ASSERT LAST_N == gt0 "g0 thr held"
GETF g0 pcr
ASSERT LAST_N == gc0 "g0 pcr held"
GETF g0 setpoint
ASSERT LAST_N == gs0 "g0 sp held"
GETF g0 atp
ASSERT LAST_N == ga0 - 2 "g0 atp-2"

// Distinct from lumen: cilia pmf+, lumen pcr+ pmf held
SEND mac pulse 4
SEND mac photosynth 4
SEND mac glycolyse 4
SEND mac pump 3
SEND mac set_threshold 10
SEND mac set_setpoint 10
GETF mac atp
LET ma0 = LAST_N
ASSERT ma0 >= 4 "mac atp"
GETF mac threshold
LET mt0 = LAST_N
GETF mac setpoint
LET ms0 = LAST_N
GETF mac heat
LET mh0 = LAST_N
GETF mac pcr
LET mc0 = LAST_N
GETF mac pmf
LET mp0 = LAST_N
GETF mac age
LET mag0 = LAST_N
SEND mac lumen 1
ASSERT LAST_N == 1 "dist lumen1a"
GETF mac pcr
ASSERT LAST_N == mc0 + 1 "dist pcr+lumen0"
GETF mac heat
ASSERT LAST_N == mh0 + 1 "dist heat+lumen0"
GETF mac threshold
LET mt1 = LAST_N
GETF mac setpoint
LET ms1 = LAST_N
GETF mac heat
LET mh1 = LAST_N
GETF mac pcr
LET mc1 = LAST_N
GETF mac pmf
LET mp1 = LAST_N
GETF mac age
LET mag1 = LAST_N
GETF mac atp
LET ma1 = LAST_N
SEND mac cilia 1
ASSERT LAST_N == 1 "dist cilia1"
GETF mac pmf
ASSERT LAST_N == mp1 + 1 "dist pmf+cilia"
GETF mac pcr
ASSERT LAST_N == mc1 "dist pcr held cilia"
GETF mac setpoint
ASSERT LAST_N == ms1 "dist sp held cilia"
GETF mac threshold
ASSERT LAST_N == mt1 "dist thr held cilia"
GETF mac age
ASSERT LAST_N == mag1 "dist age held cilia"
GETF mac heat
ASSERT LAST_N == mh1 + 1 "dist heat+cilia"
GETF mac atp
ASSERT LAST_N == ma1 - 1 "dist atp-1"


// Distinct from pump: cilia heat+pmf+, pump energy->pmf no heat
SEND gate photophos 4
GETF gate atp
LET fa0 = LAST_N
ASSERT fa0 >= 2 "fdist atp"
GETF gate energy
LET fe0 = LAST_N
GETF gate pmf
LET fp0 = LAST_N
GETF gate heat
LET fh0 = LAST_N
SEND gate pump 1
ASSERT LAST_N == 1 "fdist pump1"
GETF gate pmf
ASSERT LAST_N == fp0 + 1 "fdist pmf+pump"
GETF gate heat
ASSERT LAST_N == fh0 "fdist heat held pump"
GETF gate energy
ASSERT LAST_N == fe0 - 1 "fdist e-pump"
GETF gate pmf
LET fp1 = LAST_N
GETF gate heat
LET fh1 = LAST_N
GETF gate atp
LET fa1 = LAST_N
GETF gate energy
LET fe1 = LAST_N
SEND gate cilia 1
ASSERT LAST_N == 1 "fdist cilia1"
GETF gate pmf
ASSERT LAST_N == fp1 + 1 "fdist pmf+cilia"
GETF gate heat
ASSERT LAST_N == fh1 + 1 "fdist heat+cilia"
GETF gate energy
ASSERT LAST_N == fe1 "fdist e held cilia"
GETF gate atp
ASSERT LAST_N == fa1 - 1 "fdist atp-1"

// Distinct from seal: cilia pmf+, seal thr+
SEND gate photophos 4
GETF gate atp
LET xa0 = LAST_N
ASSERT xa0 >= 2 "sdist atp"
GETF gate threshold
LET xt0 = LAST_N
GETF gate pmf
LET xp0 = LAST_N
GETF gate heat
LET xh0 = LAST_N
SEND gate seal 1
ASSERT LAST_N == 1 "sdist seal1"
GETF gate threshold
ASSERT LAST_N == xt0 + 1 "sdist thr+seal"
GETF gate pmf
ASSERT LAST_N == xp0 "sdist pmf held seal"
GETF gate heat
ASSERT LAST_N == xh0 + 1 "sdist heat+seal"
GETF gate threshold
LET xt1 = LAST_N
GETF gate pmf
LET xp1 = LAST_N
GETF gate heat
LET xh1 = LAST_N
GETF gate atp
LET xa1 = LAST_N
SEND gate cilia 1
ASSERT LAST_N == 1 "sdist cilia1"
GETF gate pmf
ASSERT LAST_N == xp1 + 1 "sdist pmf+cilia"
GETF gate threshold
ASSERT LAST_N == xt1 "sdist thr held cilia"
GETF gate heat
ASSERT LAST_N == xh1 + 1 "sdist heat+cilia"

// Continuum lumen then cilia
SEND gate set_threshold 12
SEND gate set_setpoint 10
SEND gate photophos 6
GETF gate atp
LET ca0 = LAST_N
ASSERT ca0 >= 4 "cont atp"
GETF gate threshold
LET ct0 = LAST_N
GETF gate setpoint
LET cs0 = LAST_N
GETF gate heat
LET ch0 = LAST_N
GETF gate age
LET cag0 = LAST_N
GETF gate energy
LET ce0 = LAST_N
GETF gate pmf
LET cp0 = LAST_N
GETF gate reserve
LET cr0 = LAST_N
GETF gate pcr
LET cc0 = LAST_N
SEND gate lumen 1
ASSERT LAST_N == 1 "cont lumen1"
GETF gate pcr
ASSERT LAST_N == cc0 + 1 "cont pcr+lumen"
GETF gate pmf
ASSERT LAST_N == cp0 "cont pmf held lumen"
SEND gate cilia 2
ASSERT LAST_N == 2 "cont cilia2"
GETF gate pmf
ASSERT LAST_N == cp0 + 2 "cont pmf+2"
GETF gate pcr
ASSERT LAST_N == cc0 + 1 "cont pcr still +1"
GETF gate setpoint
ASSERT LAST_N == cs0 "cont sp held"
GETF gate threshold
ASSERT LAST_N == ct0 "cont thr held"
GETF gate heat
ASSERT LAST_N == ch0 + 1 + 2 "cont heat+3"
GETF gate age
ASSERT LAST_N == cag0 "cont age held"
GETF gate energy
ASSERT LAST_N == ce0 "cont e held"
GETF gate reserve
ASSERT LAST_N == cr0 "cont r held"
GETF gate atp
ASSERT LAST_N == ca0 - 3 "cont atp-3"

// Ceiling 1000 on pmf via cilia batches
SEND ceil set_threshold 10
SEND ceil set_setpoint 10
SEND ceil photophos 200
SEND ceil cilia 200
GETF ceil pmf
LET cA = LAST_N
ASSERT cA == 200 "ceil bat1"
SEND ceil photophos 200
SEND ceil cilia 200
GETF ceil pmf
ASSERT LAST_N == 400 "ceil bat2"
SEND ceil photophos 200
SEND ceil cilia 200
GETF ceil pmf
ASSERT LAST_N == 600 "ceil bat3"
SEND ceil photophos 200
SEND ceil cilia 200
GETF ceil pmf
ASSERT LAST_N == 800 "ceil bat4"
SEND ceil photophos 200
SEND ceil cilia 200
GETF ceil pmf
ASSERT LAST_N == 1000 "ceil bat5 cap"
GETF ceil heat
LET zh0 = LAST_N
SEND ceil photophos 10
SEND ceil cilia 7
LET ztake = LAST_N
ASSERT ztake >= 1 "ceil over take"
GETF ceil pmf
ASSERT LAST_N == 1000 "ceil pmf1000 held"
GETF ceil heat
ASSERT LAST_N == zh0 + ztake "ceil heat+ overcap"

// vitality still alive after cilia
SEND gate vitality
ASSERT LAST_N >= 1 "vital"
