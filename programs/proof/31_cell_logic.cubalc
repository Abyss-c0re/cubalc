# Proof 31 — cell logic digit-9: ANDCELL ORCELL XORCELL NOTCELL EQCELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
# seed [0xF0, 0x0F, 0xAA, 0x55, 0xFF]
CELLSET 0 240
CELLSET 1 15
CELLSET 2 170
CELLSET 3 85
CELLSET 4 255

# ANDCELL with 0x0F → [0x00, 0x0F, 0x0A, 0x05, 0x0F]
ANDCELL 0 4 15
ASSERT CELL(0) == 0
ASSERT CELL(1) == 15
ASSERT CELL(2) == 10
ASSERT CELL(3) == 5
ASSERT CELL(4) == 15
ASSERT LAST_N == 5

# ORCELL with 0xF0 → [0xF0, 0xFF, 0xFA, 0xF5, 0xFF]
ORCELL 0 4 240
ASSERT CELL(0) == 240
ASSERT CELL(1) == 255
ASSERT CELL(2) == 250
ASSERT CELL(3) == 245
ASSERT CELL(4) == 255

# XORCELL with 0xFF → invert low 8 bits of each
XORCELL 0 4 255
ASSERT CELL(0) == 15
ASSERT CELL(1) == 0
ASSERT CELL(2) == 5
ASSERT CELL(3) == 10
ASSERT CELL(4) == 0

# restore pattern for NOTCELL: set small positives
CLEARCELLS
CELLSET 0 0
CELLSET 1 1
CELLSET 2 2
CELLSET 3 255
NOTCELL 0 3
# ~0 == -1, ~1 == -2, ~2 == -3, ~255 == -256 (two's complement long)
ASSERT CELL(0) == (-1)
ASSERT CELL(1) == (-2)
ASSERT CELL(2) == (-3)
ASSERT CELL(3) == (-256)
ASSERT LAST_N == 4

# EQCELL predicate mask
CLEARCELLS
CELLSET 0 7
CELLSET 1 3
CELLSET 2 7
CELLSET 3 9
CELLSET 4 7
EQCELL 0 4 7
ASSERT CELL(0) == 1
ASSERT CELL(1) == 0
ASSERT CELL(2) == 1
ASSERT CELL(3) == 0
ASSERT CELL(4) == 1
ASSERT LAST_N == 3

# aliases / compose: CELLAND + CELLEQ
CLEARCELLS
IOTA 0 3 8 1
# cells 8,9,10,11
CELLAND 0 3 8
ASSERT CELL(0) == 8
ASSERT CELL(1) == 8
ASSERT CELL(2) == 8
ASSERT CELL(3) == 8
CELLEQ 0 3 8
ASSERT SUMCELL(0,3) == 4
ASSERT LAST_N == 4

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof30_cell_logic" SUMCELL(0,3) LAST_N
