# Proof 354 — digit-1 imm ANDN-plane TOC: SANDNTOCN SORNTOCN SXORNTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDNTOCN: 0xFF & ~0x0F → 0xF0 = 240
CELLSET 1 255
PUSH 1
SANDNTOCN 15
ASSERT LAST_N == 240
ASSERT CELL(1) == 240
POP a
ASSERT a == 240

# BICTOCN: 42 & ~0 = 42
CELLSET 2 42
PUSH 2
BICTOCN 0
ASSERT LAST_N == 42
ASSERT CELL(2) == 42
POP

# SANDNATN: 7 & ~(-1) = 0
CELLSET 3 7
PUSH 3
SANDNATN (-1)
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# SORNTOCN: 0 | ~0 → -1
CELLSET 4 0
PUSH 4
SORNTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(4) == (-1)
POP

# ORNTOCN: 8 | ~1 = -2
CELLSET 5 8
PUSH 5
ORNTOCN 1
ASSERT LAST_N == (-2)
ASSERT CELL(5) == (-2)
POP

# SORNATN: 0 | ~255 = -256
CELLSET 6 0
PUSH 6
SORNATN 255
ASSERT LAST_N == (-256)
ASSERT CELL(6) == (-256)
POP

# SXORNTOCN: 0 ^ ~0 = -1
CELLSET 7 0
PUSH 7
SXORNTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(7) == (-1)
POP

# XORNTOCN: 5 ^ ~5 = -1
CELLSET 8 5
PUSH 8
XORNTOCN 5
ASSERT LAST_N == (-1)
ASSERT CELL(8) == (-1)
POP

# SXORNATN: 1 ^ ~0 = -2
CELLSET 9 1
PUSH 9
SXORNATN 0
ASSERT LAST_N == (-2)
ASSERT CELL(9) == (-2)
POP

# soft fails empty stack
CLEARSTACK
SANDNTOCN 1
ASSERT OK == 0
SORNTOCN 1
ASSERT OK == 0
SXORNTOCN 1
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof354_sandntocn_sxorntocn" LAST_N SP
HOLD_FLASH 1
