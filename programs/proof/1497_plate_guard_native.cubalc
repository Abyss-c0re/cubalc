# plate_guard via native HASPALL/NEEDP + HASPANY/NEEDPANY (no N× HASP soup)

HOLD_FLASH 1

LET PLATE = "{\"n\":1,\"ok\":true,\"role\":\"worker\",\"status\":\"ready\"}"

# empty skip
DEFAULT NEED_KEYS = ""
DEFAULT NEED_KEY_ANY = ""
DEFAULT PLATE_GUARD_SOFT = 0
INCLUDE plate_guard
ASSERT PLATE_GUARD_OK == 1
ASSERT PLATE_GUARD_ALL_OK == 1
ASSERT PLATE_GUARD_ANY_OK == 1

# soft ALL hit
LET NEED_KEYS = "n\nok"
LET NEED_KEY_ANY = ""
LET PLATE_GUARD_SOFT = 1
INCLUDE plate_guard
ASSERT PLATE_GUARD_ALL_OK == 1
ASSERT PLATE_GUARD_OK == 1

# soft ALL miss — KEYMISS bag from HASPALL
LET NEED_KEYS = "n\nnosuch_cubalc_key_all"
LET PLATE_GUARD_SOFT = 1
INCLUDE plate_guard
ASSERT PLATE_GUARD_ALL_OK == 0
ASSERT PLATE_GUARD_OK == 0
ASSERT KEYMISS_N >= 1
SYS HASLINE KEYMISS "nosuch_cubalc_key_all"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY hit — HASPANY bags
LET NEED_KEYS = ""
LET NEED_KEY_ANY = "nosuch_a\nrole"
LET PLATE_GUARD_SOFT = 1
INCLUDE plate_guard
ASSERT PLATE_GUARD_ANY_OK == 1
ASSERT PLATE_GUARD_OK == 1
ASSERT KEYHAVE_N >= 1
SYS HASLINE KEYHAVE "role"
ASSERT LAST_N == 1
CLEAR_ERR

# soft ANY all-miss
LET NEED_KEY_ANY = "ghostA\nghostB"
LET PLATE_GUARD_SOFT = 1
INCLUDE plate_guard
ASSERT PLATE_GUARD_ANY_OK == 0
ASSERT PLATE_GUARD_OK == 0
ASSERT KEYHAVE_N == 0
ASSERT KEYMISS_N >= 2
CLEAR_ERR

# hard ALL via NEEDP
LET NEED_KEYS = "n\nok\nrole"
LET NEED_KEY_ANY = ""
LET PLATE_GUARD_SOFT = 0
INCLUDE plate_guard
ASSERT PLATE_GUARD_OK == 1

# hard ANY hit via NEEDPANY
LET NEED_KEYS = ""
LET NEED_KEY_ANY = "nosuch_z\nstatus"
LET PLATE_GUARD_SOFT = 0
INCLUDE plate_guard
ASSERT PLATE_GUARD_ANY_OK == 1
ASSERT PLATE_GUARD_OK == 1

# combined soft
LET NEED_KEYS = "n"
LET NEED_KEY_ANY = "ok\nnosuch_cubalc_z"
LET PLATE_GUARD_SOFT = 1
INCLUDE plate_guard
ASSERT PLATE_GUARD_ALL_OK == 1
ASSERT PLATE_GUARD_ANY_OK == 1
ASSERT PLATE_GUARD_OK == 1

# soft ALL miss + soft ANY hit → overall fail
LET NEED_KEYS = "n\nghost_all"
LET NEED_KEY_ANY = "role"
LET PLATE_GUARD_SOFT = 1
INCLUDE plate_guard
ASSERT PLATE_GUARD_ALL_OK == 0
ASSERT PLATE_GUARD_ANY_OK == 1
ASSERT PLATE_GUARD_OK == 0
CLEAR_ERR

# discoverable forms
HASFORM HASPANY
ASSERT LAST_N == 1
HASFORM NEEDPANY
ASSERT LAST_N == 1
HASFORM HASPALL
ASSERT LAST_N == 1
HASFORM NEEDP
ASSERT LAST_N == 1

PASS
