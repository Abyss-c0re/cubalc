# Proof 248 — digit-5 stack high-n mask plane: SANDHN SORHN SXORHN
HOLD_FLASH 1
SCIENCE LOAD

# SANDHN — keep high n bits
CLEARSTACK
PUSH 0xABCD0000000000FF
SANDHN 16
POP x
# high 16 of 0xABCD... = 0xABCD << 48
ASSERT x == 0xABCD000000000000

CLEARSTACK
PUSH 0xF00000000000000F
STACKANDHN 4
POP x
# keep high nibble 0xF
ASSERT x == 0xF000000000000000

# KEEPHN alias + n=0
CLEARSTACK
PUSH 0x55
KEEPHN 0
POP x
ASSERT x == 0

# SORHN — set high n bits
CLEARSTACK
PUSH 0x0F
SORHN 4
POP x
ASSERT x == 0xF00000000000000F

CLEARSTACK
PUSH 0x11
STACKORHN 8
POP x
ASSERT x == 0xFF00000000000011

# SETHN alias
CLEARSTACK
PUSH 0x00
SETHN 4
POP x
ASSERT x == 0xF000000000000000

# SXORHN — toggle high n bits
CLEARSTACK
PUSH 0xF00000000000000F
SXORHN 4
POP x
# high 0xF ^ 0xF = 0; low 0xF kept
ASSERT x == 0x000000000000000F

CLEARSTACK
PUSH 0x00000000000000AB
STACKXORHN 8
POP x
# set high byte via xor from 0
ASSERT x == 0xFF000000000000AB

# FLIPHN round-trip
CLEARSTACK
PUSH 0xA5000000000000FF
FLIPHN 8
FLIPHN 8
POP x
ASSERT x == 0xA5000000000000FF

# soft fails
CLEARSTACK
SANDHN 4
ASSERT OK == 0
CLEARSTACK
SORHN 4
ASSERT OK == 0
CLEARSTACK
SXORHN 4
ASSERT OK == 0

HOLD_FLASH 1
