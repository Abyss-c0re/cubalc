# Proof 118 — digit-9 stack↔cell range dual: SLOADCELLS SPOPCELLS CELLXFER
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CELLSET 0 10
CELLSET 1 20
CELLSET 2 30
CELLSET 3 40

# SLOADCELLS lo n
CLEARSTACK
SLOADCELLS 0 4
ASSERT SP == 4
ASSERT LAST_N == 40
POP d
POP c
POP b
POP a
ASSERT a == 10
ASSERT b == 20
ASSERT c == 30
ASSERT d == 40

# alias SLOADN / SPUSHRANGE
CLEARSTACK
SLOADN 1 2
ASSERT SP == 2
ASSERT LAST_N == 30
POP y
POP x
ASSERT x == 20
ASSERT y == 30

# SPOPCELLS — reverse of load
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
SPOPCELLS 10 3
ASSERT SP == 0
ASSERT CELL(10) == 1
ASSERT CELL(11) == 2
ASSERT CELL(12) == 3
ASSERT LAST_N == 3

# SSTORECELLS alias + round-trip
CLEARCELLS
CELLSET 0 7
CELLSET 1 8
CELLSET 2 9
CLEARSTACK
SLOADCELLS 0 3
CLEARCELLS
SSTORECELLS 5 3
ASSERT CELL(5) == 7
ASSERT CELL(6) == 8
ASSERT CELL(7) == 9

# CELLXFER
CLEARCELLS
CELLSET 0 50
CELLSET 1 10
CELLXFER 0 1 20
ASSERT CELL(0) == 30
ASSERT CELL(1) == 30
ASSERT LAST_N == 20
# cannot over-drain
XFERCELL 0 1 100
ASSERT CELL(0) == 0
ASSERT CELL(1) == 60
ASSERT LAST_N == 30

# soft fail underfull pop
CLEARSTACK
PUSH 1
SPOPCELLS 0 3
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof118_sloadcells_cellxfer" LAST_N SP
