# Proof 404 — digit-0 stack dual LE nibble field TOC: SNIBTOC SSETNIBTOC SCLRNIBTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSETNIBTOC: build 0x21 = 33 (nibble0=1, nibble1=2)
CELLSET 1 0
PUSH 1
PUSH 1
PUSH 0
SSETNIBTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP
PUSH 1
PUSH 2
PUSH 1
SSETNIBTOC
ASSERT LAST_N == 33
ASSERT CELL(1) == 33
POP

# SNIBTOC extract nibble 1 → 2
CELLSET 2 33
PUSH 2
PUSH 1
SNIBTOC
ASSERT LAST_N == 2
ASSERT CELL(2) == 2
POP

# NIBTOC alias: nibble 0 of 0xAB = 171 → 0xB = 11
CELLSET 3 171
PUSH 3
PUSH 0
NIBTOC
ASSERT LAST_N == 11
ASSERT CELL(3) == 11
POP

# SCLRNIBTOC clear nibble 0 of 0xF5=245 → 0xF0=240
CELLSET 4 245
PUSH 4
PUSH 0
SCLRNIBTOC
ASSERT LAST_N == 240
ASSERT CELL(4) == 240
POP

# CLRNIBTOC clear nibble 1 then extract is 0
CELLSET 5 33
PUSH 5
PUSH 1
CLRNIBTOC
POP
PUSH 5
PUSH 1
SNIBTOC
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft short stack OK=0
CLEARSTACK
SNIBTOC
ASSERT OK == 0
PUSH 1
SSETNIBTOC
ASSERT OK == 0

PRINT "404_snibtoc_sclrnibtoc OK"
