// 1933_smx_mesh_hair_follicle_life.cubalc
// MESH_HAIR_FOLLICLE — SMX mesh stability life-force for Hair follicle lanceolate receptor feed board.
// Soft-OOB storms fail-closed (never ghost-place); MESH_EXCHANGE roots C(4,2) mind mesh;
// STABILIZE hardens; ENERGYFLOW + FLOW drive hair_follicle motor free-energy return
// (free-nerve polymodal origin -> hair_follicle conduits (root hair plexus lanceolate endings (follicle shaft deflection light-touch)) ->
// hair-follicle free-energy crown (hair follicle deflection sensory crest)).
// WE_AUTOHEAL; mitosis under locked rails; second storm re-stabilizes.
// Wonder AGI can RUN. No dual ladders. Cube is SoT · matrix is key · free energy must flow.
// Pure-C SMX engine; proof-only CubalC surface.
REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

HOLD_FLASH 1
BUDGET 64
SHARE state_matrix_only

GENESIS "NEXUS_COORD hair_follicle | from=gift | type=smx_mesh_hair_follicle_life | hold_flash=1 | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap bed

ENTITY seed OF Cell 1 16 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
// hair_follicle motor free-energy charge -> free-nerve polymodal origin -> hair_follicle conduits -> hair_follicle crown
ENERGYFLOW 5
FLOW 4

LET base_cubes = CUBES

SMX KEY

// --- Storm wounds: soft-OOB fail-closed, never ghost-place ---
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

SMX EXCHANGE scrap void_cell
ASSERT SMX_OK == 0 "storm-C soft-OOB"
ASSERT SMX_OOB >= 3 "oob C depth"
ASSERT CUBES == base_cubes "no ghost from storm-C"

// --- MESH_EXCHANGE roots complete hair_follicle mind mesh among live printer spine ---
SMX MESH_EXCHANGE bed nozzle hive scrap
ASSERT SMX_OK == 1 "mesh_exchange live"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange latch"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh from mesh_exchange"
ASSERT SMX_BONDS == 6 "C(4,2)=6 undirected bonds"
ASSERT SMX_OOB == 0 "oob cleared by mesh_exchange"
ASSERT SMX_LIVE == 4 "four live after mesh_exchange"
ASSERT CUBES == base_cubes "mesh_exchange invents nothing"

// --- STABILIZE hardens HAIR_FOLLICLE yoke seal ---
SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "stabilize live"
ASSERT SMX_STABLE == 1 "stable latch"
ASSERT SMX_STEADFAST == 4 "four steadfast"
ASSERT SMX_PULSE == 4 "four pulses"
ASSERT SMX_OOB == 0 "oob cleared by stabilize"
ASSERT CUBES == base_cubes "stabilize invents nothing"

// --- hair_follicle motor free-energy return pulse under locked rails ---
IMPULSE bed 2
IMPULSE nozzle 2
IMPULSE hive 1
ENERGYFLOW 4
FLOW 3
ASSERT ENERGY >= 0 "hair_follicle motor energy non-negative"
ASSERT CUBES == base_cubes "hair_follicle motor gate invents no cubes"

// live mesh talk after hair_follicle motor pulse (free-nerve polymodal origin -> hair_follicle trunk -> hair_follicle crown)
SMX EXCHANGE bed nozzle
ASSERT SMX_OK == 1 "live exchange after hair_follicle motor pulse"
ASSERT SMX_OOB == 0 "no oob on live talk"

SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "branch talk live"
ASSERT SMX_OOB == 0 "no oob bifurcation"

// Autoheal under stable hair_follicle mesh (HAIR_FOLLICLE motor yoke resilience)
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "autoheal live"
ASSERT SMX_AUTOHEALED == 1 "autohealed latch"
ASSERT SMX_OOB == 0 "oob still clear after autoheal"
ASSERT SMX_STABLE == 1 "stable sticky through autoheal"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy"
ASSERT UNITY >= 40 "stable unity after OOB stabilize"
ASSERT DECIDE >= 0 "decide floor"
ASSERT DECIDE <= 9 "decide ceil"
ASSERT SMX_STABLE == 1 "stable sticky through decide"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange sticky through decide"

// --- Free energy mitosis under locked hair_follicle motor feed mesh ---
GETF seed alive
LET a0 = LAST_N
GETF seed energy
LET e0 = LAST_N
IF e0 < 2 THEN
  LET e0 = 16
  SETF seed energy e0
END
LET half = e0 / 2
IF half < 1 THEN
  LET half = 1
END
GETF seed gen
LET dg = LAST_N + 1
SEND d1 birth half dg
SEND seed after_div
PLUG bed d1
GETF d1 alive
LET a1 = LAST_N
ASSERT a1 == 1 "first mitosis under hair_follicle mesh"

GETF seed energy
LET e1 = LAST_N
IF e1 < 2 THEN
  LET e1 = 16
  SETF seed energy e1
END
LET half2 = e1 / 2
IF half2 < 1 THEN
  LET half2 = 1
END
GETF seed gen
LET dg2 = LAST_N + 1
SEND d2 birth half2 dg2
SEND seed after_div
PLUG bed d2
GETF d2 alive
LET a2 = LAST_N
ASSERT a2 == 1 "second mitosis under hair_follicle mesh"
ASSERT ENERGY > 0 "energy remains after mitosis"
ASSERT a0 + a1 + a2 >= 3 "population grew under hair_follicle mesh"

// --- Second storm fail-closed + re-stabilize (no thrash) ---
SMX TALK bed ghost_again
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

SMX MESH_EXCHANGE bed nozzle hive scrap
ASSERT SMX_OK == 1 "mesh_exchange after storm2"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again by mesh_exchange"
ASSERT SMX_BONDS == 6 "bonds after storm2"
ASSERT CUBES >= base_cubes "no ghost after re-mesh"

SMX STABILIZE bed nozzle hive scrap
ASSERT SMX_OK == 1 "re-stabilize live"
ASSERT SMX_STABLE == 1 "stable sticky after storm2"
ASSERT SMX_STEADFAST == 4 "steadfast holds after storm2"
ASSERT SMX_OOB == 0 "oob still clear after re-stabilize"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange sticky through mitosis+storm"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky through mitosis+storm"
ASSERT SMX_AUTOHEALED == 1 "autohealed sticky through storm2"

// Dual WE_AUTOHEAL harden — HAIR_FOLLICLE floor yoking crown resilience after second storm
SMX WE_AUTOHEAL bed nozzle hive scrap
ASSERT SMX_OK == 1 "dual autoheal live"
ASSERT SMX_AUTOHEALED == 1 "dual autohealed latch"
ASSERT SMX_OOB == 0 "oob clear after dual autoheal"
ASSERT SMX_STABLE == 1 "stable sticky through dual autoheal"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange sticky through dual autoheal"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh sticky through dual autoheal"
ASSERT CUBES >= base_cubes "dual autoheal invents no ghost cubes"

// final hair_follicle motor energy breath through free-nerve polymodal origin root -> hair_follicle trunk -> hair_follicle crown lock
ENERGYFLOW 1
FLOW 1
ASSERT ENERGY > 0 "final energy flows"
ASSERT OK == 1

PRINT "smx_mesh_hair_follicle_life" POPULATION SMX_OK SMX_MESH_EXCHANGE SMX_STABLE SMX_STABLE_MESH SMX_STEADFAST SMX_PULSE SMX_BONDS SMX_AUTOHEALED SMX_OOB CUBES UNITY ENERGY DECIDE
PASS
