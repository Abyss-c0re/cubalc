# INCLUDE env_boot — agent_boot + env_guard host-env contract

HOLD_FLASH 1

# empty contract (skip gates)
DEFAULT NEED_ENVS = ""
DEFAULT NEED_ENV_ANY = ""
INCLUDE env_boot
ASSERT OK == 1
ASSERT ENV_GUARD_OK == 1
HASINCLUDE agent_boot
ASSERT LAST_N == 1
HASINCLUDE env_guard
ASSERT LAST_N == 1
HASINCLUDE env_boot
ASSERT LAST_N == 1
VERSION
ASSERT LAST != ""

# ALL gate pass (HOME is always set on POSIX agents)
LET NEED_ENVS = "HOME"
LET NEED_ENV_ANY = ""
LET ENV_GUARD_SOFT = 0
INCLUDE env_boot
ASSERT ENV_GUARD_ALL_OK == 1
ASSERT ENV_GUARD_OK == 1

# soft ANY miss then hit
SYS ENV UNSET CUBALC_EB_X
SYS ENV UNSET CUBALC_EB_Y
LET NEED_ENVS = ""
LET NEED_ENV_ANY = "CUBALC_EB_X\nCUBALC_EB_Y"
LET ENV_GUARD_SOFT = 1
INCLUDE env_boot
ASSERT ENV_GUARD_ANY_OK == 0
ASSERT ENV_GUARD_OK == 0

SYS ENV SET CUBALC_EB_X "1"
LET NEED_ENV_ANY = "CUBALC_EB_X\nCUBALC_EB_Y"
LET ENV_GUARD_SOFT = 1
INCLUDE env_boot
ASSERT ENV_GUARD_ANY_OK == 1
ASSERT ENV_GUARD_OK == 1

SYS ENV UNSET CUBALC_EB_X
SYS ENV UNSET CUBALC_EB_Y

PASS
PRINT "1384_env_boot: PASS"
