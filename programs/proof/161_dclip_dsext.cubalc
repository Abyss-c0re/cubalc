# Proof 161 — digit-9 dual-stack data-path: DCLIP8 DCLIP16 DSEXT8 DSEXT16
HOLD_FLASH 1
SCIENCE LOAD

# DCLIP8
CLEARSTACK
PUSH -1
PUSH 300
DCLIP8
POP y
POP x
ASSERT x == 0
ASSERT y == 255

CLEARSTACK
PUSH 128
PUSH 0
2CLIP8
POP y
POP x
ASSERT x == 128
ASSERT y == 0

# DCLIP16
CLEARSTACK
PUSH -10
PUSH 70000
DCLIP16
POP y
POP x
ASSERT x == 0
ASSERT y == 65535

CLEARSTACK
PUSH 1000
PUSH 65535
2CLIP16
POP y
POP x
ASSERT x == 1000
ASSERT y == 65535

# DSEXT8 — 0xFF → -1; 0x7F → 127
CLEARSTACK
PUSH 255
PUSH 127
DSEXT8
POP y
POP x
ASSERT x == -1
ASSERT y == 127

CLEARSTACK
PUSH 128
PUSH 0
2SEXT8
POP y
POP x
ASSERT x == -128
ASSERT y == 0

# DSEXT16
CLEARSTACK
PUSH 65535
PUSH 32768
DSEXT16
POP y
POP x
ASSERT x == -1
ASSERT y == -32768

CLEARSTACK
PUSH 1
PUSH 32767
2SEXT16
POP y
POP x
ASSERT x == 1
ASSERT y == 32767

# aliases
CLEARSTACK
PUSH 400
PUSH -5
PAIRCLIP8
POP y
POP x
ASSERT x == 255
ASSERT y == 0

CLEARSTACK
PUSH 0x80
PUSH 0x01
PAIRSEXT8
POP y
POP x
ASSERT x == -128
ASSERT y == 1

# soft fails
CLEARSTACK
DCLIP8
ASSERT OK == 0
CLEARSTACK
DCLIP16
ASSERT OK == 0
CLEARSTACK
DSEXT8
ASSERT OK == 0
CLEARSTACK
DSEXT16
ASSERT OK == 0
CLEARSTACK
PUSH 1
2CLIP8
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof161_dclip_dsext" LAST_N SP
