# Proof 187 — digit-7 dual-stack unsigned compare: DULT DULE DUGT DUGE
HOLD_FLASH 1
SCIENCE LOAD

# DULT: a b c d → (ua<uc) (ub<ud)
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 4
DULT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 2ULT equal → 0
CLEARSTACK
PUSH 7
PUSH 7
PUSH 7
PUSH 7
2ULT
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DULE
CLEARSTACK
PUSH 3
PUSH 9
PUSH 5
PUSH 9
DULE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# PAIRULE
CLEARSTACK
PUSH 10
PUSH 1
PUSH 10
PUSH 0
PAIRULE
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DUGT
CLEARSTACK
PUSH 8
PUSH 2
PUSH 3
PUSH 9
DUGT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 2UGT
CLEARSTACK
PUSH 5
PUSH 5
PUSH 5
PUSH 5
2UGT
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DUGE
CLEARSTACK
PUSH 4
PUSH 9
PUSH 4
PUSH 3
DUGE
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# PAIRUGT / PAIRUGE
CLEARSTACK
PUSH 1
PUSH 100
PUSH 2
PUSH 50
PAIRUGT
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 1
PUSH 100
PUSH 2
PUSH 50
PAIRUGE
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# unsigned: -1 is max → -1 ULT 5 → 0; 5 ULT -1 → 1
CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DULT
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DUGT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DULE
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH -1
PUSH 5
PUSH 5
PUSH -1
DUGE
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# S2ULT / STACK2UGE aliases
CLEARSTACK
PUSH 0
PUSH 10
PUSH 1
PUSH 10
S2ULT
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 10
PUSH 0
PUSH 10
PUSH 1
STACK2UGE
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
DULT
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DUGE
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof187_dult_duge" LAST_N SP
