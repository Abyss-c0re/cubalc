# Proof 417 — digit-8 stack signed clip: SCLIPS4 SCLIPS8 SCLIPS16
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLIPS4: 20 → 7
PUSH 20
SCLIPS4
ASSERT LAST_N == 7
POP

# CLIPS4: -20 → -8
PUSH 0
PUSH 20
SUB
CLIPS4
ASSERT LAST_N == -8
POP

# SCLIPS4 mid: 3 stays
PUSH 3
SCLIPS4
ASSERT LAST_N == 3
POP

# SCLIPS8: 200 → 127
PUSH 200
SCLIPS8
ASSERT LAST_N == 127
POP

# CLIPS8: -200 → -128
PUSH 0
PUSH 200
SUB
CLIPS8
ASSERT LAST_N == -128
POP

# SCLIPS8 mid: 50 stays
PUSH 50
SCLIPS8
ASSERT LAST_N == 50
POP

# SCLIPS16: 40000 → 32767
PUSH 40000
SCLIPS16
ASSERT LAST_N == 32767
POP

# CLIPS16: -40000 → -32768
PUSH 0
PUSH 40000
SUB
CLIPS16
ASSERT LAST_N == -32768
POP

# SCLIPS16 mid: 100 stays
PUSH 100
SCLIPS16
ASSERT LAST_N == 100
POP

# soft short stack OK=0
CLEARSTACK
SCLIPS4
ASSERT OK == 0

CLEARSTACK
SCLIPS8
ASSERT OK == 0

CLEARSTACK
SCLIPS16
ASSERT OK == 0

HOLD_FLASH 0
