# Proof 124 — digit-0 stack foundation: 4NIP 4ROT 4RROT 4OVER
HOLD_FLASH 1
SCIENCE LOAD

# 4NIP — a b c d → a d
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4NIP
ASSERT SP == 2
ASSERT LAST_N == 4
POP a
POP b
ASSERT b == 1
ASSERT a == 4

# QNIP alias
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
QNIP
POP a
POP b
ASSERT b == 10
ASSERT a == 40

# 4ROT — a b c d → b c d a
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4ROT
ASSERT SP == 4
ASSERT LAST_N == 1
POP a
POP b
POP c
POP d
ASSERT d == 2
ASSERT c == 3
ASSERT b == 4
ASSERT a == 1

# cycle four times = identity
CLEARSTACK
PUSH 5
PUSH 6
PUSH 7
PUSH 8
4ROT
4ROT
4ROT
4ROT
POP a
POP b
POP c
POP d
ASSERT d == 5
ASSERT c == 6
ASSERT b == 7
ASSERT a == 8

# 4RROT — a b c d → d a b c
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
4RROT
POP a
POP b
POP c
POP d
ASSERT d == 4
ASSERT c == 1
ASSERT b == 2
ASSERT a == 3

# 4RROT inverse of 4ROT
CLEARSTACK
PUSH 9
PUSH 8
PUSH 7
PUSH 6
4ROT
4RROT
POP a
POP b
POP c
POP d
ASSERT d == 9
ASSERT c == 8
ASSERT b == 7
ASSERT a == 6

# ROT4 / RROT4 aliases
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
ROT4
RROT4
POP a
POP b
POP c
POP d
ASSERT d == 1
ASSERT c == 2
ASSERT b == 3
ASSERT a == 4

# 4OVER — needs 8: copy under quartet
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
PUSH 6
PUSH 7
PUSH 8
4OVER
ASSERT SP == 12
ASSERT LAST_N == 4
POP a
POP b
POP c
POP d
ASSERT d == 1
ASSERT c == 2
ASSERT b == 3
ASSERT a == 4
POP a
ASSERT a == 8

# soft fails
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
4NIP
ASSERT OK == 0
4ROT
ASSERT OK == 0
4RROT
ASSERT OK == 0
4OVER
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof124_4nip_4rot" LAST_N SP
