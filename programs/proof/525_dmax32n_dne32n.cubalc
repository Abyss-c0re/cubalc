# Proof 525 — digit-5 dual-stack imm 32-bit field max+eq: DMAX32N DEQ32N DNE32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DMAX32N: max(0x10000000, 0xC0000000) → 0xC0000000 on both
PUSH 0x10000000
PUSH 0x20000000
DMAX32N 0xC0000000 0
POP y
POP x
ASSERT x == 0xC0000000
ASSERT y == 0xC0000000

# keeps larger
CLEARSTACK
PUSH 0xF0000000
PUSH 0xE0000000
PAIRMAX32N 0x20000000 0
POP y
POP x
ASSERT x == 0xF0000000
ASSERT y == 0xE0000000

# high preserved: low 0x7711 max 0x8000 → 0x8000 low
CLEARSTACK
PUSH 0x1122334400007711
PUSH 0x99AABBCC00007711
DMAX32N 0x8000 0
POP y
POP x
ASSERT x == 0x1122334400008000
ASSERT y == 0x99AABBCC00008000

# STACK2MAX32N n1: high 0x20000000 max 0x90000000 → high 0x90000000
CLEARSTACK
PUSH 0x2000000000000000
PUSH 0x1000000000000000
S2MAX32N 0x90000000 1
POP y
POP x
ASSERT x == 0x9000000000000000
ASSERT y == 0x9000000000000000

# DGE32N alias max equal
CLEARSTACK
PUSH 0x55555555
PUSH 0x55555555
DGE32N 0x55555555 0
POP y
POP x
ASSERT x == 0x55555555
ASSERT y == 0x55555555

# DEQ32N: equal → 1
CLEARSTACK
PUSH 0xABCD1234
PUSH 0xABCD1234
DEQ32N 0xABCD1234 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# unequal → 0
CLEARSTACK
PUSH 0xABCD1234
PUSH 0xABCD1235
PAIREQ32N 0xABCD1234 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# high preserved eq: low 0x7742 == 0x7742 → low 1
CLEARSTACK
PUSH 0x1122334400007742
PUSH 0x99AABBCC00007742
DEQ32N 0x7742 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000001

# STACK2EQ32N n1: high 0x77777777 == 0x77777777 → high 1
CLEARSTACK
PUSH 0x7777777700000000
PUSH 0x6666666600000000
S2EQ32N 0x77777777 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# DNE32N: unequal → 1
CLEARSTACK
PUSH 0x10000000
PUSH 0x10000001
DNE32N 0x10000000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# equal → 0
CLEARSTACK
PUSH 0x10000000
PUSH 0x10000000
PAIRNE32N 0x10000000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved ne: low 0x77FF != 0 → low 1
CLEARSTACK
PUSH 0x11223344000077FF
PUSH 0x99AABBCC00000000
DNE32N 0 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000000

# STACK2NE32N n1: high equal → 0
CLEARSTACK
PUSH 0x5555555500000000
PUSH 0x5555555500000000
S2NE32N 0x55555555 1
POP y
POP x
ASSERT x == 0x0000000000000000
ASSERT y == 0x0000000000000000

# DCMPEQ32N / DCMPNE32N aliases
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFE
DCMPEQ32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFE
DCMPNE32N 0xFFFFFFFE 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

HOLD_FLASH 0
