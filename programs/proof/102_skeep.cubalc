# Proof 102 — SKEEP / KEEPN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
SKEEP 2
ASSERT SP == 2
POP a
ASSERT a == 5
POP b
ASSERT b == 4
ASSERT SP == 0

CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
KEEPN 3
ASSERT SP == 3
POP x
ASSERT x == 30
POP y
ASSERT y == 20
POP z
ASSERT z == 10

CLEARSTACK
PUSH 7
PUSH 8
SKEEP 0
ASSERT SP == 0

CLEARSTACK
PUSH 9
SKEEP 5
ASSERT SP == 1
