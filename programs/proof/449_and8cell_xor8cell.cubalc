# Proof 449 — digit-1 cell fixed-width 8 bitwise: AND8CELL OR8CELL XOR8CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# AND8CELL: 0xFF & 0x0F → 0x0F; high bits ignored
CELLSET 0 255
CELLSET 1 511
AND8CELL 0 1 15
ASSERT CELL(0) == 15
ASSERT CELL(1) == 15
ASSERT LAST_N == 2

# OR8CELL: 0x0F | 0xF0 → 0xFF
CELLSET 2 15
OR8CELL 2 2 240
ASSERT CELL(2) == 255
ASSERT LAST_N == 1

# XOR8CELL: 0xFF ^ 0x0F → 0xF0
CELLSET 3 255
XOR8CELL 3 3 15
ASSERT CELL(3) == 240
ASSERT LAST_N == 1

# high bits above 8 ignored on both sides
# 256+1 (257) & 0xFF → 1
CELLSET 4 257
AND8CELL 4 4 255
ASSERT CELL(4) == 1

# 257 | 2 → 1|2 = 3
CELLSET 5 257
OR8CELL 5 5 2
ASSERT CELL(5) == 3

# XOR self → 0 (low8)
CELLSET 6 255
XOR8CELL 6 6 255
ASSERT CELL(6) == 0

# AND8RANGE alias
CELLSET 7 0xAB
AND8RANGE 7 7 0x0F
ASSERT CELL(7) == 11

# range OR: two cells
CELLSET 8 1
CELLSET 9 2
OR8CELL 8 9 4
ASSERT CELL(8) == 5
ASSERT CELL(9) == 6
ASSERT LAST_N == 2

# XOR8RANGE: 0xA5 ^ 0xFF → 0x5A = 90
CELLSET 10 0xA5
XOR8RANGE 10 10 255
ASSERT CELL(10) == 90

HOLD_FLASH 0
