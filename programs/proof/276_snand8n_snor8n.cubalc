# Proof 276 — digit-8 stack imm inverted 8-bit field: SNAND8N SNOR8N SXNOR8N
HOLD_FLASH 1
SCIENCE LOAD

# SNAND8N field n — byte = ~(byte & field) & 0xFF
CLEARSTACK
PUSH 0x1122334455667788
SNAND8N 0x0F 0
POP x
ASSERT x == 0x11223344556677F7

CLEARSTACK
PUSH 0x1122334455667788
STACKNAND8N 0x0F 1
POP x
ASSERT x == 0x112233445566F888

CLEARSTACK
PUSH -1
NAND8N 0xFF 0
POP x
ASSERT x == -256

# SNOR8N field n — byte = ~(byte | field) & 0xFF
CLEARSTACK
PUSH 0x1122334455667788
SNOR8N 0xF0 0
POP x
ASSERT x == 0x1122334455667707

CLEARSTACK
PUSH 0x1122334455667788
STACKNOR8N 0xF0 2
POP x
ASSERT x == 0x1122334455097788

CLEARSTACK
PUSH 0
NOR8N 0x00 0
POP x
ASSERT x == 0xFF

CLEARSTACK
PUSH 0
SINVERTOR8N 0xAB 3
POP x
ASSERT x == 0x54000000

# SXNOR8N field n — byte = ~(byte ^ field) & 0xFF
CLEARSTACK
PUSH 0x1122334455667788
SXNOR8N 0x0F 0
POP x
ASSERT x == 0x1122334455667778

CLEARSTACK
PUSH 0x1122334455667788
STACKXNOR8N 0x0F 7
POP x
ASSERT x == 0xE122334455667788

CLEARSTACK
PUSH 0
XNOR8N 0xAB 1
POP x
ASSERT x == 0x5400

CLEARSTACK
PUSH -1
SEQUIV8N 0x00 0
POP x
ASSERT x == -256

CLEARSTACK
PUSH -1
SXNOR8N 0xFF 0
POP x
ASSERT x == -1

# soft fails
CLEARSTACK
SNAND8N 1 0
ASSERT OK == 0
CLEARSTACK
SNOR8N 1 0
ASSERT OK == 0
CLEARSTACK
SXNOR8N 1 0
ASSERT OK == 0

HOLD_FLASH 1
