// HOLD_FLASH is device/mesh-join only — not a language PLUG gate.
// Ordinary programs need no HOLD_FLASH line (runtime default 1).

BUDGET 20
SHARE state_matrix_only

// Virtual cubes plug with no HOLD_FLASH preamble
CUBE a ROLE host PROTON 1
CUBE b ROLE body PROTON 1
SETBIT a 0 1
SETBIT a 1 1
SETBIT b 0 1
SETBIT b 2 1
PLUG a b
ASSERT OK == 1
ASSERT CUBES == 2

// Clearing sticky hold must NOT deny language PLUG
HOLD_FLASH 0
CUBE c ROLE atom PROTON 1
SETBIT c 0 1
PLUG a c
ASSERT OK == 1
ASSERT CUBES == 3

// Explicit re-arm is optional (device/mesh-join surfaces only)
HOLD_FLASH 1
ASSERT OK == 1

PRINT "hold_flash_plug" CUBES OK UNITY
ASSERT CUBES == 3
ASSERT UNITY >= 0
