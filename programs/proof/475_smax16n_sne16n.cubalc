# Proof 475 — digit-7 stack imm 16-bit field max+eq: SMAX16N SEQ16N SNE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SMAX16N: max(0x1000, 0xC000) → 0xC000
PUSH 0x1000
SMAX16N 0xC000 0
POP x
ASSERT x == 0xC000

# keeps larger
CLEARSTACK
PUSH 0xF000
MAX16N 0x2000 0
POP x
ASSERT x == 0xF000

# high preserved: 0x1122334400007711 max 0x8000 → 0x1122334400008000
CLEARSTACK
PUSH 0x1122334400007711
SMAX16N 0x8000 0
POP x
ASSERT x == 0x1122334400008000

# STACKMAX16N n1: half1 of 0x20000000 max 0x9000 → 0x90000000
CLEARSTACK
PUSH 0x20000000
STACKMAX16N 0x9000 1
POP x
ASSERT x == 0x90000000

# SGE16N alias max equal
CLEARSTACK
PUSH 0x5555
SGE16N 0x5555 0
POP x
ASSERT x == 0x5555

# SEQ16N: equal → 1
CLEARSTACK
PUSH 0xABCD
SEQ16N 0xABCD 0
POP x
ASSERT x == 1

# unequal → 0
CLEARSTACK
PUSH 0xABCD
EQ16N 0xABCE 0
POP x
ASSERT x == 0

# high preserved eq: 0x1122334400007742 == 0x7742 → 0x1122334400000001
CLEARSTACK
PUSH 0x1122334400007742
SEQ16N 0x7742 0
POP x
ASSERT x == 0x1122334400000001

# STACKEQ16N n1: half1 of 0x77770000 == 0x7777 → 0x00010000
CLEARSTACK
PUSH 0x77770000
STACKEQ16N 0x7777 1
POP x
ASSERT x == 0x00010000

# SNE16N: unequal → 1
CLEARSTACK
PUSH 0x1000
SNE16N 0x1001 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0x1000
NE16N 0x1000 0
POP x
ASSERT x == 0

# high preserved ne: 0x11223344000077FF != 0 → 0x1122334400000001
CLEARSTACK
PUSH 0x11223344000077FF
SNE16N 0 0
POP x
ASSERT x == 0x1122334400000001

# STACKNE16N n1: half1 of 0x55550000 != 0x5555 → 0
CLEARSTACK
PUSH 0x55550000
STACKNE16N 0x5555 1
POP x
ASSERT x == 0x00000000

# SCMPEQ16N / SCMPNE16N aliases
CLEARSTACK
PUSH 0xFFFF
SCMPEQ16N 0xFFFF 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x0000
SCMPNE16N 1 0
POP x
ASSERT x == 1

HOLD_FLASH 0
