# Proof 507 — digit-3 stack imm 16-bit field zeros+signed: SCLZ16N SCTZ16N SNEG16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLZ16N: 0→16 ; 1→15
PUSH 0x0
SCLZ16N 0
POP x
ASSERT x == 16

CLEARSTACK
PUSH 0x1
CLZ16N 0
POP x
ASSERT x == 15

# 0x8000→0 ; 0x0002→14
CLEARSTACK
PUSH 0x8000
SCLZ16N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x0002
SNLZ16N 0
POP x
ASSERT x == 14

# high preserved clz0→16
CLEARSTACK
PUSH 0x1122334455660000
SCLZ16N 0
POP x
ASSERT x == 0x1122334455660010

# STACKCLZ16N n1: 0x40000000 half1=0x4000 clz1 → 0x00010000
CLEARSTACK
PUSH 0x40000000
STACKCLZ16N 1
POP x
ASSERT x == 0x00010000

# SCTZ16N: 0→16 ; 1→0 ; 0x8000→15 ; 0x0006→1
CLEARSTACK
PUSH 0x0
SCTZ16N 0
POP x
ASSERT x == 16

CLEARSTACK
PUSH 0x1
CTZ16N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x8000
SCTZ16N 0
POP x
ASSERT x == 15

CLEARSTACK
PUSH 0x0006
SNTZ16N 0
POP x
ASSERT x == 1

# STACKCTZ16N n1: 0xC0000000 half1=C000 ctz14 → 0x000E0000
CLEARSTACK
PUSH 0xC0000000
STACKCTZ16N 1
POP x
ASSERT x == 0x000E0000

# SNEG16N: 3→0xFFFD ; 0xFFFE (-2)→2 ; min 0x8000 stays 0x8000
CLEARSTACK
PUSH 0x3
SNEG16N 0
POP x
ASSERT x == 65533

CLEARSTACK
PUSH 0xFFFE
SNEG16N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x8000
NEG16N 0
POP x
ASSERT x == 32768

CLEARSTACK
PUSH 0x1
SWORDNEGN 0
POP x
ASSERT x == 65535

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455665555
SNEG16N 0
POP x
ASSERT x == 0x112233445566AAAB

CLEARSTACK
PUSH 0x112233445566AAAB
SNEG16N 0
POP x
ASSERT x == 0x1122334455665555

# STACKNEG16N n1: 0x30000000 half1=0x3000 → -0x3000 = 0xD000 → 0xD0000000
CLEARSTACK
PUSH 0x30000000
STACKNEG16N 1
POP x
ASSERT x == 0xD0000000

# aliases
CLEARSTACK
PUSH 0x1000
SWORDCLZN 0
POP x
ASSERT x == 3

CLEARSTACK
PUSH 0x1000
SWORDCTZN 0
POP x
ASSERT x == 12

CLEARSTACK
PUSH 0x2
SINEG16N 0
POP x
ASSERT x == 65534

HOLD_FLASH 0
