# Proof 461 — digit-2 cell fixed-width 4 nibble unary/signed: NOT4CELL CLIPS4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NOT4CELL: ~0x0 as u4 = 15; ~0xF = 0; ~0x5 = 0xA = 10
CELLSET 0 0
CELLSET 1 15
CELLSET 2 5
NOT4CELL 0 2
ASSERT CELL(0) == 15
ASSERT CELL(1) == 0
ASSERT CELL(2) == 10
ASSERT LAST_N == 3

# high bits ignored: 0x15 → low4 0x5 → ~5 = 10
CELLSET 3 21
NOT4RANGE 3 3
ASSERT CELL(3) == 10

# double NOT4 restores low4
CELLSET 4 0xA
NOT4CELL 4 4
NOT4CELL 4 4
ASSERT CELL(4) == 10

# INV4CELL alias: ~0x3 = 0xC = 12
CELLSET 5 3
INV4CELL 5 5
ASSERT CELL(5) == 12

# CLIPS4CELL: clamp to [-8,7]
# -20 via SEXT16 of 0xFFEC
CELLSET 6 20
CELLSET 7 3
CELLSET 8 65516
SEXT16CELL 8 8
CLIPS4CELL 6 8
ASSERT CELL(6) == 7
ASSERT CELL(7) == 3
ASSERT CELL(8) == -8
ASSERT LAST_N == 3

# CLIPS4RANGE: -8 stays; 7 stays
CELLSET 9 65528
SEXT16CELL 9 9
CELLSET 10 7
CLIPS4RANGE 9 10
ASSERT CELL(9) == -8
ASSERT CELL(10) == 7
ASSERT LAST_N == 2

# SCLIP4CELL alias: 100 → 7
CELLSET 11 100
SCLIP4CELL 11 11
ASSERT CELL(11) == 7

# NOTNIBCELL alias
CELLSET 12 0
NOTNIBCELL 12 12
ASSERT CELL(12) == 15

# CLIPSNIBCELL: -1 stays (in range) via SEXT of 0xFFFF
CELLSET 13 65535
SEXT16CELL 13 13
CLIPSNIBCELL 13 13
ASSERT CELL(13) == -1

HOLD_FLASH 0
