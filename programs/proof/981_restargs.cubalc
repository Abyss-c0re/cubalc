# RESTARGS / POSITIONALS — non-flag CUBALC_ARGn bag after --flags
# Agents peel files without EACH + STARTS "-" glue

HOLD_FLASH 1

# empty
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV UNSET CUBALC_ARG3
SYS ENV SET CUBALC_ARGC "0"
RESTARGS
ASSERT LAST_N == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# pure positionals
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARG1 "b.txt"
SYS ENV SET CUBALC_ARGC "2"
RESTARGS
ASSERT LAST_N == 2
SYS NTH 0 LAST
SYS EQS LAST "a.txt"
ASSERT LAST_N == 1
RESTARGS
SYS NTH 1 LAST
SYS EQS LAST "b.txt"
ASSERT LAST_N == 1

# --flag=val + files (preferred value form)
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARG1 "in.txt"
SYS ENV SET CUBALC_ARG2 "out.txt"
SYS ENV SET CUBALC_ARGC "3"
RESTARGS
ASSERT LAST_N == 2
SYS NTH 0 LAST
SYS EQS LAST "in.txt"
ASSERT LAST_N == 1
RESTARGS
SYS NTH 1 LAST
SYS EQS LAST "out.txt"
ASSERT LAST_N == 1
GETFLAG mode
SYS EQS LAST "fast"
ASSERT LAST_N == 1

# --flag value consumes value; remaining positionals
SYS ENV SET CUBALC_ARG0 "--mode"
SYS ENV SET CUBALC_ARG1 "slow"
SYS ENV SET CUBALC_ARG2 "only.txt"
SYS ENV SET CUBALC_ARGC "3"
RESTARGS
ASSERT LAST_N == 1
SYS EQS LAST "only.txt"
ASSERT LAST_N == 1

# bare -- ends flags (bool before files)
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "--"
SYS ENV SET CUBALC_ARG2 "file.txt"
SYS ENV SET CUBALC_ARGC "3"
RESTARGS
ASSERT LAST_N == 1
SYS EQS LAST "file.txt"
ASSERT LAST_N == 1
HASFLAG verbose
ASSERT LAST_N == 1

# bare "-" stdin positional kept
SYS ENV SET CUBALC_ARG0 "-"
SYS ENV SET CUBALC_ARG1 "x"
SYS ENV SET CUBALC_ARGC "2"
POSITIONALS
ASSERT LAST_N == 2
SYS NTH 0 LAST
SYS EQS LAST "-"
ASSERT LAST_N == 1

PRINT "restargs ok"
