# SYS DUMPENV / ENVALL / LISTENV — process env as KEY=VAL newline bag
# Usability: agent env inventory without shell env|grep; dual of DOTENV

HOLD_FLASH 1

# plant known keys
SYS SETENV "CUBALC_DUMPENV_MI_A" "alpha"
ASSERT OK == 1
SYS SETENV "CUBALC_DUMPENV_MI_B" "beta gamma"
ASSERT OK == 1
SYS SETENV "CUBALC_DUMPENV_MI_C" "3"
ASSERT OK == 1

# prefix filter
SYS DUMPENV "CUBALC_DUMPENV_MI_"
ASSERT OK == 1
ASSERT LAST_N == 3
ASSERT DUMPENV_N == 3
ASSERT DUMPENV_TRUNC == 0

SYS HASLINE LAST "CUBALC_DUMPENV_MI_A=alpha"
ASSERT LAST_N == 1
SYS DUMPENV "CUBALC_DUMPENV_MI_"
SYS HASLINE LAST "CUBALC_DUMPENV_MI_B=beta gamma"
ASSERT LAST_N == 1
SYS DUMPENV "CUBALC_DUMPENV_MI_"
SYS HASLINE LAST "CUBALC_DUMPENV_MI_C=3"
ASSERT LAST_N == 1

# GREP needle-first on bag (filter KEY=VAL lines)
SYS DUMPENV "CUBALC_DUMPENV_MI_"
SYS GREP "MI_A=" LAST
ASSERT LAST_N == 1
SYS EQS LAST "CUBALC_DUMPENV_MI_A=alpha"
ASSERT LAST_N == 1

# aliases
SYS ENVALL "CUBALC_DUMPENV_MI_"
ASSERT OK == 1
ASSERT ENVALL_N == 3
SYS LISTENV "CUBALC_DUMPENV_MI_"
ASSERT OK == 1
ASSERT LISTENV_N == 3
SYS ENVDUMP "CUBALC_DUMPENV_MI_"
ASSERT OK == 1

# no match → empty soft OK
SYS DUMPENV "CUBALC_DUMPENV_NO_SUCH_PREFIX_ZZZ_"
ASSERT OK == 1
ASSERT LAST_N == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# full dump returns something (at least our keys; may include more)
SYS DUMPENV
ASSERT OK == 1
ASSERT LAST_N >= 3
SYS HASLINE LAST "CUBALC_DUMPENV_MI_A=alpha"
ASSERT LAST_N == 1

# prefix recorded
SYS DUMPENV "CUBALC_DUMPENV_MI_"
SYS EQS DUMPENV_PREFIX "CUBALC_DUMPENV_MI_"
ASSERT LAST_N == 1

# cleanup
SYS UNSETENV "CUBALC_DUMPENV_MI_A"
SYS UNSETENV "CUBALC_DUMPENV_MI_B"
SYS UNSETENV "CUBALC_DUMPENV_MI_C"

PRINT "sys_dumpenv ok"
