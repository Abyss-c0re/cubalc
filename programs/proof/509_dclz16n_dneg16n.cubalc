# Proof 509 — digit-1 dual-stack imm 16-bit field zeros+signed: DCLZ16N DCTZ16N DNEG16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DCLZ16N: 0→16 ; 1→15
PUSH 0x0
PUSH 0x1
DCLZ16N 0
POP y
POP x
ASSERT x == 16
ASSERT y == 15

# 0x8000→0 ; 0x0002→14
CLEARSTACK
PUSH 0x8000
PUSH 0x0002
PAIRCLZ16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 14

# high preserved clz0→16
CLEARSTACK
PUSH 0x1122334455660000
PUSH 0x99AABBCCDDEE0001
DCLZ16N 0
POP y
POP x
ASSERT x == 0x1122334455660010
ASSERT y == 0x99AABBCCDDEE000F

# S2CLZ16N n1: 0x40000000 half1=0x4000 clz1 → 0x00010000
CLEARSTACK
PUSH 0x40000000
PUSH 0x20000000
S2CLZ16N 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00020000

# DCTZ16N: 0→16 ; 1→0 ; 0x8000→15 ; 0x0006→1
CLEARSTACK
PUSH 0x0
PUSH 0x1
DCTZ16N 0
POP y
POP x
ASSERT x == 16
ASSERT y == 0

CLEARSTACK
PUSH 0x8000
PUSH 0x0006
PAIRCTZ16N 0
POP y
POP x
ASSERT x == 15
ASSERT y == 1

# STACK2CTZ16N n1: 0xC0000000 half1=C000 ctz14 → 0x000E0000
CLEARSTACK
PUSH 0xC0000000
PUSH 0xA0000000
STACK2CTZ16N 1
POP y
POP x
ASSERT x == 0x000E0000
ASSERT y == 0x000D0000

# DNEG16N: 3→0xFFFD ; 0xFFFE (-2)→2 ; min 0x8000 stays 0x8000
CLEARSTACK
PUSH 0x3
PUSH 0xFFFE
DNEG16N 0
POP y
POP x
ASSERT x == 65533
ASSERT y == 2

CLEARSTACK
PUSH 0x8000
PUSH 0x1
PAIRNEG16N 0
POP y
POP x
ASSERT x == 32768
ASSERT y == 65535

# high preserved double-neg
CLEARSTACK
PUSH 0x1122334455665555
PUSH 0x99AABBCCDDEE0003
DNEG16N 0
POP y
POP x
ASSERT x == 0x112233445566AAAB
ASSERT y == 0x99AABBCCDDEEFFFD

CLEARSTACK
PUSH 0x112233445566AAAB
PUSH 0x99AABBCCDDEEFFFD
DNEG16N 0
POP y
POP x
ASSERT x == 0x1122334455665555
ASSERT y == 0x99AABBCCDDEE0003

# S2NEG16N n1: 0x30000000 half1=0x3000 → -0x3000 = 0xD000 → 0xD0000000
CLEARSTACK
PUSH 0x30000000
PUSH 0x20000000
S2NEG16N 1
POP y
POP x
ASSERT x == 0xD0000000
ASSERT y == 0xE0000000

# aliases
CLEARSTACK
PUSH 0x1000
PUSH 0x1000
DNLZ16N 0
POP y
POP x
ASSERT x == 3
ASSERT y == 3

CLEARSTACK
PUSH 0x1000
PUSH 0x1000
DNTZ16N 0
POP y
POP x
ASSERT x == 12
ASSERT y == 12

CLEARSTACK
PUSH 0x2
PUSH 0x2
DINEG16N 0
POP y
POP x
ASSERT x == 65534
ASSERT y == 65534

HOLD_FLASH 0
