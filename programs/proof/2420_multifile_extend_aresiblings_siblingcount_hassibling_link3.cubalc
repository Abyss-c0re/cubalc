# Proof 2420 — MULTIFILE_EXTEND_ARESIBLINGS_SIBLINGCOUNT_HASSIBLING_LINK3
# Multi-file CLASS EXTEND + ARESIBLINGS/ISSIBLING + SIBLINGCOUNT + HASSIBLING.
# Complements CHILDRANK + NEXT/PREVSIBLING + ONLYCHILD + SIBLINGS bag.
# Cube is SoT. Free energy must flow. Meaningful growth only.
REQUIRE VERSION "1.15"
HOLD_FLASH 1

INCLUDE demo_greeter_base
ASSERT OK == 1
INCLUDE demo_greeter_extend
ASSERT OK == 1
INCLUDE demo_greeter_override
ASSERT OK == 1
INCLUDE demo_greeter_loudtag
ASSERT OK == 1

HASCLASS Greeter
ASSERT LAST_N == 1
HASCLASS TagGreeter
ASSERT LAST_N == 1
HASCLASS LoudTag
ASSERT LAST_N == 1

# Peer lattice: Greeter kids = TagGreeter, TwinGreet
# TagGreeter kids = LoudTag, SoftTag ; SoftTag kid = DeepLeaf ; Solo root
CLASS TwinGreet EXTEND Greeter
  FIELD twin 1
  METHOD ping
    RET 1
  END
END
HASCLASS TwinGreet
ASSERT LAST_N == 1

CLASS SoftTag EXTEND TagGreeter
  FIELD soft 1
  METHOD hush
    RET 0
  END
END
HASCLASS SoftTag
ASSERT LAST_N == 1

CLASS Solo
  FIELD x 1
  METHOD ping
    RET 1
  END
END
HASCLASS Solo
ASSERT LAST_N == 1

CLASS DeepLeaf EXTEND SoftTag
  FIELD deep 1
  METHOD z
    RET 1
  END
END
HASCLASS DeepLeaf
ASSERT LAST_N == 1

# ---- SIBLINGCOUNT (peers under same parent, excl self) ----
# Greeter kids: TagGreeter, TwinGreet → each has 1 sibling
SIBLINGCOUNT TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT SIBLINGCOUNT_N == 1
ASSERT SIBLINGCOUNT == 1

SIBLINGCOUNT TwinGreet
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT SIBLINGCOUNT_N == 1

# TagGreeter kids: LoudTag, SoftTag → each has 1 sibling
SIBLINGCOUNT LoudTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT SIBLINGCOUNT_N == 1

SIBLINGCOUNT SoftTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT SIBLINGCOUNT_N == 1

# SoftTag only child DeepLeaf → 0 siblings
SIBLINGCOUNT DeepLeaf
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT SIBLINGCOUNT_N == 0

# roots soft 0
SIBLINGCOUNT Greeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT SIBLINGCOUNT_N == 0

SIBLINGCOUNT Solo
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT SIBLINGCOUNT_N == 0

COUNTSIBLINGS TagGreeter
ASSERT LAST_N == 1
NUMSIBLINGS TwinGreet
ASSERT LAST_N == 1
PEERCOUNT LoudTag
ASSERT LAST_N == 1
NSIBLINGS SoftTag
ASSERT LAST_N == 1

# ---- HASSIBLING ----
HASSIBLING TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT HASSIBLING_N == 1
ASSERT HASSIBLING == 1

HASSIBLING TwinGreet
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT HASSIBLING_N == 1

HASSIBLING LoudTag
ASSERT LAST_N == 1
ASSERT HASSIBLING_N == 1

HASSIBLING SoftTag
ASSERT LAST_N == 1

HASSIBLING DeepLeaf
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT HASSIBLING_N == 0

HASSIBLING Greeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT HASSIBLING_N == 0

HASSIBLING Solo
ASSERT LAST_N == 0

HASSIBLINGS TagGreeter
ASSERT LAST_N == 1
HASPEER TwinGreet
ASSERT LAST_N == 1
HASPEERS LoudTag
ASSERT LAST_N == 1

# ---- ARESIBLINGS two-arg peer gate ----
# TagGreeter ↔ TwinGreet share Greeter
ARESIBLINGS TagGreeter TwinGreet
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ARESIBLINGS_N == 1
ASSERT ARESIBLINGS == 1
ASSERT ISSIBLING_N == 1

ARESIBLINGS TwinGreet TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ARESIBLINGS_N == 1

# LoudTag ↔ SoftTag share TagGreeter
ARESIBLINGS LoudTag SoftTag
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT ARESIBLINGS_N == 1

ARESIBLINGS SoftTag LoudTag
ASSERT LAST_N == 1

# not siblings: different parents / chain levels
ARESIBLINGS TagGreeter LoudTag
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ARESIBLINGS_N == 0

ARESIBLINGS TwinGreet SoftTag
ASSERT LAST_N == 0
ASSERT ARESIBLINGS_N == 0

ARESIBLINGS LoudTag DeepLeaf
ASSERT LAST_N == 0
ASSERT ARESIBLINGS_N == 0

ARESIBLINGS Greeter Solo
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ARESIBLINGS_N == 0

# self-pair soft 0
ARESIBLINGS TagGreeter TagGreeter
ASSERT OK == 1
ASSERT LAST_N == 0
ASSERT ARESIBLINGS_N == 0

ARESIBLINGS DeepLeaf DeepLeaf
ASSERT LAST_N == 0

# root not sibling of its child
ARESIBLINGS Greeter TagGreeter
ASSERT LAST_N == 0
ASSERT ARESIBLINGS_N == 0

ARESIBLINGS SoftTag DeepLeaf
ASSERT LAST_N == 0

# aliases
ISSIBLING TagGreeter TwinGreet
ASSERT LAST_N == 1
ASSERT ISSIBLING_N == 1

SIBLINGOF LoudTag SoftTag
ASSERT LAST_N == 1
ASSERT SIBLINGOF_N == 1

PEEROF TwinGreet TagGreeter
ASSERT LAST_N == 1
ASSERT PEEROF_N == 1

ISPEEROF SoftTag LoudTag
ASSERT LAST_N == 1

ARE_SIBLINGS TagGreeter TwinGreet
ASSERT LAST_N == 1

IS_SIBLING LoudTag SoftTag
ASSERT LAST_N == 1

SHAREPARENT_P TagGreeter TwinGreet
ASSERT LAST_N == 1

SAMEPARENT_P LoudTag SoftTag
ASSERT LAST_N == 1

COSIBLING TwinGreet TagGreeter
ASSERT LAST_N == 1

# negative aliases
ISSIBLING TagGreeter LoudTag
ASSERT LAST_N == 0
SIBLINGOF Greeter Solo
ASSERT LAST_N == 0
PEEROF DeepLeaf SoftTag
ASSERT LAST_N == 0

# coherence: HASSIBLING iff SIBLINGCOUNT > 0; ARESIBLINGS implies both have siblings
HASSIBLING TagGreeter
ASSERT HASSIBLING_N == 1
SIBLINGCOUNT TagGreeter
ASSERT SIBLINGCOUNT_N == 1
ARESIBLINGS TagGreeter TwinGreet
ASSERT ARESIBLINGS_N == 1

HASSIBLING DeepLeaf
ASSERT HASSIBLING_N == 0
SIBLINGCOUNT DeepLeaf
ASSERT SIBLINGCOUNT_N == 0

# CHILDRANK coherence with peer lattice
CHILDRANK TagGreeter
ASSERT CHILDRANK_N == 0
CHILDRANK TwinGreet
ASSERT CHILDRANK_N == 1
CHILDRANK LoudTag
ASSERT CHILDRANK_N == 0
CHILDRANK SoftTag
ASSERT CHILDRANK_N == 1

PRINT "2420 ARESIBLINGS+SIBLINGCOUNT+HASSIBLING PASS"
