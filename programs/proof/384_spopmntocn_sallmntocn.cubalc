# Proof 384 — digit-9 imm low-n metric TOC: SPOPMNTOCN SANYMNTOCN SALLMNTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOPMNTOCN: popcount low-4 of 0b1101 = 13 → 3
CELLSET 1 13
PUSH 1
SPOPMNTOCN 4
ASSERT LAST_N == 3
ASSERT CELL(1) == 3
POP a
ASSERT a == 3

# POPMNTOCN n=0 → 0
CELLSET 2 255
PUSH 2
POPMNTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SANYMNTOCN: low-3 of 8=0b1000 → 0; of 9=0b1001 → 1
CELLSET 3 8
PUSH 3
SANYMNTOCN 3
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP
CELLSET 4 9
PUSH 4
ANYMNTOCN 3
ASSERT LAST_N == 1
ASSERT CELL(4) == 1
POP

# SALLMNTOCN: low-4 of 15=0xF → 1; of 7 → 0
CELLSET 5 15
PUSH 5
SALLMNTOCN 4
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP
CELLSET 6 7
PUSH 6
ALLMNTOCN 4
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# n=0 vacuous all → 1
CELLSET 7 0
PUSH 7
SALLMNTOCN 0
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# soft empty OK=0
CLEARSTACK
SPOPMNTOCN 3
ASSERT OK == 0

PRINT "384_spopmntocn_sallmntocn OK"
