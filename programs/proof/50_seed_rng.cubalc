# Proof 50 — digit-6 SEED/RNG control: SEED GETSEED SSEED SRAND SGETSEED
HOLD_FLASH 1
SCIENCE LOAD

# SEED statement + GETSEED
SEED 42
GETSEED
ASSERT LAST_N == 42
ASSERT GETSEED() == 42
ASSERT RNG() == 42

# SEED(0) maps to 1
ASSERT SEED(0) == 1
ASSERT GETSEED() == 1

# deterministic replay: same seed → same first draw
SEED 99
RAND 1000
LET a = LAST_N
SEED 99
RAND 1000
LET b = LAST_N
ASSERT a == b
ASSERT a >= 0
ASSERT a < 1000

# different seeds → typically different (xorshift)
SEED 1
RAND 1000000
LET c = LAST_N
SEED 2
RAND 1000000
LET d = LAST_N
ASSERT c != d

# expr SEED returns seed used
ASSERT SEED(12345) == 12345
ASSERT RNG() == 12345

# stack SSEED / SGETSEED
CLEARSTACK
PUSH 777
SSEED
ASSERT LAST_N == 777
SGETSEED
ASSERT LAST_N == 777
ASSERT SP == 1

# stack SRAND
CLEARSTACK
SEED 5
PUSH 10
SRAND
ASSERT LAST_N >= 0
ASSERT LAST_N < 10
# replay via stack seed
CLEARSTACK
PUSH 5
STACKSEED
PUSH 10
STACKRAND
LET e = LAST_N
CLEARSTACK
PUSH 5
SSEED
PUSH 10
SRND
LET f = LAST_N
ASSERT e == f

# SRAND max<=0 → range 10
CLEARSTACK
SEED 11
PUSH 0
SRAND
ASSERT LAST_N >= 0
ASSERT LAST_N < 10

# underflow
CLEARSTACK
SSEED
ASSERT OK == 0
CLEARSTACK
SRAND
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof50_seed_rng" LAST_N SP
