# Proof 264 — digit-7 dual-stack imm 16-bit halfword field: DWORDN DSET16N DCLR16N
HOLD_FLASH 1
SCIENCE LOAD

# DWORDN n
CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
DWORDN 0
POP y
POP x
ASSERT x == 0xCCDD
ASSERT y == 0x3344

CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
PAIRWORDN 1
POP y
POP x
ASSERT x == 0xAABB
ASSERT y == 0x1122

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DGET16N 0
POP y
POP x
ASSERT x == 0x7788
ASSERT y == 0xFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DHALFN 1
POP y
POP x
ASSERT x == 0x5566
ASSERT y == 0xDDEE

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
STACK2WORDN 2
POP y
POP x
ASSERT x == 0x3344
ASSERT y == 0xBBCC

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
S2WORDN 3
POP y
POP x
ASSERT x == 0x1122
ASSERT y == 0x99AA

# clamp index
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DWORDN 99
POP y
POP x
ASSERT x == 0x1122
ASSERT y == 0x99AA

# DSET16N field n
CLEARSTACK
PUSH 0
PUSH -1
DSET16N 0xABCD 0
POP y
POP x
ASSERT x == 0xABCD
# -1 with halfword0=ABCD → 0xFFFFFFFFFFFFABCD
ASSERT y == -21555

CLEARSTACK
PUSH 0
PUSH 0
PAIRSET16N 0x1234 1
POP y
POP x
ASSERT x == 0x12340000
ASSERT y == 0x12340000

CLEARSTACK
PUSH -1
PUSH -1
DSETWORDN 0 2
POP y
POP x
# clear halfword 2 (bits 32..47): -1 & ~0xFFFF00000000
ASSERT x == -281470681743361
ASSERT y == -281470681743361

CLEARSTACK
PUSH 0
PUSH 0
DPUT16N 0xFFFF 3
POP y
POP x
ASSERT x == -281474976710656
ASSERT y == -281474976710656

# DCLR16N n
CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
DCLR16N 0
POP y
POP x
ASSERT x == 0xAABB0000
ASSERT y == 0x11220000

CLEARSTACK
PUSH 0xAABBCCDD
PUSH 0x11223344
PAIRCLR16N 1
POP y
POP x
ASSERT x == 0x0000CCDD
ASSERT y == 0x00003344

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DZAP16N 2
POP y
POP x
ASSERT x == 0x1122000055667788
ASSERT y == 0x99AA0000DDEEFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DCLRWORDN 3
POP y
POP x
ASSERT x == 0x0000334455667788
ASSERT y == 0x0000BBCCDDEEFF00

# soft fails
CLEARSTACK
DWORDN 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSET16N 2 0
ASSERT OK == 0
CLEARSTACK
DCLR16N 0
ASSERT OK == 0

HOLD_FLASH 1
