# FILLP / SUBSTPLATE — expand {{key}} from PLATE into agent templates
# Usability: status/log/path strings without GETP+REPLACEALL chains.

HOLD_FLASH 1

LET PLATE = "{}"
SETP "name" "alice"
SETP "host" "cube1"
SETP "n" 7
SETP "role" "worker"

# --- basic multi-key fill ---
FILLP "peer {{name}}@{{host}} role={{role}} n={{n}}"
ASSERT OK == 1
ASSERT FILLP_N == 4
ASSERT FILLP_MISS == 0
SYS EQS LAST "peer alice@cube1 role=worker n=7"
ASSERT LAST_N == 1

# aliases
SUBSTPLATE "hi {{name}}"
SYS EQS LAST "hi alice"
ASSERT LAST_N == 1
EXPANDP "n={{n}}"
SYS EQS LAST "n=7"
ASSERT LAST_N == 1
TEMPLATEP "{{role}}"
SYS EQS LAST "worker"
ASSERT LAST_N == 1

# --- missing key soft empty + MISS count ---
FILLP "x={{missing}} y={{name}}"
ASSERT OK == 1
ASSERT FILLP_N == 2
ASSERT FILLP_MISS == 1
SYS EQS LAST "x= y=alice"
ASSERT LAST_N == 1

# --- bare FILLP uses prior LAST as template ---
LET t = "host={{host}}"
# put template in LAST
SYS CAT "" t
FILLP
SYS EQS LAST "host=cube1"
ASSERT LAST_N == 1
ASSERT FILLP_N == 1

# --- no slots ---
FILLP "plain text"
ASSERT FILLP_N == 0
ASSERT FILLP_MISS == 0
SYS EQS LAST "plain text"
ASSERT LAST_N == 1

# --- incomplete brace stays literal ---
FILLP "keep {{name"
SYS HAS LAST "{{name"
ASSERT LAST_N == 1
SYS HAS LAST "keep"
ASSERT LAST_N == 1

# --- empty PLATE ---
LET PLATE = "{}"
FILLP "a={{name}}"
ASSERT FILLP_N == 1
ASSERT FILLP_MISS == 1
SYS EQS LAST "a="
ASSERT LAST_N == 1

# --- path-ish template for agent plates ---
LET PLATE = "{}"
SETP "agent" "hive-01"
SETP "tick" 42
FILLP "state/{{agent}}/tick-{{tick}}.json"
SYS EQS LAST "state/hive-01/tick-42.json"
ASSERT LAST_N == 1

PRINT "fillp ok"

# --- present empty string is hit not miss ---
LET PLATE = "{}"
SETP "empty" ""
SETP "name" "z"
FILLP "[{{empty}}]{{name}}"
ASSERT FILLP_N == 2
ASSERT FILLP_MISS == 0
SYS EQS LAST "[]z"
ASSERT LAST_N == 1
