# Proof 476 — digit-2 dual-stack imm 16-bit field arith: DADD16N DSUB16N DMUL16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DADD16N: half0 of pair + 0x0200
PUSH 0x1000
PUSH 0x0300
DADD16N 0x200 0
POP y
POP x
ASSERT x == 0x1200
ASSERT y == 0x0500

# wrap add: 0xFFFF + 2 → 0x0001 both
CLEARSTACK
PUSH 0xFFFF
PUSH 0xFFFF
PAIRADD16N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# high half preserved: half0 add 0x55
CLEARSTACK
PUSH 0x1122334400001000
PUSH 0x99AABBCC00002000
DADD16N 0x55 0
POP y
POP x
ASSERT x == 0x1122334400001055
ASSERT y == 0x99AABBCC00002055

# S2ADD16N n1: half1 of each + 0x30
CLEARSTACK
PUSH 0x00020000
PUSH 0x00040000
S2ADD16N 0x30 1
POP y
POP x
ASSERT x == 0x00320000
ASSERT y == 0x00340000

# DINC16N alias add
CLEARSTACK
PUSH 0xFFFE
PUSH 0x0001
DINC16N 1 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 2

# DSUB16N: half0 - field
CLEARSTACK
PUSH 0x0500
PUSH 0x0400
DSUB16N 0x100 0
POP y
POP x
ASSERT x == 0x0400
ASSERT y == 0x0300

# wrap borrow: 0x0001 - 2 → 0xFFFF
CLEARSTACK
PUSH 0x0001
PUSH 0x0000
PAIRSUB16N 2 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 65534

# STACK2SUB16N n1: half1 of 0x50000000 / 0x30000000 - 0x1000
CLEARSTACK
PUSH 0x50000000
PUSH 0x30000000
STACK2SUB16N 0x1000 1
POP y
POP x
ASSERT x == 0x40000000
ASSERT y == 0x20000000

# DDEC16N alias sub
CLEARSTACK
PUSH 0x0000
PUSH 0x0005
DDEC16N 1 0
POP y
POP x
ASSERT x == 65535
ASSERT y == 4

# DMUL16N: half0 * field
CLEARSTACK
PUSH 0x0010
PUSH 0x0020
DMUL16N 0x10 0
POP y
POP x
ASSERT x == 0x0100
ASSERT y == 0x0200

# wrap mul: 0x0100 * 0x0100 → 0
CLEARSTACK
PUSH 0x0100
PUSH 0x0200
PAIRMUL16N 0x100 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# zero annihilator
CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
DMUL16N 0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved mul: half0 * 5
CLEARSTACK
PUSH 0x1122334400000003
PUSH 0x99AABBCC00000007
DMUL16N 5 0
POP y
POP x
ASSERT x == 0x112233440000000F
ASSERT y == 0x99AABBCC00000023

# S2MUL16N n1: half1 of each * 3
CLEARSTACK
PUSH 0x00040000
PUSH 0x00050000
S2MUL16N 3 1
POP y
POP x
ASSERT x == 0x000C0000
ASSERT y == 0x000F0000

# DTIMES16N alias mul
CLEARSTACK
PUSH 0x0006
PUSH 0x0007
DTIMES16N 4 0
POP y
POP x
ASSERT x == 24
ASSERT y == 28

# round-trip add then sub on pair
CLEARSTACK
PUSH 0xA55A
PUSH 0x1234
DADD16N 0x11 0
DSUB16N 0x11 0
POP y
POP x
ASSERT x == 0xA55A
ASSERT y == 0x1234

HOLD_FLASH 0
