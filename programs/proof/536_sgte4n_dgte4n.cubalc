# Proof 536 — digit-1 stack+dual imm 4-bit field GTE: SGTE4N DGTE4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SGTE4N: greater → 1
PUSH 0xC
SGTE4N 0x2 0
POP x
ASSERT x == 1

# equal → 1
CLEARSTACK
PUSH 0x5
GTE4N 0x5 0
POP x
ASSERT x == 1

# less → 0
CLEARSTACK
PUSH 0x1
SGTE4N 0x2 0
POP x
ASSERT x == 0

# other nibbles preserved: nibble0 0x8 >= 0x1 → 1
CLEARSTACK
PUSH 0x9A8
SGTE4N 0x1 0
POP x
ASSERT x == 0x9A1

# STACKGTE4N n1: nibble1 0x3 >= 0x2 → 1
CLEARSTACK
PUSH 0x0030
STACKGTE4N 0x2 1
POP x
ASSERT x == 0x0010

# nibble1 0x1 >= 0x2 → 0
CLEARSTACK
PUSH 0x0010
SGTE4N 0x2 1
POP x
ASSERT x == 0x0000

# n2
CLEARSTACK
PUSH 0x0F00
SGTE4N 0x8 2
POP x
ASSERT x == 0x0100

# SCMPGE4N / SGEQ4N
CLEARSTACK
PUSH 2
SCMPGE4N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 1
SGEQ4N 2 0
POP x
ASSERT x == 0

# unsigned high nibble bit: 0x8 >= 0x7 → 1
CLEARSTACK
PUSH 0x8
SGTE4N 0x7 0
POP x
ASSERT x == 1

# DGTE4N dual
CLEARSTACK
PUSH 0xC
PUSH 0x1
DGTE4N 0x2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal both
CLEARSTACK
PUSH 0x5
PUSH 0x5
PAIRGTE4N 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# less both
CLEARSTACK
PUSH 0x1
PUSH 0x0
DGTE4N 0x2 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved dual: nibble0
CLEARSTACK
PUSH 0x9A8
PUSH 0x123
DGTE4N 0x1 0
POP y
POP x
ASSERT x == 0x9A1
ASSERT y == 0x121

# S2GTE4N n1
CLEARSTACK
PUSH 0x0030
PUSH 0x0010
S2GTE4N 0x2 1
POP y
POP x
ASSERT x == 0x0010
ASSERT y == 0x0000

# DCMPGE4N / DGEQ4N
CLEARSTACK
PUSH 2
PUSH 1
DCMPGE4N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 1
PUSH 3
DGEQ4N 2 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# unsigned dual: 0x8 >= 0x7 → 1
CLEARSTACK
PUSH 0x8
PUSH 0x7
DGTE4N 0x7 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

HOLD_FLASH 0
