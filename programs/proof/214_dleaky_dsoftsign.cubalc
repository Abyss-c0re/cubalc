# Proof 214 — digit-6 dual-stack energy soft activations: DLEAKY DSOFTSIGN
HOLD_FLASH 1
SCIENCE LOAD

# DLEAKY: pass positive / quarter negative
CLEARSTACK
PUSH 8
PUSH -8
DLEAKY
POP y
POP x
ASSERT x == 8
ASSERT y == -2

CLEARSTACK
PUSH 0
PUSH -3
2LEAKY
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# PAIRLEAKY / DLEAKYRELU / STACK2LEAKY
CLEARSTACK
PUSH 5
PUSH -4
PAIRLEAKY
POP y
POP x
ASSERT x == 5
ASSERT y == -1

CLEARSTACK
PUSH -1
PUSH 12
DLEAKYRELU
POP y
POP x
ASSERT x == 0
ASSERT y == 12

CLEARSTACK
PUSH -16
PUSH -5
STACK2LEAKY
POP y
POP x
ASSERT x == -4
ASSERT y == -1

# DSOFTSIGN: soft energy plane (-100,100)
CLEARSTACK
PUSH 0
PUSH 100
DSOFTSIGN
POP y
POP x
ASSERT x == 0
ASSERT y == 50

CLEARSTACK
PUSH -100
PUSH 25
2SOFTSIGN
POP y
POP x
ASSERT x == -50
ASSERT y == 20

# PAIRSOFTSIGN / DSOFTSGN / STACK2SOFTSIGN
CLEARSTACK
PUSH 300
PUSH -300
PAIRSOFTSIGN
POP y
POP x
ASSERT x == 75
ASSERT y == -75

CLEARSTACK
PUSH 1
PUSH -1
DSOFTSGN
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 900
PUSH 0
STACK2SOFTSIGN
POP y
POP x
ASSERT x == 90
ASSERT y == 0
