# INCLUDE arg_guard — multi program-arg ALL + ANY contract (env_guard twin for args)

HOLD_FLASH 1

# clear args
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV UNSET CUBALC_AG_FILE
SYS ENV SET CUBALC_ARGC "0"

# --- skip both gates when empty ---
DEFAULT NEED_ARGS = ""
DEFAULT NEED_ARG_ANY = ""
DEFAULT ARG_GUARD_SOFT = 0
INCLUDE arg_guard
ASSERT ARG_GUARD_OK == 1
ASSERT ARG_GUARD_ALL_OK == 1
ASSERT ARG_GUARD_ANY_OK == 1

# --- soft ALL miss ---
LET NEED_ARGS = "0\n1"
LET NEED_ARG_ANY = ""
LET ARG_GUARD_SOFT = 1
INCLUDE arg_guard
ASSERT ARG_GUARD_OK == 0
ASSERT ARG_GUARD_ALL_OK == 0
ASSERT ARGMISS_N >= 1
SYS HASLINE ARGMISS "0"
ASSERT LAST_N == 1
CLEAR_ERR

# --- soft ALL hit ---
SYS ENV SET CUBALC_ARG0 "a.txt"
SYS ENV SET CUBALC_ARG1 "b.txt"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_ARGS = "0\n1"
LET ARG_GUARD_SOFT = 1
INCLUDE arg_guard
ASSERT ARG_GUARD_ALL_OK == 1
ASSERT ARG_GUARD_OK == 1

# --- soft ANY miss ---
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_AG_FILE
LET NEED_ARGS = ""
LET NEED_ARG_ANY = "0\nCUBALC_AG_FILE"
LET ARG_GUARD_SOFT = 1
INCLUDE arg_guard
ASSERT ARG_GUARD_ANY_OK == 0
ASSERT ARG_GUARD_OK == 0
ASSERT ARGMISS_N >= 1
CLEAR_ERR

# --- soft ANY hit with one ---
SYS ENV SET CUBALC_AG_FILE "x"
LET NEED_ARG_ANY = "0\nCUBALC_AG_FILE"
LET ARG_GUARD_SOFT = 1
INCLUDE arg_guard
ASSERT ARG_GUARD_ANY_OK == 1
ASSERT ARG_GUARD_OK == 1
SYS HASLINE ARGHAVE "CUBALC_AG_FILE"
ASSERT LAST_N == 1
CLEAR_ERR

# --- hard ALL path ---
SYS ENV SET CUBALC_ARG0 "a"
SYS ENV SET CUBALC_ARG1 "b"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_ARGS = "0\n1"
LET NEED_ARG_ANY = ""
LET ARG_GUARD_SOFT = 0
INCLUDE arg_guard
ASSERT ARG_GUARD_OK == 1

# --- hard ANY path ---
SYS ENV SET CUBALC_ARG0 "only"
SYS ENV SET CUBALC_ARGC "1"
LET NEED_ARGS = ""
LET NEED_ARG_ANY = "0\n1"
LET ARG_GUARD_SOFT = 0
INCLUDE arg_guard
ASSERT ARG_GUARD_ANY_OK == 1
ASSERT ARG_GUARD_OK == 1

# --- combined ALL + ANY soft ---
SYS ENV SET CUBALC_ARG0 "a"
SYS ENV SET CUBALC_ARG1 "b"
SYS ENV SET CUBALC_ARGC "2"
SYS ENV SET CUBALC_AG_FILE "f"
LET NEED_ARGS = "0\n1"
LET NEED_ARG_ANY = "CUBALC_AG_FILE\n9"
LET ARG_GUARD_SOFT = 1
INCLUDE arg_guard
ASSERT ARG_GUARD_ALL_OK == 1
ASSERT ARG_GUARD_ANY_OK == 1
ASSERT ARG_GUARD_OK == 1

# discoverable
HASFORM HASARGALL
ASSERT LAST_N == 1
HASFORM HASARGANY
ASSERT LAST_N == 1
HASLIB arg_guard
ASSERT LAST_N == 1

SYS ENV UNSET CUBALC_AG_FILE
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"

PRINT "1388_arg_guard ok"
PASS
