# Proof 175 — digit-2 dual-stack modular: DADDMOD DSUBMOD
HOLD_FLASH 1
SCIENCE LOAD

# DADDMOD: a b c d ma mb → (a+c)%ma (b+d)%mb
CLEARSTACK
PUSH 10
PUSH 7
PUSH 3
PUSH 5
PUSH 8
PUSH 6
DADDMOD
POP y
POP x
ASSERT x == 5
ASSERT y == 0

# wrap
CLEARSTACK
PUSH 9
PUSH 8
PUSH 4
PUSH 3
PUSH 10
PUSH 5
2ADDMOD
POP y
POP x
ASSERT x == 3
ASSERT y == 1

# negative operands normalize into [0,m)
CLEARSTACK
PUSH -3
PUSH -1
PUSH 2
PUSH 4
PUSH 7
PUSH 5
PAIRADDMOD
POP y
POP x
ASSERT x == 6
ASSERT y == 3

# m<=0 → 0
CLEARSTACK
PUSH 5
PUSH 5
PUSH 1
PUSH 1
PUSH 0
PUSH 3
DADDMOD
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DSUBMOD: a b c d ma mb → (a-c)%ma (b-d)%mb
CLEARSTACK
PUSH 10
PUSH 7
PUSH 3
PUSH 2
PUSH 8
PUSH 6
DSUBMOD
POP y
POP x
ASSERT x == 7
ASSERT y == 5

# sub underflows into [0,m)
CLEARSTACK
PUSH 2
PUSH 1
PUSH 5
PUSH 4
PUSH 7
PUSH 5
2SUBMOD
POP y
POP x
ASSERT x == 4
ASSERT y == 2

# PAIRSUBMOD alias + m<=0
CLEARSTACK
PUSH 9
PUSH 8
PUSH 1
PUSH 1
PUSH 0
PUSH 0
PAIRSUBMOD
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fail underflow
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DADDMOD
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
DSUBMOD
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof175_daddmod_dsubmod" LAST_N SP
