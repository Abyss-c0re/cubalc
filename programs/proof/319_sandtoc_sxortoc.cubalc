# Proof 319 — digit-1 stack↔cell bitwise: SANDTOC SORTOC SXORTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDTOC
CELLSET 1 15
PUSH 1
PUSH 6
SANDTOC
ASSERT LAST_N == 6
ASSERT CELL(1) == 6
POP a
ASSERT a == 6

# SANDTOCELL alias
CELLSET 2 255
PUSH 2
PUSH 240
SANDTOCELL
ASSERT LAST_N == 240
ASSERT CELL(2) == 240
POP

# SORTOC
CELLSET 3 1
PUSH 3
PUSH 8
SORTOC
ASSERT LAST_N == 9
ASSERT CELL(3) == 9
POP

# BORTOC alias
CELLSET 4 2
PUSH 4
PUSH 4
BORTOC
ASSERT LAST_N == 6
ASSERT CELL(4) == 6
POP

# SXORTOC
CELLSET 5 15
PUSH 5
PUSH 7
SXORTOC
ASSERT LAST_N == 8
ASSERT CELL(5) == 8
POP

# BXORTOC alias
CELLSET 6 255
PUSH 6
PUSH 255
BXORTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# soft fails
CLEARSTACK
SANDTOC
ASSERT OK == 0
SORTOC
ASSERT OK == 0
SXORTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof319_sandtoc_sxortoc" LAST_N SP
HOLD_FLASH 1
