# Proof 335 — digit-9 data-path unsigned compare TOC: SULTTOC SUGTTOC SULETOC SUGETOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SULTTOC true: unsigned 1 < 5
CELLSET 1 1
PUSH 1
PUSH 5
SULTTOC
ASSERT LAST_N == 1
ASSERT CELL(1) == 1
POP a
ASSERT a == 1

# CMPULTTOC false: 9 < 2
CELLSET 2 9
PUSH 2
PUSH 2
CMPULTTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# high-bit: -1 as unsigned max > 0 (SSETCELL holds signed -1)
PUSH 3
PUSH (-1)
SSETCELL
POP
PUSH 3
PUSH 0
SUGTTOC
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# signed would say -1 < 0; unsigned: 0 > u-max is false
PUSH 4
PUSH 0
SSETCELL
POP
PUSH 4
PUSH (-1)
SUGTAT
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SULETOC equal
CELLSET 5 7
PUSH 5
PUSH 7
SULETOC
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# CMPULETOC false: 10 <= 3
CELLSET 6 10
PUSH 6
PUSH 3
CMPULETOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SUGETOC true: 9 >= 2
CELLSET 7 9
PUSH 7
PUSH 2
SUGETOC
ASSERT LAST_N == 1
ASSERT CELL(7) == 1
POP

# CMPUGETOC: -1 (u-max) >= 0 → 1
PUSH 8
PUSH (-1)
SSETCELL
POP
PUSH 8
PUSH 0
CMPUGETOC
ASSERT LAST_N == 1
ASSERT CELL(8) == 1
POP

# SUGEAT false: 1 >= 5
CELLSET 9 1
PUSH 9
PUSH 5
SUGEAT
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# contrast: signed SGTTOC on -1 vs 0 → false; unsigned SUGTTOC → true
PUSH 10
PUSH (-1)
SSETCELL
POP
PUSH 10
PUSH 0
SGTTOC
ASSERT LAST_N == 0
POP
PUSH 10
PUSH (-1)
SSETCELL
POP
PUSH 10
PUSH 0
SUGTTOC
ASSERT LAST_N == 1
POP

# soft fails
CLEARSTACK
SULTTOC
ASSERT OK == 0
SUGTTOC
ASSERT OK == 0
SULETOC
ASSERT OK == 0
SUGETOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof335_sulttoc_sugtoc" LAST_N SP
HOLD_FLASH 1
