# Proof 158 — digit-2 dual-stack numthy: DLOG2 DPHI DISPRIME
HOLD_FLASH 1
SCIENCE LOAD

# DLOG2 — floor(log2); <=0 → -1
CLEARSTACK
PUSH 1
PUSH 0
DLOG2
POP y
POP x
ASSERT x == 0
ASSERT y == -1

CLEARSTACK
PUSH 8
PUSH 1024
2LOG2
POP y
POP x
ASSERT x == 3
ASSERT y == 10

CLEARSTACK
PUSH -5
PUSH 7
PAIRLOG2
POP y
POP x
ASSERT x == -1
ASSERT y == 2

# DPHI — Euler totient
CLEARSTACK
PUSH 1
PUSH 10
DPHI
POP y
POP x
ASSERT x == 1
ASSERT y == 4

CLEARSTACK
PUSH 7
PUSH 0
2PHI
POP y
POP x
ASSERT x == 6
ASSERT y == 0

CLEARSTACK
PUSH 9
PUSH 12
DTOTIENT
POP y
POP x
ASSERT x == 6
ASSERT y == 4

# DISPRIME
CLEARSTACK
PUSH 2
PUSH 4
DISPRIME
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 17
PUSH 1
2ISPRIME
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 9
PUSH 3
DPRIMEP
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# soft fails
CLEARSTACK
DLOG2
ASSERT OK == 0
CLEARSTACK
DPHI
ASSERT OK == 0
CLEARSTACK
DISPRIME
ASSERT OK == 0
CLEARSTACK
PUSH 1
2LOG2
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof158_dlog2_dphi" LAST_N SP
