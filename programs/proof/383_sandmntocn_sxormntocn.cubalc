# Proof 383 — digit-8 imm low-n mask TOC: SANDMNTOCN SORMNTOCN SXORMNTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDMNTOCN: keep low 4 bits of 0xFF = 15
CELLSET 1 255
PUSH 1
SANDMNTOCN 4
ASSERT LAST_N == 15
ASSERT CELL(1) == 15
POP a
ASSERT a == 15

# ANDMNTOCN n=0 → 0
CELLSET 2 99
PUSH 2
ANDMNTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SORMNTOCN: set low 3 bits of 0 → 7
CELLSET 3 0
PUSH 3
SORMNTOCN 3
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# ORMNTOCN: 8 | low-2 mask = 8|3 = 11
CELLSET 4 8
PUSH 4
ORMNTOCN 2
ASSERT LAST_N == 11
ASSERT CELL(4) == 11
POP

# SXORMNTOCN: 0 ^ low-4 = 15; again → 0
CELLSET 5 0
PUSH 5
SXORMNTOCN 4
ASSERT LAST_N == 15
ASSERT CELL(5) == 15
POP
PUSH 5
XORMNTOCN 4
ASSERT LAST_N == 0
ASSERT CELL(5) == 0
POP

# soft empty OK=0
CLEARSTACK
SANDMNTOCN 3
ASSERT OK == 0

PRINT "383_sandmntocn_sxormntocn OK"
