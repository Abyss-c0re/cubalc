# Proof 345 — digit-8 bit metrics TOC: SPOPCNTTOC SCLZTOC SCTZTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOPCNTTOC: 0b1011 → popcount 3
CELLSET 1 11
PUSH 1
SPOPCNTTOC
ASSERT LAST_N == 3
ASSERT CELL(1) == 3
POP a
ASSERT a == 3

# SPCNTTOC zero → 0
CELLSET 2 0
PUSH 2
SPCNTTOC
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SPOPAT: 0xFF → 8
CELLSET 3 255
PUSH 3
SPOPAT
ASSERT LAST_N == 8
ASSERT CELL(3) == 8
POP

# SCLZTOC: 1 → clz=63
CELLSET 4 1
PUSH 4
SCLZTOC
ASSERT LAST_N == 63
ASSERT CELL(4) == 63
POP

# CLZTOC zero → 64
CELLSET 5 0
PUSH 5
CLZTOC
ASSERT LAST_N == 64
ASSERT CELL(5) == 64
POP

# SCLZAT: bit 63 set → clz=0
PUSH 6
PUSH (-9223372036854775808)
SSETCELL
POP
PUSH 6
SCLZAT
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# SCTZTOC: 8 (0b1000) → ctz=3
CELLSET 7 8
PUSH 7
SCTZTOC
ASSERT LAST_N == 3
ASSERT CELL(7) == 3
POP

# CTZTOC zero → 64
CELLSET 8 0
PUSH 8
CTZTOC
ASSERT LAST_N == 64
ASSERT CELL(8) == 64
POP

# SCTZAT: odd → ctz=0
CELLSET 9 7
PUSH 9
SCTZAT
ASSERT LAST_N == 0
ASSERT CELL(9) == 0
POP

# soft fails empty stack
CLEARSTACK
SPOPCNTTOC
ASSERT OK == 0
SCLZTOC
ASSERT OK == 0
SCTZTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof345_spopcnttoc_sclztoc" LAST_N SP
HOLD_FLASH 1
