# Proof 108 — digit-1 data: SSUBTOC SMULTOC SDIVTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSUBTOC
CELLSET 2 20
PUSH 2
PUSH 5
SSUBTOC
ASSERT LAST_N == 15
ASSERT CELL(2) == 15
POP a
ASSERT a == 15

# SMULTOC
CELLSET 3 6
PUSH 3
PUSH 7
SMULTOC
ASSERT LAST_N == 42
ASSERT CELL(3) == 42
POP b
ASSERT b == 42

# SDIVTOC
CELLSET 4 100
PUSH 4
PUSH 4
SDIVTOC
ASSERT LAST_N == 25
ASSERT CELL(4) == 25
POP c
ASSERT c == 25

# SDIVTOC by zero → 0
CELLSET 5 9
PUSH 5
PUSH 0
SCELLDIV
ASSERT LAST_N == 0
ASSERT CELL(5) == 0

# aliases + chain
CLEARCELLS
CELLSET 0 10
PUSH 0
PUSH 3
SCELLSUB
POP
PUSH 0
PUSH 2
SCELLMUL
POP
PUSH 0
PUSH 2
SCELLDIV
ASSERT LAST_N == 7
ASSERT CELL(0) == 7

# soft fail
CLEARSTACK
SSUBTOC
ASSERT OK == 0
SMULTOC
ASSERT OK == 0
SDIVTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof108_ssubtoc_smultoc" LAST_N SP
