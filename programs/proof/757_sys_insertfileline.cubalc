# SYS INSERTFILELINE / FILEINSERTLINE — insert line at 0-based file index
# Usability: add plate/config row without READ+INSERTLINE+WRITE glue
# Completes LINEAT/SETFILELINE. Append if past end. Soft miss.

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS JOIN td "insfileline_mi_fixture"
LET fix = LAST
SYS MKDIR fix

SYS JOIN fix "sample.txt"
LET fs = LAST
SYS WRITE fs "L0\nL1\nL2"

# insert middle
SYS INSERTFILELINE fs 1 "X"
ASSERT OK == 1
ASSERT INSERTFILELINE_N == 1
ASSERT INSERTFILELINE_I == 1
ASSERT INSERTFILELINE_TOTAL == 4
SYS EQS LAST "X"
ASSERT LAST_N == 1

SYS LINEAT fs 0
SYS EQS LAST "L0"
ASSERT LAST_N == 1
SYS LINEAT fs 1
SYS EQS LAST "X"
ASSERT LAST_N == 1
SYS LINEAT fs 2
SYS EQS LAST "L1"
ASSERT LAST_N == 1
SYS LINEAT fs 3
SYS EQS LAST "L2"
ASSERT LAST_N == 1

# insert front (alias)
SYS FILEINSERTLINE fs 0 "HEAD"
ASSERT INSERTFILELINE_N == 1
ASSERT INSERTFILELINE_I == 0
ASSERT INSERTFILELINE_TOTAL == 5
SYS LINEAT fs 0
SYS EQS LAST "HEAD"
ASSERT LAST_N == 1

# append past end
SYS INSERTFILELINE fs 99 "TAIL"
ASSERT OK == 1
ASSERT INSERTFILELINE_N == 1
ASSERT INSERTFILELINE_I == 5
ASSERT INSERTFILELINE_TOTAL == 6
SYS LINEAT fs 5
SYS EQS LAST "TAIL"
ASSERT LAST_N == 1

# soft miss
SYS INSERTFILELINE "no_such_insfileline_mi.txt" 0 "x"
ASSERT OK == 0
ASSERT INSERTFILELINE_N == 0

# cleanup
SYS RM fs

PRINT "sys_insertfileline ok"
