# Proof 280 — digit-4 dual-stack imm inverted 4-bit field: DNAND4N DNOR4N DXNOR4N
HOLD_FLASH 1
SCIENCE LOAD

# DNAND4N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNAND4N 0x3 0
POP y
POP x
ASSERT x == 0x112233445566778F
ASSERT y == 0x99AABBCCDDEEFF0F

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNAND4N 0x3 1
POP y
POP x
ASSERT x == 0x11223344556677F8
ASSERT y == 0x99AABBCCDDEEFFF0

CLEARSTACK
PUSH -1
PUSH -1
DINVERTAND4N 0xF 0
POP y
POP x
ASSERT x == -16
ASSERT y == -16

# DNOR4N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DNOR4N 0xC 0
POP y
POP x
ASSERT x == 0x1122334455667783
ASSERT y == 0x99AABBCCDDEEFF03

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRNOR4N 0x1 2
POP y
POP x
ASSERT x == 0x1122334455667888
ASSERT y == 0x99AABBCCDDEEF000

CLEARSTACK
PUSH 0
PUSH 0
DINVERTOR4N 0xA 3
POP y
POP x
ASSERT x == 0x5000
ASSERT y == 0x5000

# DXNOR4N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNOR4N 0x1 0
POP y
POP x
ASSERT x == 0x1122334455667786
ASSERT y == 0x99AABBCCDDEEFF0E

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXNOR4N 0x1 15
POP y
POP x
ASSERT x == 0xF122334455667788
ASSERT y == 0x79AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DEQUIV4N 0x0 0
POP y
POP x
ASSERT x == -16
ASSERT y == -16

CLEARSTACK
PUSH -1
PUSH -1
DXNOR4N 0xF 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

# soft fails
CLEARSTACK
DNAND4N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DNOR4N 1 0
ASSERT OK == 0
CLEARSTACK
DXNOR4N 1 0
ASSERT OK == 0

HOLD_FLASH 1
