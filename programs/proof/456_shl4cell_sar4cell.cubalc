# Proof 456 — digit-9 cell fixed-width 4 nibble shift: SHL4CELL SHR4CELL SAR4CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SHL4CELL: 1<<2 → 4; 0x8<<1 → 0 (uint4 overflow)
CELLSET 0 1
CELLSET 1 8
SHL4CELL 0 1 2
ASSERT CELL(0) == 4
ASSERT CELL(1) == 0
ASSERT LAST_N == 2

# SHL4RANGE k>=4 → 0
CELLSET 2 15
SHL4RANGE 2 2 4
ASSERT CELL(2) == 0

# SHR4CELL: 0x8 >> 1 → 0x4; 15 >> 2 → 3
CELLSET 3 8
CELLSET 4 15
SHR4CELL 3 4 1
ASSERT CELL(3) == 4
ASSERT CELL(4) == 7
ASSERT LAST_N == 2

CELLSET 5 15
SHR4RANGE 5 5 2
ASSERT CELL(5) == 3

# SAR4CELL: 0xE (-2) >> 1 → -1; 0x8 (-8) >> 1 → -4
CELLSET 6 14
CELLSET 7 8
SAR4CELL 6 7 1
ASSERT CELL(6) == -1
ASSERT CELL(7) == -4
ASSERT LAST_N == 2

# SAR4RANGE k>=4 → all sign
CELLSET 8 8
SAR4RANGE 8 8 4
ASSERT CELL(8) == -1
CELLSET 9 4
SAR4RANGE 9 9 5
ASSERT CELL(9) == 0

# positive SAR: 0x6 >> 1 → 3
CELLSET 10 6
SAR4CELL 10 10 1
ASSERT CELL(10) == 3

# high bits above 4 ignored on shift
CELLSET 11 17
SHL4CELL 11 11 1
ASSERT CELL(11) == 2

# SHLNIBCELL alias: 3 << 1 → 6
CELLSET 12 3
SHLNIBCELL 12 12 1
ASSERT CELL(12) == 6

# CELLLSHR4: 12 >> 2 → 3
CELLSET 13 12
CELLLSHR4 13 13 2
ASSERT CELL(13) == 3

# round-trip: SHL then SHR on positive nibble
CELLSET 14 3
SHL4CELL 14 14 1
SHR4CELL 14 14 1
ASSERT CELL(14) == 3

HOLD_FLASH 0
