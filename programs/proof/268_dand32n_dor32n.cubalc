# Proof 268 — digit-7 dual-stack imm 32-bit field bitwise: DAND32N DOR32N DXOR32N
HOLD_FLASH 1
SCIENCE LOAD

# DAND32N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DAND32N 0x0000FFFF 0
POP y
POP x
ASSERT x == 0x1122334400007788
ASSERT y == 0x99AABBCC0000FF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRAND32N 0x00FFFFFF 1
POP y
POP x
ASSERT x == 0x0022334455667788
ASSERT y == 0x00AABBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DANDWN 0xAABBCCDD 0
POP y
POP x
ASSERT x == -1430532899
ASSERT y == -1430532899

# DOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DOR32N 0xFF000000 0
POP y
POP x
ASSERT x == 0x11223344FF667788
ASSERT y == 0x99AABBCCFFEEFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIROR32N 0xFF000000 1
POP y
POP x
ASSERT x == 0xFF22334455667788
ASSERT y == 0xFFAABBCCDDEEFF00

CLEARSTACK
PUSH 0
PUSH 0
DSETOR32N 0x12345678 1
POP y
POP x
ASSERT x == 0x1234567800000000
ASSERT y == 0x1234567800000000

# DXOR32N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXOR32N 0x000000FF 0
POP y
POP x
ASSERT x == 0x1122334455667777
ASSERT y == 0x99AABBCCDDEEFFFF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXOR32N 0x000000FF 1
POP y
POP x
ASSERT x == 0x112233BB55667788
ASSERT y == 0x99AABB33DDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DFLIP32N 0xFFFFFFFF 0
POP y
POP x
ASSERT x == -4294967296
ASSERT y == -4294967296

# soft fails
CLEARSTACK
DAND32N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DOR32N 1 0
ASSERT OK == 0
CLEARSTACK
DXOR32N 1 0
