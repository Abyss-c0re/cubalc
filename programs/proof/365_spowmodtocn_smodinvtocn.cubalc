# Proof 365 — digit-2 forward imm modular inv/pow/div TOC: SPOWMODTOCN SMODDIVTOCN SMODINVTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SPOWMODTOCN: 3^5 mod 13 = 9
CELLSET 1 3
PUSH 1
SPOWMODTOCN 5 13
ASSERT LAST_N == 9
ASSERT CELL(1) == 9
POP a
ASSERT a == 9

# POWMODTOCN: 2^10 mod 1000 = 24
CELLSET 2 2
PUSH 2
POWMODTOCN 10 1000
ASSERT LAST_N == 24
ASSERT CELL(2) == 24
POP

# SEXPMMODTOCN: 5^0 mod 7 = 1
CELLSET 3 5
PUSH 3
SEXPMMODTOCN 0 7
ASSERT LAST_N == 1
ASSERT CELL(3) == 1
POP

# soft m<=0 → 0
CELLSET 4 9
PUSH 4
SPOWMODTOCN 3 0
ASSERT LAST_N == 0
ASSERT CELL(4) == 0
POP

# SMODDIVTOCN: 10 * inv(3) mod 7 = 1  (10*5=50 ≡ 1 mod 7)
CELLSET 5 10
PUSH 5
SMODDIVTOCN 3 7
ASSERT LAST_N == 1
ASSERT CELL(5) == 1
POP

# MODDIVTOCN: 1 * inv(2) mod 5 = 3
CELLSET 6 1
PUSH 6
MODDIVTOCN 2 5
ASSERT LAST_N == 3
ASSERT CELL(6) == 3
POP

# no inverse → 0
CELLSET 7 1
PUSH 7
SMODDIVTOCN 2 4
ASSERT LAST_N == 0
ASSERT CELL(7) == 0
POP

# SMODINVTOCN: inv(3) mod 7 = 5
CELLSET 8 3
PUSH 8
SMODINVTOCN 7
ASSERT LAST_N == 5
ASSERT CELL(8) == 5
POP

# SINVMODTOCN: inv(2) mod 5 = 3
CELLSET 9 2
PUSH 9
SINVMODTOCN 5
ASSERT LAST_N == 3
ASSERT CELL(9) == 3
POP

# no inverse m<=1 → 0
CELLSET 10 3
PUSH 10
SMODINVTOCN 1
ASSERT LAST_N == 0
ASSERT CELL(10) == 0
POP

# soft empty OK=0
CLEARSTACK
SPOWMODTOCN 2 5
ASSERT OK == 0

PRINT "365_spowmodtocn_smodinvtocn OK"
