# Proof 528 — digit-4 stack imm 16-bit field ordered-cmp: SLT16N SGT16N SLTE16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SLT16N: 0x1000 < 0xC000 → 1
PUSH 0x1000
SLT16N 0xC000 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0xC000
LT16N 0xC000 0
POP x
ASSERT x == 0

# greater → 0
CLEARSTACK
PUSH 0xF000
SLT16N 0x2000 0
POP x
ASSERT x == 0

# high half preserved: half0 0x0010 < 0x0020 → 1; half1 untouched
CLEARSTACK
PUSH 0xAABB0010
SLT16N 0x0020 0
POP x
ASSERT x == 0xAABB0001

# STACKLT16N n1: half1 0x1000 < 0x2000 → half1 1
CLEARSTACK
PUSH 0x10000000
STACKLT16N 0x2000 1
POP x
ASSERT x == 0x00010000

# n2: half2
CLEARSTACK
PUSH 0x0000100000000000
SLT16N 0x2000 2
POP x
ASSERT x == 0x0000000100000000

# n3: half3
CLEARSTACK
PUSH 0x1000000000000000
SLT16N 0x2000 3
POP x
ASSERT x == 0x0001000000000000

# SGT16N: 0xF000 > 0x2000 → 1
CLEARSTACK
PUSH 0xF000
SGT16N 0x2000 0
POP x
ASSERT x == 1

# equal → 0
CLEARSTACK
PUSH 0x5555
GT16N 0x5555 0
POP x
ASSERT x == 0

# less → 0
CLEARSTACK
PUSH 0x10
SGT16N 0x20 0
POP x
ASSERT x == 0

# high preserved gt
CLEARSTACK
PUSH 0x99AA8000
SGT16N 0x1000 0
POP x
ASSERT x == 0x99AA0001

# STACKGT16N n1
CLEARSTACK
PUSH 0x90000000
STACKGT16N 0x1000 1
POP x
ASSERT x == 0x00010000

# SLTE16N: less → 1
CLEARSTACK
PUSH 0x1000
SLTE16N 0xC000 0
POP x
ASSERT x == 1

# equal → 1
CLEARSTACK
PUSH 0xABCD
LTE16N 0xABCD 0
POP x
ASSERT x == 1

# greater → 0
CLEARSTACK
PUSH 0xFFFF
SLEQ16N 0xFFFE 0
POP x
ASSERT x == 0

# high preserved lte
CLEARSTACK
PUSH 0x11227742
SLTE16N 0x7742 0
POP x
ASSERT x == 0x11220001

# STACKLTE16N n1: 0x5555 <= 0x5554 → 0
CLEARSTACK
PUSH 0x55550000
STACKLTE16N 0x5554 1
POP x
ASSERT x == 0x00000000

# aliases
CLEARSTACK
PUSH 1
SCMPLT16N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 3
SCMPGT16N 2 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 2
SCMPLE16N 2 0
POP x
ASSERT x == 1

# unsigned high bit: 0x8000 > 0x7FFF → 1
CLEARSTACK
PUSH 0x8000
SGT16N 0x7FFF 0
POP x
ASSERT x == 1

HOLD_FLASH 0
