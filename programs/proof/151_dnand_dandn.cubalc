# Proof 151 — digit-5 dual-stack extended bitwise: DNAND DNOR DXNOR DANDN
HOLD_FLASH 1
SCIENCE LOAD

# DNAND — ~(a&c) ~(b&d)
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0xFF
PUSH 0xFF
DNAND
POP y
POP x
ASSERT x == -241
ASSERT y == -16

# DNOR
CLEARSTACK
PUSH 0
PUSH 0
PUSH 0
PUSH 1
DNOR
POP y
POP x
ASSERT x == -1
ASSERT y == -2

# DXNOR — equality bits
CLEARSTACK
PUSH 0xAA
PUSH 0x55
PUSH 0xAA
PUSH 0xAA
DXNOR
POP y
POP x
ASSERT x == -1
ASSERT y == -256

# DANDN — a & ~c
CLEARSTACK
PUSH 0xFF
PUSH 0x0F
PUSH 0x0F
PUSH 0x03
DANDN
POP y
POP x
ASSERT x == 240
ASSERT y == 12

# aliases
CLEARSTACK
PUSH 1
PUSH 2
PUSH 1
PUSH 2
2NAND
POP y
POP x
ASSERT x == -2
ASSERT y == -3

CLEARSTACK
PUSH 0xF
PUSH 0xF
PUSH 0x1
PUSH 0x2
PAIRANDN
POP y
POP x
ASSERT x == 14
ASSERT y == 13

# soft fails
CLEARSTACK
DNAND
ASSERT OK == 0
CLEARSTACK
DNOR
ASSERT OK == 0
CLEARSTACK
DXNOR
ASSERT OK == 0
CLEARSTACK
DANDN
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2NOR
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof151_dnand_dandn" LAST_N SP
