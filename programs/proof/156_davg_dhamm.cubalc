# Proof 156 — digit-6 dual-stack flow metrics: DAVG DDIST DHAMM
HOLD_FLASH 1
SCIENCE LOAD

# DAVG — truncated mean of vector pairs
CLEARSTACK
PUSH 10
PUSH 20
PUSH 4
PUSH 6
DAVG
POP y
POP x
ASSERT x == 7
ASSERT y == 13

CLEARSTACK
PUSH -3
PUSH 5
PUSH 1
PUSH -1
2AVG
POP y
POP x
ASSERT x == -1
ASSERT y == 2

# DDIST — absolute difference
CLEARSTACK
PUSH 10
PUSH 3
PUSH 4
PUSH 9
DDIST
POP y
POP x
ASSERT x == 6
ASSERT y == 6

CLEARSTACK
PUSH 0
PUSH 100
PUSH 5
PUSH 40
2DIST
POP y
POP x
ASSERT x == 5
ASSERT y == 60

# DHAMM — popcount of XOR (bit distance)
CLEARSTACK
PUSH 0xF0
PUSH 0x0F
PUSH 0xFF
PUSH 0x00
DHAMM
POP y
POP x
ASSERT x == 4
ASSERT y == 4

CLEARSTACK
PUSH 0
PUSH 7
PUSH 0
PUSH 1
2HAMM
POP y
POP x
ASSERT x == 0
ASSERT y == 2

# aliases
CLEARSTACK
PUSH 8
PUSH 2
PUSH 2
PUSH 4
DMEAN
POP y
POP x
ASSERT x == 5
ASSERT y == 3

CLEARSTACK
PUSH 15
PUSH 0
PUSH 0
PUSH 15
DABSDIFF
POP y
POP x
ASSERT x == 15
ASSERT y == 15

CLEARSTACK
PUSH 0xAA
PUSH 0x55
PUSH 0xAA
PUSH 0x55
PAIRHAMM
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fails
CLEARSTACK
DAVG
ASSERT OK == 0
CLEARSTACK
DDIST
ASSERT OK == 0
CLEARSTACK
DHAMM
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2AVG
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof156_davg_dhamm" LAST_N SP
