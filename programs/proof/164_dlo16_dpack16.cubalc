# Proof 164 — digit-4 dual-stack control halfwords: DLO16 DHI16 DPACK16
HOLD_FLASH 1
SCIENCE LOAD

# DLO16
CLEARSTACK
PUSH 0x12345678
PUSH 0xABCD
DLO16
POP y
POP x
ASSERT x == 0x5678
ASSERT y == 0xABCD

CLEARSTACK
PUSH 65536
PUSH -1
2LO16
POP y
POP x
ASSERT x == 0
ASSERT y == 65535

# DHI16
CLEARSTACK
PUSH 0x12345678
PUSH 0xABCD1234
DHI16
POP y
POP x
ASSERT x == 0x1234
ASSERT y == 0xABCD

CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x0000FFFF
2HI16
POP y
POP x
ASSERT x == 0xFFFF
ASSERT y == 0

# DPACK16 — a b c d → (a<<16|c) (b<<16|d)
CLEARSTACK
PUSH 0x1234
PUSH 0xABCD
PUSH 0x5678
PUSH 0xEF01
DPACK16
POP y
POP x
ASSERT x == 0x12345678
ASSERT y == 0xABCDEF01

CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
2PACK16
POP y
POP x
ASSERT x == 0x00010003
ASSERT y == 0x00020004

# round-trip
CLEARSTACK
PUSH 0x11223344
PUSH 0x55667788
DHI16
POP hb
POP ha
CLEARSTACK
PUSH 0x11223344
PUSH 0x55667788
DLO16
POP lb
POP la
CLEARSTACK
PUSH ha
PUSH hb
PUSH la
PUSH lb
DPACK16
POP y
POP x
ASSERT x == 0x11223344
ASSERT y == 0x55667788

# aliases
CLEARSTACK
PUSH 0x0F0FABCD
PUSH 0xF0F01234
PAIRLO16
POP y
POP x
ASSERT x == 0xABCD
ASSERT y == 0x1234

CLEARSTACK
PUSH 0x0A0B
PUSH 0x0C0D
PUSH 0x0E0F
PUSH 0x1011
PAIRPACK16
POP y
POP x
ASSERT x == 0x0A0B0E0F
ASSERT y == 0x0C0D1011

# soft fails
CLEARSTACK
DLO16
ASSERT OK == 0
CLEARSTACK
DHI16
ASSERT OK == 0
CLEARSTACK
DPACK16
ASSERT OK == 0
CLEARSTACK
PUSH 1
2LO16
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2PACK16
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof164_dlo16_dpack16" LAST_N SP
