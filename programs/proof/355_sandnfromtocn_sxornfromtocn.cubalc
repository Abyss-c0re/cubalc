# Proof 355 — digit-6 reverse imm ANDN-plane TOC: SANDNFROMTOCN SORNFROMTOCN SXORNFROMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDNFROMTOCN: n=0xFF, cell=0x0F → 0xFF & ~0x0F = 0xF0 = 240
CELLSET 1 15
PUSH 1
SANDNFROMTOCN 255
ASSERT LAST_N == 240
ASSERT CELL(1) == 240
POP a
ASSERT a == 240

# BICFROMTOCN: n=42, cell=0 → 42 & ~0 = 42
CELLSET 2 0
PUSH 2
BICFROMTOCN 42
ASSERT LAST_N == 42
ASSERT CELL(2) == 42
POP

# SANDNFROMATN: n=7, cell=-1 → 7 & ~(-1) = 0
CELLSET 3 (-1)
PUSH 3
SANDNFROMATN 7
ASSERT LAST_N == 0
ASSERT CELL(3) == 0
POP

# RANDNTOCN: n=0xF0, cell=0x0F → 0xF0 & ~0x0F = 0xF0 = 240
CELLSET 10 15
PUSH 10
RANDNTOCN 240
ASSERT LAST_N == 240
ASSERT CELL(10) == 240
POP

# SORNFROMTOCN: n=0, cell=0 → 0 | ~0 = -1
CELLSET 4 0
PUSH 4
SORNFROMTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(4) == (-1)
POP

# ORNFROMTOCN: n=8, cell=1 → 8 | ~1 = -2
CELLSET 5 1
PUSH 5
ORNFROMTOCN 8
ASSERT LAST_N == (-2)
ASSERT CELL(5) == (-2)
POP

# SORNFROMATN: n=0, cell=255 → 0 | ~255 = -256
CELLSET 6 255
PUSH 6
SORNFROMATN 0
ASSERT LAST_N == (-256)
ASSERT CELL(6) == (-256)
POP

# SXORNFROMTOCN: n=0, cell=0 → 0 ^ ~0 = -1
CELLSET 7 0
PUSH 7
SXORNFROMTOCN 0
ASSERT LAST_N == (-1)
ASSERT CELL(7) == (-1)
POP

# XORNFROMTOCN: n=5, cell=5 → 5 ^ ~5 = -1
CELLSET 8 5
PUSH 8
XORNFROMTOCN 5
ASSERT LAST_N == (-1)
ASSERT CELL(8) == (-1)
POP

# SXORNFROMATN: n=1, cell=0 → 1 ^ ~0 = -2
CELLSET 9 0
PUSH 9
SXORNFROMATN 1
ASSERT LAST_N == (-2)
ASSERT CELL(9) == (-2)
POP

# RXORNTOCN: n=0xFF, cell=0x0F → 0xFF ^ ~0x0F = 0xF0 = 240? 
# 255 ^ (~15) = 255 ^ (-16) = 255 ^ 0xFFFFFFFFFFFFFFF0
# on 64-bit: 0xFF ^ 0xFFFFFFFFFFFFFFF0 = 0xFFFFFFFFFFFFFF0F = -241
CELLSET 11 15
PUSH 11
RXORNTOCN 255
ASSERT LAST_N == (-241)
ASSERT CELL(11) == (-241)
POP

# soft empty-stack OK=0
CLEARSTACK
SANDNFROMTOCN 1
ASSERT OK == 0

PRINT "355_sandnfromtocn_sxornfromtocn OK"
