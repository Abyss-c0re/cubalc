# Proof 270 — digit-8 dual-stack imm 16-bit field bitwise: DAND16N DOR16N DXOR16N
HOLD_FLASH 1
SCIENCE LOAD

# DAND16N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DAND16N 0x00FF 0
POP y
POP x
ASSERT x == 0x1122334455660088
ASSERT y == 0x99AABBCCDDEE0000

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRAND16N 0x00FF 1
POP y
POP x
ASSERT x == 0x1122334400667788
ASSERT y == 0x99AABBCC00EEFF00

CLEARSTACK
PUSH -1
PUSH -1
DKEEP16N 0xABCD 0
POP y
POP x
ASSERT x == -21555
ASSERT y == -21555

# DOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DOR16N 0xF000 0
POP y
POP x
ASSERT x == 0x112233445566F788
ASSERT y == 0x99AABBCCDDEEFF00

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIROR16N 0xF000 2
POP y
POP x
ASSERT x == 0x1122F34455667788
ASSERT y == 0x99AAFBCCDDEEFF00

CLEARSTACK
PUSH 0
PUSH 0
DSETOR16N 0x1234 3
POP y
POP x
ASSERT x == 0x1234000000000000
ASSERT y == 0x1234000000000000

# DXOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXOR16N 0x00FF 0
POP y
POP x
ASSERT x == 0x1122334455667777
ASSERT y == 0x99AABBCCDDEEFFFF

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
PAIRXOR16N 0xFFFF 3
POP y
POP x
ASSERT x == 0xEEDD334455667788
ASSERT y == 0x6655BBCCDDEEFF00

CLEARSTACK
PUSH -1
PUSH -1
DFLIP16N 0xFFFF 0
POP y
POP x
ASSERT x == -65536
ASSERT y == -65536

# soft fails
CLEARSTACK
DAND16N 1 0
ASSERT OK == 0
CLEARSTACK
PUSH 1
DOR16N 1 0
ASSERT OK == 0
CLEARSTACK
DXOR16N 1 0
ASSERT OK == 0

HOLD_FLASH 1
