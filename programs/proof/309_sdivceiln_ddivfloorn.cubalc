# Proof 309 — digit-7 imm ceil/floor div: SDIVCEILN SDIVFLOORN DDIVCEILN DDIVFLOORN
HOLD_FLASH 1
SCIENCE LOAD

# SDIVCEILN — positive
CLEARSTACK
PUSH 10
SDIVCEILN 3
POP x
ASSERT x == 4

CLEARSTACK
PUSH 9
CEILDIVN 3
POP x
ASSERT x == 3

CLEARSTACK
PUSH 1
CEILN 5
POP x
ASSERT x == 1

# SDIVCEILN — both neg
CLEARSTACK
PUSH -10
SDIVCEILN -3
POP x
ASSERT x == 4

# SDIVCEILN — mixed signs → trunc
CLEARSTACK
PUSH -10
SDIVCEILN 3
POP x
ASSERT x == -3

# /0 soft
CLEARSTACK
PUSH 7
SDIVCEILN 0
POP x
ASSERT x == 0

# SDIVFLOORN — positive
CLEARSTACK
PUSH 10
SDIVFLOORN 3
POP x
ASSERT x == 3

CLEARSTACK
PUSH 9
FLOORDIVN 3
POP x
ASSERT x == 3

# SDIVFLOORN — toward -inf
CLEARSTACK
PUSH -10
FLOORN 3
POP x
ASSERT x == -4

CLEARSTACK
PUSH 10
SDIVFLOORN -3
POP x
ASSERT x == -4

# /0 soft
CLEARSTACK
PUSH 5
SDIVFLOORN 0
POP x
ASSERT x == 0

# soft empty
CLEARSTACK
SDIVCEILN 2
ASSERT OK == 0
CLEARSTACK
SDIVFLOORN 2
ASSERT OK == 0

# DDIVCEILN
CLEARSTACK
PUSH 10
PUSH 7
DDIVCEILN 3
POP y
POP x
ASSERT x == 4
ASSERT y == 3

CLEARSTACK
PUSH 9
PUSH 8
PAIRDIVCEILN 4
POP y
POP x
ASSERT x == 3
ASSERT y == 2

# DDIVCEILN /0
CLEARSTACK
PUSH 5
PUSH 6
DDIVCEILN 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DDIVFLOORN
CLEARSTACK
PUSH 10
PUSH 7
DDIVFLOORN 3
POP y
POP x
ASSERT x == 3
ASSERT y == 2

CLEARSTACK
PUSH -10
PUSH 10
PAIRDIVFLOORN 3
POP y
POP x
ASSERT x == -4
ASSERT y == 3

# dual soft
CLEARSTACK
DDIVCEILN 2
ASSERT OK == 0
CLEARSTACK
PUSH 1
DDIVFLOORN 2
ASSERT OK == 0

# binary sibling still works
CLEARSTACK
PUSH 10
PUSH 3
SDIVCEIL
POP x
ASSERT x == 4

HOLD_FLASH 1
