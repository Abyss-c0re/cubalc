# Proof 126 — digit-5 cell-memory stack duals: SCOPYCELL SMOVECELL SREVCELL SROTCELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CELLSET 0 10
CELLSET 1 20
CELLSET 2 30
CELLSET 3 40

# SCOPYCELL src dst n
CLEARSTACK
PUSH 0
PUSH 4
PUSH 3
SCOPYCELL
ASSERT LAST_N == 3
ASSERT SP == 0
ASSERT CELL(4) == 10
ASSERT CELL(5) == 20
ASSERT CELL(6) == 30

# SCELLCOPY alias — overlap-safe
CLEARSTACK
PUSH 4
PUSH 5
PUSH 2
SCELLCOPY
ASSERT LAST_N == 2
ASSERT CELL(5) == 10
ASSERT CELL(6) == 20

# SMOVECELL — move then clear non-overlapping source
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CLEARSTACK
PUSH 0
PUSH 10
PUSH 3
SMOVECELL
ASSERT LAST_N == 3
ASSERT CELL(10) == 1
ASSERT CELL(11) == 2
ASSERT CELL(12) == 3
ASSERT CELL(0) == 0
ASSERT CELL(1) == 0
ASSERT CELL(2) == 0

# SREVCELL lo hi
CLEARCELLS
CELLSET 0 1
CELLSET 1 2
CELLSET 2 3
CELLSET 3 4
CLEARSTACK
PUSH 0
PUSH 3
SREVCELL
ASSERT LAST_N == 4
ASSERT CELL(0) == 4
ASSERT CELL(1) == 3
ASSERT CELL(2) == 2
ASSERT CELL(3) == 1

# SCELLREV alias
CLEARSTACK
PUSH 0
PUSH 3
SCELLREV
ASSERT CELL(0) == 1
ASSERT CELL(3) == 4

# SROTCELL lo hi k — left rotate by 1: 1 2 3 4 → 2 3 4 1
CLEARSTACK
PUSH 0
PUSH 3
PUSH 1
SROTCELL
ASSERT LAST_N == 4
ASSERT CELL(0) == 2
ASSERT CELL(1) == 3
ASSERT CELL(2) == 4
ASSERT CELL(3) == 1

# right rotate by 1 (k=-1): 2 3 4 1 → 1 2 3 4
CLEARSTACK
PUSH 0
PUSH 3
PUSH -1
SCELLROT
ASSERT CELL(0) == 1
ASSERT CELL(1) == 2
ASSERT CELL(2) == 3
ASSERT CELL(3) == 4

# soft fails
CLEARSTACK
SCOPYCELL
ASSERT OK == 0
SMOVECELL
ASSERT OK == 0
SREVCELL
ASSERT OK == 0
SROTCELL
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof126_scopycell_srot" LAST_N SP
