# Proof 443 — digit-3 cell signed-clip duals: CLIPS8CELL CLIPS16CELL CLIPS32CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# CLIPS8CELL: clamp to [-128,127]
# 200 → 127; 50 → 50; -200 (SEXT16 of 0xFF38) → -128
CELLSET 0 200
CELLSET 1 50
CELLSET 2 65336
SEXT16CELL 2 2
CLIPS8CELL 0 2
ASSERT CELL(0) == 127
ASSERT CELL(1) == 50
ASSERT CELL(2) == -128
ASSERT LAST_N == 3

# CLIPS16CELL: 40000 → 32767; 1000 → 1000; min int16 stays -32768
CELLSET 3 40000
CELLSET 4 1000
CLIPS16CELL 3 4
ASSERT CELL(3) == 32767
ASSERT CELL(4) == 1000
ASSERT LAST_N == 2
CELLSET 5 32768
SEXT16CELL 5 5
CLIPS16CELL 5 5
ASSERT CELL(5) == -32768

# CLIPS32CELL: mid and max int32 stay
CELLSET 6 100
CELLSET 7 2147483647
CLIPS32CELL 6 7
ASSERT CELL(6) == 100
ASSERT CELL(7) == 2147483647
ASSERT LAST_N == 2

# CLIPS8RANGE single
CELLSET 9 0
CLIPS8RANGE 9 9
ASSERT CELL(9) == 0

# unsigned CLIP8 then signed CLIPS8: 200 → 200 → 127
CELLSET 10 200
CLIP8CELL 10 10
ASSERT CELL(10) == 200
CLIPS8CELL 10 10
ASSERT CELL(10) == 127

HOLD_FLASH 0
