# LASTFLAT / ENDFLAT — last matching leaf value by path needle
# Usability: newest-wins nest peel without REVL+GETFLAT glue.

HOLD_FLASH 1

# first role is meta.role=worker, last is cfg.role=leader
LET PLATE = "{\"meta\":{\"role\":\"worker\",\"port\":1},\"cfg\":{\"role\":\"leader\",\"port\":9090},\"label\":\"x\"}"

GETFLAT "role"
SYS EQS LAST "worker"
ASSERT LAST_N == 1
SYS EQS GETFLAT_PATH "meta.role"
ASSERT LAST_N == 1

LASTFLAT "role"
ASSERT OK == 1
ASSERT LASTFLAT_HIT == 1
SYS EQS LAST "leader"
ASSERT LAST_N == 1
SYS EQS LASTFLAT_PATH "cfg.role"
ASSERT LAST_N == 1

GETFLAT "port"
SYS EQS LAST "1"
ASSERT LAST_N == 1
LASTFLAT "port"
SYS EQS LAST "9090"
ASSERT LAST_N == 1
SYS EQS LASTFLAT_PATH "cfg.port"
ASSERT LAST_N == 1

LASTFLAT "nope" OR "fallback"
ASSERT LASTFLAT_HIT == 0
ASSERT LASTFLAT_FALLBACK == 1
SYS EQS LAST "fallback"
ASSERT LAST_N == 1

LASTFLAT "nope"
ASSERT LASTFLAT_HIT == 0
SYS EQS LAST ""
ASSERT LAST_N == 1

LET PEER = "{\"a\":{\"name\":\"first\"},\"b\":{\"name\":\"second\"}}"
LASTFLAT FROM PEER "name"
ASSERT LASTFLAT_FROM == 1
SYS EQS LASTFLAT_SRC "PEER"
ASSERT LAST_N == 1
SYS EQS LAST "second"
ASSERT LAST_N == 1
SYS EQS LASTFLAT_PATH "b.name"
ASSERT LAST_N == 1

# plate unchanged
LET PLATE = "{\"x\":1}"
LASTFLAT FROM PEER "name"
GETP "x"
SYS EQS LAST "1"
ASSERT LAST_N == 1

ENDFLAT "x"
ASSERT LASTFLAT_HIT == 1
SYS EQS LAST "1"
ASSERT LAST_N == 1

PASS
PRINT "1237_lastflat: PASS"
