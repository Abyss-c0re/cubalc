REQUIRE VERSION "1.15"
INCLUDE life_cell

# LIFE_CELL_BAAT - Baat bile acid-CoA:amino acid N-acyltransferase after Fmo1
# Continuum ...->pepf->pdf->map->nata->natb->natc->nate->mete->metk->ahcy->cbs->cgl->gsha->gshb->gor->gpx->gst->ggt->dug1->nat8->cdo1->csad->fmo1->baat
# Gift: Baat conjugates Fmo1 taurine with bile acid-CoA -> taurocholate so Cys-disposal finishes into exportable bile salt.
# Cube is SoT. Free energy must flow.

ENTITY founder OF Cell 1 44 0
ENTITY quiet OF Cell 1 28 0
ENTITY corpse OF Cell 0 18 0
ENTITY empty OF Cell 1 0 0
ENTITY bed OF Cell 1 52 0

SEND founder set_threshold 10
SEND quiet set_threshold 12
SEND bed set_threshold 8
SEND empty set_threshold 10

