# HASENVALL / NEEDENVS — multi host-env ALL gate (HASARGALL twin for process env)

HOLD_FLASH 1

# empty names soft → 0
HASENVALL
ASSERT LAST_N == 0
ASSERT ENVMISS_N == 0

# miss synthetic keys
HASENVALL CUBALC_HENVALL_A CUBALC_HENVALL_B
ASSERT LAST_N == 0
ASSERT ENVMISS_N == 2
SYS HASLINE ENVMISS "CUBALC_HENVALL_A"
ASSERT LAST_N == 1
SYS HASLINE ENVMISS "CUBALC_HENVALL_B"
ASSERT LAST_N == 1
ASSERT HASENVALL_N == 0
ASSERT NEEDENVS_N == 2

# partial
SYS ENV SET CUBALC_HENVALL_A "1"
HASENVALL CUBALC_HENVALL_A CUBALC_HENVALL_B
ASSERT LAST_N == 0
ASSERT ENVMISS_N == 1
SYS HASLINE ENVMISS "CUBALC_HENVALL_B"
ASSERT LAST_N == 1
SYS HASLINE ENVHAVE "CUBALC_HENVALL_A"
ASSERT LAST_N == 1
ASSERT HASENVALL_N == 1

# all present
SYS ENV SET CUBALC_HENVALL_B "2"
HASENVALL CUBALC_HENVALL_A CUBALC_HENVALL_B
ASSERT LAST_N == 1
ASSERT ENVMISS_N == 0
ASSERT HASENVALL_N == 2
ASSERT OK == 1

# bag / CSV
HASENVALL "CUBALC_HENVALL_A,CUBALC_HENVALL_B"
ASSERT LAST_N == 1

# hard twin passes when all present
NEEDENVS CUBALC_HENVALL_A CUBALC_HENVALL_B
ASSERT LAST_N == 1
ASSERT OK == 1

# soft miss sticky ERR
SYS ENV UNSET CUBALC_HENVALL_B
HASENVALL CUBALC_HENVALL_A CUBALC_HENVALL_B
ASSERT LAST_N == 0
ASSERT OK == 0
SYS HASI "HASENVALL miss"
ASSERT LAST_N == 1

# IF without N× SYS HASENV
SYS ENV SET CUBALC_HENVALL_B "y"
HASENVALL CUBALC_HENVALL_A CUBALC_HENVALL_B
IF LAST_N == 1
  LET gate "ok"
ELSE
  LET gate "no"
END
SYS EQS gate "ok"
ASSERT LAST_N == 1

# discoverable
HASFORM HASENVALL
ASSERT LAST_N == 1
HASFORM NEEDENVS
ASSERT LAST_N == 1

# cleanup
SYS ENV UNSET CUBALC_HENVALL_A
SYS ENV UNSET CUBALC_HENVALL_B

PRINT "hasenvall ok"
PASS
