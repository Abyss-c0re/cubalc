# Proof 300 — digit-0 unsigned imm div/mod: SUDIVN SUMODN DUDIVN DUMODN
HOLD_FLASH 1
SCIENCE LOAD

# SUDIVN — normal positive
CLEARSTACK
PUSH 20
SUDIVN 4
POP x
ASSERT x == 5

# SUDIVN — unsigned high (negative as large unsigned)
CLEARSTACK
PUSH -1
UDIVN 2
POP x
ASSERT x == 9223372036854775807

# SUDIVN — /0 soft
CLEARSTACK
PUSH 99
SUDIVIMM 0
POP x
ASSERT x == 0

# SUMODN — normal
CLEARSTACK
PUSH 17
SUMODN 5
POP x
ASSERT x == 2

# SUMODN — unsigned high
CLEARSTACK
PUSH -1
UMODN 10
POP x
ASSERT x == 5

# SUMODN — /0 soft
CLEARSTACK
PUSH 7
SUREMN 0
POP x
ASSERT x == 0

# DUDIVN — normal
CLEARSTACK
PUSH 20
PUSH 35
DUDIVN 5
POP y
POP x
ASSERT x == 4
ASSERT y == 7

# DUDIVN — unsigned high both
CLEARSTACK
PUSH -2
PUSH -1
PAIRUDIVN 2
POP y
POP x
ASSERT x == 9223372036854775807
ASSERT y == 9223372036854775807

# DUDIVN — /0
CLEARSTACK
PUSH 8
PUSH 9
DUDIVIMM 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DUMODN — normal
CLEARSTACK
PUSH 17
PUSH 23
DUMODN 5
POP y
POP x
ASSERT x == 2
ASSERT y == 3

# DUMODN — unsigned high
CLEARSTACK
PUSH -1
PUSH -3
PAIRUMODN 10
POP y
POP x
ASSERT x == 5
ASSERT y == 3

# soft fails
CLEARSTACK
SUDIVN 2
ASSERT OK == 0
CLEARSTACK
SUMODN 2
ASSERT OK == 0
CLEARSTACK
DUDIVN 2
ASSERT OK == 0
CLEARSTACK
PUSH 1
DUMODN 2
ASSERT OK == 0

HOLD_FLASH 1
