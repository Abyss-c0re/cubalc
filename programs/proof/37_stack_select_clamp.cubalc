# Proof 37 — stack select/within/clamp + zero-tests digit-4
HOLD_FLASH 1
SCIENCE LOAD

# SZ SNZ
CLEARSTACK
PUSH 0
SZ
ASSERT LAST_N == 1
PUSH 5
SNZ
ASSERT LAST_N == 1
PUSH 0
SNZ
ASSERT LAST_N == 0

# S0LT S0GT SSIGN
CLEARSTACK
PUSH -3
S0LT
ASSERT LAST_N == 1
PUSH 7
S0GT
ASSERT LAST_N == 1
CLEARSTACK
PUSH -9
SSIGN
ASSERT LAST_N == -1
PUSH 0
SSIGN
ASSERT LAST_N == 0
PUSH 4
SSIGN
ASSERT LAST_N == 1

# SSEL: f t cond
CLEARSTACK
PUSH 100
PUSH 200
PUSH 1
SSEL
ASSERT LAST_N == 200
PUSH 100
PUSH 200
PUSH 0
SSEL
ASSERT LAST_N == 100

# SWITHIN: n lo hi  (half-open)
CLEARSTACK
PUSH 5
PUSH 0
PUSH 10
SWITHIN
ASSERT LAST_N == 1
PUSH 10
PUSH 0
PUSH 10
SWITHIN
ASSERT LAST_N == 0
PUSH -1
PUSH 0
PUSH 10
WITHIN
ASSERT LAST_N == 0

# SCLAMP
CLEARSTACK
PUSH 15
PUSH 0
PUSH 10
SCLAMP
ASSERT LAST_N == 10
PUSH -3
PUSH 0
PUSH 10
SCLAMP
ASSERT LAST_N == 0
PUSH 7
PUSH 0
PUSH 10
SCLAMP
ASSERT LAST_N == 7

# aliases + compose with compare
CLEARSTACK
PUSH 0
S0EQ
ASSERT LAST_N == 1
PUSH 1
PUSH 2
PUSH 1
STACKSEL
ASSERT LAST_N == 2

# underflow
CLEARSTACK
SZ
ASSERT OK == 0
SSEL
ASSERT OK == 0
SWITHIN
ASSERT OK == 0
SCLAMP
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
