# ERRRUN — ERRTIPS classify + RUNSNIP topic one-shot

ERRRUN
ASSERT OK == 1
ASSERT ERRRUN_TOPIC == "general"
ASSERT ERRRUN_OK == 1
ASSERT ERRTIPS_N >= 1

FAIL "INCLUDE missing hold_seed"
ERRRUN
ASSERT ERRRUN_TOPIC == "lib"
ASSERT ERRRUN_OK == 1
ASSERT ERRTIPS_TOPIC == "lib"
ASSERT ERRTIPS_N >= 1
CLEAR_ERR

FAIL "unknown form ZZZ did you mean"
ERRRUN
ASSERT ERRRUN_TOPIC == "cap"
ASSERT ERRRUN_OK == 1
CLEAR_ERR

ERRRUN "SMX DIAL timeout"
ASSERT ERRRUN_TOPIC == "p2p"
ASSERT ERRRUN_OK == 1

ERRRUN "ASSERT is false"
ASSERT ERRRUN_TOPIC == "run"
ASSERT ERRRUN_OK == 1

# alias
RECOVERSNIP "VARROOM NEEDVARROOM"
ASSERT ERRRUN_TOPIC == "fat"
ASSERT ERRRUN_OK == 1

PASS
PRINT "1337_errrun: PASS"
