SEND starved feed 20
GETF starved energy
LET se = LAST_N
GETF starved atp
LET sa = LAST_N
SEND starved lpoa 100
LET st = LAST_N
ASSERT st >= 1 "starved take>=1"
ASSERT st <= se "starved <=e"
ASSERT st <= sa "starved <=atp"
SEND starved photosynth 24
SEND starved glycolyse 20
SEND starved charge 30
SEND starved feed 20
GETF starved heat
LET sh1 = LAST_N
GETF starved energy
LET se1 = LAST_N
GETF starved atp
LET sa1 = LAST_N
GETF starved pcr
LET sc1 = LAST_N
GETF starved reserve
LET sr1 = LAST_N
SEND starved meps 100
LET stm = LAST_N
ASSERT stm >= 1 "starved meps>=1"
ASSERT stm <= se1 "starved meps<=e"
ASSERT stm <= sa1 "starved meps<=atp"
GETF starved heat
ASSERT LAST_N == sh1 + stm "starved h+meps"
GETF starved energy
ASSERT LAST_N == se1 - stm "starved e-meps"
GETF starved atp
ASSERT LAST_N == sa1 - stm "starved atp-meps"
GETF starved pcr
ASSERT LAST_N == sc1 "starved pcr held meps"
GETF starved reserve
ASSERT LAST_N == sr1 "starved reserve held meps"

