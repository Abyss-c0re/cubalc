# Proof 252 — digit-1 stack high-n bitfield metrics: SPOPHN SANYHN SALLHN
HOLD_FLASH 1
SCIENCE LOAD

# SPOPHN — popcount high n
CLEARSTACK
PUSH 0xF000000000000000
SPOPHN 4
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0xAB00000000000000
STACKPOPHN 8
POP x
# 0xAB = 10101011 → 5 ones
ASSERT x == 5

# SONESHN alias
CLEARSTACK
PUSH 0x00
SONESHN 8
POP x
ASSERT x == 0

# SANYHN
CLEARSTACK
PUSH 0x0F00000000000000
SANYHN 4
POP x
# high nibble is 0 → no
ASSERT x == 0

CLEARSTACK
PUSH 0x1000000000000000
STACKANYHN 4
POP x
# bit 60 set within high 4
ASSERT x == 1

CLEARSTACK
PUSH 0x00
ANYHN 8
POP x
ASSERT x == 0

# SALLHN
CLEARSTACK
PUSH 0xF000000000000000
SALLHN 4
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x7000000000000000
STACKALLHN 4
POP x
ASSERT x == 0

# n=0 vacuous all
CLEARSTACK
PUSH 0x00
ALLHN 0
POP x
ASSERT x == 1

# soft fails
CLEARSTACK
SPOPHN 4
ASSERT OK == 0
CLEARSTACK
SANYHN 4
ASSERT OK == 0
CLEARSTACK
SALLHN 4
ASSERT OK == 0

HOLD_FLASH 1
