# Proof 278 — digit-0 stack imm inverted 16-bit field: SNAND16N SNOR16N SXNOR16N
HOLD_FLASH 1
SCIENCE LOAD

# SNAND16N field n
CLEARSTACK
PUSH 0x1122334455667788
SNAND16N 0x00FF 0
POP x
ASSERT x == 0x112233445566FF77

CLEARSTACK
PUSH 0x1122334455667788
STACKNAND16N 0x00FF 1
POP x
ASSERT x == 0x11223344FF997788

CLEARSTACK
PUSH -1
NAND16N 0xFFFF 0
POP x
ASSERT x == -65536

# SNOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
SNOR16N 0xFF00 0
POP x
ASSERT x == 0x1122334455660077

CLEARSTACK
PUSH 0x1122334455667788
STACKNOR16N 0xFF00 2
POP x
ASSERT x == 0x112200BB55667788

CLEARSTACK
PUSH 0
NOR16N 0x0000 0
POP x
ASSERT x == 0xFFFF

CLEARSTACK
PUSH 0
SINVERTOR16N 0xABCD 3
POP x
ASSERT x == 0x5432000000000000

# SXNOR16N field n
CLEARSTACK
PUSH 0x1122334455667788
SXNOR16N 0x00FF 0
POP x
ASSERT x == 0x1122334455668888

CLEARSTACK
PUSH 0x1122334455667788
STACKXNOR16N 0x00FF 3
POP x
ASSERT x == 0xEE22334455667788

CLEARSTACK
PUSH 0
XNOR16N 0xABCD 1
POP x
ASSERT x == 0x54320000

CLEARSTACK
PUSH -1
SEQUIV16N 0x0000 0
POP x
ASSERT x == -65536

CLEARSTACK
PUSH -1
SXNOR16N 0xFFFF 0
POP x
ASSERT x == -1

# soft fails
CLEARSTACK
SNAND16N 1 0
ASSERT OK == 0
CLEARSTACK
SNOR16N 1 0
ASSERT OK == 0
CLEARSTACK
SXNOR16N 1 0
ASSERT OK == 0

HOLD_FLASH 1
