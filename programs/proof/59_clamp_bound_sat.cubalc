# Proof 59 — digit-1 BOUND SATADD/SATSUB/SATMUL WRAPMOD CLIP8/16 + stack
HOLD_FLASH 1
SCIENCE LOAD

# BOUND alias of CLAMP
ASSERT BOUND(15, 0, 10) == 10
ASSERT BOUND(-3, 0, 10) == 0
ASSERT BOUND(7, 0, 10) == 7
ASSERT BOUND(5, 10, 0) == 5

# WRAPMOD / WMOD non-negative remainder
ASSERT WRAPMOD(10, 3) == 1
ASSERT WRAPMOD(-1, 5) == 4
ASSERT WRAPMOD(0, 7) == 0
ASSERT WMOD(17, 8) == 1
ASSERT WRAPMOD(9, 0) == 0

# CLIP8 / CLIP16
ASSERT CLIP8(300) == 255
ASSERT CLIP8(-1) == 0
ASSERT CLIP8(128) == 128
ASSERT CLIP16(70000) == 65535
ASSERT CLIP16(-5) == 0
ASSERT CLIP16(1000) == 1000

# SATADD / SATSUB / SATMUL (no overflow cases use ordinary values)
ASSERT SATADD(10, 20) == 30
ASSERT SATSUB(10, 3) == 7
ASSERT SATMUL(6, 7) == 42
ASSERT SATADD(-5, -3) == -8
ASSERT SATSUB(-5, 3) == -8

# compose with CLAMP/SELECT
ASSERT CLIP8(SATADD(200, 100)) == 255
ASSERT BOUND(SATMUL(3, 4), 0, 10) == 10
ASSERT SELECT(WRAPMOD(4, 2) == 0, 1, 0) == 1

# stack SSATADD SSATSUB SSATMUL
CLEARSTACK
PUSH 11
PUSH 22
SSATADD
ASSERT LAST_N == 33
CLEARSTACK
PUSH 50
PUSH 8
SSATSUB
ASSERT LAST_N == 42
CLEARSTACK
PUSH 9
PUSH 6
SSATMUL
ASSERT LAST_N == 54

# stack SWMOD
CLEARSTACK
PUSH -1
PUSH 5
SWMOD
ASSERT LAST_N == 4
CLEARSTACK
PUSH 10
PUSH 3
SWRAPMOD
ASSERT LAST_N == 1

# stack SCLIP8 SCLIP16
CLEARSTACK
PUSH 400
SCLIP8
ASSERT LAST_N == 255
CLEARSTACK
PUSH -2
SCLIP8
ASSERT LAST_N == 0
CLEARSTACK
PUSH 70000
SCLIP16
ASSERT LAST_N == 65535

# stack SBOUND
CLEARSTACK
PUSH 99
PUSH 0
PUSH 10
SBOUND
ASSERT LAST_N == 10
CLEARSTACK
PUSH -4
PUSH 0
PUSH 10
STACKBOUND
ASSERT LAST_N == 0

# underflow
CLEARSTACK
SSATADD
ASSERT OK == 0
CLEARSTACK
SWMOD
ASSERT OK == 0
CLEARSTACK
SCLIP8
ASSERT OK == 0
CLEARSTACK
SBOUND
ASSERT OK == 0

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof59_clamp_bound_sat" LAST_N SP
