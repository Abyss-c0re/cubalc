# Proof 284 — digit-9 dual-stack imm ANDN plane: DANDNI DORNI DXORNI
HOLD_FLASH 1
SCIENCE LOAD

# DANDNI n — a b → (a&~n) (b&~n)
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DANDNI 0x0F
POP y
POP x
ASSERT x == 0x1122334455667780
ASSERT y == 0x99AABBCCDDEEFF00

CLEARSTACK
PUSH 0xABCD
PUSH 0x1234
DBICI 0xFF
POP y
POP x
ASSERT x == 0xAB00
ASSERT y == 0x1200

CLEARSTACK
PUSH -1
PUSH -1
PAIRANDNI 0xF0
POP y
POP x
ASSERT x == -241
ASSERT y == -241

# DORNI n — a b → (a|~n) (b|~n)
CLEARSTACK
PUSH 0
PUSH 0
DORNI 0
POP y
POP x
ASSERT x == -1
ASSERT y == -1

CLEARSTACK
PUSH 0
PUSH 0
PAIRORNI 0xFF
POP y
POP x
ASSERT x == -256
ASSERT y == -256

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DORNOTI 0x0F
POP y
POP x
ASSERT x == -8
ASSERT y == -16

# DXORNI n — a b → (a^~n) (b^~n) (equiv DXNORI)
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXORNI 0x0F
POP y
POP x
ASSERT x == 0xEEDDCCBBAA998878
ASSERT y == 0x66554433221100F0

CLEARSTACK
PUSH -1
PUSH -1
PAIRXORNI 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH -1
PUSH 0
DXORNOTI 0xF
POP y
POP x
ASSERT x == 15
ASSERT y == -16

CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXNORI 0x0F
POP y2
POP x2
CLEARSTACK
PUSH 0x1122334455667788
PUSH 0x99AABBCCDDEEFF00
DXORNI 0x0F
POP y
POP x
ASSERT x == x2
ASSERT y == y2

# soft fails (need 2 stack items)
CLEARSTACK
DANDNI 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DORNI 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
POP z
DXORNI 1
ASSERT OK == 0

HOLD_FLASH 1
