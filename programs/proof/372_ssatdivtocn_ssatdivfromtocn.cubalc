# Proof 372 — digit-9 reverse imm sat TOC: SSATDIVTOCN SSATSUBFROMTOCN SSATDIVFROMTOCN
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SSATDIVTOCN: 20/4 = 5
CELLSET 1 20
PUSH 1
SSATDIVTOCN 4
ASSERT LAST_N == 5
ASSERT CELL(1) == 5
POP a
ASSERT a == 5

# SATDIVTOCN soft /0 → 0
CELLSET 2 9
PUSH 2
SATDIVTOCN 0
ASSERT LAST_N == 0
ASSERT CELL(2) == 0
POP

# SDIVSATTOCN: 15/2 = 7
CELLSET 3 15
PUSH 3
SDIVSATTOCN 2
ASSERT LAST_N == 7
ASSERT CELL(3) == 7
POP

# SSATSUBFROMTOCN: sat(10-3) = 7
CELLSET 4 3
PUSH 4
SSATSUBFROMTOCN 10
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
POP

# RSATSUBTOCN: sat(3-5) = -2
CELLSET 5 5
PUSH 5
RSATSUBTOCN 3
ASSERT LAST_N == -2
ASSERT CELL(5) == -2
POP

# SSATDIVFROMTOCN: sat(20/4) with cell=4 → 5
CELLSET 6 4
PUSH 6
SSATDIVFROMTOCN 20
ASSERT LAST_N == 5
ASSERT CELL(6) == 5
POP

# RSATDIVTOCN soft cell0 → 0
CELLSET 7 0
PUSH 7
RSATDIVTOCN 10
ASSERT LAST_N == 0
ASSERT CELL(7) == 0
POP

# SSATDIVFROMTOCN: 15/2 cell=2 → 7
CELLSET 8 2
PUSH 8
SSATDIVFROMTOCN 15
ASSERT LAST_N == 7
ASSERT CELL(8) == 7
POP

# soft empty OK=0
CLEARSTACK
SSATDIVTOCN 2
ASSERT OK == 0

PRINT "372_ssatdivtocn_ssatdivfromtocn OK"
