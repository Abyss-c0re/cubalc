# Proof 395 — digit-9 stack dual inverted low-n mask TOC: SNANDMNTOC SNORMNTOC SXNORMNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SNANDMNTOC: ~(13 & low-4) = ~13 = -14
CELLSET 1 13
PUSH 1
PUSH 4
SNANDMNTOC
ASSERT LAST_N == -14
ASSERT CELL(1) == -14
POP a
ASSERT a == -14

# NANDMNTOC n=0: ~(x & 0) = ~0 = -1
CELLSET 2 99
PUSH 2
PUSH 0
NANDMNTOC
ASSERT LAST_N == -1
ASSERT CELL(2) == -1
POP

# SNORMNTOC: ~(0 | low-3) = ~7 = -8
CELLSET 3 0
PUSH 3
PUSH 3
SNORMNTOC
ASSERT LAST_N == -8
ASSERT CELL(3) == -8
POP

# NORMNTOC: ~(8 | low-2) = ~(8|3)= ~11 = -12
CELLSET 4 8
PUSH 4
PUSH 2
NORMNTOC
ASSERT LAST_N == -12
ASSERT CELL(4) == -12
POP

# SXNORMNTOC: ~(0 ^ low-4) = ~15 = -16
CELLSET 5 0
PUSH 5
PUSH 4
SXNORMNTOC
ASSERT LAST_N == -16
ASSERT CELL(5) == -16
POP

# XNORMNTOC: ~(15 ^ low-4) = ~0 = -1
CELLSET 6 15
PUSH 6
PUSH 4
XNORMNTOC
ASSERT LAST_N == -1
ASSERT CELL(6) == -1
POP

# soft short stack OK=0
CLEARSTACK
SNANDMNTOC
ASSERT OK == 0
PUSH 1
SNORMNTOC
ASSERT OK == 0

PRINT "395_snandmntoc_sxnormntoc OK"
