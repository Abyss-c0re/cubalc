# Proof 330 — digit-6 energy ANDN TOC: SANDNTOC SORNTOC SXORNTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SANDNTOC: 15 & ~6 = 9
CELLSET 1 15
PUSH 1
PUSH 6
SANDNTOC
ASSERT LAST_N == 9
ASSERT CELL(1) == 9
POP a
ASSERT a == 9

# SBICTOC alias: 255 & ~1 = 254
CELLSET 2 255
PUSH 2
PUSH 1
SBICTOC
ASSERT LAST_N == 254
ASSERT CELL(2) == 254
POP

# SORNTOC: 0 | ~0 = -1
CELLSET 3 0
PUSH 3
PUSH 0
SORNTOC
ASSERT LAST_N == -1
ASSERT CELL(3) == -1
POP

# SORNOTTOC: 1 | ~2
# ~2 = -3; 1 | -3 = -3
CELLSET 4 1
PUSH 4
PUSH 2
SORNOTTOC
ASSERT LAST_N == -3
ASSERT CELL(4) == -3
POP

# SXORNTOC: 0 ^ ~0 = -1
CELLSET 5 0
PUSH 5
PUSH 0
SXORNTOC
ASSERT LAST_N == -1
ASSERT CELL(5) == -1
POP

# XORNOTTOC: 7 ^ ~0 = 7 ^ -1 = ~7 = -8
CELLSET 6 7
PUSH 6
PUSH 0
XORNOTTOC
ASSERT LAST_N == -8
ASSERT CELL(6) == -8
POP

# soft fails
CLEARSTACK
SANDNTOC
ASSERT OK == 0
SORNTOC
ASSERT OK == 0
SXORNTOC
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof330_sandntoc_sxorntoc" LAST_N SP
HOLD_FLASH 1
