# Proof 466 — digit-7 stack imm 4-bit field abs+extend: SABS4N SSEXT4N SZEXT4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SABS4N: 0xE (-2) → 0x2; 0x5 → 0x5; min 0x8 → 0x8
PUSH 0xE
SABS4N 0
POP x
ASSERT x == 2

CLEARSTACK
PUSH 0x5
ABS4N 0
POP x
ASSERT x == 5

CLEARSTACK
PUSH 0x8
SABS4N 0
POP x
ASSERT x == 8

# high preserved: 0x...7E abs low → 0x...72
CLEARSTACK
PUSH 0x112233445566777E
SABS4N 0
POP x
ASSERT x == 0x1122334455667772

# STACKABS4N n1: nibble1 of 0x...D0 is D=-3 → abs 3 → 0x...30
CLEARSTACK
PUSH 0xD0
STACKABS4N 1
POP x
ASSERT x == 0x30

# SSEXT4N: 0x7 → 7; 0xE → -2; 0x8 → -8
CLEARSTACK
PUSH 0x7
SSEXT4N 0
POP x
ASSERT x == 7

CLEARSTACK
PUSH 0xE
SSEXT4N 0
POP x
ASSERT x == -2

CLEARSTACK
PUSH 0x8
SEXT4N 0
POP x
ASSERT x == -8

# SSEXT4N n1 of 0x...A0: nibble1=A=-6
CLEARSTACK
PUSH 0xA0
STACKSEXT4N 1
POP x
ASSERT x == -6

# high ignored: 0xFF SSEXT4N 0 → -1 (low nibble F)
CLEARSTACK
PUSH 0xFF
SSEXT4N 0
POP x
ASSERT x == -1

# SZEXT4N: extract low nibble; 0xAB → 0xB; n1 of 0xAB → 0xA
CLEARSTACK
PUSH 0xAB
SZEXT4N 0
POP x
ASSERT x == 11

CLEARSTACK
PUSH 0xAB
ZEXT4N 1
POP x
ASSERT x == 10

# STACKZEXT4N n2 of 0x...123: nibble2=1
CLEARSTACK
PUSH 0x123
STACKZEXT4N 2
POP x
ASSERT x == 1

# SNIBZEXTN alias: 0x0 → 0
CLEARSTACK
PUSH 0xF0
SNIBZEXTN 0
POP x
ASSERT x == 0

# SSEXT then abs via SABS full-stack path check: 0xC sext → -4
CLEARSTACK
PUSH 0xC
SSEXTNIBN 0
POP x
ASSERT x == -4

HOLD_FLASH 0
