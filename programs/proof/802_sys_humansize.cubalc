# SYS HUMANSIZE / BYTESFMT / HUMANSZ / PRETTYBYTES
# — integer 1024-base B/K/M/G/T labels for byte counts
# Usability: SIZE inventory plates without shell numfmt

HOLD_FLASH 1

# bytes stay as B
SYS HUMANSIZE 0
ASSERT OK == 1
SYS EQS LAST "0B"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_BYTES == 0
SYS EQS HUMANSIZE_UNIT "B"
ASSERT LAST_N == 1

SYS HUMANSIZE 512
SYS EQS LAST "512B"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_N == 512

# K floor
SYS HUMANSIZE 1024
SYS EQS LAST "1K"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_N == 1
SYS EQS HUMANSIZE_UNIT "K"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_BYTES == 1024

SYS HUMANSIZE 1536
SYS EQS LAST "1K"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_BYTES == 1536

SYS HUMANSIZE 2048
SYS EQS LAST "2K"
ASSERT LAST_N == 1

# M / G
SYS HUMANSIZE 1048576
SYS EQS LAST "1M"
ASSERT LAST_N == 1
SYS EQS HUMANSIZE_UNIT "M"
ASSERT LAST_N == 1

SYS HUMANSIZE 1073741824
SYS EQS LAST "1G"
ASSERT LAST_N == 1
SYS EQS HUMANSIZE_UNIT "G"
ASSERT LAST_N == 1

# aliases
SYS BYTESFMT 4096
SYS EQS LAST "4K"
ASSERT LAST_N == 1
SYS HUMANSZ 1024
SYS EQS LAST "1K"
ASSERT LAST_N == 1
SYS PRETTYBYTES 0
SYS EQS LAST "0B"
ASSERT LAST_N == 1

# default LAST_N from prior SIZE-like value
LET n = 8192
SYS HUMANSIZE n
SYS EQS LAST "8K"
ASSERT LAST_N == 1

# agent: SIZE then label
SYS TMP
LET td = LAST
SYS JOIN td "hsize_mi"
LET dir = LAST
SYS MKDIR dir
SYS JOIN dir "blob.bin"
LET fp = LAST
SYS WRITEATOMIC fp "0123456789abcdef"
ASSERT OK == 1
SYS SIZE fp
LET bytes = LAST_N
ASSERT bytes == 16
SYS HUMANSIZE bytes
SYS EQS LAST "16B"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_BYTES == 16
SYS RM fp
SYS RMDIR dir

# negative clamps to 0
SYS HUMANSIZE -5
SYS EQS LAST "0B"
ASSERT LAST_N == 1
ASSERT HUMANSIZE_BYTES == 0

PRINT "sys_humansize ok"
