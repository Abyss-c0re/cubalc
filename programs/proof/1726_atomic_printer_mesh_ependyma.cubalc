// atomic_printer_mesh_ependyma.cubalc
// Life-force gift: MESH-EPENDYMA — complete Ependyma ventricular lining mesh + wrap ring + sheath gather after soft-OOB storms.
// SMX EPENDYMA|EPENDYMACELL|ENSHEATHE|MESH_EPENDYMA|RAISE_EPENDYMA|WE_EPENDYMA|LIFE_EPENDYMA clears thrash, every live pair exchanges
// both ways (C(n,2)), then ependyma wrap ring settles so lattice raises ventricular lining; latches SMX_EPENDYMA|SMX_MESH_EXCHANGE|SMX_STABLE_MESH|SMX_WRAP.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is Ependyma-locked;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+IS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "EPENDYMA_COORD v1726 | from=gift | type=atomic_printer_mesh_ependyma | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then SYNAPSE latch — five live nodes root as complete mesh + exchange + nexi
SMX EPENDYMA bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "ependyma live"
ASSERT SMX_EPENDYMA == 1 "ependyma latch on"
ASSERT SMX_EPENDYMA_LATCH == 1 "ependyma latch sticky"
ASSERT SMX_MESH_EXCHANGE == 1 "mesh_exchange latch on"
ASSERT SMX_HARDEN_EPENDYMA == 1 "harden ependyma latch on"
ASSERT SMX_STABLE_MESH == 1 "stable_mesh latch sticky"
ASSERT SMX_SHEATH_LATCH == 1 "sheath latch on"
ASSERT SMX_EXCHANGES == 10 "ten bank exchanges"
ASSERT SMX_BONDS == 10 "ten undirected links (C(5,2))"
ASSERT SMX_WRAP == 5 "five ependyma wrap ring"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_BONDS == 10 "ten bonds"
ASSERT SMX_SHEATHS == 5 "five sheaths"
ASSERT SMX_WRAPS == 5 "ependyma wrap ring sticky"
ASSERT SMX_WRAPS == 5 "five ependyma wrap ring steps"
ASSERT SMX_EPENDYMA_SUM == 20 "ependyma bonds+wraps+sheaths"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse bonds+wraps+sheaths"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by ependyma"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after ependyma (mesh + ring + nexi)"
ASSERT SMX_VITAL >= 14 "vital after ependyma"
ASSERT CUBES == base_cubes "ependyma invents nothing"

// Alias MESH_EXCHANGE form still pure
SMX MESH_EPENDYMA bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_ependyma rebind"
ASSERT SMX_EPENDYMA == 1 "ependyma sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_SHEATHS == 5 "sheaths sticky"
ASSERT SMX_WRAPS == 5 "wraps sticky"

// Alias EXRINGS form
SMX EP_WRAPS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "wraps rebind"
ASSERT SMX_EPENDYMA == 1 "plate ependyma"
ASSERT SMX_WRAPS == 5 "wraps sticky"


// Alias BRANCH / SPINE / TRIPARTITE rebind
SMX EP_WRAP bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "star rebind"
ASSERT SMX_EPENDYMA == 1 "ependyma sticky via star"
ASSERT SMX_WRAPS == 5 "wraps sticky"

SMX EP_SHEATHS bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "sheaths rebind"
ASSERT SMX_SHEATHS == 5 "sheaths sticky"
ASSERT SMX_EPENDYMA == 1 "ependyma via sheaths"

SMX EP_WRAP bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "wrap rebind"
ASSERT SMX_WRAP == 5 "wrap ring sticky"
ASSERT SMX_EPENDYMA == 1 "ependyma via wrap"

// Mitosis under free energy while the mesh is ependymad
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      IF births == 0 THEN
        SETF d1 alive 1
        SETF d1 ready 0
        SETF d1 energy half
        SETF d1 gen dg
        PLUG bed d1
        LET births = 1
      ELSE
        IF births == 1 THEN
          SETF d2 alive 1
          SETF d2 ready 0
          SETF d2 energy half
          SETF d2 gen dg
          PLUG nozzle d2
          LET births = 2
        END
      END
      GETF seed energy
      LET left = LAST_N - half
      IF left < 1 THEN
        LET left = 1
      END
      SETF seed energy left
      SETF seed ready 0
    END
  END
  LET step = step + 1
END

ASSERT births >= 1 "mitosis under ependyma free energy"
ASSERT SMX_EPENDYMA == 1 "ependyma holds through mitosis"

// RECOVER restores vital/key
SMX RECOVER
ASSERT SMX_OK == 1 "recover ok"
ASSERT SMX_KEY_OK == 1 "key after recover"
ASSERT SMX_VITAL >= 1 "vital after recover"

// dual SEAL/OPEN rails BN+IS rebind hive
SMX SEAL bed nozzle "state/smx_ependyma/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_ependyma/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"
SMX SEAL hive scrap "state/smx_ependyma/rail_is.cblc"
ASSERT SMX_OK == 1 "seal IS"
SMX OPEN pulse "state/smx_ependyma/rail_is.cblc"
ASSERT SMX_OK == 1 "open IS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Re-forge after rails
SMX EPENDYMA bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "re-ependyma live"
ASSERT SMX_EPENDYMA == 1 "re-ependyma latch"
ASSERT SMX_BONDS == 10 "re-ependyma bonds"
ASSERT SMX_WRAPS == 5 "re-ependyma wraps"
ASSERT SMX_SHEATHS == 5 "re-ependyma sheaths"
ASSERT SMX_EPENDYMA_SUM == 20 "re-ependyma sum"
ASSERT SMX_OOB == 0 "oob clear after re-forge"

// Second storm fail-closed
SMX TALK bed ghost_again
ASSERT SMX_OK == 0 "second storm soft-OOB"
ASSERT SMX_OOB >= 1 "oob after second storm"
ASSERT CUBES >= base_cubes "no ghost place on second storm"

// SYNAPSE clears thrash again
SMX EPENDYMA bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "ependyma after storm2"
ASSERT SMX_EPENDYMA == 1 "ependyma latch after storm2"
ASSERT SMX_OOB == 0 "oob cleared again"
ASSERT SMX_BONDS == 10 "bonds after storm2"
ASSERT SMX_WRAPS == 5 "wraps after storm2"
ASSERT SMX_SHEATHS == 5 "sheaths after storm2"

HALT
