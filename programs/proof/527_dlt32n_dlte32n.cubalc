# Proof 527 — digit-6 dual-stack imm 32-bit field ordered-cmp: DLT32N DGT32N DLTE32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLT32N: 0x10 < 0xC0 → 1 ; 0xF0 < 0xC0 → 0
PUSH 0x10000000
PUSH 0xF0000000
DLT32N 0xC0000000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0xC0000000
PUSH 0xC0000000
PAIRLT32N 0xC0000000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved: low 0x10 < 0x20 → low 1
CLEARSTACK
PUSH 0x1122334400000010
PUSH 0x99AABBCC00000030
DLT32N 0x20 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000000

# S2LT32N n1: high 0x10 < 0x20 → high 1
CLEARSTACK
PUSH 0x1000000000000000
PUSH 0x3000000000000000
S2LT32N 0x20000000 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# DGT32N: 0xF0 > 0x20 → 1 ; 0x10 > 0x20 → 0
CLEARSTACK
PUSH 0xF0000000
PUSH 0x10000000
DGT32N 0x20000000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# equal → 0
CLEARSTACK
PUSH 0x55555555
PUSH 0x55555555
PAIRGT32N 0x55555555 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# high preserved gt
CLEARSTACK
PUSH 0x99AABBCC00008000
PUSH 0x1122334400000500
DGT32N 0x1000 0
POP y
POP x
ASSERT x == 0x99AABBCC00000001
ASSERT y == 0x1122334400000000

# S2GT32N n1
CLEARSTACK
PUSH 0x9000000000000000
PUSH 0x0500000000000000
S2GT32N 0x10000000 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

# DLTE32N: less → 1 ; equal → 1 ; greater → 0
CLEARSTACK
PUSH 0x10000000
PUSH 0xC0000000
DLTE32N 0xC0000000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0xFFFFFFFE
DLEQ32N 0xFFFFFFFE 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# high preserved lte
CLEARSTACK
PUSH 0x1122334400007742
PUSH 0x99AABBCC00007743
DLTE32N 0x7742 0
POP y
POP x
ASSERT x == 0x1122334400000001
ASSERT y == 0x99AABBCC00000000

# STACK2LTE32N n1
CLEARSTACK
PUSH 0x5555555500000000
PUSH 0x5555555400000000
S2LTE32N 0x55555554 1
POP y
POP x
ASSERT x == 0x0000000000000000
ASSERT y == 0x0000000100000000

# aliases + unsigned high-bit
CLEARSTACK
PUSH 1
PUSH 3
DCMPLT32N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 3
PUSH 1
DCMPGT32N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 2
PUSH 2
DCMPLE32N 2 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

CLEARSTACK
PUSH 0x80000000
PUSH 0x7FFFFFFF
DGT32N 0x7FFFFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

HOLD_FLASH 0
