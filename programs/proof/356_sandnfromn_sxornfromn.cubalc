# Proof 356 — digit-7 reverse imm ANDN plane: SANDNFROMN SORNFROMN SXORNFROMN
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SANDNFROMN: n=0xFF, TOS=0x0F → 0xFF & ~0x0F = 0xF0 = 240
PUSH 15
SANDNFROMN 255
POP a
ASSERT a == 240

# BICFROMN: n=42, TOS=0 → 42 & ~0 = 42
PUSH 0
BICFROMN 42
POP a
ASSERT a == 42

# RANDNFROMN: n=7, TOS=-1 → 7 & ~(-1) = 0
PUSH (-1)
RANDNFROMN 7
POP a
ASSERT a == 0

# SORNFROMN: n=0, TOS=0 → 0 | ~0 = -1
PUSH 0
SORNFROMN 0
POP a
ASSERT a == (-1)

# ORNFROMN: n=8, TOS=1 → 8 | ~1 = -2
PUSH 1
ORNFROMN 8
POP a
ASSERT a == (-2)

# RORNFROMN: n=0, TOS=255 → 0 | ~255 = -256
PUSH 255
RORNFROMN 0
POP a
ASSERT a == (-256)

# SXORNFROMN: n=0, TOS=0 → 0 ^ ~0 = -1
PUSH 0
SXORNFROMN 0
POP a
ASSERT a == (-1)

# XORNFROMN: n=5, TOS=5 → 5 ^ ~5 = -1
PUSH 5
XORNFROMN 5
POP a
ASSERT a == (-1)

# RXORNFROMN: n=1, TOS=0 → 1 ^ ~0 = -2
PUSH 0
RXORNFROMN 1
POP a
ASSERT a == (-2)

# SBICFROMN: n=0xF0, TOS=0x0F → 0xF0 & ~0x0F = 0xF0 = 240
PUSH 15
SBICFROMN 240
POP a
ASSERT a == 240

# soft empty-stack OK=0
CLEARSTACK
SANDNFROMN 1
ASSERT OK == 0

PRINT "356_sandnfromn_sxornfromn OK"
