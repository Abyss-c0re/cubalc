# Proof 558 — digit-7 stack+dual field zero-eq 8/4: S0EQ8N S0EQ4N D0EQ8N D0EQ4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# S0EQ8N: 0 → 1
PUSH 0x0
S0EQ8N 0
POP x
ASSERT x == 1

# non-zero → 0
CLEARSTACK
PUSH 0x5
SZ8N 0
POP x
ASSERT x == 0

# 0xFF not zero
CLEARSTACK
PUSH 0xFF
SEQZ8N 0
POP x
ASSERT x == 0

# high preserve
CLEARSTACK
PUSH 0xAA00
SISZERO8N 0
POP x
ASSERT x == 0xAA01

# STACK0EQ8N n1: high 0 → high 1
CLEARSTACK
PUSH 0x0003
STACK0EQ8N 1
POP x
ASSERT x == 0x0103

# high non-zero → 0
CLEARSTACK
PUSH 0x0200
STACK0EQ8N 1
POP x
ASSERT x == 0x0000

# S0EQ4N: 0 → 1
CLEARSTACK
PUSH 0x0
S0EQ4N 0
POP x
ASSERT x == 1

# non-zero
CLEARSTACK
PUSH 0x3
SZ4N 0
POP x
ASSERT x == 0

# high nibble preserve: low 0 → 1; high 1 stays
CLEARSTACK
PUSH 0x10
S0EQ4N 0
POP x
ASSERT x == 0x11

# STACK0EQ4N n1: high 0 → 1; low 5
CLEARSTACK
PUSH 0x05
STACK0EQ4N 1
POP x
ASSERT x == 0x15

# D0EQ8N
CLEARSTACK
PUSH 0x0
PUSH 0x7
D0EQ8N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFF
PUSH 0x0
PAIR0EQ8N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK20EQ8N n1
CLEARSTACK
PUSH 0x0001
PUSH 0x0500
STACK20EQ8N 1
POP y
POP x
ASSERT x == 0x0101
ASSERT y == 0x0000

# D0EQ4N
CLEARSTACK
PUSH 0x0
PUSH 0x3
D0EQ4N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xF
PUSH 0x0
PAIR0EQ4N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK20EQ4N n1
CLEARSTACK
PUSH 0x03
PUSH 0x50
STACK20EQ4N 1
POP y
POP x
ASSERT x == 0x13
ASSERT y == 0x00

HOLD_FLASH 0
