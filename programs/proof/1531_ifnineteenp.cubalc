# IFNINETEENP — plate exactly-nineteen key diagnostic branch
# Continues ladder after IFEIGHTEENP. Soft twin ENNEADECAP.
# MI-1016 seal: duals IFENNEADECAP/IFNINETEENKEYP + WHEN* + *_N/*_LEN

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET eighteen = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18}"
LET nineteen = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19}"
LET twenty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20}"
LET empty = "{}"

IFNINETEENP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFNINETEENP_N == 1
ASSERT NINETEENP_N == 1
ASSERT IFNINETEENP_LEN == 19
ASSERT IFENNEADECAP_N == 1
ASSERT IFNINETEENKEYP_N == 1

IFENNEADECAP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFNINETEENKEYP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFNINETEENP eighteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFNINETEENP_N == 0
ASSERT IFNINETEENP_LEN == 18

IFNINETEENP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFNINETEENP_LEN == 20

IFNINETEENP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFNINETEENP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENNINETEENP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENENNEADECAP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENNINETEENKEYP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "ifnineteenp_ok" IFNINETEENP_N IFNINETEENP_LEN
PASS
