# Proof 302 — digit-6 imm energy wrap: SWMODN SWRAPN DWRAPN DWMODN
HOLD_FLASH 1
SCIENCE LOAD

# SWMODN m — normal
CLEARSTACK
PUSH 17
SWMODN 5
POP x
ASSERT x == 2

# SWRAPN — negative wrap into [0,m)
CLEARSTACK
PUSH -3
SWRAPN 10
POP x
ASSERT x == 7

# WRAPN alias
CLEARSTACK
PUSH 25
WRAPN 8
POP x
ASSERT x == 1

# m<=0 → 0
CLEARSTACK
PUSH 99
SWMODIMM 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 5
WMODN -1
POP x
ASSERT x == 0

# DWRAPN shared modulus
CLEARSTACK
PUSH 17
PUSH -3
DWRAPN 10
POP y
POP x
ASSERT x == 7
ASSERT y == 7

CLEARSTACK
PUSH 25
PUSH 8
PAIRWRAPN 8
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DWMODN
CLEARSTACK
PUSH -1
PUSH 15
DWMODN 7
POP y
POP x
ASSERT x == 6
ASSERT y == 1

# m<=0 both zero
CLEARSTACK
PUSH 3
PUSH 4
DWRAPIMM 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# soft fails
CLEARSTACK
SWMODN 3
ASSERT OK == 0
CLEARSTACK
DWRAPN 3
ASSERT OK == 0
CLEARSTACK
PUSH 1
PAIRWRAPN 3
ASSERT OK == 0

HOLD_FLASH 1
