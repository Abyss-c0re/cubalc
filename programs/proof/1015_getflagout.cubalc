# GETFLAGOUT / FLAGOUT — path flag peel + ABSPATH + mkdir parent
# LAST = absolute file path (ready for WRITE), not the parent dir.

HOLD_FLASH 1

SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET MI_OUT

SYS TMP
LET td = LAST
SYS PID
SYS STR LAST_N
LET pid = LAST
SYS JOIN td "mi_gfo_"
SYS CAT LAST pid
LET root = LAST
SYS MKDIR root
ASSERT OK == 1

# default nested file under missing dirs
SYS JOIN root "a/b/c/report.json"
LET def = LAST
GETFLAGOUT out|o OR ENV MI_OUT OR def
ASSERT OK == 1
SYS EQS GETFLAGOUT_SRC "default"
ASSERT LAST_N == 1
ASSERT GETFLAGOUT_HIT == 0
ASSERT GETFLAGOUT_CREATED == 1
ASSERT GETFLAGOUT_EXIST == 0
SYS STARTS LAST "/"
ASSERT LAST_N == 1
SYS ENDS LAST "report.json"
ASSERT LAST_N == 1
SYS EQS GETFLAGOUT_RAW def
ASSERT LAST_N == 1
# parent is a/b/c
SYS ENDS GETFLAGOUT_PARENT "c"
ASSERT LAST_N == 1
SYS ISDIR GETFLAGOUT_PARENT
ASSERT LAST_N == 1
# WRITE to LAST (file), not parent
SYS WRITE LAST "{\"ok\":1}"
ASSERT OK == 1
SYS ISFILE LAST
ASSERT LAST_N == 1
ASSERT GETFLAGOUT_EXIST == 0
# re-peel shows file exists
GETFLAGOUT out OR def
ASSERT GETFLAGOUT_CREATED == 0
ASSERT GETFLAGOUT_EXIST == 1
SYS ENDS LAST "report.json"
ASSERT LAST_N == 1

# ENV wins over default
SYS JOIN root "from_env/x.out"
LET envp = LAST
SYS ENV SET MI_OUT envp
GETFLAGOUT out OR ENV MI_OUT OR def
SYS EQS GETFLAGOUT_SRC "env"
ASSERT LAST_N == 1
SYS EQS FLAG_ENV "MI_OUT"
ASSERT LAST_N == 1
ASSERT GETFLAGOUT_CREATED == 1
SYS ENDS LAST "x.out"
ASSERT LAST_N == 1
SYS WRITE LAST "env"
ASSERT OK == 1

# CLI beats ENV
SYS JOIN root "from_cli/y.out"
LET clip = LAST
SYS ENV SET MI_OUT envp
SYS ENV SET CUBALC_ARG0 "--out"
SYS ENV SET CUBALC_ARG1 clip
SYS ENV SET CUBALC_ARGC "2"
GETFLAGOUT out|o OR ENV MI_OUT OR def
ASSERT GETFLAGOUT_HIT == 1
SYS EQS GETFLAGOUT_SRC "cli"
ASSERT LAST_N == 1
SYS EQS FLAG_HIT_NAME "out"
ASSERT LAST_N == 1
SYS ENDS LAST "y.out"
ASSERT LAST_N == 1
SYS WRITE LAST "cli"
ASSERT OK == 1

# short -o
SYS JOIN root "short/z.out"
LET shortp = LAST
SYS ENV SET CUBALC_ARG0 "-o"
SYS ENV SET CUBALC_ARG1 shortp
SYS ENV SET CUBALC_ARGC "2"
FLAGOUT out|o OR "none"
ASSERT GETFLAGOUT_HIT == 1
SYS EQS FLAG_HIT_NAME "o"
ASSERT LAST_N == 1
SYS ENDS LAST "z.out"
ASSERT LAST_N == 1

# empty soft miss
SYS ENV SET CUBALC_ARGC "0"
SYS ENV UNSET MI_OUT
GETFLAGOUT out
ASSERT OK == 0
ASSERT GETFLAGOUT_EXIST == 0
LET e = LAST_ERR
SYS HAS e "empty"
ASSERT LAST_N == 1

# cleanup
SYS WALK root
SYS RMALL LAST
SYS RM root

PRINT "getflagout ok"
