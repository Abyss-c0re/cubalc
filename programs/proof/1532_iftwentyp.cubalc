# IFTWENTYP — plate exactly-twenty key diagnostic branch
# Continues ladder after IFNINETEENP. Soft twin ICOSAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET nineteen = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19}"
LET twenty = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20}"
LET twentyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21}"
LET empty = "{}"

IFTWENTYP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFTWENTYP_N == 1
ASSERT TWENTYP_N == 1
ASSERT IFTWENTYP_LEN == 20
ASSERT IFICOSAP_N == 1
ASSERT IFTWENTYKEYP_N == 1

IFICOSAP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYKEYP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFTWENTYP nineteen
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYP_N == 0
ASSERT IFTWENTYP_LEN == 19

IFTWENTYP twentyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFTWENTYP_LEN == 21

IFTWENTYP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFTWENTYP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENTWENTYP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENICOSAP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENTWENTYKEYP twenty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iftwentyp_ok" IFTWENTYP_N IFTWENTYP_LEN
PASS
