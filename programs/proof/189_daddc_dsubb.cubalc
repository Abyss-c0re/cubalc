# Proof 189 — digit-7 dual-stack multiword: DADDC DSUBB
HOLD_FLASH 1
SCIENCE LOAD

# DADDC no cin, no overflow
CLEARSTACK
LET CARRY = 0
PUSH 10
PUSH 20
PUSH 3
PUSH 4
DADDC
POP y
POP x
ASSERT x == 13
ASSERT y == 24
ASSERT CARRY == 0

# overflow one lane: -1 + 1 → 0 cout
CLEARSTACK
LET CARRY = 0
LET all1 = 0 - 1
PUSH all1
PUSH 5
PUSH 1
PUSH 2
2ADDC
POP y
POP x
ASSERT x == 0
ASSERT y == 7
ASSERT CARRY == 1

# cin=1 both lanes
CLEARSTACK
LET CARRY = 1
PUSH 1
PUSH 1
PUSH 1
PUSH 1
PAIRADDC
POP y
POP x
ASSERT x == 3
ASSERT y == 3
ASSERT CARRY == 0

# both overflow
CLEARSTACK
LET CARRY = 0
PUSH all1
PUSH all1
PUSH 1
PUSH 1
DADC
POP y
POP x
ASSERT x == 0
ASSERT y == 0
ASSERT CARRY == 1

# DSUBB no bin
CLEARSTACK
LET BORROW = 0
LET CARRY = 0
PUSH 10
PUSH 20
PUSH 3
PUSH 5
DSUBB
POP y
POP x
ASSERT x == 7
ASSERT y == 15
ASSERT BORROW == 0

# borrow: 3-5 → wrap
CLEARSTACK
LET BORROW = 0
PUSH 3
PUSH 10
PUSH 5
PUSH 1
2SUBB
POP y
POP x
ASSERT x == -2
ASSERT y == 9
ASSERT BORROW == 1

# bin=1
CLEARSTACK
LET BORROW = 1
PUSH 5
PUSH 5
PUSH 1
PUSH 1
PAIRSUBB
POP y
POP x
ASSERT x == 3
ASSERT y == 3
ASSERT BORROW == 0

# DSBB alias underflow with bin (prefer BORROW, else CARRY)
CLEARSTACK
LET BORROW = 1
LET CARRY = 1
PUSH 0
PUSH 0
PUSH 0
PUSH 0
DSBB
POP y
POP x
ASSERT x == all1
ASSERT y == all1
ASSERT BORROW == 1

# S2ADDC / STACK2SUBB
CLEARSTACK
LET CARRY = 0
PUSH 100
PUSH 200
PUSH 50
PUSH 25
S2ADDC
POP y
POP x
ASSERT x == 150
ASSERT y == 225
ASSERT CARRY == 0

CLEARSTACK
LET BORROW = 0
PUSH 50
PUSH 25
PUSH 10
PUSH 5
STACK2SUBB
POP y
POP x
ASSERT x == 40
ASSERT y == 20
ASSERT BORROW == 0

# soft fail
CLEARSTACK
PUSH 1
PUSH 2
DADDC
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
DSUBB
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof189_daddc_dsubb" LAST_N SP
