# Proof 398 — digit-1 stack dual clear + high-mask TOC: SCLRMNTOC SCLRHNTOC SHMASKTOC
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SCLRMNTOC: clear low 4 of 255 → 240 (0xF0)
CELLSET 1 255
PUSH 1
PUSH 4
SCLRMNTOC
ASSERT LAST_N == 240
ASSERT CELL(1) == 240
POP a
ASSERT a == 240

# CLRMNTOC n=0: no-op leave 99
CELLSET 2 99
PUSH 2
PUSH 0
CLRMNTOC
ASSERT LAST_N == 99
ASSERT CELL(2) == 99
POP

# SCLRHNTOC: all-ones clear high-1 → positive (MSB cleared)
CELLSET 3 0
PUSH 3
PUSH 64
SORMNTOC
POP
PUSH 3
PUSH 1
SCLRHNTOC
ASSERT LAST_N > 0
ASSERT CELL(3) > 0
POP

# CLRHNTOC n=0: no-op leave 7
CELLSET 4 7
PUSH 4
PUSH 0
CLRHNTOC
ASSERT LAST_N == 7
ASSERT CELL(4) == 7
POP

# SHMASKTOC: high-1 → MSB only (negative)
CELLSET 5 0
PUSH 5
PUSH 1
SHMASKTOC
ASSERT LAST_N < 0
ASSERT CELL(5) < 0
POP

# HMASKTOC n=0 → 0
CELLSET 6 42
PUSH 6
PUSH 0
HMASKTOC
ASSERT LAST_N == 0
ASSERT CELL(6) == 0
POP

# soft short stack OK=0
CLEARSTACK
SCLRMNTOC
ASSERT OK == 0
PUSH 1
SCLRHNTOC
ASSERT OK == 0

PRINT "398_sclrmntoc_shmasktoc OK"
