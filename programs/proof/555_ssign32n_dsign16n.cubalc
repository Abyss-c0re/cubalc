# Proof 555 — digit-0 stack+dual signed field signum 32/16: SSIGN32N SSIGN16N DSIGN32N DSIGN16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SSIGN32N: +5 → +1
PUSH 0x5
SSIGN32N 0
POP x
ASSERT x == 1

# 0 → 0
CLEARSTACK
PUSH 0x0
SIGN32N 0
POP x
ASSERT x == 0

# -1 → 0xFFFFFFFF
CLEARSTACK
PUSH 0xFFFFFFFF
SSIGNUM32N 0
POP x
ASSERT x == 0xFFFFFFFF

# INT_MIN → -1 field
CLEARSTACK
PUSH 0x80000000
SGN32N 0
POP x
ASSERT x == 0xFFFFFFFF

# high word preserve: low +3 → +1; high stays
CLEARSTACK
PUSH 0x1122334400000003
SSIGN32N 0
POP x
ASSERT x == 0x1122334400000001

# STACKSIGN32N n1: high -2 → high -1; low preserved
CLEARSTACK
PUSH 0xFFFFFFFE00000007
STACKSIGN32N 1
POP x
ASSERT x == 0xFFFFFFFF00000007

# SSIGN16N: +7 → 1
CLEARSTACK
PUSH 0x7
SSIGN16N 0
POP x
ASSERT x == 1

# 0 → 0
CLEARSTACK
PUSH 0x0
SIGN16N 0
POP x
ASSERT x == 0

# -1=0xFFFF → 0xFFFF
CLEARSTACK
PUSH 0xFFFF
SSIGNUM16N 0
POP x
ASSERT x == 0xFFFF

# high halfword: n1 of 0x0005_0000 → +1 in high; low 0
CLEARSTACK
PUSH 0x00050000
STACKSIGN16N 1
POP x
ASSERT x == 0x00010000

# high preserve around low signum of -3
CLEARSTACK
PUSH 0xABCDFFFD
SSIGN16N 0
POP x
ASSERT x == 0xABCDFFFF

# DSIGN32N
CLEARSTACK
PUSH 0x5
PUSH 0xFFFFFFFE
DSIGN32N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0xFFFFFFFF

CLEARSTACK
PUSH 0x0
PUSH 0x80000000
PAIRSIGN32N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFFFFFFFF

# STACK2SIGN32N n1
CLEARSTACK
PUSH 0x0000000300000000
PUSH 0xFFFFFFFD00000000
STACK2SIGN32N 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0xFFFFFFFF00000000

# DSIGN16N
CLEARSTACK
PUSH 0x7
PUSH 0xFFFE
DSIGN16N 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0xFFFF

CLEARSTACK
PUSH 0x0
PUSH 0x8000
PAIRSIGN16N 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0xFFFF

# STACK2SIGN16N n1
CLEARSTACK
PUSH 0x00030000
PUSH 0xFFFD0000
STACK2SIGN16N 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0xFFFF0000

HOLD_FLASH 0
