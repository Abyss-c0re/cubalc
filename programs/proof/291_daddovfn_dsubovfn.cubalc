# Proof 291 — digit-3 dual-stack imm overflow: DADDOVFN DSUBOVFN DMULOVFN
HOLD_FLASH 1
SCIENCE LOAD

# DADDOVFN n
CLEARSTACK
PUSH 10
PUSH 20
DADDOVFN 5
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 9223372036854775807
PUSH 0
PAIRADDOVFN 1
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -9223372036854775807
PUSH -9223372036854775807
DADDOVERIMM -2
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DSUBOVFN n
CLEARSTACK
PUSH 10
PUSH -5
DSUBOVFN 3
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH -9223372036854775807
PUSH 9223372036854775807
PAIRSUBOVFN 2
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 9223372036854775807
PUSH 0
DSUBOVERIMM -1
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DMULOVFN n
CLEARSTACK
PUSH 6
PUSH 7
DMULOVFN 7
POP y
POP x
ASSERT x == 0
ASSERT y == 0

CLEARSTACK
PUSH 0
PUSH 3037000500
PAIRMULOVFN 3037000500
POP y
POP x
ASSERT x == 0
ASSERT y == 1

CLEARSTACK
PUSH 9223372036854775807
PUSH -3037000500
DMULOVERIMM 2
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH -3037000500
PUSH -3037000500
DMULOVFN 3037000500
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# soft fails
CLEARSTACK
DADDOVFN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSUBOVFN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
POP z
DMULOVFN 1
ASSERT OK == 0

HOLD_FLASH 1
