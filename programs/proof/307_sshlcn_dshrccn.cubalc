# Proof 307 — digit-5 imm rotate-through-CARRY: SSHLCN SSHRCN DSHLCCN DSHRCCN
HOLD_FLASH 1
SCIENCE LOAD

# SSHLCN n=1 matches SSHLC
CLEARSTACK
LET CARRY = 1
PUSH 4
SSHLCN 1
POP x
ASSERT x == 9
ASSERT CARRY == 0

# SSHLCN multi-bit no cin: 5 RCL 3 = 40
CLEARSTACK
LET CARRY = 0
PUSH 5
RCLN 3
POP x
ASSERT x == 40
ASSERT CARRY == 0

# SSHLCN n=0 is identity
CLEARSTACK
LET CARRY = 1
PUSH 42
SHLCYN 0
POP x
ASSERT x == 42
ASSERT CARRY == 1

# SSHLCN RCL2 from high bit: bit walks to bit0, cout cleared
CLEARSTACK
LET CARRY = 0
PUSH 1
SSHLN 63
SSHLCN 2
POP x
ASSERT x == 1
ASSERT CARRY == 0

# start with high bit + cin=0, RCL1 → value 0, cout=1
CLEARSTACK
LET CARRY = 0
PUSH 1
SSHLN 63
SSHLCN 1
POP x
ASSERT x == 0
ASSERT CARRY == 1

# SSHRCN n=1 matches SSHRC
CLEARSTACK
LET CARRY = 0
PUSH 7
SSHRCN 1
POP x
ASSERT x == 3
ASSERT CARRY == 1

# SSHRCN multi-bit
CLEARSTACK
LET CARRY = 0
PUSH 40
RCRN 3
POP x
ASSERT x == 5
ASSERT CARRY == 0

# SSHRCN cin injects MSB then shifts
CLEARSTACK
LET CARRY = 1
PUSH 0
SSHRCN 1
POP x
ASSERT x < 0
ASSERT CARRY == 0

# soft fail empty stack
CLEARSTACK
SSHLCN 1
ASSERT OK == 0
CLEARSTACK
SSHRCN 2
ASSERT OK == 0

# DSHLCCN shared cin
CLEARSTACK
LET CARRY = 1
PUSH 4
PUSH 6
DSHLCCN 1
POP y
POP x
ASSERT x == 9
ASSERT y == 13
ASSERT CARRY == 0

# DSHLCCN multi-bit
CLEARSTACK
LET CARRY = 0
PUSH 1
PUSH 2
PAIRSHLCCN 3
POP y
POP x
ASSERT x == 8
ASSERT y == 16
ASSERT CARRY == 0

# DSHRCCN
CLEARSTACK
LET CARRY = 0
PUSH 8
PUSH 16
DSHRCCN 3
POP y
POP x
ASSERT x == 1
ASSERT y == 2
ASSERT CARRY == 0

# DSHRCCN with cin
CLEARSTACK
LET CARRY = 1
PUSH 0
PUSH 0
DRCRN 1
POP y
POP x
ASSERT x < 0
ASSERT y < 0
ASSERT CARRY == 0

# dual soft fail
CLEARSTACK
DSHLCCN 1
ASSERT OK == 0
CLEARSTACK
PUSH 1
DSHRCCN 1
ASSERT OK == 0

HOLD_FLASH 1
