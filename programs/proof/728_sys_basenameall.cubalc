# SYS BASENAMEALL / DIRNAMEALL / EXTALL / STEMALL — path peels over bags
# Usability: PATHGLOB → names/stems without EACH + BASENAME glue

HOLD_FLASH 1

SYS TMP
LET td = LAST
SYS JOIN td "baseall_mi_fixture"
LET fix = LAST
SYS MKDIR fix
SYS JOIN fix "alpha.plate"
LET f1 = LAST
SYS JOIN fix "beta.log"
LET f2 = LAST
SYS JOIN fix "readme"
LET f3 = LAST
SYS TOUCH f1
SYS TOUCH f2
SYS TOUCH f3

# PATHGLOB full paths → basenames
SYS PATHGLOB fix
SYS BASENAMEALL LAST
ASSERT OK == 1
ASSERT BASENAMEALL_N == 3
SYS HASLINE LAST "alpha.plate"
ASSERT LAST_N == 1
SYS HASLINE LAST "beta.log"
ASSERT LAST_N == 1
SYS HASLINE LAST "readme"
ASSERT LAST_N == 1
SYS HASLINE LAST f1
ASSERT LAST_N == 0

# MAPBASE alias + bag arg
SYS PATHGLOB fix
LET paths = LAST
SYS MAPBASE paths
ASSERT MAPBASE_N == 3

# DIRNAMEALL — all under fix
SYS PATHGLOB fix
SYS DIRNAMEALL LAST
ASSERT DIRNAMEALL_N == 3
SYS HASLINE LAST fix
ASSERT LAST_N == 1
# every field should be fix (same dir)
SYS NTH 0 LAST
SYS EQS LAST fix
ASSERT LAST_N == 1

# EXTALL
SYS PATHGLOB fix
SYS EXTALL LAST
ASSERT EXTALL_N == 3
SYS HASLINE LAST ".plate"
ASSERT LAST_N == 1
SYS HASLINE LAST ".log"
ASSERT LAST_N == 1
# readme has no ext → empty field kept
SYS COUNTLINE LAST ""
ASSERT LAST_N == 1

# STEMALL
SYS PATHGLOB fix
SYS STEMALL LAST
ASSERT STEMALL_N == 3
SYS HASLINE LAST "alpha"
ASSERT LAST_N == 1
SYS HASLINE LAST "beta"
ASSERT LAST_N == 1
SYS HASLINE LAST "readme"
ASSERT LAST_N == 1

# default LAST bag (no arg)
SYS PATHGLOB fix "*.plate"
SYS BASENAMEALL
ASSERT BASENAMEALL_N == 1
SYS EQS LAST "alpha.plate"
ASSERT LAST_N == 1

# aliases
SYS PATHGLOB fix
SYS MAPDIR LAST
ASSERT MAPDIR_N == 3
SYS PATHGLOB fix
SYS MAPEXT LAST
ASSERT MAPEXT_N == 3
SYS PATHGLOB fix
SYS MAPSTEM LAST
ASSERT MAPSTEM_N == 3

# cleanup
SYS RM f1
SYS RM f2
SYS RM f3

PRINT "sys_basenameall ok"
