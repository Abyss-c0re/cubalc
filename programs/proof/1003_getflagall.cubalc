# GETFLAGALL / MULTIFLAG — collect multi-occurrence CLI flags into a bag

HOLD_FLASH 1

# miss no default → empty count 0
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV UNSET CUBALC_ARG2
SYS ENV SET CUBALC_ARGC "0"
GETFLAGALL tags
ASSERT LAST_N == 0
ASSERT GETFLAGALL_HIT == 0
SYS EMPTY LAST
ASSERT LAST_N == 1

# OR default bag
GETFLAGALL tags OR "default"
ASSERT LAST_N == 1
ASSERT GETFLAGALL_HIT == 0
SYS EQS LAST "default"
ASSERT LAST_N == 1

# multi --tag a --tag b
SYS ENV SET CUBALC_ARG0 "--tag"
SYS ENV SET CUBALC_ARG1 "alpha"
SYS ENV SET CUBALC_ARG2 "--tag"
SYS ENV SET CUBALC_ARG3 "beta"
SYS ENV SET CUBALC_ARGC "4"
GETFLAGALL tag
ASSERT LAST_N == 2
ASSERT GETFLAGALL_HIT == 1
SYS NTH 0
SYS EQS LAST "alpha"
ASSERT LAST_N == 1
# re-fetch bag
GETFLAGALL tag
SYS NTH 1
SYS EQS LAST "beta"
ASSERT LAST_N == 1

# --tag=x --tag=y equals form
SYS ENV SET CUBALC_ARG0 "--tag=one"
SYS ENV SET CUBALC_ARG1 "--tag=two"
SYS ENV SET CUBALC_ARG2 "--tag=three"
SYS ENV SET CUBALC_ARGC "3"
MULTIFLAG tag
ASSERT LAST_N == 3
ASSERT GETFLAGALL_HIT == 1

# short alias mix -t a --tag b
SYS ENV SET CUBALC_ARG0 "-t"
SYS ENV SET CUBALC_ARG1 "short"
SYS ENV SET CUBALC_ARG2 "--tag"
SYS ENV SET CUBALC_ARG3 "long"
SYS ENV SET CUBALC_ARGC "4"
GETFLAGALL tag|t
ASSERT LAST_N == 2
ASSERT GETFLAGALL_HIT == 1
SYS EQS FLAG_HIT_NAME "t"
ASSERT LAST_N == 1

# bare --verbose multi → 1\n1
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "--verbose"
SYS ENV SET CUBALC_ARGC "2"
FLAGALL verbose
ASSERT LAST_N == 2
SYS NTH 0
SYS EQS LAST "1"
ASSERT LAST_N == 1

# coexists with other flags
SYS ENV SET CUBALC_ARG0 "--workers=4"
SYS ENV SET CUBALC_ARG1 "--include"
SYS ENV SET CUBALC_ARG2 "a.h"
SYS ENV SET CUBALC_ARG3 "--include=b.h"
SYS ENV SET CUBALC_ARG4 "file.c"
SYS ENV SET CUBALC_ARGC "5"
GETFLAGALL include|I
ASSERT LAST_N == 2
ASSERT GETFLAGALL_HIT == 1
GETFLAGN workers OR 1
ASSERT LAST_N == 4

PRINT "getflagall ok"
