# HASCLASSANY / NEEDCLASSANY — any-of multi CLASS soft/hard gate

HOLD_FLASH 1

CLASS Ticket
  FIELD id
END

# any hit (Ghost missing)
HASCLASSANY Ticket Ghost
ASSERT OK == 1
ASSERT LAST_N == 1
ASSERT HASCLASSANY_N == 1
ASSERT CLASSHAVE_N == 1
ASSERT CLASSHAVE == "Ticket"
ASSERT CLASSMISS_N == 1
SYS HASI CLASSMISS "Ghost"
ASSERT LAST_N == 1

# all miss soft
HASCLASSANY Ghost Spectre
ASSERT OK == 0
ASSERT LAST_N == 0
ASSERT HASCLASSANY_N == 0
ASSERT CLASSHAVE == ""
ASSERT CLASSMISS_N == 2

# bag form
LET opts = "Ghost,Ticket"
HASCLASSANY opts
ASSERT LAST_N == 1
ASSERT CLASSHAVE == "Ticket"

# ALL miss vs ALL hit after INCLUDE
INCLUDE life_cell
HASCLASSANY Cell Ghost
ASSERT LAST_N == 1
ASSERT CLASSHAVE == "Cell"

# ANYCLASS alias
ANYCLASS Ticket Cell
ASSERT LAST_N == 1
ASSERT CLASSHAVE_N == 2

# empty soft
HASCLASSANY
ASSERT LAST_N == 0
ASSERT OK == 0
CLEAR_ERR

HASFORM "HASCLASSANY"
ASSERT LAST_N == 1
HASFORM "NEEDCLASSANY"
ASSERT LAST_N == 1

PRINT "1421_hasclassany ok"
PASS
