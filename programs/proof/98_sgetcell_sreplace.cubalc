# Proof 98 — digit-1 data plane: SGETCELL + SREPLACE + SDROPAT
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# SGETCELL: i → cells[i]
CELLSET 3 77
CELLSET 0 11
PUSH 3
SGETCELL
ASSERT LAST_N == 77
ASSERT SP == 1
POP v
ASSERT v == 77

PUSH 0
SLOAD
ASSERT LAST_N == 11
POP w
ASSERT w == 11

# SFETCH alias + clamp soft
PUSH 9999
SFETCH
ASSERT OK == 1
ASSERT SP == 1
DROP

# SREPLACE: write TOS into depth-n, drop TOS
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 99
# stack: 10 20 30 99 — SREPLACE 2 → write 99 at depth 2 (20→99), drop: 10 99 30
SREPLACE 2
ASSERT SP == 3
POP a
ASSERT a == 30
POP b
ASSERT b == 99
POP c
ASSERT c == 10

# SREPLACE 0 ≡ DROP
CLEARSTACK
PUSH 1
PUSH 2
SREPLACE 0
ASSERT SP == 1
PEEK
ASSERT LAST_N == 1

# SREPLACE 1 ≡ NIP (write top under, drop top)
CLEARSTACK
PUSH 5
PUSH 6
SREPLACE 1
ASSERT SP == 1
PEEK
ASSERT LAST_N == 6

# SDROPAT 0 ≡ DROP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
SDROPAT 0
ASSERT SP == 2
PEEK
ASSERT LAST_N == 2

# SDROPAT 1 ≡ NIP
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
NIPN 1
ASSERT SP == 2
POP x
ASSERT x == 3
POP y
ASSERT y == 1

# SDROPAT 2 removes bottom of top-3
CLEARSTACK
PUSH 10
PUSH 20
PUSH 30
PUSH 40
DROPAT 2
# remove depth2=20 → 10 30 40
ASSERT SP == 3
POP p0
ASSERT p0 == 40
POP p1
ASSERT p1 == 30
POP p2
ASSERT p2 == 10

# soft fail OOR
CLEARSTACK
PUSH 1
SREPLACE 5
ASSERT OK == 0
SDROPAT 3
ASSERT OK == 0

# energy flow
CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof98_sgetcell_sreplace" LAST_N SP
