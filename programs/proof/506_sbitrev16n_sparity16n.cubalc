# Proof 506 — digit-5 stack imm 16-bit field metrics: SBITREV16N SPOPCNT16N SPARITY16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SBITREV16N: 0x0001 → 0x8000 ; 0x0003 → 0xC000
PUSH 0x0001
SBITREV16N 0
POP x
ASSERT x == 32768

CLEARSTACK
PUSH 0x0003
BITREV16N 0
POP x
ASSERT x == 49152

# 0xA55A palindrome-ish bitrev; 0x00FF → 0xFF00
CLEARSTACK
PUSH 0x00FF
SBITREV16N 0
POP x
ASSERT x == 0xFF00

CLEARSTACK
PUSH 0x0F0F
SBREV16N 0
POP x
ASSERT x == 0xF0F0

# involution + high preserved
CLEARSTACK
PUSH 0x112233445566778A
SBITREV16N 0
SBITREV16N 0
POP x
ASSERT x == 0x112233445566778A

# STACKBITREV16N n1: half1 of 0x00018000 is 0001 → 8000 → 0x80008000
CLEARSTACK
PUSH 0x00018000
STACKBITREV16N 1
POP x
ASSERT x == 0x80008000

# SPOPCNT16N: 0→0 ; FFFF→16
CLEARSTACK
PUSH 0x0
SPOPCNT16N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xFFFF
SPOPCNT16N 0
POP x
ASSERT x == 16

# high preserved: 0x...5555 → pop 8
CLEARSTACK
PUSH 0x1122334455665555
POPCNT16N 0
POP x
ASSERT x == 0x1122334455660008

# STACKPOPCNT16N n1: 0xFFFF0000 half1=FFFF→16 → 0x00100000
CLEARSTACK
PUSH 0xFFFF0000
STACKPOPCNT16N 1
POP x
ASSERT x == 0x00100000

# SPCNT16N alias: 0xAAAA→8
CLEARSTACK
PUSH 0xAAAA
SPCNT16N 0
POP x
ASSERT x == 8

# SPARITY16N: 0→0 ; 1→1 ; 3→0 ; 7→1
CLEARSTACK
PUSH 0x0
SPARITY16N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x1
SPARITY16N 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x3
PARITY16N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x7
SXORRED16N 0
POP x
ASSERT x == 1

# high preserved parity half1: 0x90000000 half1=9000 even→0; 0xB0000000 odd→1
CLEARSTACK
PUSH 0x90000000
SPARITY16N 1
POP x
ASSERT x == 0x00000000

CLEARSTACK
PUSH 0xB0000000
STACKPARITY16N 1
POP x
ASSERT x == 0x00010000

# FFFF even→0 ; FFFE odd→1
CLEARSTACK
PUSH 0xFFFF
SWORDPARN 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xFFFE
SPARITYWORDN 0
POP x
ASSERT x == 1

# SBITREVWORDN alias: 0x8000 → 0x0001
CLEARSTACK
PUSH 0x8000
SBITREVWORDN 0
POP x
ASSERT x == 1

HOLD_FLASH 0
