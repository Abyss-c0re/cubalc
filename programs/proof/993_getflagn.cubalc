# GETFLAGN / FLAGN — peel CLI --name as integer LAST_N

HOLD_FLASH 1

# missing no default → 0
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
GETFLAGN port
ASSERT LAST_N == 0
ASSERT GETFLAGN_HIT == 0

# OR default
GETFLAGN port OR 8080
ASSERT LAST_N == 8080
ASSERT GETFLAGN_HIT == 0
SYS EQS LAST "8080"
ASSERT LAST_N == 1

# --port=9000
SYS ENV SET CUBALC_ARG0 "--port=9000"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN port OR 8080
ASSERT LAST_N == 9000
ASSERT GETFLAGN_HIT == 1
ASSERT GETFLAGN_N == 9000
SYS EQS LAST "9000"
ASSERT LAST_N == 1

# bare --retries → 1
SYS ENV SET CUBALC_ARG0 "--retries"
SYS ENV SET CUBALC_ARGC "1"
FLAGN retries OR 3
ASSERT LAST_N == 1
ASSERT GETFLAGN_HIT == 1

# --n value space form
SYS ENV SET CUBALC_ARG0 "--n"
SYS ENV SET CUBALC_ARG1 "42"
SYS ENV SET CUBALC_ARGC "2"
GETFLAGN n OR 0
ASSERT LAST_N == 42

# negative
SYS ENV SET CUBALC_ARG0 "--delta=-7"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN delta OR 0
ASSERT LAST_N == -7

# non-numeric soft
SYS ENV SET CUBALC_ARG0 "--mode=fast"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN mode OR 5
ASSERT GETFLAGN_HIT == 1
ASSERT LAST_N == 0
SYS EMPTY LAST_ERR
# should have sticky err
SYS HAS LAST_ERR
# check via EMPTY on ERR pattern — use EXPECT style
# LAST_ERR set
LET e ""
LET e = LAST_ERR
SYS EMPTY e
ASSERT LAST_N == 0

# FLAGNUM alias + default when missing among other flags
SYS ENV SET CUBALC_ARG0 "--verbose"
SYS ENV SET CUBALC_ARG1 "file.txt"
SYS ENV SET CUBALC_ARGC "2"
FLAGNUM workers OR 4
ASSERT LAST_N == 4
ASSERT GETFLAGN_HIT == 0

# zero value is valid hit
SYS ENV SET CUBALC_ARG0 "--count=0"
SYS ENV SET CUBALC_ARGC "1"
GETFLAGN count OR 9
ASSERT LAST_N == 0
ASSERT GETFLAGN_HIT == 1

PRINT "getflagn ok"
