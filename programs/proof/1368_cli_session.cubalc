# INCLUDE cli_session — cli_boot + cli_guard one-shot

HOLD_FLASH 1

# empty argv, no flag/rest contract (defaults skip guard)
SYS ENV UNSET CUBALC_ARG0
SYS ENV UNSET CUBALC_ARG1
SYS ENV SET CUBALC_ARGC "0"
DEFAULT NEED_FLAGS = ""
DEFAULT NEED_REST_N = 0
INCLUDE cli_session
ASSERT OK == 1
ASSERT CLI_GUARD_OK == 1
SYS HASI "cubalc.cli.v1"
ASSERT LAST_N == 1
ASSERT HELPFLAG_HIT == 0
ASSERT VERSIONFLAG_HIT == 0
SYS LEN USAGE
ASSERT LAST_N >= 1

# contract pass: flag + file
SYS ENV SET CUBALC_ARG0 "--out=x"
SYS ENV SET CUBALC_ARG1 "a.txt"
SYS ENV SET CUBALC_ARGC "2"
LET NEED_FLAGS = "out"
LET NEED_REST_N = 1
LET CLI_GUARD_SOFT = 0
INCLUDE cli_session
ASSERT CLI_GUARD_OK == 1
ASSERT LISTFLAGS_N >= 1
ASSERT RESTARGS_N >= 1

# soft miss contract
SYS ENV SET CUBALC_ARGC "0"
LET NEED_FLAGS = "missing"
LET NEED_REST_N = 0
LET CLI_GUARD_SOFT = 1
INCLUDE cli_session
ASSERT CLI_GUARD_OK == 0
ASSERT CLI_GUARD_FLAGS_OK == 0

PASS
PRINT "1368_cli_session: PASS"
