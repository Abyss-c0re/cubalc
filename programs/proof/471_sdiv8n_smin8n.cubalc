# Proof 471 — digit-2 stack imm 8-bit field div/mod/min: SDIV8N SMOD8N SMIN8N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SDIV8N: 0x64 / 0x0A → 0x0A
PUSH 0x64
SDIV8N 10 0
POP x
ASSERT x == 10

# floor: 0x17 / 0x05 → 0x04
CLEARSTACK
PUSH 0x17
DIV8N 5 0
POP x
ASSERT x == 4

# div by zero → 0
CLEARSTACK
PUSH 0xFF
SDIV8N 0 0
POP x
ASSERT x == 0

# high preserved: 0x...77C8 / 4 → 0x...7732 (200/4=50)
CLEARSTACK
PUSH 0x11223344556677C8
SDIV8N 4 0
POP x
ASSERT x == 0x1122334455667732

# STACKDIV8N n1: byte1 of 0x...6400 / 10 → 0x...0A00
CLEARSTACK
PUSH 0x6400
STACKDIV8N 10 1
POP x
ASSERT x == 0x0A00

# SMOD8N: 0x17 % 0x05 → 0x03 (23%5=3)
CLEARSTACK
PUSH 0x17
SMOD8N 5 0
POP x
ASSERT x == 3

# exact: 0x64 % 0x0A → 0
CLEARSTACK
PUSH 0x64
MOD8N 10 0
POP x
ASSERT x == 0

# mod by zero → 0
CLEARSTACK
PUSH 0xAB
SREM8N 0 0
POP x
ASSERT x == 0

# STACKMOD8N n1: byte1 of 0x...1700 % 5 → 0x...0300 (23%5=3)
CLEARSTACK
PUSH 0x1700
STACKMOD8N 5 1
POP x
ASSERT x == 0x0300

# SMIN8N: min(0xC0, 0x40) → 0x40
CLEARSTACK
PUSH 0xC0
SMIN8N 0x40 0
POP x
ASSERT x == 0x40

# keeps smaller
CLEARSTACK
PUSH 0x10
MIN8N 0x90 0
POP x
ASSERT x == 0x10

# high preserved min: 0x...77FE min 0x20 → 0x...7720
CLEARSTACK
PUSH 0x11223344556677FE
SMIN8N 0x20 0
POP x
ASSERT x == 0x1122334455667720

# STACKMIN8N n1: byte1 of 0x...FF00 min 0x11 → 0x...1100
CLEARSTACK
PUSH 0xFF00
STACKMIN8N 0x11 1
POP x
ASSERT x == 0x1100

# SLE8N alias min equal
CLEARSTACK
PUSH 0x55
SLE8N 0x55 0
POP x
ASSERT x == 0x55

# SQUO8N alias div
CLEARSTACK
PUSH 0x1E
SQUO8N 6 0
POP x
ASSERT x == 5

HOLD_FLASH 0
