# IFFIFTYTWOP - plate exactly-fifty-two key diagnostic branch
# Continues ladder after IFFIFTYONEP. Soft twin DOPENTECONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET fiftyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51}"
LET fiftytwo = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51,\"P\":52}"
LET fiftythree = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43,\"H\":44,\"I\":45,\"J\":46,\"K\":47,\"L\":48,\"M\":49,\"N\":50,\"O\":51,\"P\":52,\"Q\":53}"
LET empty = "{}"

IFFIFTYTWOP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFIFTYTWOP_N == 1
ASSERT FIFTYTWOP_N == 1
ASSERT IFFIFTYTWOP_LEN == 52
ASSERT IFDOPENTECONTAP_N == 1
ASSERT IFFIFTYTWOKEYP_N == 1

IFDOPENTECONTAP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFIFTYTWOKEYP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFIFTYTWOP fiftyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFIFTYTWOP_N == 0
ASSERT IFFIFTYTWOP_LEN == 51

IFFIFTYTWOP fiftythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFIFTYTWOP_LEN == 53

IFFIFTYTWOP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFIFTYTWOP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFIFTYTWOP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENDOPENTECONTAP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFIFTYTWOKEYP fiftytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffiftytwop_ok" IFFIFTYTWOP_N IFFIFTYTWOP_LEN
PASS
