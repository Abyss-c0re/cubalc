# Proof 452 — digit-9 cell fixed-width 16 inverted bitwise: NAND16CELL NOR16CELL XNOR16CELL
HOLD_FLASH 1
SCIENCE LOAD

CLEARCELLS
CLEARSTACK

# NAND16CELL: 255 & 255 → ~255 as u16 = 65280
CELLSET 0 255
NAND16CELL 0 0 255
ASSERT CELL(0) == 65280
ASSERT LAST_N == 1

# NOR16CELL: 255 | 0 → ~255 as u16 = 65280
CELLSET 1 255
NOR16CELL 1 1 0
ASSERT CELL(1) == 65280
ASSERT LAST_N == 1

# XNOR16CELL: 255 ^ 0 → ~255 as u16 = 65280
CELLSET 2 255
XNOR16CELL 2 2 0
ASSERT CELL(2) == 65280
ASSERT LAST_N == 1

# range NAND: 65535 with mask 255 → ~255 = 65280
CELLSET 3 65535
CELLSET 4 65535
NAND16CELL 3 4 255
ASSERT CELL(3) == 65280
ASSERT CELL(4) == 65280
ASSERT LAST_N == 2

# CELLNOR16: 0 | 0 → ~0 = 65535
CELLSET 5 0
CELLNOR16 5 5 0
ASSERT CELL(5) == 65535

# CELLXNOR16: 0xA5A5 ^ 0xA5A5 → ~0 = 65535
CELLSET 6 0xA5A5
CELLXNOR16 6 6 0xA5A5
ASSERT CELL(6) == 65535

# high bits ignored: 65536+255 nand 255 → ~255 = 65280
CELLSET 7 65791
NAND16CELL 7 7 255
ASSERT CELL(7) == 65280

# NOR16RANGE: 0 | 0xFF → ~0xFF = 65280
CELLSET 8 0
NOR16RANGE 8 8 255
ASSERT CELL(8) == 65280

# XNOR16RANGE: self-xnor → 65535
CELLSET 9 0x1234
XNOR16RANGE 9 9 0x1234
ASSERT CELL(9) == 65535

# BNAND16CELL: 0 mask 0 → 65535
CELLSET 10 0
BNAND16CELL 10 10 0
ASSERT CELL(10) == 65535

HOLD_FLASH 0
