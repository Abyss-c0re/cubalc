# Proof 36 — stack compare/min/max digit-1: SEQ SNE SLT SGT SLE SGE SMIN SMAX
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 5
PUSH 5
SEQ
ASSERT LAST_N == 1
ASSERT SP == 1

CLEARSTACK
PUSH 5
PUSH 7
SNE
ASSERT LAST_N == 1
PUSH 1
SLT
ASSERT LAST_N == 0

CLEARSTACK
PUSH 3
PUSH 10
SLT
ASSERT LAST_N == 1
PUSH 0
SGT
ASSERT LAST_N == 1

CLEARSTACK
PUSH 4
PUSH 4
SLE
ASSERT LAST_N == 1
PUSH 4
SGE
ASSERT LAST_N == 0

CLEARSTACK
PUSH 9
PUSH 2
SMIN
ASSERT LAST_N == 2
PUSH 8
SMAX
ASSERT LAST_N == 8

# aliases
CLEARSTACK
PUSH 1
PUSH 2
CMPEQ
ASSERT LAST_N == 0
PUSH 0
STACKEQ
ASSERT LAST_N == 1

# underflow
CLEARSTACK
SEQ
ASSERT OK == 0
SMIN
ASSERT OK == 0

# compose: compare predicate then stack bitops
CLEARSTACK
PUSH 10
PUSH 3
SGT
ASSERT LAST_N == 1
PUSH 0xFF
SAND
ASSERT LAST_N == 1
PUSH 0xFE
SOR
ASSERT LAST_N == 255

CUBE m ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof36_stack_compare" LAST_N SP
