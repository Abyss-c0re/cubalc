# Proof 464 — digit-4 stack imm 4-bit field metrics: SBITREV4N SPOPCNT4N SPARITY4N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SBITREV4N: 0x1 → 0x8; 0x3 → 0xC; 0x5 → 0xA
PUSH 0x1
SBITREV4N 0
POP x
ASSERT x == 8

CLEARSTACK
PUSH 0x3
SBITREV4N 0
POP x
ASSERT x == 12

CLEARSTACK
PUSH 0x5
BITREV4N 0
POP x
ASSERT x == 10

# involution on nibble0; high preserved
CLEARSTACK
PUSH 0x112233445566778A
SBITREV4N 0
SBITREV4N 0
POP x
ASSERT x == 0x112233445566778A

# SPOPCNT4N: 0x0 → 0; 0xF → 4; 0x5 → 2
CLEARSTACK
PUSH 0x0
SPOPCNT4N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0xF
SPOPCNT4N 0
POP x
ASSERT x == 4

CLEARSTACK
PUSH 0x1122334455667755
SPOPCNT4N 0
POP x
ASSERT x == 0x1122334455667752

# STACKPOPCNT4N n1: nibble1 of 0x...F0 is F → 4
CLEARSTACK
PUSH 0xF0
STACKPOPCNT4N 1
POP x
ASSERT x == 0x40

# SPARITY4N: 0 → 0; 1 → 1; 3 → 0; 7 → 1
CLEARSTACK
PUSH 0x0
SPARITY4N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x1
SPARITY4N 0
POP x
ASSERT x == 1

CLEARSTACK
PUSH 0x3
SPARITY4N 0
POP x
ASSERT x == 0

CLEARSTACK
PUSH 0x7
SXORRED4N 0
POP x
ASSERT x == 1

# high nibble parity on 0x...90: n1=9=1001 parity 0
CLEARSTACK
PUSH 0x90
SPARITY4N 1
POP x
ASSERT x == 0x00

HOLD_FLASH 0
