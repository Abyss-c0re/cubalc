# Proof 549 — digit-9 stack+dual imm 32-bit signed clamp+between: SCLAMPS32N SBETWEENS32N DCLAMPS32N DBETWEENS32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SCLAMPS32N: clamp -5 into [-1, 3] → -1
PUSH 0xFFFFFFFB
SCLAMPS32N 0xFFFFFFFF 0x3 0
POP x
ASSERT x == 0xFFFFFFFF

# clamp 10 into [-1, 3] → 3
CLEARSTACK
PUSH 0xA
CLAMPS32N 0xFFFFFFFF 0x3 0
POP x
ASSERT x == 3

# in range stays
CLEARSTACK
PUSH 0x1
SCLAMPSIGN32N 0xFFFFFFFF 0x3 0
POP x
ASSERT x == 1

# swap lo/hi: clamp 0 into [3, -1] → same as [-1,3]
CLEARSTACK
PUSH 0x0
SCLAMPS32N 0x3 0xFFFFFFFF 0
POP x
ASSERT x == 0

# INT_MIN clamp to [0, 10] → 0
CLEARSTACK
PUSH 0x80000000
SCLAMPS32N 0x0 0xA 0
POP x
ASSERT x == 0

# unsigned contrast: SCLAMPN is full-cell (not field signed word)
# high word preserved: low clamp of 0xFFFFFFFF (-1) into [0,5] → 0 low
CLEARSTACK
PUSH 0x11223344FFFFFFFF
SCLAMPS32N 0x0 0x5 0
POP x
ASSERT x == 0x1122334400000000

# STACKCLAMPS32N n1: high -2 clamp [-1,1] → high -1
CLEARSTACK
PUSH 0xFFFFFFFE00000000
STACKCLAMPS32N 0xFFFFFFFF 0x1 1
POP x
ASSERT x == 0xFFFFFFFF00000000

# SBETWEENS32N: -1 in [-2, 0] → 1
CLEARSTACK
PUSH 0xFFFFFFFF
SBETWEENS32N 0xFFFFFFFE 0x0 0
POP x
ASSERT x == 1

# 5 not in [-1, 3] → 0
CLEARSTACK
PUSH 0x5
BETWEENS32N 0xFFFFFFFF 0x3 0
POP x
ASSERT x == 0

# INT_MIN not in [0, 10] → 0
CLEARSTACK
PUSH 0x80000000
SINRANGES32N 0x0 0xA 0
POP x
ASSERT x == 0

# 0xFFFFFFFF unsigned large but signed -1 is in [-5, 5]
CLEARSTACK
PUSH 0xFFFFFFFF
SBETWEENS32N 0xFFFFFFFB 0x5 0
POP x
ASSERT x == 1

# swap bounds
CLEARSTACK
PUSH 0x2
SBETWEENS32N 0x5 0x0 0
POP x
ASSERT x == 1

# high preserved between
CLEARSTACK
PUSH 0xAABBCCDD00000002
SBETWEENS32N 0x0 0x3 0
POP x
ASSERT x == 0xAABBCCDD00000001

# STACKBETWEENS32N n1
CLEARSTACK
PUSH 0xFFFFFFFF00000000
STACKBETWEENS32N 0xFFFFFFFE 0x0 1
POP x
ASSERT x == 0x0000000100000000

# DCLAMPS32N: -5 and 10 clamp [-1,3] → -1 and 3
CLEARSTACK
PUSH 0xFFFFFFFB
PUSH 0xA
DCLAMPS32N 0xFFFFFFFF 0x3 0
POP y
POP x
ASSERT x == 0xFFFFFFFF
ASSERT y == 3

# both in range
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRCLAMPS32N 0x0 0x5 0
POP y
POP x
ASSERT x == 1
ASSERT y == 2

# high preserve dual clamp
CLEARSTACK
PUSH 0x11110000FFFFFFFF
PUSH 0x222200000000000A
S2CLAMPS32N 0x0 0x5 0
POP y
POP x
ASSERT x == 0x1111000000000000
ASSERT y == 0x2222000000000005

# STACK2CLAMPS32N n1
CLEARSTACK
PUSH 0xFFFFFFFE00000000
PUSH 0x0000000A00000000
STACK2CLAMPS32N 0xFFFFFFFF 0x1 1
POP y
POP x
ASSERT x == 0xFFFFFFFF00000000
ASSERT y == 0x0000000100000000

# DBETWEENS32N: -1 in [-2,0] → 1; 5 not → 0
CLEARSTACK
PUSH 0xFFFFFFFF
PUSH 0x5
DBETWEENS32N 0xFFFFFFFE 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# both in
CLEARSTACK
PUSH 0x1
PUSH 0x2
PAIRBETWEENS32N 0x0 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# DINRANGESIGN32N mixed
CLEARSTACK
PUSH 0x80000000
PUSH 0xFFFFFFFF
DINRANGESIGN32N 0xFFFFFFFE 0x0 0
POP y
POP x
ASSERT x == 0
ASSERT y == 1

# STACK2BETWEENS32N n1
CLEARSTACK
PUSH 0xFFFFFFFF00000000
PUSH 0x0000000500000000
STACK2BETWEENS32N 0xFFFFFFFE 0x0 1
POP y
POP x
ASSERT x == 0x0000000100000000
ASSERT y == 0x0000000000000000

HOLD_FLASH 0
