# Proof 192 — digit-2 dual-stack modular: DMODINV DMODDIV
HOLD_FLASH 1
SCIENCE LOAD

# DMODINV: 3^{-1} mod 7 = 5; 2^{-1} mod 5 = 3
CLEARSTACK
PUSH 3
PUSH 2
PUSH 7
PUSH 5
DMODINV
POP y
POP x
ASSERT x == 5
ASSERT y == 3

# 2MODINV identity 1
CLEARSTACK
PUSH 1
PUSH 1
PUSH 11
PUSH 13
2MODINV
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# no inverse (even, even mod)
CLEARSTACK
PUSH 2
PUSH 4
PUSH 6
PUSH 8
PAIRMODINV
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DINVMOD alias: 4^{-1} mod 7 = 2
CLEARSTACK
PUSH 4
PUSH 3
PUSH 7
PUSH 7
DINVMOD
POP y
POP x
ASSERT x == 2
ASSERT y == 5

# DMODDIV: 6 * 3^{-1} mod 7 = 6*5 = 30 mod 7 = 2
#          8 * 3^{-1} mod 11 = 8*4 = 32 mod 11 = 10
CLEARSTACK
PUSH 6
PUSH 8
PUSH 3
PUSH 3
PUSH 7
PUSH 11
DMODDIV
POP y
POP x
ASSERT x == 2
ASSERT y == 10

# 2MODDIV identity /1
CLEARSTACK
PUSH 5
PUSH 9
PUSH 1
PUSH 1
PUSH 13
PUSH 17
2MODDIV
POP y
POP x
ASSERT x == 5
ASSERT y == 9

# no inv → 0
CLEARSTACK
PUSH 1
PUSH 1
PUSH 2
PUSH 2
PUSH 4
PUSH 6
PAIRMODDIV
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# S2MODINV / STACK2MODDIV
CLEARSTACK
PUSH 5
PUSH 7
PUSH 11
PUSH 11
S2MODINV
POP y
POP x
# 5*9=45=1 mod 11; 7*8=56=1 mod 11
ASSERT x == 9
ASSERT y == 8

CLEARSTACK
PUSH 10
PUSH 4
PUSH 3
PUSH 5
PUSH 13
PUSH 7
STACK2MODDIV
POP y
POP x
# 10*9=90=12 mod 13; 4*3=12=5 mod 7
ASSERT x == 12
ASSERT y == 5

# soft fail
CLEARSTACK
PUSH 1
PUSH 2
DMODINV
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
PUSH 4
PUSH 5
DMODDIV
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof192_dmodinv_dmoddiv" LAST_N SP
