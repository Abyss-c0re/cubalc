# Proof 150 — digit-4 dual-stack rotate + range: DROL DROR DWITHIN DBETWEEN
HOLD_FLASH 1
SCIENCE LOAD

# DROL — rotate left
CLEARSTACK
PUSH 0x1
PUSH 0x80
PUSH 4
PUSH 1
DROL
POP y
POP x
ASSERT x == 16
ASSERT y == 256

# DROR
CLEARSTACK
PUSH 0x10
PUSH 0x2
PUSH 4
PUSH 1
DROR
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 2ROL alias
CLEARSTACK
PUSH 0xF
PUSH 0x1
PUSH 0
PUSH 3
2ROL
POP y
POP x
ASSERT x == 15
ASSERT y == 8

# DWITHIN half-open [lo,hi)
CLEARSTACK
PUSH 5
PUSH 10
PUSH 0
PUSH 10
DWITHIN
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DBETWEEN inclusive
CLEARSTACK
PUSH 0
PUSH 10
PUSH 0
PUSH 10
DBETWEEN
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# inverted BETWEEN
CLEARSTACK
PUSH 3
PUSH 20
PUSH 10
PUSH 0
2BETWEEN
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# soft fails
CLEARSTACK
DROL
ASSERT OK == 0
CLEARSTACK
DROR
ASSERT OK == 0
CLEARSTACK
DWITHIN
ASSERT OK == 0
CLEARSTACK
DBETWEEN
ASSERT OK == 0
CLEARSTACK
PUSH 1
PUSH 2
PUSH 3
2ROR
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof150_drol_dwithin" LAST_N SP
