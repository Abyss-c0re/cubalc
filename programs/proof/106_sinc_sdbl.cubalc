# Proof 106 — digit-7 stack ALU: SINC SDEC SDBL SHALF
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK
PUSH 10
SINC
ASSERT LAST_N == 11
SINC
ASSERT LAST_N == 12
SDEC
ASSERT LAST_N == 11
POP a
ASSERT a == 11

# SDBL / SHALF
CLEARSTACK
PUSH 7
SDBL
ASSERT LAST_N == 14
SDBL
ASSERT LAST_N == 28
SHALF
ASSERT LAST_N == 14
SHALF
ASSERT LAST_N == 7
POP b
ASSERT b == 7

# aliases + negative
CLEARSTACK
PUSH -3
SINC
ASSERT LAST_N == -2
SDEC
ASSERT LAST_N == -3
SDOUBLE
ASSERT LAST_N == -6
SHALVE
ASSERT LAST_N == -3

# soft fail empty
CLEARSTACK
SINC
ASSERT OK == 0
SDEC
ASSERT OK == 0
SDBL
ASSERT OK == 0
SHALF
ASSERT OK == 0

CUBE z ROLE matrix PROTON 1
ENERGYFLOW 1
ASSERT ENERGY >= 0
ASSERT OK == 1

PRINT "proof106_sinc_sdbl" LAST_N SP
