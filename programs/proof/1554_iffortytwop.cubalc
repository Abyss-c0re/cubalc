# IFFORTYTWOP - plate exactly-forty-two key diagnostic branch
# Continues ladder after IFFORTYONEP. Soft twin DOTETRACONTAP.

HOLD_FLASH 1

LET one = "{\"a\":1}"
LET fortyone = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41}"
LET fortytwo = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42}"
LET fortythree = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"r\":18,\"s\":19,\"t\":20,\"u\":21,\"v\":22,\"w\":23,\"x\":24,\"y\":25,\"z\":26,\"0\":27,\"1\":28,\"2\":29,\"3\":30,\"4\":31,\"5\":32,\"6\":33,\"7\":34,\"8\":35,\"9\":36,\"A\":37,\"B\":38,\"C\":39,\"D\":40,\"E\":41,\"F\":42,\"G\":43}"
LET empty = "{}"

IFFORTYTWOP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1
ASSERT IFFORTYTWOP_N == 1
ASSERT FORTYTWOP_N == 1
ASSERT IFFORTYTWOP_LEN == 42
ASSERT IFDOTETRACONTAP_N == 1
ASSERT IFFORTYTWOKEYP_N == 1

IFDOTETRACONTAP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYTWOKEYP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

IFFORTYTWOP fortyone
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYTWOP_N == 0
ASSERT IFFORTYTWOP_LEN == 41

IFFORTYTWOP fortythree
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0
ASSERT IFFORTYTWOP_LEN == 43

IFFORTYTWOP one
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

IFFORTYTWOP empty
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 0

WHENFORTYTWOP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENDOTETRACONTAP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

WHENFORTYTWOKEYP fortytwo
  LET q = 1
ELSE
  LET q = 0
END
ASSERT q == 1

PRINT "iffortytwop_ok" IFFORTYTWOP_N IFFORTYTWOP_LEN
PASS
