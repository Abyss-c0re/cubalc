# Proof 542 — digit-8 dual-stack imm 16-bit signed ordered-cmp: DLTS16N DGTS16N DLTES16N DGTES16N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# DLTS16N: -1 (0xFFFF) < 1 → 1 ; 1 < 1 → 0
PUSH 0xFFFF
PUSH 0x1
DLTS16N 0x1 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# unsigned DLT: 0xFFFF < 0x1 → 0
CLEARSTACK
PUSH 0xFFFF
PUSH 0x1
DLT16N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# equal signed → 0 for LT
CLEARSTACK
PUSH 0x8000
PUSH 0x8000
PAIRLTS16N 0x8000 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# mixed: 2 < 3 → 1; 4 < 3 → 0
CLEARSTACK
PUSH 0x2
PUSH 0x4
DLTS16N 0x3 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 1 < -1 → 0 both
CLEARSTACK
PUSH 0x1
PUSH 0x2
S2LTS16N 0xFFFF 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# preserved high half
CLEARSTACK
PUSH 0xAABBFFFF
PUSH 0x11220000
DLTS16N 0x1 0
POP y
POP x
ASSERT x == 0xAABB0001
ASSERT y == 0x11220001

# STACK2LTS16N n1
CLEARSTACK
PUSH 0xFFFF0000
PUSH 0x00010000
STACK2LTS16N 0x0 1
POP y
POP x
ASSERT x == 0x00010000
ASSERT y == 0x00000000

# DGTS16N: 1 > -1 → 1 ; -1 > -1 → 0
CLEARSTACK
PUSH 0x1
PUSH 0xFFFF
DGTS16N 0xFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# 0xFFFF > 0x1 signed → 0 both
CLEARSTACK
PUSH 0xFFFF
PUSH 0xFFFE
PAIRGTS16N 0x1 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# -32768 > 32767 → 0
CLEARSTACK
PUSH 0x8000
PUSH 0x8000
DGTS16N 0x7FFF 0
POP y
POP x
ASSERT x == 0
ASSERT y == 0

# DLTES16N equal → 1
CLEARSTACK
PUSH 0x8000
PUSH 0x8000
DLTES16N 0x8000 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# -1 <= 0 → 1; 1 <= 0 → 0
CLEARSTACK
PUSH 0xFFFF
PUSH 0x1
DLEQS16N 0x0 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DGTES16N equal → 1
CLEARSTACK
PUSH 0x5555
PUSH 0x5555
DGTES16N 0x5555 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# 1 >= -1 → 1; -32768 >= 32767 → 0
CLEARSTACK
PUSH 0x1
PUSH 0x8000
DGEQS16N 0xFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

# DCMPLTS16N / DCMPGES16N
CLEARSTACK
PUSH 0xFFFE
PUSH 0x0
DCMPLTS16N 0xFFFF 0
POP y
POP x
ASSERT x == 1
ASSERT y == 0

CLEARSTACK
PUSH 0xFFFF
PUSH 0xFFFE
DCMPGES16N 0xFFFE 0
POP y
POP x
ASSERT x == 1
ASSERT y == 1

# n2 dual signed
CLEARSTACK
PUSH 0xFFFF00000000
PUSH 0x000100000000
DLTS16N 0x0 2
POP y
POP x
ASSERT x == 0x000100000000
ASSERT y == 0x000000000000

HOLD_FLASH 0
