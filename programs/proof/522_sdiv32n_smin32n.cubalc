# Proof 522 — digit-7 stack imm 32-bit field div/mod/min: SDIV32N SMOD32N SMIN32N
HOLD_FLASH 1
SCIENCE LOAD

CLEARSTACK

# SDIV32N: 100 / 10 → 10
PUSH 100
SDIV32N 10 0
POP x
ASSERT x == 10

# floor: 23 / 5 → 4
CLEARSTACK
PUSH 23
DIV32N 5 0
POP x
ASSERT x == 4

# div by zero → 0
CLEARSTACK
PUSH 0xFFFFFFFF
SDIV32N 0 0
POP x
ASSERT x == 0

# high preserved: 0x11223344000000C8 / 4 → 0x1122334400000032
CLEARSTACK
PUSH 0x11223344000000C8
SDIV32N 4 0
POP x
ASSERT x == 0x1122334400000032

# STACKDIV32N n1: high of 0x0000006400000000 / 10 → high 0xA
CLEARSTACK
PUSH 0x0000006400000000
STACKDIV32N 10 1
POP x
ASSERT x == 0x0000000A00000000

# SMOD32N: 23 % 5 → 3
CLEARSTACK
PUSH 23
SMOD32N 5 0
POP x
ASSERT x == 3

# exact: 100 % 10 → 0
CLEARSTACK
PUSH 100
MOD32N 10 0
POP x
ASSERT x == 0

# mod by zero → 0
CLEARSTACK
PUSH 0xABCD1234
SREM32N 0 0
POP x
ASSERT x == 0

# STACKMOD32N n1: high of 0x0000001700000000 % 5 → high 3
CLEARSTACK
PUSH 0x0000001700000000
STACKMOD32N 5 1
POP x
ASSERT x == 0x0000000300000000

# SMIN32N: min(0xC0000000, 0x40000000) → 0x40000000
CLEARSTACK
PUSH 0xC0000000
SMIN32N 0x40000000 0
POP x
ASSERT x == 0x40000000

# keeps smaller
CLEARSTACK
PUSH 0x10
MIN32N 0x90000000 0
POP x
ASSERT x == 0x10

# high preserved min
CLEARSTACK
PUSH 0x11223344FFFFFFFE
SMIN32N 0x20 0
POP x
ASSERT x == 0x1122334400000020

# STACKMIN32N n1: high FFFFFFFF min 0x11 → high 0x11
CLEARSTACK
PUSH 0xFFFFFFFF00000000
STACKMIN32N 0x11 1
POP x
ASSERT x == 0x0000001100000000

# SLE32N alias min equal
CLEARSTACK
PUSH 0x55555555
SLE32N 0x55555555 0
POP x
ASSERT x == 0x55555555

# SQUO32N alias div
CLEARSTACK
PUSH 30
SQUO32N 6 0
POP x
ASSERT x == 5

HOLD_FLASH 0
