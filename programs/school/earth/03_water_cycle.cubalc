# Earth 03 — Water cycle as nested flow (evap → cloud → rain)
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | domain=water |"
CUBE ocean ROLE reservoir PROTON 1
CUBE cloud ROLE vapor PROTON 1
CUBE land ROLE sink PROTON 1
NEST ocean cloud
FOLDBITS ocean "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS cloud "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS land  "1111000011110000111100001111000011110000111100001111000011110000"
PLUG ocean cloud
PLUG cloud land
PLUG land ocean
IMPULSE ocean 1
FLOW 5
ASSERT FLOWED(cloud) == 1
ASSERT FLOWED(land) == 1
# freeze/boil thresholds
ASSERT H2O_BP == 100
ASSERT CELSIUS_K(0) == 273
PRINT "earth03_water" ENERGY(cloud) ENERGY(land)
