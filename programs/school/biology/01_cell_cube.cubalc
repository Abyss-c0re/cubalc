# Biology 01 — Cell as nested cube (organelles)
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | domain=cell |"

CUBE cell ROLE organism PROTON 1
CUBE nucleus ROLE organelle PROTON 1
CUBE mito ROLE organelle PROTON 1
CUBE membrane ROLE boundary PROTON 1
NEST cell nucleus
NEST cell mito
NEST cell membrane
ASSERT NESTED(nucleus) == 1
ASSERT NESTED(mito) == 1

FOLDBITS cell     "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS nucleus  "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS mito     "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS membrane "1010101010101010101010101010101010101010101010101010101010101010"
PLUG cell membrane
PLUG membrane nucleus
PLUG membrane mito
IMPULSE cell 1
FLOW 4
COMPILE nucleus
COMPILE mito
COMPILE membrane
COMPILE cell
ASSERT COMPILED(cell) == 1

PRINT "bio01_cell" CUBES COMPILED(cell)
