# Biology 06 — Ecosystem energy pyramid (10% rule integer)
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | domain=eco |"

CUBE sun ROLE producer PROTON 1
CUBE plant ROLE producer PROTON 1
CUBE herb ROLE consumer PROTON 1
CUBE carn ROLE consumer PROTON 1
PLUG sun plant
PLUG plant herb
PLUG herb carn
IMPULSE sun 1
ENERGYFLOW 3
FLOW 2

LET E0 = 10000
LET E1 = E0 * 10 / 100
LET E2 = E1 * 10 / 100
LET E3 = E2 * 10 / 100
ASSERT E1 == 1000
ASSERT E2 == 100
ASSERT E3 == 10

PRINT "bio06_eco" E1 E2 E3 CUBES
