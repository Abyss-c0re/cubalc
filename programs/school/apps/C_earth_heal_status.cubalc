# App C — Earth Heal Status (native CubalC)
# Monitor atmosphere / water / soil cubes; heal impulse restores energy
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | app=C_earth |"
CUBE earth ROLE planet PROTON 1
CUBE air ROLE atmos PROTON 1
CUBE water ROLE hydro PROTON 1
CUBE soil ROLE geo PROTON 1
NEST earth air
NEST earth water
NEST earth soil
FOLDBITS earth "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS air   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS water "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS soil  "1111000011110000111100001111000011110000111100001111000011110000"
PLUG earth air
PLUG earth water
PLUG earth soil
# damage then heal
DECONSTRUCT soil
RECONSTRUCT soil
IMPULSE earth 1
FLOW 4
COMPILE air
COMPILE water
COMPILE soil
COMPILE earth
ASSERT COMPILED(earth) == 1
ASSERT NESTED(air) == 1
ASSERT ATM_O2 == 21
LET health = CLAMP(ENERGY(earth), 0, 100)
ASSERT health >= 0
PRINT "appC_earth_heal" COMPILED(earth) health ATM_O2
