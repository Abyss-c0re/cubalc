# App D — Wire Integrity (native CubalC)
# CubeChain of plugs; reverse I/O; verify flow still works
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | app=D_wire |"
CUBE a ROLE node PROTON 1
CUBE b ROLE node PROTON 1
CUBE c ROLE node PROTON 1
IO a OUT 0
IO a IN 1
IO b IN 0
IO b OUT 1
IO c IN 0
IO c OUT 1
FOLDBITS a "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS b "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS c "1111000011110000111100001111000011110000111100001111000011110000"
PLUG a b
PLUG b c
IMPULSE a 1
FLOW DIR 4
ASSERT FLOWED(c) == 1
REVERSE a b
FLOW DIR 4
ASSERT OK == 1
UNPLUG a b
PLUG a b
FLOW 2
ASSERT CUBES == 3
PRINT "appD_wire" FLOWED(c) REVERSED
