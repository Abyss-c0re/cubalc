# App B — Hive Pulse (native CubalC)
# Ring of cubes; energy must rise then settle with unity
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | app=B_hive |"
CUBE c0 ROLE hive PROTON 1
CUBE c1 ROLE hive PROTON 1
CUBE c2 ROLE hive PROTON 1
CUBE c3 ROLE hive PROTON 1
FOLDBITS c0 "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS c1 "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS c2 "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS c3 "1010101010101010101010101010101010101010101010101010101010101010"
PLUG RING
IMPULSE c0 1
ENERGYFLOW 4
FLOW 4
ASSERT CUBES == 4
ASSERT FLOWED(c0) == 1
ASSERT FLOWED(c2) == 1
ASSERT UNITY >= 50
PRINT "appB_hive" CUBES UNITY ENERGY(c0)
