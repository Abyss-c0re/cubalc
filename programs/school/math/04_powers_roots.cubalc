# Math 04 — Powers and integer roots
HOLD_FLASH 1
SCIENCE LOAD

ASSERT POW(2,10) == 1024
ASSERT POW(3,4) == 81
ASSERT POW(5,0) == 1
ASSERT SQRT(0) == 0
ASSERT SQRT(1) == 1
ASSERT SQRT(16) == 4
ASSERT SQRT(17) == 4
ASSERT SQRT(100) == 10
ASSERT FACT(5) == 120
ASSERT FACT(0) == 1
ASSERT FACT(6) == 720

PRINT "math04_pow_sqrt" POW(2,10) SQRT(100) FACT(5)
