# Final — Pure science (math + physics + chemistry + biology)
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | exam=final | hold_flash=1 |"

# MATH
ASSERT GCD(100,35) == 5
ASSERT POW(2,5) == 32
ASSERT SQRT(144) == 12
ASSERT FACT(5) == 120

# PHYSICS
ASSERT FORCE(3,5) == 15
ASSERT KE(4,3) == 18
ASSERT PE(2,5) == 2 * 98 * 5 / 10
ASSERT C_LIGHT == 299792458

# CHEMISTRY
ASSERT CELSIUS_K(100) == 373
LET H_in = 2 * 2
LET O_in = 2
ASSERT H_in == 4
ASSERT O_in == 2

# BIOLOGY cubechain life model
CUBE organism ROLE life PROTON 1
CUBE cell ROLE unit PROTON 1
CUBE gene ROLE code PROTON 1
NEST organism cell
NEST cell gene
FOLDBITS organism "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS cell     "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS gene     "1010101010101010101010101010101010101010101010101010101010101010"
PLUG organism cell
PLUG cell gene
IMPULSE organism 1
FLOW 3
COMPILE gene
COMPILE cell
COMPILE organism
ASSERT COMPILED(organism) == 1
ASSERT NESTED(gene) == 1
ASSERT CUBES == 3

PRINT "FINAL_PURE_SCIENCE" CUBES COMPILED(organism) FORCE(3,5) GCD(100,35)
