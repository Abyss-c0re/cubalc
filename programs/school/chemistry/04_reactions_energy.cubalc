# Chemistry 04 — Reaction as energy flow on cubechain
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | domain=react |"

CUBE reactants ROLE source PROTON 1
CUBE products ROLE sink PROTON 1
FOLDBITS reactants "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS products  "1111000011110000111100001111000011110000111100001111000011110000"
PLUG reactants products
IMPULSE reactants 1
FLOW 4
ASSERT FLOWED(products) == 1

# exothermic proxy: energy moved
LET e_r = ENERGY(reactants)
LET e_p = ENERGY(products)
ASSERT e_p >= 0

PRINT "chem04_react" e_r e_p
