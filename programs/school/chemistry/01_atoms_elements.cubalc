# Chemistry 01 — Atoms as cubes; Z = proton count metaphor
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | domain=chem |"

CUBE H ROLE element PROTON 1
CUBE C ROLE element PROTON 1
CUBE O ROLE element PROTON 1
SETDIGIT H 1
SETDIGIT C 6
SETDIGIT O 8
ASSERT DIGIT(H) == 1
ASSERT DIGIT(C) == 6
ASSERT DIGIT(O) == 8

# mass number A = Z + N
LET Z = 6
LET N = 6
LET A = Z + N
ASSERT A == 12

PRINT "chem01_atoms" DIGIT(C) A
