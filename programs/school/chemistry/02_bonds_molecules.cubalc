# Chemistry 02 — Bonds = plugs; molecule = nest
HOLD_FLASH 1
SCIENCE LOAD
GENESIS "NEXUS_COORD v1 | from=school | domain=bond |"

CUBE mol ROLE molecule PROTON 1
CUBE H1 ROLE atom PROTON 1
CUBE H2 ROLE atom PROTON 1
CUBE O ROLE atom PROTON 1
NEST mol H1
NEST mol H2
NEST mol O
SETDIGIT H1 1
SETDIGIT H2 1
SETDIGIT O 8

FOLDBITS H1 "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS H2 "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS O  "1010101010101010101010101010101010101010101010101010101010101010"
FOLDBITS mol "1010101010101010101010101010101010101010101010101010101010101010"

PLUG mol O
PLUG O H1
PLUG O H2
IMPULSE mol 1
FLOW 4
COMPILE H1
COMPILE H2
COMPILE O
COMPILE mol
ASSERT NESTED(H1) == 1
ASSERT COMPILED(mol) == 1

# water stoichiometry H2O: 2 H + 1 O
ASSERT 2 + 1 == 3

PRINT "chem02_h2o" CUBES COMPILED(mol)
