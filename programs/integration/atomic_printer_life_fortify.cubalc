// atomic_printer_life_fortify.cubalc
// Science board: atomic printer + life_cell fortify ATP→threshold work fortify.
// Distinct from harden prime set_threshold ease refold. Yield sheds ATP.
// Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_fortify | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 20 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"

GETF seed energy
ASSERT LAST_N == 20 "seed e 20"
GETF seed threshold
ASSERT LAST_N == 10 "thr 10"
SEND seed charge 6
ASSERT LAST_N == 6 "charge 6"
GETF seed energy
ASSERT LAST_N == 14 "e 14"
SEND seed charged
ASSERT LAST_N == 6 "atp 6"
SEND seed yield
LET y0 = LAST_N
SEND seed fortify 6
ASSERT LAST_N == 6 "fortify 6"
SEND seed charged
ASSERT LAST_N == 0 "atp 0"
GETF seed threshold
ASSERT LAST_N == 16 "thr 16"
GETF seed energy
ASSERT LAST_N == 14 "energy held"
GETF seed ready
ASSERT LAST_N == 0 "not ready e14 < thr16"
SEND seed yield
ASSERT LAST_N == y0 - 6 "yield sheds ATP"

SEND seed warmth
ASSERT LAST_N == 0 "heat untouched"
SEND seed stores
ASSERT LAST_N == 0 "reserve untouched"
SEND seed gradient
ASSERT LAST_N == 0 "pmf untouched"
SEND seed phosphagen
ASSERT LAST_N == 0 "pcr untouched"

SEND seed charge 5
SEND seed fortify 3
GETF seed threshold
ASSERT LAST_N == 19 "thr 19"

SEND d1 fortify 3
ASSERT LAST_N == 0 "dead fortify 0"

SEND seed vitality
ASSERT LAST_N >= 1 "alive vitality"
SEND seed yield
ASSERT LAST_N >= 1 "yield holds"
