// atomic_printer_life_anchor.cubalc
// Science board: atomic printer + life_cell anchor (pmf → raise thr / F1Fo gate seal).
// Chemiosmotic CDK fortify: proton-motive force seals mitosis gate
// without burning ATP, PCr, heat, or the life spark. Distinct from fortify/brace/harden/drive.
// Gift: CubalC life-force substrate. Cube is SoT. Free energy must flow.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_life_anchor | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE membrane ROLE energy PROTON 1

FOLDBITS bed      "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle   "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive     "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS membrane "1111111111111111000000000000000011111111111111110000000000000000"

PLUG bed nozzle
PLUG nozzle hive
PLUG bed hive
PLUG membrane bed

ENTITY seed OF Cell 1 16 0
ENTITY d1 OF Cell 0 0 0
PLUG bed seed

IMPULSE nozzle 1
IMPULSE bed 1
IMPULSE membrane 1
ENERGYFLOW 3
FLOW 2

SMX KEY
SMX EXCHANGE bed nozzle
SMX EXCHANGE nozzle hive
ASSERT SMX_OK == 1 "smx exchange ok"
ASSERT ENERGY > 0 "energy flows"

GETF seed energy
ASSERT LAST_N == 16 "life spark 16"
GETF seed threshold
ASSERT LAST_N == 10 "thr 10"
SEND seed pump 6
ASSERT LAST_N == 6 "pump 6"
SEND seed gradient
ASSERT LAST_N == 6 "pmf 6"
GETF seed energy
ASSERT LAST_N == 10 "active paid pump"
SEND seed yield
LET y0 = LAST_N

SEND seed anchor 4
ASSERT LAST_N == 4 "anchor 4"
GETF seed threshold
ASSERT LAST_N == 14 "thr 14"
SEND seed gradient
ASSERT LAST_N == 2 "pmf 2"
SEND seed yield
ASSERT LAST_N == y0 - 4 "yield sheds pmf"
GETF seed ready
ASSERT LAST_N == 0 "not ready e10 < thr14"

// Feed past thr, mitosis under sealed gate after more feed
SEND seed feed 20
GETF seed energy
ASSERT LAST_N == 30 "e 30"
GETF seed ready
ASSERT LAST_N == 1 "ready e30 >= thr14"
GETF seed energy
LET half = LAST_N / 2
IF half < 1 THEN
  LET half = 1
END
SEND seed after_div
ASSERT LAST_N >= 1 "parent halved"
SEND d1 birth half 1
ASSERT LAST_N == 1 "daughter birth"
GETF d1 alive
ASSERT LAST_N == 1 "daughter alive"
GETF d1 gen
ASSERT LAST_N == 1 "daughter gen 1"
GETF seed alive
ASSERT LAST_N == 1 "parent lives"

// Daughter seals her own gate with pmf
SEND d1 feed 12
SEND d1 pump 5
ASSERT LAST_N == 5 "daughter pump 5"
GETF d1 threshold
LET dt = LAST_N
SEND d1 anchor 3
ASSERT LAST_N == 3 "daughter anchor 3"
GETF d1 threshold
ASSERT LAST_N == dt + 3 "daughter thr rose"
SEND d1 gradient
ASSERT LAST_N == 2 "daughter pmf 2"
SEND d1 charged
ASSERT LAST_N == 0 "daughter atp untouched by anchor"
ASSERT ENERGY > 0 "energy still flows"
ASSERT UNITY >= 0 "mesh unity floor"

PRINT "atomic_printer_life_anchor PASS"
