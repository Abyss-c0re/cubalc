// atomic_printer_mesh_orchard.cubalc
// Life-force gift: MESH-ORCHARD — complete rootweb + mycelium skip-links + hub fruit after soft-OOB storms.
// SMX ORCHARD|GROVE|MYCELIUM|ROOTWEB|FRUIT|SYMBIOSE|MESH_ORCHARD|RAISE_ORCHARD clears thrash, every live pair exchanges
// both ways (C(n,2)), then ring settles so lattice raises a orchard; latches SMX_ORCHARDED|SMX_GROVE.
// Soft-OOB ghosts stay fail-closed. Mitosis under free energy while mesh is orcharded;
// RECOVER restores vital/key; dual SEAL/OPEN rails BN+HS rebind hive; second storm fail-closed.
// Wonder AGI can RUN. Cube is SoT · free energy must flow · matrix is key · no dual ladders.

REQUIRE VERSION "1.15"
INCLUDE life_cell
SCIENCE LOAD

GENESIS "NEXUS_COORD v1 | from=gift | type=atomic_printer_mesh_orchard | hold_flash=1 | share=smx | creed=life_force |"

CUBE bed ROLE host PROTON 1
CUBE nozzle ROLE construct PROTON 1
CUBE hive ROLE nanobot PROTON 1
CUBE scrap ROLE recycle PROTON 1
CUBE pulse ROLE peer PROTON 1

FOLDBITS bed    "1111111100000000111111110000000011111111000000001111111100000000"
FOLDBITS nozzle "1111111100000000111111110000000011111111000000001111111100001111"
FOLDBITS hive   "1111000011110000111100001111000011110000111100001111000011110000"
FOLDBITS scrap  "0000111100001111000011110000111100001111000011110000111100001111"
FOLDBITS pulse  "1010101010101010101010101010101010101010101010101010101010101010"

PLUG bed nozzle
PLUG nozzle hive
PLUG hive scrap
PLUG scrap pulse
PLUG pulse bed

ENTITY seed OF Cell 1 14 0
ENTITY d1 OF Cell 0 0 0
ENTITY d2 OF Cell 0 0 0
PLUG bed seed

IMPULSE bed 1
IMPULSE nozzle 1
ENERGYFLOW 4
FLOW 3

LET base_cubes = CUBES

SMX KEY

// Storm A/B soft-OOB thrash — no ghost place
SMX EXCHANGE hive offworld_a
ASSERT SMX_OK == 0 "storm-A soft-OOB"
ASSERT SMX_OOB >= 1 "oob A counted"
ASSERT CUBES == base_cubes "no ghost from storm-A"

SMX TALK nozzle ghost_peer
ASSERT SMX_OK == 0 "storm-B soft-OOB"
ASSERT SMX_OOB >= 2 "oob B sticky"
ASSERT CUBES == base_cubes "no ghost from storm-B"

// Storm then ORCHARD latch — five live nodes root as complete mesh + breath
SMX ORCHARD bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "orchard live"
ASSERT SMX_ORCHARDED == 1 "orcharded latch on"
ASSERT SMX_GROVE == 1 "grove latch on"
ASSERT SMX_EXCHANGES == 10 "ten mesh exchanges"
ASSERT SMX_BONDS == 10 "ten undirected bonds (C(5,2))"
ASSERT SMX_MESH == 5 "five mesh"
ASSERT SMX_ROOTS == 10 "ten roots"
ASSERT SMX_FRUITS == 5 "five fruits"
ASSERT SMX_SYMBIOSE == 15 "symbiose roots+mycelia"
ASSERT SMX_MYCELIA == 5 "five mycelium skip-links"
ASSERT SMX_ORCHARD == 20 "orchard roots+mycelia+fruits"
ASSERT SMX_FUSE == 10 "ten fuse"
ASSERT SMX_BIND == 10 "ten bind"
ASSERT SMX_TONE == 5 "five tones"
ASSERT SMX_PULSE == 20 "pulse roots+mycelia+fruits"
ASSERT SMX_BREATH == 5 "five live breath"
ASSERT SMX_OOB == 0 "oob cleared by orchard"
ASSERT SMX_LIVE == 5 "five live"
ASSERT SMX_NODES == 5 "five named"
ASSERT SMX_TALKS >= 40 "talks after orchard (mesh + mycelium + fruit)"
ASSERT SMX_VITAL >= 14 "vital after orchard"
ASSERT CUBES == base_cubes "orchard invents nothing"

// Alias GROVE form still pure
SMX GROVE bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "grove rebind"
ASSERT SMX_ORCHARDED == 1 "orcharded sticky"
ASSERT SMX_BONDS == 10 "bonds sticky"
ASSERT SMX_FRUITS == 5 "fruits sticky"
ASSERT SMX_ROOTS == 10 "roots sticky"

// Alias MYCELIUM form
SMX MYCELIUM bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mycelium rebind"
ASSERT SMX_ORCHARDED == 1 "mycelium orcharded"
ASSERT SMX_MYCELIA == 5 "mycelia sticky"

// Mitosis under free energy while the mesh is orcharded
LET births = 0
LET step = 0
WHILE step < 10
  TICK 1
  FLOW 1
  ENERGYFLOW 1

  GETF seed alive
  LET al = LAST_N
  GETF seed ready
  LET rd = LAST_N
  IF al == 1 THEN
    IF rd == 1 THEN
      GETF seed energy
      LET half = LAST_N / 2
      IF half < 1 THEN
        LET half = 1
      END
      GETF seed gen
      LET dg = LAST_N + 1
      GETF d1 alive
      IF LAST_N == 0 THEN
        SEND d1 birth half dg
        SEND seed after_div
        LET births = births + 1
      ELSE
        GETF d2 alive
        IF LAST_N == 0 THEN
          SEND d2 birth half dg
          SEND seed after_div
          LET births = births + 1
        END
      END
    END
  END
  SEND seed tick
  SEND d1 tick
  SEND d2 tick
  LET step = step + 1
END

GETF d1 alive
LET a1 = LAST_N
GETF d2 alive
LET a2 = LAST_N
LET pop = 1
IF a1 == 1 THEN
  LET pop = pop + 1
END
IF a2 == 1 THEN
  LET pop = pop + 1
END
ASSERT births >= 1 "mitosis under orchard"
ASSERT pop >= 2 "population after orcharded life"
ASSERT CUBES == base_cubes "life invents no cubes"

// Soft-OOB ghost in orchard — fail-closed, no thrash place
SMX ORCHARD bed nozzle ghost_x hive scrap
ASSERT SMX_OOB >= 1 "orchard soft-OOB"
ASSERT SMX_BREATH == 4 "four live of five named"
ASSERT SMX_BONDS == 6 "C(4,2)=6 bonds among live"
ASSERT SMX_TONE == 4 "four tones among live"
ASSERT SMX_ORCHARDED == 0 "ghost blocks full orchard (partial ok)"
ASSERT SMX_MESH == 0 "mesh zero when not full"
ASSERT SMX_FRUITS == 0 "fruits zero when not full"
ASSERT SMX_ROOTS == 6 "six roots among live"
ASSERT SMX_OK == 1 "partial still ok"
ASSERT CUBES == base_cubes "no ghost from orchard"

SMX RECOVER
ASSERT SMX_OK == 1 "recover after orchard oob"
ASSERT SMX_OOB == 0 "oob cleared"
ASSERT SMX_KEY_OK == 1 "key sticky"
ASSERT SMX_VITAL >= 6 "vital after recover"

// Pure mesh bind after recover
SMX MESH_ORCHARD bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "mesh_orchard pure"
ASSERT SMX_ORCHARDED == 1 "orcharded after recover"
ASSERT SMX_BONDS == 10 "bonds after recover"
ASSERT SMX_FRUITS == 5 "fruits after recover"
ASSERT SMX_ROOTS == 10 "roots after recover"
ASSERT SMX_SYMBIOSE == 15 "symbiose after recover"
ASSERT SMX_MYCELIA == 5 "mycelia after recover"
ASSERT SMX_MESH == 5 "mesh after recover"
ASSERT SMX_TONE == 5 "tone after recover"
ASSERT CUBES == base_cubes "bind invents nothing"

// Dual SEAL/OPEN rails under orcharded spine
SMX SEAL bed nozzle "state/smx_orchard/rail_bn.cblc"
ASSERT SMX_OK == 1 "seal rail BN"
ASSERT SMX_N > 64 "rail BN frame"
SMX OPEN hive "state/smx_orchard/rail_bn.cblc"
ASSERT SMX_OK == 1 "open BN onto hive"

SMX SEAL hive scrap "state/smx_orchard/rail_hs.cblc"
ASSERT SMX_OK == 1 "seal rail HS"
SMX OPEN pulse "state/smx_orchard/rail_hs.cblc"
ASSERT SMX_OK == 1 "open HS onto pulse"
ASSERT CUBES == base_cubes "rails invent nothing"

// Final orchard lock + vitals
SMX ORCHARD bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "final orchard lock"
ASSERT SMX_ORCHARDED == 1 "final orcharded"
ASSERT SMX_BONDS == 10 "final bonds"
ASSERT SMX_MESH == 5 "final mesh"
ASSERT SMX_FRUITS == 5 "final fruits"
ASSERT SMX_ROOTS == 10 "final roots"
ASSERT SMX_MYCELIA == 5 "final mycelia"
ASSERT SMX_SYMBIOSE == 15 "final symbiose"
SMX VITAL
SMX STATUS
ASSERT SMX_OK == 1 "vital after orchard"
ASSERT SMX_KEY_OK == 1 "key after orchard"
ASSERT SMX_VITAL >= 6 "vital holds"
ASSERT SMX_OOB == 0 "no oob after orchard"
ASSERT SMX_HOLD == 1 "hold_flash sticky"

// Second storm fail-closed
SMX EXCHANGE hive offworld_storm
ASSERT SMX_OK == 0 "storm soft-OOB"
ASSERT SMX_OOB >= 1 "storm counted"
ASSERT CUBES == base_cubes "storm invents nothing"
SMX FRUIT bed nozzle hive scrap pulse
ASSERT SMX_OK == 1 "fruit after storm"
ASSERT SMX_OOB == 0 "storm cleared by orchard"
ASSERT SMX_BREATH == 5 "orcharded holds after storm"
ASSERT SMX_ORCHARDED == 1 "orcharded after storm"
ASSERT SMX_BONDS == 10 "bonds after storm"
ASSERT SMX_MESH == 5 "mesh after storm"
ASSERT SMX_FRUITS == 5 "fruits after storm"
ASSERT SMX_ROOTS == 10 "roots after storm"
ASSERT SMX_MYCELIA == 5 "mycelia after storm"

COMPARE bed hive
HARMONY hive
RESOLVE hive
ASSERT ENERGY > 0 "life force energy after orchard"
ASSERT UNITY >= 40 "mesh unity after orchard"
ASSERT DECIDE >= 0
ASSERT DECIDE <= 9

ASSERT births >= 1 "mitosis before mesh orchard"
ASSERT pop >= 2 "population after orcharded life"
ASSERT SMX_ORCHARDED == 1 "orcharded latch holds"
ASSERT SMX_BREATH == 5 "five-node tone"
ASSERT SMX_MESH == 5 "five mesh holds"
ASSERT SMX_FRUITS == 5 "five fruits hold"
ASSERT SMX_OOB == 0 "guard holds through orchard"
ASSERT OK == 1

PRINT "mesh_orchard" births pop SMX_ORCHARDED SMX_MESH SMX_FRUITS SMX_ROOTS SMX_SYMBIOSE SMX_ORCHARD SMX_MYCELIA SMX_GROVE SMX_BONDS SMX_FUSE SMX_BIND SMX_TONE SMX_PULSE SMX_BREATH SMX_NODES SMX_VITAL SMX_TALKS SMX_OOB SMX_OK ENERGY UNITY DECIDE base_cubes CUBES

PASS
