#!/usr/bin/env bash
# Block creating/updating junk branches; allow deletes (local_sha all-zero)
set -euo pipefail
z40=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  # delete ref — always OK (healing)
  if [[ "$local_sha" == "$z40" ]]; then
    continue
  fi
  br=${remote_ref#refs/heads/}
  if echo "$br" | grep -qiE '^(ship[-/]|life-cell-|mi-[0-9]|keeper/)'; then
    echo "HERESY: refuse push of junk branch '$br' — stay on main" >&2
    exit 1
  fi
  if echo "$br" | grep -qiE '^ship[0-9_]|ship_'; then
    echo "HERESY: refuse push of junk branch '$br' — stay on main" >&2
    exit 1
  fi
done
exit 0
